@proposal 0004_target_rv64_sll
@domain target
@goal Grow multi-file RV64 shift encoder and target assembly emitter
@principles P1,P7,P24,P30,P31
@capability pure
@max_asm_lines 400
@approval signed:ricardo:ed25519:2ec6a9b1ec20e16015a9d8c74a1db406d10d3137d021999b2dff7d9e76b88daaedaa1fa685f204f918418e2132ac5c106ee1c33caaacc80fd442e1c0faae5001
@file compiler/stage1/mod_target_isa.src
@baseline
fn rv64_add(rd: int, rs1: int, rs2: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and rs2 >= 0 and rs2 < 32 ensures result >= 51 = 51 + rd * 128 + rs1 * 32768 + rs2 * 1048576
@end
@candidate
fn rv64_add(rd: int, rs1: int, rs2: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and rs2 >= 0 and rs2 < 32 ensures result >= 51 = 51 + rd * 128 + rs1 * 32768 + rs2 * 1048576
@bound(cycles: 32)
fn rv64_slli(rd: int, rs1: int, shamt: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and shamt >= 0 and shamt < 64 ensures result >= 19 = 19 + rd * 128 + 4096 + rs1 * 32768 + shamt * 1048576
fn test_rv64_slli_encodes_opcode_and_shamt() = rv64_slli(10, 11, 3) == 3511523
@end
@file compiler/stage1/mod_target_emit.src
@baseline
use mod_target_isa
fn emit_rv64_pair(rd: int, rs1: int, rs2: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and rs2 >= 0 and rs2 < 32 ensures result >= 51 = rv64_add(rd, rs1, rs2)
@end
@candidate
use mod_target_isa
fn emit_rv64_pair(rd: int, rs1: int, rs2: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and rs2 >= 0 and rs2 < 32 ensures result >= 51 = rv64_add(rd, rs1, rs2)
@bound(cycles: 48)
fn emit_rv64_scale(rd: int, rs1: int, shamt: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and shamt >= 0 and shamt < 64 ensures result >= 70 = rv64_slli(rd, rs1, shamt) + rv64_add(rd, rd, rs1)
fn test_emit_rv64_scale_combines_slli_and_add() = emit_rv64_scale(10, 11, 3) == 15374646
@end
@tests
print rv64_slli(10, 11, 3)
print emit_rv64_scale(10, 11, 3)
@end
@expected
3511523
15374646
@end
