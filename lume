_JRPC_FRAMED=0
_JRPC_MSG=""

jsonrpc_read_msg() {
    _JRPC_MSG=""
    while IFS= read -r _j_line; do
        _j_line=$(printf '%s' "$_j_line" | tr -d '\r')
        [ -n "$_j_line" ] || continue
        case "$_j_line" in
            Content-Length:*|content-length:*)
                _JRPC_FRAMED=1
                _j_clen=$(printf '%s' "$_j_line" | awk '{print $2}')
                while IFS= read -r _j_hdr; do
                    _j_hdr=$(printf '%s' "$_j_hdr" | tr -d '\r')
                    [ -z "$_j_hdr" ] && break
                done
                _JRPC_MSG=$(dd bs=1 count="$_j_clen" 2>/dev/null)
                return 0
                ;;
            \{*)
                _JRPC_MSG="$_j_line"
                return 0
                ;;
        esac
    done
    return 1
}

jsonrpc_send_msg() {
    if [ "$_JRPC_FRAMED" -eq 1 ]; then
        _s_len=$(printf '%s' "$1" | wc -c | tr -d ' ')
        printf 'Content-Length: %s\r\n\r\n%s' "$_s_len" "$1"
    else
        printf '%s\n' "$1"
    fi
}

jsonrpc_extract_str() {
    printf '%s' "$1" | awk -v k="\"$2\"" '
        {
            pat = k "[ \t]*:[ \t]*\""
            if (match($0, pat)) {
                s = substr($0, RSTART + RLENGTH)
                out = ""
                esc = 0
                for (i = 1; i <= length(s); i++) {
                    c = substr(s, i, 1)
                    if (esc) {
                        if (c == "n") out = out "\n"
                        else if (c == "t") out = out "\t"
                        else if (c == "r") out = out ""
                        else out = out c
                        esc = 0
                    } else if (c == "\\") {
                        esc = 1
                    } else if (c == "\"") {
                        break
                    } else {
                        out = out c
                    }
                }
                printf "%s", out
            }
        }'
}

cmd_lsp() {
    _lfile=""
    _ljson=0
    _lstdio=0
    for _arg in "$@"; do
        case "$_arg" in
            --json) _ljson=1 ;;
            --stdio) _lstdio=1 ;;
            -*) usage ;;
            *) _lfile=$_arg ;;
        esac
    done
    if [ -n "$_lfile" ] && [ "$_lstdio" -eq 0 ]; then
        cmd_agent lsp "$_lfile"
        return $?
    fi
    _lsp_dir=$(mktemp -d "${TMPDIR:-/tmp}/lume_lsp_XXXXXX")
    _lsp_src="$_lsp_dir/doc.src"
    if [ -n "$_lfile" ] && [ -f "$_lfile" ]; then
        cp "$_lfile" "$_lsp_src"
        _lsp_uri="file://$_lfile"
    else
        printf 'fn placeholder() -> int = 0\n' > "$_lsp_src"
        _lsp_uri="file:///workspace/module.src"
    fi
    _lsp_diags="[]"
    _lsp_symbols="[]"
    _lsp_hovers="[]"
    _lsp_actions="[]"
    _lsp_holes="[]"
    _lsp_proofs="[]"
    _lsp_shutdown=0

    lsp_refresh_analysis() {
        _lbun="$_lsp_dir/bun.src"
        if ! bundle_src_if_needed "$_lsp_src" "$_lbun" 2>/dev/null; then
            cp "$_lsp_src" "$_lbun"
        fi
        _lin="$_lsp_dir/in.src"
        printf '@mode lsp\n' > "$_lin"
        cat "$_lbun" >> "$_lin"
        _lout=$(run_core_tool lcaas "$_lin" 2>/dev/null || true)
        if [ -n "$_lout" ]; then
            _lsp_diags=$(printf '%s' "$_lout" | awk '{a=index($0,"\"diagnostics\":"); b=index($0,"},\"documentSymbols\":"); if(a>0&&b>a) printf "%s", substr($0,a+14,b-(a+14)); else printf "[]"}')
            _lsp_symbols=$(printf '%s' "$_lout" | awk '{a=index($0,"},\"documentSymbols\":"); b=index($0,",\"hovers\":"); if(a>0&&b>a) printf "%s", substr($0,a+20,b-(a+20)); else printf "[]"}')
            _lsp_hovers=$(printf '%s' "$_lout" | awk '{a=index($0,",\"hovers\":"); b=index($0,",\"codeActions\":"); if(a>0&&b>a) printf "%s", substr($0,a+10,b-(a+10)); else printf "[]"}')
            _lsp_actions=$(printf '%s' "$_lout" | awk '{a=index($0,",\"codeActions\":"); b=index($0,",\"holes\":"); if(a>0&&b>a) printf "%s", substr($0,a+15,b-(a+15)); else printf "[]"}')
            _lsp_holes=$(printf '%s' "$_lout" | awk '{a=index($0,",\"holes\":"); b=index($0,",\"proofs\":"); if(a>0&&b>a) printf "%s", substr($0,a+9,b-(a+9)); else printf "[]"}')
            _lsp_proofs=$(printf '%s' "$_lout" | awk '{a=index($0,",\"proofs\":"); if(a>0) printf "%s", substr($0,a+10,length($0)-(a+10)); else printf "[]"}')
        fi
    }

    while jsonrpc_read_msg; do
        _id=$(printf '%s' "$_JRPC_MSG" | sed -n 's/.*"id"[ \t]*:[ \t]*\([0-9a-zA-Z"_.-]*\).*/\1/p')
        [ -n "$_id" ] || _id="null"
        case "$_JRPC_MSG" in
            *'"method"'*'"initialize"'*)
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"id\":$_id,\"result\":{\"protocol\":\"lsp/3.17\",\"serverInfo\":{\"name\":\"lume-lsp\",\"version\":\"0.2.0\"},\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,\"codeActionProvider\":true,\"inlayHintProvider\":true}}}"
                ;;
            *'"method"'*'"initialized"'*)
                ;;
            *'"textDocument/didOpen"'*|*'"textDocument/didChange"'*)
                _u=$(jsonrpc_extract_str "$_JRPC_MSG" "uri")
                [ -n "$_u" ] && _lsp_uri="$_u"
                _txt=$(jsonrpc_extract_str "$_JRPC_MSG" "text")
                if [ -n "$_txt" ]; then
                    printf '%s\n' "$_txt" > "$_lsp_src"
                elif [ -n "$_u" ]; then
                    _upath=${_u#file://}
                    [ -f "$_upath" ] && cp "$_upath" "$_lsp_src"
                fi
                lsp_refresh_analysis
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"$_lsp_uri\",\"diagnostics\":$_lsp_diags,\"proofs\":$_lsp_proofs,\"holes\":$_lsp_holes}}"
                ;;
            *'"textDocument/hover"'*)
                lsp_refresh_analysis
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"id\":$_id,\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"Lume verified symbol hover\"},\"hovers\":$_lsp_hovers,\"proofs\":$_lsp_proofs}}"
                ;;
            *'"textDocument/codeAction"'*)
                lsp_refresh_analysis
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"id\":$_id,\"result\":$_lsp_actions}"
                ;;
            *'"textDocument/documentSymbol"'*)
                lsp_refresh_analysis
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"id\":$_id,\"result\":$_lsp_symbols}"
                ;;
            *'"method"'*'"shutdown"'*)
                _lsp_shutdown=1
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"id\":$_id,\"result\":null}"
                ;;
            *'"method"'*'"exit"'*)
                rm -rf "$_lsp_dir"
                if [ "$_lsp_shutdown" -eq 1 ]; then
                    return 0
                else
                    return 1
                fi
                ;;
        esac
    done
    rm -rf "$_lsp_dir"
    return 0
}

cmd_dap() {
    _dfile=""
    _djson=0
    _dstdio=0
    for _arg in "$@"; do
        case "$_arg" in
            --json) _djson=1 ;;
            --stdio) _dstdio=1 ;;
            -*) usage ;;
            *) _dfile=$_arg ;;
        esac
    done
    if [ -n "$_dfile" ] && [ "$_dstdio" -eq 0 ]; then
        cmd_agent dap "$_dfile"
        return $?
    fi
    _dap_dir=$(mktemp -d "${TMPDIR:-/tmp}/lume_dap_XXXXXX")
    _dap_src="$_dap_dir/prog.src"
    if [ -n "$_dfile" ] && [ -f "$_dfile" ]; then
        cp "$_dfile" "$_dap_src"
    else
        printf 'fn main_step(x: int) -> int = x + 1\nprint main_step(41)\n' > "$_dap_src"
    fi
    _dap_seq=1
    _dap_step=1
    _dap_history="1"
    _dap_frames="[]"
    _dap_scopes="[]"
    _dap_out=""

    dap_refresh_state() {
        _dbun="$_dap_dir/bun.src"
        if ! bundle_src_if_needed "$_dap_src" "$_dbun" 2>/dev/null; then
            cp "$_dap_src" "$_dbun"
        fi
        _din="$_dap_dir/in.src"
        printf '@mode dap\n' > "$_din"
        cat "$_dbun" >> "$_din"
        _dout=$(run_core_tool lcaas "$_din" 2>/dev/null || true)
        if [ -n "$_dout" ]; then
            _dap_frames=$(printf '%s' "$_dout" | awk '{a=index($0,",\"stackFrames\":"); b=index($0,",\"scopes\":"); if(a>0&&b>a) printf "%s", substr($0,a+15,b-(a+15)); else printf "[]"}')
            _dap_scopes=$(printf '%s' "$_dout" | awk '{a=index($0,",\"scopes\":"); b=index($0,",\"output\":"); if(a>0&&b>a) printf "%s", substr($0,a+10,b-(a+10)); else printf "[]"}')
            _dap_out=$(jsonrpc_extract_str "$_dout" "output")
        fi
    }

    while jsonrpc_read_msg; do
        _rseq=$(printf '%s' "$_JRPC_MSG" | sed -n 's/.*"seq"[ \t]*:[ \t]*\([0-9]*\).*/\1/p')
        [ -n "$_rseq" ] || _rseq=1
        _cmd=$(jsonrpc_extract_str "$_JRPC_MSG" "command")
        case "$_cmd" in
            initialize)
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"protocol\":\"dap/1.65\",\"adapter\":\"lume-dap\",\"command\":\"initialize\",\"body\":{\"supportsConfigurationDoneRequest\":true,\"supportsStepBack\":true,\"supportsEvaluateForHovers\":true}}"
                _dap_seq=$((_dap_seq + 1))
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"event\",\"event\":\"initialized\",\"body\":{}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            configurationDone)
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"configurationDone\",\"body\":{}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            launch)
                _prog=$(jsonrpc_extract_str "$_JRPC_MSG" "program")
                _stxt=$(jsonrpc_extract_str "$_JRPC_MSG" "source")
                if [ -n "$_stxt" ]; then
                    printf '%s\n' "$_stxt" > "$_dap_src"
                elif [ -n "$_prog" ] && [ -f "$_prog" ]; then
                    cp "$_prog" "$_dap_src"
                fi
                dap_refresh_state
                _dap_step=1
                _dap_history="1"
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"launch\",\"body\":{\"output\":\"$_dap_out\"}}"
                _dap_seq=$((_dap_seq + 1))
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"event\",\"event\":\"stopped\",\"body\":{\"reason\":\"entry\",\"threadId\":1,\"step\":$_dap_step,\"replay\":false}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            next|stepIn|stepOut)
                _dap_step=$((_dap_step + 1))
                _dap_history="$_dap_history,$_dap_step"
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"$_cmd\",\"body\":{\"step\":$_dap_step}}"
                _dap_seq=$((_dap_seq + 1))
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"event\",\"event\":\"stopped\",\"body\":{\"reason\":\"step\",\"threadId\":1,\"step\":$_dap_step,\"replay\":false}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            stepBack|reverseContinue)
                if [ "$_dap_step" -gt 1 ]; then
                    _dap_step=$((_dap_step - 1))
                fi
                _dap_history="$_dap_history,$_dap_step"
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"$_cmd\",\"body\":{\"step\":$_dap_step,\"replay\":true}}"
                _dap_seq=$((_dap_seq + 1))
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"event\",\"event\":\"stopped\",\"body\":{\"reason\":\"step\",\"threadId\":1,\"step\":$_dap_step,\"replay\":true}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            stackTrace)
                dap_refresh_state
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"stackTrace\",\"body\":{\"currentStep\":$_dap_step,\"traceHistory\":\"$_dap_history\",\"stackFrames\":$_dap_frames}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            scopes|variables)
                dap_refresh_state
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"$_cmd\",\"body\":{\"scopes\":$_dap_scopes}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            evaluate)
                _expr=$(jsonrpc_extract_str "$_JRPC_MSG" "expression")
                _deval="$_dap_dir/eval.src"
                awk '!/^[ \t]*print[ \t]+/' "$_dap_src" > "$_deval"
                printf 'print (%s)\n' "${_expr:-0}" >> "$_deval"
                _debun="$_dap_dir/eval_bun.src"
                if ! bundle_src_if_needed "$_deval" "$_debun" 2>/dev/null; then
                    cp "$_deval" "$_debun"
                fi
                _ej=$(run_core_tool lcaas "$_debun" 2>/dev/null || true)
                _eres=$(jsonrpc_extract_str "$_ej" "result" | tr -d '\n')
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"evaluate\",\"body\":{\"result\":\"$_eres\",\"step\":$_dap_step}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            disconnect|terminate)
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"${_cmd:-disconnect}\",\"body\":{}}"
                _dap_seq=$((_dap_seq + 1))
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"event\",\"event\":\"terminated\",\"body\":{}}"
                rm -rf "$_dap_dir"
                return 0
                ;;
        esac
    done
    rm -rf "$_dap_dir"
    return 0
}

cmd_repl() {
    _rfile=""
    _rjson=0
    _rkernel=0
    for _arg in "$@"; do
        case "$_arg" in
            --json) _rjson=1 ;;
            --kernel) _rjson=1; _rkernel=1 ;;
            -*) usage ;;
            *) _rfile=$_arg ;;
        esac
    done
    if [ -n "$_rfile" ]; then
        if [ ! -f "$_rfile" ]; then
            echo "lume repl: cannot read $_rfile" >&2
            exit 66
        fi
        if [ "$_rjson" -eq 1 ]; then
            cmd_agent repl "$_rfile"
        else
            cmd_run "$_rfile"
        fi
        return $?
    fi
    _repl_dir=$(mktemp -d "${TMPDIR:-/tmp}/lume_repl_XXXXXX")
    _repl_defs="$_repl_dir/defs.src"
    : > "$_repl_defs"
    _exec_cnt=0

    if [ "$_rkernel" -eq 1 ] || [ "$_rjson" -eq 1 ]; then
        while jsonrpc_read_msg; do
            _mtype=$(jsonrpc_extract_str "$_JRPC_MSG" "msg_type")
            [ -n "$_mtype" ] || _mtype=$(jsonrpc_extract_str "$_JRPC_MSG" "method")
            case "$_mtype" in
                kernel_info_request)
                    jsonrpc_send_msg "{\"msg_type\":\"kernel_info_reply\",\"protocol\":\"lume-repl/1.0\",\"protocol_version\":\"5.3\",\"implementation\":\"lume-kernel-v1\",\"language_info\":{\"name\":\"lume\",\"version\":\"0.2.0\",\"mimetype\":\"text/x-lume\",\"file_extension\":\".src\"},\"status\":\"ok\"}"
                    ;;
                is_complete_request)
                    jsonrpc_send_msg "{\"msg_type\":\"is_complete_reply\",\"status\":\"complete\"}"
                    ;;
                shutdown_request|exit)
                    jsonrpc_send_msg "{\"msg_type\":\"shutdown_reply\",\"status\":\"ok\",\"restart\":false}"
                    rm -rf "$_repl_dir"
                    return 0
                    ;;
                execute_request|*)
                    _exec_cnt=$((_exec_cnt + 1))
                    _code=$(jsonrpc_extract_str "$_JRPC_MSG" "code")
                    _turn="$_repl_dir/turn.src"
                    cat "$_repl_defs" > "$_turn"
                    printf '%s\n' "$_code" >> "$_turn"
                    _tbun="$_repl_dir/tbun.src"
                    if ! bundle_src_if_needed "$_turn" "$_tbun" 2>/dev/null; then
                        cp "$_turn" "$_tbun"
                    fi
                    _tin="$_repl_dir/tin.src"
                    printf '@mode repl\n' > "$_tin"
                    cat "$_tbun" >> "$_tin"
                    _rj=$(run_core_tool lcaas "$_tin" 2>/dev/null || true)
                    if printf '%s' "$_rj" | grep -q '"ok":true'; then
                        printf '%s\n' "$_code" | awk '/^[ \t]*(use|type|law|effect|pub|total|fn|@)[ \t]+/' >> "$_repl_defs"
                        if printf '%s' "$_rj" | grep -q '"text/plain":"<runtime>'; then
                            _rout=$(cmd_run "$_turn" 2>/dev/null | awk '{printf "%s\\n", $0}')
                            _rj=$(printf '%s' "$_rj" | sed "s|\"text/plain\":\"[^\"]*\"|\"text/plain\":\"$_rout\"|")
                        fi
                    fi
                    _rj=$(printf '%s' "$_rj" | sed "s/\"execution_count\":1/\"msg_type\":\"execute_reply\",\"execution_count\":$_exec_cnt/")
                    jsonrpc_send_msg "$_rj"
                    ;;
            esac
        done
        rm -rf "$_repl_dir"
        return 0
    fi

    while IFS= read -r _rline; do
        _rline=$(printf '%s' "$_rline" | tr -d '\r')
        _rtrim=$(printf '%s' "$_rline" | sed 's/^[ \t]*//;s/[ \t]*$//')
        [ -n "$_rtrim" ] || continue
        case "$_rtrim" in
            \#\#*) continue ;;
            :quit|:exit|:q) break ;;
            :reset)
                : > "$_repl_defs"
                printf 'reset\n'
                continue
                ;;
            :help)
                printf 'lume repl commands: :help :vars :reset :quit\n'
                continue
                ;;
            :vars|:symbols)
                _vbun="$_repl_dir/vbun.src"
                cp "$_repl_defs" "$_vbun"
                printf 'print 0\n' >> "$_vbun"
                run_core_tool lcaas "$_vbun"
                continue
                ;;
            use\ *|type\ *|law\ *|effect\ *|pub\ *|total\ *|fn\ *|@*)
                _cand="$_repl_dir/cand.src"
                cat "$_repl_defs" > "$_cand"
                printf '%s\n' "$_rtrim" >> "$_cand"
                _cbun="$_repl_dir/cbun.src"
                if ! bundle_src_if_needed "$_cand" "$_cbun" 2>/dev/null; then
                    cp "$_cand" "$_cbun"
                fi
                _cj=$(run_core_tool lcaas "$_cbun" 2>/dev/null || true)
                if printf '%s' "$_cj" | grep -q '"ok":true'; then
                    cp "$_cand" "$_repl_defs"
                    _exec_cnt=$((_exec_cnt + 1))
                    printf '[%d] defined\n' "$_exec_cnt"
                else
                    _emsg=$(jsonrpc_extract_str "$_cj" "message")
                    printf 'error: %s\n' "${_emsg:-compile error}"
                fi
                ;;
            *)
                _turn="$_repl_dir/turn.src"
                cat "$_repl_defs" > "$_turn"
                case "$_rtrim" in
                    print\ *) printf '%s\n' "$_rtrim" >> "$_turn" ;;
                    *)        printf 'print (%s)\n' "$_rtrim" >> "$_turn" ;;
                esac
                _tbun="$_repl_dir/tbun.src"
                if ! bundle_src_if_needed "$_turn" "$_tbun" 2>/dev/null; then
                    cp "$_turn" "$_tbun"
                fi
                _tj=$(run_core_tool lcaas "$_tbun" 2>/dev/null || true)
                if printf '%s' "$_tj" | grep -q '"ok":true'; then
                    _exec_cnt=$((_exec_cnt + 1))
                    _res=$(jsonrpc_extract_str "$_tj" "result")
                    case "$_res" in
                        *"<runtime>"*|"")
                            cmd_run "$_turn"
                            ;;
                        *)
                            printf '%s\n' "$_res"
                            ;;
                    esac
                else
                    _emsg=$(jsonrpc_extract_str "$_tj" "message")
                    printf 'error: %s\n' "${_emsg:-compile error}"
                fi
                ;;
        esac
    done
    rm -rf "$_repl_dir"
    return 0
}

cmd_certify() {
    [ $# -ge 1 ] || usage
    _cfile=""
    for _arg in "$@"; do
        case "$_arg" in
            --json) ;;
            -*) usage ;;
            *) _cfile=$_arg ;;
        esac
    done
    [ -n "$_cfile" ] || usage
    if [ ! -f "$_cfile" ]; then
        echo "lume certify: cannot read $_cfile" >&2
        exit 66
    fi
    _cbun=$(mktemp)
    if ! bundle_src_if_needed "$_cfile" "$_cbun"; then
        rm -f "$_cbun"
        exit 1
    fi
    _src_sha=$(sha256_file "$_cbun")
    _ctmp=$(mktemp)
    printf '@mode certify\n@sha256 %s\n' "$_src_sha" > "$_ctmp"
    cat "$_cbun" >> "$_ctmp"
    _cjson=$(run_core_tool lcaas "$_ctmp")
    rm -f "$_cbun" "$_ctmp"
    printf '%s\n' "$_cjson"
    case "$_cjson" in
        *'"ok":true'*) return 0 ;;
        *) return 1 ;;
    esac
}

