gen_lockfile() {
    _pdir=$1
    _mjson=$2
    _lkin=$(mktemp)
    printf '@cmd pkg-lock\n@manifest %s\n@manifest_sha256 %s\n' "$_mjson" "$(sha256_file "$_pdir/lume.toml")" > "$_lkin"
    for _sf in $(find "$_pdir" -maxdepth 2 \( -name '*.src' -o -name '*.lume' \) | LC_ALL=C sort); do
        _rel=${_sf#"$_pdir/"}
        printf '@module %s %s\n' "$_rel" "$(sha256_file "$_sf")" >> "$_lkin"
    done
    run_core_tool lcli "$_lkin"
    rm -f "$_lkin"
}

cmd_pkg() {
    [ $# -ge 1 ] || usage
    _action=$1
    shift
    _pdir="${1:-.}"
    case "$_action" in
        init)
            mkdir -p "$_pdir"
            _pkgname=$(basename -- "$(cd "$_pdir" && pwd)")
            if [ ! -f "$_pdir/lume.toml" ]; then
                _pi_in=$(mktemp)
                printf '@cmd pkg-init\n@pkg %s\n@part toml\n' "$_pkgname" > "$_pi_in"
                run_core_tool lcli "$_pi_in" > "$_pdir/lume.toml"
                rm -f "$_pi_in"
            fi
            if [ ! -f "$_pdir/main.src" ]; then
                _pi_in=$(mktemp)
                printf '@cmd pkg-init\n@pkg %s\n@part main\n' "$_pkgname" > "$_pi_in"
                run_core_tool lcli "$_pi_in" > "$_pdir/main.src"
                rm -f "$_pi_in"
            fi
            echo "lume pkg: initialized $_pkgname in $_pdir/lume.toml"
            ;;
        check|manifest)
            if [ ! -f "$_pdir/lume.toml" ]; then
                echo "lume pkg: missing $_pdir/lume.toml" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            echo "$_mjson"
            ;;
        lock)
            if [ ! -f "$_pdir/lume.toml" ]; then
                echo "lume pkg: missing $_pdir/lume.toml" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            gen_lockfile "$_pdir" "$_mjson" > "$_pdir/lume.lock"
            echo "lume pkg: wrote $_pdir/lume.lock"
            ;;
        verify)
            if [ ! -f "$_pdir/lume.toml" ] || [ ! -f "$_pdir/lume.lock" ]; then
                echo "lume pkg: missing lume.toml or lume.lock in $_pdir" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            _ltmp=$(mktemp)
            gen_lockfile "$_pdir" "$_mjson" > "$_ltmp"
            if ! cmp -s "$_pdir/lume.lock" "$_ltmp"; then
                rm -f "$_ltmp"
                echo "lume pkg: lockfile verification failed (source or manifest drift detected)" >&2
                exit 1
            fi
            rm -f "$_ltmp"
            echo "lume pkg: verified $_pdir/lume.lock (all SHA-256 digests match)"
            ;;
        tree)
            if [ ! -f "$_pdir/lume.toml" ]; then
                echo "lume pkg: missing $_pdir/lume.toml" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            _trin=$(mktemp)
            printf '@cmd pkg-tree\n@manifest %s\n' "$_mjson" > "$_trin"
            for _sf in $(find "$_pdir" -maxdepth 2 -name '*.src' | LC_ALL=C sort); do
                _rel=${_sf#"$_pdir/"}
                printf '@modsrc %s\n' "$_rel" >> "$_trin"
                cat "$_sf" >> "$_trin"
                printf '\n@end\n' >> "$_trin"
            done
            run_core_tool lcli "$_trin"
            rm -f "$_trin"
            ;;
        *)
            usage
            ;;
    esac
}

