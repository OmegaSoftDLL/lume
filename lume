prepend_evolve_pubkeys() {
    _pk_out=$1
    : > "$_pk_out"
    if [ -f "$ROOT/evolve/maintainers.pub" ]; then
        awk '!/^[ \t]*#/ && NF>=2 {print "@pubkey " $1 " " $2}' "$ROOT/evolve/maintainers.pub" >> "$_pk_out"
    fi
}

cmd_evolve() {
    [ $# -ge 1 ] || usage
    _eact=$1
    shift
    case "$_eact" in
        goals)
            cmd_run "$ROOT/evolve/goals.src"
            return 0
            ;;
        budgets)
            cmd_run "$ROOT/evolve/budgets.src"
            return 0
            ;;
        verify|propose|check|status)
            _efile=""
            for _arg in "$@"; do
                case "$_arg" in
                    --json) ;;
                    -*) usage ;;
                    *) _efile=$_arg ;;
                esac
            done
            [ -n "$_efile" ] || _efile="$ROOT/evolve/proposals/0001_math_clamp/proposal.bundle"
            if [ -d "$_efile" ] && [ -f "$_efile/proposal.bundle" ]; then
                _efile="$_efile/proposal.bundle"
            fi
            _etmp_goal=""
            if [ ! -f "$_efile" ] && [ "$_eact" = "propose" ]; then
                _etmp_goal=$(mktemp)
                _epin=$(mktemp)
                printf '@cmd evolve-propose\n@goal %s\n' "$_efile" > "$_epin"
                run_core_tool lcli "$_epin" > "$_etmp_goal"
                rm -f "$_epin"
                _efile="$_etmp_goal"
            fi
            if [ ! -f "$_efile" ]; then
                echo "lume evolve: cannot read $_efile" >&2
                exit 66
            fi
            if [ -f "$ROOT/build/bootstrap/lumec2" ] && [ -f "$ROOT/build/bootstrap/lumec3" ]; then
                if ! cmp -s "$ROOT/build/bootstrap/lumec2" "$ROOT/build/bootstrap/lumec3"; then
                    [ -n "$_etmp_goal" ] && rm -f "$_etmp_goal"
                    echo "lume evolve: stage2 != stage3 binary fixpoint failure" >&2
                    exit 1
                fi
            fi
            _evin=$(mktemp)
            prepend_evolve_pubkeys "$_evin"
            cat "$_efile" >> "$_evin"
            _ejson=$(run_core_tool levolve "$_evin")
            rm -f "$_evin"
            [ -n "$_etmp_goal" ] && rm -f "$_etmp_goal"
            printf '%s\n' "$_ejson"
            case "$_ejson" in
                *'"gates_ok":true'*) return 0 ;;
                *) return 1 ;;
            esac
            ;;
        approve)
            _efile=""
            _by="maintainer"
            _sig=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --by)
                        [ $# -ge 2 ] || usage
                        _by=$2
                        shift 2
                        ;;
                    --sig)
                        [ $# -ge 2 ] || usage
                        _sig=$2
                        shift 2
                        ;;
                    --json)
                        shift
                        ;;
                    -*)
                        usage
                        ;;
                    *)
                        _efile=$1
                        shift
                        ;;
                esac
            done
            [ -n "$_efile" ] || _efile="$ROOT/evolve/proposals/0001_math_clamp/proposal.bundle"
            if [ -d "$_efile" ] && [ -f "$_efile/proposal.bundle" ]; then
                _efile="$_efile/proposal.bundle"
            fi
            if [ ! -f "$_efile" ]; then
                echo "lume evolve: cannot read $_efile" >&2
                exit 66
            fi
            if [ -f "$ROOT/build/bootstrap/lumec2" ] && [ -f "$ROOT/build/bootstrap/lumec3" ]; then
                if ! cmp -s "$ROOT/build/bootstrap/lumec2" "$ROOT/build/bootstrap/lumec3"; then
                    echo "lume evolve: stage2 != stage3 binary fixpoint failure" >&2
                    exit 1
                fi
            fi
            _etmp=$(mktemp)
            prepend_evolve_pubkeys "$_etmp"
            cat "$_efile" >> "$_etmp"
            if [ -n "$_sig" ]; then
                printf '\n@approval signed:%s:%s\n' "$_by" "$_sig" >> "$_etmp"
            else
                printf '\n@approval approved:%s\n' "$_by" >> "$_etmp"
            fi
            _ejson=$(run_core_tool levolve "$_etmp")
            rm -f "$_etmp"
            printf '%s\n' "$_ejson"
            case "$_ejson" in
                *'"can_merge":true'*) return 0 ;;
                *) return 1 ;;
            esac
            ;;
        apply)
            _efile=""
            _by=""
            _sig=""
            _etarget=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --by)
                        [ $# -ge 2 ] || usage
                        _by=$2
                        shift 2
                        ;;
                    --sig)
                        [ $# -ge 2 ] || usage
                        _sig=$2
                        shift 2
                        ;;
                    --target)
                        [ $# -ge 2 ] || usage
                        _etarget=$2
                        shift 2
                        ;;
                    --json)
                        shift
                        ;;
                    -*)
                        usage
                        ;;
                    *)
                        _efile=$1
                        shift
                        ;;
                esac
            done
            [ -n "$_efile" ] || _efile="$ROOT/evolve/proposals/0003_decimal_clamp/proposal.bundle"
            if [ -d "$_efile" ] && [ -f "$_efile/proposal.bundle" ]; then
                _efile="$_efile/proposal.bundle"
            fi
            if [ ! -f "$_efile" ]; then
                echo "lume evolve: cannot read $_efile" >&2
                exit 66
            fi
            if [ -f "$ROOT/build/bootstrap/lumec2" ] && [ -f "$ROOT/build/bootstrap/lumec3" ]; then
                if ! cmp -s "$ROOT/build/bootstrap/lumec2" "$ROOT/build/bootstrap/lumec3"; then
                    echo "lume evolve: stage2 != stage3 binary fixpoint failure" >&2
                    exit 1
                fi
            fi
            _etmp=$(mktemp)
            prepend_evolve_pubkeys "$_etmp"
            cat "$_efile" >> "$_etmp"
            if [ -n "$_sig" ]; then
                printf '\n@approval signed:%s:%s\n' "${_by:-ricardo}" "$_sig" >> "$_etmp"
            elif [ -n "$_by" ]; then
                printf '\n@approval approved:%s\n' "$_by" >> "$_etmp"
            fi
            _ejson=$(run_core_tool levolve "$_etmp")
            case "$_ejson" in
                *'"can_merge":true'*'"signature_verified":true'*|*'"signature_verified":true'*'"can_merge":true'*) ;;
                *)
                    rm -f "$_etmp"
                    printf '%s\n' "$_ejson"
                    return 1
                    ;;
            esac
            if [ -z "$_etarget" ]; then
                _rel_t=$(awk '/^@target[ \t]+/{sub(/^@target[ \t]+/,""); sub(/[ \t\r]+$/,""); print; exit}' "$_efile")
                if [ -n "$_rel_t" ]; then
                    case "$_rel_t" in
                        /*) _etarget="$_rel_t" ;;
                        *)  _etarget="$ROOT/$_rel_t" ;;
                    esac
                fi
            fi
            if [ -z "$_etarget" ]; then
                rm -f "$_etmp"
                echo "lume evolve apply: proposal has no @target and --target was not specified" >&2
                return 1
            fi
            _etmp_app=$(mktemp)
            printf '@mode apply\n' > "$_etmp_app"
            cat "$_etmp" >> "$_etmp_app"
            _etmp_out=$(mktemp)
            if ! run_core_tool levolve "$_etmp_app" | tr -d '\r' > "$_etmp_out"; then
                rm -f "$_etmp" "$_etmp_app" "$_etmp_out"
                printf '%s\n' "$_ejson"
                return 1
            fi
            mv "$_etmp_out" "$_etarget"
            rm -f "$_etmp" "$_etmp_app"
            if grep -Eq '^fn[ \t]+test_' "$_etarget"; then
                if ! cmd_test "$_etarget" >/dev/null 2>&1; then
                    echo "lume evolve apply: target test suite failed after apply on $_etarget" >&2
                    return 1
                fi
            fi
            printf '%s\n' "$_ejson"
            return 0
            ;;
        *)
            usage
            ;;
    esac
}

