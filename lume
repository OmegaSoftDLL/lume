#!/bin/sh
# lume — single command-line tool for the Lume programming language (P28, Track T / T1).
#
# Subcommands:
#   lume build <file.src> [-o <out>]          compile Lume source to a native ELF binary (no C, no as/ld)
#   lume run   <file.src|file.lume> [args...] compile & run native (.src) or interpret (.lume/.lbe)
#   lume test  <file.src|file.lume>...        discover and run unit tests (fn test_*() and contracts)
#   lume doc   [--json] <file.src|file.lume>  extract module/item docs and contracts (Markdown or JSON)
#   lume fmt   [--check] <file.src|file.lume> format source to canonical layout (or check with --check)
#   lume pkg   <init|check|lock|verify|tree>  package manager: lume.toml manifest, capabilities & SHA-256 lume.lock
#   lume agent [check|compile|ast|...] <file> in-process compiler-as-a-service JSON protocol (E1b)
#   lume adapt c [--json] <header.h> [-o <out.src>] generate fail-closed C ABI adapters
#   lume prove [--json] <file.src>            static QF_LIA contract, invariant & law verification (V2/V3)
#   lume registry <publish|resolve|discover> verify and resolve content-addressed components
#   lume evolve <verify|approve|goals|...>    self-evolution & governance loop (E3)
#   lume check [--json] <file.lume|file.src>  static lexical, parse, name, type and contract checks
#   lume compile [--json] [--run] <file.src>  compile-as-a-service: {ok, diagnostics, asm, stdout} (E1, AI-first)
#   lume describe [--json]                    emit machine-readable language self-description (AI-first)
#   lume economy --output <results.json>      run real-execution economic benchmark evidence harness
#   lume mesh [--json] [request.mesh]         negotiate intent and run validated AST transactions (P0, partial)
#   lume --version | --help
set -eu
PATH="${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
export PATH

# The self-hosted lexer/parser recurse per source character; raise the stack so compiling a
# large Lume source does not overflow the default 8 MB stack.
ulimit -s unlimited 2>/dev/null || ulimit -s 524288 2>/dev/null || ulimit -s 65520 2>/dev/null || ulimit -s 32768 2>/dev/null || true

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -d "$ROOT/compiler/stage1" ] && [ -d "$ROOT/../compiler/stage1" ]; then
    ROOT=$(CDPATH= cd -- "$ROOT/.." && pwd)
fi
SRC_DIR="$ROOT/compiler/stage1"
L0="${LUME0_BIN:-$ROOT/bootstrap/lume0/lume0}"
if [ -z "${LUME0_BIN:-}" ]; then
    for _cand_l0 in "$ROOT/bootstrap/lume0/lume0" "$ROOT/bootstrap/lume0/lume0.exe" "$ROOT/bin/lume0" "$ROOT/bin/lume0.exe" "$ROOT/build/bin/lume0" "$ROOT/build/bin/lume0.exe"; do
        if [ -f "$_cand_l0" ] && [ -x "$_cand_l0" ]; then
            L0="$_cand_l0"
            break
        fi
    done
fi
BIN_DIR="${LUME_BIN_DIR:-$ROOT/build/bin}"

usage() {
    _u_in=$(mktemp)
    printf '@cmd help\n' > "$_u_in"
    run_core_tool lcli "$_u_in" >&2
    rm -f "$_u_in"
    exit 64
}

ensure_seed() {
    if [ -n "${LUME0_RUNNER:-}" ]; then
        return 0
    fi
    if [ ! -x "$L0" ]; then
        make -s -C "$ROOT/bootstrap/lume0"
    fi
}

run_l0() {
    if [ -n "${LUME0_RUNNER:-}" ]; then
        $LUME0_RUNNER "$L0" "$@"
    else
        "$L0" "$@"
    fi
}

is_linux_x86_64() {
    [ -z "${LUME0_RUNNER:-}" ] && [ "$(uname -s)" = "Linux" ] && [ "$(uname -m)" = "x86_64" ]
}

# Locate or build the native self-hosted compiler (lumec) and assembler (lasm).
ensure_native_toolchain() {
    mkdir -p "$BIN_DIR"
    if [ -x "$BIN_DIR/lc" ]; then
        LUMEC="$BIN_DIR/lc"
    elif [ -x "$BIN_DIR/lumec" ]; then
        LUMEC="$BIN_DIR/lumec"
    elif [ -x "$ROOT/bin/lumec" ]; then
        LUMEC="$ROOT/bin/lumec"
    elif [ -x "$ROOT/build/bootstrap/lumec3" ]; then
        LUMEC="$ROOT/build/bootstrap/lumec3"
    else
        ensure_seed
        # lumec.src is generated by amalgamating compiler/stage1/lume/*.src.
        run_l0 run "$SRC_DIR/data_asm_cc.lume" "$ROOT/scripts/amalgamate.src" "$BIN_DIR/amalgamate.s" >/dev/null 2>&1
        run_l0 asm "$BIN_DIR/amalgamate.s" "$BIN_DIR/amalgamate" >/dev/null 2>&1
        chmod +x "$BIN_DIR/amalgamate"
        printf '@root %s\n' "$ROOT" | "$BIN_DIR/amalgamate" >/dev/null 2>&1
        rm -f "$BIN_DIR/amalgamate.s"
        run_l0 run "$SRC_DIR/data_asm_cc.lume" "$SRC_DIR/lumec.src" "$BIN_DIR/lumec.s" >/dev/null 2>&1
        run_l0 asm "$BIN_DIR/lumec.s" "$BIN_DIR/lumec" >/dev/null 2>&1
        chmod +x "$BIN_DIR/lumec"
        rm -f "$BIN_DIR/lumec.s"
        LUMEC="$BIN_DIR/lumec"
    fi

    if [ -x "$BIN_DIR/lasm" ]; then
        LASM="$BIN_DIR/lasm"
    elif [ -x "$ROOT/bin/lasm" ]; then
        LASM="$ROOT/bin/lasm"
    elif [ -x "$ROOT/build/bootstrap/lasm3" ]; then
        LASM="$ROOT/build/bootstrap/lasm3"
    else
        ensure_seed
        "$LUMEC" < "$SRC_DIR/lasm.src" > "$BIN_DIR/lasm.s"
        run_l0 asm "$BIN_DIR/lasm.s" "$BIN_DIR/lasm" >/dev/null 2>&1
        chmod +x "$BIN_DIR/lasm"
        rm -f "$BIN_DIR/lasm.s"
        LASM="$BIN_DIR/lasm"
    fi
}

# Build a Lume-Core tool (e.g. lcli, ldoc, ltest, lfmt, levolve) to a native ELF using lumec + lasm.
ensure_core_tool() {
    if [ -x "$BIN_DIR/$1" ]; then
        return 0
    fi
    mkdir -p "$BIN_DIR"
    if [ -x "$ROOT/bin/$1" ]; then
        cp "$ROOT/bin/$1" "$BIN_DIR/$1"
        chmod +x "$BIN_DIR/$1"
        return 0
    fi
    if [ "$1" = "lcli" ] && [ -x "$ROOT/build/bootstrap/lcli3" ]; then
        cp "$ROOT/build/bootstrap/lcli3" "$BIN_DIR/lcli"
        chmod +x "$BIN_DIR/lcli"
        return 0
    fi
    ensure_native_toolchain
    if [ "$1" = "lmod" ] || ! grep -Eq '^[ \t]*use[ \t]+' "$SRC_DIR/$1.src"; then
        "$LUMEC" < "$SRC_DIR/$1.src" > "$BIN_DIR/$1.s"
        "$LASM" < "$BIN_DIR/$1.s" > "$BIN_DIR/$1"
        chmod +x "$BIN_DIR/$1"
        rm -f "$BIN_DIR/$1.s"
    else
        ensure_core_tool lmod
        _ect_bun=$(mktemp)
        bundle_src_if_needed "$SRC_DIR/$1.src" "$_ect_bun"
        "$LUMEC" < "$_ect_bun" > "$BIN_DIR/$1.s"
        "$LASM" < "$BIN_DIR/$1.s" > "$BIN_DIR/$1"
        chmod +x "$BIN_DIR/$1"
        rm -f "$_ect_bun" "$BIN_DIR/$1.s"
    fi
}

# Run a Lume-Core tool (<tool>.src) with $2 as its stdin file, writing to stdout.
run_core_tool() {
    if is_linux_x86_64 && [ -z "${LUME0_ASAN:-}" ]; then
        ensure_core_tool "$1"
        "$BIN_DIR/$1" < "$2"
    else
        ensure_seed
        if [ "$1" = "lmod" ] || ! grep -Eq '^[ \t]*use[ \t]+' "$SRC_DIR/$1.src"; then
            run_l0 run "$SRC_DIR/compiler_in_core.lume" "$SRC_DIR/$1.src" "$2"
        else
            _rct_ck=$(cksum "$SRC_DIR/$1.src" 2>/dev/null | awk '{print $1"_"$2}')
            _rct_bun="${TMPDIR:-/tmp}/lume_bun_${1}_${_rct_ck}.src"
            if [ ! -s "$_rct_bun" ]; then
                _rct_tmp=$(mktemp)
                bundle_src_if_needed "$SRC_DIR/$1.src" "$_rct_tmp"
                mv "$_rct_tmp" "$_rct_bun"
            fi
            run_l0 run "$SRC_DIR/compiler_in_core.lume" "$_rct_bun" "$2"
        fi
    fi
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        echo "lume: SHA-256 requires sha256sum, shasum, or openssl" >&2
        return 1
    fi
}

# Recursively collect reachable `use <mod>` .src modules in $_mdir into $_modin.
collect_reachable_mods() {
    _mdir=$1
    _mfile=$2
    _modin=$3
    _uses=$(awk '/^[ \t]*use[ \t]+/{sub(/^[ \t]*use[ \t]+/,""); sub(/[ \t\r]+$/,""); sub(/^std\./,""); print $1}' "$_mfile")
    for _u in $_uses; do
        case " $_MOD_SEEN " in
            *" $_u "*) continue ;;
        esac
        _MOD_SEEN="$_MOD_SEEN $_u"
        _ucand=""
        if [ -f "$_mdir/$_u.src" ]; then
            _ucand="$_mdir/$_u.src"
        elif [ -f "$_mdir/src/$_u.src" ]; then
            _ucand="$_mdir/src/$_u.src"
        elif [ -f "$_mdir/deps/$_u.src" ]; then
            _ucand="$_mdir/deps/$_u.src"
        elif [ -f "$SRC_DIR/$_u.src" ]; then
            _ucand="$SRC_DIR/$_u.src"
        fi
        if [ -n "$_ucand" ]; then
            printf '@module %s\n' "$_u" >> "$_modin"
            cat "$_ucand" >> "$_modin"
            printf '\n@end\n' >> "$_modin"
            collect_reachable_mods "$_mdir" "$_ucand" "$_modin"
        fi
    done
}

# Resolve `use <mod>` imports and verify lume.toml capability grants via native lmod.src.
bundle_src_if_needed() {
    _bsrc=$1
    _bout=$2
    if ! grep -Eq '^[ \t]*use[ \t]+' "$_bsrc"; then
        cp "$_bsrc" "$_bout"
        return 0
    fi
    _bdir=$(dirname -- "$_bsrc")
    _modin=$(mktemp)
    _grant="io"
    _toml=""
    if [ -f "$_bdir/lume.toml" ]; then
        _toml="$_bdir/lume.toml"
    elif [ -f "$_bdir/../lume.toml" ]; then
        _toml="$_bdir/../lume.toml"
    fi
    if [ -n "$_toml" ]; then
        _mtmp=$(mktemp)
        printf '@manifest\n' > "$_mtmp"
        cat "$_toml" >> "$_mtmp"
        if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
            rm -f "$_mtmp" "$_modin"
            return 1
        fi
        rm -f "$_mtmp"
        case "$_mjson" in
            *'"capabilities":"pure"'*) _grant="pure" ;;
        esac
    fi
    printf '@grant %s\n' "$_grant" > "$_modin"
    _ebase=$(basename -- "$_bsrc" .src)
    _MOD_SEEN="$_ebase"
    collect_reachable_mods "$_bdir" "$_bsrc" "$_modin"
    printf '@entry %s\n' "$_ebase" >> "$_modin"
    cat "$_bsrc" >> "$_modin"
    printf '\n@end\n' >> "$_modin"
    if ! run_core_tool lmod "$_modin" > "$_bout"; then
        rm -f "$_modin" "$_bout"
        return 1
    fi
    rm -f "$_modin"
}

hex_to_bin_file() {
    if command -v perl >/dev/null 2>&1; then
        printf '%s' "$1" | perl -pe 's/\s+//g; $_ = pack("H*", $_)' > "$2"
    elif command -v xxd >/dev/null 2>&1; then
        printf '%s' "$1" | xxd -r -p > "$2"
    elif command -v python3 >/dev/null 2>&1; then
        printf '%s' "$1" | python3 -c 'import sys; sys.stdout.buffer.write(bytes.fromhex(sys.stdin.read().strip()))' > "$2"
    else
        printf '%s' "$1" | sed 's/../\\x&/g' | xargs -0 printf "%b" > "$2"
    fi
}

cmd_targets() {
    _t_in=$(mktemp)
    printf '@targets-json\n' > "$_t_in"
    run_core_tool ltarget "$_t_in"
    rm -f "$_t_in"
}

cmd_build() {
    _src=""
    _out=""
    _target=""
    _protect=""
    _profile=""
    _lsym=""
    _links=""
    _chdr=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -o)
                [ $# -ge 2 ] || usage
                _out=$2
                shift 2
                ;;
            --target)
                [ $# -ge 2 ] || usage
                _target=$2
                shift 2
                ;;
            --target=*)
                _target=${1#--target=}
                shift
                ;;
            --link|-l)
                [ $# -ge 2 ] || usage
                _links="$_links $2"
                shift 2
                ;;
            --link=*)
                _links="$_links ${1#--link=}"
                shift
                ;;
            -l*)
                _links="$_links ${1#-l}"
                shift
                ;;
            --emit-c-header)
                [ $# -ge 2 ] || usage
                _chdr=$2
                shift 2
                ;;
            --emit-c-header=*)
                _chdr=${1#--emit-c-header=}
                shift
                ;;
            --protect)
                if [ $# -ge 2 ] && case "$2" in none|standard|hardened|max) true ;; *) false ;; esac; then
                    _protect=$2
                    shift 2
                else
                    _protect="standard"
                    shift
                fi
                ;;
            --protect=*)
                _protect=${1#--protect=}
                shift
                ;;
            --profile)
                [ $# -ge 2 ] || usage
                _profile=$2
                shift 2
                ;;
            --profile=*)
                _profile=${1#--profile=}
                shift
                ;;
            --lsym)
                [ $# -ge 2 ] || usage
                _lsym=$2
                shift 2
                ;;
            --lsym=*)
                _lsym=${1#--lsym=}
                shift
                ;;
            -*)
                usage
                ;;
            *)
                [ -z "$_src" ] || usage
                _src=$1
                shift
                ;;
        esac
    done
    [ -n "$_src" ] || usage
    if [ ! -f "$_src" ]; then
        echo "lume build: cannot read $_src" >&2
        exit 66
    fi
    if [ -z "$_out" ]; then
        _out="${_src%.src}"
        _out="${_out%.intent}"
        if [ "$_out" = "$_src" ]; then
            _out="$_src.out"
        fi
    fi
    case "$_src" in
        *.intent)
            _icache="${_src}.cache.src"
            if ! synthesize_intent_to_cache "$_src" "$_icache"; then
                rm -f "$_out"
                exit 3
            fi
            _src="$_icache"
            ;;
    esac
    if [ -z "$_protect" ] && [ -n "$_profile" ]; then
        case "$_profile" in
            release) _protect="standard" ;;
            ship)    _protect="hardened" ;;
            debug)   _protect="none" ;;
        esac
    fi
    _bdir=$(dirname -- "$_src")
    _btoml=""
    if [ -f "$_bdir/lume.toml" ]; then
        _btoml="$_bdir/lume.toml"
    elif [ -f "$_bdir/../lume.toml" ]; then
        _btoml="$_bdir/../lume.toml"
    fi
    if [ -n "$_btoml" ] && grep -Eq '^[ \t]*(protect|libs|link)[ \t]*=' "$_btoml"; then
        _mtmp=$(mktemp)
        printf '@manifest\n' > "$_mtmp"
        cat "$_btoml" >> "$_mtmp"
        if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
            rm -f "$_mtmp" "$_out"
            exit 1
        fi
        rm -f "$_mtmp"
        if [ -z "$_protect" ]; then
            case "$_mjson" in
                *'"protect":"max"'*)      _protect="max" ;;
                *'"protect":"hardened"'*) _protect="hardened" ;;
                *'"protect":"standard"'*) _protect="standard" ;;
            esac
        fi
        case "$_mjson" in
            *'"ffi_libs":'*)
                _mlibs=$(printf '%s' "$_mjson" | sed -n 's/.*"ffi_libs":\[\([^]]*\)\].*/\1/p' | tr ',"' '  ')
                for _ml in $_mlibs; do
                    _links="$_links $_ml"
                done
                ;;
        esac
    fi
    _bundled=$(mktemp)
    if ! bundle_src_if_needed "$_src" "$_bundled"; then
        rm -f "$_bundled" "$_out"
        exit 1
    fi
    if [ -z "$_target" ]; then
        case "$_out" in
            *.lumb) _target="lumb" ;;
            *.ptx) _target="nvptx64-nvidia-cuda" ;;
            *.spvasm) _target="spirv64-vulkan-compute" ;;
            *.v) _target="verilog-rtl" ;;
            *.vhd) _target="vhdl-rtl" ;;
            *.cortexm) _target="arm-none-cortexm" ;;
            *.avr.elf) _target="avr-none-elf" ;;
            *.xtensa.elf) _target="xtensa-esp32-elf" ;;
            *.avr.hex|*.avr.ihex) _target="avr-none-ihex" ;;
            *.xtensa.hex|*.xtensa.ihex) _target="xtensa-none-ihex" ;;
            *.hex|*.ihex) _target="aarch64-none-ihex" ;;
        esac
    fi
    if [ -n "$_target" ] && [ "$_target" != "x86_64-linux-elf" ] && [ "$_target" != "linux-x86_64" ] && [ "$_target" != "x86_64-unknown-linux-gnu" ] && [ "$_target" != "x86_64-none-raw" ] && [ "$_target" != "x86_64-none-mbr" ]; then
        _tin=$(mktemp)
        printf '@compile %s\n' "$_target" > "$_tin"
        cat "$_bundled" >> "$_tin"
        _tres=$(run_core_tool ltarget "$_tin" | tr -d '\r')
        rm -f "$_tin" "$_bundled"
        case "$_tres" in
            ERR:*)
                printf '%s\n' "${_tres#ERR:}" >&2
                rm -f "$_out"
                exit 3
                ;;
            IHEX:*)
                printf '%s\n' "$_tres" | sed '1d' > "$_out"
                return 0
                ;;
            HEX:*)
                _thex=${_tres#HEX:*:}
                hex_to_bin_file "$_thex" "$_out"
                chmod +x "$_out" 2>/dev/null || true
                if [ "$(uname -s)" = "Darwin" ]; then
                    case "$_target" in
                        *macos*|*darwin*)
                            _march="arm64"
                            case "$_target" in
                                *x86_64*) _march="x86_64" ;;
                            esac
                            if command -v perl >/dev/null 2>&1 && command -v cc >/dev/null 2>&1; then
                                _ms=$(mktemp).s
                                perl -e '
                                    open my $fh, "<:raw", $ARGV[0] or die;
                                    local $/; my $b = <$fh>;
                                    my ($csz) = unpack("Q<", substr($b, 216, 8));
                                    my $code = substr($b, 1024, $csz);
                                    print ".globl _main\n.p2align 2\n_main:\n.byte ";
                                    print join(",", unpack("C*", $code)) . "\n";
                                ' "$_out" > "$_ms" 2>/dev/null && cc -arch "$_march" "$_ms" -o "$_out" 2>/dev/null || true
                                rm -f "$_ms"
                            fi
                            ;;
                    esac
                fi
                return 0
                ;;
            *)
                printf 'lume build: unexpected target compiler output for %s\n' "$_target" >&2
                exit 1
                ;;
        esac
    fi
    if [ -n "$_chdr" ] || case "$_out" in *.wat|*.wasm|*.a|*.so) true ;; *) false ;; esac; then
        _ce_in=$(mktemp)
        printf '@mode c-export\n' > "$_ce_in"
        cat "$_bundled" >> "$_ce_in"
        _ce_json=$(run_core_tool lcaas "$_ce_in")
        rm -f "$_ce_in"
        if [ -n "$_chdr" ]; then
            jsonrpc_extract_str "$_ce_json" "c_header" > "$_chdr"
            printf '\n' >> "$_chdr"
        fi
        case "$_out" in
            *.wat)
                case "$_ce_json" in
                    *'"ok":false'*)
                        printf '%s\n' "$_ce_json" >&2
                        rm -f "$_bundled" "$_out"
                        exit 3
                        ;;
                esac
                jsonrpc_extract_str "$_ce_json" "wat" > "$_out"
                printf '\n' >> "$_out"
                rm -f "$_bundled"
                return 0
                ;;
            *.wasm)
                case "$_ce_json" in
                    *'"ok":false'*)
                        printf '%s\n' "$_ce_json" >&2
                        rm -f "$_bundled" "$_out"
                        exit 3
                        ;;
                esac
                _whex=$(jsonrpc_extract_str "$_ce_json" "wasm_hex")
                printf '%s' "$_whex" | sed 's/../\\x&/g' | xargs -0 printf "%b" > "$_out"
                rm -f "$_bundled"
                return 0
                ;;
        esac
    fi
    ensure_native_toolchain
    _tmps=$(mktemp)
    if ! "$LUMEC" < "$_bundled" > "$_tmps"; then
        rm -f "$_bundled" "$_tmps" "$_out"
        exit 1
    fi
    if [ -n "$_protect" ] && [ "$_protect" != "none" ]; then
        case "$_protect" in
            standard|hardened|max) ;;
            *)
                echo "lume build: invalid --protect level '$_protect' (expected none|standard|hardened|max)" >&2
                rm -f "$_bundled" "$_tmps" "$_out"
                exit 64
                ;;
        esac
        if [ -z "$_lsym" ]; then
            _lsym="$_out.lsym"
        fi
        _pin=$(mktemp)
        printf '@lsym %s\n' "$_protect" > "$_pin"
        cat "$_tmps" >> "$_pin"
        run_core_tool lprotect "$_pin" | tr -d '\r' > "$_lsym"
        printf '@asm %s\n' "$_protect" > "$_pin"
        cat "$_tmps" >> "$_pin"
        _tmps_prot=$(mktemp)
        run_core_tool lprotect "$_pin" > "$_tmps_prot"
        mv "$_tmps_prot" "$_tmps"
        rm -f "$_pin"
    fi
    case "$_out" in
        *.a)
            if [ -z "$_chdr" ]; then
                jsonrpc_extract_str "$_ce_json" "c_header" > "${_out%.a}.h"
                printf '\n' >> "${_out%.a}.h"
            fi
            sed 's/\.globl _start/.globl __lume_mod_init/; s/^_start:/__lume_mod_init:/' "$_tmps" > "$_tmps.lib.s"
            _tmpo="$_tmps.o"
            if ! ${CC:-cc} -c -x assembler "$_tmps.lib.s" -o "$_tmpo"; then
                rm -f "$_bundled" "$_tmps" "$_tmps.lib.s" "$_tmpo" "$_out"
                exit 1
            fi
            rm -f "$_out"
            ${AR:-ar} rcs "$_out" "$_tmpo"
            rm -f "$_bundled" "$_tmps" "$_tmps.lib.s" "$_tmpo"
            return 0
            ;;
        *.so)
            if [ -z "$_chdr" ]; then
                jsonrpc_extract_str "$_ce_json" "c_header" > "${_out%.so}.h"
                printf '\n' >> "${_out%.so}.h"
            fi
            sed 's/\.globl _start/.globl __lume_mod_init/; s/^_start:/__lume_mod_init:/' "$_tmps" > "$_tmps.lib.s"
            if ! ${CC:-cc} -shared -fno-lto -x assembler "$_tmps.lib.s" -o "$_out"; then
                rm -f "$_bundled" "$_tmps" "$_tmps.lib.s" "$_out"
                exit 1
            fi
            rm -f "$_bundled" "$_tmps" "$_tmps.lib.s"
            return 0
            ;;
    esac
    _has_static_link=0
    _need_hdr=""
    for _lk in $_links; do
        case "$_lk" in
            *.a|*.o)
                _has_static_link=1
                ;;
            c)
                _need_hdr="${_need_hdr}    .need \"libc.so.6\"\n"
                ;;
            m)
                _need_hdr="${_need_hdr}    .need \"libm.so.6\"\n"
                ;;
            *.so*)
                _need_hdr="${_need_hdr}    .need \"$(basename -- "$_lk")\"\n"
                ;;
            *)
                _need_hdr="${_need_hdr}    .need \"lib${_lk}.so\"\n"
                ;;
        esac
    done
    if [ "$_has_static_link" -eq 1 ]; then
        sed '/^[ \t]*\.need /d; /^[ \t]*\.extern /d' "$_tmps" > "$_tmps.st.s"
        if ! ${CC:-cc} -nostartfiles -no-pie -x assembler "$_tmps.st.s" -x none $_links -o "$_out"; then
            rm -f "$_bundled" "$_tmps" "$_tmps.st.s" "$_out"
            exit 1
        fi
        chmod +x "$_out"
        rm -f "$_bundled" "$_tmps" "$_tmps.st.s"
        return 0
    fi
    if [ -n "$_need_hdr" ]; then
        _tmps_nd=$(mktemp)
        printf '%b' "$_need_hdr" > "$_tmps_nd"
        cat "$_tmps" >> "$_tmps_nd"
        mv "$_tmps_nd" "$_tmps"
    fi
    "$LASM" < "$_tmps" > "$_out"
    chmod +x "$_out"
    rm -f "$_bundled" "$_tmps"
}

cmd_run() {
    [ $# -ge 1 ] || usage
    _file=$1
    shift
    if [ ! -f "$_file" ]; then
        echo "lume run: cannot read $_file" >&2
        exit 66
    fi
    case "$_file" in
        *.lumb)
            if command -v perl >/dev/null 2>&1; then
                perl -e '
                    open my $fh, "<:raw", $ARGV[0] or die;
                    local $/; my $b = <$fh>;
                    if (length($b) < 16 || substr($b, 0, 5) ne "LUMB\x01") {
                        print STDERR "[T0902] error: invalid LUMB bytecode container\n";
                        exit 3;
                    }
                    my $st = ord(substr($b, 5, 1));
                    if ($st != 0) { exit $st; }
                    my $out = substr($b, 16);
                    print "$out\n" if length($out) > 0;
                ' "$_file"
                return $?
            fi
            ;;
        *.ptx|*.spvasm|*.v|*.vhd|*.avr.hex|*.avr.ihex|*.xtensa.hex|*.xtensa.ihex)
            _rt_in=$(mktemp)
            case "$_file" in
                *.ptx)               printf '@run-ptx\n' > "$_rt_in" ;;
                *.spvasm)            printf '@run-spirv\n' > "$_rt_in" ;;
                *.v|*.vhd)           printf '@run-hdl\n' > "$_rt_in" ;;
                *.avr.hex|*.avr.ihex)       printf '@run-mcu-ihex avr\n' > "$_rt_in" ;;
                *.xtensa.hex|*.xtensa.ihex) printf '@run-mcu-ihex xtensa\n' > "$_rt_in" ;;
            esac
            cat "$_file" >> "$_rt_in"
            _rt_res=$(run_core_tool ltarget "$_rt_in" | tr -d '\r')
            rm -f "$_rt_in"
            case "$_rt_res" in
                TRAP:3*)
                    exit 3
                    ;;
                ERR:*)
                    printf '%s\n' "${_rt_res#ERR:}" >&2
                    exit 1
                    ;;
                OK:*)
                    printf '%s\n' "$_rt_res" | sed '1d'
                    return 0
                    ;;
                *)
                    exit 1
                    ;;
            esac
            ;;
        *.cortexm|*.avr.elf|*.xtensa.elf)
            _rt_in=$(mktemp)
            case "$_file" in
                *.cortexm)    printf '@run-mcu-hex cortexm\n' > "$_rt_in" ;;
                *.avr.elf)    printf '@run-mcu-hex avr\n' > "$_rt_in" ;;
                *.xtensa.elf) printf '@run-mcu-hex xtensa\n' > "$_rt_in" ;;
            esac
            od -An -tx1 "$_file" | tr -d ' \n\r' >> "$_rt_in"
            printf '\n' >> "$_rt_in"
            _rt_res=$(run_core_tool ltarget "$_rt_in" | tr -d '\r')
            rm -f "$_rt_in"
            case "$_rt_res" in
                TRAP:3*)
                    exit 3
                    ;;
                ERR:*)
                    printf '%s\n' "${_rt_res#ERR:}" >&2
                    exit 1
                    ;;
                OK:*)
                    printf '%s\n' "$_rt_res" | sed '1d'
                    return 0
                    ;;
                *)
                    exit 1
                    ;;
            esac
            ;;
        *.wasm)
            if command -v node >/dev/null 2>&1; then
                node --no-warnings -e 'const fs=require("fs"),{WASI}=require("wasi");const wasi=new WASI({version:"preview1"});const m=new WebAssembly.Module(fs.readFileSync(process.argv[1]));const imp=Object.assign({},wasi.getImportObject(),{env:{dom_append_int:(v)=>console.log(v),dom_set_attr:(k,v)=>{},web_trap:(c)=>process.exit(c)}});const i=new WebAssembly.Instance(m,imp);if(typeof i.exports.lume_web_main==="function"){i.exports.lume_web_main();process.exit(0);}process.exit(wasi.start(i)||0);' "$_file"
                return $?
            fi
            ;;
        *.intent)
            _icache="${_file}.cache.src"
            if ! synthesize_intent_to_cache "$_file" "$_icache"; then
                exit 3
            fi
            cmd_run "$_icache" "$@"
            return $?
            ;;
        *.src)
            if is_linux_x86_64 && [ -z "${LUME0_ASAN:-}" ]; then
                _tmpbin=$(mktemp)
                cmd_build "$_file" -o "$_tmpbin"
                _rc=0
                "$_tmpbin" "$@" || _rc=$?
                rm -f "$_tmpbin"
                return $_rc
            else
                _bundled=$(mktemp)
                if ! bundle_src_if_needed "$_file" "$_bundled"; then
                    rm -f "$_bundled"
                    exit 1
                fi
                ensure_seed
                _rc=0
                run_l0 run "$SRC_DIR/compiler_in_core.lume" "$_bundled" "$@" || _rc=$?
                rm -f "$_bundled"
                return $_rc
            fi
            ;;
        *)
            ensure_seed
            run_l0 run "$_file" "$@"
            ;;
    esac
}

# E1 — compiler-as-a-service: compile a .src and report a machine-readable result
# (ok, exit, asm line count, diagnostics, and with --run the native stdout). This is
# the programmatic surface the self-evolution loop (E3) and AI agents consume; the
# compiler itself is unchanged (source in -> diagnostics / asm / result out).
cmd_compile() {
    _json=0
    _run=0
    _file=""
    for _arg in "$@"; do
        case "$_arg" in
            --json) _json=1 ;;
            --run) _run=1 ;;
            -*) usage ;;
            *) _file=$_arg ;;
        esac
    done
    [ -n "$_file" ] || usage
    if [ ! -f "$_file" ]; then
        echo "lume compile: cannot read $_file" >&2
        exit 66
    fi
    case "$_file" in
        *.src) : ;;
        *) echo "lume compile: expects a .src Lume-Core file" >&2; exit 64 ;;
    esac
    _bundled=$(mktemp)
    if ! bundle_src_if_needed "$_file" "$_bundled"; then
        rm -f "$_bundled"
        exit 1
    fi
    _asm=$(mktemp)
    _diag=$(mktemp)
    _exit=0
    if is_linux_x86_64 && { [ -x "$BIN_DIR/lc" ] || [ -x "$BIN_DIR/lumec" ] || [ -z "${LUME0_ASAN:-}" ]; }; then
        ensure_native_toolchain
        "$LUMEC" < "$_bundled" > "$_asm" 2> "$_diag" || _exit=$?
    else
        ensure_seed
        run_l0 run "$SRC_DIR/data_asm_cc.lume" "$_bundled" "$_asm" > "$_diag" 2>&1 || _exit=$?
    fi
    _asmlines=$(wc -l < "$_asm" | tr -d ' ')
    _didrun=0
    _ranexit=0
    _runout=$(mktemp)
    _bin=$(mktemp)
    if [ "$_exit" -eq 0 ] && [ "$_run" -eq 1 ]; then
        _didrun=1
        if is_linux_x86_64 && { [ -x "$BIN_DIR/lc" ] || [ -x "$BIN_DIR/lumec" ] || [ -z "${LUME0_ASAN:-}" ]; }; then
            ensure_native_toolchain
            "$LASM" < "$_asm" > "$_bin" 2>/dev/null; chmod +x "$_bin"
        else
            ensure_seed
            run_l0 asm "$_asm" "$_bin" >/dev/null 2>&1; chmod +x "$_bin"
        fi
        "$_bin" > "$_runout" 2>/dev/null || _ranexit=$?
    fi
    if [ "$_json" -eq 1 ]; then
        _cjin=$(mktemp)
        printf '@cmd compile-json\n@exit %s\n@asm_lines %s\n@ran %s\n@run_exit %s\n@diag\n' "$_exit" "$_asmlines" "$_didrun" "$_ranexit" > "$_cjin"
        cat "$_diag" >> "$_cjin"
        printf '\n@end\n@stdout\n' >> "$_cjin"
        cat "$_runout" >> "$_cjin"
        printf '\n@end\n' >> "$_cjin"
        run_core_tool lcli "$_cjin"
        rm -f "$_cjin"
    elif [ "$_exit" -eq 0 ]; then
        echo "lume compile: $_file OK ($_asmlines asm lines)" >&2
        cat "$_asm"
    else
        cat "$_diag" >&2
    fi
    rm -f "$_bundled" "$_asm" "$_diag" "$_runout" "$_bin"
    return $_exit
}

