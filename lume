cmd_prove() {
    [ $# -ge 1 ] || usage
    _pfile=""
    _pfile2=""
    _pmode=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) shift ;;
            --diff) _pmode="proof-diff"; shift ;;
            --share) _pmode="share"; shift ;;
            --compositional) _pmode="compose"; shift ;;
            -*) usage ;;
            *)
                if [ -z "$_pfile" ]; then
                    _pfile=$1
                else
                    _pfile2=$1
                fi
                shift
                ;;
        esac
    done
    [ -n "$_pfile" ] || usage
    if [ "$_pmode" = "proof-diff" ] || [ "$_pmode" = "compose" ]; then
        [ -n "$_pfile2" ] || usage
        cmd_agent "$_pmode" "$_pfile" "$_pfile2"
        return $?
    fi
    if [ "$_pmode" = "share" ]; then
        cmd_agent share "$_pfile"
        return $?
    fi
    if [ ! -f "$_pfile" ]; then
        echo "lume prove: cannot read $_pfile" >&2
        exit 66
    fi
    case "$_pfile" in
        *.intent)
            cmd_intent build --json "$_pfile"
            return $?
            ;;
    esac
    _pbun=$(mktemp)
    if ! bundle_src_if_needed "$_pfile" "$_pbun"; then
        rm -f "$_pbun"
        exit 1
    fi
    _pjson=$(run_core_tool lcaas "$_pbun")
    rm -f "$_pbun"
    printf '%s\n' "$_pjson"
    case "$_pjson" in
        *'"ok":true'*) return 0 ;;
        *) return 1 ;;
    esac
}

cmd_self() {
    _sact="status"
    if [ $# -ge 1 ]; then
        case "$1" in
            status|verify|update) _sact=$1; shift ;;
        esac
    fi
    _sprefix="${LUME_HOME:-}"
    _sfrom=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --prefix)
                [ $# -ge 2 ] || usage
                _sprefix=$2
                shift 2
                ;;
            --from)
                [ $# -ge 2 ] || usage
                _sfrom=$2
                shift 2
                ;;
            --json)
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
    if [ -z "$_sprefix" ]; then
        if [ -f "$ROOT/MANIFEST.sha256" ]; then
            _sprefix="$ROOT"
        elif [ -d "$HOME/.lume" ] && [ -f "$HOME/.lume/MANIFEST.sha256" ]; then
            _sprefix="$HOME/.lume"
        else
            _sprefix="$ROOT"
        fi
    fi
    case "$_sact" in
        status|verify)
            if [ -f "$_sprefix/MANIFEST.sha256" ]; then
                _v_ok=1
                _v_cnt=0
                _v_bad=""
                while IFS=' ' read -r _ehash _epath; do
                    _epath=${_epath#\*}
                    _epath=${_epath# }
                    [ -n "$_ehash" ] && [ -n "$_epath" ] || continue
                    if [ ! -f "$_sprefix/$_epath" ]; then
                        _v_ok=0
                        _v_bad="$_epath (missing)"
                        break
                    fi
                    _ahash=$(sha256_file "$_sprefix/$_epath")
                    if [ "$_ahash" != "$_ehash" ]; then
                        _v_ok=0
                        _v_bad="$_epath (sha256 mismatch)"
                        break
                    fi
                    _v_cnt=$((_v_cnt + 1))
                done < "$_sprefix/MANIFEST.sha256"
                if [ "$_v_ok" -eq 1 ] && [ "$_v_cnt" -gt 0 ]; then
                    printf '{"ok":true,"command":"self-%s","version":"0.2.0","edition":"2026","prefix":"%s","zero_c_required":true,"manifest_verified":true,"verified_files":%d}\n' "$_sact" "$_sprefix" "$_v_cnt"
                    return 0
                else
                    printf '{"ok":false,"command":"self-%s","version":"0.2.0","prefix":"%s","manifest_verified":false,"error":"manifest verification failed: %s"}\n' "$_sact" "$_sprefix" "$_v_bad"
                    return 1
                fi
            else
                if [ "$_sact" = "verify" ]; then
                    printf '{"ok":false,"command":"self-verify","version":"0.2.0","prefix":"%s","manifest_verified":false,"mode":"in-tree","error":"MANIFEST.sha256 not found"}\n' "$_sprefix"
                    return 1
                fi
                printf '{"ok":true,"command":"self-status","version":"0.2.0","edition":"2026","prefix":"%s","zero_c_required":true,"manifest_verified":false,"mode":"in-tree"}\n' "$_sprefix"
                return 0
            fi
            ;;
        update)
            [ -n "$_sfrom" ] || _sfrom="$BIN_DIR"
            sh "$ROOT/scripts/install.sh" --prefix "$_sprefix" --from-dir "$_sfrom" >/dev/null
            if [ -f "$_sprefix/MANIFEST.sha256" ]; then
                _msha=$(sha256_file "$_sprefix/MANIFEST.sha256")
                printf '{"ok":true,"command":"self-update","version":"0.2.0","edition":"2026","prefix":"%s","from":"%s","manifest_sha256":"%s","manifest_verified":true}\n' "$_sprefix" "$_sfrom" "$_msha"
                return 0
            fi
            printf '{"ok":false,"command":"self-update","prefix":"%s","error":"update did not produce MANIFEST.sha256"}\n' "$_sprefix"
            return 1
            ;;
        *)
            usage
            ;;
    esac
}

prepend_evolve_pubkeys() {
    _pk_out=$1
    : > "$_pk_out"
    if [ -f "$ROOT/evolve/maintainers.pub" ]; then
        awk '!/^[ \t]*#/ && NF>=2 {print "@pubkey " $1 " " $2}' "$ROOT/evolve/maintainers.pub" >> "$_pk_out"
    fi
}

cmd_evolve() {
    [ $# -ge 1 ] || usage
    _eact=$1
    shift
    case "$_eact" in
        goals)
            cmd_run "$ROOT/evolve/goals.src"
            return 0
            ;;
        budgets)
            cmd_run "$ROOT/evolve/budgets.src"
            return 0
            ;;
        verify|propose|check|status)
            _efile=""
            _edom=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --domain)
                        [ $# -ge 2 ] || usage
                        _edom=$2
                        shift 2
                        ;;
                    --json)
                        shift
                        ;;
                    -*)
                        usage
                        ;;
                    *)
                        _efile=$1
                        shift
                        ;;
                esac
            done
            if [ -z "$_efile" ]; then
                if [ "$_eact" = "propose" ] && [ -n "$_edom" ]; then
                    _efile=""
                else
                    _efile="$ROOT/evolve/proposals/0001_math_clamp/proposal.bundle"
                fi
            fi
            if [ -n "$_efile" ] && [ -d "$_efile" ] && [ -f "$_efile/proposal.bundle" ]; then
                _efile="$_efile/proposal.bundle"
            fi
            _etmp_goal=""
            if [ ! -f "$_efile" ] && [ "$_eact" = "propose" ]; then
                _etmp_goal=$(mktemp)
                _epin=$(mktemp)
                printf '@cmd evolve-propose\n@part %s\n@goal %s\n' "$_edom" "$_efile" > "$_epin"
                run_core_tool lcli "$_epin" > "$_etmp_goal"
                rm -f "$_epin"
                _efile="$_etmp_goal"
            fi
            if [ ! -f "$_efile" ]; then
                echo "lume evolve: cannot read $_efile" >&2
                exit 66
            fi
            if [ -f "$ROOT/build/bootstrap/lumec2" ] && [ -f "$ROOT/build/bootstrap/lumec3" ]; then
                if ! cmp -s "$ROOT/build/bootstrap/lumec2" "$ROOT/build/bootstrap/lumec3"; then
                    [ -n "$_etmp_goal" ] && rm -f "$_etmp_goal"
                    echo "lume evolve: stage2 != stage3 binary fixpoint failure" >&2
                    exit 1
                fi
            fi
            _evin=$(mktemp)
            prepend_evolve_pubkeys "$_evin"
            cat "$_efile" >> "$_evin"
            _ejson=$(run_core_tool levolve "$_evin")
            rm -f "$_evin"
            [ -n "$_etmp_goal" ] && rm -f "$_etmp_goal"
            printf '%s\n' "$_ejson"
            case "$_ejson" in
                *'"gates_ok":true'*) return 0 ;;
                *) return 1 ;;
            esac
            ;;
        approve)
            _efile=""
            _by="maintainer"
            _sig=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --by)
                        [ $# -ge 2 ] || usage
                        _by=$2
                        shift 2
                        ;;
                    --sig)
                        [ $# -ge 2 ] || usage
                        _sig=$2
                        shift 2
                        ;;
                    --json)
                        shift
                        ;;
                    -*)
                        usage
                        ;;
                    *)
                        _efile=$1
                        shift
                        ;;
                esac
            done
            [ -n "$_efile" ] || _efile="$ROOT/evolve/proposals/0001_math_clamp/proposal.bundle"
            if [ -d "$_efile" ] && [ -f "$_efile/proposal.bundle" ]; then
                _efile="$_efile/proposal.bundle"
            fi
            if [ ! -f "$_efile" ]; then
                echo "lume evolve: cannot read $_efile" >&2
                exit 66
            fi
            if [ -f "$ROOT/build/bootstrap/lumec2" ] && [ -f "$ROOT/build/bootstrap/lumec3" ]; then
                if ! cmp -s "$ROOT/build/bootstrap/lumec2" "$ROOT/build/bootstrap/lumec3"; then
                    echo "lume evolve: stage2 != stage3 binary fixpoint failure" >&2
                    exit 1
                fi
            fi
            _etmp=$(mktemp)
            prepend_evolve_pubkeys "$_etmp"
            cat "$_efile" >> "$_etmp"
            if [ -n "$_sig" ]; then
                printf '\n@approval signed:%s:%s\n' "$_by" "$_sig" >> "$_etmp"
            else
                printf '\n@approval approved:%s\n' "$_by" >> "$_etmp"
            fi
            _ejson=$(run_core_tool levolve "$_etmp")
            rm -f "$_etmp"
            printf '%s\n' "$_ejson"
            case "$_ejson" in
                *'"can_merge":true'*) return 0 ;;
                *) return 1 ;;
            esac
            ;;
        apply|grow)
            _efile=""
            _by=""
            _sig=""
            _etarget=""
            _eroot="$ROOT"
            while [ $# -gt 0 ]; do
                case "$1" in
                    --by)
                        [ $# -ge 2 ] || usage
                        _by=$2
                        shift 2
                        ;;
                    --sig)
                        [ $# -ge 2 ] || usage
                        _sig=$2
                        shift 2
                        ;;
                    --target)
                        [ $# -ge 2 ] || usage
                        _etarget=$2
                        shift 2
                        ;;
                    --root)
                        [ $# -ge 2 ] || usage
                        _eroot=$2
                        shift 2
                        ;;
                    --json)
                        shift
                        ;;
                    -*)
                        usage
                        ;;
                    *)
                        _efile=$1
                        shift
                        ;;
                esac
            done
            [ -n "$_efile" ] || _efile="$ROOT/evolve/proposals/0003_decimal_clamp/proposal.bundle"
            if [ -d "$_efile" ] && [ -f "$_efile/proposal.bundle" ]; then
                _efile="$_efile/proposal.bundle"
            fi
            if [ ! -f "$_efile" ]; then
                echo "lume evolve: cannot read $_efile" >&2
                exit 66
            fi
            if [ -f "$ROOT/build/bootstrap/lumec2" ] && [ -f "$ROOT/build/bootstrap/lumec3" ]; then
                if ! cmp -s "$ROOT/build/bootstrap/lumec2" "$ROOT/build/bootstrap/lumec3"; then
                    echo "lume evolve: stage2 != stage3 binary fixpoint failure" >&2
                    exit 1
                fi
            fi
            _etmp=$(mktemp)
            prepend_evolve_pubkeys "$_etmp"
            cat "$_efile" >> "$_etmp"
            if [ -n "$_sig" ]; then
                printf '\n@approval signed:%s:%s\n' "${_by:-ricardo}" "$_sig" >> "$_etmp"
            elif [ -n "$_by" ]; then
                printf '\n@approval approved:%s\n' "$_by" >> "$_etmp"
            fi
            _ejson=$(run_core_tool levolve "$_etmp")
            case "$_ejson" in
                *'"can_merge":true'*'"signature_verified":true'*|*'"signature_verified":true'*'"can_merge":true'*) ;;
                *)
                    rm -f "$_etmp"
                    printf '%s\n' "$_ejson"
                    return 1
                    ;;
            esac
            _emfiles=$(awk '/^@file[ \t]+/{sub(/^@file[ \t]+/,""); sub(/[ \t\r]+$/,""); print}' "$_efile")
            if [ -n "$_emfiles" ] && [ -z "$_etarget" ]; then
                for _rel_f in $_emfiles; do
                    case "$_rel_f" in
                        /*) _abs_f="$_rel_f" ;;
                        *)  _abs_f="$_eroot/$_rel_f" ;;
                    esac
                    mkdir -p "$(dirname "$_abs_f")"
                    _etmp_app=$(mktemp)
                    printf '@mode apply\n@apply_file %s\n' "$_rel_f" > "$_etmp_app"
                    cat "$_etmp" >> "$_etmp_app"
                    _etmp_out=$(mktemp)
                    if ! run_core_tool levolve "$_etmp_app" | tr -d '\r' > "$_etmp_out"; then
                        rm -f "$_etmp" "$_etmp_app" "$_etmp_out"
                        printf '%s\n' "$_ejson"
                        return 1
                    fi
                    mv "$_etmp_out" "$_abs_f"
                    rm -f "$_etmp_app"
                done
                for _rel_f in $_emfiles; do
                    case "$_rel_f" in
                        /*) _abs_f="$_rel_f" ;;
                        *)  _abs_f="$_eroot/$_rel_f" ;;
                    esac
                    if grep -Eq '^fn[ \t]+test_' "$_abs_f"; then
                        if ! cmd_test "$_abs_f" >/dev/null 2>&1; then
                            rm -f "$_etmp"
                            echo "lume evolve apply: target test suite failed after apply on $_abs_f" >&2
                            return 1
                        fi
                    fi
                done
                rm -f "$_etmp"
                printf '%s\n' "$_ejson"
                return 0
            fi
            if [ -z "$_etarget" ]; then
                _rel_t=$(awk '/^@target[ \t]+/{sub(/^@target[ \t]+/,""); sub(/[ \t\r]+$/,""); print; exit}' "$_efile")
                if [ -n "$_rel_t" ]; then
                    case "$_rel_t" in
                        /*) _etarget="$_rel_t" ;;
                        *)  _etarget="$_eroot/$_rel_t" ;;
                    esac
                fi
            fi
            if [ -z "$_etarget" ]; then
                rm -f "$_etmp"
                echo "lume evolve apply: proposal has no @target and --target was not specified" >&2
                return 1
            fi
            _etmp_app=$(mktemp)
            printf '@mode apply\n' > "$_etmp_app"
            cat "$_etmp" >> "$_etmp_app"
            _etmp_out=$(mktemp)
            if ! run_core_tool levolve "$_etmp_app" | tr -d '\r' > "$_etmp_out"; then
                rm -f "$_etmp" "$_etmp_app" "$_etmp_out"
                printf '%s\n' "$_ejson"
                return 1
            fi
            mv "$_etmp_out" "$_etarget"
            rm -f "$_etmp" "$_etmp_app"
            if grep -Eq '^fn[ \t]+test_' "$_etarget"; then
                if ! cmd_test "$_etarget" >/dev/null 2>&1; then
                    echo "lume evolve apply: target test suite failed after apply on $_etarget" >&2
                    return 1
                fi
            fi
            printf '%s\n' "$_ejson"
            return 0
            ;;
        *)
            usage
            ;;
    esac
}

registry_error() {
    printf '{"ok":false,"action":"%s","error":{"code":"%s","message":"%s"}}\n' "$1" "$2" "$3"
    return 1
}

registry_sha_text() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf 'sha256:'
        sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        printf 'sha256:'
        shasum -a 256 | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        printf 'sha256:'
        openssl dgst -sha256 | awk '{print $NF}'
    else
        echo "lume registry: SHA-256 requires sha256sum, shasum, or openssl" >&2
        return 1
    fi
}

registry_file_sha() {
    printf 'sha256:%s' "$(sha256_file "$1")"
}

registry_valid_cid() {
    [ "${#1}" -eq 71 ] || return 1
    case "$1" in
        sha256:*) ;;
        *) return 1 ;;
    esac
    _rv_hex=${1#sha256:}
    [ -z "$(printf '%s' "$_rv_hex" | tr -d '0-9a-f')" ]
}

registry_toolchain_id() {
    ensure_native_toolchain
    ensure_core_tool lcaas
    ensure_core_tool lcert
    ensure_core_tool ltest
    ensure_core_tool lregistry
    ensure_core_tool lregistry_cid
    {
        printf 'cli=%s\n' "$(sha256_file "$ROOT/lume")"
        printf 'lumec=%s\n' "$(sha256_file "$LUMEC")"
        printf 'lasm=%s\n' "$(sha256_file "$LASM")"
        printf 'lcaas=%s\n' "$(sha256_file "$BIN_DIR/lcaas")"
        printf 'lcert=%s\n' "$(sha256_file "$BIN_DIR/lcert")"
        printf 'ltest=%s\n' "$(sha256_file "$BIN_DIR/ltest")"
        printf 'lregistry=%s\n' "$(sha256_file "$BIN_DIR/lregistry")"
    } | registry_sha_text
}

registry_make_component() {
    _rmc_dir=$1
    {
        cat "$_rmc_dir/adapter.src"
        printf '\n'
        cat "$_rmc_dir/source.src"
        printf '\n'
    } > "$_rmc_dir/component.src"
    {
        cat "$_rmc_dir/component.src"
        cat "$_rmc_dir/tests.src"
        printf '\n'
    } > "$_rmc_dir/test-component.src"
}

registry_derive_interface() {
    _rdi_input=$(mktemp)
    printf '@mode registry-interface\n' > "$_rdi_input"
    cat "$1" >> "$_rdi_input"
    _rdi_json=$(run_core_tool lcaas "$_rdi_input")
    rm -f "$_rdi_input"
    case "$_rdi_json" in
        *'"ok":true'*) ;;
        *) registry_error "$REG_ACTION" R0002 "parsed public interface derivation failed"; return 1 ;;
    esac
    REG_CAPABILITIES=$(jsonrpc_extract_str "$_rdi_json" "capabilities")
    REG_CONTRACT_SIGNATURE=$(jsonrpc_extract_str "$_rdi_json" "contract_signature")
    REG_PUBLIC_CONTRACTS=$(printf '%s' "$_rdi_json" | sed -n 's/.*"public_contracts":\([0-9][0-9]*\).*/\1/p')
    registry_valid_cid "$REG_CONTRACT_SIGNATURE" || { registry_error "$REG_ACTION" R0002 "invalid derived contract signature"; return 1; }
    case "$REG_PUBLIC_CONTRACTS" in
        ''|*[!0-9]*) registry_error "$REG_ACTION" R0002 "invalid public contract count"; return 1 ;;
    esac
    [ "$REG_PUBLIC_CONTRACTS" -gt 0 ] || { registry_error "$REG_ACTION" R0002 "component needs at least one public contract"; return 1; }
}

registry_verify_proof() {
    _rvp_dir=$1
    if [ -f "$_rvp_dir/proof.cert.json" ]; then
        _rvp_supplied=$(run_core_tool lcert "$_rvp_dir/proof.cert.json")
        case "$_rvp_supplied" in
            *'"kernel_verified":true'*'"hash_verified":true'*) ;;
            *) registry_error "$REG_ACTION" R0002 "independent proof kernel rejected supplied certificate"; return 1 ;;
        esac
    fi
    _rvp_fresh=$(mktemp)
    if ! cmd_certify "$_rvp_dir/component.src" > "$_rvp_fresh"; then
        rm -f "$_rvp_fresh"
        registry_error "$REG_ACTION" R0002 "source and adapter failed proof certification"
        return 1
    fi
    _rvp_kernel=$(run_core_tool lcert "$_rvp_fresh")
    case "$_rvp_kernel" in
        *'"kernel_verified":true'*'"hash_verified":true'*) ;;
        *) rm -f "$_rvp_fresh"; registry_error "$REG_ACTION" R0002 "independent proof kernel rejected fresh certificate"; return 1 ;;
    esac
    if [ -f "$_rvp_dir/proof.cert.json" ] && ! cmp -s "$_rvp_dir/proof.cert.json" "$_rvp_fresh"; then
        rm -f "$_rvp_fresh"
        registry_error "$REG_ACTION" R0002 "proof certificate is stale or does not bind the actual source and adapter"
        return 1
    fi
    cp "$_rvp_fresh" "$_rvp_dir/proof.cert.json"
    rm -f "$_rvp_fresh"
    REG_PROOF_KERNEL=$(jsonrpc_extract_str "$_rvp_kernel" "kernel_id")
    [ -n "$REG_PROOF_KERNEL" ] || { registry_error "$REG_ACTION" R0002 "proof kernel identity is missing"; return 1; }
}

registry_execute_tests() {
    _ret_dir=$1
    _ret_fresh=$(mktemp)
    if ! cmd_test "$_ret_dir/test-component.src" > "$_ret_fresh" 2>&1; then
        rm -f "$_ret_fresh"
        registry_error "$REG_ACTION" R0005 "component test execution failed"
        return 1
    fi
    if ! grep -Eq '[1-9][0-9]* passed, 0 failed' "$_ret_fresh"; then
        rm -f "$_ret_fresh"
        registry_error "$REG_ACTION" R0005 "component must execute at least one passing test with zero failures"
        return 1
    fi
    if [ -f "$_ret_dir/test-output.txt" ] && ! cmp -s "$_ret_dir/test-output.txt" "$_ret_fresh"; then
        rm -f "$_ret_fresh"
        registry_error "$REG_ACTION" R0005 "stored test evidence is stale or tampered"
        return 1
    fi
    cp "$_ret_fresh" "$_ret_dir/test-output.txt"
    rm -f "$_ret_fresh"
}

registry_cid_material() {
    printf 'lume-verified-component/0.1\n'
    printf 'adapter_sha256=%s\nsource_sha256=%s\nproof_sha256=%s\ntests_sha256=%s\ntest_output_sha256=%s\n' "$REG_ADAPTER_SHA" "$REG_SOURCE_SHA" "$REG_PROOF_SHA" "$REG_TESTS_SHA" "$REG_TEST_OUTPUT_SHA"
    printf 'target=%s\ntoolchain_sha256=%s\ncapabilities=%s\ncontract_signature=%s\npublic_contracts=%s\nproof_kernel=%s\n' "$REG_TARGET" "$REG_TOOLCHAIN_SHA" "$REG_CAPABILITIES" "$REG_CONTRACT_SIGNATURE" "$REG_PUBLIC_CONTRACTS" "$REG_PROOF_KERNEL"
}

registry_evaluate() {
    _re_dir=$1
    REG_TARGET=$2
    if ! is_linux_x86_64 || [ -n "${LUME0_ASAN:-}" ] || [ "$REG_TARGET" != "x86_64-linux-elf" ]; then
        registry_error "$REG_ACTION" R0004 "this increment publishes and resolves only on the x86_64-linux-elf execution target"
        return 1
    fi
    for _re_file in adapter.src source.src tests.src; do
        if [ ! -s "$_re_dir/$_re_file" ]; then
            registry_error "$REG_ACTION" R0001 "missing or empty artifact: $_re_file"
            return 1
        fi
    done
    registry_make_component "$_re_dir"
    registry_verify_proof "$_re_dir" || return 1
    registry_execute_tests "$_re_dir" || return 1
    registry_derive_interface "$_re_dir/component.src" || return 1
    REG_ADAPTER_SHA=$(registry_file_sha "$_re_dir/adapter.src")
    REG_SOURCE_SHA=$(registry_file_sha "$_re_dir/source.src")
    REG_PROOF_SHA=$(registry_file_sha "$_re_dir/proof.cert.json")
    REG_TESTS_SHA=$(registry_file_sha "$_re_dir/tests.src")
    REG_TEST_OUTPUT_SHA=$(registry_file_sha "$_re_dir/test-output.txt")
    REG_TOOLCHAIN_SHA=$(registry_toolchain_id) || return 1
    REG_CID=$(registry_cid_material | registry_sha_text) || return 1
}

registry_manifest_input() {
    _rmi_mode=$1
    _rmi_dir=$2
    _rmi_out=$3
    printf '@mode %s\n@cid %s\n@adapter-sha256 %s\n@source-sha256 %s\n@proof-sha256 %s\n@tests-sha256 %s\n@test-output-sha256 %s\n' "$_rmi_mode" "$REG_CID" "$REG_ADAPTER_SHA" "$REG_SOURCE_SHA" "$REG_PROOF_SHA" "$REG_TESTS_SHA" "$REG_TEST_OUTPUT_SHA" > "$_rmi_out"
    printf '@target %s\n@toolchain-sha256 %s\n@capabilities %s\n@contract-signature %s\n@public-contracts %s\n@proof-kernel %s\n' "$REG_TARGET" "$REG_TOOLCHAIN_SHA" "$REG_CAPABILITIES" "$REG_CONTRACT_SIGNATURE" "$REG_PUBLIC_CONTRACTS" "$REG_PROOF_KERNEL" >> "$_rmi_out"
    if [ "$_rmi_mode" = "verify" ]; then
        printf '@manifest\n' >> "$_rmi_out"
        cat "$_rmi_dir/manifest.json" >> "$_rmi_out"
        printf '\n@end\n' >> "$_rmi_out"
    fi
}

registry_verify_entry() {
    _rve_dir=$1
    _rve_cid=$2
    _rve_target=$3
    registry_valid_cid "$_rve_cid" || { registry_error "$REG_ACTION" R0001 "invalid content identifier"; return 1; }
    for _rve_file in manifest.json adapter.src source.src proof.cert.json tests.src test-output.txt; do
        if [ ! -s "$_rve_dir/$_rve_file" ]; then
            registry_error "$REG_ACTION" R0003 "registry entry is incomplete: $_rve_file"
            return 1
        fi
    done
    _rve_manifest=$(cat "$_rve_dir/manifest.json")
    _rve_stored_target=$(jsonrpc_extract_str "$_rve_manifest" "target")
    if [ "$_rve_stored_target" != "$_rve_target" ]; then
        registry_error "$REG_ACTION" R0004 "component target is incompatible with the requested target"
        return 1
    fi
    registry_evaluate "$_rve_dir" "$_rve_target" || return 1
    _rve_stored_toolchain=$(jsonrpc_extract_str "$_rve_manifest" "toolchain_sha256")
    if [ "$_rve_stored_toolchain" != "$REG_TOOLCHAIN_SHA" ]; then
        registry_error "$REG_ACTION" R0004 "component evidence is stale for the current toolchain"
        return 1
    fi
    _rve_input=$(mktemp)
    registry_manifest_input verify "$_rve_dir" "$_rve_input"
    _rve_result=$(run_core_tool lregistry "$_rve_input")
    rm -f "$_rve_input"
    case "$_rve_result" in
        *'"ok":true'*) ;;
        *) registry_error "$REG_ACTION" R0003 "artifact hashes, interface, CID, or manifest do not match fresh derivation"; return 1 ;;
    esac
    cat "$_rve_dir/manifest.json"
}

registry_capability_matches() {
    [ -n "$2" ] || return 0
    if [ "$2" = "pure" ] && [ -z "$1" ]; then
        return 0
    fi
    case ",$1," in
        *",$2,"*) return 0 ;;
        *) return 1 ;;
    esac
}

cmd_registry() {
    [ $# -ge 1 ] || usage
    REG_ACTION=$1
    shift
    _rc_store="${LUME_REGISTRY_DIR:-${TMPDIR:-/tmp}/lume_verified_registry}"
    _rc_target="x86_64-linux-elf"
    _rc_adapter=""
    _rc_source=""
    _rc_proof=""
    _rc_tests=""
    _rc_cid=""
    _rc_capability=""
    _rc_contract=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --store) [ $# -ge 2 ] || usage; _rc_store=$2; shift 2 ;;
            --store=*) _rc_store=${1#--store=}; shift ;;
            --target) [ $# -ge 2 ] || usage; _rc_target=$2; shift 2 ;;
            --target=*) _rc_target=${1#--target=}; shift ;;
            --adapter) [ $# -ge 2 ] || usage; _rc_adapter=$2; shift 2 ;;
            --adapter=*) _rc_adapter=${1#--adapter=}; shift ;;
            --source) [ $# -ge 2 ] || usage; _rc_source=$2; shift 2 ;;
            --source=*) _rc_source=${1#--source=}; shift ;;
            --proof) [ $# -ge 2 ] || usage; _rc_proof=$2; shift 2 ;;
            --proof=*) _rc_proof=${1#--proof=}; shift ;;
            --tests) [ $# -ge 2 ] || usage; _rc_tests=$2; shift 2 ;;
            --tests=*) _rc_tests=${1#--tests=}; shift ;;
            --cid) [ $# -ge 2 ] || usage; _rc_cid=$2; shift 2 ;;
            --cid=*) _rc_cid=${1#--cid=}; shift ;;
            --capability) [ $# -ge 2 ] || usage; _rc_capability=$2; shift 2 ;;
            --capability=*) _rc_capability=${1#--capability=}; shift ;;
            --contract-signature) [ $# -ge 2 ] || usage; _rc_contract=$2; shift 2 ;;
            --contract-signature=*) _rc_contract=${1#--contract-signature=}; shift ;;
            --json) shift ;;
            *) usage ;;
        esac
    done
    case "$REG_ACTION" in
        publish)
            [ -n "$_rc_adapter" ] && [ -n "$_rc_source" ] && [ -n "$_rc_tests" ] || usage
            for _rc_input in "$_rc_adapter" "$_rc_source" "$_rc_tests"; do
                [ -s "$_rc_input" ] || { registry_error publish R0001 "input artifact is missing or empty"; return 1; }
            done
            if [ -n "$_rc_proof" ] && [ ! -s "$_rc_proof" ]; then
                registry_error publish R0001 "proof artifact is missing or empty"
                return 1
            fi
            mkdir -p "$_rc_store/components"
            _rc_tmp=$(mktemp -d "$_rc_store/components/.publish.XXXXXX")
            cp "$_rc_adapter" "$_rc_tmp/adapter.src"
            cp "$_rc_source" "$_rc_tmp/source.src"
            cp "$_rc_tests" "$_rc_tmp/tests.src"
            if [ -n "$_rc_proof" ]; then
                cp "$_rc_proof" "$_rc_tmp/proof.cert.json"
            fi
            if ! registry_evaluate "$_rc_tmp" "$_rc_target"; then
                rm -rf "$_rc_tmp"
                return 1
            fi
            _rc_input=$(mktemp)
            registry_manifest_input emit "$_rc_tmp" "$_rc_input"
            if ! run_core_tool lregistry "$_rc_input" > "$_rc_tmp/manifest.json"; then
                rm -f "$_rc_input"
                rm -rf "$_rc_tmp"
                registry_error publish R0003 "manifest generation failed"
                return 1
            fi
            rm -f "$_rc_input"
            if ! grep -q '^{"schema":"lume-verified-component/0.1"' "$_rc_tmp/manifest.json"; then
                rm -rf "$_rc_tmp"
                registry_error publish R0003 "manifest kernel rejected the derived artifact evidence"
                return 1
            fi
            _rc_dest="$_rc_store/components/$REG_CID"
            if [ -e "$_rc_dest" ]; then
                rm -rf "$_rc_tmp"
                registry_error publish R0003 "content identifier already exists; resolve it instead of overwriting"
                return 1
            fi
            mv "$_rc_tmp" "$_rc_dest"
            cat "$_rc_dest/manifest.json"
            ;;
        resolve)
            [ -n "$_rc_cid" ] || usage
            registry_verify_entry "$_rc_store/components/$_rc_cid" "$_rc_cid" "$_rc_target"
            ;;
        discover)
            _rc_matches=$(mktemp)
            : > "$_rc_matches"
            for _rc_dir in "$_rc_store"/components/sha256:*; do
                [ -d "$_rc_dir" ] || continue
                [ -f "$_rc_dir/manifest.json" ] || { rm -f "$_rc_matches"; registry_error discover R0003 "registry entry has no manifest"; return 1; }
                _rc_manifest=$(cat "$_rc_dir/manifest.json")
                _rc_stored_target=$(jsonrpc_extract_str "$_rc_manifest" "target")
                [ "$_rc_stored_target" = "$_rc_target" ] || continue
                _rc_stored_contract=$(jsonrpc_extract_str "$_rc_manifest" "contract_signature")
                if [ -n "$_rc_contract" ] && [ "$_rc_stored_contract" != "$_rc_contract" ]; then
                    continue
                fi
                if ! registry_verify_entry "$_rc_dir" "${_rc_dir##*/}" "$_rc_target" >/dev/null; then
                    rm -f "$_rc_matches"
                    return 1
                fi
                if registry_capability_matches "$REG_CAPABILITIES" "$_rc_capability"; then
                    cat "$_rc_dir/manifest.json" >> "$_rc_matches"
                    printf '\n' >> "$_rc_matches"
                fi
            done
            _rc_items=$(awk 'NF { if (n++) printf ","; printf "%s", $0 }' "$_rc_matches")
            rm -f "$_rc_matches"
            printf '{"ok":true,"action":"discover","target":"%s","components":[%s]}\n' "$_rc_target" "$_rc_items"
            ;;
        *) usage ;;
    esac
}

cmd_mesh() {
    _mfile=""
    while [ $# -gt 0 ]; do
        case "$1" in
            bench)
                echo "lume mesh bench: removed; use 'lume economy' for real-execution evidence" >&2
                return 64
                ;;
            --json) shift ;;
            -*) usage ;;
            *)
                [ -z "$_mfile" ] || usage
                _mfile=$1
                shift
                ;;
        esac
    done
    _min=$(mktemp)
    if [ -n "$_mfile" ]; then
        if [ ! -f "$_mfile" ]; then
            rm -f "$_min"
            echo "lume mesh: cannot read $_mfile" >&2
            exit 66
        fi
        cp "$_mfile" "$_min"
    else
        cat > "$_min"
    fi
    _mjson=$(run_core_tool lmesh "$_min")
    rm -f "$_min"
    printf '%s\n' "$_mjson"
    case "$_mjson" in
        *'"ok":true'*) return 0 ;;
        *) return 1 ;;
    esac
}

cmd_economy() {
    ensure_core_tool leconomy
    _e_out=
    _e_artifacts=
    _e_self=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --output)
                [ $# -ge 2 ] || return 64
                _e_out=$2
                shift 2
                ;;
            --artifacts)
                [ $# -ge 2 ] || return 64
                _e_artifacts=$2
                shift 2
                ;;
            --self-test)
                _e_self=1
                shift
                ;;
            *)
                echo "lume economy: unsupported argument: $1" >&2
                return 64
                ;;
        esac
    done
    [ -n "$_e_out" ] || {
        echo "lume economy: --output is required" >&2
        return 64
    }
    _e_dir=$(dirname -- "$_e_out")
    _e_file=$(basename -- "$_e_out")
    mkdir -p "$_e_dir"
    _e_dir_abs=$(CDPATH= cd -- "$_e_dir" && pwd)
    _e_out="$_e_dir_abs/$_e_file"
    if [ -z "$_e_artifacts" ]; then
        _e_artifacts="${_e_out%.*}.artifacts"
    fi
    mkdir -p "$_e_artifacts"
    _e_artifacts=$(CDPATH= cd -- "$_e_artifacts" && pwd)
    _e_tmp=$(mktemp)
    printf '@output %s\n@artifacts %s\n@base %s\n@root %s\n@self_test %s\n' \
        "$_e_out" "$_e_artifacts" "$_e_dir_abs" "$ROOT" "$_e_self" >"$_e_tmp"
    _e_result=$(run_core_tool leconomy "$_e_tmp")
    rm -f "$_e_tmp"
    printf '%s\n' "$_e_result"
}

[ $# -ge 1 ] || usage
_sub=$1
shift

case "$_sub" in
    --version|version)
