run_surface_tests() {
    _st_file=$1
    ensure_seed
    if ! run_l0 check "$_st_file" >/dev/null; then
        return 1
    fi
    _st_tokens=$(mktemp)
    _st_names=$(mktemp)
    _st_src=$(mktemp)
    run_l0 tokens "$_st_file" > "$_st_tokens"
    awk '
        $1 ~ /:1$/ && $2 == "KW_FN" { state = 1; next }
        state == 1 && $2 == "IDENT" { name = $3; state = 2; next }
        state == 2 && $2 == "LPAREN" { state = 3; next }
        state == 3 && $2 == "RPAREN" {
            if (name ~ /^test_/) print name
            state = 0
            next
        }
        { state = 0 }
    ' "$_st_tokens" > "$_st_names"
    cp "$_st_file" "$_st_src"
    _st_count=0
    while IFS= read -r _st_name; do
        [ -n "$_st_name" ] || continue
        printf '\nassert %s(), "%s"\n' "$_st_name" "$_st_name" >> "$_st_src"
        _st_count=$((_st_count + 1))
    done < "$_st_names"
    rm -f "$_st_tokens" "$_st_names"
    if ! run_l0 run "$_st_src"; then
        rm -f "$_st_src"
        printf 'lume test: %s failed\n' "$_st_file" >&2
        return 1
    fi
    rm -f "$_st_src"
    printf '%d passed, 0 failed\n' "$_st_count"
}

cmd_test() {
    [ $# -ge 1 ] || usage
    _overall=0
    for _file in "$@"; do
        if [ ! -f "$_file" ]; then
            echo "lume test: cannot read $_file" >&2
            exit 66
        fi
        case "$_file" in
            *.src)
                _bundled=$(mktemp "${TMPDIR:-/tmp}/lume_tb_XXXXXX.src")
                if ! bundle_src_if_needed "$_file" "$_bundled"; then
                    rm -f "$_bundled"
                    _overall=1
                    continue
                fi
                _tmpsrc=$(mktemp "${TMPDIR:-/tmp}/lume_test_XXXXXX.src")
                run_core_tool ltest "$_bundled" > "$_tmpsrc"
                if ! cmd_run "$_tmpsrc"; then
                    _overall=1
                fi
                rm -f "$_bundled" "$_tmpsrc"
                ;;
            *)
                if ! run_surface_tests "$_file"; then
                    _overall=1
                fi
                ;;
        esac
    done
    return $_overall
}

cmd_fmt() {
    _check=0
    _stdout=0
    _nfiles=0
    for _arg in "$@"; do
        case "$_arg" in
            --check) _check=1 ;;
            --stdout) _stdout=1 ;;
            -*) usage ;;
            *) _nfiles=$((_nfiles + 1)) ;;
        esac
    done
    [ "$_nfiles" -ge 1 ] || usage
    _rc=0
    for _arg in "$@"; do
        case "$_arg" in
            --check|--stdout) continue ;;
        esac
        _file=$_arg
        if [ ! -f "$_file" ]; then
            echo "lume fmt: cannot read $_file" >&2
            exit 66
        fi
        _tmpfmt=$(mktemp)
        case "$_file" in
            *.src)
                if [ -f "$SRC_DIR/lfmt.src" ]; then
                    run_core_tool lfmt "$_file" > "$_tmpfmt"
                else
                    awk '{ sub(/[ \t\r]+$/, ""); if ($0 == "") { b++; if (b <= 1) print "" } else { b = 0; print $0 } }' "$_file" > "$_tmpfmt"
                fi
                ;;
            *)
                awk '{ sub(/[ \t\r]+$/, ""); if ($0 == "") { b++; if (b <= 1) print "" } else { b = 0; print $0 } }' "$_file" > "$_tmpfmt"
                ;;
        esac
        if [ "$_stdout" -eq 1 ]; then
            cat "$_tmpfmt"
        elif [ "$_check" -eq 1 ]; then
            if ! cmp -s "$_file" "$_tmpfmt"; then
                echo "lume fmt: $_file is not canonically formatted" >&2
                _rc=1
            fi
        else
            if ! cmp -s "$_file" "$_tmpfmt"; then
                cp "$_tmpfmt" "$_file"
            fi
        fi
        rm -f "$_tmpfmt"
    done
    return $_rc
}

cmd_check() {
    _json=""
    _file=""
    for _arg in "$@"; do
        case "$_arg" in
            --json) _json="--json" ;;
            -*) usage ;;
            *) _file=$_arg ;;
        esac
    done
    [ -n "$_file" ] || usage
    if [ ! -f "$_file" ]; then
        echo "lume check: cannot read $_file" >&2
        exit 66
    fi
    case "$_file" in
        *.intent)
            cmd_intent build --json "$_file"
            return $?
            ;;
        *.src)
            _bundled=$(mktemp)
            if ! bundle_src_if_needed "$_file" "$_bundled"; then
                rm -f "$_bundled"
                exit 1
            fi
            if is_linux_x86_64 && { [ -x "$BIN_DIR/lc" ] || [ -x "$BIN_DIR/lumec" ] || [ -z "${LUME0_ASAN:-}" ]; }; then
                ensure_native_toolchain
                "$LUMEC" < "$_bundled" > /dev/null
                rm -f "$_bundled"
                if [ -z "$_json" ]; then
                    echo "$_file: OK (Lume-Core parsed and checked)" >&2
                fi
            else
                ensure_seed
                run_l0 run "$SRC_DIR/data_asm_cc.lume" "$_bundled" /dev/null >/dev/null
                rm -f "$_bundled"
                if [ -z "$_json" ]; then
                    echo "$_file: OK (Lume-Core parsed and checked)" >&2
                fi
            fi
            ;;
        *)
            ensure_seed
            if [ -n "$_json" ]; then
                if run_l0 check "$_file" --json; then
                    printf '{"ok":true,"command":"check"}\n'
                else
                    return 1
                fi
            else
                run_l0 check "$_file"
            fi
            ;;
    esac
}

gen_lockfile() {
    _pdir=$1
    _mjson=$2
    _lkin=$(mktemp)
    printf '@cmd pkg-lock\n@manifest %s\n@manifest_sha256 %s\n' "$_mjson" "$(sha256_file "$_pdir/lume.toml")" > "$_lkin"
    find "$_pdir" -maxdepth 2 \( -name '*.src' -o -name '*.lume' \) | LC_ALL=C sort | while IFS= read -r _sf; do
        _rel=${_sf#"$_pdir/"}
        printf '@module %s %s\n' "$(sha256_file "$_sf")" "$_rel" >> "$_lkin"
    done
    run_core_tool lcli "$_lkin"
    rm -f "$_lkin"
}

cmd_pkg() {
    [ $# -ge 1 ] || usage
    _action=$1
    shift
    _pdir="${1:-.}"
    case "$_action" in
        init)
            mkdir -p "$_pdir"
            _pkgname=$(basename -- "$(cd "$_pdir" && pwd)")
            if [ ! -f "$_pdir/lume.toml" ]; then
                _pi_in=$(mktemp)
                printf '@cmd pkg-init\n@pkg %s\n@part toml\n' "$_pkgname" > "$_pi_in"
                run_core_tool lcli "$_pi_in" > "$_pdir/lume.toml"
                rm -f "$_pi_in"
            fi
            if [ ! -f "$_pdir/main.src" ]; then
                _pi_in=$(mktemp)
                printf '@cmd pkg-init\n@pkg %s\n@part main\n' "$_pkgname" > "$_pi_in"
                run_core_tool lcli "$_pi_in" > "$_pdir/main.src"
                rm -f "$_pi_in"
            fi
            echo "lume pkg: initialized $_pkgname in $_pdir/lume.toml"
            ;;
        check|manifest)
            if [ ! -f "$_pdir/lume.toml" ]; then
                echo "lume pkg: missing $_pdir/lume.toml" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            echo "$_mjson"
            ;;
        lock)
            if [ ! -f "$_pdir/lume.toml" ]; then
                echo "lume pkg: missing $_pdir/lume.toml" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            gen_lockfile "$_pdir" "$_mjson" > "$_pdir/lume.lock"
            echo "lume pkg: wrote $_pdir/lume.lock"
            ;;
        verify)
            if [ ! -f "$_pdir/lume.toml" ] || [ ! -f "$_pdir/lume.lock" ]; then
                echo "lume pkg: missing lume.toml or lume.lock in $_pdir" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            _ltmp=$(mktemp)
            gen_lockfile "$_pdir" "$_mjson" > "$_ltmp"
            if ! cmp -s "$_pdir/lume.lock" "$_ltmp"; then
                rm -f "$_ltmp"
                echo "lume pkg: lockfile verification failed (source or manifest drift detected)" >&2
                exit 1
            fi
            rm -f "$_ltmp"
            echo "lume pkg: verified $_pdir/lume.lock (all SHA-256 digests match)"
            ;;
        tree)
            if [ ! -f "$_pdir/lume.toml" ]; then
                echo "lume pkg: missing $_pdir/lume.toml" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            _trin=$(mktemp)
            printf '@cmd pkg-tree\n@manifest %s\n' "$_mjson" > "$_trin"
            find "$_pdir" -maxdepth 2 -name '*.src' | LC_ALL=C sort | while IFS= read -r _sf; do
                _rel=${_sf#"$_pdir/"}
                printf '@modsrc %s\n' "$_rel" >> "$_trin"
                cat "$_sf" >> "$_trin"
                printf '\n@end\n' >> "$_trin"
            done
            run_core_tool lcli "$_trin"
            rm -f "$_trin"
            ;;
        publish)
            _pdir="."
            _store="${LUME_REGISTRY_DIR:-${TMPDIR:-/tmp}/lume_registry}"
            while [ $# -gt 0 ]; do
                case "$1" in
                    --store)
                        [ $# -ge 2 ] || usage
                        _store=$2
                        shift 2
                        ;;
                    --json)
                        shift
                        ;;
                    -*)
                        usage
                        ;;
                    *)
                        _pdir=$1
                        shift
                        ;;
                esac
            done
            if [ ! -f "$_pdir/lume.toml" ]; then
                echo "lume pkg publish: missing $_pdir/lume.toml" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            _pkgname=$(jsonrpc_extract_str "$_mjson" "name")
            [ -n "$_pkgname" ] || _pkgname=$(basename -- "$(cd "$_pdir" && pwd)")
            _entry=""
            if [ -f "$_pdir/main.src" ]; then
                _entry="$_pdir/main.src"
            else
                _entry=$(find "$_pdir" -maxdepth 2 -name '*.src' | LC_ALL=C sort | head -n 1)
            fi
            if [ -z "$_entry" ] || [ ! -f "$_entry" ]; then
                echo "lume pkg publish: no .src module found in $_pdir" >&2
                exit 66
            fi
            _cert_tmp=$(mktemp)
            if ! cmd_certify "$_entry" > "$_cert_tmp" 2>/dev/null; then
                _cjson=$(cat "$_cert_tmp" 2>/dev/null || printf '{"ok":false}')
                rm -f "$_cert_tmp"
                printf '{"ok":false,"action":"publish","package":"%s","error":"[V0001] package failed static contract verification or proof certification","certificate":%s}\n' "$_pkgname" "$_cjson"
                return 1
            fi
            _vjson=$(run_core_tool lcert "$_cert_tmp" 2>/dev/null || printf '{"kernel_verified":false}')
            case "$_vjson" in
                *'"kernel_verified":true'*) ;;
                *)
                    rm -f "$_cert_tmp"
                    printf '{"ok":false,"action":"publish","package":"%s","error":"[V0001] independent proof certificate kernel rejected package","verification":%s}\n' "$_pkgname" "$_vjson"
                    return 1
                    ;;
            esac
            if [ ! -f "$_pdir/lume.lock" ]; then
                gen_lockfile "$_pdir" "$_mjson" > "$_pdir/lume.lock"
            fi
            _dest="$_store/$_pkgname"
            mkdir -p "$_dest"
            cp "$_pdir/lume.toml" "$_pdir/lume.lock" "$_dest/"
            find "$_pdir" -maxdepth 2 -name '*.src' | LC_ALL=C sort | while IFS= read -r _sf; do
                cp "$_sf" "$_dest/"
            done
            cp "$_cert_tmp" "$_dest/proof.cert.json"
            rm -f "$_cert_tmp"
            _msha=$(sha256_file "$_dest/lume.toml")
            _lsha=$(sha256_file "$_dest/lume.lock")
            _csha=$(sha256_file "$_dest/proof.cert.json")
            printf '{"ok":true,"action":"publish","package":"%s","manifest":%s,"manifest_sha256":"%s","lockfile_sha256":"%s","certificate_sha256":"%s","kernel_verified":true,"proof_certificate_verified":true,"store":"%s"}\n' "$_pkgname" "$_mjson" "$_msha" "$_lsha" "$_csha" "$_dest"
            ;;
        audit)
            _pdir="."
            _store=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --store)
                        [ $# -ge 2 ] || usage
                        _store=$2
                        shift 2
                        ;;
                    --json)
                        shift
                        ;;
                    -*)
                        usage
                        ;;
                    *)
                        _pdir=$1
                        shift
                        ;;
                esac
            done
            if [ ! -d "$_pdir" ] && [ -n "$_store" ] && [ -d "$_store/$_pdir" ]; then
                _pdir="$_store/$_pdir"
            fi
            if [ ! -f "$_pdir/lume.toml" ] || [ ! -f "$_pdir/lume.lock" ]; then
                echo "lume pkg audit: missing lume.toml or lume.lock in $_pdir" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            _pkgname=$(jsonrpc_extract_str "$_mjson" "name")
            _ltmp=$(mktemp)
            gen_lockfile "$_pdir" "$_mjson" > "$_ltmp"
            if ! cmp -s "$_pdir/lume.lock" "$_ltmp"; then
                rm -f "$_ltmp"
                printf '{"ok":false,"action":"audit","package":"%s","lockfile_verified":false,"proof_certificate_verified":false,"error":"lockfile SHA-256 drift detected"}\n' "$_pkgname"
                return 1
            fi
            rm -f "$_ltmp"
            _entry=""
            if [ -f "$_pdir/main.src" ]; then
                _entry="$_pdir/main.src"
            else
                _entry=$(find "$_pdir" -maxdepth 2 -name '*.src' | LC_ALL=C sort | head -n 1)
            fi
            _vok=0
            if [ -f "$_pdir/proof.cert.json" ]; then
                _vj=$(run_core_tool lcert "$_pdir/proof.cert.json" 2>/dev/null || true)
                case "$_vj" in *'"kernel_verified":true'*) _vok=1 ;; esac
            elif [ -n "$_entry" ] && [ -f "$_entry" ]; then
                if cmd_verify_cert "$_entry" >/dev/null 2>&1; then
                    _vok=1
                fi
            fi
            if [ "$_vok" -ne 1 ]; then
                printf '{"ok":false,"action":"audit","package":"%s","manifest":%s,"lockfile_verified":true,"proof_certificate_verified":false,"error":"[V0001] package proof certificate failed verification"}\n' "$_pkgname" "$_mjson"
                return 1
            fi
            printf '{"ok":true,"action":"audit","package":"%s","manifest":%s,"lockfile_verified":true,"proof_certificate_verified":true}\n' "$_pkgname" "$_mjson"
            ;;
        check-rot)
            [ $# -ge 3 ] || usage
            cmd_agent check-rot "$1" "$2" "$3"
            return $?
            ;;
        *)
            usage
            ;;
    esac
}

cmd_adapt() {
    [ $# -ge 1 ] || usage
    _akind=$1
    shift
    if [ "$_akind" != "c" ]; then
        echo "lume adapt: unsupported adapter '$_akind' (only 'c' is implemented)" >&2
        return 64
    fi
    _afile=""
    _aoutput=""
    _ajson=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) _ajson=1; shift ;;
            -o|--output)
                [ $# -ge 2 ] || usage
                _aoutput=$2
                shift 2
                ;;
            -*) usage ;;
            *)
                [ -z "$_afile" ] || usage
                _afile=$1
                shift
                ;;
        esac
    done
    [ -n "$_afile" ] || usage
    if [ ! -f "$_afile" ]; then
        echo "lume adapt: cannot read $_afile" >&2
        return 66
    fi
    if [ "$_ajson" -eq 1 ] && [ -n "$_aoutput" ]; then
        echo "lume adapt: --json and --output are mutually exclusive" >&2
        return 64
    fi
    _ain=$(mktemp)
    printf '@mode bind\n' > "$_ain"
    cat "$_afile" >> "$_ain"
    _aout=$(run_core_tool lcaas "$_ain")
    case "$_aout" in
        *'"ok":true'*) ;;
        *)
            printf '%s\n' "$_aout"
            rm -f "$_ain"
            return 1
            ;;
    esac
    if [ "$_ajson" -eq 1 ]; then
        printf '%s\n' "$_aout"
        rm -f "$_ain"
        return 0
    fi
    printf '@mode bind-source\n' > "$_ain"
    cat "$_afile" >> "$_ain"
    if [ -n "$_aoutput" ]; then
        _atmp=$(mktemp)
        run_core_tool lcaas "$_ain" > "$_atmp"
        mv "$_atmp" "$_aoutput"
    else
        run_core_tool lcaas "$_ain"
    fi
    rm -f "$_ain"
}

cmd_agent() {
    [ $# -ge 1 ] || usage
    _afile=""
    _afile2=""
    _afile3=""
    _amode=""
    while [ $# -gt 0 ]; do
        case "$1" in
            bind) _amode="bind"; shift ;;
            witness) _amode="witness"; shift ;;
            repair) _amode="repair"; shift ;;
            impact) _amode="impact"; shift ;;
            hashes) _amode="hashes"; shift ;;
            grammar) _amode="grammar"; shift ;;
            project) _amode="project"; shift ;;
            c-export) _amode="c-export"; shift ;;
            kernel) _amode="kernel"; shift ;;
            lsp) _amode="lsp"; shift ;;
            dap) _amode="dap"; shift ;;
            repl) _amode="repl"; shift ;;
            proof-diff) _amode="proof-diff"; shift ;;
            check-rot) _amode="check-rot"; shift ;;
            share) _amode="share"; shift ;;
            patch) _amode="patch"; shift ;;
            replay) _amode="replay"; shift ;;
            lineage) _amode="lineage"; shift ;;
            compose) _amode="compose"; shift ;;
            check|compile|fill|prove|ast|expand|symbols|eval|--json) shift ;;
            -*) usage ;;
            *)
                if [ -z "$_afile" ]; then
                    _afile=$1
                elif [ -z "$_afile2" ]; then
                    _afile2=$1
                else
                    _afile3=$1
                fi
                shift
                ;;
        esac
    done
    [ -n "$_afile" ] || usage
    if [ ! -f "$_afile" ]; then
        echo "lume agent: cannot read $_afile" >&2
        exit 66
    fi
    if [ "$_amode" = "bind" ]; then
        cmd_adapt c --json "$_afile"
        return $?
    fi
    if [ "$_amode" = "proof-diff" ] || [ "$_amode" = "compose" ]; then
        [ -n "$_afile2" ] && [ -f "$_afile2" ] || usage
        _b1=$(mktemp)
        _b2=$(mktemp)
        bundle_src_if_needed "$_afile" "$_b1" || cp "$_afile" "$_b1"
        bundle_src_if_needed "$_afile2" "$_b2" || cp "$_afile2" "$_b2"
        _atmp=$(mktemp)
        printf '@mode %s\n' "$_amode" > "$_atmp"
        cat "$_b1" >> "$_atmp"
        printf '\n@split\n' >> "$_atmp"
        cat "$_b2" >> "$_atmp"
        _aout=$(run_core_tool lcaas "$_atmp")
        rm -f "$_b1" "$_b2" "$_atmp"
        printf '%s\n' "$_aout"
        case "$_aout" in
            *'"ok":true'*) return 0 ;;
            *) return 1 ;;
        esac
    fi
    if [ "$_amode" = "check-rot" ]; then
        [ -n "$_afile2" ] && [ -f "$_afile2" ] && [ -n "$_afile3" ] && [ -f "$_afile3" ] || usage
        _atmp=$(mktemp)
        printf '@mode check-rot\n' > "$_atmp"
        cat "$_afile" >> "$_atmp"
        printf '\n@split\n' >> "$_atmp"
        cat "$_afile2" >> "$_atmp"
        printf '\n@split\n' >> "$_atmp"
        cat "$_afile3" >> "$_atmp"
        _aout=$(run_core_tool lcaas "$_atmp")
        rm -f "$_atmp"
        printf '%s\n' "$_aout"
        case "$_aout" in
            *'"ok":true'*) return 0 ;;
            *) return 1 ;;
        esac
    fi
    if [ "$_amode" = "patch" ]; then
        [ -n "$_afile2" ] && [ -n "$_afile3" ] || usage
        _b1=$(mktemp)
        bundle_src_if_needed "$_afile" "$_b1" || cp "$_afile" "$_b1"
        _atmp=$(mktemp)
        printf '@mode patch\n' > "$_atmp"
        cat "$_b1" >> "$_atmp"
        printf '\n@split\n%s\n@split\n%s\n' "$_afile2" "$_afile3" >> "$_atmp"
        _aout=$(run_core_tool lcaas "$_atmp")
        rm -f "$_b1" "$_atmp"
        printf '%s\n' "$_aout"
        case "$_aout" in
            *'"ok":true'*) return 0 ;;
            *) return 1 ;;
        esac
    fi
    if [ "$_amode" = "lineage" ]; then
        _b1=$(mktemp)
        bundle_src_if_needed "$_afile" "$_b1" || cp "$_afile" "$_b1"
        _atmp=$(mktemp)
        printf '@mode lineage\n' > "$_atmp"
        cat "$_b1" >> "$_atmp"
        if [ -n "$_afile2" ]; then
            printf '\n@split\n%s\n' "$_afile2" >> "$_atmp"
        fi
        _aout=$(run_core_tool lcaas "$_atmp")
        rm -f "$_b1" "$_atmp"
        printf '%s\n' "$_aout"
        return 0
    fi
    _abun=$(mktemp)
    if ! bundle_src_if_needed "$_afile" "$_abun"; then
        rm -f "$_abun"
        exit 1
    fi
    if [ -n "$_amode" ]; then
        _atmp=$(mktemp)
        printf '@mode %s\n' "$_amode" > "$_atmp"
        cat "$_abun" >> "$_atmp"
        _aout=$(run_core_tool lcaas "$_atmp")
        rm -f "$_abun" "$_atmp"
        printf '%s\n' "$_aout"
        if [ "$_amode" = "share" ] || [ "$_amode" = "replay" ]; then
            case "$_aout" in
                *'"ok":true'*) return 0 ;;
                *) return 1 ;;
            esac
        fi
        return 0
    fi
    run_core_tool lcaas "$_abun"
    rm -f "$_abun"
}

_JRPC_FRAMED=0
_JRPC_MSG=""

jsonrpc_read_msg() {
    _JRPC_MSG=""
    while IFS= read -r _j_line; do
        _j_line=$(printf '%s' "$_j_line" | tr -d '\r')
        [ -n "$_j_line" ] || continue
        case "$_j_line" in
            Content-Length:*|content-length:*)
                _JRPC_FRAMED=1
                _j_clen=$(printf '%s' "$_j_line" | awk '{print $2}')
                while IFS= read -r _j_hdr; do
                    _j_hdr=$(printf '%s' "$_j_hdr" | tr -d '\r')
                    [ -z "$_j_hdr" ] && break
                done
                _JRPC_MSG=$(dd bs=1 count="$_j_clen" 2>/dev/null)
                return 0
                ;;
            \{*)
                _JRPC_MSG="$_j_line"
                return 0
                ;;
        esac
    done
    return 1
}

jsonrpc_send_msg() {
    if [ "$_JRPC_FRAMED" -eq 1 ]; then
        _s_len=$(printf '%s' "$1" | wc -c | tr -d ' ')
        printf 'Content-Length: %s\r\n\r\n%s' "$_s_len" "$1"
    else
        printf '%s\n' "$1"
    fi
}

jsonrpc_extract_str() {
    printf '%s' "$1" | awk -v k="\"$2\"" '
        {
            pat = k "[ \t]*:[ \t]*\""
            if (match($0, pat)) {
                s = substr($0, RSTART + RLENGTH)
                out = ""
                esc = 0
                for (i = 1; i <= length(s); i++) {
                    c = substr(s, i, 1)
                    if (esc) {
                        if (c == "n") out = out "\n"
                        else if (c == "t") out = out "\t"
                        else if (c == "r") out = out ""
                        else out = out c
                        esc = 0
                    } else if (c == "\\") {
                        esc = 1
                    } else if (c == "\"") {
                        break
                    } else {
                        out = out c
                    }
                }
                printf "%s", out
            }
        }'
}

cmd_lsp() {
    _lfile=""
    _ljson=0
    _lstdio=0
    for _arg in "$@"; do
        case "$_arg" in
            --json) _ljson=1 ;;
            --stdio) _lstdio=1 ;;
            -*) usage ;;
            *) _lfile=$_arg ;;
        esac
    done
    if [ -n "$_lfile" ] && [ "$_lstdio" -eq 0 ]; then
        cmd_agent lsp "$_lfile"
        return $?
    fi
    _lsp_dir=$(mktemp -d "${TMPDIR:-/tmp}/lume_lsp_XXXXXX")
    _lsp_src="$_lsp_dir/doc.src"
    if [ -n "$_lfile" ] && [ -f "$_lfile" ]; then
        cp "$_lfile" "$_lsp_src"
        _lsp_uri="file://$_lfile"
    else
        printf 'fn placeholder() -> int = 0\n' > "$_lsp_src"
        _lsp_uri="file:///workspace/module.src"
    fi
    _lsp_diags="[]"
    _lsp_symbols="[]"
    _lsp_hovers="[]"
    _lsp_actions="[]"
    _lsp_holes="[]"
    _lsp_proofs="[]"
    _lsp_shutdown=0

    lsp_refresh_analysis() {
        _lbun="$_lsp_dir/bun.src"
        if ! bundle_src_if_needed "$_lsp_src" "$_lbun" 2>/dev/null; then
            cp "$_lsp_src" "$_lbun"
        fi
        _lin="$_lsp_dir/in.src"
        printf '@mode lsp\n' > "$_lin"
        cat "$_lbun" >> "$_lin"
        _lout=$(run_core_tool lcaas "$_lin" 2>/dev/null || true)
        if [ -n "$_lout" ]; then
            _lsp_diags=$(printf '%s' "$_lout" | awk '{a=index($0,"\"diagnostics\":"); b=index($0,"},\"documentSymbols\":"); if(a>0&&b>a) printf "%s", substr($0,a+14,b-(a+14)); else printf "[]"}')
            _lsp_symbols=$(printf '%s' "$_lout" | awk '{a=index($0,"},\"documentSymbols\":"); b=index($0,",\"hovers\":"); if(a>0&&b>a) printf "%s", substr($0,a+20,b-(a+20)); else printf "[]"}')
            _lsp_hovers=$(printf '%s' "$_lout" | awk '{a=index($0,",\"hovers\":"); b=index($0,",\"codeActions\":"); if(a>0&&b>a) printf "%s", substr($0,a+10,b-(a+10)); else printf "[]"}')
            _lsp_actions=$(printf '%s' "$_lout" | awk '{a=index($0,",\"codeActions\":"); b=index($0,",\"holes\":"); if(a>0&&b>a) printf "%s", substr($0,a+15,b-(a+15)); else printf "[]"}')
            _lsp_holes=$(printf '%s' "$_lout" | awk '{a=index($0,",\"holes\":"); b=index($0,",\"proofs\":"); if(a>0&&b>a) printf "%s", substr($0,a+9,b-(a+9)); else printf "[]"}')
            _lsp_proofs=$(printf '%s' "$_lout" | awk '{a=index($0,",\"proofs\":"); if(a>0) printf "%s", substr($0,a+10,length($0)-(a+10)); else printf "[]"}')
        fi
    }

    while jsonrpc_read_msg; do
        _id=$(printf '%s' "$_JRPC_MSG" | sed -n 's/.*"id"[ \t]*:[ \t]*\([0-9a-zA-Z"_.-]*\).*/\1/p')
        [ -n "$_id" ] || _id="null"
        case "$_JRPC_MSG" in
            *'"method"'*'"initialize"'*)
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"id\":$_id,\"result\":{\"protocol\":\"lsp/3.17\",\"serverInfo\":{\"name\":\"lume-lsp\",\"version\":\"0.2.0\"},\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,\"codeActionProvider\":true,\"inlayHintProvider\":true}}}"
                ;;
            *'"method"'*'"initialized"'*)
                ;;
            *'"textDocument/didOpen"'*|*'"textDocument/didChange"'*)
                _u=$(jsonrpc_extract_str "$_JRPC_MSG" "uri")
                [ -n "$_u" ] && _lsp_uri="$_u"
                _txt=$(jsonrpc_extract_str "$_JRPC_MSG" "text")
                if [ -n "$_txt" ]; then
                    printf '%s\n' "$_txt" > "$_lsp_src"
                elif [ -n "$_u" ]; then
                    _upath=${_u#file://}
                    [ -f "$_upath" ] && cp "$_upath" "$_lsp_src"
                fi
                lsp_refresh_analysis
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"$_lsp_uri\",\"diagnostics\":$_lsp_diags,\"proofs\":$_lsp_proofs,\"holes\":$_lsp_holes}}"
                ;;
            *'"textDocument/hover"'*)
                lsp_refresh_analysis
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"id\":$_id,\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"Lume verified symbol hover\"},\"hovers\":$_lsp_hovers,\"proofs\":$_lsp_proofs}}"
                ;;
            *'"textDocument/codeAction"'*)
                lsp_refresh_analysis
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"id\":$_id,\"result\":$_lsp_actions}"
                ;;
            *'"textDocument/documentSymbol"'*)
                lsp_refresh_analysis
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"id\":$_id,\"result\":$_lsp_symbols}"
                ;;
            *'"method"'*'"shutdown"'*)
                _lsp_shutdown=1
                jsonrpc_send_msg "{\"jsonrpc\":\"2.0\",\"id\":$_id,\"result\":null}"
                ;;
            *'"method"'*'"exit"'*)
                rm -rf "$_lsp_dir"
                if [ "$_lsp_shutdown" -eq 1 ]; then
                    return 0
                else
                    return 1
                fi
                ;;
        esac
    done
    rm -rf "$_lsp_dir"
    return 0
}

cmd_dap() {
    _dfile=""
    _djson=0
    _dstdio=0
    for _arg in "$@"; do
        case "$_arg" in
            --json) _djson=1 ;;
            --stdio) _dstdio=1 ;;
            -*) usage ;;
            *) _dfile=$_arg ;;
        esac
    done
    if [ -n "$_dfile" ] && [ "$_dstdio" -eq 0 ]; then
        cmd_agent dap "$_dfile"
        return $?
    fi
    _dap_dir=$(mktemp -d "${TMPDIR:-/tmp}/lume_dap_XXXXXX")
    _dap_src="$_dap_dir/prog.src"
    if [ -n "$_dfile" ] && [ -f "$_dfile" ]; then
        cp "$_dfile" "$_dap_src"
    else
        printf 'fn main_step(x: int) -> int = x + 1\nprint main_step(41)\n' > "$_dap_src"
    fi
    _dap_seq=1
    _dap_step=1
    _dap_history="1"
    _dap_frames="[]"
    _dap_scopes="[]"
    _dap_out=""

    dap_refresh_state() {
        _dbun="$_dap_dir/bun.src"
        if ! bundle_src_if_needed "$_dap_src" "$_dbun" 2>/dev/null; then
            cp "$_dap_src" "$_dbun"
        fi
        _din="$_dap_dir/in.src"
        printf '@mode dap\n' > "$_din"
        cat "$_dbun" >> "$_din"
        _dout=$(run_core_tool lcaas "$_din" 2>/dev/null || true)
        if [ -n "$_dout" ]; then
            _dap_frames=$(printf '%s' "$_dout" | awk '{a=index($0,",\"stackFrames\":"); b=index($0,",\"scopes\":"); if(a>0&&b>a) printf "%s", substr($0,a+15,b-(a+15)); else printf "[]"}')
            _dap_scopes=$(printf '%s' "$_dout" | awk '{a=index($0,",\"scopes\":"); b=index($0,",\"output\":"); if(a>0&&b>a) printf "%s", substr($0,a+10,b-(a+10)); else printf "[]"}')
            _dap_out=$(jsonrpc_extract_str "$_dout" "output")
        fi
    }

    while jsonrpc_read_msg; do
        _rseq=$(printf '%s' "$_JRPC_MSG" | sed -n 's/.*"seq"[ \t]*:[ \t]*\([0-9]*\).*/\1/p')
        [ -n "$_rseq" ] || _rseq=1
        _cmd=$(jsonrpc_extract_str "$_JRPC_MSG" "command")
        case "$_cmd" in
            initialize)
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"protocol\":\"dap/1.65\",\"adapter\":\"lume-dap\",\"command\":\"initialize\",\"body\":{\"supportsConfigurationDoneRequest\":true,\"supportsStepBack\":true,\"supportsEvaluateForHovers\":true}}"
                _dap_seq=$((_dap_seq + 1))
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"event\",\"event\":\"initialized\",\"body\":{}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            configurationDone)
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"configurationDone\",\"body\":{}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            launch)
                _prog=$(jsonrpc_extract_str "$_JRPC_MSG" "program")
                _stxt=$(jsonrpc_extract_str "$_JRPC_MSG" "source")
                if [ -n "$_stxt" ]; then
                    printf '%s\n' "$_stxt" > "$_dap_src"
                elif [ -n "$_prog" ] && [ -f "$_prog" ]; then
                    cp "$_prog" "$_dap_src"
                fi
                dap_refresh_state
                _dap_step=1
                _dap_history="1"
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"launch\",\"body\":{\"output\":\"$_dap_out\"}}"
                _dap_seq=$((_dap_seq + 1))
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"event\",\"event\":\"stopped\",\"body\":{\"reason\":\"entry\",\"threadId\":1,\"step\":$_dap_step,\"replay\":false}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            next|stepIn|stepOut)
                _dap_step=$((_dap_step + 1))
                _dap_history="$_dap_history,$_dap_step"
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"$_cmd\",\"body\":{\"step\":$_dap_step}}"
                _dap_seq=$((_dap_seq + 1))
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"event\",\"event\":\"stopped\",\"body\":{\"reason\":\"step\",\"threadId\":1,\"step\":$_dap_step,\"replay\":false}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            stepBack|reverseContinue)
                if [ "$_dap_step" -gt 1 ]; then
                    _dap_step=$((_dap_step - 1))
                fi
                _dap_history="$_dap_history,$_dap_step"
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"$_cmd\",\"body\":{\"step\":$_dap_step,\"replay\":true}}"
                _dap_seq=$((_dap_seq + 1))
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"event\",\"event\":\"stopped\",\"body\":{\"reason\":\"step\",\"threadId\":1,\"step\":$_dap_step,\"replay\":true}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            stackTrace)
                dap_refresh_state
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"stackTrace\",\"body\":{\"currentStep\":$_dap_step,\"traceHistory\":\"$_dap_history\",\"stackFrames\":$_dap_frames}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            scopes|variables)
                dap_refresh_state
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"$_cmd\",\"body\":{\"scopes\":$_dap_scopes}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            evaluate)
                _expr=$(jsonrpc_extract_str "$_JRPC_MSG" "expression")
                _deval="$_dap_dir/eval.src"
                awk '!/^[ \t]*print[ \t]+/' "$_dap_src" > "$_deval"
                printf 'print (%s)\n' "${_expr:-0}" >> "$_deval"
                _debun="$_dap_dir/eval_bun.src"
                if ! bundle_src_if_needed "$_deval" "$_debun" 2>/dev/null; then
                    cp "$_deval" "$_debun"
                fi
                _ej=$(run_core_tool lcaas "$_debun" 2>/dev/null || true)
                _eres=$(jsonrpc_extract_str "$_ej" "result" | tr -d '\n')
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"evaluate\",\"body\":{\"result\":\"$_eres\",\"step\":$_dap_step}}"
                _dap_seq=$((_dap_seq + 1))
                ;;
            disconnect|terminate)
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"response\",\"request_seq\":$_rseq,\"success\":true,\"command\":\"${_cmd:-disconnect}\",\"body\":{}}"
                _dap_seq=$((_dap_seq + 1))
                jsonrpc_send_msg "{\"seq\":$_dap_seq,\"type\":\"event\",\"event\":\"terminated\",\"body\":{}}"
                rm -rf "$_dap_dir"
                return 0
                ;;
        esac
    done
    rm -rf "$_dap_dir"
    return 0
}

cmd_repl() {
    _rfile=""
    _rjson=0
    _rkernel=0
    for _arg in "$@"; do
        case "$_arg" in
            --json) _rjson=1 ;;
            --kernel) _rjson=1; _rkernel=1 ;;
            -*) usage ;;
            *) _rfile=$_arg ;;
        esac
    done
    if [ -n "$_rfile" ]; then
        if [ ! -f "$_rfile" ]; then
            echo "lume repl: cannot read $_rfile" >&2
            exit 66
        fi
        if [ "$_rjson" -eq 1 ]; then
            cmd_agent repl "$_rfile"
        else
            cmd_run "$_rfile"
        fi
        return $?
    fi
    _repl_dir=$(mktemp -d "${TMPDIR:-/tmp}/lume_repl_XXXXXX")
    _repl_defs="$_repl_dir/defs.src"
    : > "$_repl_defs"
    _exec_cnt=0

    if [ "$_rkernel" -eq 1 ] || [ "$_rjson" -eq 1 ]; then
        while jsonrpc_read_msg; do
            _mtype=$(jsonrpc_extract_str "$_JRPC_MSG" "msg_type")
            [ -n "$_mtype" ] || _mtype=$(jsonrpc_extract_str "$_JRPC_MSG" "method")
            case "$_mtype" in
                kernel_info_request)
                    jsonrpc_send_msg "{\"msg_type\":\"kernel_info_reply\",\"protocol\":\"lume-repl/1.0\",\"protocol_version\":\"5.3\",\"implementation\":\"lume-kernel-v1\",\"language_info\":{\"name\":\"lume\",\"version\":\"0.2.0\",\"mimetype\":\"text/x-lume\",\"file_extension\":\".src\"},\"status\":\"ok\"}"
                    ;;
                is_complete_request)
                    jsonrpc_send_msg "{\"msg_type\":\"is_complete_reply\",\"status\":\"complete\"}"
                    ;;
                shutdown_request|exit)
                    jsonrpc_send_msg "{\"msg_type\":\"shutdown_reply\",\"status\":\"ok\",\"restart\":false}"
                    rm -rf "$_repl_dir"
                    return 0
                    ;;
                execute_request|*)
                    _exec_cnt=$((_exec_cnt + 1))
                    _code=$(jsonrpc_extract_str "$_JRPC_MSG" "code")
                    _turn="$_repl_dir/turn.src"
                    cat "$_repl_defs" > "$_turn"
                    printf '%s\n' "$_code" >> "$_turn"
                    _tbun="$_repl_dir/tbun.src"
                    if ! bundle_src_if_needed "$_turn" "$_tbun" 2>/dev/null; then
                        cp "$_turn" "$_tbun"
                    fi
                    _tin="$_repl_dir/tin.src"
                    printf '@mode repl\n' > "$_tin"
                    cat "$_tbun" >> "$_tin"
                    _rj=$(run_core_tool lcaas "$_tin" 2>/dev/null || true)
                    if printf '%s' "$_rj" | grep -q '"ok":true'; then
                        printf '%s\n' "$_code" | awk '/^[ \t]*(use|type|law|effect|pub|total|fn|@)[ \t]+/' >> "$_repl_defs"
                        if printf '%s' "$_rj" | grep -q '"text/plain":"<runtime>'; then
                            _rout=$(cmd_run "$_turn" 2>/dev/null | awk '{printf "%s\\n", $0}')
                            _rj=$(printf '%s' "$_rj" | sed "s|\"text/plain\":\"[^\"]*\"|\"text/plain\":\"$_rout\"|")
                        fi
                    fi
                    _rj=$(printf '%s' "$_rj" | sed "s/\"execution_count\":1/\"msg_type\":\"execute_reply\",\"execution_count\":$_exec_cnt/")
                    jsonrpc_send_msg "$_rj"
                    ;;
            esac
        done
        rm -rf "$_repl_dir"
        return 0
    fi

    while IFS= read -r _rline; do
        _rline=$(printf '%s' "$_rline" | tr -d '\r')
        _rtrim=$(printf '%s' "$_rline" | sed 's/^[ \t]*//;s/[ \t]*$//')
        [ -n "$_rtrim" ] || continue
        case "$_rtrim" in
            \#\#*) continue ;;
            :quit|:exit|:q) break ;;
            :reset)
                : > "$_repl_defs"
                printf 'reset\n'
                continue
                ;;
            :help)
                printf 'lume repl commands: :help :vars :reset :quit\n'
                continue
                ;;
            :vars|:symbols)
                _vbun="$_repl_dir/vbun.src"
                cp "$_repl_defs" "$_vbun"
                printf 'print 0\n' >> "$_vbun"
                run_core_tool lcaas "$_vbun"
                continue
                ;;
            use\ *|type\ *|law\ *|effect\ *|pub\ *|total\ *|fn\ *|@*)
                _cand="$_repl_dir/cand.src"
                cat "$_repl_defs" > "$_cand"
                printf '%s\n' "$_rtrim" >> "$_cand"
                _cbun="$_repl_dir/cbun.src"
                if ! bundle_src_if_needed "$_cand" "$_cbun" 2>/dev/null; then
                    cp "$_cand" "$_cbun"
                fi
                _cj=$(run_core_tool lcaas "$_cbun" 2>/dev/null || true)
                if printf '%s' "$_cj" | grep -q '"ok":true'; then
                    cp "$_cand" "$_repl_defs"
                    _exec_cnt=$((_exec_cnt + 1))
                    printf '[%d] defined\n' "$_exec_cnt"
                else
                    _emsg=$(jsonrpc_extract_str "$_cj" "message")
                    printf 'error: %s\n' "${_emsg:-compile error}"
                fi
                ;;
            *)
                _turn="$_repl_dir/turn.src"
                cat "$_repl_defs" > "$_turn"
                case "$_rtrim" in
                    print\ *) printf '%s\n' "$_rtrim" >> "$_turn" ;;
                    *)        printf 'print (%s)\n' "$_rtrim" >> "$_turn" ;;
                esac
                _tbun="$_repl_dir/tbun.src"
                if ! bundle_src_if_needed "$_turn" "$_tbun" 2>/dev/null; then
                    cp "$_turn" "$_tbun"
                fi
                _tj=$(run_core_tool lcaas "$_tbun" 2>/dev/null || true)
                if printf '%s' "$_tj" | grep -q '"ok":true'; then
                    _exec_cnt=$((_exec_cnt + 1))
                    _res=$(jsonrpc_extract_str "$_tj" "result")
                    case "$_res" in
                        *"<runtime>"*|"")
                            cmd_run "$_turn"
                            ;;
                        *)
                            printf '%s\n' "$_res"
                            ;;
                    esac
                else
                    _emsg=$(jsonrpc_extract_str "$_tj" "message")
                    printf 'error: %s\n' "${_emsg:-compile error}"
                fi
                ;;
        esac
    done
    rm -rf "$_repl_dir"
    return 0
}

synthesize_intent_to_cache() {
    _if_in=$1
    _if_cache=$2
    _if_cert="${_if_cache%.src}.cert.json"
    _if_tmp=$(mktemp)
    printf '@mode intent-code\n' > "$_if_tmp"
    cat "$_if_in" >> "$_if_tmp"
    if [ -f "$_if_cache" ]; then
        printf '\n@split\n' >> "$_if_tmp"
        cat "$_if_cache" >> "$_if_tmp"
    fi
    _if_out=$(mktemp)
    if ! run_core_tool lcaas "$_if_tmp" | tr -d '\r' > "$_if_out"; then
        rm -f "$_if_tmp" "$_if_out"
        return 3
    fi
    mv "$_if_out" "$_if_cache"
    rm -f "$_if_tmp"
    cmd_certify "$_if_cache" > "$_if_cert" 2>/dev/null || true
    return 0
}

cmd_intent() {
    [ $# -ge 1 ] || usage
    _iact="build"
    case "$1" in
        build|run|verify|status|clean)
            _iact=$1
            shift
            ;;
    esac
    _ifile=""
    _icache=""
    _iout=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -o)
                [ $# -ge 2 ] || usage
                _iout=$2
                shift 2
                ;;
            --cache)
                [ $# -ge 2 ] || usage
                _icache=$2
                shift 2
                ;;
            --json)
                shift
                ;;
            -*)
                usage
                ;;
            *)
                if [ -z "$_ifile" ]; then
                    _ifile=$1
                fi
                shift
                ;;
        esac
    done
    [ -n "$_ifile" ] || usage
    if [ ! -f "$_ifile" ]; then
        echo "lume intent: cannot read $_ifile" >&2
        exit 66
    fi
    [ -n "$_icache" ] || _icache="${_ifile}.cache.src"
    _icert="${_icache%.src}.cert.json"
    case "$_iact" in
        clean)
            rm -f "$_icache" "$_icert"
            printf '{"ok":true,"mode":"intent-clean","cache_file":"%s"}\n' "$_icache"
            return 0
            ;;
        verify|status)
            _itmp=$(mktemp)
            printf '@mode intent-verify\n' > "$_itmp"
            cat "$_ifile" >> "$_itmp"
            if [ -f "$_icache" ]; then
                printf '\n@split\n' >> "$_itmp"
                cat "$_icache" >> "$_itmp"
            fi
            _ijson=$(run_core_tool lcaas "$_itmp")
            rm -f "$_itmp"
            printf '%s\n' "$_ijson"
            case "$_ijson" in
                *'"ok":true'*) return 0 ;;
                *) return 1 ;;
            esac
            ;;
        run)
            if ! synthesize_intent_to_cache "$_ifile" "$_icache"; then
                exit 3
            fi
            cmd_run "$_icache"
            return $?
            ;;
        build|*)
            _itmp=$(mktemp)
            printf '@mode intent-build\n' > "$_itmp"
            cat "$_ifile" >> "$_itmp"
            if [ -f "$_icache" ]; then
                printf '\n@split\n' >> "$_itmp"
                cat "$_icache" >> "$_itmp"
            fi
            _ijson=$(run_core_tool lcaas "$_itmp")
            rm -f "$_itmp"
            case "$_ijson" in
                *'"ok":true'*) ;;
                *)
                    printf '%s\n' "$_ijson"
                    return 3
                    ;;
            esac
            case "$_ijson" in
                *'"cache_hit":true'*)
                    if [ ! -f "$_icert" ]; then
                        cmd_certify "$_icache" > "$_icert" 2>/dev/null || true
                    fi
                    ;;
                *)
                    if ! synthesize_intent_to_cache "$_ifile" "$_icache"; then
                        printf '%s\n' "$_ijson"
                        return 3
                    fi
                    ;;
            esac
            if [ -n "$_iout" ]; then
                cmd_build "$_icache" -o "$_iout"
            fi
            printf '%s\n' "$_ijson"
            return 0
            ;;
    esac
}

cmd_certify() {
    [ $# -ge 1 ] || usage
    _cfile=""
    for _arg in "$@"; do
        case "$_arg" in
            --json) ;;
            -*) usage ;;
            *) _cfile=$_arg ;;
        esac
    done
    [ -n "$_cfile" ] || usage
    if [ ! -f "$_cfile" ]; then
        echo "lume certify: cannot read $_cfile" >&2
        exit 66
    fi
    _cbun=$(mktemp)
    if ! bundle_src_if_needed "$_cfile" "$_cbun"; then
        rm -f "$_cbun"
        exit 1
    fi
    _src_sha=$(sha256_file "$_cbun")
    _ctmp=$(mktemp)
    printf '@mode certify\n@sha256 %s\n' "$_src_sha" > "$_ctmp"
    cat "$_cbun" >> "$_ctmp"
    _cjson=$(run_core_tool lcaas "$_ctmp")
    rm -f "$_cbun" "$_ctmp"
    printf '%s\n' "$_cjson"
    case "$_cjson" in
        *'"ok":true'*) return 0 ;;
        *) return 1 ;;
    esac
}

cmd_verify_cert() {
    [ $# -ge 1 ] || usage
    _cfile=""
    for _arg in "$@"; do
        case "$_arg" in
