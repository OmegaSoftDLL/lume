            --check) _check=1 ;;
            --stdout) _stdout=1 ;;
            -*) usage ;;
            *) _files="$_files $_arg" ;;
        esac
    done
    set -- $_files
    [ $# -ge 1 ] || usage
    _rc=0
    for _file in "$@"; do
        if [ ! -f "$_file" ]; then
            echo "lume fmt: cannot read $_file" >&2
            exit 66
        fi
        _tmpfmt=$(mktemp)
        case "$_file" in
            *.src)
                if [ -f "$SRC_DIR/lfmt.src" ]; then
                    run_core_tool lfmt "$_file" > "$_tmpfmt"
                else
                    awk '{ sub(/[ \t\r]+$/, ""); if ($0 == "") { b++; if (b <= 1) print "" } else { b = 0; print $0 } }' "$_file" > "$_tmpfmt"
                fi
                ;;
            *)
                awk '{ sub(/[ \t\r]+$/, ""); if ($0 == "") { b++; if (b <= 1) print "" } else { b = 0; print $0 } }' "$_file" > "$_tmpfmt"
                ;;
        esac
        if [ "$_stdout" -eq 1 ]; then
            cat "$_tmpfmt"
