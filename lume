#!/bin/sh
# lume — single command-line tool for the Lume programming language (P28, Track T / T1).
#
# Subcommands:
#   lume build <file.src> [-o <out>]          compile Lume source to a native ELF binary (no C, no as/ld)
#   lume run   <file.src|file.lume> [args...] compile & run native (.src) or interpret (.lume/.lbe)
#   lume test  <file.src|file.lume>...        discover and run unit tests (fn test_*() and contracts)
#   lume doc   [--json] <file.src|file.lume>  extract module/item docs and contracts (Markdown or JSON)
#   lume fmt   [--check] <file.src|file.lume> format source to canonical layout (or check with --check)
#   lume pkg   <init|check|lock|verify|tree>  package manager: lume.toml manifest, capabilities & SHA-256 lume.lock
#   lume agent [check|compile|ast|...] <file> in-process compiler-as-a-service JSON protocol (E1b)
#   lume prove [--json] <file.src>            static QF_LIA contract, invariant & law verification (V2/V3)
#   lume evolve <verify|approve|goals|...>    self-evolution & governance loop (E3)
#   lume check [--json] <file.lume|file.src>  static lexical, parse, name, type and contract checks
#   lume compile [--json] [--run] <file.src>  compile-as-a-service: {ok, diagnostics, asm, stdout} (E1, AI-first)
#   lume describe [--json]                    emit machine-readable language self-description (AI-first)
#   lume --version | --help
set -eu

# The self-hosted lexer/parser recurse per source character; raise the stack so compiling a
# large Lume source does not overflow the default 8 MB stack.
ulimit -s unlimited 2>/dev/null || ulimit -s 524288 2>/dev/null || true

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SRC_DIR="$ROOT/compiler/stage1"
L0="$ROOT/bootstrap/lume0/lume0"
if [ ! -x "$L0" ] && [ -x "$ROOT/bootstrap/lume0/lume0.exe" ]; then
    L0="$ROOT/bootstrap/lume0/lume0.exe"
fi
BIN_DIR="${LUME_BIN_DIR:-$ROOT/build/bin}"

usage() {
    cat >&2 <<'EOF'
lume 0.2.0 — the AI-first programming language (edition 2026)

usage:
  lume build <file.src> [-o <out>]          compile to a standalone native ELF executable (no C, no as/ld)
  lume run   <file.src|file.lume> [args...] run a Lume program (native ELF for .src, interpreter for .lume/.lbe)
  lume test  <file.src|file.lume>...        discover and run unit tests (`fn test_*()` and runtime contracts)
  lume doc   [--json] <file.src|file.lume>  render module & item documentation + contracts (Markdown or JSON)
  lume fmt   [--check] <file>               format a Lume source file in place (or verify with --check)
  lume pkg   <init|check|lock|verify|tree>  manage lume.toml manifest, capabilities & SHA-256 lume.lock
  lume agent [check|compile|ast|...] <file> query in-process compiler-as-a-service JSON protocol
  lume prove [--json] <file.src>            verify requires/ensures/invariant/law contracts statically
  lume evolve <verify|approve|goals|...>    run self-evolution gates and human governance loop
  lume check [--json] <file.lume|file.src>  run static semantic checks
  lume compile [--json] [--run] <file.src>  compile-as-a-service: structured {ok, diagnostics, asm, stdout}
  lume describe [--json]                    emit machine-readable language self-description for AI agents
  lume --version                            print version
EOF
    exit 64
}

ensure_seed() {
    if [ ! -x "$L0" ]; then
        make -s -C "$ROOT/bootstrap/lume0"
    fi
}

is_linux_x86_64() {
    [ "$(uname -s)" = "Linux" ] && [ "$(uname -m)" = "x86_64" ]
}

# Locate or build the native self-hosted compiler (lumec) and assembler (lasm).
ensure_native_toolchain() {
    mkdir -p "$BIN_DIR"
    if [ -x "$BIN_DIR/lc" ]; then
        LUMEC="$BIN_DIR/lc"
    elif [ -x "$BIN_DIR/lumec" ]; then
        LUMEC="$BIN_DIR/lumec"
    elif [ -x "$ROOT/build/bootstrap/lumec3" ]; then
        LUMEC="$ROOT/build/bootstrap/lumec3"
    else
        ensure_seed
        # lumec.src is generated by amalgamating compiler/stage1/lume/*.src.
        sh "$ROOT/scripts/amalgamate.sh"
        "$L0" run "$SRC_DIR/data_asm_cc.lume" "$SRC_DIR/lumec.src" "$BIN_DIR/lumec.s" >/dev/null 2>&1
        "$L0" asm "$BIN_DIR/lumec.s" "$BIN_DIR/lumec" >/dev/null 2>&1
        chmod +x "$BIN_DIR/lumec"
        rm -f "$BIN_DIR/lumec.s"
        LUMEC="$BIN_DIR/lumec"
    fi

    if [ -x "$BIN_DIR/lasm" ]; then
        LASM="$BIN_DIR/lasm"
    elif [ -x "$ROOT/build/bootstrap/lasm3" ]; then
        LASM="$ROOT/build/bootstrap/lasm3"
    else
        ensure_seed
        "$LUMEC" < "$SRC_DIR/lasm.src" > "$BIN_DIR/lasm.s"
        "$L0" asm "$BIN_DIR/lasm.s" "$BIN_DIR/lasm" >/dev/null 2>&1
        chmod +x "$BIN_DIR/lasm"
        rm -f "$BIN_DIR/lasm.s"
        LASM="$BIN_DIR/lasm"
    fi
}

# Build a Lume-Core tool (e.g. ldoc, ltest, lfmt, levolve) to a native ELF using lumec + lasm.
ensure_core_tool() {
    if [ -x "$BIN_DIR/$1" ]; then
        return 0
    fi
    ensure_native_toolchain
    if [ "$1" = "lmod" ] || ! grep -Eq '^[ \t]*use[ \t]+' "$SRC_DIR/$1.src"; then
        "$LUMEC" < "$SRC_DIR/$1.src" > "$BIN_DIR/$1.s"
        "$LASM" < "$BIN_DIR/$1.s" > "$BIN_DIR/$1"
        chmod +x "$BIN_DIR/$1"
        rm -f "$BIN_DIR/$1.s"
    else
        ensure_core_tool lmod
        _ect_bun=$(mktemp)
        bundle_src_if_needed "$SRC_DIR/$1.src" "$_ect_bun"
        "$LUMEC" < "$_ect_bun" > "$BIN_DIR/$1.s"
        "$LASM" < "$BIN_DIR/$1.s" > "$BIN_DIR/$1"
        chmod +x "$BIN_DIR/$1"
        rm -f "$_ect_bun" "$BIN_DIR/$1.s"
    fi
}

# Run a Lume-Core tool (<tool>.src) with $2 as its stdin file, writing to stdout.
run_core_tool() {
    if is_linux_x86_64 && [ -z "${LUME0_ASAN:-}" ]; then
        ensure_core_tool "$1"
        "$BIN_DIR/$1" < "$2"
    else
        ensure_seed
        if [ "$1" = "lmod" ] || ! grep -Eq '^[ \t]*use[ \t]+' "$SRC_DIR/$1.src"; then
            "$L0" run "$SRC_DIR/compiler_in_core.lume" "$SRC_DIR/$1.src" "$2"
        else
            _rct_bun=$(mktemp)
            bundle_src_if_needed "$SRC_DIR/$1.src" "$_rct_bun"
            "$L0" run "$SRC_DIR/compiler_in_core.lume" "$_rct_bun" "$2"
            rm -f "$_rct_bun"
        fi
    fi
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        cksum "$1" | awk '{print $1}'
    fi
}

# Recursively collect reachable `use <mod>` .src modules in $_mdir into $_modin.
collect_reachable_mods() {
    _mdir=$1
    _mfile=$2
    _modin=$3
    _uses=$(awk '/^[ \t]*use[ \t]+/{sub(/^[ \t]*use[ \t]+/,""); sub(/[ \t\r]+$/,""); sub(/^std\./,""); print $1}' "$_mfile")
    for _u in $_uses; do
        case " $_MOD_SEEN " in
            *" $_u "*) continue ;;
        esac
        _MOD_SEEN="$_MOD_SEEN $_u"
        _ucand=""
        if [ -f "$_mdir/$_u.src" ]; then
            _ucand="$_mdir/$_u.src"
        elif [ -f "$_mdir/src/$_u.src" ]; then
            _ucand="$_mdir/src/$_u.src"
        elif [ -f "$_mdir/deps/$_u.src" ]; then
            _ucand="$_mdir/deps/$_u.src"
        elif [ -f "$SRC_DIR/$_u.src" ]; then
            _ucand="$SRC_DIR/$_u.src"
        fi
        if [ -n "$_ucand" ]; then
            printf '@module %s\n' "$_u" >> "$_modin"
            cat "$_ucand" >> "$_modin"
            printf '\n@end\n' >> "$_modin"
            collect_reachable_mods "$_mdir" "$_ucand" "$_modin"
        fi
    done
}

# Resolve `use <mod>` imports and verify lume.toml capability grants via native lmod.src.
bundle_src_if_needed() {
    _bsrc=$1
    _bout=$2
    if ! grep -Eq '^[ \t]*use[ \t]+' "$_bsrc"; then
        cp "$_bsrc" "$_bout"
        return 0
    fi
    _bdir=$(dirname -- "$_bsrc")
    _modin=$(mktemp)
    _grant="io"
    _toml=""
    if [ -f "$_bdir/lume.toml" ]; then
        _toml="$_bdir/lume.toml"
    elif [ -f "$_bdir/../lume.toml" ]; then
        _toml="$_bdir/../lume.toml"
    fi
    if [ -n "$_toml" ]; then
        _mtmp=$(mktemp)
        printf '@manifest\n' > "$_mtmp"
        cat "$_toml" >> "$_mtmp"
        if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
            rm -f "$_mtmp" "$_modin"
            return 1
        fi
        rm -f "$_mtmp"
        case "$_mjson" in
            *'"capabilities":"pure"'*) _grant="pure" ;;
        esac
    fi
    printf '@grant %s\n' "$_grant" > "$_modin"
    _ebase=$(basename -- "$_bsrc" .src)
    _MOD_SEEN="$_ebase"
    collect_reachable_mods "$_bdir" "$_bsrc" "$_modin"
    printf '@entry %s\n' "$_ebase" >> "$_modin"
    cat "$_bsrc" >> "$_modin"
    printf '\n@end\n' >> "$_modin"
    if ! run_core_tool lmod "$_modin" > "$_bout"; then
        rm -f "$_modin" "$_bout"
        return 1
    fi
    rm -f "$_modin"
}

cmd_build() {
    _src=""
    _out=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -o)
                [ $# -ge 2 ] || usage
                _out=$2
                shift 2
                ;;
            -*)
                usage
                ;;
            *)
                [ -z "$_src" ] || usage
                _src=$1
                shift
                ;;
        esac
    done
    [ -n "$_src" ] || usage
    if [ ! -f "$_src" ]; then
        echo "lume build: cannot read $_src" >&2
        exit 66
    fi
    if [ -z "$_out" ]; then
        _out="${_src%.src}"
        if [ "$_out" = "$_src" ]; then
            _out="$_src.out"
        fi
    fi
    _bundled=$(mktemp)
    if ! bundle_src_if_needed "$_src" "$_bundled"; then
        rm -f "$_bundled" "$_out"
        exit 1
    fi
    ensure_native_toolchain
    _tmps=$(mktemp)
    if ! "$LUMEC" < "$_bundled" > "$_tmps"; then
        rm -f "$_bundled" "$_tmps" "$_out"
        exit 1
    fi
    "$LASM" < "$_tmps" > "$_out"
    chmod +x "$_out"
    rm -f "$_bundled" "$_tmps"
}

cmd_run() {
    [ $# -ge 1 ] || usage
    _file=$1
    shift
    if [ ! -f "$_file" ]; then
        echo "lume run: cannot read $_file" >&2
        exit 66
    fi
    case "$_file" in
        *.src)
            if is_linux_x86_64 && [ -z "${LUME0_ASAN:-}" ]; then
                _tmpbin=$(mktemp)
                cmd_build "$_file" -o "$_tmpbin"
                _rc=0
                "$_tmpbin" "$@" || _rc=$?
                rm -f "$_tmpbin"
                return $_rc
            else
                _bundled=$(mktemp)
                if ! bundle_src_if_needed "$_file" "$_bundled"; then
                    rm -f "$_bundled"
                    exit 1
                fi
                ensure_seed
                _rc=0
                "$L0" run "$SRC_DIR/compiler_in_core.lume" "$_bundled" "$@" || _rc=$?
                rm -f "$_bundled"
                return $_rc
            fi
            ;;
        *)
            ensure_seed
            "$L0" run "$_file" "$@"
            ;;
    esac
}

# JSON-escape the contents of a file to a single string body (no surrounding quotes).
json_escape() {
    awk 'BEGIN { ORS = "" } { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "\\r"); if (NR > 1) printf "\\n"; printf "%s", $0 }' "$1"
}

# E1 — compiler-as-a-service: compile a .src and report a machine-readable result
# (ok, exit, asm line count, diagnostics, and with --run the native stdout). This is
# the programmatic surface the self-evolution loop (E3) and AI agents consume; the
# compiler itself is unchanged (source in -> diagnostics / asm / result out).
cmd_compile() {
    _json=0
    _run=0
    _file=""
    for _arg in "$@"; do
        case "$_arg" in
            --json) _json=1 ;;
            --run) _run=1 ;;
            -*) usage ;;
            *) _file=$_arg ;;
        esac
    done
    [ -n "$_file" ] || usage
    if [ ! -f "$_file" ]; then
        echo "lume compile: cannot read $_file" >&2
        exit 66
    fi
    case "$_file" in
        *.src) : ;;
        *) echo "lume compile: expects a .src Lume-Core file" >&2; exit 64 ;;
    esac
    _bundled=$(mktemp)
    if ! bundle_src_if_needed "$_file" "$_bundled"; then
        rm -f "$_bundled"
        exit 1
    fi
    _asm=$(mktemp)
    _diag=$(mktemp)
    _exit=0
    if is_linux_x86_64 && [ -z "${LUME0_ASAN:-}" ]; then
        ensure_native_toolchain
        "$LUMEC" < "$_bundled" > "$_asm" 2> "$_diag" || _exit=$?
    else
        ensure_seed
        "$L0" run "$SRC_DIR/data_asm_cc.lume" "$_bundled" "$_asm" > "$_diag" 2>&1 || _exit=$?
    fi
    _asmlines=$(wc -l < "$_asm" | tr -d ' ')
    _didrun=0
    _ranexit=0
    _runout=$(mktemp)
    _bin=$(mktemp)
    if [ "$_exit" -eq 0 ] && [ "$_run" -eq 1 ]; then
        _didrun=1
        if is_linux_x86_64 && [ -z "${LUME0_ASAN:-}" ]; then
            ensure_native_toolchain
            "$LASM" < "$_asm" > "$_bin" 2>/dev/null; chmod +x "$_bin"
        else
            ensure_seed
            "$L0" asm "$_asm" "$_bin" >/dev/null 2>&1; chmod +x "$_bin"
        fi
        "$_bin" > "$_runout" 2>/dev/null || _ranexit=$?
    fi
    if [ "$_json" -eq 1 ]; then
        printf '{'
        if [ "$_exit" -eq 0 ]; then printf '"ok":true'; else printf '"ok":false'; fi
        printf ',"exit":%s,"asm_lines":%s,"diagnostics":"' "$_exit" "$_asmlines"
        json_escape "$_diag"
        printf '"'
        if [ "$_didrun" -eq 1 ]; then
            printf ',"ran":true,"run_exit":%s,"stdout":"' "$_ranexit"
            json_escape "$_runout"
            printf '"'
        else
            printf ',"ran":false'
        fi
        printf '}\n'
    elif [ "$_exit" -eq 0 ]; then
        echo "lume compile: $_file OK ($_asmlines asm lines)" >&2
        cat "$_asm"
    else
        cat "$_diag" >&2
    fi
    rm -f "$_bundled" "$_asm" "$_diag" "$_runout" "$_bin"
    return $_exit
}

cmd_doc() {
    _json=0
    _file=""
    for _arg in "$@"; do
        case "$_arg" in
            --json) _json=1 ;;
            -*) usage ;;
            *) _file=$_arg ;;
        esac
    done
    [ -n "$_file" ] || usage
    if [ ! -f "$_file" ]; then
        echo "lume doc: cannot read $_file" >&2
        exit 66
    fi
    if [ "$_json" -eq 1 ]; then
        _tmpin=$(mktemp)
        printf '@json\n' > "$_tmpin"
        cat "$_file" >> "$_tmpin"
        run_core_tool ldoc "$_tmpin"
        rm -f "$_tmpin"
    else
        run_core_tool ldoc "$_file"
    fi
}

cmd_test() {
    [ $# -ge 1 ] || usage
    _overall=0
    for _file in "$@"; do
        if [ ! -f "$_file" ]; then
            echo "lume test: cannot read $_file" >&2
            exit 66
        fi
        case "$_file" in
            *.src)
                _bundled=$(mktemp "${TMPDIR:-/tmp}/lume_tb_XXXXXX.src")
                if ! bundle_src_if_needed "$_file" "$_bundled"; then
                    rm -f "$_bundled"
                    _overall=1
                    continue
                fi
                _tmpsrc=$(mktemp "${TMPDIR:-/tmp}/lume_test_XXXXXX.src")
                run_core_tool ltest "$_bundled" > "$_tmpsrc"
                if ! cmd_run "$_tmpsrc"; then
                    _overall=1
                fi
                rm -f "$_bundled" "$_tmpsrc"
                ;;
            *)
                ensure_seed
                if "$L0" check "$_file" >/dev/null 2>&1 && "$L0" run "$_file" >/dev/null 2>&1; then
                    printf '  ok   %s\n1 passed, 0 failed\n' "$_file"
                else
                    printf '  FAIL %s\n0 passed, 1 failed\n' "$_file"
                    _overall=1
                fi
                ;;
        esac
    done
    return $_overall
}

cmd_fmt() {
    _check=0
    _stdout=0
    _files=""
    for _arg in "$@"; do
        case "$_arg" in
            --check) _check=1 ;;
            --stdout) _stdout=1 ;;
            -*) usage ;;
            *) _files="$_files $_arg" ;;
        esac
    done
    set -- $_files
    [ $# -ge 1 ] || usage
    _rc=0
    for _file in "$@"; do
        if [ ! -f "$_file" ]; then
            echo "lume fmt: cannot read $_file" >&2
            exit 66
        fi
        _tmpfmt=$(mktemp)
        case "$_file" in
            *.src)
                if [ -f "$SRC_DIR/lfmt.src" ]; then
                    run_core_tool lfmt "$_file" > "$_tmpfmt"
                else
                    awk '{ sub(/[ \t\r]+$/, ""); if ($0 == "") { b++; if (b <= 1) print "" } else { b = 0; print $0 } }' "$_file" > "$_tmpfmt"
                fi
                ;;
            *)
                awk '{ sub(/[ \t\r]+$/, ""); if ($0 == "") { b++; if (b <= 1) print "" } else { b = 0; print $0 } }' "$_file" > "$_tmpfmt"
                ;;
        esac
        if [ "$_stdout" -eq 1 ]; then
            cat "$_tmpfmt"
        elif [ "$_check" -eq 1 ]; then
            if ! cmp -s "$_file" "$_tmpfmt"; then
                echo "lume fmt: $_file is not canonically formatted" >&2
                _rc=1
            fi
        else
            if ! cmp -s "$_file" "$_tmpfmt"; then
                cp "$_tmpfmt" "$_file"
            fi
        fi
        rm -f "$_tmpfmt"
    done
    return $_rc
}

cmd_check() {
    _json=""
    _file=""
    for _arg in "$@"; do
        case "$_arg" in
            --json) _json="--json" ;;
            -*) usage ;;
            *) _file=$_arg ;;
        esac
    done
    [ -n "$_file" ] || usage
    if [ ! -f "$_file" ]; then
        echo "lume check: cannot read $_file" >&2
        exit 66
    fi
    case "$_file" in
        *.src)
            _bundled=$(mktemp)
            if ! bundle_src_if_needed "$_file" "$_bundled"; then
                rm -f "$_bundled"
                exit 1
            fi
            if is_linux_x86_64 && [ -z "${LUME0_ASAN:-}" ]; then
                ensure_native_toolchain
                "$LUMEC" < "$_bundled" > /dev/null
                rm -f "$_bundled"
                if [ -z "$_json" ]; then
                    echo "$_file: OK (Lume-Core parsed and checked)" >&2
                fi
            else
                ensure_seed
                "$L0" run "$SRC_DIR/data_asm_cc.lume" "$_bundled" /dev/null >/dev/null
                rm -f "$_bundled"
                if [ -z "$_json" ]; then
                    echo "$_file: OK (Lume-Core parsed and checked)" >&2
                fi
            fi
            ;;
        *)
            ensure_seed
            if [ -n "$_json" ]; then
                "$L0" check "$_file" --json
            else
                "$L0" check "$_file"
            fi
            ;;
    esac
}

gen_lockfile() {
    _pdir=$1
    _mjson=$2
    printf '# lume.lock — deterministic content-addressed lockfile (P26, P32)\n'
    printf 'version = 1\n'
    printf 'manifest = %s\n' "$_mjson"
    printf 'manifest_sha256 = "%s"\n' "$(sha256_file "$_pdir/lume.toml")"
    for _sf in $(find "$_pdir" -maxdepth 2 \( -name '*.src' -o -name '*.lume' \) | LC_ALL=C sort); do
        _rel=${_sf#"$_pdir/"}
        printf 'module "%s" sha256 = "%s"\n' "$_rel" "$(sha256_file "$_sf")"
    done
}

cmd_pkg() {
    [ $# -ge 1 ] || usage
    _action=$1
    shift
    _pdir="${1:-.}"
    case "$_action" in
        init)
            mkdir -p "$_pdir"
            _pkgname=$(basename -- "$(cd "$_pdir" && pwd)")
            if [ ! -f "$_pdir/lume.toml" ]; then
                cat > "$_pdir/lume.toml" <<EOF
[package]
name = "$_pkgname"
version = "0.1.0"
edition = "2026"

[capabilities]
allow = ["io"]

[dependencies]
EOF
            fi
            if [ ! -f "$_pdir/main.src" ]; then
                printf '## %s — entry module\nfn main_val() -> int = 42\nprint main_val()\n' "$_pkgname" > "$_pdir/main.src"
            fi
            echo "lume pkg: initialized $_pkgname in $_pdir/lume.toml"
            ;;
        check|manifest)
            if [ ! -f "$_pdir/lume.toml" ]; then
                echo "lume pkg: missing $_pdir/lume.toml" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            echo "$_mjson"
            ;;
        lock)
            if [ ! -f "$_pdir/lume.toml" ]; then
                echo "lume pkg: missing $_pdir/lume.toml" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            gen_lockfile "$_pdir" "$_mjson" > "$_pdir/lume.lock"
            echo "lume pkg: wrote $_pdir/lume.lock"
            ;;
        verify)
            if [ ! -f "$_pdir/lume.toml" ] || [ ! -f "$_pdir/lume.lock" ]; then
                echo "lume pkg: missing lume.toml or lume.lock in $_pdir" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            _ltmp=$(mktemp)
            gen_lockfile "$_pdir" "$_mjson" > "$_ltmp"
            if ! cmp -s "$_pdir/lume.lock" "$_ltmp"; then
                rm -f "$_ltmp"
                echo "lume pkg: lockfile verification failed (source or manifest drift detected)" >&2
                exit 1
            fi
            rm -f "$_ltmp"
            echo "lume pkg: verified $_pdir/lume.lock (all SHA-256 digests match)"
            ;;
        tree)
            if [ ! -f "$_pdir/lume.toml" ]; then
                echo "lume pkg: missing $_pdir/lume.toml" >&2
                exit 66
            fi
            _mtmp=$(mktemp)
            printf '@manifest\n' > "$_mtmp"
            cat "$_pdir/lume.toml" >> "$_mtmp"
            if ! _mjson=$(run_core_tool lmod "$_mtmp"); then
                rm -f "$_mtmp"
                exit 1
            fi
            rm -f "$_mtmp"
            echo "$_mjson"
            for _sf in $(find "$_pdir" -maxdepth 2 -name '*.src' | LC_ALL=C sort); do
                _rel=${_sf#"$_pdir/"}
                _uses=$(awk '/^[ \t]*use[ \t]+/{sub(/^[ \t]*use[ \t]+/,""); sub(/[ \t\r]+$/,""); printf "%s ", $1}' "$_sf")
                if [ -n "$_uses" ]; then
                    printf '  |-- %s -> %s\n' "$_rel" "$_uses"
                else
                    printf '  |-- %s\n' "$_rel"
                fi
            done
            ;;
        *)
            usage
            ;;
    esac
}

cmd_agent() {
    [ $# -ge 1 ] || usage
    _afile=""
    for _arg in "$@"; do
        case "$_arg" in
            check|compile|fill|prove|ast|expand|symbols|eval|--json) ;;
            -*) usage ;;
            *) _afile=$_arg ;;
        esac
    done
    [ -n "$_afile" ] || usage
    if [ ! -f "$_afile" ]; then
        echo "lume agent: cannot read $_afile" >&2
        exit 66
    fi
    _abun=$(mktemp)
    if ! bundle_src_if_needed "$_afile" "$_abun"; then
        rm -f "$_abun"
        exit 1
    fi
    run_core_tool lcaas "$_abun"
    rm -f "$_abun"
}

cmd_prove() {
    [ $# -ge 1 ] || usage
    _pfile=""
    for _arg in "$@"; do
        case "$_arg" in
            --json) ;;
            -*) usage ;;
            *) _pfile=$_arg ;;
        esac
    done
    [ -n "$_pfile" ] || usage
    if [ ! -f "$_pfile" ]; then
        echo "lume prove: cannot read $_pfile" >&2
        exit 66
    fi
    _pbun=$(mktemp)
    if ! bundle_src_if_needed "$_pfile" "$_pbun"; then
        rm -f "$_pbun"
        exit 1
    fi
    _pjson=$(run_core_tool lcaas "$_pbun")
    rm -f "$_pbun"
    printf '%s\n' "$_pjson"
    case "$_pjson" in
        *'"ok":true'*) return 0 ;;
        *) return 1 ;;
    esac
}

cmd_evolve() {
    [ $# -ge 1 ] || usage
    _eact=$1
    shift
    case "$_eact" in
        goals)
            cmd_run "$ROOT/evolve/goals.src"
            return 0
            ;;
        budgets)
            cmd_run "$ROOT/evolve/budgets.src"
            return 0
            ;;
        verify|propose|check|status)
            _efile=""
            for _arg in "$@"; do
                case "$_arg" in
                    --json) ;;
                    -*) usage ;;
                    *) _efile=$_arg ;;
                esac
            done
            [ -n "$_efile" ] || _efile="$ROOT/evolve/proposals/0001_math_clamp/proposal.bundle"
            if [ -d "$_efile" ] && [ -f "$_efile/proposal.bundle" ]; then
                _efile="$_efile/proposal.bundle"
            fi
            if [ ! -f "$_efile" ]; then
                echo "lume evolve: cannot read $_efile" >&2
                exit 66
            fi
            _ejson=$(run_core_tool levolve "$_efile")
            printf '%s\n' "$_ejson"
            case "$_ejson" in
                *'"gates_ok":true'*) return 0 ;;
                *) return 1 ;;
            esac
            ;;
        approve)
            _efile=""
            _by="maintainer"
            while [ $# -gt 0 ]; do
                case "$1" in
                    --by)
                        [ $# -ge 2 ] || usage
                        _by=$2
                        shift 2
                        ;;
                    --json)
                        shift
                        ;;
                    -*)
                        usage
                        ;;
                    *)
                        _efile=$1
                        shift
                        ;;
                esac
            done
            [ -n "$_efile" ] || _efile="$ROOT/evolve/proposals/0001_math_clamp/proposal.bundle"
            if [ -d "$_efile" ] && [ -f "$_efile/proposal.bundle" ]; then
                _efile="$_efile/proposal.bundle"
            fi
            if [ ! -f "$_efile" ]; then
                echo "lume evolve: cannot read $_efile" >&2
                exit 66
            fi
            _etmp=$(mktemp)
            cat "$_efile" > "$_etmp"
            printf '\n@approval approved:%s\n' "$_by" >> "$_etmp"
            _ejson=$(run_core_tool levolve "$_etmp")
            rm -f "$_etmp"
            printf '%s\n' "$_ejson"
            case "$_ejson" in
                *'"can_merge":true'*) return 0 ;;
                *) return 1 ;;
            esac
            ;;
        *)
            usage
            ;;
    esac
}

[ $# -ge 1 ] || usage
_sub=$1
shift

case "$_sub" in
    --version|version)
        echo "lume 0.2.0 (edition 2026)"
        ;;
    --help|-h|help)
