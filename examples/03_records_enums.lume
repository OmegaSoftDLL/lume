## Records, enums with payloads, exhaustive match, UFCS methods.
use std.io

type Point = record
    x: f64
    y: f64 = 0.0

type Shape = enum
    Circle(radius: f64)
    Rect(w: f64, h: f64)
    Empty

fn area(s: Shape) -> f64
    match s
        Circle(radius)       => 3.14159 * radius ** 2
        Rect(w, h) if w == h => w * w
        Rect(w, h)           => w * h
        Empty                => 0.0

fn describe(p: Point) -> str = "({p.x}, {p.y})"

fn main()
    let p = Point(x: 1.5)
    io.println("point {p.describe()}")          # UFCS: describe(p)
    let shapes = [Circle(radius: 1.0), Rect(w: 2.0, h: 3.0), Rect(w: 2.0, h: 2.0), Empty]
    for s in shapes
        io.println("area = {s.area():.2}")
    let total = shapes.map(area).sum()
    io.println("total = {total:.2}")
