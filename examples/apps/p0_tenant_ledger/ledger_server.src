## P0 real acceptance slice (#337/#332): single-worker multi-tenant HTTP ledger.
## Linux x86-64 only. Plain HTTP, static demonstration bearer tokens, and durable
## append-only WAL snapshots. TLS, production authentication, multi-worker I/O,
## browser DOM, and the remaining #332/#333 acceptance criteria are not implemented.

use decimal
use net
use table

fn ledger_wal_path() = "p0_tenant_ledger.wal"

fn ledger_schema() = Cons({name: "tenant", type: "int"}, Cons({name: "delta", type: "int"}, Nil))

fn ledger_empty() = read_csv("tenant,delta\n", ledger_schema())

fn ledger_open_store() = let raw = fs_read_file(ledger_wal_path()) in if count(raw) == 0 then persist_open(ledger_wal_path(), ledger_schema(), ledger_empty()) else persist_recover_path(ledger_wal_path(), ledger_schema())

fn ledger_balance_rows(rows, tenant) = match rows
    Nil         => 100
    Cons(r, rs) => let tenant_cell = list_head(r) in let delta_cell = list_head(list_tail(r)) in let rest = ledger_balance_rows(rs, tenant) in if tenant_cell.value == tenant then rest + delta_cell.value else rest

fn ledger_balance(store, tenant) = ledger_balance_rows(store.current.rows, tenant)

fn ledger_header_count_from(headers, key, start) = let found = net_find_sub(headers, key, start, count(headers)) in if found < 0 then 0 else 1 + ledger_header_count_from(headers, key, found + count(key))

fn ledger_header_count(headers, key) = ledger_header_count_from(headers, key, 0)

fn ledger_declared_length(headers) = let length_text = http_extract_header(headers, "Content-Length: ") in let length_count = ledger_header_count(headers, "Content-Length: ") in if length_count == 0 then 0 else if length_count != 1 or length_text == "" or net_is_digits(length_text) == 0 or count(length_text) > 4 then 0 - 1 else let declared = toint(length_text) in if declared > 1024 then 0 - 1 else declared

fn ledger_read_headers(client, raw) = if count(raw) > 4096 then raw else if net_find_sub(raw, "\r\n\r\n", 0, count(raw)) >= 0 then raw else let chunk = net_recv_str(client, 4096) in if count(chunk) == 0 then raw else ledger_read_headers(client, raw + chunk)

fn ledger_read_body(client, raw) = let sep = net_find_sub(raw, "\r\n\r\n", 0, count(raw)) in if sep < 0 or count(raw) > 4096 then raw else let headers = slice(raw, 0, sep + 2) in let declared = ledger_declared_length(headers) in let body = slice(raw, sep + 4, count(raw)) in if declared < 0 or net_find_sub(headers, "Transfer-Encoding:", 0, count(headers)) >= 0 or count(body) >= declared then raw else let chunk = net_recv_str(client, 4096) in if count(chunk) == 0 then raw else ledger_read_body(client, raw + chunk)

fn ledger_read_request(client) = let headers_and_body = ledger_read_headers(client, "") in ledger_read_body(client, headers_and_body)

fn ledger_valid_framing(raw, req) = let sep = net_find_sub(raw, "\r\n\r\n", 0, count(raw)) in if sep < 0 or req.ok == 0 or count(req.host) == 0 or count(raw) > 4096 or count(req.body) > 1024 then 0 else let headers = slice(raw, 0, sep + 2) in if net_find_sub(headers, "Transfer-Encoding:", 0, count(headers)) >= 0 or ledger_declared_length(headers) < 0 then 0 else 1

fn ledger_token_tenant(authorization) = if authorization == "Bearer ledger-101-token" then 101 else if authorization == "Bearer ledger-202-token" then 202 else 0

fn ledger_auth_request(raw, req) = let sep = net_find_sub(raw, "\r\n\r\n", 0, count(raw)) in let headers = slice(raw, 0, sep + 2) in let tenant_text = http_extract_header(headers, "X-Tenant-ID: ") in let authorization = http_extract_header(headers, "Authorization: ") in if ledger_header_count(headers, "X-Tenant-ID: ") != 1 or ledger_header_count(headers, "Authorization: ") != 1 or net_is_digits(tenant_text) == 0 then {status: 401, tenant: 0} else let requested = toint(tenant_text) in let authenticated = ledger_token_tenant(authorization) in if authenticated == 0 or (requested != 101 and requested != 202) then {status: 401, tenant: 0} else if authenticated != requested then {status: 403, tenant: 0} else {status: 200, tenant: authenticated}

fn json_response(status, reason, body) = "HTTP/1.1 " + str(status) + " " + reason + "\r\nContent-Type: application/json\r\nContent-Length: " + str(count(body)) + "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n" + body

fn ledger_error(status, reason, message) = json_response(status, reason, "{\"error\":\"" + message + "\"}")

fn ledger_balance_response(store, tenant) = if store.ok == 0 then ledger_error(500, "Internal Server Error", "storage_recovery_failed") else json_response(200, "OK", "{\"tenant\":" + str(tenant) + ",\"balance\":" + str(ledger_balance(store, tenant)) + ",\"version\":" + str(store.version) + "}")

fn ledger_row(tenant, delta) = Cons({kind: "int", value: tenant}, Cons({kind: "int", value: delta}, Nil))

fn ledger_change(req, tenant, debit) = if net_is_digits(req.body) == 0 or count(req.body) > 6 then ledger_error(400, "Bad Request", "amount_must_be_a_positive_integer") else let amount = toint(req.body) in if amount <= 0 or amount > 100000 then ledger_error(400, "Bad Request", "amount_out_of_range") else let current = persist_recover_path(ledger_wal_path(), ledger_schema()) in if current.ok == 0 then ledger_error(500, "Internal Server Error", "storage_recovery_failed") else let balance = ledger_balance(current, tenant) in if debit == 1 and amount > balance then ledger_error(409, "Conflict", "insufficient_funds") else let delta = if debit == 1 then 0 - amount else amount in let committed = persist_tx_insert_row(ledger_wal_path(), ledger_schema(), ledger_row(tenant, delta)) in ledger_balance_response(committed, tenant)

fn ledger_route(raw, req) = if req.path == "/health" then (if req.method == "GET" then json_response(200, "OK", "{\"ok\":true}") else ledger_error(405, "Method Not Allowed", "method_not_allowed")) else let auth = ledger_auth_request(raw, req) in if auth.status != 200 then ledger_error(auth.status, if auth.status == 403 then "Forbidden" else "Unauthorized", if auth.status == 403 then "cross_tenant_access_denied" else "invalid_credentials") else if req.path == "/v1/balance" then (if req.method == "GET" then ledger_balance_response(persist_recover_path(ledger_wal_path(), ledger_schema()), auth.tenant) else ledger_error(405, "Method Not Allowed", "method_not_allowed")) else if req.path == "/v1/debit" then (if req.method == "POST" then ledger_change(req, auth.tenant, 1) else ledger_error(405, "Method Not Allowed", "method_not_allowed")) else if req.path == "/v1/credit" then (if req.method == "POST" then ledger_change(req, auth.tenant, 0) else ledger_error(405, "Method Not Allowed", "method_not_allowed")) else ledger_error(404, "Not Found", "route_not_found")

fn ledger_handle(raw) = let req = http_parse_request(raw) in if ledger_valid_framing(raw, req) == 0 then ledger_error(400, "Bad Request", "invalid_http_framing") else ledger_route(raw, req)

fn ledger_accept_loop(listener) = let client = net_tcp_accept(listener) in if client < 0 then 1 else let raw = ledger_read_request(client) in let response = ledger_handle(raw) in let sent = net_send_str(client, response) in let closed = net_close(client) in ledger_accept_loop(listener)

fn ledger_main() = let store = ledger_open_store() in if store.ok == 0 then 2 else let listener = net_tcp_listen(18737) in if listener < 0 then 3 else ledger_accept_loop(listener)

print ledger_main()
