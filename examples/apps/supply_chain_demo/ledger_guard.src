## ledger_guard.src — Supply-Chain-Security & High-Assurance Escrow Demo (docs/22-adoption.md G7, #196).
## Demonstrates a zero-C, bit-reproducible, QF_LIA-proven payment handler with algebraic conservation laws
## and WCET cycle bounds.

@bound(cycles: 32)
pub fn authorize_payout(vault: int, payout: int, reserve_min: int) -> int requires vault >= payout + reserve_min and payout > 0 and reserve_min >= 0 ensures result >= reserve_min and result == vault - payout = vault - payout

@bound(cycles: 24)
pub fn clamp_fee(raw_fee: int, cap: int) -> int requires raw_fee >= 0 and cap >= 0 ensures result >= 0 and result <= cap = if raw_fee > cap then cap else raw_fee

law vault_never_below_reserve(vault: int, payout: int, reserve_min: int) = if vault >= payout + reserve_min and payout > 0 and reserve_min >= 0 then authorize_payout(vault, payout, reserve_min) >= reserve_min else 1 == 1

law conservation_of_escrow(vault: int, payout: int, reserve_min: int) = if vault >= payout + reserve_min and payout > 0 and reserve_min >= 0 then authorize_payout(vault, payout, reserve_min) + payout == vault else 1 == 1

fn test_authorize_payout() = authorize_payout(5000, 1200, 1000) == 3800
fn test_clamp_fee() = clamp_fee(45, 25) == 25

print authorize_payout(5000, 1200, 1000)
print clamp_fee(45, 25)
