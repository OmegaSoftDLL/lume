fn dg_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128

fn dg_run(root, args, name) = let output = root + "/build/cli-" + name + ".out" in let errors = root + "/build/cli-" + name + ".err" in let status = os_run_capture_timeout(root + "/build/bin/lume_driver", args, output, errors, 120000) in {status: dg_wait_exit(status), output: fs_read_file(output), errors: fs_read_file(errors)}

fn dg_exact(root, name, args, expected) = let result = dg_run(root, args, name) in if result.status != 0 then name + " failed with status " + str(result.status) + "\nstdout:\n" + result.output + "\nstderr:\n" + result.errors else if result.output != expected then name + " output mismatch: " + result.output else ""

fn dg_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else dg_contains_at(text, part, i + 1)

fn dg_contains(text, part) = dg_contains_at(text, part, 0)

fn dg_part(root, name, args, expected) = let result = dg_run(root, args, name) in if result.status != 0 then name + " failed with status " + str(result.status) + "\nstdout:\n" + result.output + "\nstderr:\n" + result.errors else if dg_contains(result.output, expected) == 0 then name + " is missing expected output: " + expected else ""

fn dg_build(root) = let source = root + "/build/cli_fib.src" in let binary = root + "/build/cli_fib" in let written = fs_write_sync(source, "fn fib(n: int) -> int = if n < 2 then n else fib(n - 1) + fib(n - 2)\nprint fib(10)\n") in if written != 1 then "cannot write native build fixture" else let built = dg_run(root, Cons("build", Cons(source, Cons("-o", Cons(binary, Nil)))), "build") in if built.status != 0 then "native build failed: " + built.errors else if built.output != "" then "native build produced unexpected stdout: " + built.output else let output = root + "/build/cli-fib-run.out" in let errors = root + "/build/cli-fib-run.err" in let executed = os_run_capture_timeout(binary, Nil, output, errors, 10000) in if executed != 0 then "native built program failed: " + fs_read_file(errors) else if fs_read_file(output) != "55\n" then "native built program output mismatch" else let missing = dg_run(root, Cons("build", Cons(root + "/build/definitely-missing.src", Cons("-o", Cons(root + "/build/missing-output", Nil)))), "build-missing") in if missing.status == 0 then "native build accepted a missing source" else ""

fn dg_import_build(root) = let base = root + "/build/cli_base.src" in let base_written = fs_write_sync(base, "fn inc(x: int) -> int = x + 1\n") in let math = root + "/build/cli_math.src" in let math_written = fs_write_sync(math, "use cli_base\nfn answer() -> int = inc(41)\n") in let source = root + "/build/cli_import.src" in let source_written = fs_write_sync(source, "use cli_math\nprint answer()\n") in let binary = root + "/build/cli-import" in if base_written != 1 or math_written != 1 or source_written != 1 then "cannot write transitive import fixtures" else let built = dg_run(root, Cons("build", Cons(source, Cons("-o", Cons(binary, Nil)))), "build-import") in if built.status != 0 then "transitive native bundling failed: " + built.errors else let output = root + "/build/cli-import-run.out" in let errors = root + "/build/cli-import-run.err" in let executed = os_run_capture_timeout(binary, Nil, output, errors, 10000) in if executed != 0 then "transitively bundled program failed: " + fs_read_file(errors) else if fs_read_file(output) != "42\n" then "transitively bundled program output mismatch" else let missing = root + "/build/cli_missing_module.src" in let missing_written = fs_write_sync(missing, "use definitely_missing\nprint 0\n") in let rejected = dg_run(root, Cons("build", Cons(missing, Cons("-o", Cons(root + "/build/cli-missing-module", Nil)))), "build-missing-module") in if rejected.status == 0 then "native bundling accepted a missing module" else ""

fn dg_run_cli(root) = let source = root + "/build/cli_args.src" in let written = fs_write_sync(source, "print os_arg_at(1)\n") in if written != 1 then "cannot write native run fixture" else let args = dg_exact(root, "run-args", Cons("run", Cons(source, Cons("with space", Nil))), "with space\n") in if args != "" then args else let trap = root + "/build/cli_exit.src" in let trap_written = fs_write_sync(trap, "os_exit(7)\n") in let result = dg_run(root, Cons("run", Cons(trap, Nil)), "run-exit") in if result.status != 7 then "native run did not preserve exit code 7: " + str(result.status) else ""

fn dg_intent(root) = let source = root + "/examples/intent/verified_specs.intent" in let cache = root + "/build/cli_intent.cache.src" in let built = dg_part(root, "intent-build", Cons("intent", Cons("build", Cons(source, Cons("--cache", Cons(cache, Nil))))), "\"ok\":true") in if built != "" then built else let verified = dg_part(root, "intent-verify", Cons("intent", Cons("verify", Cons(source, Cons("--cache", Cons(cache, Nil))))), "\"cache_valid\":true") in if verified != "" then verified else let tampered = fs_write_sync(cache, fs_read_file(cache) + "fn extra() = 0\n") in if tampered != 1 then "cannot tamper native intent cache" else let rejected = dg_run(root, Cons("intent", Cons("verify", Cons(source, Cons("--cache", Cons(cache, Nil))))), "intent-tampered") in if rejected.status == 0 then "native intent accepted a tampered cache" else if dg_contains(rejected.errors, "\"cache_tampered\":true") == 0 then "native intent cache-tamper diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("intent", Cons("build", Cons(root + "/build/definitely-missing.intent", Nil))), "intent-missing") in if missing.status == 0 then "native intent accepted a missing specification" else ""

fn dg_certify(root) = let source = root + "/build/cli_certify.src" in let written = fs_write_sync(source, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\n") in if written != 1 then "cannot write native certify fixture" else let result = dg_run(root, Cons("certify", Cons(source, Nil)), "certify-valid") in if result.status != 0 then "certify-valid failed with status " + str(result.status) + "\nstdout:\n" + result.output + "\nstderr:\n" + result.errors else if dg_contains(result.output, "\"ok\":true") == 0 then "certify-valid is missing expected output" else let cert = root + "/build/cli_certificate.json" in let saved = fs_write_sync(cert, result.output) in if saved != 1 then "cannot save native certificate" else let verified = dg_part(root, "verify-cert-valid", Cons("verify-cert", Cons(cert, Nil)), "\"kernel_verified\":true") in if verified != "" then verified else let tampered = fs_write_sync(cert, "{}") in if tampered != 1 then "cannot write invalid native certificate" else let rejected = dg_run(root, Cons("verify-cert", Cons(cert, Nil)), "verify-cert-invalid") in if rejected.status == 0 then "native verify-cert accepted an invalid artifact" else if dg_contains(rejected.errors, "\"ok\":false") == 0 then "native verify-cert invalid-artifact diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("certify", Cons(root + "/build/definitely-missing-certify.src", Nil)), "certify-missing") in if missing.status == 0 then "native certify accepted a missing source" else ""

fn dg_unknown(root) = let result = dg_run(root, Cons("not-a-command", Nil), "unknown") in if result.status == 0 then "unknown command unexpectedly succeeded" else ""

fn dg_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else dg_line_end(text, i + 1)

fn dg_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, dg_line_end(input, 0))

fn dg_main(root) = let version = dg_exact(root, "version", Cons("--version", Nil), "lume 0.2.0 (edition 2026)\n") in if version != "" then version else let help = dg_part(root, "help", Cons("--help", Nil), "lume build [--target <triple>]") in if help != "" then help else let description = dg_part(root, "describe", Cons("describe", Nil), "\"stage\": \"self-hosted (lumec + lasm + lcli)\"") in if description != "" then description else let targets = dg_part(root, "targets", Cons("targets", Nil), "x86_64-windows-pe") in if targets != "" then targets else let built = dg_build(root) in if built != "" then built else let imports = dg_import_build(root) in if imports != "" then imports else let ran = dg_run_cli(root) in if ran != "" then ran else let certified = dg_certify(root) in if certified != "" then certified else let intended = dg_intent(root) in if intended != "" then intended else dg_unknown(root)

fn dg_dispatch(input) = let root = dg_root(input) in if root == "" then ctfail("native driver gate requires @root\n") else let problem = dg_main(root) in if problem != "" then ctfail("native driver gate failed: " + problem + "\n") else "native driver version, help, describe, targets, build, transitive bundling, run, argv, exit-code, certification, independent verification, intent cache proofs, tamper rejection, and rejection checks passed"

print dg_dispatch(readall())
