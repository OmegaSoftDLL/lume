use gate_manifest
use gate_process
use lregistry_cid_lib

fn rg_inputs(root) = let input = root + "/build/registry-gate/input" in let made = rg_mkdir(input) in let a = rg_write(input + "/adapter.src", "pub fn adapter_twice(x: int) -> int requires x >= 0 ensures result >= x = x + x\n") in let b = rg_write(input + "/source.src", "pub fn component_clamp(x: int, lo: int, hi: int) -> int requires lo <= hi ensures result >= lo and result <= hi = if x < lo then lo else if x > hi then hi else x\n") in let c = rg_write(input + "/tests.src", "fn test_adapter_twice() = adapter_twice(3) == 6\nfn test_component_clamp_low() = component_clamp(0 - 4, 0, 10) == 0\nfn test_component_clamp_high() = component_clamp(40, 0, 10) == 10\nfn test_component_clamp_inner() = component_clamp(4, 0, 10) == 4\n") in am_first(a, am_first(b, c))

fn rg_publish_flow(root) = let tmp = root + "/build/registry-gate" in let store = tmp + "/store" in let removed = rg_rm(tmp) in let made = rg_mkdir(store) in let input_error = rg_inputs(root) in if input_error != "" then {error: input_error, cid: "", entry: "", publish: "", manifest: am_err(0, input_error)} else let adapter = tmp + "/input/adapter.src" in let source = tmp + "/input/source.src" in let tests = tmp + "/input/tests.src" in let publish = tmp + "/publish.json" in let raw = rg_lume(root, rg_registry_args(adapter, source, tests), publish) in if raw != 0 then {error: "registry publish failed", cid: "", entry: "", publish: publish, manifest: am_err(0, "publish")} else let manifest = am_parse(fs_read_file(publish)) in let valid = rg_publish_valid(manifest, tmp + "/input", store + "/components/" + rg_text_field(manifest, "cid")) in if valid != "" then {error: valid, cid: "", entry: "", publish: publish, manifest: manifest} else let oracle = am_parse(rj_response(fs_read_file(publish))) in if rg_text_field(oracle, "ok") != "true" or rg_text_field(oracle, "cid") != rg_text_field(manifest, "cid") then {error: "independent CID oracle mismatch", cid: "", entry: "", publish: publish, manifest: manifest} else let cid = rg_text_field(manifest, "cid") in {error: "", cid: cid, entry: store + "/components/" + cid, publish: publish, manifest: manifest}

fn rg_resolve_flow(root, flow) = let resolve = root + "/build/registry-gate/resolve.json" in let raw = rg_lume(root, rg_resolve_args(flow.cid), resolve) in if raw != 0 then "registry resolve failed" else if fs_read_file(resolve) != fs_read_file(flow.publish) then "resolved manifest differs from publication" else let signature = rg_text_field(flow.manifest, "contract_signature") in let found_raw = rg_lume(root, rg_discover_signature_args(signature), root + "/build/registry-gate/discover.json") in let other_raw = rg_lume(root, rg_discover_args("ffi"), root + "/build/registry-gate/discover-other.json") in if found_raw != 0 or other_raw != 0 then "registry discover failed" else rg_discover_valid(am_parse(fs_read_file(root + "/build/registry-gate/discover.json")), am_parse(fs_read_file(root + "/build/registry-gate/discover-other.json")), flow.cid)
