use acceptance_json

fn rg_run(path, args, out, timeout) = let err = out + ".err" in os_run_capture_timeout(path, args, out, err, timeout)
fn rg_lume(root, args, out) = rg_run(root + "/lume", args, out, 900000)
fn rg_store_args(root) = Cons("--store", Cons(root + "/build/registry-gate/store", Nil))
fn rg_registry_args(root, adapter, source, tests) = cs_app(Cons("registry", Cons("publish", Cons("--adapter", Cons(adapter, Nil)))), cs_app(Cons("--source", Cons(source, Cons("--tests", Cons(tests, Nil)))), rg_store_args(root)))
fn rg_registry_proof_args(root, adapter, source, tests, proof) = cs_app(Cons("registry", Cons("publish", Cons("--adapter", Cons(adapter, Nil)))), cs_app(Cons("--source", Cons(source, Nil)), cs_app(Cons("--tests", Cons(tests, Cons("--proof", Cons(proof, Nil)))), rg_store_args(root))))
fn rg_resolve_args(root, cid) = cs_app(Cons("registry", Cons("resolve", Cons("--cid", Cons(cid, Nil)))), rg_store_args(root))
fn rg_target_args(root, cid, target) = cs_app(Cons("registry", Cons("resolve", Cons("--cid", Cons(cid, Nil)))), cs_app(Cons("--target", Cons(target, Nil)), rg_store_args(root)))
fn rg_discover_args(root, capability) = cs_app(Cons("registry", Cons("discover", Cons("--capability", Cons(capability, Nil)))), rg_store_args(root))
fn rg_discover_signature_args(root, signature) = cs_app(Cons("registry", Cons("discover", Cons("--capability", Cons("pure", Nil)))), cs_app(Cons("--contract-signature", Cons(signature, Nil)), rg_store_args(root)))
fn rg_cp(source, dest) = rg_run("/bin/cp", Cons(source, Cons(dest, Nil)), dest + ".copy.log", 10000)
fn rg_mv(source, dest) = rg_run("/bin/mv", Cons(source, Cons(dest, Nil)), dest + ".move.log", 10000)
fn rg_mkdir(path) = rg_run("/bin/mkdir", Cons("-p", Cons(path, Nil)), path + ".mkdir.log", 10000)
fn rg_rm(path) = rg_run("/bin/rm", Cons("-rf", Cons(path, Nil)), path + ".rm.log", 10000)
