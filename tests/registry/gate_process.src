use acceptance_json

fn rg_run(path, args, out, timeout) = let err = out + ".err" in os_run_capture_timeout(path, args, out, err, timeout)
fn rg_lume(root, args, out) = rg_run(root + "/lume", args, out, 900000)
fn rg_registry_args(adapter, source, tests) = cs_app(Cons("registry", Cons("publish", Cons("--adapter", Cons(adapter, Nil)))), Cons("--source", Cons(source, Cons("--tests", Cons(tests, Nil)))))
fn rg_registry_proof_args(adapter, source, tests, proof) = cs_app(Cons("registry", Cons("publish", Cons("--adapter", Cons(adapter, Nil)))), cs_app(Cons("--source", Cons(source, Nil)), Cons("--tests", Cons(tests, Cons("--proof", Cons(proof, Nil))))))
fn rg_resolve_args(cid) = Cons("registry", Cons("resolve", Cons("--cid", Cons(cid, Nil))))
fn rg_target_args(cid, target) = cs_app(Cons("registry", Cons("resolve", Cons("--cid", Cons(cid, Nil)))), Cons("--target", Cons(target, Nil)))
fn rg_discover_args(capability) = Cons("registry", Cons("discover", Cons("--capability", Cons(capability, Nil))))
fn rg_discover_signature_args(signature) = cs_app(Cons("registry", Cons("discover", Cons("--capability", Cons("pure", Nil)))), Cons("--contract-signature", Cons(signature, Nil)))
fn rg_cp(source, dest) = rg_run("/bin/cp", Cons(source, Cons(dest, Nil)), dest + ".copy.log", 10000)
fn rg_mv(source, dest) = rg_run("/bin/mv", Cons(source, Cons(dest, Nil)), dest + ".move.log", 10000)
fn rg_mkdir(path) = rg_run("/bin/mkdir", Cons("-p", Cons(path, Nil)), path + ".mkdir.log", 10000)
fn rg_rm(path) = rg_run("/bin/rm", Cons("-rf", Cons(path, Nil)), path + ".rm.log", 10000)
