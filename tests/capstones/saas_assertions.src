fn cs_rtrimnl(s, e) = if e <= 0 then 0 else if at(s, e - 1) == "\n" or at(s, e - 1) == "\r" or at(s, e - 1) == " " then cs_rtrimnl(s, e - 1) else e
fn cs_chomp(s) = slice(s, 0, cs_rtrimnl(s, count(s)))
fn cs_startswith(s, p) = if count(s) < count(p) then 0 else if slice(s, 0, count(p)) == p then 1 else 0
fn cs_find_substr(s, pat, i, n, m) = if i + m > n then n else if slice(s, i, i + m) == pat then i else cs_find_substr(s, pat, i + 1, n, m)
fn cs_has_substr_i(s, pat, i, n, m) = if i + m > n then 0 else if slice(s, i, i + m) == pat then 1 else cs_has_substr_i(s, pat, i + 1, n, m)
fn cs_has_substr(s, pat) = let n = count(s) in let m = count(pat) in if m == 0 then 1 else if m > n then 0 else cs_has_substr_i(s, pat, 0, n, m)
fn lc_find_ch(s, i, n, ch) = if i >= n then n else if at(s, i) == ch then i else lc_find_ch(s, i + 1, n, ch)
fn lc_trim_r(s) = let n = count(s) in if n == 0 then "" else if at(s, n - 1) == " " or at(s, n - 1) == "\t" or at(s, n - 1) == ";" then lc_trim_r(slice(s, 0, n - 1)) else s
fn lc_trim_l(s, i, n) = if i >= n then "" else if at(s, i) == " " or at(s, i) == "\t" then lc_trim_l(s, i + 1, n) else slice(s, i, n)
fn lc_trim(s) = lc_trim_r(lc_trim_l(cs_chomp(s), 0, count(cs_chomp(s))))

fn sa_value(payload, key) = let marker = "\"" + key + "\":" in let p = cs_find_substr(payload, marker, 0, count(payload), count(marker)) in if p >= count(payload) then "" else let start = p + count(marker) in let start2 = if at(payload, start) == " " then start + 1 else start in if at(payload, start2) == "\"" then let finish = lc_find_ch(payload, start2 + 1, count(payload), "\"") in slice(payload, start2 + 1, finish) else let finish = lc_find_ch(payload, start2, count(payload), ",") in let end_brace = lc_find_ch(payload, start2, count(payload), "}") in let stop = if finish < end_brace then finish else end_brace in lc_trim(slice(payload, start2, stop))

fn sa_fields(payload, keys, values) = match keys
    Nil => 1
    Cons(k, kt) => match values
        Nil => 0
        Cons(v, vt) => if sa_value(payload, k) == v then sa_fields(payload, kt, vt) else 0

fn sa_receive(fd, acc) = let chunk = net_recv_str(fd) in if count(chunk) == 0 then acc else sa_receive(fd, acc + chunk)

fn sa_response(raw) = let marker = "\r\n\r\n" in let p = cs_find_substr(raw, marker, 0, count(raw), 4) in if cs_startswith(raw, "HTTP/1.1 ") == 0 or p >= count(raw) or cs_has_substr(slice(raw, 0, p), "application/json") == 0 then {status: 0, payload: ""} else {status: toint(slice(raw, 9, 12)), payload: slice(raw, p + 4, count(raw))}

fn sa_exchange(payload) = let fd = net_tcp_connect(18737) in if fd < 0 then {status: 0, payload: ""} else let sent = net_send_str(fd, payload) in let shutdown = net_shutdown_write(fd) in let raw = sa_receive(fd, "") in let closed = net_close(fd) in sa_response(raw)

fn sa_request(method, path, body, tenant, token) = let auth = if token == "" then "" else "Authorization: Bearer " + token + "\r\n" in let tenancy = if tenant == "" then "" else "X-Tenant-ID: " + tenant + "\r\n" in let framing = if method == "POST" then "Content-Length: " + str(count(body)) + "\r\n" else "" in let payload = method + " " + path + " HTTP/1.1\r\nHost: 127.0.0.1\r\n" + auth + tenancy + framing + "\r\n" + body in sa_exchange(payload)

fn sa_expect(response, status, keys, values) = response.status == status and sa_fields(response.payload, keys, values) == 1

fn sa_parts(headers, first, second) = let fd = net_tcp_connect(18737) in if fd < 0 then {status: 0, payload: ""} else let sent = net_send_str(fd, headers) in let slept1 = os_sleep_ms(100) in let sent1 = net_send_str(fd, first) in let slept2 = os_sleep_ms(100) in let sent2 = net_send_str(fd, second) in let shutdown = net_shutdown_write(fd) in let raw = sa_receive(fd, "") in let closed = net_close(fd) in sa_response(raw)

fn sa_count_marker(s, marker) = if cs_has_substr(s, marker) == 0 then 0 else let p = cs_find_substr(s, marker, 0, count(s), count(marker)) in 1 + sa_count_marker(slice(s, p + count(marker), count(s)), marker)

fn sa_phase1() = let common = "POST /v1/debit HTTP/1.1\r\nHost: 127.0.0.1\r\nAuthorization: Bearer ledger-101-token\r\nX-Tenant-ID: 101\r\n" in sa_expect(sa_request("GET", "/v1/balance", "", "101", "ledger-101-token"), 200, Cons("tenant", Cons("balance", Cons("version", Nil))), Cons("101", Cons("100", Cons("1", Nil)))) == 1 and sa_expect(sa_request("GET", "/v1/balance", "", "202", "ledger-202-token"), 200, Cons("tenant", Cons("balance", Cons("version", Nil))), Cons("202", Cons("100", Cons("1", Nil)))) == 1 and sa_expect(sa_request("POST", "/v1/debit", "35", "101", "ledger-101-token"), 200, Cons("tenant", Cons("balance", Cons("version", Nil))), Cons("101", Cons("65", Cons("2", Nil)))) == 1 and sa_expect(sa_request("POST", "/v1/credit", "25", "202", "ledger-202-token"), 200, Cons("tenant", Cons("balance", Cons("version", Nil))), Cons("202", Cons("125", Cons("3", Nil)))) == 1 and sa_expect(sa_request("GET", "/v1/balance", "", "101", "ledger-101-token"), 200, Cons("balance", Nil), Cons("65", Nil)) == 1 and sa_expect(sa_request("GET", "/v1/balance", "", "202", "ledger-202-token"), 200, Cons("balance", Nil), Cons("125", Nil)) == 1 and sa_expect(sa_request("GET", "/v1/balance", "", "202", "ledger-101-token"), 403, Cons("error", Nil), Cons("cross_tenant_access_denied", Nil)) == 1 and sa_expect(sa_request("POST", "/v1/debit", "10", "202", "ledger-101-token"), 403, Cons("error", Nil), Cons("cross_tenant_access_denied", Nil)) == 1 and sa_expect(sa_request("GET", "/v1/balance", "", "101", ""), 401, Cons("error", Nil), Cons("invalid_credentials", Nil)) == 1 and sa_expect(sa_request("GET", "/v1/balance", "", "101", "wrong-token"), 401, Cons("error", Nil), Cons("invalid_credentials", Nil)) == 1 and sa_expect(sa_request("POST", "/v1/debit", "999", "101", "ledger-101-token"), 409, Cons("error", Nil), Cons("insufficient_funds", Nil)) == 1 and sa_expect(sa_request("POST", "/v1/debit", "-5", "101", "ledger-101-token"), 400, Cons("error", Nil), Cons("amount_must_be_a_positive_integer", Nil)) == 1 and sa_expect(sa_request("POST", "/v1/debit", "abc", "101", "ledger-101-token"), 400, Cons("error", Nil), Cons("amount_must_be_a_positive_integer", Nil)) == 1 and sa_expect(sa_request("POST", "/v1/debit", "0", "101", "ledger-101-token"), 400, Cons("error", Nil), Cons("amount_out_of_range", Nil)) == 1 and sa_expect(sa_request("POST", "/v1/debit", "100001", "101", "ledger-101-token"), 400, Cons("error", Nil), Cons("amount_out_of_range", Nil)) == 1 and sa_expect(sa_request("GET", "/v1/balance", "", "202", "ledger-202-token"), 200, Cons("balance", Nil), Cons("125", Nil)) == 1 and sa_expect(sa_exchange(common + "Content-Length: abc\r\n\r\n1"), 400, Cons("error", Nil), Cons("invalid_http_framing", Nil)) == 1 and sa_expect(sa_exchange(common + "Content-Length: 1\r\nContent-Length: 1\r\n\r\n1"), 400, Cons("error", Nil), Cons("invalid_http_framing", Nil)) == 1 and sa_expect(sa_exchange(common + "Transfer-Encoding: chunked\r\nContent-Length: 1\r\n\r\n1"), 400, Cons("error", Nil), Cons("invalid_http_framing", Nil)) == 1 and sa_expect(sa_exchange(common + "Content-Length: 2048\r\n\r\n" + sa_repeat("1", 2048)), 400, Cons("error", Nil), Cons("invalid_http_framing", Nil)) == 1 and sa_expect(sa_exchange(common + "Content-Length: 2\r\n\r\n1"), 400, Cons("error", Nil), Cons("invalid_http_framing", Nil)) == 1 and sa_expect(sa_exchange("GET /v1/balance HTTP/1.1\r\nAuthorization: Bearer ledger-101-token\r\nX-Tenant-ID: 101\r\n\r\n"), 400, Cons("error", Nil), Cons("invalid_http_framing", Nil)) == 1 and sa_expect(sa_parts(common + "Content-Length: 2\r\n\r\n", "1", "5"), 200, Cons("tenant", Cons("balance", Cons("version", Nil))), Cons("101", Cons("50", Cons("4", Nil)))) == 1

fn sa_repeat(s, n) = if n <= 0 then "" else s + sa_repeat(s, n - 1)

fn sa_health() = sa_expect(sa_request("GET", "/health", "", "", ""), 200, Cons("ok", Nil), Cons("true", Nil))

fn sa_wal() = let path = "p0_tenant_ledger.wal" in let raw = fs_read_file(path) in if fs_read_byte(path, 0) >= 0 and count(raw) > 0 and sa_count_marker(raw, "@tx|") == 4 then fs_append_sync(path, "@tx|5|0|torn|tenant,delta~n999,999|@endtx\n") else 0

fn sa_phase2() = sa_expect(sa_request("GET", "/v1/balance", "", "101", "ledger-101-token"), 200, Cons("balance", Cons("version", Nil)), Cons("50", Cons("4", Nil))) == 1 and sa_expect(sa_request("GET", "/v1/balance", "", "202", "ledger-202-token"), 200, Cons("balance", Cons("version", Nil)), Cons("125", Cons("4", Nil))) == 1 and sa_expect(sa_request("POST", "/v1/debit", "5", "101", "ledger-101-token"), 200, Cons("balance", Cons("version", Nil)), Cons("45", Cons("5", Nil))) == 1

fn sa_phase3() = sa_expect(sa_request("GET", "/v1/balance", "", "101", "ledger-101-token"), 200, Cons("balance", Cons("version", Nil)), Cons("45", Cons("5", Nil))) == 1 and sa_expect(sa_request("GET", "/v1/balance", "", "202", "ledger-202-token"), 200, Cons("balance", Cons("version", Nil)), Cons("125", Cons("5", Nil))) == 1

fn sa_dispatch(input) = let mode = lc_trim(input) in let ok = if mode == "health" then sa_health() else if mode == "phase1" then sa_phase1() else if mode == "wal" then sa_wal() else if mode == "phase2" then sa_phase2() else if mode == "phase3" then sa_phase3() else 0 in if ok == 1 then "PASS: independent HTTP, tenant isolation, malformed input, WAL restart and torn-frame recovery" else ctfail("SaaS capstone assertion failed: " + mode)

print sa_dispatch(readall())
