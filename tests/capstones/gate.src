fn cp_chomp(s) = let n = count(s) in if n == 0 then "" else let c = at(s, n - 1) in if c == "\n" or c == "\r" or c == " " or c == "\t" then cp_chomp(slice(s, 0, n - 1)) else s
fn cp_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else cp_line_end(s, i + 1)
fn cp_lines(s, i) = if i >= count(s) then Nil else let e = cp_line_end(s, i) in Cons(slice(s, i, e), cp_lines(s, e + 1))
fn cp_at_line(xs, idx) = match xs
    Nil => ""
    Cons(h, t) => if idx == 0 then cp_chomp(h) else cp_at_line(t, idx - 1)
fn cp_value(line, prefix) = if count(line) >= count(prefix) and slice(line, 0, count(prefix)) == prefix then slice(line, count(prefix), count(line)) else ""
fn cp_request(input) = let ls = cp_lines(input, 0) in {root: cp_value(cp_at_line(ls, 0), "@root "), bin: cp_value(cp_at_line(ls, 1), "@bin ")}
fn cp_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else cp_contains_at(text, part, i + 1)
fn cp_contains(text, part) = cp_contains_at(text, part, 0)
fn cp_run(path, args, out) = os_run_capture_timeout(path, args, out, out + ".err", 900000)
fn cp_input(path, args, input, out, timeout_ms) = os_run_input_capture_timeout(path, args, input, out, out + ".err", timeout_ms)
fn cp_lume(root, bin, args, out) = cp_run("/usr/bin/env", Cons("PATH=/usr/local/bin:/usr/bin:/bin", Cons("LUME_BIN_DIR=" + bin, Cons(root + "/lume", args))), out)
fn cp_build(root, bin, source, out, log) = cp_lume(root, bin, Cons("build", Cons(source, Cons("-o", Cons(out, Nil)))), log)
fn cp_failure(step, status, out) = if status == 0 then "" else step + " failed with native status " + str(status) + "\nstdout:\n" + fs_read_file(out) + "\nstderr:\n" + fs_read_file(out + ".err") + "\n"
fn cp_assert(tmp, mode) = let input = tmp + "/saas.in" in let out = tmp + "/saas-" + mode + ".out" in let written = fs_write_sync(input, mode + "\n") in if written != 1 then "cannot write SaaS assertion input" else cp_failure("SaaS assertion " + mode, cp_input("/usr/bin/env", Cons("-C", Cons(tmp, Cons(tmp + "/saas_assert", Nil))), input, out, 30000), out)
fn cp_health(tmp, attempt) = if attempt >= 200 then "ledger server did not become healthy\n" + fs_read_file(tmp + "/saas-health.out") + fs_read_file(tmp + "/saas-health.out.err") else let err_msg = cp_assert(tmp, "health") in if err_msg == "" then "" else let slept = os_sleep_ms(50) in cp_health(tmp, attempt + 1)
fn cp_stop(pid) = let killed = os_kill(pid, 15) in if killed != 0 then "cannot stop ledger server: native status " + str(killed) else let status = os_waitpid_status(pid) in if status == 0 or status == 15 then "" else "ledger server wait failed with native status " + str(status)
fn cp_server_child(tmp) = let status = os_exec("/usr/bin/env", Cons("-C", Cons(tmp, Cons(tmp + "/ledger_server", Nil)))) in os_exit(status)
fn cp_start_failure(pid, err_msg) = let stopped = cp_stop(pid) in {pid: 0 - 1, err_msg: err_msg + stopped}
fn cp_start(tmp) = let pid = os_fork() in if pid < 0 then {pid: pid, err_msg: "cannot fork ledger server: native status " + str(pid)} else if pid == 0 then cp_server_child(tmp) else let err_msg = cp_health(tmp, 0) in if err_msg != "" then cp_start_failure(pid, err_msg) else {pid: pid, err_msg: ""}
fn cp_phase(tmp, pid, mode) = let assertion = cp_assert(tmp, mode) in let stopped = cp_stop(pid) in if stopped != "" then stopped else assertion
fn cp_session(tmp, mode) = let started = cp_start(tmp) in if started.err_msg != "" then started.err_msg else cp_phase(tmp, started.pid, mode)
fn cp_saas(tmp) = let first = cp_session(tmp, "phase1") in if first != "" then first else let wal = cp_assert(tmp, "wal") in if wal != "" then wal else let second = cp_session(tmp, "phase2") in if second != "" then second else cp_session(tmp, "phase3")
fn cp_prepare(root, bin, tmp) = let parent = fs_mkdir(root + "/build") in if parent != 1 then "cannot create capstone capture parent" else let removed = cp_run("/bin/rm", Cons("-rf", Cons(tmp, Nil)), tmp + ".rm.out") in if removed != 0 then "cannot reset capstone gate directory: native status " + str(removed) else let made = cp_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil)), tmp + ".mkdir.out") in if made != 0 then "cannot create capstone gate directory: native status " + str(made) else let server = cp_build(root, bin, root + "/examples/apps/p0_tenant_ledger/ledger_server.src", tmp + "/ledger_server", tmp + "/server-build.out") in if server != 0 then cp_failure("ledger server build", server, tmp + "/server-build.out") else let saas = cp_build(root, bin, root + "/tests/capstones/saas_assertions.src", tmp + "/saas_assert", tmp + "/saas-build.out") in if saas != 0 then cp_failure("SaaS oracle build", saas, tmp + "/saas-build.out") else let rtc = cp_build(root, bin, root + "/tests/capstones/rtc_assertions.src", tmp + "/rtc_assert", tmp + "/rtc-build.out") in if rtc != 0 then cp_failure("RTC oracle build", rtc, tmp + "/rtc-build.out") else ""
fn cp_qemu_config(tmp) = fs_write_sync(tmp + "/qemu.cfg", "[drive]\n  format = \"raw\"\n  file = \"" + tmp + "/kernel_rtc.img\"\n[device]\n  driver = \"isa-debug-exit\"\n  iobase = \"0xf4\"\n  iosize = \"0x04\"\n[chardev \"console\"]\n  backend = \"stdio\"\n[serial]\n  chardev = \"console\"\n[display]\n  type = \"none\"\n")
fn cp_qemu(tmp, name, base) = let out = tmp + "/rtc-" + name + ".out" in let status = os_run_capture_timeout("/usr/bin/qemu-system-x86_64", Cons("-readconfig", Cons(tmp + "/qemu.cfg", Cons("-no-reboot", Cons("-rtc", Cons("base=" + base, Nil))))), out, out + ".err", 20000) in if os_last_timed_out() != 0 then "QEMU " + name + " timed out\n" + fs_read_file(out) + fs_read_file(out + ".err") else ""
fn cp_effect_source(name, restricted) = let call = if name == "exec" then "os_exec(\"/definitely/missing\", Nil)" else if name == "kill" then "os_kill(1, 0)" else "os_waitpid_status(1)" in let signature = if restricted == 1 then " / {io}" else " / pure" in (if restricted == 1 then "@capability {fs}\n" else "") + "pub fn rejected() -> int" + signature + " = " + call + "\nprint rejected()\n"
fn cp_effect_case(root, bin, tmp, name, restricted) = let suffix = name + "-" + str(restricted) in let source = tmp + "/effect-" + suffix + ".src" in let written = fs_write_sync(source, cp_effect_source(name, restricted)) in if written != 1 then "cannot write process effect regression" else let checked = cp_lume(root, bin, Cons("agent", Cons("check", Cons(source, Nil))), tmp + "/effect-" + suffix + ".json") in if cp_contains(fs_read_file(tmp + "/effect-" + suffix + ".json"), "\"ok\":false") == 0 or cp_contains(fs_read_file(tmp + "/effect-" + suffix + ".json"), "E0200") == 0 then "process effect analysis accepted " + suffix + "\n" + fs_read_file(tmp + "/effect-" + suffix + ".json") else let built = cp_build(root, bin, source, tmp + "/effect-" + suffix, tmp + "/effect-" + suffix + ".build.out") in if built == 0 then "process effect compiler accepted " + suffix else if fs_path_exists(tmp + "/effect-" + suffix) == 1 then "rejected process effect produced an executable: " + suffix else ""
fn cp_effect_names(root, bin, tmp, names, restricted) = match names
    Nil => ""
    Cons(h, t) => let checked = cp_effect_case(root, bin, tmp, h, restricted) in if checked != "" then checked else cp_effect_names(root, bin, tmp, t, restricted)
fn cp_process_effects(root, bin, tmp) = let names = Cons("exec", Cons("kill", Cons("wait", Nil))) in let pure = cp_effect_names(root, bin, tmp, names, 0) in if pure != "" then pure else cp_effect_names(root, bin, tmp, names, 1)
fn cp_rtc(root, bin, tmp) = let kernel = root + "/examples/apps/p0_rtc_kernel/kernel_rtc.src" in let asm = tmp + "/kernel_rtc.s" in let image = tmp + "/kernel_rtc.img" in let compiled = cp_lume(root, bin, Cons("compile", Cons(kernel, Nil)), asm) in if compiled != 0 then cp_failure("RTC kernel compilation", compiled, asm) else let assembled = cp_input(bin + "/lasm", Nil, asm, image, 900000) in if assembled != 0 then cp_failure("RTC kernel assembly", assembled, image) else let tested = cp_lume(root, bin, Cons("test", Cons(root + "/tests/capstones/rtc_assertions.src", Nil)), tmp + "/rtc-native-tests.out") in if tested != 0 then cp_failure("RTC native regressions", tested, tmp + "/rtc-native-tests.out") else if cp_contains(fs_read_file(tmp + "/rtc-native-tests.out"), "7 passed, 0 failed") == 0 then "RTC native regressions did not report 7 passed, 0 failed\n" + fs_read_file(tmp + "/rtc-native-tests.out") else let qemu = cp_run("/usr/bin/qemu-system-x86_64", Cons("--version", Nil), tmp + "/qemu-version.out") in if qemu != 0 then cp_failure("QEMU availability", qemu, tmp + "/qemu-version.out") else let configured = cp_qemu_config(tmp) in if configured != 1 then "cannot write QEMU configuration" else let first = cp_qemu(tmp, "first", "2024-06-15T12:34:56") in if first != "" then first else let second = cp_qemu(tmp, "second", "2031-11-22T01:02:03") in if second != "" then second else let request = tmp + "/rtc.in" in let written = fs_write_sync(request, "@image " + image + "\n@asm " + asm + "\n@first " + tmp + "/rtc-first.out\n@second " + tmp + "/rtc-second.out\n@first_base 2024-06-15T12:34:56\n@second_base 2031-11-22T01:02:03\n") in if written != 1 then "cannot write RTC assertion input" else cp_failure("RTC capstone assertion", cp_input(tmp + "/rtc_assert", Nil, request, tmp + "/rtc-final.out", 30000), tmp + "/rtc-final.out")
fn cp_main(root, bin) = let tmp = root + "/build/capstone-gate" in let prepared = cp_prepare(root, bin, tmp) in if prepared != "" then prepared else let saas = cp_saas(tmp) in if saas != "" then saas else let effects = cp_process_effects(root, bin, tmp) in if effects != "" then effects else cp_rtc(root, bin, tmp)
fn cp_dispatch(input) = let req = cp_request(input) in if req.root == "" or req.bin == "" then ctfail("capstone gate requires @root and @bin\n") else let err_msg = cp_main(req.root, req.bin) in if err_msg != "" then ctfail("capstone gate failed: " + err_msg + "\n") else "PASS: native SaaS/WAL restart and two-clock QEMU RTC capstone gates"
print cp_dispatch(readall())
