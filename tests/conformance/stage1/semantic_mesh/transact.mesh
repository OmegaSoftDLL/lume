@protocol lume-semantic-intent/0.1
@mode transact
@goal revise and replay a verified contract branch
@target x86_64-linux-elf
@capabilities pure
@resources max_source_bytes=4096,max_transactions=8
@acceptance compile
@source
fn inc(x: int) -> int requires x >= 0 = x + 1
fn caller(x: int) -> int requires x >= 0 ensures result == x + 2 = inc(x) + 1
@end
@op add_contract
@symbol inc
@kind ensures
@expr result == x + 1
@end
@op replace_contract
@symbol inc
@kind ensures
@expr result - x == 1
@end
@op set_target
@target lumb
@end
@op rollback
@to 1
@end
@op replay
@from 1
@to 3
@end
