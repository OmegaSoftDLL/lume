@protocol lume-semantic-intent/0.1
@mode transact
@goal reject trailing contract payload
@target x86_64-linux-elf
@capabilities pure
@resources max_source_bytes=4096,max_transactions=4
@acceptance compile
@source
fn same(x: int) -> int = x
@end
@op add_contract
@symbol same
@kind ensures
@expr result == x = 0
@end
