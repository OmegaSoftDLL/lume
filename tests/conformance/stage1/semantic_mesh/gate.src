fn sm_run(path, args, out) = os_run_capture_timeout(path, args, out, out + ".err", 900000)
fn sm_input(path, args, input, out) = os_run_input_capture_timeout(path, args, input, out, out + ".err", 900000)
fn sm_fixture(root) = root + "/tests/conformance/stage1/semantic_mesh"
fn sm_invoke(root, tmp, name) = sm_run(root + "/lume", Cons("mesh", Cons(sm_fixture(root) + "/" + name + ".mesh", Nil)), tmp + "/" + name + ".json")
fn sm_write(path, text) = if fs_write_sync(path, text) == 1 then "" else "cannot write " + path
fn sm_oracle(tmp, request) = let input = tmp + "/oracle.in" in let out = tmp + "/oracle.out" in let written = sm_write(input, request) in if written != "" then written else let status = sm_input(tmp + "/lmesh_assert", Nil, input, out) in if status == 0 then "" else "semantic assertion failed: " + fs_read_file(out) + fs_read_file(out + ".err")
fn sm_case(root, tmp, name, mode, code) = let raw = sm_invoke(root, tmp, name) in if code == "" and raw != 0 then name + " failed: " + fs_read_file(tmp + "/" + name + ".json.err") else if code != "" and raw == 0 then name + " unexpectedly passed" else if code == "" then sm_oracle(tmp, "@mode " + mode + "\n@path " + tmp + "/" + name + ".json\n") else sm_oracle(tmp, "@mode error\n@path " + tmp + "/" + name + ".json\n@other \n@code " + code + "\n")
fn sm_report(name, error) = if error == "" then let shown = print("  ok   " + name) in 0 else let shown = print("  FAIL " + name + ": " + error) in 1
fn sm_cases(root, tmp, cases) = match cases
    Nil => {failed: 0, total: 0}
    Cons(h, t) => let failed = sm_report(h.name, sm_case(root, tmp, h.name, h.mode, h.code)) in let rest = sm_cases(root, tmp, t) in {failed: failed + rest.failed, total: 1 + rest.total}
fn sm_case_names() = Cons({name: "negotiate", mode: "negotiate", code: ""}, Cons({name: "transact", mode: "transact", code: ""}, Cons({name: "invalid_mode", mode: "error", code: "M1003"}, Cons({name: "ambiguous_payload", mode: "error", code: "M1002"}, Cons({name: "unknown_operation", mode: "error", code: "M1003"}, Cons({name: "duplicate_symbols", mode: "error", code: "M2002"}, Cons({name: "capability_violation", mode: "error", code: "M2004"}, Cons({name: "top_level_capability", mode: "error", code: "M2004"}, Cons({name: "top_level_expression", mode: "error", code: "M1004"}, Cons({name: "invalid_target", mode: "error", code: "M2003"}, Cons({name: "false_contract", mode: "error", code: "V0001"}, Cons({name: "out_of_fragment", mode: "out_of_fragment", code: ""}, Cons({name: "ambiguous_contract", mode: "error", code: "M1002"}, Nil)))))))))))))
fn sm_canonical(root, tmp) = let a = sm_invoke(root, tmp, "canonical_a") in let b = sm_invoke(root, tmp, "canonical_b") in if a != 0 or b != 0 then "canonical requests failed" else sm_oracle(tmp, "@mode canonical\n@path " + tmp + "/canonical_a.json\n@other " + tmp + "/canonical_b.json\n")
fn sm_cli(root, tmp) = let out = tmp + "/cli_bad.out" in let raw = sm_run(root + "/lume", Cons("mesh", Cons("--fixed-success", Nil)), out) in if raw == 0 then "unknown CLI arguments were accepted" else ""
fn sm_prepare(root, tmp) = let removed = sm_run("/bin/rm", Cons("-rf", Cons(tmp, Nil)), tmp + ".rm.out") in if removed != 0 then "cannot reset semantic gate directory" else let made = sm_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil)), tmp + ".mkdir.out") in if made != 0 then "cannot create semantic gate directory" else let built = sm_run(root + "/lume", Cons("build", Cons(sm_fixture(root) + "/assertions.src", Cons("-o", Cons(tmp + "/lmesh_assert", Nil)))), tmp + "/assertions-build.out") in if built != 0 then "cannot build semantic oracle: " + fs_read_file(tmp + "/assertions-build.out.err") else ""
fn sm_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else sm_line_end(text, i + 1)
fn sm_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, sm_line_end(input, 0))
fn sm_main(root) = let tmp = root + "/build/semantic-mesh-gate" in let prepared = sm_prepare(root, tmp) in if prepared != "" then {failed: 1, total: 1, error: prepared} else let cases = sm_cases(root, tmp, sm_case_names()) in let canonical = sm_report("canonical", sm_canonical(root, tmp)) in let cli = sm_report("cli", sm_cli(root, tmp)) in {failed: cases.failed + canonical + cli, total: cases.total + 2, error: ""}
fn sm_dispatch(input) = let root = sm_root(input) in if root == "" then ctfail("semantic gate requires @root\n") else let result = sm_main(root) in let summary = "semantic mesh: " + str(result.total - result.failed) + " passed, " + str(result.failed) + " failed" in if result.failed != 0 then ctfail(summary + "\n" + result.error) else summary
print sm_dispatch(readall())
