fn lf_source(name) = if name == "elf_hello" then "    .globl _start\n    .section .text\n_start:\n    movq $1, %rax\n    movq $1, %rdi\n    leaq msg(%rip), %rsi\n    movq $16, %rdx\n    syscall\n    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n    .section .rodata\nmsg:\n    .ascii \"lume native elf\\n\"\n" else if name == "local_labels" then "    .globl _start\n    .section .text\n_start:\n    xorq %rbx, %rbx\n    movq $3, %rcx\n1:\n    addq $1, %rbx\n    subq $1, %rcx\n    jne 1b\n    jmp 1f\n    movq $99, %rbx\n1:\n    movq $4, %rcx\n1:\n    addq $10, %rbx\n    subq $1, %rcx\n    jne 1b\n    cmpq $43, %rbx\n    jne 2f\n    leaq okm(%rip), %rsi\n    movq $3, %rdx\n    jmp 1f\n2:\n    leaq nom(%rip), %rsi\n    movq $3, %rdx\n1:\n    movq $1, %rax\n    movq $1, %rdi\n    syscall\n    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n    .section .rodata\nokm:\n    .asciz \"ok\\n\"\nnom:\n    .asciz \"no\\n\"\n" else if name == "symbol_collisions" then ".section .text\n.globl _start\n_start:\n    call A\n    call Ab\n    movq $60, %rax\n    movq $0, %rdi\n    syscall\nA:\n    movq $120, %rsi\n    ret\nAb:\n    movq $240, %rsi\n    ret\n" else ""

fn lf_write(dir, name) = if lf_source(name) == "" then 0 else fs_write_sync(dir + "/" + name + ".s", lf_source(name))

fn lf_self_test() = if lf_source("elf_hello") == "" or lf_source("local_labels") == "" or lf_source("symbol_collisions") == "" then 0 else if lf_source("unknown") != "" then 0 else 1
