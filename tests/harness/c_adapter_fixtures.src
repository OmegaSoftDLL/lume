fn cf_header(name) = if name == "buffer_math" then "#include <stdint.h>\n#pragma once\n\nint64_t c_buffer_weighted_sum(const char *bytes, int64_t bytes_len, int64_t weight);\nint64_t c_text_checksum(const char *text);\n" else if name == "array" then "int64_t array_buffer(const char data[16]);\n" else if name == "callback" then "int64_t apply_callback(int64_t (*callback)(int64_t), int64_t value);\n" else if name == "duplicate_parameter" then "int64_t duplicate_parameter(int64_t value, int64_t value);\n" else if name == "duplicate_symbol" then "int64_t duplicate_symbol(int64_t value);\nextern int64_t duplicate_symbol(int64_t other);\n" else if name == "garbage" then "this is not a C declaration\n" else if name == "length_type" then "#include <stddef.h>\nint64_t sized_bytes(const char *data, size_t data_len);\n" else if name == "mixed" then "int64_t supported(int64_t value);\nvoid *unsupported_owned_pointer(void);\n" else if name == "multiline" then "int64_t multiline(\n    int64_t value);\n" else if name == "mutable_buffer" then "int64_t fill_buffer(char *data, int64_t data_len);\n" else if name == "preprocessor" then "#define int64_t long\nint64_t rewritten(int64_t value);\n" else if name == "trailing_comma" then "int64_t trailing_comma(int64_t value,);\n" else if name == "trailing_garbage" then "int64_t valid(int64_t value); int64_t injected(int64_t value);\n" else if name == "unspecified_arity" then "int64_t unspecified_arity();\n" else if name == "variadic" then "int64_t variadic(const char *format, ...);\n" else ""

fn cf_write(dir, name) = if cf_header(name) == "" then 0 else fs_write_sync(dir + "/" + name + ".h", cf_header(name))

fn cf_self_test() = if cf_header("buffer_math") != "#include <stdint.h>\n#pragma once\n\nint64_t c_buffer_weighted_sum(const char *bytes, int64_t bytes_len, int64_t weight);\nint64_t c_text_checksum(const char *text);\n" then 0 else if cf_header("array") != "int64_t array_buffer(const char data[16]);\n" then 0 else if cf_header("callback") != "int64_t apply_callback(int64_t (*callback)(int64_t), int64_t value);\n" then 0 else if cf_header("duplicate_parameter") != "int64_t duplicate_parameter(int64_t value, int64_t value);\n" then 0 else if cf_header("duplicate_symbol") != "int64_t duplicate_symbol(int64_t value);\nextern int64_t duplicate_symbol(int64_t other);\n" then 0 else if cf_header("garbage") != "this is not a C declaration\n" then 0 else if cf_header("length_type") != "#include <stddef.h>\nint64_t sized_bytes(const char *data, size_t data_len);\n" then 0 else if cf_header("mixed") != "int64_t supported(int64_t value);\nvoid *unsupported_owned_pointer(void);\n" then 0 else if cf_header("multiline") != "int64_t multiline(\n    int64_t value);\n" then 0 else if cf_header("mutable_buffer") != "int64_t fill_buffer(char *data, int64_t data_len);\n" then 0 else if cf_header("preprocessor") != "#define int64_t long\nint64_t rewritten(int64_t value);\n" then 0 else if cf_header("trailing_comma") != "int64_t trailing_comma(int64_t value,);\n" then 0 else if cf_header("trailing_garbage") != "int64_t valid(int64_t value); int64_t injected(int64_t value);\n" then 0 else if cf_header("unspecified_arity") != "int64_t unspecified_arity();\n" then 0 else if cf_header("variadic") != "int64_t variadic(const char *format, ...);\n" then 0 else if cf_header("unknown") != "" then 0 else if cf_write("cf_fixture_write_test", "unknown") != 0 then 0 else 1
