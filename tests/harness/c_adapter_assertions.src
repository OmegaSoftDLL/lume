use lcaas

fn cj_between(s, open, close) = let n = count(s) in let a = cs_find_substr(s, open, 0, n, count(open)) in if a >= n then {ok: 0, text: ""} else let start = a + count(open) in let b = cs_find_substr(s, close, start, n, count(close)) in if b >= n then {ok: 0, text: ""} else {ok: 1, text: slice(s, start, b)}

fn cj_string_end(s, i) = if i >= count(s) then i else if at(s, i) == "\"" then i else if at(s, i) == "\\" then cj_string_end(s, i + 2) else cj_string_end(s, i + 1)

fn cj_field(s, key) = let marker = "\"" + key + "\":\"" in let p = cs_find_substr(s, marker, 0, count(s), count(marker)) in if p >= count(s) then {ok: 0, text: ""} else let start = p + count(marker) in let finish = cj_string_end(s, start) in if finish >= count(s) then {ok: 0, text: ""} else {ok: 1, text: slice(s, start, finish)}

fn cj_unescape(s, i, acc) = if i >= count(s) then {ok: 1, text: acc} else let c = at(s, i) in if c != "\\" then cj_unescape(s, i + 1, acc + c) else if i + 1 >= count(s) then {ok: 0, text: ""} else let e = at(s, i + 1) in let decoded = if e == "n" then "\n" else if e == "r" then "\r" else if e == "t" then "\t" else if e == "\\" then "\\" else if e == "\"" then "\"" else if e == "/" then "/" else "" in if count(decoded) == 0 then {ok: 0, text: ""} else cj_unescape(s, i + 2, acc + decoded)

fn cj_text(s, key) = let field = cj_field(s, key) in if field.ok == 0 then {ok: 0, text: ""} else cj_unescape(field.text, 0, "")

fn cj_first_string(s) = if count(s) == 0 or at(s, 0) != "\"" then {ok: 0, text: ""} else let finish = cj_string_end(s, 1) in if finish >= count(s) then {ok: 0, text: ""} else cj_unescape(slice(s, 1, finish), 0, "")

fn cj_objects(text) = if text == "" then Nil else let p = cs_find_substr(text, "},{", 0, count(text), 3) in let raw = if p >= count(text) then text else slice(text, 0, p + 1) in let rest = if p >= count(text) then "" else slice(text, p + 2, count(text)) in Cons(raw, cj_objects(rest))

fn cj_count_marker(s, marker) = if cs_has_substr(s, marker) == 0 then 0 else let p = cs_find_substr(s, marker, 0, count(s), count(marker)) in 1 + cj_count_marker(slice(s, p + count(marker), count(s)), marker)

fn cj_diagnostics_valid(raws) = match raws
    Nil => 1
    Cons(h, t) => if (cj_text(h, "code")).text == "I0003" and (cj_text(h, "severity")).text == "error" then cj_diagnostics_valid(t) else 0

fn cj_callback_diagnostic(raws) = match raws
    Nil => 0
    Cons(h, t) => if cs_has_substr((cj_text(h, "message")).text, "callback") == 1 then 1 else cj_callback_diagnostic(t)

fn cj_manifest(result, header, output) = let generated = cj_text(result, "generated_lume") in let diagnostics = cj_between(result, "\"diagnostics\":[", "],\"adapters\":") in let adapters = cj_between(result, "\"adapters\":[", "],\"extern_decls\":") in let buffer = cj_between(adapters.text, "{\"symbol\":\"c_buffer_weighted_sum\"", "},{\"symbol\":\"c_text_checksum\"") in let parameters = cj_between(buffer.text, "\"parameters\":[", "],\"return\":") in let bytes = cj_between(parameters.text, "{\"name\":\"bytes\"", "},{\"name\":\"bytes_len\"") in let bytes_len = cj_between(parameters.text, "{\"name\":\"bytes_len\"", "}") in let externs = cj_between(result, "\"extern_decls\":[", "],\"foreign_wrappers\":") in let wrappers = cj_between(result, "\"foreign_wrappers\":[", "],\"generated_lume\":") in let extern0 = cj_first_string(externs.text) in let wrapper0 = cj_first_string(wrappers.text) in let valid = if cs_startswith(result, "{\"ok\":true") == 1 and (cj_text(result, "adapter_contract")).text == "c_abi_foreign_v2" and (cj_text(result, "source_hash")).text == lc_sha256(header) and cs_has_substr(result, "\"capabilities\":[\"ffi\"]") == 1 and (cj_text(result, "provenance_guard")).text == "A0003" and (cj_text(result, "return_provenance")).text == "unverified" and diagnostics.ok == 1 and diagnostics.text == "" and adapters.ok == 1 and cj_count_marker(adapters.text, "\"symbol\":") == 2 and (cj_text(buffer.text, "symbol")).text == "c_buffer_weighted_sum" and cs_has_substr(buffer.text, "\"return\":{\"c_type\":\"int64_t\",\"lume_type\":\"unverified[int]\",\"provenance\":\"foreign\"}") == 1 and cs_has_substr(buffer.text, "\"effects\":[\"ffi\"]") == 1 and (cj_text(bytes.text, "name")).text == "bytes" and (cj_text(bytes.text, "c_type")).text == "const char *" and (cj_text(bytes.text, "lume_type")).text == "str" and (cj_text(bytes.text, "ownership")).text == "borrowed_read_only" and (cj_text(bytes.text, "lifetime")).text == "call" and (cj_text(bytes.text, "extent")).text == "count(c_bytes)" and (cj_text(bytes.text, "length_parameter")).text == "bytes_len" and (cj_text(bytes_len.text, "ownership")).text == "value" and extern0.text == "extern \"c\" fn c_buffer_weighted_sum(c_bytes: str, c_bytes_len: int, c_weight: int) -> int" and wrapper0.text == "pub fn foreign_c_buffer_weighted_sum(c_bytes: str, c_weight: int) -> unverified[int] / {ffi} = c_buffer_weighted_sum(c_bytes, count(c_bytes), c_weight)" and cs_has_substr(generated.text, "verify(") == 0 and cs_has_substr(generated.text, "ensures") == 0 then 1 else 0 in if valid == 1 and generated.ok == 1 then fs_write_sync(output, generated.text + "\n") else 0

fn cj_invalid(result) = let generated = cj_text(result, "generated_lume") in let diagnostics = cj_between(result, "\"diagnostics\":[", "],\"adapters\":") in cs_startswith(result, "{\"ok\":false") == 1 and generated.text == "" and diagnostics.ok == 1 and diagnostics.text != "" and cj_diagnostics_valid(cj_objects(diagnostics.text)) == 1

fn cj_callback(result) = let generated = cj_text(result, "generated_lume") in let diagnostics = cj_between(result, "\"diagnostics\":[", "],\"adapters\":") in cs_startswith(result, "{\"ok\":false") == 1 and generated.text == "" and diagnostics.ok == 1 and cj_callback_diagnostic(cj_objects(diagnostics.text)) == 1

fn cj_len(xs) = match xs
    Nil => 0
    Cons(h, t) => 1 + cj_len(t)

fn cj_array_count(raw) = if raw == "" then 0 else 1 + cj_count_marker(raw, "\",\"")

fn cj_array_contains(raw, expected) = if raw == "" then 0 else let item = cj_first_string(raw) in let finish = cj_string_end(raw, 1) in if item.text == expected then 1 else if finish + 2 >= count(raw) then 0 else cj_array_contains(slice(raw, finish + 2, count(raw)), expected)

fn cj_message_containing(raws, keyword) = match raws
    Nil => 0
    Cons(h, t) => if cs_has_substr((cj_text(h, "message")).text, keyword) == 1 then 1 else cj_message_containing(t, keyword)

fn cj_asthead(xs) = match xs
    Nil => ""
    Cons(h, t) => h

fn cj_stage0(good, bad, empty, output) = let generated = cj_text(good, "generated_lume") in let good_diagnostics = cj_between(good, "\"diagnostics\":[", "],\"adapters\":") in let good_externs = cj_between(good, "\"extern_decls\":[", "],\"foreign_wrappers\":") in let good_wrappers = cj_between(good, "\"foreign_wrappers\":[", "],\"generated_lume\":") in let bad_generated = cj_text(bad, "generated_lume") in let bad_diagnostics = cj_between(bad, "\"diagnostics\":[", "],\"adapters\":") in let bad_externs = cj_between(bad, "\"extern_decls\":[", "],\"foreign_wrappers\":") in let bad_wrappers = cj_between(bad, "\"foreign_wrappers\":[", "],\"generated_lume\":") in let empty_generated = cj_text(empty, "generated_lume") in let empty_diagnostics = cj_between(empty, "\"diagnostics\":[", "],\"adapters\":") in let bad_diags = cj_objects(bad_diagnostics.text) in let empty_diags = cj_objects(empty_diagnostics.text) in let valid = if cs_startswith(good, "{\"ok\":true") == 1 and (cj_text(good, "adapter_contract")).text == "c_abi_foreign_v2" and (cj_text(good, "ownership")).text == "borrowed_const_cstr_and_sized_read_only_buffers" and (cj_text(good, "return_provenance")).text == "unverified" and good_diagnostics.ok == 1 and good_diagnostics.text == "" and cj_array_count(good_externs.text) == 2 and cj_array_count(good_wrappers.text) == 2 and cj_array_contains(good_externs.text, "extern \"c\" fn db_open(c_filename: str, c_flags: int) -> int") == 1 and cj_array_contains(good_wrappers.text, "pub fn foreign_db_open(c_filename: str, c_flags: int) -> unverified[int] / {ffi} = db_open(c_filename, c_flags)") == 1 and cs_has_substr(generated.text, "verify(") == 0 and cs_has_substr(generated.text, "ensures") == 0 and cs_has_substr(generated.text, "safe_") == 0 and cs_startswith(bad, "{\"ok\":false") == 1 and bad_generated.text == "" and cj_array_count(bad_externs.text) == 1 and cj_array_count(bad_wrappers.text) == 1 and cj_len(bad_diags) == 11 and cj_diagnostics_valid(bad_diags) == 1 and cj_message_containing(bad_diags, "callback") == 1 and cj_message_containing(bad_diags, "ownership") == 1 and cs_startswith(empty, "{\"ok\":false") == 1 and empty_generated.text == "" and cj_len(empty_diags) == 1 then 1 else 0 in if valid == 1 and generated.ok == 1 and (cj_text(cj_asthead(empty_diags), "code")).text == "I0003" then fs_write_sync(output, generated.text + "\n") else 0

fn cj_at_line(xs, idx) = match xs
    Nil => ""
    Cons(h, t) => if idx == 0 then cs_chomp(h) else cj_at_line(t, idx - 1)

fn cj_value(line, prefix) = if cs_startswith(line, prefix) == 1 then slice(line, count(prefix), count(line)) else ""

fn cj_request(input) = let ls = lc_split_lines(input, 0, count(input)) in {mode: cj_value(cj_at_line(ls, 0), "@mode "), path: cj_value(cj_at_line(ls, 1), "@path "), header: cj_value(cj_at_line(ls, 2), "@header "), output: cj_value(cj_at_line(ls, 3), "@output "), generated: cj_value(cj_at_line(ls, 4), "@generated ")}

fn cj_dispatch(input) = let req = cj_request(input) in let result = fs_read_file(req.path) in let ok = if req.mode == "manifest" then cj_manifest(result, fs_read_file(req.header), req.output) else if req.mode == "invalid" then cj_invalid(result) else if req.mode == "callback" then cj_callback(result) else if req.mode == "stage0" then cj_stage0(result, fs_read_file(req.header), fs_read_file(req.output), req.generated) else 0 in if ok == 1 then "{\"ok\":true}" else ctfail("C adapter assertion failed: " + req.mode)

print cj_dispatch(readall())
