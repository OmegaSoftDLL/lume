fn sha_u32(x) = let r = x % 4294967296 in if r < 0 then r + 4294967296 else r
fn sha_pow2(n) = if n <= 0 then 1 else if n >= 16 then 65536 * sha_pow2(n - 16) else if n >= 8 then 256 * sha_pow2(n - 8) else if n >= 4 then 16 * sha_pow2(n - 4) else if n == 3 then 8 else if n == 2 then 4 else 2
fn sha_shr(x, n) = x / sha_pow2(n)
fn sha_rotr(x, n) = let p = sha_pow2(n) in (x / p) + ((x % p) * sha_pow2(32 - n))
fn sha_xor3_4(x, y, z) = let b0 = ((x % 2) + (y % 2) + (z % 2)) % 2 in let b1 = (((x / 2) % 2) + ((y / 2) % 2) + ((z / 2) % 2)) % 2 in let b2 = (((x / 4) % 2) + ((y / 4) % 2) + ((z / 4) % 2)) % 2 in let b3 = (((x / 8) % 2) + ((y / 8) % 2) + ((z / 8) % 2)) % 2 in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_xor3_n(x, y, z, nibs) = if nibs == 8 then bv_xor(bv_xor(x, y), z) else if nibs <= 0 then 0 else sha_xor3_4(x % 16, y % 16, z % 16) + 16 * sha_xor3_n(x / 16, y / 16, z / 16, nibs - 1)
fn sha_ch_4(e, f, g) = let b0 = (if (e % 2) == 1 then (f % 2) else (g % 2)) in let b1 = (if ((e / 2) % 2) == 1 then ((f / 2) % 2) else ((g / 2) % 2)) in let b2 = (if ((e / 4) % 2) == 1 then ((f / 4) % 2) else ((g / 4) % 2)) in let b3 = (if ((e / 8) % 2) == 1 then ((f / 8) % 2) else ((g / 8) % 2)) in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_ch_n(e, f, g, nibs) = if nibs == 8 then bv_xor(bv_and(e, f), bv_and(bv_xor(e, 4294967295), g)) else if nibs <= 0 then 0 else sha_ch_4(e % 16, f % 16, g % 16) + 16 * sha_ch_n(e / 16, f / 16, g / 16, nibs - 1)
fn sha_maj_4(a, b, c) = let b0 = (if (a % 2) + (b % 2) + (c % 2) >= 2 then 1 else 0) in let b1 = (if ((a / 2) % 2) + ((b / 2) % 2) + ((c / 2) % 2) >= 2 then 1 else 0) in let b2 = (if ((a / 4) % 2) + ((b / 4) % 2) + ((c / 4) % 2) >= 2 then 1 else 0) in let b3 = (if ((a / 8) % 2) + ((b / 8) % 2) + ((c / 8) % 2) >= 2 then 1 else 0) in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_maj_n(a, b, c, nibs) = if nibs == 8 then bv_xor(bv_xor(bv_and(a, b), bv_and(a, c)), bv_and(b, c)) else if nibs <= 0 then 0 else sha_maj_4(a % 16, b % 16, c % 16) + 16 * sha_maj_n(a / 16, b / 16, c / 16, nibs - 1)
fn sha_big_sig0(a) = sha_xor3_n(sha_rotr(a, 2), sha_rotr(a, 13), sha_rotr(a, 22), 8)
fn sha_big_sig1(e) = sha_xor3_n(sha_rotr(e, 6), sha_rotr(e, 11), sha_rotr(e, 25), 8)
fn sha_sml_sig0(x) = sha_xor3_n(sha_rotr(x, 7), sha_rotr(x, 18), sha_shr(x, 3), 8)
fn sha_sml_sig1(x) = sha_xor3_n(sha_rotr(x, 17), sha_rotr(x, 19), sha_shr(x, 10), 8)
fn sha_k(t) = if t < 16 then (if t == 0 then 1116352408 else if t == 1 then 1899447441 else if t == 2 then 3049323471 else if t == 3 then 3921009573 else if t == 4 then 961987163 else if t == 5 then 1508970993 else if t == 6 then 2453635748 else if t == 7 then 2870763221 else if t == 8 then 3624381080 else if t == 9 then 310598401 else if t == 10 then 607225278 else if t == 11 then 1426881987 else if t == 12 then 1925078388 else if t == 13 then 2162078206 else if t == 14 then 2614888103 else 3248222580) else if t < 32 then (if t == 16 then 3835390401 else if t == 17 then 4022224774 else if t == 18 then 264347078 else if t == 19 then 604807628 else if t == 20 then 770255983 else if t == 21 then 1249150122 else if t == 22 then 1555081692 else if t == 23 then 1996064986 else if t == 24 then 2554220882 else if t == 25 then 2821834349 else if t == 26 then 2952996808 else if t == 27 then 3210313671 else if t == 28 then 3336571891 else if t == 29 then 3584528711 else if t == 30 then 113926993 else 338241895) else if t < 48 then (if t == 32 then 666307205 else if t == 33 then 773529912 else if t == 34 then 1294757372 else if t == 35 then 1396182291 else if t == 36 then 1695183700 else if t == 37 then 1986661051 else if t == 38 then 2177026350 else if t == 39 then 2456956037 else if t == 40 then 2730485921 else if t == 41 then 2820302411 else if t == 42 then 3259730800 else if t == 43 then 3345764771 else if t == 44 then 3516065817 else if t == 45 then 3600352804 else if t == 46 then 4094571909 else 275423344) else (if t == 48 then 430227734 else if t == 49 then 506948616 else if t == 50 then 659060556 else if t == 51 then 883997877 else if t == 52 then 958139571 else if t == 53 then 1322822218 else if t == 54 then 1537002063 else if t == 55 then 1747873779 else if t == 56 then 1955562222 else if t == 57 then 2024104815 else if t == 58 then 2227730452 else if t == 59 then 2361852424 else if t == 60 then 2428436474 else if t == 61 then 2756734187 else if t == 62 then 3204031479 else 3329325298)
fn sha_nth(xs, i) = match xs
    Nil        => 0
    Cons(h, t) => if i <= 0 then h else sha_nth(t, i - 1)
fn sha_msg_byte(s, len, total, idx) = if idx < len then ord(at(s, idx)) else if idx == len then 128 else if idx >= total - 8 then ((len * 8) / sha_pow2(8 * (total - 1 - idx))) % 256 else 0
fn sha_msg_word(s, len, total, base) = sha_msg_byte(s, len, total, base) * 16777216 + sha_msg_byte(s, len, total, base + 1) * 65536 + sha_msg_byte(s, len, total, base + 2) * 256 + sha_msg_byte(s, len, total, base + 3)
fn sha_w_build(s, len, total, blk_off, t, w_rev) = if t >= 64 then w_rev else let wt = (if t < 16 then sha_msg_word(s, len, total, blk_off + t * 4) else sha_u32(sha_nth(w_rev, 15) + sha_sml_sig0(sha_nth(w_rev, 14)) + sha_nth(w_rev, 6) + sha_sml_sig1(sha_nth(w_rev, 1)))) in sha_w_build(s, len, total, blk_off, t + 1, Cons(wt, w_rev))
fn sha_round(st, wt, kt) = let t1 = sha_u32(st.h + sha_big_sig1(st.e) + sha_ch_n(st.e, st.f, st.g, 8) + kt + wt) in let t2 = sha_u32(sha_big_sig0(st.a) + sha_maj_n(st.a, st.b, st.c, 8)) in {a: sha_u32(t1 + t2), b: st.a, c: st.b, d: st.c, e: sha_u32(st.d + t1), f: st.e, g: st.f, h: st.g}
fn sha_rounds(st, w_rev, t) = if t >= 64 then st else sha_rounds(sha_round(st, sha_nth(w_rev, 63 - t), sha_k(t)), w_rev, t + 1)
fn sha_blocks(s, len, total, blk_off, st) = if blk_off >= total then st else let w_rev = sha_w_build(s, len, total, blk_off, 0, Nil) in let r = sha_rounds(st, w_rev, 0) in sha_blocks(s, len, total, blk_off + 64, {a: sha_u32(st.a + r.a), b: sha_u32(st.b + r.b), c: sha_u32(st.c + r.c), d: sha_u32(st.d + r.d), e: sha_u32(st.e + r.e), f: sha_u32(st.f + r.f), g: sha_u32(st.g + r.g), h: sha_u32(st.h + r.h)})
fn sha_hex1(n) = at("0123456789abcdef", n % 16)
fn sha_hex32(w) = sha_hex1(w / 268435456) + sha_hex1(w / 16777216) + sha_hex1(w / 1048576) + sha_hex1(w / 65536) + sha_hex1(w / 4096) + sha_hex1(w / 256) + sha_hex1(w / 16) + sha_hex1(w)
fn sha256_hex(s) = let len = count(s) in let total = ((len + 9 + 63) / 64) * 64 in let init = {a: 1779033703, b: 3144134277, c: 1013904242, d: 2773480762, e: 1359893119, f: 2600822924, g: 528734635, h: 1541459225} in let fin = sha_blocks(s, len, total, 0, init) in sha_hex32(fin.a) + sha_hex32(fin.b) + sha_hex32(fin.c) + sha_hex32(fin.d) + sha_hex32(fin.e) + sha_hex32(fin.f) + sha_hex32(fin.g) + sha_hex32(fin.h)
fn lc_sha256(s) = "sha256:" + sha256_hex(s)

fn cs_rtrimnl(s, e) = if e <= 0 then 0 else if at(s, e - 1) == "\n" or at(s, e - 1) == "\r" or at(s, e - 1) == " " then cs_rtrimnl(s, e - 1) else e
fn cs_chomp(s) = slice(s, 0, cs_rtrimnl(s, count(s)))
fn cs_startswith(s, p) = if count(s) < count(p) then 0 else if slice(s, 0, count(p)) == p then 1 else 0
fn cs_lineend(s, i, n) = if i >= n then i else if at(s, i) == "\n" then i + 1 else cs_lineend(s, i + 1, n)
fn lc_split_lines(s, i, n) = if i >= n then Nil else let le = cs_lineend(s, i, n) in Cons(slice(s, i, le), lc_split_lines(s, le, n))
fn cs_find_substr(s, pat, i, n, m) = if i + m > n then n else if slice(s, i, i + m) == pat then i else cs_find_substr(s, pat, i + 1, n, m)
fn cs_has_substr_i(s, pat, i, n, m) = if i + m > n then 0 else if slice(s, i, i + m) == pat then 1 else cs_has_substr_i(s, pat, i + 1, n, m)
fn cs_has_substr(s, pat) = let n = count(s) in let m = count(pat) in if m == 0 then 1 else if m > n then 0 else cs_has_substr_i(s, pat, 0, n, m)

fn cj_between(s, open, close) = let n = count(s) in let a = cs_find_substr(s, open, 0, n, count(open)) in if a >= n then {ok: 0, text: ""} else let start = a + count(open) in let b = cs_find_substr(s, close, start, n, count(close)) in if b >= n then {ok: 0, text: ""} else {ok: 1, text: slice(s, start, b)}

fn cj_string_end(s, i) = if i >= count(s) then i else if at(s, i) == "\"" then i else if at(s, i) == "\\" then cj_string_end(s, i + 2) else cj_string_end(s, i + 1)

fn cj_field(s, key) = let marker = "\"" + key + "\":\"" in let p = cs_find_substr(s, marker, 0, count(s), count(marker)) in if p >= count(s) then {ok: 0, text: ""} else let start = p + count(marker) in let finish = cj_string_end(s, start) in if finish >= count(s) then {ok: 0, text: ""} else {ok: 1, text: slice(s, start, finish)}

fn cj_unescape(s, i, acc) = if i >= count(s) then {ok: 1, text: acc} else let c = at(s, i) in if c != "\\" then cj_unescape(s, i + 1, acc + c) else if i + 1 >= count(s) then {ok: 0, text: ""} else let e = at(s, i + 1) in let decoded = if e == "n" then "\n" else if e == "r" then "\r" else if e == "t" then "\t" else if e == "\\" then "\\" else if e == "\"" then "\"" else if e == "/" then "/" else "" in if count(decoded) == 0 then {ok: 0, text: ""} else cj_unescape(s, i + 2, acc + decoded)

fn cj_text(s, key) = let field = cj_field(s, key) in if field.ok == 0 then {ok: 0, text: ""} else cj_unescape(field.text, 0, "")

fn cj_first_string(s) = if count(s) == 0 or at(s, 0) != "\"" then {ok: 0, text: ""} else let finish = cj_string_end(s, 1) in if finish >= count(s) then {ok: 0, text: ""} else cj_unescape(slice(s, 1, finish), 0, "")

fn cj_objects(text) = if text == "" then Nil else let p = cs_find_substr(text, "},{", 0, count(text), 3) in let raw = if p >= count(text) then text else slice(text, 0, p + 1) in let rest = if p >= count(text) then "" else slice(text, p + 2, count(text)) in Cons(raw, cj_objects(rest))

fn cj_count_marker(s, marker) = if cs_has_substr(s, marker) == 0 then 0 else let p = cs_find_substr(s, marker, 0, count(s), count(marker)) in 1 + cj_count_marker(slice(s, p + count(marker), count(s)), marker)

fn cj_diagnostics_valid(raws) = match raws
    Nil => 1
    Cons(h, t) => if (cj_text(h, "code")).text == "I0003" and (cj_text(h, "severity")).text == "error" then cj_diagnostics_valid(t) else 0

fn cj_callback_diagnostic(raws) = match raws
    Nil => 0
    Cons(h, t) => if cs_has_substr((cj_text(h, "message")).text, "callback") == 1 then 1 else cj_callback_diagnostic(t)

fn cj_manifest(result, header, output) = let generated = cj_text(result, "generated_lume") in let diagnostics = cj_between(result, "\"diagnostics\":[", "],\"adapters\":") in let adapters = cj_between(result, "\"adapters\":[", "],\"extern_decls\":") in let buffer = cj_between(adapters.text, "{", "},{\"symbol\":\"c_text_checksum\"") in let parameters = cj_between(buffer.text, "\"parameters\":[", "],\"return\":") in let bytes = cj_between(parameters.text, "{", "},{\"name\":\"weight\"") in let weight = cj_between(parameters.text, "},{\"name\":\"weight\"", "}") in let externs = cj_between(result, "\"extern_decls\":[", "],\"foreign_wrappers\":") in let wrappers = cj_between(result, "\"foreign_wrappers\":[", "],\"generated_lume\":") in let extern0 = cj_first_string(externs.text) in let wrapper0 = cj_first_string(wrappers.text) in let exp_wrap0 = "pub fn foreign_c_buffer_weighted_sum(c_bytes: str, c_weight: int) -> unverified[int] / {" + "ffi} = c_buffer_weighted_sum(c_bytes, count(c_bytes), c_weight)" in let valid = if cs_startswith(result, "{\"ok\":true") == 1 and (cj_text(result, "adapter_contract")).text == "c_abi_foreign_v2" and (cj_text(result, "source_hash")).text == lc_sha256(header) and cs_has_substr(result, "\"capabilities\":[\"ffi\"]") == 1 and (cj_text(result, "provenance_guard")).text == "A0003" and (cj_text(result, "return_provenance")).text == "unverified" and diagnostics.ok == 1 and diagnostics.text == "" and adapters.ok == 1 and cj_count_marker(adapters.text, "\"symbol\":") == 2 and (cj_text(buffer.text, "symbol")).text == "c_buffer_weighted_sum" and cs_has_substr(buffer.text, "\"return\":{\"c_type\":\"int64_t\",\"lume_type\":\"unverified[int]\",\"provenance\":\"foreign\"}") == 1 and cs_has_substr(buffer.text, "\"effects\":[\"ffi\"]") == 1 and (cj_text(bytes.text, "name")).text == "bytes" and (cj_text(bytes.text, "c_type")).text == "const char *" and (cj_text(bytes.text, "lume_type")).text == "str" and (cj_text(bytes.text, "ownership")).text == "borrowed_read_only" and (cj_text(bytes.text, "lifetime")).text == "call" and (cj_text(bytes.text, "extent")).text == "count(c_bytes)" and (cj_text(bytes.text, "length_parameter")).text == "bytes_len" and (cj_text(weight.text, "ownership")).text == "value" and extern0.text == "extern \"c\" fn c_buffer_weighted_sum(c_bytes: str, c_bytes_len: int, c_weight: int) -> int" and wrapper0.text == exp_wrap0 and cs_has_substr(generated.text, "verify(") == 0 and cs_has_substr(generated.text, "ensures") == 0 then 1 else 0 in if valid == 1 and generated.ok == 1 then fs_write_sync(output, generated.text + "\n") else 0

fn cj_invalid(result) = let generated = cj_text(result, "generated_lume") in let diagnostics = cj_between(result, "\"diagnostics\":[", "],\"adapters\":") in cs_startswith(result, "{\"ok\":false") == 1 and generated.text == "" and diagnostics.ok == 1 and diagnostics.text != "" and cj_diagnostics_valid(cj_objects(diagnostics.text)) == 1

fn cj_callback(result) = let generated = cj_text(result, "generated_lume") in let diagnostics = cj_between(result, "\"diagnostics\":[", "],\"adapters\":") in cs_startswith(result, "{\"ok\":false") == 1 and generated.text == "" and diagnostics.ok == 1 and cj_callback_diagnostic(cj_objects(diagnostics.text)) == 1

fn cj_len(xs) = match xs
    Nil => 0
    Cons(h, t) => 1 + cj_len(t)

fn cj_array_count(raw) = if raw == "" then 0 else 1 + cj_count_marker(raw, "\",\"")

fn cj_array_contains(raw, expected) = if raw == "" then 0 else let item = cj_first_string(raw) in let finish = cj_string_end(raw, 1) in if item.text == expected then 1 else if finish + 2 >= count(raw) then 0 else cj_array_contains(slice(raw, finish + 2, count(raw)), expected)

fn cj_message_containing(raws, keyword) = match raws
    Nil => 0
    Cons(h, t) => if cs_has_substr((cj_text(h, "message")).text, keyword) == 1 then 1 else cj_message_containing(t, keyword)

fn cj_asthead(xs) = match xs
    Nil => ""
    Cons(h, t) => h

fn cj_stage0(good, bad, empty, output) = let generated = cj_text(good, "generated_lume") in let good_diagnostics = cj_between(good, "\"diagnostics\":[", "],\"adapters\":") in let good_externs = cj_between(good, "\"extern_decls\":[", "],\"foreign_wrappers\":") in let good_wrappers = cj_between(good, "\"foreign_wrappers\":[", "],\"generated_lume\":") in let bad_generated = cj_text(bad, "generated_lume") in let bad_diagnostics = cj_between(bad, "\"diagnostics\":[", "],\"adapters\":") in let bad_externs = cj_between(bad, "\"extern_decls\":[", "],\"foreign_wrappers\":") in let bad_wrappers = cj_between(bad, "\"foreign_wrappers\":[", "],\"generated_lume\":") in let empty_generated = cj_text(empty, "generated_lume") in let empty_diagnostics = cj_between(empty, "\"diagnostics\":[", "],\"adapters\":") in let bad_diags = cj_objects(bad_diagnostics.text) in let empty_diags = cj_objects(empty_diagnostics.text) in let exp_db_wrap = "pub fn foreign_db_open(c_filename: str, c_flags: int) -> unverified[int] / {" + "ffi} = db_open(c_filename, c_flags)" in let valid = if cs_startswith(good, "{\"ok\":true") == 1 and (cj_text(good, "adapter_contract")).text == "c_abi_foreign_v2" and (cj_text(good, "ownership")).text == "borrowed_const_cstr_and_sized_read_only_buffers" and (cj_text(good, "return_provenance")).text == "unverified" and good_diagnostics.ok == 1 and good_diagnostics.text == "" and cj_array_count(good_externs.text) == 2 and cj_array_count(good_wrappers.text) == 2 and cj_array_contains(good_externs.text, "extern \"c\" fn db_open(c_filename: str, c_flags: int) -> int") == 1 and cj_array_contains(good_wrappers.text, exp_db_wrap) == 1 and cs_has_substr(generated.text, "verify(") == 0 and cs_has_substr(generated.text, "ensures") == 0 and cs_has_substr(generated.text, "safe_") == 0 and cs_startswith(bad, "{\"ok\":false") == 1 and bad_generated.text == "" and cj_array_count(bad_externs.text) == 1 and cj_array_count(bad_wrappers.text) == 1 and cj_len(bad_diags) == 11 and cj_diagnostics_valid(bad_diags) == 1 and cj_message_containing(bad_diags, "callback") == 1 and cj_message_containing(bad_diags, "ownership") == 1 and cs_startswith(empty, "{\"ok\":false") == 1 and empty_generated.text == "" and cj_len(empty_diags) == 1 then 1 else 0 in if valid == 1 and generated.ok == 1 and (cj_text(cj_asthead(empty_diags), "code")).text == "I0003" then fs_write_sync(output, generated.text + "\n") else 0

fn cj_at_line(xs, idx) = match xs
    Nil => ""
    Cons(h, t) => if idx == 0 then cs_chomp(h) else cj_at_line(t, idx - 1)

fn cj_value(line, prefix) = if cs_startswith(line, prefix) == 1 then slice(line, count(prefix), count(line)) else ""

fn cj_request(input) = let ls = lc_split_lines(input, 0, count(input)) in {mode: cj_value(cj_at_line(ls, 0), "@mode "), path: cj_value(cj_at_line(ls, 1), "@path "), header: cj_value(cj_at_line(ls, 2), "@header "), output: cj_value(cj_at_line(ls, 3), "@output "), generated: cj_value(cj_at_line(ls, 4), "@generated ")}

fn cj_dispatch(input) = let req = cj_request(input) in let result = fs_read_file(req.path) in let ok = if req.mode == "manifest" then cj_manifest(result, fs_read_file(req.header), req.output) else if req.mode == "invalid" then cj_invalid(result) else if req.mode == "callback" then cj_callback(result) else if req.mode == "stage0" then cj_stage0(result, fs_read_file(req.header), fs_read_file(req.output), req.generated) else 0 in if ok == 1 then "{\"ok\":true}" else ctfail("C adapter assertion failed: " + req.mode)

print cj_dispatch(readall())
