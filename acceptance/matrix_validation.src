use acceptance_json

fn am_reference_valid(ref, kind, path, seen) = let key_error = am_check_keys(ref, Cons("number", Cons("expected_state", Nil)), path) in if key_error != "" then key_error else let number = am_get(ref, "number") in let state = am_get(ref, "expected_state") in if number.kind != "number" or number.num <= 0 then path + ": " + kind + " number must be a positive integer" else if am_string_in(seen, str(number.num)) == 1 then path + ": duplicate " + kind + " reference #" + str(number.num) else if state.kind != "string" or (if kind == "issue" then am_issue_state_valid(state.text) else am_pr_state_valid(state.text)) == 0 then path + ": invalid expected " + kind + " state" else ""
fn am_reference_number_seen(refs, number) = match refs
    Nil => 0
    Cons(h, t) => if am_get(h, "number").num == number then 1 else am_reference_number_seen(t, number)
fn am_references(value, kind, path) = if value.kind != "array" or cs_isnil(value.items) == 1 then path + ": must contain at least one " + kind + " reference" else am_references_loop(value.items, kind, path, Nil)
fn am_references_loop(refs, kind, path, seen) = match refs
    Nil => ""
    Cons(h, t) => let number = am_get(h, "number").num in let error = am_reference_valid(h, kind, path, seen) in if error != "" then error else am_references_loop(t, kind, path, Cons(str(number), seen))

fn am_sources(values, root, path) = if values.kind != "array" or cs_isnil(values.items) == 1 then path + ": must contain at least one source artifact" else am_artifacts(values.items, root, path)
fn am_artifacts(values, root, path) = match values
    Nil => ""
    Cons(h, t) => let error = am_artifact(h, root, path) in if error != "" then error else am_artifacts(t, root, path)
fn am_evidence(item, root, path, seen) = let key_error = am_check_keys(item, Cons("id", Cons("command", Cons("artifacts", Cons("expected", Nil)))), path) in if key_error != "" then key_error else let id = am_get(item, "id") in let command = am_get(item, "command") in let expected = am_get(item, "expected") in let artifacts = am_get(item, "artifacts") in if am_nonempty(id) == 0 then path + ".id: must be a non-empty string" else if am_string_in(seen, id.text) == 1 then path + ".id: duplicate evidence ID in claim" else if am_nonempty(command) == 0 then path + ".command: runnable evidence requires a command" else if am_nonempty(expected) == 0 then path + ".expected: must describe the expected observation" else if artifacts.kind != "array" or cs_isnil(artifacts.items) == 1 then path + ".artifacts: must contain test/evidence artifacts" else am_artifacts(artifacts.items, root, path + ".artifacts")
fn am_evidence_list(value, result, root, path) = if value.kind != "array" then path + ": must be an array" else if (result == "PASS" or result == "FAIL") and cs_isnil(value.items) == 1 then path + ": " + result + " requires at least one runnable evidence entry" else am_evidence_loop(value.items, root, path, Nil)
fn am_evidence_loop(items, root, path, seen) = match items
    Nil => ""
    Cons(h, t) => let id = am_get(h, "id").text in let error = am_evidence(h, root, path, seen) in if error != "" then error else am_evidence_loop(t, root, path, Cons(id, seen))

fn am_claim(claim, scope_issue, root, seen) = let key_error = am_check_keys(claim, Cons("id", Cons("claim", Cons("implementation_state", Cons("result", Cons("issues", Cons("pull_requests", Cons("source", Cons("evidence", Cons("notes", Nil))))))))), "claim") in if key_error != "" then key_error else let id = am_get(claim, "id") in let text = am_get(claim, "claim") in let state = am_get(claim, "implementation_state") in let result = am_get(claim, "result") in let issues = am_get(claim, "issues") in let pulls = am_get(claim, "pull_requests") in let sources = am_get(claim, "source") in let evidence = am_get(claim, "evidence") in let notes = am_get(claim, "notes") in if am_nonempty(id) == 0 or count(id.text) < 4 or at(id.text, 0) != "L" or at(id.text, 1) != "." or am_claim_id_valid(id.text, 2, 1) == 0 then "claim.id: invalid stable Track L claim ID" else if am_string_in(seen, id.text) == 1 then "claim.id: duplicate claim ID " + id.text else if am_nonempty(text) == 0 then "claim " + id.text + ".claim: must be a non-empty string" else if am_nonempty(notes) == 0 then "claim " + id.text + ".notes: must be a non-empty string" else if state.kind != "string" or am_state_valid(state.text) == 0 then "claim " + id.text + ".implementation_state: invalid state" else if result.kind != "string" or am_result_valid(result.text) == 0 then "claim " + id.text + ".result: expected PASS, FAIL, or UNKNOWN" else let issue_error = am_references(issues, "issue", "claim " + id.text + ".issues") in if issue_error != "" then issue_error else if am_reference_number_seen(issues.items, scope_issue) == 0 then "claim " + id.text + ".issues: missing scope issue #" + str(scope_issue) else let pull_error = am_references(pulls, "pull request", "claim " + id.text + ".pull_requests") in if pull_error != "" then pull_error else let source_error = am_sources(sources, root, "claim " + id.text + ".source") in if source_error != "" then source_error else am_evidence_list(evidence, result.text, root, "claim " + id.text + ".evidence")
fn am_claims(claims, scope_issue, root, seen) = match claims
    Nil => ""
    Cons(h, t) => let id = am_get(h, "id").text in let error = am_claim(h, scope_issue, root, seen) in if error != "" then error else am_claims(t, scope_issue, root, Cons(id, seen))
fn am_scope(scope, root) = let key_error = am_check_keys(scope, Cons("track", Cons("issue", Cons("source", Cons("boundary", Nil)))), "matrix.scope") in if key_error != "" then key_error else let track = am_get(scope, "track") in let issue = am_get(scope, "issue") in let source = am_get(scope, "source") in let boundary = am_get(scope, "boundary") in if track.kind != "string" or track.text != "L" then "matrix.scope.track: this schema slice requires Track L" else if issue.kind != "number" then "matrix.scope.issue: must be an integer" else if am_nonempty(source) == 0 then "matrix.scope.source: must be a non-empty string" else if am_nonempty(boundary) == 0 then "matrix.scope.boundary: must be a non-empty string" else am_artifact(source, root, "matrix.scope.source")
fn am_validate(matrix, root) = let key_error = am_check_keys(matrix, Cons("schema", Cons("repository", Cons("scope", Cons("claims", Nil)))), "matrix") in if key_error != "" then key_error else let schema = am_get(matrix, "schema") in let repository = am_get(matrix, "repository") in let scope = am_get(matrix, "scope") in let claims = am_get(matrix, "claims") in if schema.kind != "string" or schema.text != "lume-acceptance-matrix/0.1" then "matrix.schema: expected lume-acceptance-matrix/0.1" else if repository.kind != "string" or am_repository_valid(repository.text, 0, 0) == 0 then "matrix.repository: expected owner/repository" else let scope_error = am_scope(scope, root) in if scope_error != "" then scope_error else if claims.kind != "array" or cs_isnil(claims.items) == 1 then "matrix.claims: must be a non-empty array" else am_claims(claims.items, am_get(scope, "issue").num, root, Nil)

fn am_fixture(root, name, expected) = let parsed = am_parse(fs_read_file(root + "/tests/acceptance_matrix/" + name)) in let error = if parsed.ok == 0 then parsed.text else am_validate(parsed, root) in if error == "" then name + ": invalid fixture silently passed" else if cs_has_substr(error, expected) == 0 then name + ": expected error containing '" + expected + "', got " + error else ""
fn am_self_test(root) = let a = am_fixture(root, "invalid_missing_artifact.json", "artifact does not exist") in let b = am_fixture(root, "invalid_missing_evidence.json", "PASS requires at least one runnable evidence entry") in let c = am_fixture(root, "invalid_issue_reference.json", "issue number must be a positive integer") in let d = am_fixture(root, "invalid_pr_reference.json", "pull request number must be a positive integer") in let e = am_fixture(root, "invalid_result.json", "expected PASS, FAIL, or UNKNOWN") in am_first(a, am_first(b, am_first(c, am_first(d, e))))
