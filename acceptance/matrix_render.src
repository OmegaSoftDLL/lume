use acceptance_json

fn am_md(text, i) = if i >= count(text) then "" else let c = at(text, i) in let rendered = if c == "|" then "\\|" else if c == "\n" or c == "\r" then " " else c in rendered + am_md(text, i + 1)
fn am_path_list(items) = match items
    Nil => ""
    Cons(h, t) => "`" + h.text + "`" + (if cs_isnil(t) == 1 then "" else ", " + am_path_list(t))
fn am_evidence_id_list(items) = match items
    Nil => "none"
    Cons(h, t) => "`" + am_md(am_get(h, "id").text, 0) + "`" + (if cs_isnil(t) == 1 then "" else ", " + am_evidence_id_list(t))
fn am_issue_link_list(repository, items) = match items
    Nil => ""
    Cons(h, t) => let n = str(am_get(h, "number").num) in "[#" + n + "](https://github.com/" + repository + "/issues/" + n + ")" + (if cs_isnil(t) == 1 then "" else ", " + am_issue_link_list(repository, t))
fn am_pr_link_list(repository, items) = match items
    Nil => ""
    Cons(h, t) => let n = str(am_get(h, "number").num) in "[#" + n + "](https://github.com/" + repository + "/pull/" + n + ")" + (if cs_isnil(t) == 1 then "" else ", " + am_pr_link_list(repository, t))
fn am_result_count(claims, result) = match claims
    Nil => 0
    Cons(h, t) => (if am_get(h, "result").text == result then 1 else 0) + am_result_count(t, result)
fn am_claim_row(repository, claim) = "| `" + am_get(claim, "id").text + "` | " + am_get(claim, "implementation_state").text + " | **" + am_get(claim, "result").text + "** | " + am_md(am_get(claim, "claim").text, 0) + " | " + am_evidence_id_list(am_get(claim, "evidence").items) + " | " + am_issue_link_list(repository, am_get(claim, "issues").items) + "; " + am_pr_link_list(repository, am_get(claim, "pull_requests").items) + " |"
fn am_claim_rows(repository, claims) = match claims
    Nil => Nil
    Cons(h, t) => Cons(am_claim_row(repository, h), am_claim_rows(repository, t))
fn am_evidence_detail(item) = Cons("Evidence `" + am_get(item, "id").text + "`:", Cons("", Cons("```sh", Cons(am_get(item, "command").text, Cons("```", Cons("", Cons("Expected: " + am_md(am_get(item, "expected").text, 0), Cons("", Cons("Artifacts: " + am_path_list(am_get(item, "artifacts").items) + ".", Cons("", Nil))))))))))
fn am_evidence_details(items) = match items
    Nil => Nil
    Cons(h, t) => cs_app(am_evidence_detail(h), am_evidence_details(t))
fn am_claim_detail(claim) = let evidence = am_get(claim, "evidence").items in cs_app(Cons("### `" + am_get(claim, "id").text + "`", Cons("", Cons("Source: " + am_path_list(am_get(claim, "source").items) + ".", Cons("", Nil)))), cs_app(if cs_isnil(evidence) == 1 then Cons("Evidence: **UNKNOWN — no sufficient runnable acceptance evidence is registered.**", Cons("", Nil)) else am_evidence_details(evidence), Cons("Boundary: " + am_md(am_get(claim, "notes").text, 0), Cons("", Nil))))
fn am_claim_details(claims) = match claims
    Nil => Nil
    Cons(h, t) => cs_app(am_claim_detail(h), am_claim_details(t))
fn am_render_intro(matrix) = let scope = am_get(matrix, "scope") in Cons("# Track L acceptance matrix", Cons("", Cons("<!-- Generated by acceptance/matrix_assertions.src; edit acceptance/matrix.json instead. -->", Cons("", Cons("Schema: `" + am_get(matrix, "schema").text + "`. Source: [`" + am_get(scope, "source").text + "`](../" + am_get(scope, "source").text + ").", Cons("", Cons(am_md(am_get(scope, "boundary").text, 0), Cons("", Nil))))))))

fn am_render_semantics() = Cons("## Result semantics", Cons("", Cons("- **PASS**: the cited runnable evidence supports the exact, narrowly scoped claim.", Cons("- **FAIL**: cited runnable evidence contradicts the claim.", Cons("- **UNKNOWN**: evidence is missing, insufficient, not independently checked where required, or not established for the current revision.", Cons("- Implementation state (`shipped`, `partial`, `model`, or `planned`) is separate from evidence result.", Cons("", Nil)))))))

fn am_render_counts(claims) = Cons("Current declared results: **" + str(am_result_count(claims, "PASS")) + " PASS**, **" + str(am_result_count(claims, "FAIL")) + " FAIL**, **" + str(am_result_count(claims, "UNKNOWN")) + " UNKNOWN**. These counts are not a maturity score.", Cons("", Cons("| Claim ID | Implementation | Result | Scoped claim | Evidence | Tracking |", Cons("|---|---|---|---|---|---|", Nil))))

fn am_consumer_lines() = Cons("## Consumer commands", Cons("", Cons("```sh", Cons("./lume build acceptance/matrix_assertions.src -o build/bin/acceptance_matrix", Cons("printf '@mode local\\n@root %s\\n' \"$PWD\" | build/bin/acceptance_matrix", Cons("printf '@mode online\\n@root %s\\n' \"$PWD\" | build/bin/acceptance_matrix", Cons("```", Cons("", Cons("The local command validates artifacts and negative fixtures and checks this generated view. The online command additionally verifies issue/PR existence and expected state through the GitHub API. Runnable evidence commands are executed by the existing project test jobs; this validator does not treat a declared command as an executed result.", Cons("", Nil))))))))))

fn am_render(matrix) = let repository = am_get(matrix, "repository").text in let claims = am_get(matrix, "claims").items in let lines = cs_app(am_render_intro(matrix), cs_app(am_render_semantics(), cs_app(am_render_counts(claims), cs_app(am_claim_rows(repository, claims), cs_app(Cons("", Cons("## Sources, evidence, and boundaries", Cons("", Nil))), cs_app(am_claim_details(claims), am_consumer_lines())))))) in cs_joinsep(lines, "\n") + "\n"
