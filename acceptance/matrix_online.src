use acceptance_json

fn am_curl_args(url, token) = if token == "" then Cons("-fsSL", Cons(url, Nil)) else Cons("-fsSL", Cons("-H", Cons("Authorization: Bearer " + token, Cons(url, Nil))))
fn am_online_ref(root, repository, kind, ref, token) = let made = fs_mkdir(root + "/build") in let number = am_get(ref, "number").num in let expected = am_get(ref, "expected_state").text in let out = root + "/build/acceptance-" + kind + "-" + str(number) + ".stdout" in let err = root + "/build/acceptance-" + kind + "-" + str(number) + ".stderr" in let endpoint = "repos/" + repository + "/" + kind + "/" + str(number) in let raw = os_run_capture_timeout("/usr/bin/curl", am_curl_args("https://api.github.com/" + endpoint, token), out, err, 30000) in if raw != 0 then kind + "/" + str(number) + ": GitHub API query failed: " + fs_read_file(err) else let payload = am_parse(fs_read_file(out)) in if payload.ok == 0 then kind + "/" + str(number) + ": invalid GitHub JSON response" else if am_get(payload, "number").num != number then kind + "/" + str(number) + ": API returned a different reference" else if kind == "issues" and am_get(payload, "pull_request").kind != "missing" then kind + "/" + str(number) + ": reference is a pull request, not an issue" else let state = am_get(payload, "state").text in let actual = if kind == "pulls" and am_get(payload, "merged_at").kind != "null" then "MERGED" else am_upper(state, 0) in if actual != expected then kind + "/" + str(number) + ": stale state, expected " + expected + ", got " + actual else ""
fn am_online_claims(root, repository, claims, token) = match claims
    Nil => ""
    Cons(h, t) => let issue_error = am_online_refs(root, repository, "issues", am_get(h, "issues").items, token) in if issue_error != "" then issue_error else let pull_error = am_online_refs(root, repository, "pulls", am_get(h, "pull_requests").items, token) in if pull_error != "" then pull_error else am_online_claims(root, repository, t, token)
fn am_online_refs(root, repository, kind, refs, token) = match refs
    Nil => ""
    Cons(h, t) => let error = am_online_ref(root, repository, kind, h, token) in if error != "" then error else am_online_refs(root, repository, kind, t, token)
fn am_online(root, matrix, token) = am_online_claims(root, am_get(matrix, "repository").text, am_get(matrix, "claims").items, token)
