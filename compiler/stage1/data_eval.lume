## data_eval.lume — evaluator for the ADT + functions language: tagged values, match, recursion.
use data_ast
use std.io

type RV = enum
    VInt(n: int)
    VStr(s: str)
    VObj(tag: str, fields: [RV])

fn rv_int(v: RV) -> int
    match v
        VInt(n)     => n
        VStr(s)     => 0
        VObj(t, fs) => 0

fn rv_is_str(v: RV) -> bool
    match v
        VStr(s) => true
        _       => false

fn rv_str(v: RV) -> str
    match v
        VStr(s)     => s
        VInt(n)     => "{n}"
        VObj(t, fs) => "<obj>"

fn rv_show(v: RV) -> str
    match v
        VInt(n)     => "{n}"
        VStr(s)     => s
        VObj(t, fs) => do
            if fs.len() == 0
                t
            else
                t + "(" + fs.map(rv_show).join(", ") + ")"

fn match_pat(p: Pat, v: RV, env: mut map[str, RV]) -> bool
    match p
        PWild       => true
        PBind(name) => do
            env[name] = v
            true
        PInt(k)     => do
            match v
                VInt(m)     => m == k
                VStr(s)     => false
                VObj(t, fs) => false
        PCons(tag, subs) => do
            match v
                VInt(m) => false
                VStr(s) => false
                VObj(vtag, fields) => do
                    if vtag != tag
                        return false
                    if fields.len() != subs.len()
                        return false
                    var ok = true
                    for i in 0..subs.len()
                        if not match_pat(subs[i], fields[i], env)
                            ok = false
                    ok

fn deval(e: DExpr, env: map[str, RV], fns: [DStmt]) -> RV
    match e
        DInt(n)       => VInt(n: n)
        DVar(name)    => env.get(name) ?? VInt(n: 0)
        DCons(tag, args) => VObj(tag: tag, fields: args.map(|a| deval(a, env, fns)))
        DCall(name, args) => do
            var result = VInt(n: 0)
            var found = false
            for f in fns
                match f
                    DFnS(fname, params, body) => do
                        if not found and fname == name
                            var env2 = {}
                            for i in 0..params.len()
                                env2[params[i]] = deval(args[i], env, fns)
                            result = deval(body, env2, fns)
                            found = true
                    DLet(n2, v2) => do
                        let _ = 0
                    DPrint(v2) => do
                        let _ = 0
            result
        DStr(sv)      => VStr(s: sv)
        DBin(op, l, r) => do
            let lv = deval(l, env, fns)
            let rv = deval(r, env, fns)
            if op == "+" and rv_is_str(lv) and rv_is_str(rv)
                return VStr(s: rv_str(lv) + rv_str(rv))
            let a = rv_int(lv)
            let b = rv_int(rv)
            match op
                "+"  => VInt(n: a + b)
                "-"  => VInt(n: a - b)
                "*"  => VInt(n: a * b)
                "/"  => VInt(n: if b == 0 then 0 else a / b)
                "<"  => VInt(n: if a < b then 1 else 0)
                ">"  => VInt(n: if a > b then 1 else 0)
                "==" => VInt(n: if a == b then 1 else 0)
                _    => VInt(n: 0)
        DMatch(scrut, arms) => do
            let v = deval(scrut, env, fns)
            var result = VInt(n: 0)
            var done = false
            for arm in arms
                if not done
                    var local = env
                    if match_pat(arm.pat, v, local)
                        result = deval(arm.body, local, fns)
                        done = true
            result

fn run_data(prog: [DStmt])
    var fns = []
    for s in prog
        match s
            DFnS(n, p, b) => do
                fns.push(s)
            DLet(n, v) => do
                let _ = 0
            DPrint(v) => do
                let _ = 0
    var env = {}
    for s in prog
        match s
            DLet(name, v) => do
                env[name] = deval(v, env, fns)
            DPrint(v) => do
                io.println(rv_show(deval(v, env, fns)))
            DFnS(n, p, b) => do
                let _ = 0
