## data_eval.lume — evaluator for the ADT + functions language: tagged values, match, recursion.
use data_ast
use std.io

type RV = enum
    VInt(n: int)
    VStr(s: str)
    VList(items: [RV])
    VRec(fields: map[str, RV])
    VObj(tag: str, fields: [RV])

fn rv_int(v: RV) -> int
    match v
        VInt(n)     => n
        VStr(s)     => 0
        VList(xs)   => 0
        VRec(m)     => 0
        VObj(t, fs) => 0

fn rv_is_str(v: RV) -> bool
    match v
        VStr(s) => true
        _       => false

fn rv_str(v: RV) -> str
    match v
        VStr(s)     => s
        VInt(n)     => "{n}"
        VObj(t, fs) => "<obj>"

fn rv_show(v: RV) -> str
    match v
        VInt(n)     => "{n}"
        VStr(s)     => s
        VList(xs)   => "[" + xs.map(rv_show).join(", ") + "]"
        VRec(m)     => do
            var parts = []
            for e in m.entries()
                parts.push(e[0] + ": " + rv_show(e[1]))
            "{{" + parts.join(", ") + "}}"
        VObj(t, fs) => do
            if fs.len() == 0
                t
            else
                t + "(" + fs.map(rv_show).join(", ") + ")"

fn match_pat(p: Pat, v: RV, env: mut map[str, RV]) -> bool
    match p
        PWild       => true
        PBind(name) => do
            env[name] = v
            true
        PInt(k)     => do
            match v
                VInt(m)     => m == k
                VStr(s)     => false
                VList(xs)   => false
                VRec(mm)    => false
                VObj(t, fs) => false
        PCons(tag, subs) => do
            match v
                VInt(m) => false
                VStr(s) => false
                VList(xs) => false
                VRec(mm) => false
                VObj(vtag, fields) => do
                    if vtag != tag
                        return false
                    if fields.len() != subs.len()
                        return false
                    var ok = true
                    for i in 0..subs.len()
                        if not match_pat(subs[i], fields[i], env)
                            ok = false
                    ok

## a real copy: `var b = a` aliases a map, so a let-in / match binding would leak into the outer scope
fn env_copy(env: map[str, RV]) -> map[str, RV]
    var out = {}
    for e in env.entries()
        out[e[0]] = e[1]
    out

fn entries_have(xs, key: str) -> bool
    match xs
        Nil => false
        Cons(h, t) => h[0] == key or entries_have(t, key)

fn rv_is_decimal(v: RV) -> bool
    match v
        VRec(fields) => entries_have(fields.entries(), "coefficient") and entries_have(fields.entries(), "scale")
        _ => false

fn decimal_eval_power10(n: int) -> int = if n <= 0 then 1 else 10 * decimal_eval_power10(n - 1)

fn decimal_eval_align(coefficient: int, from_scale: int, to_scale: int) -> int = if from_scale >= to_scale then coefficient else coefficient * decimal_eval_power10(to_scale - from_scale)

fn decimal_eval_bin(op: str, left: RV, right: RV) -> RV
    match left
        VRec(lf) => match right
            VRec(rf) => do
                let lc = rv_int(lf.get("coefficient") ?? VInt(n: 0))
                let ls = rv_int(lf.get("scale") ?? VInt(n: 0))
                let rc = rv_int(rf.get("coefficient") ?? VInt(n: 0))
                let rs = rv_int(rf.get("scale") ?? VInt(n: 0))
                let scale = if ls >= rs then ls else rs
                let la = decimal_eval_align(lc, ls, scale)
                let ra = decimal_eval_align(rc, rs, scale)
                if op == "+"
                    VRec(fields: {"coefficient": VInt(n: la + ra), "scale": VInt(n: scale)})
                elif op == "-"
                    VRec(fields: {"coefficient": VInt(n: la - ra), "scale": VInt(n: scale)})
                elif op == "*"
                    VRec(fields: {"coefficient": VInt(n: lc * rc), "scale": VInt(n: ls + rs)})
                elif op == "=="
                    VInt(n: if la == ra then 1 else 0)
                elif op == "!="
                    VInt(n: if la != ra then 1 else 0)
                elif op == "<"
                    VInt(n: if la < ra then 1 else 0)
                elif op == ">"
                    VInt(n: if la > ra then 1 else 0)
                elif op == "<="
                    VInt(n: if la <= ra then 1 else 0)
                elif op == ">="
                    VInt(n: if la >= ra then 1 else 0)
                else
                    VInt(n: 0)
            _ => VInt(n: 0)
        _ => VInt(n: 0)

fn deval(e: DExpr, env: map[str, RV], fns: [DStmt]) -> RV
    match e
        DInt(n)       => VInt(n: n)
        DDecimal(coefficient, scale) => do
            var fields = {}
            fields["coefficient"] = VInt(n: coefficient)
            fields["scale"] = VInt(n: scale)
            VRec(fields: fields)
        DVar(name)    => env.get(name) ?? VInt(n: 0)
        DCons(tag, args) => VObj(tag: tag, fields: args.map(|a| deval(a, env, fns)))
        DCall(name, args) => do
            var result = VInt(n: 0)
            var found = false
            for f in fns
                match f
                    DFnS(fname, params, body) => do
                        if not found and fname == name
                            ## top-level lets are visible inside functions (the "$g" snapshot)
                            var env2 = {}
                            env2["$in"] = env.get("$in") ?? VStr(s: "/dev/stdin")
                            match env.get("$g") ?? VInt(n: 0)
                                VRec(gm) => do
                                    for e in gm.entries()
                                        env2[e[0]] = e[1]
                                    env2["$g"] = VRec(fields: gm)
                                _ => do
                                    let _ = 0
                            for i in 0..params.len()
                                env2[params[i]] = deval(args[i], env, fns)
                            result = deval(body, env2, fns)
                            found = true
                    DLet(n2, v2) => do
                        let _ = 0
                    DPrint(v2) => do
                        let _ = 0
                    DExprS(v2) => do
                        let _ = 0
            if not found and name == "count"
                let cv = deval(args[0], env, fns)
                match cv
                    VList(xs) => do
                        result = VInt(n: xs.len())
                    VStr(s) => do
                        result = VInt(n: s.len())
                    _ => do
                        result = VInt(n: 0)
            if not found and name == "at"
                let asv = rv_str(deval(args[0], env, fns))
                let aix = rv_int(deval(args[1], env, fns))
                if aix >= 0 and aix < asv.len()
                    result = VStr(s: asv[aix..aix + 1])
                else
                    result = VStr(s: "")
            if not found and name == "slice"
                let ssv = rv_str(deval(args[0], env, fns))
                var sa = rv_int(deval(args[1], env, fns))
                var sb = rv_int(deval(args[2], env, fns))
                if sa < 0
                    sa = 0
                if sb > ssv.len()
                    sb = ssv.len()
                if sb < sa
                    sb = sa
                result = VStr(s: ssv[sa..sb])
            if not found and name == "slicen"
                let ssv = rv_str(deval(args[0], env, fns))
                let sln = rv_int(deval(args[1], env, fns))
                var sa = rv_int(deval(args[2], env, fns))
                var sb = rv_int(deval(args[3], env, fns))
                if sa < 0
                    sa = 0
                if sb > sln
                    sb = sln
                if sb < sa
                    sb = sa
                result = VStr(s: ssv[sa..sb])
            if not found and name == "toint"
                result = VInt(n: rv_str(deval(args[0], env, fns)).parse_int() ?? 0)
            if not found and name == "str"
                result = VStr(s: rv_str(deval(args[0], env, fns)))
            if not found and name == "read"
                ## one line of stdin (up to \n or EOF); lume0 has no stdin builtin, so this
                ## reads /dev/stdin (works for `< file`, not pipes) and only ever sees the first line
                let rin = io.read_file("/dev/stdin")
                var rk = 0
                while rk < rin.len() and rin[rk..rk + 1] != "\n"
                    rk = rk + 1
                result = VStr(s: rin[0..rk])
            if not found and name == "readall"
                let rpath = rv_str(env.get("$in") ?? VStr(s: "/dev/stdin"))
                result = VStr(s: io.read_file(rpath))
            if not found and name == "ctfail"
                panic rv_str(deval(args[0], env, fns))
            if not found and name == "nl"
                result = VStr(s: "\n")
            if not found and name == "dq"
                result = VStr(s: "\"")
            result
        DStr(sv)      => VStr(s: sv)
        DList(elems)  => VList(items: elems.map(|a| deval(a, env, fns)))
        DRec(fields)  => do
            var m = {}
            for f in fields
                m[f.name] = deval(f.value, env, fns)
            VRec(fields: m)
        DField(obj, name) => do
            let ov = deval(obj, env, fns)
            match ov
                VRec(m) => m.get(name) ?? VInt(n: 0)
                _       => VInt(n: 0)
        DIndex(coll, idx) => do
            let cv = deval(coll, env, fns)
            let iv = rv_int(deval(idx, env, fns))
            match cv
                VList(xs) => if iv >= 0 and iv < xs.len() then xs[iv] else VInt(n: 0)
                _         => VInt(n: 0)
        DBin(op, l, r) => do
            let lv = deval(l, env, fns)
            let rv = deval(r, env, fns)
            if op == "and"
                return VInt(n: if rv_int(lv) != 0 and rv_int(rv) != 0 then 1 else 0)
            if op == "or"
                return VInt(n: if rv_int(lv) != 0 or rv_int(rv) != 0 then 1 else 0)
            if op == "+" and rv_is_str(lv) and rv_is_str(rv)
                return VStr(s: rv_str(lv) + rv_str(rv))
            if rv_is_str(lv) and rv_is_str(rv)
                let sl = rv_str(lv)
                let sr = rv_str(rv)
                if op == "=="
                    return VInt(n: if sl == sr then 1 else 0)
                if op == "!="
                    return VInt(n: if sl == sr then 0 else 1)
                if op == "<"
                    return VInt(n: if sl < sr then 1 else 0)
                if op == ">"
                    return VInt(n: if sl > sr then 1 else 0)
                if op == "<="
                    return VInt(n: if sl <= sr then 1 else 0)
                if op == ">="
                    return VInt(n: if sl >= sr then 1 else 0)
            if rv_is_decimal(lv) and rv_is_decimal(rv)
                return decimal_eval_bin(op, lv, rv)
            let a = rv_int(lv)
            let b = rv_int(rv)
            match op
                "+"  => VInt(n: a + b)
                "-"  => VInt(n: a - b)
                "*"  => VInt(n: a * b)
                "/"  => VInt(n: if b == 0 then 0 else a / b)
                "%"  => VInt(n: if b == 0 then 0 else a % b)
                "<"  => VInt(n: if a < b then 1 else 0)
                ">"  => VInt(n: if a > b then 1 else 0)
                "<=" => VInt(n: if a <= b then 1 else 0)
                ">=" => VInt(n: if a >= b then 1 else 0)
                "==" => VInt(n: if a == b then 1 else 0)
                "!=" => VInt(n: if a != b then 1 else 0)
                _    => VInt(n: 0)
        DLetIn(name, value, body) => do
            var env2 = env_copy(env)
            env2[name] = deval(value, env2, fns)
            deval(body, env2, fns)
        DIf(c, a, b) => do
            if rv_int(deval(c, env, fns)) != 0
                deval(a, env, fns)
            else
                deval(b, env, fns)
        DMatch(scrut, arms) => do
            let v = deval(scrut, env, fns)
            var result = VInt(n: 0)
            var done = false
            for arm in arms
                if not done
                    var local = env_copy(env)
                    if match_pat(arm.pat, v, local)
                        result = deval(arm.body, local, fns)
                        done = true
            result

fn run_data(prog: [DStmt])
    var fns = []
    for s in prog
        match s
            DFnS(n, p, b) => do
                fns.push(s)
            DLet(n, v) => do
                let _ = 0
            DPrint(v) => do
                let _ = 0
            DExprS(v) => do
                let _ = 0
    let cargs = env.args()
    let inpath = if cargs.len() >= 2 then cargs[1] else "/dev/stdin"
    var env = {}
    env["$in"] = VStr(s: inpath)
    for s in prog
        match s
            DLet(name, v) => do
                let gv = deval(v, env, fns)
                env[name] = gv
                var gm = {}
                match env.get("$g") ?? VInt(n: 0)
                    VRec(old) => do
                        gm = old
                    _ => do
                        let _ = 0
                gm[name] = gv
                env["$g"] = VRec(fields: gm)
            DPrint(v) => do
                io.println(rv_show(deval(v, env, fns)))
            DExprS(v) => do
                let _ = deval(v, env, fns)
            DFnS(n, p, b) => do
                let _ = 0
