print (run_db_tx()).h
print (run_db_tx()).snap_v20
print (run_db_tx()).cur_v20
print (run_db_tx()).cur_v10
print (run_db_tx()).range_sum
print (run_db_tx()).plan1
print (run_db_tx()).plan2

