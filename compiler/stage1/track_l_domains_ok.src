print (run_media_pipeline()).wav_ok
print (run_media_pipeline()).sr
print (run_media_pipeline()).fir1
print (run_media_pipeline()).p1_runs
print (run_media_pipeline()).gop_ok

## --- 6. Real ML observations ---
print (value_and_grad(f_nonpoly, 3)).val
print (value_and_grad(f_nonpoly, 3)).grad
print grad(f_clamp_leaky, 2)
print grad(f_clamp_leaky, 5)
print grad(f_clamp_leaky, 0 - 2)
print grad(f_quot, 1)
print (run_wengert_and_models()).th
print (run_wengert_and_models()).sg
print (run_wengert_and_models()).ex
print (run_wengert_and_models()).gx
print (run_wengert_and_models()).gw
print (run_wengert_and_models()).st_ok
print (run_wengert_and_models()).ox_ok
print (run_wengert_and_models()).hmc_ok
