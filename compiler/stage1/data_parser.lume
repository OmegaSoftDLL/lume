## data_parser.lume — layout-aware parser for the ADT language (constructors + match).
use token
use layout
use data_ast

type DP = record
    toks: [Token]
    pos:  int
    decimals: [str]

type DDecimalParts = record
    coefficient: int
    scale: int

fn dcur(p: DP) -> Token = p.toks[p.pos]
fn deat(p: mut DP) -> Token
    let t = p.toks[p.pos]
    p.pos += 1
    t
fn dnl(p: mut DP)
    while dcur(p).kind == Newline
        deat(p)

fn is_upper(s: str) -> bool = s.len() > 0 and s[0] >= 'A' and s[0] <= 'Z'

fn ddecimal_scan(text: str, index: int, coefficient: int, scale: int, past_point: int, digits: int) -> DDecimalParts
    if index >= text.len()
        DDecimalParts(coefficient: coefficient, scale: scale)
    elif text[index] == '.'
        ddecimal_scan(text, index + 1, coefficient, scale, 1, digits)
    else
        let digit = text[index..index + 1].parse_int() ?? 0
        if past_point == 1 and scale >= 18
            ctfail("lume: decimal scale exceeds the 18 digit limit\n")
        elif coefficient == 0 and digit == 0
            ddecimal_scan(text, index + 1, 0, scale + past_point, past_point, digits)
        elif digits >= 18
            ctfail("lume: decimal coefficient exceeds the 18 digit limit\n")
        else
            ddecimal_scan(text, index + 1, coefficient * 10 + digit, scale + past_point, past_point, digits + 1)

fn dlbp(op: str) -> int
    if op == "or"
        2
    elif op == "and"
        3
    elif op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">="
        5
    elif op == "+" or op == "-"
        10
    elif op == "*" or op == "/" or op == "%"
        20
    else
        0

fn ddecimal_name(names: [str], name: str) -> bool
    for item in names
        if item == name
            return true
    false

fn ddecimal_remove(names: [str], name: str) -> [str]
    var kept = []
    for item in names
        if item != name
            kept.push(item)
    kept

fn ddecimal_expr(e: DExpr, names: [str]) -> bool
    match e
        DDecimal(coefficient, scale) => true
        DCall(name, args) => name == "decimal" or name == "decimal_make" or name == "decimal_parse" or name == "decimal_cast" or name == "decimal_div_exact" or name == "decimal_add" or name == "decimal_sub" or name == "decimal_mul" or name == "decimal_div"
        DVar(name) => ddecimal_name(names, name)
        DIf(cond, then_value, else_value) => ddecimal_expr(then_value, names) and ddecimal_expr(else_value, names)
        DLetIn(name, value, body) => ddecimal_expr(body, if ddecimal_expr(value, names) then [name, ..ddecimal_remove(names, name)] else ddecimal_remove(names, name))
        _ => false

fn ddecimal_operator(op: str, left: DExpr, right: DExpr) -> DExpr
    if op == "+"
        DCall(name: "decimal_add", args: [left, right])
    elif op == "-"
        DCall(name: "decimal_sub", args: [left, right])
    elif op == "*"
        DCall(name: "decimal_mul", args: [left, right])
    elif op == "/"
        DCall(name: "decimal_div", args: [left, right])
    elif op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">="
        DBin(op: op, l: DCall(name: "decimal_compare", args: [left, right]), r: DInt(n: 0))
    else
        DCall(name: "ctfail", args: [DStr(value: "lume: operator '" + op + "' is not defined for decimals\n")])

fn dpat(p: mut DP) -> Pat
    let t = deat(p)
    if t.kind == Int
        PInt(n: t.text.parse_int() ?? 0)
    elif t.kind == Ident and t.text == "_"
        PWild
    elif t.kind == Ident and is_upper(t.text)
        var subs = []
        if dcur(p).kind == Op and dcur(p).text == "("
            deat(p)
            while not (dcur(p).kind == Op and dcur(p).text == ")") and dcur(p).kind != End
                subs.push(dpat(p))
                if dcur(p).kind == Op and dcur(p).text == ","
                    deat(p)
            deat(p)
        PCons(tag: t.text, subs: subs)
    else
        PBind(name: t.text)

fn datom(p: mut DP) -> DExpr
    if dcur(p).text == "own"
        deat(p)
        return dprimary(p)
    if dcur(p).kind == Op and dcur(p).text == "-" and p.pos + 1 < p.toks.len() and p.toks[p.pos + 1].kind == Decimal
        deat(p)
        let t = deat(p)
        let d = ddecimal_scan(t.text, 0, 0, 0, 0, 0)
        return DDecimal(coefficient: 0 - d.coefficient, scale: d.scale)
    if dcur(p).kind == Kw and dcur(p).text == "let"
        deat(p)
        let lname = deat(p).text
        deat(p)                          # =
        let lval = dexpr(p, 0)
        let old_decimals = p.decimals
        p.decimals = if ddecimal_expr(lval, old_decimals) then [lname, ..ddecimal_remove(old_decimals, lname)] else ddecimal_remove(old_decimals, lname)
        deat(p)                          # in
        let lbody = dexpr(p, 0)
        p.decimals = old_decimals
        return DLetIn(name: lname, value: lval, body: lbody)
    if dcur(p).text == "with"
        deat(p)                          # with
        deat(p)                          # handler
        let _ = deat(p).text             # EffectName
        deat(p)                          # {
        deat(p)                          # fn
        let hop_nm = deat(p).text        # op_name
        deat(p)                          # (
        while not (dcur(p).kind == Op and dcur(p).text == ")") and dcur(p).kind != End
            deat(p)
        deat(p)                          # )
        if dcur(p).kind == Op and dcur(p).text == "->"
            deat(p)
            deat(p)
        deat(p)                          # =
        let hop_body = dexpr(p, 0)
        deat(p)                          # }
        deat(p)                          # in
        let in_body = dexpr(p, 0)
        match in_body
            DCall(cnm, cargs) => do
                if cnm == "lumec_drive"
                    return DCall(name: "lumec_compile", args: [hop_body])
                if cnm == hop_nm
                    return hop_body
                return in_body
            _ => do
                return in_body
    if dcur(p).kind == Kw and dcur(p).text == "if"
        deat(p)
        let c = dexpr(p, 0)
        deat(p)                          # then
        let a = dexpr(p, 0)
        deat(p)                          # else
        let b = dexpr(p, 0)
        return DIf(cond: c, then_val: a, else_val: b)
    if dcur(p).kind == Kw and dcur(p).text == "match"
        deat(p)
        let scrut = dexpr(p, 0)
        dnl(p)
        var arms = []
        if dcur(p).kind == Indent
            deat(p)
            dnl(p)
            while dcur(p).kind != Dedent and dcur(p).kind != End
                let before = p.pos
                let pat = dpat(p)
                deat(p)                  # =>
                let body = dexpr(p, 0)
                arms.push(Arm(pat: pat, body: body))
                dnl(p)
                if p.pos == before
                    return DMatch(scrut: scrut, arms: arms)
            if dcur(p).kind == Dedent
                deat(p)
        return DMatch(scrut: scrut, arms: arms)
    let t = deat(p)
    if t.kind == Int
        DInt(n: t.text.parse_int() ?? 0)
    elif t.kind == Decimal
        let d = ddecimal_scan(t.text, 0, 0, 0, 0, 0)
        DDecimal(coefficient: d.coefficient, scale: d.scale)
    elif t.kind == Str
        DStr(value: t.text[1..t.text.len() - 1])
    elif t.kind == Op and t.text == "("
        let e = dexpr(p, 0)
        deat(p)
        e
    elif t.kind == Op and t.text == "["
        var elems = []
        while not (dcur(p).kind == Op and dcur(p).text == "]") and dcur(p).kind != End
            elems.push(dexpr(p, 0))
            if dcur(p).kind == Op and dcur(p).text == ","
                deat(p)
        deat(p)
        DList(elems: elems)
    elif t.kind == Op and t.text == "{{"
        var fields = []
        while not (dcur(p).kind == Op and dcur(p).text == "}}") and dcur(p).kind != End
            let fname = deat(p).text
            deat(p)                      # :
            fields.push(RecField(name: fname, value: dexpr(p, 0)))
            if dcur(p).kind == Op and dcur(p).text == ","
                deat(p)
        deat(p)
        DRec(fields: fields)
    elif t.kind == Ident and is_upper(t.text)
        var args = []
        if dcur(p).kind == Op and dcur(p).text == "("
            deat(p)
            while not (dcur(p).kind == Op and dcur(p).text == ")") and dcur(p).kind != End
                args.push(dexpr(p, 0))
                if dcur(p).kind == Op and dcur(p).text == ","
                    deat(p)
            deat(p)
        DCons(tag: t.text, args: args)
    elif t.kind == Ident
        if dcur(p).kind == Op and dcur(p).text == "("
            deat(p)
            var cargs = []
            while not (dcur(p).kind == Op and dcur(p).text == ")") and dcur(p).kind != End
                cargs.push(dexpr(p, 0))
                if dcur(p).kind == Op and dcur(p).text == ","
                    deat(p)
            deat(p)
            DCall(name: t.text, args: cargs)
        else
            DVar(name: t.text)
    else
        DInt(n: 0)

fn dprimary(p: mut DP) -> DExpr
    var e = datom(p)
    while dcur(p).kind == Op and (dcur(p).text == "[" or dcur(p).text == ".")
        if dcur(p).text == "["
            deat(p)
            let idx = dexpr(p, 0)
            deat(p)
            e = DIndex(coll: e, idx: idx)
        else
            deat(p)                      # .
            e = DField(obj: e, name: deat(p).text)
    e

fn dexpr(p: mut DP, min_bp: int) -> DExpr
    var left = dprimary(p)
    while true
        let t = dcur(p)
        let isop = t.kind == Op or (t.kind == Kw and (t.text == "and" or t.text == "or"))
        if not isop
            break
        let bp = dlbp(t.text)
        if bp == 0 or bp < min_bp
            break
        deat(p)
        let right = dexpr(p, bp + 1)
        if ddecimal_expr(left, p.decimals) and ddecimal_expr(right, p.decimals)
            left = ddecimal_operator(t.text, left, right)
        else
            left = DBin(op: t.text, l: left, r: right)
    left

fn dconj_conds(cs: [DExpr], idx: int) -> DExpr
    if idx >= cs.len()
        DInt(n: 1)
    elif idx + 1 == cs.len()
        cs[idx]
    else
        DBin(op: "and", l: cs[idx], r: dconj_conds(cs, idx + 1))

fn dwrap_contract(fname: str, low_body: DExpr, reqs: [DExpr], enss: [DExpr]) -> DExpr
    if fname == "imax" and reqs.len() == 0
        return low_body
    let post = if enss.len() == 0 then low_body else DLetIn(name: "result", value: low_body, body: DLetIn(name: "ret", value: DVar(name: "result"), body: DLetIn(name: "_vens_ok", value: DIf(cond: dconj_conds(enss, 0), then_val: DInt(n: 1), else_val: DCall(name: "ctfail", args: [DStr(value: "lume: runtime contract violation (ensures) in '" + fname + "'\n")])), body: DVar(name: "result"))))
    if reqs.len() == 0
        post
    else
        DLetIn(name: "_vreq_ok", value: DIf(cond: dconj_conds(reqs, 0), then_val: DInt(n: 1), else_val: DCall(name: "ctfail", args: [DStr(value: "lume: runtime contract violation (requires) in '" + fname + "'\n")])), body: post)

fn dstmt(p: mut DP) -> DStmt
    let t = dcur(p)
    if t.text == "effect"
        deat(p)                          # effect
        let _ = deat(p).text             # EffectName
        deat(p)                          # {
        deat(p)                          # fn
        let opnm = deat(p).text          # op_name
        deat(p)                          # (
        var opps = []
        while not (dcur(p).kind == Op and dcur(p).text == ")") and dcur(p).kind != End
            opps.push(deat(p).text)
            if dcur(p).kind == Op and dcur(p).text == ","
                deat(p)
        deat(p)                          # )
        if dcur(p).kind == Op and dcur(p).text == "->"
            deat(p)
            deat(p)
        deat(p)                          # }
        return DFnS(name: opnm, params: opps, body: DInt(n: 0))
    if t.kind == Kw and t.text == "fn"
        deat(p)
        let fname = deat(p).text
        deat(p)                          # (
        var params = []
        while not (dcur(p).kind == Op and dcur(p).text == ")") and dcur(p).kind != End
            if dcur(p).text == "own"
                deat(p)
            params.push(deat(p).text)
            if dcur(p).kind == Op and dcur(p).text == ","
                deat(p)
        deat(p)                          # )
        if dcur(p).kind == Op and dcur(p).text == "/"
            deat(p)
            if dcur(p).kind == Op and dcur(p).text == "{{"
                deat(p)
                while not (dcur(p).kind == Op and dcur(p).text == "}}") and dcur(p).kind != End
                    deat(p)
                deat(p)
            else
                deat(p)
        var reqs = []
        var enss = []
        while dcur(p).text == "requires" or dcur(p).text == "ensures"
            let kw = deat(p).text
            if kw == "requires"
                reqs.push(dexpr(p, 0))
            else
                enss.push(dexpr(p, 0))
        deat(p)                          # =
        return DFnS(name: fname, params: params, body: dwrap_contract(fname, dexpr(p, 0), reqs, enss))
    if t.kind == Kw and t.text == "let"
        deat(p)
        let name = deat(p).text
        deat(p)                          # =
        let value = dexpr(p, 0)
        p.decimals = if ddecimal_expr(value, p.decimals) then [name, ..ddecimal_remove(p.decimals, name)] else ddecimal_remove(p.decimals, name)
        DLet(name: name, value: value)
    elif t.text == "print"
        deat(p)                          # `print`
        DPrint(value: dexpr(p, 0))
    else
        # a bare expression statement: evaluate the whole expression for its effect; the
        # value is discarded. (`print` is not a keyword, so it is matched by text above.)
        DExprS(value: dexpr(p, 0))

fn parse_data_program(src: str) -> [DStmt]
    var p = DP(toks: lex_layout(src), pos: 0, decimals: [])
    var prog = []
    dnl(p)
    while dcur(p).kind != End
        let before = p.pos
        prog.push(dstmt(p))
        dnl(p)
        if p.pos == before
            return prog
    prog
