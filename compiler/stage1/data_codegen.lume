## data_codegen.lume — compile the ML-core (ADT + match) language to C (library module).
## This is the transitional path: the core language (constructors, match, let-in,
## if, recursion, strings, ints) lowers to C with a tiny tagged-Value runtime, then
## cc -> native. C is only the bootstrap seed; this lowering will be ported to the
## direct machine-code backend later so the C step disappears.
##
## Supported now: DInt, DStr, DVar, DCons, DCall, DBin, DIf, DLetIn, DMatch
## (patterns PWild / PBind / PInt / PCons). Records/lists/field access are not
## lowered yet and emit a marker that fails C compilation loudly if used.
use data_ast

## --- the emitted C runtime: a dynamically tagged Value (int | str | constructor) ---
fn runtime() -> str
    let lines = [
        "#include <stdio.h>",
        "#include <stdlib.h>",
        "#include <string.h>",
        "typedef struct Value Value;",
        "struct Value {{ int tag; long long i; const char* s; const char* ctor; int argc; Value** args; int nf; const char** fnames; Value** fvals; }};",
        "static Value* mkint(long long n){{ Value* v=(Value*)calloc(1,sizeof(Value)); v->tag=0; v->i=n; return v; }}",
        "static Value* ctfail(Value* s){{ fprintf(stderr,\"%s\",s->s); exit(3); return mkint(0); }}",
        "static Value* mkstr(const char* s){{ Value* v=(Value*)calloc(1,sizeof(Value)); v->tag=1; v->s=s; return v; }}",
        "static Value* mkctor(const char* c,int n,Value** a){{ Value* v=(Value*)calloc(1,sizeof(Value)); v->tag=2; v->ctor=c; v->argc=n; if(n){{ v->args=(Value**)malloc(sizeof(Value*)*n); for(int k=0;k<n;k++) v->args[k]=a[k]; }} return v; }}",
        "static Value* mkrec(int n,const char** names,Value** vals){{ Value* v=(Value*)calloc(1,sizeof(Value)); v->tag=3; v->nf=n; if(n){{ v->fnames=(const char**)malloc(sizeof(char*)*n); v->fvals=(Value**)malloc(sizeof(Value*)*n); for(int k=0;k<n;k++){{ v->fnames[k]=names[k]; v->fvals[k]=vals[k]; }} }} return v; }}",
        "static Value* recget(Value* r,const char* nm){{ for(int k=0;k<r->nf;k++) if(strcmp(r->fnames[k],nm)==0) return r->fvals[k]; return mkint(0); }}",
        "static int truthy(Value* v){{ return v->tag==0 ? (v->i!=0) : 1; }}",
        "static Value* addv(Value* a,Value* b){{ if(a->tag==1||b->tag==1){{ const char* x=a->tag==1?a->s:\"\"; const char* y=b->tag==1?b->s:\"\"; size_t la=strlen(x),lb=strlen(y); char* r=(char*)malloc(la+lb+1); memcpy(r,x,la); memcpy(r+la,y,lb); r[la+lb]=0; return mkstr(r); }} return mkint(a->i+b->i); }}",
        "static long long eqv(Value* a,Value* b){{ if(a->tag==0&&b->tag==0) return a->i==b->i; if(a->tag==1&&b->tag==1) return strcmp(a->s,b->s)==0; if(a->tag==2&&b->tag==2) return strcmp(a->ctor,b->ctor)==0; return 0; }}",
        "static long long cmpv(Value* a,Value* b){{ if(a->tag==1&&b->tag==1){{ int r=strcmp(a->s,b->s); return r<0?-1:(r>0?1:0); }} long long x=a->i,y=b->i; return x<y?-1:(x>y?1:0); }}",
        "static Value* mklist(int n,Value** xs){{ Value* v=(Value*)calloc(1,sizeof(Value)); v->tag=4; v->argc=n; if(n){{ v->args=(Value**)malloc(sizeof(Value*)*n); for(int k=0;k<n;k++) v->args[k]=xs[k]; }} return v; }}",
        "static Value* lidx(Value* c,Value* i){{ long long k=i->i; if(c->tag==4 && k>=0 && k<c->argc) return c->args[k]; return mkint(0); }}",
        "static Value* count(Value* s){{ if(s->tag==4) return mkint(s->argc); return mkint((long long)strlen(s->s)); }}",
        "static Value* at(Value* s,Value* i){{ long long k=i->i; char* b=(char*)malloc(2); b[0]=s->s[k]; b[1]=0; return mkstr(b); }}",
        "static Value* slice(Value* s,Value* a,Value* b){{ long long i=a->i,j=b->i,L=(long long)strlen(s->s); if(i<0)i=0; if(j>L)j=L; long long n=j-i; if(n<0)n=0; char* r=(char*)malloc(n+1); memcpy(r,s->s+i,n); r[n]=0; return mkstr(r); }}",
        "static Value* toint(Value* s){{ return mkint(atoll(s->s)); }}",
        "static Value* str(Value* v){{ if(v->tag==1) return v; char* b=(char*)malloc(32); if(v->tag==0) snprintf(b,32,\"%lld\",(long long)v->i); else snprintf(b,32,\"%s\",v->ctor?v->ctor:\"?\"); return mkstr(b); }}",
        "static void printval(Value* v){{ if(v->tag==0) printf(\"%lld\\n\",(long long)v->i); else if(v->tag==1) printf(\"%s\\n\",v->s); else if(v->tag==2) printf(\"%s\\n\",v->ctor); else printf(\"<record>\\n\"); }}"
    ]
    lines.join("\n") + "\n"

## escape a core string literal for embedding in a C "..." literal
fn cesc(s: str) -> str
    var out = ""
    for ch in s.chars()
        let c = str(ch)
        if c == "\""
            out = out + "\\" + "\""
        elif c == "\\"
            out = out + "\\" + "\\"
        elif c == "\n"
            out = out + "\\" + "n"
        elif c == "\t"
            out = out + "\\" + "t"
        elif c == "\r"
            out = out + "\\" + "r"
        else
            out = out + c
    out

## binary operators over Value*
fn cbin(op: str, a: str, b: str) -> str
    if op == "+"
        "addv(" + a + ", " + b + ")"
    elif op == "-" or op == "*" or op == "/" or op == "%"
        "mkint(" + a + "->i " + op + " " + b + "->i)"
    elif op == "=="
        "mkint(eqv(" + a + ", " + b + "))"
    elif op == "!="
        "mkint(!eqv(" + a + ", " + b + "))"
    elif op == "<" or op == ">" or op == "<=" or op == ">="
        "mkint(cmpv(" + a + ", " + b + ") " + op + " 0)"
    elif op == "and"
        "mkint(truthy(" + a + ") && truthy(" + b + "))"
    elif op == "or"
        "mkint(truthy(" + a + ") || truthy(" + b + "))"
    else
        "mkint(0)"

fn decimal_expr(e: DExpr) -> bool
    match e
        DDecimal(coefficient, scale) => true
        DCall(name, args) => name == "decimal_make" or name == "decimal_parse" or name == "decimal_cast" or name == "decimal_div_exact" or name == "decimal_add" or name == "decimal_sub" or name == "decimal_mul" or name == "decimal_div"
        DIf(cond, then_value, else_value) => decimal_expr(then_value) and decimal_expr(else_value)
        DLetIn(name, value, body) => decimal_expr(body)
        _ => false

fn cdecimal_bin(op: str, left: str, right: str) -> str
    if op == "+"
        "decimal_add(" + left + ", " + right + ")"
    elif op == "-"
        "decimal_sub(" + left + ", " + right + ")"
    elif op == "*"
        "decimal_mul(" + left + ", " + right + ")"
    elif op == "/"
        "decimal_div(" + left + ", " + right + ")"
    elif op == "=="
        "mkint(decimal_compare(" + left + ", " + right + ")->i == 0)"
    elif op == "!="
        "mkint(decimal_compare(" + left + ", " + right + ")->i != 0)"
    elif op == "<"
        "mkint(decimal_compare(" + left + ", " + right + ")->i < 0)"
    elif op == ">"
        "mkint(decimal_compare(" + left + ", " + right + ")->i > 0)"
    elif op == "<="
        "mkint(decimal_compare(" + left + ", " + right + ")->i <= 0)"
    elif op == ">="
        "mkint(decimal_compare(" + left + ", " + right + ")->i >= 0)"
    else
        "mkint(0)"

## pattern -> boolean C test against the C expression `path`
fn pat_test(p: Pat, path: str) -> str
    match p
        PWild    => "1"
        PBind(nm) => "1"
        PInt(n)  => "(" + path + "->tag==0 && " + path + "->i==" + str(n) + ")"
        PCons(tag, subs) => do
            var t = "(" + path + "->tag==2 && strcmp(" + path + "->ctor, \"" + tag + "\")==0"
            var i = 0
            for sub in subs
                t = t + " && " + pat_test(sub, path + "->args[" + str(i) + "]")
                i = i + 1
            t + ")"

## pattern -> C variable bindings (each a `Value* name = path;`)
fn pat_binds(p: Pat, path: str) -> str
    match p
        PWild    => ""
        PBind(nm) => "Value* " + nm + " = " + path + "; "
        PInt(n)  => ""
        PCons(tag, subs) => do
            var b = ""
            var i = 0
            for sub in subs
                b = b + pat_binds(sub, path + "->args[" + str(i) + "]")
                i = i + 1
            b

fn cexpr(e: DExpr) -> str
    match e
        DInt(n)   => "mkint(" + str(n) + ")"
        DDecimal(coefficient, scale) => "mkrec(2, (const char*[]){{\"coefficient\", \"scale\"}}, (Value*[]){{mkint(" + str(coefficient) + "), mkint(" + str(scale) + ")}})"
        DStr(v)   => "mkstr(\"" + cesc(v) + "\")"
        DVar(nm)  => nm
        DCons(tag, args) => do
            if args.len() == 0
                "mkctor(\"" + tag + "\", 0, 0)"
            else
                "mkctor(\"" + tag + "\", " + str(args.len()) + ", (Value*[]){{" + args.map(cexpr).join(", ") + "}})"
        DCall(nm, args) => nm + "(" + args.map(cexpr).join(", ") + ")"
        DBin(op, l, r) => if decimal_expr(l) and decimal_expr(r) then cdecimal_bin(op, cexpr(l), cexpr(r)) else cbin(op, cexpr(l), cexpr(r))
        DIf(c, t, e2)  => "(truthy(" + cexpr(c) + ") ? " + cexpr(t) + " : " + cexpr(e2) + ")"
        DLetIn(nm, v, body) => "({{ Value* " + nm + " = " + cexpr(v) + "; " + cexpr(body) + "; }})"
        DMatch(scrut, arms) => cmatch(scrut, arms)
        DRec(fields) => do
            if fields.len() == 0
                "mkrec(0, 0, 0)"
            else
                let names = fields.map(|f| "\"" + f.name + "\"").join(", ")
                let vals = fields.map(|f| cexpr(f.value)).join(", ")
                "mkrec(" + str(fields.len()) + ", (const char*[]){{" + names + "}}, (Value*[]){{" + vals + "}})"
        DField(o, nm) => "recget(" + cexpr(o) + ", \"" + nm + "\")"
        DList(xs) => do
            if xs.len() == 0
                "mklist(0, 0)"
            else
                "mklist(" + str(xs.len()) + ", (Value*[]){{" + xs.map(cexpr).join(", ") + "}})"
        DIndex(c, i) => "lidx(" + cexpr(c) + ", " + cexpr(i) + ")"

fn cmatch(scrut: DExpr, arms: [Arm]) -> str
    var out = "({{ Value* _s = " + cexpr(scrut) + "; Value* _r = 0; "
    var first = true
    for arm in arms
        let test = pat_test(arm.pat, "_s")
        let binds = pat_binds(arm.pat, "_s")
        if first
            out = out + "if (" + test + ") {{ " + binds + "_r = " + cexpr(arm.body) + "; }}"
            first = false
        else
            out = out + " else if (" + test + ") {{ " + binds + "_r = " + cexpr(arm.body) + "; }}"
    out + " _r; }})"

fn cparams(ps: [str]) -> str
    if ps.len() == 0
        "void"
    else
        ps.map(|p| "Value* " + p).join(", ")

fn cgen_data(prog: [DStmt]) -> str
    var protos = ""
    var defs = ""
    var body = ""
    for s in prog
        match s
            DFnS(nm, ps, b) => do
                protos = protos + "Value* " + nm + "(" + cparams(ps) + ");\n"
                defs = defs + "Value* " + nm + "(" + cparams(ps) + ") {{\n    return " + cexpr(b) + ";\n}}\n"
            DPrint(v) => do
                body = body + "    printval(" + cexpr(v) + ");\n"
            DLet(nm, v) => do
                body = body + "    Value* " + nm + " = " + cexpr(v) + ";\n"
    runtime() + protos + defs + "int main(void) {{\n" + body + "    return 0;\n}}\n"
