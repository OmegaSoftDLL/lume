## --- type checker (F1): GRADUAL, AI-first, zero false positives ----------------------------------------------
## GRADUAL RULE (TypeScript/Zig spirit, decided and documented here): a program that declares NO `type` is
## UNCHECKED -- constructors and records stay free, exactly as before (so every existing `.src`, and lumec.src
## itself, compile byte-identically; the self-host fixpoint is untouched). The moment a program declares ANY
## `type`, it opts IN: every constructor it uses (in an expression OR a pattern) must resolve to a declared enum
## variant with the right ARITY, and every field named in a NOMINAL record literal `T{...}` must be a field of
## the declared record type `T`. This is what catches a model's typo (`Conss` for `Cons`, a wrong field name,
## a missing/extra argument) -- the AI-first win -- while never flagging a correct program. ANONYMOUS records
## `{...}` are NEVER checked (they have no declared type without inference, which is F3), so opting in to types
## does not forbid ad-hoc helper records. tcheck returns the program UNCHANGED on success and aborts via `ctfail`
## (clear message to stderr, exit 3, no asm) on the first error -- the same failure channel comptime already uses.
##
## F2 (gradual argument checking): `fn f(a: T1, b: T2) -> R = ...` annotations are optional. A call `f(args)` of an
## annotated function checks ONLY the arguments whose type is INEQUIVOCAL without inference: an integer literal is
## `int`, a string literal is `str`, a constructor of a declared enum (its UNIQUE owner) is that enum, a nominal
## record literal of a declared record is that record. A variable, a call of a function, an operator expression --
## anything not known -- is NEVER flagged (that is F3 inference). An unannotated parameter accepts anything. The
## same rule checks a function body that is a bare literal/constructor against its `-> R`. Annotations alone
## (no `type` declaration) enable argument checking but NOT the F1 constructor/record declaration checks, so a
## program that only annotates `int`/`str` never gets a false "constructor not declared".
fn tcheck(prog) = if tanydecl(prog) == 0 and tanysig(prog) == 0 then prog else tcheckforce(prog, tcollect(prog))
fn tanysig(prog) = match prog
    Nil        => 0
    Cons(h, t) => tanysig2(h, t)
fn tanysig2(h, t) = match h
    Sig(nm, ps, ts, rt)       => 1
    GSig(nm, pl, rt)          => 1
    TypeRefineS(nm, bty, pr)  => 1
    TraitDecl(tnm, ops)       => 1
    ImplDecl(tnm, tty, mths)  => 1
    _                         => tanysig(t)
fn tcheckforce(prog, tt) = tforced(tchkstmts(prog, tt), prog)
fn tforced(chk, prog) = tcoerce_program(prog, tcollects(prog))
fn tcoerce_program(prog, sigs) = match prog
    Nil => Nil
    Cons(h, t) => tcoerce_stmt(h, t, sigs)
fn tcoerce_stmt(stmt, rest, sigs) = match stmt
    Fn(nm, ps, body) => Cons(Fn(nm, ps, tcoerce_fn_body(nm, body, sigs)), tcoerce_program(rest, sigs))
    Print(v) => Cons(Print(tcoerce_expr(v, sigs)), tcoerce_program(rest, sigs))
    ExprS(v) => Cons(ExprS(tcoerce_expr(v, sigs)), tcoerce_program(rest, sigs))
    Sig(nm, ps, tys, rt) => Cons(stmt, tcoerce_program(rest, sigs))
    _ => Cons(stmt, tcoerce_program(rest, sigs))
fn tcoerce_fn_body(nm, body, sigs) = tcoerce_fn_body2(body, tsiglookup(nm, sigs), sigs)
fn tcoerce_fn_body2(body, signature, sigs) = match signature
    Nil => tcoerce_expr(body, sigs)
    Cons(sg, rest) => tcoerce_expected(body, sg.rt, sigs)
fn tcoerce_expr(e, sigs) = match e
    Bin(op, l, r) => Bin(op, tcoerce_expr(l, sigs), tcoerce_expr(r, sigs))
    If(c, t, e2) => If(tcoerce_expr(c, sigs), tcoerce_expr(t, sigs), tcoerce_expr(e2, sigs))
    LetIn(nm, v, body) => LetIn(nm, tcoerce_expr(v, sigs), tcoerce_expr(body, sigs))
    Call(nm, args) => tcoerce_call(nm, args, sigs, tsiglookup(nm, sigs))
    Rec(items) => Rec(tcoerce_entries(items, sigs))
    RecT(tn, items) => RecT(tn, tcoerce_entries(items, sigs))
    Match(sc, arms) => Match(tcoerce_expr(sc, sigs), tcoerce_arms(arms, sigs))
    CT(inner) => CT(tcoerce_expr(inner, sigs))
    LambdaE(ps, tys, rt, body) => LambdaE(ps, tys, rt, tcoerce_expr(body, sigs))
    AwaitE(inner) => AwaitE(tcoerce_expr(inner, sigs))
    ShardE(vnm, lo, hi, body) => ShardE(vnm, tcoerce_expr(lo, sigs), tcoerce_expr(hi, sigs), tcoerce_expr(body, sigs))
    _ => e
fn tcoerce_entries(items, sigs) = match items
    Nil => Nil
    Cons(h, t) => Cons({key: h.key, val: tcoerce_expr(h.val, sigs)}, tcoerce_entries(t, sigs))
fn tcoerce_arms(arms, sigs) = match arms
    Nil => Nil
    Cons(h, t) => Cons({pat: h.pat, body: tcoerce_expr(h.body, sigs)}, tcoerce_arms(t, sigs))
fn tcoerce_call(nm, args, sigs, signature) = match signature
    Nil => Call(nm, tcoerce_args_untyped(args, sigs))
    Cons(sg, rest) => tcoerce_call_result(nm, tcoerce_args(args, sg.pt, sigs), sg.rt)
fn tcoerce_call_result(nm, args, rt) = tcoerce_decimal_result(Call(nm, args), rt)
fn tcoerce_decimal_result(call, rt) = match rt
    TyDecimal(p, s) => Call("decimal", Cons(Num(p), Cons(Num(s), Cons(call, Nil))))
    _ => call
fn tcoerce_args(args, types, sigs) = match args
    Nil => Nil
    Cons(arg, rest) => tcoerce_arg(arg, rest, types, sigs)
fn tcoerce_arg(arg, rest, types, sigs) = match types
    Nil => Cons(tcoerce_expr(arg, sigs), tcoerce_args(rest, Nil, sigs))
    Cons(ty, more) => Cons(tcoerce_expected(arg, ty, sigs), tcoerce_args(rest, more, sigs))
fn tcoerce_args_untyped(args, sigs) = match args
    Nil => Nil
    Cons(arg, rest) => Cons(tcoerce_expr(arg, sigs), tcoerce_args_untyped(rest, sigs))
fn tcoerce_expected(e, ty, sigs) = match ty
    TyDecimal(p, s) => if tdecimal_literal(e) then Call("decimal", Cons(Num(p), Cons(Num(s), Cons(tcoerce_expr(e, sigs), Nil)))) else tcoerce_expr(e, sigs)
    _ => tcoerce_expr(e, sigs)
fn tdecimal_literal(e) = match e
    Rec(items) => ldec_expr(e, Nil) and ldec_value(items, "coefficient") != (0 - 999999999999999999) and ldec_value(items, "scale") != (0 - 999999999999999999)
    _ => 0
fn tanydecl(prog) = match prog
    Nil        => 0
    Cons(h, t) => tanydecl2(h, t)
fn tanydecl2(h, t) = match h
    TypeS(nm, k, items) => 1
    _                   => tanydecl(t)
## the type table {ctors, recs}: ctors is a flat list of {tag, ar} from every enum, recs a list of {rname, fields}
fn tcollect(prog) = {ctors: tcollectc(prog), recs: tcollectr(prog), sigs: tcollects(prog), gsigs: tcollectg(prog), decl: tanydecl(prog), lenv: Nil, recenv: Nil, isigs: tcollecti(prog)}
fn twith(tt, lenv, recenv) = {ctors: tt.ctors, recs: tt.recs, sigs: tt.sigs, gsigs: tt.gsigs, decl: tt.decl, lenv: lenv, recenv: recenv, isigs: tt.isigs}
fn twithlenv(tt, lenv) = twith(tt, lenv, tt.recenv)
## F3c (structural inference): a `let` bound to an ANONYMOUS record literal records its field names in `tt.recenv`,
## so a later `<var>.<field>` on that variable is checked WITHOUT any annotation -- accessing a field the record
## does not have is a compile-time error. Only a direct record literal gives a known field set (a call/unknown
## leaves the variable unchecked, so zero false positives). Checker-only, so lumec.src and the fixpoint are
## untouched. This is the first structural piece of full Hindley-Milner inference (F3c).
fn tletbind(tt, nm, v) = twith(tt, Cons({k: nm, v: tletscheme(v, tt)}, tt.lenv), trecbind(nm, v, tt))
fn tletscheme(v, tt) = match v
    LambdaE(ps, tys, rt, body) => tlambda_scheme(ps, tys, rt, body, tt.lenv)
    _                          => tnarrow(tknownl(v, tt, tt.lenv))
fn trecbind(nm, v, tt) = match v
    Rec(items) => Cons({k: nm, fields: recfields(items, tt)}, tt.recenv)
    _          => tt.recenv
fn recfields(items, tt) = match items
    Nil        => Nil
    Cons(h, t) => Cons({fname: h.key, fty: tnarrow(tknownl(h.val, tt, tt.lenv))}, recfields(t, tt))
fn tchkfieldaccess(o, nm, tt) = match o
    Var(x) => tchkfieldv(x, nm, trecenvlookup(x, tt.recenv))
    _      => 0
fn trecenvlookup(x, renv) = match renv
    Nil        => Nil
    Cons(h, t) => if h.k == x then Cons(h, Nil) else trecenvlookup(x, t)
fn tchkfieldv(x, nm, m) = match m
    Nil           => 0
    Cons(r, rest) => if tfieldname(r.fields, nm) == 1 then 1 else ctfail("lume: type error: record '" + x + "' has no field '" + nm + "'\n")
fn tfieldname(fields, nm) = match fields
    Nil        => 0
    Cons(f, t) => if f.fname == nm then 1 else tfieldname(t, nm)
## F3c field-type inference: `<var>.<field>` on a known let-bound record has the field's inferred type, so it
## flows into the argument/return checks (a record field of one type used where another is expected is caught).
fn tfieldtype(o, nm, tt) = match o
    Var(x) => tfieldtype2(nm, trecenvlookup(x, tt.recenv))
    _      => TyAny
fn tfieldtype2(nm, m) = match m
    Nil           => TyAny
    Cons(r, rest) => tfieldtylook(r.fields, nm)
fn tfieldtylook(fields, nm) = match fields
    Nil        => TyAny
    Cons(f, t) => if f.fname == nm then f.fty else tfieldtylook(t, nm)
fn tcollectg(prog) = match prog
    Nil        => Nil
    Cons(h, t) => tcollectg2(h, t)
fn tcollectg2(h, t) = match h
    GSig(nm, pl, rt) => Cons({fname: nm, params: pl, rt: rt}, tcollectg(t))
    _                => tcollectg(t)
fn tcollectrt(prog) = match prog
    Nil        => Nil
    Cons(h, t) => tcollectrt2(h, t)
fn tcollectrt2(h, t) = match h
    TypeRefineS(nm, bty, pr) => Cons({nm: nm, bty: bty}, tcollectrt(t))
    _                        => tcollectrt(t)
fn trtlookup(nm, rts) = match rts
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h.bty, Nil) else trtlookup(nm, t)
fn tstrip_refine(ty, rts) = match ty
    TyRefine(bty, pr) => tstrip_refine(bty, rts)
    TyName(n)         => tstrip_refine_nm(n, trtlookup(n, rts), rts)
    TyList(e)         => TyList(tstrip_refine(e, rts))
    TyApply(n, e)     => TyApply(n, tstrip_refine(e, rts))
    _                 => ty
fn tstrip_refine_nm(n, m, rts) = match m
    Nil          => TyName(n)
    Cons(bty, r) => tstrip_refine(bty, rts)
fn tstrip_refine_tys(tys, rts) = match tys
    Nil        => Nil
    Cons(h, t) => Cons(tstrip_refine(h, rts), tstrip_refine_tys(t, rts))
fn tstrip_self(ty, rts) = match ty
    TyName(n) => if n == "Self" then TyAny else tstrip_refine(ty, rts)
    _         => tstrip_refine(ty, rts)
fn tstrip_self_tys(tys, rts) = match tys
    Nil        => Nil
    Cons(h, t) => Cons(tstrip_self(h, rts), tstrip_self_tys(t, rts))
fn ttrait_sigs(ops, rts) = match ops
    Nil         => Nil
    Cons(op, r) => Cons({fname: op.op, pn: op.ps, pt: tstrip_self_tys(op.tys, rts), rt: tstrip_self(op.rt, rts)}, ttrait_sigs(r, rts))
fn tcollects(prog) = tcollects_rts(prog, tcollectrt(prog))
fn tcollects_rts(prog, rts) = match prog
    Nil        => Nil
    Cons(h, t) => tcollects2(h, t, rts)
fn tcollects2(h, t, rts) = match h
    Sig(nm, ps, ts, rt) => Cons({fname: nm, pn: ps, pt: tstrip_refine_tys(ts, rts), rt: tstrip_refine(rt, rts)}, tcollects_rts(t, rts))
    TraitDecl(tnm, ops) => app(ttrait_sigs(ops, rts), tcollects_rts(t, rts))
    _                   => tcollects_rts(t, rts)
fn townerize(nm, items) = match items
    Nil        => Nil
    Cons(h, t) => Cons({tag: h.tag, ar: h.ar, pty: h.pty, en: nm}, townerize(nm, t))
fn tcollectc(prog) = match prog
    Nil        => Nil
    Cons(h, t) => tcollectc2(h, t)
fn tcollectc2(h, t) = match h
    TypeS(nm, k, items) => if k == "enum" then app(townerize(nm, items), tcollectc(t)) else tcollectc(t)
    _                   => tcollectc(t)
fn tcollectr(prog) = match prog
    Nil        => Nil
    Cons(h, t) => tcollectr2(h, t)
fn tcollectr2(h, t) = match h
    TypeS(nm, k, items) => if k == "record" then Cons({rname: nm, fields: items}, tcollectr(t)) else tcollectr(t)
    _                   => tcollectr(t)
## walk every statement/expression/pattern; each node returns an int so `+` FORCES evaluation (the core is eager)
fn tchkstmts(prog, tt) = match prog
    Nil        => 0
    Cons(h, t) => tchkstmt(h, tt) + tchkstmts(t, tt)
fn tchkstmt(s0, tt) = match s0
    Fn(nm, ps, body) => tchkfn(nm, body, twithlenv(tt, tfnlenv(nm, tt)), tt)
    Print(v)         => tchke(v, tt)
    ExprS(v)         => tchke(v, tt)
    _                => 0
## F3b: check a function body with the function's parameters bound in the local type env (tt.lenv), so argument
## inference (tchkinferargs, below) can see each parameter's type. tfnlenv is that env (Nil when the fn has no sig).
fn tchkfn(nm, body, ttl, tt) = tchke(body, ttl) + tchkret(nm, body, tsiglookup(nm, tt.sigs), ttl)
fn tfnlenv(nm, tt) = tfnlenv2(tsiglookup(nm, tt.sigs))
fn tfnlenv2(m) = match m
    Nil         => Nil
    Cons(sg, r) => tparamlenv(sg)
fn tchke(e, tt) = match e
    Bin(op, a, b)   => tchke(a, tt) + tchke(b, tt)
    If(c, t, e2)    => tchke(c, tt) + tchke(t, tt) + tchke(e2, tt)
    LetIn(nm, v, b)            => tchke(v, tt) + tchke(b, tletbind(tt, nm, v))
    Call(nm, args)             => tchkquerycall(nm, args, tt) + tchkcall(nm, args, tt) + tchkeargsc(nm, args, tglookup(nm, tt.gsigs), tt) + tchkinferargs(nm, args, tt) + tchk_letpoly_call(nm, args, tt)
    Var(nm)                    => tchkvar(nm, tt)
    Rec(items)      => tchkerec(items, tt)
    RecT(tn, items) => tchkrect(tn, items, tt) + tchkerec(items, tt)
    Field(o, nm)    => tchke(o, tt) + tchkfieldaccess(o, nm, tt)
    Match(sc, arms) => tchke(sc, tt) + tchkarms(arms, tt)
    CT(inner)                  => tchke(inner, tt)
    Quote(inner)               => 0
    Splice(inner)              => tchke(inner, tt)
    LambdaE(ps, tys, rt, body) => tchke(body, tt)
    AwaitE(inner)              => tchke(inner, tt)
    ShardE(vnm, lo, hi, body)  => tchke(lo, tt) + tchke(hi, tt) + tchke(body, tt)
    _                          => 0
fn tchkeargs(xs, tt) = match xs
    Nil        => 0
    Cons(h, t) => tchke(h, tt) + tchkeargs(t, tt)
fn tchkerec(xs, tt) = match xs
    Nil        => 0
    Cons(h, t) => tchke(h.val, tt) + tchkerec(t, tt)
fn tchkarms(xs, tt) = match xs
    Nil        => 0
    Cons(h, t) => tchkpat(h.pat, tt) + tchke(h.body, tt) + tchkarms(t, tt)
fn tchkpat(p, tt) = match p
    PCons(tag, subs) => tchkctor(tag, len(subs), tt) + tchkpatl(subs, tt)
    _                => 0
fn tchkpatl(xs, tt) = match xs
    Nil        => 0
    Cons(h, t) => tchkpat(h, tt) + tchkpatl(t, tt)
## a capitalised name is a constructor use; check it is declared and its arity matches
fn tchkvar(nm, tt) = if isctor(nm) then tchkctor(nm, 0, tt) else 0
fn tchkcall(nm, args, tt) = if isctor(nm) then tchkctor(nm, len(args), tt) else tchkcallg(nm, args, tglookup(nm, tt.gsigs), tt)
## D3 compile-time row types make query column references checkable against nominal records.
fn tchkquerycall(nm, args, tt) = if nm == "query_where" then tqwhere(args, tt) else if nm == "query_order" then tqorder(args, tt) else if nm == "query_join" then tqjoin(args, tt) else if nm == "query_group" then tqgroup(args, tt) else 0
fn tqwhere(args, tt) = tqwhere2(args, tt)
fn tqwhere2(args, tt) = match args
    Cons(Var(row), Cons(table, Cons(Str(field), Cons(Str(op), Cons(value, Nil))))) => tqfield("query_where", row, field, value, op, tt)
    _ => ctfail("lume: type error: query_where expects (Row, table, column, operator, value)\n")
fn tqorder(args, tt) = match args
    Cons(Var(row), Cons(table, Cons(Str(field), Cons(Str(direction), Nil)))) => tqfield("query_order", row, field, Num(0), direction, tt)
    _ => ctfail("lume: type error: query_order expects (Row, table, column, direction)\n")
fn tqgroup(args, tt) = match args
    Cons(Var(row), Cons(Var(out), Cons(table, Cons(Str(key), Cons(Str(sum), Nil))))) => tqgroupfields(row, out, key, sum, tt)
    _ => ctfail("lume: type error: query_group expects (Row, Out, table, key, sum)\n")
fn tqjoin(args, tt) = match args
    Cons(Var(left), Cons(Var(right), Cons(Var(out), Cons(lt, Cons(rt, Cons(Str(lp), Cons(Str(rp), Cons(Str(lk), Cons(Str(rk), Nil))))))))) => tqjoinfields(left, right, out, lp, rp, lk, rk, tt)
    _ => ctfail("lume: type error: query_join expects (Left, Right, Out, left, right, prefixes, keys)\n")
fn tqfield(fnname, row, field, value, op, tt) = if tfieldhas(tqfields(row, tt), field) == 0 then ctfail("lume: type error: query on '" + row + "' has no field '" + field + "'\n") else if tqvaluecompat(tqfieldtype(row, field, tt), tknown(value, tt), op) == 1 then 1 else ctfail("lume: type error: query value for '" + field + "' has incompatible type\n")
fn tqfields(row, tt) = match trecptypelookup(row, tt.recs)
    Nil => if tt.decl == 1 then ctfail("lume: type error: query row type '" + row + "' is not a declared record\n") else Nil
    Cons(rd, rest) => rd.fields
fn tqfieldtype(row, field, tt) = tqfieldtype2(tqfields(row, tt), field)
fn tqfieldtype2(fields, field) = match fields
    Nil => TyAny
    Cons(f, rest) => if f.fname == field then f.fty else tqfieldtype2(rest, field)
fn tqvaluecompat(fieldty, valty, op) = if op == "asc" or op == "desc" then 1 else if op != "==" and op != "!=" and op != "<" and op != "<=" and op != ">" and op != ">=" then 0 else tcompat(fieldty, valty)
fn tqgroupfields(row, out, key, sum, tt) = if tfieldhas(tqfields(row, tt), key) == 0 then ctfail("lume: type error: query_group has no key field '" + key + "'\n") else if tfieldhas(tqfields(row, tt), sum) == 0 then ctfail("lume: type error: query_group has no sum field '" + sum + "'\n") else if tqfieldtype(row, sum, tt) == TyName("int") or tqisdecimal(tqfieldtype(row, sum, tt)) then tqgroupout(row, out, key, sum, tt) else ctfail("lume: type error: query_group sum field must be int or decimal\n")
fn tqgroupout(row, out, key, sum, tt) = if trecptypelookup(out, tt.recs) == Nil then ctfail("lume: type error: query_group output type '" + out + "' is not a declared record\n") else if tfieldhas(tqfields(out, tt), key) == 0 or tfieldhas(tqfields(out, tt), "count") == 0 or tfieldhas(tqfields(out, tt), "sum") == 0 then ctfail("lume: type error: query_group output requires key, count, and sum fields\n") else if tcompat(tqfieldtype(out, key, tt), tqfieldtype(row, key, tt)) == 1 and tcompat(tqfieldtype(out, "count", tt), TyName("int")) == 1 and tcompat(tqfieldtype(out, "sum", tt), tqfieldtype(row, sum, tt)) == 1 then 1 else ctfail("lume: type error: query_group output field types do not match its key/count/sum\n")
fn tqisdecimal(ty) = match ty
    TyDecimal(p, s) => 1
    _ => 0
fn tqjoinfields(left, right, out, lp, rp, lk, rk, tt) = if lp == "" or rp == "" or lp == rp then ctfail("lume: type error: query_join prefixes must be non-empty and distinct\n") else if tfieldhas(tqfields(left, tt), lk) == 0 then ctfail("lume: type error: query_join left row has no field '" + lk + "'\n") else if tfieldhas(tqfields(right, tt), rk) == 0 then ctfail("lume: type error: query_join right row has no field '" + rk + "'\n") else if tcompat(tqfieldtype(left, lk, tt), tqfieldtype(right, rk, tt)) == 0 then ctfail("lume: type error: query_join key fields have different types\n") else if trecptypelookup(out, tt.recs) == Nil then ctfail("lume: type error: query_join output type '" + out + "' is not a declared record\n") else if tqjoinoutfields(tqfields(left, tt), lp, out, tt) + tqjoinoutfields(tqfields(right, tt), rp, out, tt) == len(tqfields(out, tt)) then 1 else ctfail("lume: type error: query_join output fields must be prefix_field with matching source types\n")
fn tqjoinoutfields(fields, prefix, out, tt) = match fields
    Nil => 0
    Cons(field, rest) => if tfieldhas(tqfields(out, tt), prefix + "_" + field.fname) == 1 and tcompat(tqfieldtype(out, prefix + "_" + field.fname, tt), field.fty) == 1 then 1 + tqjoinoutfields(rest, prefix, out, tt) else 0 - 999999
## a generic function (has a GSig) is checked with the generic rule (bind type params, then check runtime args);
## everything else keeps F2's ordinary signature check.
fn tchkcallg(nm, args, g, tt) = if nm == "money_add" or nm == "money_sub" or nm == "money_cmp" then (let m = tknown_money_bin(args, tt) in 0) else tchkcallg2(nm, args, g, tt)
fn tchkcallg2(nm, args, g, tt) = match g
    Nil         => tchksig(nm, args, tsiglookup(nm, tt.sigs), tt)
    Cons(gg, r) => tchkgcall(nm, args, gg, tt)
fn isastctorar(tag) = if tag == "Nil" then 0 else if tag == "Num" or tag == "Str" or tag == "Var" then 1 else if tag == "Cons" or tag == "Call" then 2 else if tag == "Bin" or tag == "If" or tag == "LetIn" then 3 else 0 - 1
fn tchkctor(tag, ar, tt) = tchkctor2(tag, ar, tctorlookup(tag, tt.ctors), tt.decl)
fn tchkctor2(tag, ar, m, dc) = match m
    Nil        => if isastctorar(tag) == ar then 1 else if isastctorar(tag) >= 0 then ctfail("lume: type error: constructor '" + tag + "' expects " + str(isastctorar(tag)) + " argument(s) but got " + str(ar) + "\n") else if dc == 1 then ctfail("lume: type error: constructor '" + tag + "' is not declared in any enum type (add it to a `type ... = enum ...` declaration)\n") else 0
    Cons(v, r) => if v.ar == ar then 1 else ctfail("lume: type error: constructor '" + tag + "' expects " + str(v.ar) + " argument(s) but got " + str(ar) + "\n")
fn tctorlookup(tag, cs) = match cs
    Nil        => Nil
    Cons(h, t) => if h.tag == tag then Cons(h, Nil) else tctorlookup(tag, t)
## a nominal record literal T{...}: T must be a declared record type and every key must be one of its fields
fn tchkrect(tn, items, tt) = tchkrect2(tn, items, trecptypelookup(tn, tt.recs), tt.decl)
fn tchkrect2(tn, items, m, dc) = match m
    Nil        => if dc == 1 then ctfail("lume: type error: record type '" + tn + "' is not declared (declare it with `type " + tn + " = record ...`)\n") else 0
    Cons(rd, r) => tchkfields(tn, items, rd.fields)
fn trecptypelookup(tn, rs) = match rs
    Nil        => Nil
    Cons(h, t) => if h.rname == tn then Cons(h, Nil) else trecptypelookup(tn, t)
fn tchkfields(tn, items, fields) = match items
    Nil        => 0
    Cons(h, t) => tchkfield(tn, h.key, fields) + tchkfields(tn, t, fields)
fn tchkfield(tn, key, fields) = if tfieldhas(fields, key) == 1 then 1 else ctfail("lume: type error: record type '" + tn + "' has no field '" + key + "'\n")
fn tfieldhas(fields, key) = match fields
    Nil        => 0
    Cons(f, r) => if f.fname == key then 1 else tfieldhas(r, key)

## --- F2: signatures, the type an expression is KNOWN to have, and the argument/return checks ---
fn tsiglookup(nm, ss) = match ss
    Nil        => Nil
    Cons(h, t) => if h.fname == nm then Cons(h, Nil) else tsiglookup(nm, t)
fn tctorcnt(tag, cs) = match cs
    Nil        => 0
    Cons(h, t) => (if h.tag == tag then 1 else 0) + tctorcnt(tag, t)
## tknown: TyName/TyList when the type is certain WITHOUT inference, else TyAny (= unknown, never an error)
fn tknown(e, tt) = match e
    Num(n)        => TyName("int")
    Str(s)        => TyName("str")
    Var(nm)       => tknownctor(nm, tt)
    Call(nm, xs)  => tknowncall(nm, xs, tt)
    Rec(items)    => tknown_decimal_record(items)
    RecT(tn, its) => tknownrec(tn, trecptypelookup(tn, tt.recs), its, tt)
    _             => TyAny
fn tknown_cons_list(h, tt) = let eh = tknown(h, tt) in if isany(eh) == 1 then TyAny else TyList(eh)
fn tknown_money_call(xs) = match xs
    Cons(Str(ccy), rest) => if ccy != "" then TyApply("money", TyName(ccy)) else TyAny
    _ => TyAny
fn tknown_money_fx(xs) = match xs
    Cons(m, Cons(Str(ccy), rest)) => if ccy != "" then TyApply("money", TyName(ccy)) else TyAny
    _ => TyAny
fn tknown_money_bin(xs, tt) = match xs
    Cons(a, Cons(b, Nil)) => let ka = tknown(a, tt) in let kb = tknown(b, tt) in if isany(ka) == 0 and isany(kb) == 0 and tcompat(ka, kb) == 0 then ctfail("lume: type error: currency mismatch in money operation: cannot mix " + tystr(ka) + " and " + tystr(kb) + "\n") else if isany(ka) == 0 then ka else kb
    _ => TyAny
fn tknowncall(nm, xs, tt) = if nm == "decimal" then tknown_decimal_call(xs) else if nm == "decimal_cast" then tknown_decimal_cast(xs) else if nm == "money_parse" or nm == "money_make" then tknown_money_call(xs) else if nm == "money_convert_fx" then tknown_money_fx(xs) else if nm == "money_add" or nm == "money_sub" then tknown_money_bin(xs, tt) else if nm == "money_cmp" then (let m = tknown_money_bin(xs, tt) in TyName("int")) else if nm == "Cons" and len(xs) == 2 and isnil(tctorlookup("Cons", tt.ctors)) == 1 then tknown_cons_list(asthead(xs), tt) else if tqname(nm) then tknownquery(nm, xs) else tknown_call_result(nm, xs, tt)
fn tqname(nm) = nm == "query_where" or nm == "query_order" or nm == "query_join" or nm == "query_group"
fn tknownquery(nm, xs) = if nm == "query_join" then tknownqueryout(xs, 2) else if nm == "query_group" then tknownqueryout(xs, 1) else tknownqueryout(xs, 0)
fn tknownqueryout(xs, index) = match xs
    Nil => TyAny
    Cons(arg, rest) => if index <= 0 then tknownquerytypearg(arg) else tknownqueryout(rest, index - 1)
fn tknownquerytypearg(arg) = match arg
    Var(nm) => TyApply("table", TyName(nm))
    _ => TyAny
fn tknown_call_result(nm, xs, tt) = match tglookup(nm, tt.gsigs)
    Cons(g, rest) => tsubst(g.rt, tknown_gbind(xs, g.params, Nil), tpset(g.params))
    Nil => tknown_simple_result(tsiglookup(nm, tt.sigs), tknownctorcall(nm, xs, tt))
fn tknown_simple_result(signature, fallback) = match signature
    Nil => fallback
    Cons(sg, rest) => sg.rt
fn tknown_gbind(args, params, env) = match params
    Nil => env
    Cons(param, rest_params) => match args
        Nil => env
        Cons(arg, rest_args) => if param.cf == 1 then tknown_gbind(rest_args, rest_params, gbind(param.pn, arg, env)) else tknown_gbind(rest_args, rest_params, env)
fn tknown_decimal_call(xs) = match xs
    Cons(Num(p), Cons(Num(s), rest)) => TyDecimal(p, s)
    _ => TyAny
fn tknown_decimal_cast(xs) = match xs
    Cons(v, Cons(Num(p), Cons(Num(s), rest))) => TyDecimal(p, s)
    _ => TyAny
fn tknown_decimal_record(items) = if ldec_expr(Rec(items), Nil) then tknown_decimal_record2(ldec_value(items, "coefficient"), ldec_value(items, "scale")) else TyAny
fn tknown_decimal_record2(c, s) = if c == (0 - 999999999999999999) or s == (0 - 999999999999999999) then TyAny else TyDecimalLiteral(c, s)
fn ldec_value(items, key) = match items
    Nil => 0 - 999999999999999999
    Cons(h, t) => if h.key == key then ldec_num(h.val) else ldec_value(t, key)
fn ldec_num(e) = match e
    Num(n) => n
    _ => 0 - 999999999999999999
fn tknownctor(nm, tt) = if isctor(nm) then tknownctor2(tctorlookup(nm, tt.ctors), tctorcnt(nm, tt.ctors)) else TyAny
fn tknownctor2(m, n) = if n != 1 then TyAny else tknownctor3(m)
fn tknownctor3(m) = match m
    Nil        => TyAny
    Cons(v, r) => TyName(v.en)
fn tknownctorcall(nm, xs, tt) = if isctor(nm) and len(xs) == 1 and tctorcnt(nm, tt.ctors) == 1 then tknownctorcall2(tctorlookup(nm, tt.ctors), asthead(xs), tt) else tknownctor(nm, tt)
fn tknownctorcall2(m, arg, tt) = match m
    Nil        => TyAny
    Cons(v, r) => tknownctorcall3(v.en, v.pty, arg, tt)
fn tknownctorcall3(en, pty, arg, tt) = match pty
    TyName(tp) => if tisconcrete_name(tp, tt) == 0 then (let ka = tknown(arg, tt) in if isany(ka) == 1 then TyName(en) else TyApply(en, ka)) else TyName(en)
    _          => TyName(en)
fn tenumhas(n, cs) = match cs
    Nil        => 0
    Cons(h, t) => if h.en == n then 1 else tenumhas(n, t)
fn tisconcrete_name(n, tt) = if n == "int" or n == "str" then 1 else if isnil(trecptypelookup(n, tt.recs)) == 0 then 1 else if tenumhas(n, tt.ctors) == 1 then 1 else 0
fn trecval(its, fnm) = match its
    Nil        => Nil
    Cons(h, t) => if h.key == fnm then Cons(h.val, Nil) else trecval(t, fnm)
fn trecelemty2(m, tt) = match m
    Nil        => TyAny
    Cons(v, r) => tknown(v, tt)
fn trecelemty1(fty, fnm, r, its, tt) = match fty
    TyName(tp) => if tisconcrete_name(tp, tt) == 0 then trecelemty2(trecval(its, fnm), tt) else trecelemty(r, its, tt)
    _          => trecelemty(r, its, tt)
fn trecelemty(fs, its, tt) = match fs
    Nil        => TyAny
    Cons(f, r) => trecelemty1(f.fty, f.fname, r, its, tt)
fn tknownrec(tn, m, its, tt) = match m
    Nil        => TyAny
    Cons(rd, r) => let et = trecelemty(rd.fields, its, tt) in if isany(et) == 1 then TyName(tn) else TyApply(tn, et)
## --- F3a: local gradual inference ---------------------------------------------------------------------------
## `tknownl(e, tt, lenv)` is `tknown` extended with a LOCAL type environment `lenv` (variable name -> Ty, built
## from a function's annotated parameters and from `let` bindings) plus operator/`if` result types. It returns a
## CONCRETE type only when it is certain and TyAny (= unknown, never an error) otherwise, so it adds real checks
## -- a function body whose inferred type contradicts its `-> R` annotation -- with ZERO false positives. A program
## that opts into no types never reaches the checker (tcheck returns it unchanged), so the self-host fixpoint is
## untouched. `tknown(e, tt)` is preserved as `tknownl(e, tt, Nil)` so every existing caller is byte-for-byte
## unchanged. This is the first step toward full Hindley-Milner inference (F3b: unification + let-polymorphism).
fn tknownl(e, tt, lenv) = match e
    Var(nm)         => tknownlvar(nm, lenv, tt)
    Bin(op, a, b)   => tknownlbin(op, tknownl(a, tt, lenv), tknownl(b, tt, lenv))
    If(c, t, e2)    => tknownlif(tknownl(t, tt, lenv), tknownl(e2, tt, lenv))
    LetIn(nm, v, b) => tknownl(b, tt, Cons({k: nm, v: tletscheme_lenv(v, tt, lenv)}, lenv))
    Field(o, nm)    => tfieldtype(o, nm, tt)
    Call(nm, xs)    => tknownlcall(nm, xs, tt, lenv)
    _               => tknown(e, tt)
fn tletscheme_lenv(v, tt, lenv) = match v
    LambdaE(ps, tys, rt, body) => tlambda_scheme(ps, tys, rt, body, lenv)
    _                          => tnarrow(tknownl(v, tt, lenv))
fn tchk_letpoly_call(nm, xs, tt) = let r = tknownlcall(nm, xs, tt, tt.lenv) in 0
fn tknownlcall(nm, xs, tt, lenv) = if nm == "_call" then tknownl_direct_call(xs, tt, lenv) else tknownlcall_env(nm, xs, tt, lenv, tlookuplenv(nm, lenv))
fn tknownl_direct_call(xs, tt, lenv) = match xs
    Cons(LambdaE(ps, tys, rt, body), cargs) => tinst_apply_scheme("_lambda", tlambda_scheme(ps, tys, rt, body, lenv), cargs, tt, lenv)
    _                                       => TyAny
fn tknownlcall_env(nm, xs, tt, lenv, m) = match m
    Cons(sch, r) => tinst_apply_scheme(nm, sch, xs, tt, lenv)
    Nil          => tknownlcall_isig(nm, xs, tt, lenv, tilookup(nm, tt.isigs))
fn tknownlcall_isig(nm, xs, tt, lenv, m) = match m
    Cons(isg, r) => tknownlcall_isig2(nm, xs, tt, lenv, isg.rscheme)
    Nil          => tknown(Call(nm, xs), tt)
fn tknownlcall_isig2(nm, xs, tt, lenv, rsch) = match rsch
    Forall(tvs, fty) => let rt = tinst_apply_scheme(nm, rsch, xs, tt, lenv) in if isany(rt) == 0 then rt else tknown(Call(nm, xs), tt)
    _                => tknown(Call(nm, xs), tt)
fn tinst_apply_scheme(nm, sch, xs, tt, lenv) = match sch
    Forall(tvs, fty) => tinst_apply_fun(nm, fty, xs, tt, lenv)
    TyFun(pts, rty)  => tinst_apply_fun(nm, sch, xs, tt, lenv)
    _                => tknown(Call(nm, xs), tt)
fn tinst_apply_fun(nm, fty, xs, tt, lenv) = match fty
    TyFun(pts, rty) => let s = tinst_bind_args({nm: nm, tt: tt, lenv: lenv}, 1, pts, xs, Nil) in hconcrete(happly(s, rty))
    _               => TyAny
fn tinst_bind_args(ctx, i, pts, xs, subst) = match pts
    Nil          => subst
    Cons(pt, pr) => tinst_bind_args2(ctx, i, pt, pr, xs, subst)
fn tinst_bind_args2(ctx, i, pt, pr, xs, subst) = match xs
    Nil         => subst
    Cons(a, ar) => let ka = tnarrow(tknownl(a, ctx.tt, ctx.lenv)) in let s2 = tinst_unify_arg(ctx.nm, i, happly(subst, pt), ka, subst) in tinst_bind_args(ctx, i + 1, pr, ar, s2)
fn tinst_unify_arg(nm, i, pt, ka, subst) = if isany(ka) == 1 then subst else tinst_unify_arg2(nm, i, pt, ka, subst)
fn tinst_unify_arg2(nm, i, pt, ka, subst) = match pt
    TyVar(n)   => hbind(n, ka, subst)
    TyName(en) => if tisname(ka) == 1 and tcompat(pt, ka) == 0 then ctfail("lume: type error [T0500]: argument " + str(i) + " of '" + nm + "' has type " + tystr(ka) + " but expected " + tystr(pt) + "\n") else subst
    _          => subst
## F3a infers only int/str (the unambiguous, high-value subset); decimal/record/list/apply fall back to TyAny
## (unchecked, as before), so the strict decimal/record equality can never produce a NEW false positive.
## F3 nominal inference: keep int/str AND any declared NOMINAL type name (enum/record); drop decimal/list/
## table/literal, whose equality is scale/element-sensitive and coercion-prone. Nominal names compare by exact
## identity (no coercion), so inferring and checking them adds real cross-type catches with zero false positives.
fn tnarrow(ty) = match ty
    TyName(n) => ty
    _         => TyAny
fn tisname(ty) = match ty
    TyName(n) => 1
    _         => 0
fn tknownlvar(nm, lenv, tt) = match tlookuplenv(nm, lenv)
    Cons(ty, r) => ty
    Nil         => tknown(Var(nm), tt)
fn tlookuplenv(nm, lenv) = match lenv
    Nil        => Nil
    Cons(h, t) => if h.k == nm then Cons(h.v, Nil) else tlookuplenv(nm, t)
fn tisint(ty) = match ty
    TyName(n) => if n == "int" then 1 else 0
    _         => 0
fn tisstr(ty) = match ty
    TyName(n) => if n == "str" then 1 else 0
    _         => 0
fn tisarith(op) = op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
fn tiscmp(op) = op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or"
fn tknownlbin(op, ka, kb) = if op == "+" and tisstr(ka) == 1 and tisstr(kb) == 1 then TyName("str") else if tisarith(op) == 1 and tisint(ka) == 1 and tisint(kb) == 1 then TyName("int") else if tiscmp(op) == 1 then TyName("int") else TyAny
fn tknownlif(kt, ke) = if tsameconcrete(kt, ke) == 1 then tnarrow(kt) else TyAny
fn tsameconcrete(a, b) = if tystr(a) == "?" then 0 else if tystr(a) == tystr(b) then 1 else 0
fn tparamlenv(sg) = tparamlenv2(sg.pn, sg.pt)
fn tparamlenv2(pns, pts) = match pns
    Nil        => Nil
    Cons(pn, pr) => tparamlenv3(pn, pr, pts)
fn tparamlenv3(pn, pr, pts) = match pts
    Nil         => Nil
    Cons(ty, tr) => Cons({k: pn, v: tnarrow(ty)}, tparamlenv2(pr, tr))
## --- F3b: argument inference (int/str only, additive) -------------------------------------------------------
## For an ordinary call (NOT a constructor, query or generic), an argument that is a variable / operator / let /
## if whose type INFERS (via tt.lenv + operator result types) to int or str is checked against the parameter's
## type -- but ONLY when that parameter is also int or str. A decimal/record/list/table/generic parameter is
## never inspected here, so the strict decimal/record equality and the D3/query code can raise NO new error.
## This extends F2's literal-only argument check to inferred int/str arguments (the common AI type confusion),
## leaving tchkarg/tcompat and every existing path byte-for-byte unchanged.
fn tchkinferargs(nm, args, tt) = if isctor(nm) then 0 else if tqname(nm) then 0 else tchkinferargs2(nm, args, tglookup(nm, tt.gsigs), tt)
fn tchkinferargs2(nm, args, g, tt) = match g
    Cons(gg, r) => 0
    Nil         => tchkinferargs3(nm, args, tsiglookup(nm, tt.sigs), tt)
fn tchkinferargs3(nm, args, m, tt) = match m
    Nil         => tchkinferargsi(nm, args, tilookup(nm, tt.isigs), tt)
    Cons(sg, r) => tchkinferwalk(nm, 1, args, sg.pn, sg.pt, tt)
## F3c HM: a function with NO explicit signature is checked against its INFERRED parameter types (Hindley-Milner
## over the body; unresolved types are TyAny, so a polymorphic/unknown parameter is never flagged). Every argument
## (literal or not) is checked, since an inferred int/str parameter is as binding as an annotated one.
fn tchkinferargsi(nm, args, m, tt) = match m
    Nil          => 0
    Cons(isg, r) => tchkiwalk(nm, 1, args, isg.pn, isg.iptypes, tt)
fn tchkiwalk(nm, i, args, pns, pts, tt) = match args
    Nil         => 0
    Cons(a, ar) => tchkiwalk2(nm, i, a, pns, pts, tt) + tchkiwalk(nm, i + 1, ar, ptl(pns), ptl(pts), tt)
fn tchkiwalk2(nm, i, a, pns, pts, tt) = match pts
    Nil          => 0
    Cons(ty, pr) => tchkinfercmp(nm, i, phd(pns), ty, tnarrow(tknownl(a, tt, tt.lenv)))
fn tilookup(nm, isgs) = match isgs
    Nil        => Nil
    Cons(h, t) => if fnname(h.fnode) == nm then Cons(h, Nil) else tilookup(nm, t)
## --- F3c: the Hindley-Milner inference engine (unification) --------------------------------------------------
## `tcollecti` infers every function's parameter types from their use in the body. Each parameter starts as a
## fresh type variable; literals and operators (`+ - * / %` and comparisons) generate unifications; a parameter
## that unifies to int or str is reported as that type, and anything unresolved (polymorphic or simply unknown)
## concretizes to TyAny. The engine is INTERNAL: a `TyVar` never escapes `tcollecti` -- inferred parameter types
## are concretized to int/str/TyAny before any check sees them, so there are zero false positives and no other
## pass changes. This infers UNANNOTATED functions (`fn inc(x) = x + 1` => x: int), which gradual checking could
## not, and catches a mismatched call to them.
fn tcollecti(prog) = match prog
    Nil        => Nil
    Cons(h, t) => tcollecti2(h, t)
fn tcollecti2(h, t) = match h
    Fn(nm, ps, body) => Cons(tifn(h, ps, body), tcollecti(t))
    _                => tcollecti(t)
fn tifn(fnnode, ps, body) = tifn2(fnnode, ps, henv0(ps, 0), body)
fn tifn2(fnnode, ps, env, body) = tifn3(fnnode, ps, env, tinfer(body, env, Nil, len(ps)))
fn tifn3(fnnode, ps, env, ri) requires len(env) == len(ps) ensures len(result.iptypes) == len(ps) = {fnode: fnnode, pn: ps, iptypes: tiptypes(env, ri.subst), rscheme: tifn_rscheme(env, ri.subst, happly(ri.subst, ri.ty))}
fn tifn_rscheme(env, subst, rty) = match rty
    TyVar(n) => hgeneralize(Nil, subst, TyFun(henv_raw_tys(env, subst), rty))
    _        => TyAny
fn henv_raw_tys(env, subst) = match env
    Nil        => Nil
    Cons(h, t) => Cons(happly(subst, h.v), henv_raw_tys(t, subst))
fn henv0(ps, i) requires i >= 0 ensures len(result) == len(ps) = match ps
    Nil        => Nil
    Cons(p, r) => Cons({k: p, v: TyVar(i)}, henv0(r, i + 1))
fn tiptypes(env, subst) = match env
    Nil        => Nil
    Cons(h, t) => Cons(hconcrete(happly(subst, h.v)), tiptypes(t, subst))
fn hconcrete(ty) = match ty
    TyName(n) => tnarrow(ty)
    _         => TyAny
fn henv(nm, env) = match env
    Nil        => TyAny
    Cons(h, t) => if h.k == nm then h.v else henv(nm, t)
fn hlook(subst, n) = match subst
    Nil        => Nil
    Cons(b, r) => if b.tv == n then Cons(b.ty, Nil) else hlook(r, n)
fn happly(subst, ty) = match ty
    TyVar(n)       => happlyv(ty, subst, hlook(subst, n))
    TyFun(pts, rt) => TyFun(happly_list(subst, pts), happly(subst, rt))
    _              => ty
fn happly_list(subst, tys) = match tys
    Nil        => Nil
    Cons(h, t) => Cons(happly(subst, h), happly_list(subst, t))
fn happlyv(orig, subst, m) = match m
    Nil        => orig
    Cons(t, r) => happly(subst, t)
fn htv_mem(n, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == n then 1 else htv_mem(n, t)
fn htv_add(n, xs) = if htv_mem(n, xs) == 1 then xs else Cons(n, xs)
fn htv_union(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => htv_union(t, htv_add(h, ys))
fn htv_diff(xs, ys) = match xs
    Nil        => Nil
    Cons(h, t) => if htv_mem(h, ys) == 1 then htv_diff(t, ys) else Cons(h, htv_diff(t, ys))
fn hftv_ty(ty, subst) = hftv_ty2(happly(subst, ty), subst)
fn hftv_ty2(ty, subst) = match ty
    TyVar(n)       => Cons(n, Nil)
    TyFun(pts, rt) => htv_union(hftv_list(pts, subst), hftv_ty(rt, subst))
    _              => Nil
fn hftv_list(tys, subst) = match tys
    Nil        => Nil
    Cons(h, t) => htv_union(hftv_ty(h, subst), hftv_list(t, subst))
fn hftv_scheme(sch, subst) = match sch
    Forall(tvs, ty) => htv_diff(hftv_ty(ty, subst), tvs)
    _               => hftv_ty(sch, subst)
fn hftv_env(env, subst) = match env
    Nil        => Nil
    Cons(h, t) => htv_union(hftv_scheme(h.v, subst), hftv_env(t, subst))
fn hgeneralize(env, subst, ty) = let applied = happly(subst, ty) in let fty = hftv_ty(applied, Nil) in let fenv = hftv_env(env, subst) in let gtvs = htv_diff(fty, fenv) in if isnil(gtvs) == 1 then applied else Forall(gtvs, applied)
fn hinstantiate(sch, subst, fresh) = match sch
    Forall(tvs, ty) => let rm = hinst_map(tvs, fresh, Nil) in tir(hsubst_tvs(ty, rm.map), subst, rm.fresh)
    _               => tir(sch, subst, fresh)
fn hinst_map(tvs, fresh, acc) = match tvs
    Nil        => {map: acc, fresh: fresh}
    Cons(v, r) => hinst_map(r, fresh + 1, Cons({tv: v, ty: TyVar(fresh)}, acc))
fn hsubst_tvs(ty, map) = match ty
    TyVar(n)       => hsubst_tv1(ty, hlook(map, n))
    TyFun(pts, rt) => TyFun(hsubst_tvs_list(pts, map), hsubst_tvs(rt, map))
    _              => ty
fn hsubst_tv1(orig, m) = match m
    Nil        => orig
    Cons(t, r) => t
fn hsubst_tvs_list(tys, map) = match tys
    Nil        => Nil
    Cons(h, t) => Cons(hsubst_tvs(h, map), hsubst_tvs_list(t, map))
fn tlambda_scheme(ps, tys, rt, body, lenv) = let lctx = hlambda_env(ps, tys, 0, lenv) in let ri = tinfer(body, lctx.env, Nil, len(ps)) in let s2 = if tisname(rt) == 1 then hunify_strict("lambda", ri.ty, rt, ri.subst) else ri.subst in let fty = TyFun(happly_list(s2, lctx.ptvs), happly(s2, ri.ty)) in hgeneralize(lenv, s2, fty)
fn hlambda_env(ps, tys, i, base_env) = match ps
    Nil        => {env: base_env, ptvs: Nil}
    Cons(p, r) => hlambda_env2(p, r, tys, i, base_env)
fn hlambda_env2(p, r, tys, i, base_env) = match tys
    Nil         => let sub = hlambda_env(r, Nil, i + 1, base_env) in {env: Cons({k: p, v: TyVar(i)}, sub.env), ptvs: Cons(TyVar(i), sub.ptvs)}
    Cons(ty, tr) => let pty = if tisname(ty) == 1 then ty else TyVar(i) in let sub = hlambda_env(r, tr, i + 1, base_env) in {env: Cons({k: p, v: pty}, sub.env), ptvs: Cons(pty, sub.ptvs)}
fn hbind(n, ty, subst) requires n >= 0 ensures isnil(result) == 0 = Cons({tv: n, ty: ty}, subst)
fn hunify(a, b, subst) = hunify2(happly(subst, a), happly(subst, b), subst)
fn hunify2(a, b, subst) = match a
    TyVar(n)       => hunifyl(n, b, subst)
    TyFun(pa, ra)  => hunify_fun(pa, ra, b, subst)
    _              => hunifyr(a, b, subst)
fn hunifyl(n, b, subst) = match b
    TyVar(m) => if n == m then subst else hbind(n, b, subst)
    _        => hbind(n, b, subst)
fn hunifyr(a, b, subst) = match b
    TyVar(m) => hbind(m, a, subst)
    _        => subst
fn hunify_fun(pa, ra, b, subst) = match b
    TyVar(m)      => hbind(m, TyFun(pa, ra), subst)
    TyFun(pb, rb) => hunify_strict("lambda", ra, rb, hunify_strict_list("lambda", pa, pb, subst))
    _             => subst
fn hunify_strict_list(nm, xs, ys, subst) = match xs
    Nil        => subst
    Cons(x, r) => hunify_strict_list2(nm, x, r, ys, subst)
fn hunify_strict_list2(nm, x, r, ys, subst) = match ys
    Nil         => subst
    Cons(y, yr) => hunify_strict_list(nm, r, yr, hunify_strict(nm, x, y, subst))
fn hunify_strict(nm, a, b, subst) = hunify_strict2(nm, happly(subst, a), happly(subst, b), subst)
fn hunify_strict2(nm, a, b, subst) = match a
    TyVar(n)      => hunifyl(n, b, subst)
    TyFun(pa, ra) => hunify_fun(pa, ra, b, subst)
    TyName(na)    => hunify_strict_name(nm, na, a, b, subst)
    _             => hunifyr(a, b, subst)
fn hunify_strict_name(nm, na, a, b, subst) = match b
    TyVar(m)   => hbind(m, a, subst)
    TyName(nb) => if na == nb then subst else ctfail("lume: type error [T0500]: Hindley-Milner unification mismatch in '" + nm + "': cannot unify " + na + " with " + nb + "\n")
    _          => subst
fn tir(ty, subst, fresh) = {ty: ty, subst: subst, fresh: fresh}
fn tinfer(e, env, subst, fresh) = match e
    Num(n)                     => tir(TyName("int"), subst, fresh)
    Str(s)                     => tir(TyName("str"), subst, fresh)
    Var(nm)                    => hinstantiate(henv(nm, env), subst, fresh)
    Bin(op, a, b)              => tinferbin(op, a, b, env, subst, fresh)
    If(c, t, e2)               => tinferif(c, t, e2, env, subst, fresh)
    LetIn(nm, v, b)            => tinferlet(nm, v, b, env, subst, fresh)
    LambdaE(ps, tys, rt, body) => tinferlambda(ps, tys, rt, body, {env: env, subst: subst, fresh: fresh})
    Call(cnm, args)            => tinfercall(cnm, args, env, subst, fresh)
    _                          => tir(TyAny, subst, fresh)
fn tinferlambda(ps, tys, rt, body, ctx) = let lctx = hlambda_env(ps, tys, ctx.fresh, ctx.env) in let rb = tinfer(body, lctx.env, ctx.subst, ctx.fresh + len(ps)) in let s2 = if tisname(rt) == 1 then hunify_strict("lambda", rb.ty, rt, rb.subst) else rb.subst in tir(TyFun(happly_list(s2, lctx.ptvs), happly(s2, rb.ty)), s2, rb.fresh)
fn tinfercall(cnm, args, env, subst, fresh) = let fsch = henv(cnm, env) in if isany(fsch) == 1 then tinfer_args_only(args, env, subst, fresh) else let ri = hinstantiate(fsch, subst, fresh) in let ra = tinfer_arg_tys(args, env, ri.subst, ri.fresh) in let rtv = TyVar(ra.fresh) in let s2 = hunify_strict(cnm, ri.ty, TyFun(ra.tys, rtv), ra.subst) in tir(happly(s2, rtv), s2, ra.fresh + 1)
fn tinfer_args_only(args, env, subst, fresh) = match args
    Nil        => tir(TyAny, subst, fresh)
    Cons(a, r) => let ra = tinfer(a, env, subst, fresh) in tinfer_args_only(r, env, ra.subst, ra.fresh)
fn tinfer_arg_tys(args, env, subst, fresh) = match args
    Nil        => {tys: Nil, subst: subst, fresh: fresh}
    Cons(a, r) => let ra = tinfer(a, env, subst, fresh) in let rr = tinfer_arg_tys(r, env, ra.subst, ra.fresh) in {tys: Cons(ra.ty, rr.tys), subst: rr.subst, fresh: rr.fresh}
fn tinferbin(op, a, b, env, subst, fresh) = tinferbinA(op, b, env, tinfer(a, env, subst, fresh))
fn tinferbinA(op, b, env, ra) = tinferbinB(op, ra.ty, tinfer(b, env, ra.subst, ra.fresh))
fn tinferbinB(op, aty, rb) = tinferbinC(op, aty, rb.ty, rb.subst, rb.fresh)
fn tinferbinC(op, aty, bty, subst, fresh) = if op == "+" then tinferplus(aty, bty, subst, fresh) else if tisarith(op) == 1 then tir(TyName("int"), hunify(bty, TyName("int"), hunify(aty, TyName("int"), subst)), fresh) else if tiscmp(op) == 1 then tir(TyName("int"), hunify(aty, bty, subst), fresh) else tir(TyAny, subst, fresh)
fn tinferplus(aty, bty, subst, fresh) = tinferplus2(aty, bty, hunify(aty, bty, subst), fresh)
fn tinferplus2(aty, bty, subst, fresh) = tir(hplusres(happly(subst, aty), happly(subst, bty)), subst, fresh)
fn hplusres(a, b) = match a
    TyName(n) => TyName(n)
    _         => hplusresb(b)
fn hplusresb(b) = match b
    TyName(n) => TyName(n)
    _         => TyAny
fn tinferif(c, t, e2, env, subst, fresh) = tinferifA(t, e2, env, tinfer(c, env, subst, fresh))
fn tinferifA(t, e2, env, rc) = tinferifB(e2, env, rc.ty, tinfer(t, env, rc.subst, rc.fresh))
fn tinferifB(e2, env, cty, rt) = tinferifC(rt.ty, tinfer(e2, env, rt.subst, rt.fresh))
fn tinferifC(tty, re) = tir(hplusres(happly(re.subst, tty), happly(re.subst, re.ty)), hunify(tty, re.ty, re.subst), re.fresh)
fn tinferlet(nm, v, b, env, subst, fresh) = tinferletA(nm, b, env, tinfer(v, env, subst, fresh))
fn tinferletA(nm, b, env, rv) = tinfer(b, Cons({k: nm, v: hgeneralize(env, rv.subst, rv.ty)}, env), rv.subst, rv.fresh)
fn tchkinferwalk(nm, i, args, pns, pts, tt) = match args
    Nil         => 0
    Cons(a, ar) => tchkinferwalk2(nm, i, a, ar, pns, pts, tt)
fn tchkinferwalk2(nm, i, a, ar, pns, pts, tt) = match pts
    Nil          => 0
    Cons(ty, pr) => tchkinferone(nm, i, a, phd(pns), ty, tt) + tchkinferwalk(nm, i + 1, ar, ptl(pns), pr, tt)
fn tchkinferone(nm, i, a, pn, ty, tt) = if tisinferable(a) == 1 then tchkinfercmp(nm, i, pn, ty, tnarrow(tknownl(a, tt, tt.lenv))) else 0
fn tisinferable(a) = match a
    Var(x)          => 1
    Bin(op, l, r)   => 1
    If(c, t, e2)    => 1
    LetIn(x, v, b)  => 1
    Field(o, nm)    => 1
    Call(nm, xs)    => 1
    _               => 0
fn tchkinfercmp(nm, i, pn, ty, k) = if tisname(ty) == 1 and tisname(k) == 1 and tcompat(ty, k) == 0 then ctfail("lume: type error [T0500]: argument " + str(i) + " of '" + nm + "' has type " + tystr(k) + " but parameter '" + pn + "' expects " + tystr(ty) + "\n") else 0
fn tdims_str(ds) = match ds
    Nil        => ""
    Cons(d, r) => ", " + d + tdims_str(r)
fn tystr(t) = match t
    TyName(n) => n
    TyList(e) => "[" + tystr(e) + "]"
    TyApply(n, e) => n + "[" + tystr(e) + "]"
    TyTensor(e, ds) => "tensor[" + tystr(e) + tdims_str(ds) + "]"
    TyDecimal(p, s) => "decimal(" + str(p) + ", " + str(s) + ")"
    TyDecimalLiteral(c, s) => "decimal literal"
    TyRefine(bty, pr) => tystr(bty)
    TyFun(pts, rt) => "fn(...) -> " + tystr(rt)
    _         => "?"
## tcompat(expected, known): 1 unless both are known and differ
fn tcompat(ex, k) = match ex
    TyAny     => 1
    TyName(n) => tcompatn(n, k)
    TyList(e) => tcompatl(e, k)
    TyApply(n, e) => tcompatapply(n, e, k)
    TyTensor(e, ds) => tcompattensor(e, ds, k)
    TyDecimal(p, s) => tcompatdecimal(p, s, k)
fn tcompattensor(e, ds, k) = match k
    TyAny => 1
    TyTensor(e2, ds2) => 1
    _ => 0
fn tcompatn(n, k) = match k
    TyAny     => 1
    TyName(m) => if n == m then 1 else 0
    TyApply(n2, e2) => if n == n2 then 1 else if tiswrapty(n2) == 1 then tcompatn(n, e2) else 0
    TyList(e) => 0
    TyDecimal(p, s) => 0
    TyDecimalLiteral(c, s) => 0
fn tcompatl(e, k) = match k
    TyAny     => 1
    TyName(m) => 0
    TyList(e2) => tcompat(e, e2)
    TyDecimal(p, s) => 0
    TyDecimalLiteral(c, s) => 0
fn tiswrapty(n) = if n == "Ref" or n == "View" or n == "rc" or n == "arc" or n == "weak" or n == "cell" or n == "chan" or n == "unverified" then 1 else 0
fn tcompatapply(n, e, k) = match k
    TyAny => 1
    TyApply(n2, e2) => if n == n2 then tcompat(e, e2) else 0
    TyName(n2) => if n == n2 then 1 else if tiswrapty(n) == 1 then tcompat(e, k) else 0
    _ => if tiswrapty(n) == 1 then tcompat(e, k) else 0
fn tcompatdecimal(p, s, known) = match known
    TyAny => 1
    TyDecimal(p2, s2) => if p == p2 and s == s2 then 1 else 0
    TyDecimalLiteral(c, s2) => tdecimal_literal_fits(c, s2, p, s)
    _ => 0
fn tdecimal_literal_fits(c, source_scale, precision, target_scale) = if source_scale > target_scale then tdecimal_reduce_fits(c, source_scale - target_scale, precision) else if c == 0 then 1 else tdecimal_digits(c) + target_scale - source_scale <= precision
fn tdecimal_reduce_fits(c, shift, precision) = let divisor = tdecimal_pow10(shift) in if c % divisor == 0 then tdecimal_digits(c / divisor) <= precision else 0
fn tdecimal_digits(c) = count(str(if c < 0 then 0 - c else c))
fn tdecimal_pow10(n) = if n <= 0 then 1 else 10 * tdecimal_pow10(n - 1)
fn tchksig(nm, args, m, tt) = match m
    Nil        => 0
    Cons(sg, r) => tchkargs(nm, 1, args, sg.pn, sg.pt, tt)
fn phd(xs) = match xs
    Nil        => ""
    Cons(h, t) => h
fn ptl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t
fn tchkargs(nm, i, args, pns, pts, tt) = match args
    Nil        => 0
    Cons(a, rest) => tchkargs2(nm, i, a, rest, pns, pts, tt)
fn tchkargs2(nm, i, a, rest, pns, pts, tt) = match pts
    Nil        => 0
    Cons(ty, pr) => tchkarg(nm, i, phd(pns), ty, tknown(a, tt)) + tchkargs(nm, i + 1, rest, ptl(pns), pr, tt)
fn tchkarg(nm, i, pn, ty, k) = if tcompat(ty, k) == 1 then 1 else ctfail("lume: type error: argument " + str(i) + " of '" + nm + "' has type " + tystr(k) + " but parameter '" + pn + "' expects " + tystr(ty) + "\n")
fn tchkret(nm, body, m, tt) = match m
    Nil        => 0
    Cons(sg, r) => tchkret2(nm, sg.rt, tknownl(body, tt, tparamlenv(sg)))
fn tchkret2(nm, rt, k) = if tcompat(rt, k) == 1 then 1 else ctfail("lume: type error: function '" + nm + "' returns " + tystr(k) + " but is declared to return " + tystr(rt) + "\n")

## --- C3: generic argument checking (reuses F2's `tknown`/`tcompat`/`tchkarg`) -----------------------------------
## A call `id(int, "hi")` to a generic function is checked left-to-right against the GSig parameter list, threading a
## type environment `env` (type-parameter name -> the TyName it was bound to). A COMPTIME parameter (cf=1, e.g.
## `comptime T: type`) consumes its argument as a TYPE value: a bare type name `Var("int")` binds `T := int` (any
## non-name argument binds nothing, so the parameter stays unknown and nothing downstream is flagged -- zero false
## positives). A RUNTIME parameter (cf=0) is checked exactly as in F2, except its declared type is first substituted
## through `env`: `x: T` with `T := int` becomes `x: int`, so `id(int, "hi")` reports `argument 2 ... has type str but
## parameter 'x' expects int`. `tps` is the set of this function's type-parameter names, so only those names are
## substituted (and, if a type param was never bound, they resolve to TyAny = unknown, never a false error). `tsubst`
## leaves a concrete type (`int`, a declared type) untouched. Argument indices count ALL arguments as written, so the
## message's position matches the source. Superior to Zig: gradual (annotations optional), AI-first (one clear
## message), and never a false positive on an argument whose type is not inequivocally known.
fn tglookup(nm, gs) = match gs
    Nil        => Nil
    Cons(h, t) => if h.fname == nm then Cons(h, Nil) else tglookup(nm, t)
fn tchkgcall(nm, args, gg, tt) = tchkgargs(nm, 1, args, gg.params, {env: Nil, tps: tpset(gg.params), tt: tt})
fn tchkgargs(nm, i, args, ps, c) = match ps
    Nil         => 0
    Cons(p, pr) => tchkgargs2(nm, i, args, p, pr, c)
fn tchkgargs2(nm, i, args, p, pr, c) = match args
    Nil         => 0
    Cons(a, ar) => tchkgstep(nm, i, a, ar, p, pr, c)
fn tchkgstep(nm, i, a, ar, p, pr, c) = if p.cf == 1 then tchkgargs(nm, i + 1, ar, pr, {env: gbind(p.pn, a, c.env), tps: c.tps, tt: c.tt}) else tchkgrt(nm, i, a, ar, p, pr, c)
fn tchkgrt(nm, i, a, ar, p, pr, c) = tchkarg(nm, i, p.pn, tsubst(p.pt, c.env, c.tps), tknownl(a, c.tt, (c.tt).lenv)) + tchkgargs(nm, i + 1, ar, pr, c)
fn tpset(ps) = match ps
    Nil        => Nil
    Cons(p, r) => if p.cf == 1 then Cons(p.pn, tpset(r)) else tpset(r)
fn gbind(pn, a, env) = gbind2(pn, gtypeval(a), env)
fn gbind2(pn, mt, env) = match mt
    Nil         => env
    Cons(ty, r) => Cons({k: pn, v: ty}, env)
fn gtypeval(a) = match a
    Var(nm)      => Cons(TyName(nm), Nil)
    Call(nm, xs) => gtypevalcall(nm, xs)
    _            => Nil
fn gtypevalcall(nm, xs) = if nm == "_tylist_" and len(xs) == 1 then gtypevallist(gtypeval(asthead(xs))) else if count(nm) > 7 and slice(nm, 0, 7) == "_tyapp_" and len(xs) == 1 then gtypevalapp(slice(nm, 7, count(nm)), gtypeval(asthead(xs))) else Nil
fn gtypevallist(m) = match m
    Nil         => Nil
    Cons(ty, r) => Cons(TyList(ty), Nil)
fn gtypevalapp(kn, m) = match m
    Nil         => Nil
    Cons(ty, r) => Cons(TyApply(kn, ty), Nil)
fn tsubst(ty, env, tps) = match ty
    TyName(n) => tsubstn(n, env, tps)
    TyList(e) => TyList(tsubst(e, env, tps))
    TyApply(n, e) => TyApply(n, tsubst(e, env, tps))
    _         => ty
fn tsubstn(n, env, tps) = if tmem(n, tps) == 1 then tlookupty(n, env) else TyName(n)
fn tlookupty(n, env) = match env
    Nil        => TyAny
    Cons(h, t) => if h.k == n then h.v else tlookupty(n, t)
fn tmem(n, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == n then 1 else tmem(n, t)
## recursive argument check of a Call: for a generic call, skip the comptime (type-name) arguments -- they are types,
## not value expressions, so they must not go through the ordinary `tchke` (which would, for a declared-type name,
## wrongly treat it as a constructor use). For any non-generic call, check every argument as before.
fn tchkeargsc(nm, args, g, tt) = if nm == "query_where" then tchkeargs(gdrop(args, 1), tt) else if nm == "query_order" then tchkeargs(gdrop(args, 1), tt) else if nm == "query_join" then tchkeargs(gdrop(args, 3), tt) else if nm == "query_group" then tchkeargs(gdrop(args, 2), tt) else match g
    Nil         => tchkeargs(args, tt)
    Cons(gg, r) => tchkeargs(gfilterrt(args, gg.params), tt)
fn gfilterrt(args, ps) = match ps
    Nil         => args
    Cons(p, pr) => gfilterrt2(args, p, pr)
fn gfilterrt2(args, p, pr) = match args
    Nil         => Nil
    Cons(a, ar) => if p.cf == 1 then gfilterrt(ar, pr) else Cons(a, gfilterrt(ar, pr))
fn gdrop(args, n) = if n <= 0 then args else match args
    Nil => Nil
    Cons(h, t) => gdrop(t, n - 1)

