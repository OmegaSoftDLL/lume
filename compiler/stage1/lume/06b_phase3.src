## --- Phase 3 Track O & Track A (`06b_phase3.src`) ---
## Track O: ownership (`own`), borrow checker (`shared`/`mut`), regions (`from <param>`), LIFO `defer`/`errdefer`,
##          and memory tiers (`rc`/`arc`/`weak`/`cell`/arena, `@gc`, `@freestanding` + `with alloc`).
## Track A: AI-native authoring:
##   - A1: Typed holes (`_`, `_hole*`) + hole-driven candidate synthesis (`[A0001]`).
##   - A2: `total fn` termination & structural/measure recursion checker (`[A0002]`).
##   - A3: Provenance & uncertainty in the type (`unverified[T]`, `llm fn`, `prob_sample`) with contract/law/evolve
##         discharge (`verify`, `law_check`, `evolve_approve`, or branch guard) before trusted boundaries (`[A0003]`).
## Gradual & fixpoint-safe: when `oany(prog) == 0`, `ocheck(prog)` returns `prog` immediately with zero allocation.

fn omem(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else omem(x, t)

fn orem(x, xs) = match xs
    Nil        => Nil
    Cons(h, t) => if h == x then orem(x, t) else Cons(h, orem(x, t))

fn ostarts(s, p) = if count(s) < count(p) then 0 else slice(s, 0, count(p)) == p

fn ois_free(mflags) = mflags % 2
fn ois_total(mflags) = (mflags / 2) % 2
fn ois_llm(mflags) = (mflags / 4) % 2

fn ais_hole_name(nm) = if nm == "_" or ostarts(nm, "_hole") == 1 then 1 else 0

fn ois_unverified_ty(ty) = match ty
    TyApply(n, e) => if n == "unverified" then 1 else 0
    _             => 0

fn ohas_unverified_tys(tys) = match tys
    Nil        => 0
    Cons(h, t) => if ois_unverified_ty(h) == 1 then 1 else ohas_unverified_tys(t)

fn oany(prog) = match prog
    Nil        => 0
    Cons(h, t) => if oanystmt(h) == 1 then 1 else oany(t)

fn oanystmt(st) = match st
    OSig(nm, pubf, freef, pl, rty, fromp) => 1
    OType(nm, k)                          => 1
    KEffSig(nm, effs)                     => 1
    KEffectDecl(enm, ops)                 => 1
    KCapGrant(effs)                       => 1
    VContractSig(nm, ps, reqs, enss)      => 1
    VTypeInvariant(nm, fs, inv)           => 1
    VLawDecl(nm, ps, body)                => 1
    Sig(nm, ps, ts, rt)                   => if ohas_unverified_tys(ts) == 1 or ois_unverified_ty(rt) == 1 then 1 else 0
    Fn(nm, ps, body)                      => oanye(body)
    Print(v)                              => oanye(v)
    ExprS(v)                              => oanye(v)
    _                                     => 0

fn oanye(e) = match e
    Var(nm)                 => ais_hole_name(nm)
    VarIn(nm, v, b)         => 1
    OwnE(inner)             => 1
    MutE(inner)             => 1
    DeferE(c, b)            => 1
    ErrDeferE(c, b)         => 1
    WithAllocE(a, b)        => 1
    WithHandlerE(en, hs, b) => 1
    ScopeE(snm, b)          => 1
    SpawnE(inner)           => 1
    LetIn(nm, v, b)         => if oanye(v) == 1 then 1 else oanye(b)
    If(c, t, e2)            => if oanye(c) == 1 then 1 else if oanye(t) == 1 then 1 else oanye(e2)
    Bin(op, l, r)           => if oanye(l) == 1 then 1 else oanye(r)
    Call(nm, args)          => if nm == "borrow" or nm == "borrow_mut" or nm == "move" or nm == "clone" or nm == "verify" or nm == "law_check" or nm == "evolve_approve" or nm == "llm_complete" or nm == "prob_sample" or nm == "old" then 1 else oanyargs(args)
    Field(o, fld)           => oanye(o)
    Rec(items)              => oanyrec(items)
    RecT(tn, items)         => oanyrec(items)
    Match(sc, arms)         => if oanye(sc) == 1 then 1 else oanyarms(arms)
    CT(inner)               => oanye(inner)
    _                       => 0

fn oanyhops(xs) = match xs
    Nil        => 0
    Cons(h, t) => if oanye(h.body) == 1 then 1 else oanyhops(t)

fn oanyargs(xs) = match xs
    Nil        => 0
    Cons(h, t) => if oanye(h) == 1 then 1 else oanyargs(t)

fn oanyrec(xs) = match xs
    Nil        => 0
    Cons(h, t) => if oanye(h.val) == 1 then 1 else oanyrec(t)

fn oanyarms(xs) = match xs
    Nil        => 0
    Cons(h, t) => if oanye(h.body) == 1 then 1 else oanyarms(t)

## --- collect OSig, OType, and user functions ---
fn ocollects(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ocollects1(h, ocollects(t))

fn ocollects1(st, rest) = match st
    OSig(nm, pubf, freef, pl, rty, fromp) => Cons({nm: nm, pubf: pubf, freef: freef, pl: pl, rty: rty, fromp: fromp}, rest)
    _                                     => rest

fn ocollectt(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ocollectt1(h, ocollectt(t))

fn ocollectt1(st, rest) = match st
    OType(nm, k) => Cons({nm: nm, kind: k}, rest)
    _            => rest

fn ocollectf(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ocollectf1(h, ocollectf(t))

fn ocollectf1(st, rest) = match st
    Fn(nm, ps, body) => Cons({nm: nm, ps: ps, body: body}, rest)
    _                => rest

fn ocollectfnms(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ocollectfnms1(h, ocollectfnms(t))

fn ocollectfnms1(st, rest) = match st
    Fn(nm, ps, body) => Cons(nm, rest)
    _                => rest

fn kcollect_effsigs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => kcollect_effsig1(h, kcollect_effsigs(t))

fn kcollect_effsig1(st, rest) = match st
    KEffSig(nm, effs) => Cons({nm: nm, effs: effs}, rest)
    _                 => rest

fn kcollect_effdecls(prog) = match prog
    Nil        => Nil
    Cons(h, t) => kcollect_effdecl1(h, kcollect_effdecls(t))

fn kcollect_effdecl1(st, rest) = match st
    KEffectDecl(enm, ops) => Cons({enm: enm, ops: ops}, rest)
    _                     => rest

fn kcollect_caps(prog) = match prog
    Nil        => Nil
    Cons(h, t) => kcollect_cap1(h, kcollect_caps(t))

fn kcollect_cap1(st, rest) = match st
    KCapGrant(effs) => app(effs, rest)
    _               => rest

fn keffsig_lookup(nm, ksigs) = match ksigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else keffsig_lookup(nm, t)

fn kop_effect(opnm, edecls) = match edecls
    Nil        => ""
    Cons(d, r) => if kop_in_ops(opnm, d.ops) == 1 then d.enm else kop_effect(opnm, r)

fn kop_in_ops(opnm, ops) = match ops
    Nil        => 0
    Cons(o, r) => if o.op == opnm then 1 else kop_in_ops(opnm, r)

fn keff_add(eff, xs) = if eff == "" or eff == "pure" or omem(eff, xs) == 1 then xs else Cons(eff, xs)

fn keff_union(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => keff_union(t, keff_add(h, ys))

fn keff_diff(xs, ys) = match xs
    Nil        => Nil
    Cons(h, t) => if h == "pure" or omem(h, ys) == 1 then keff_diff(t, ys) else Cons(h, keff_diff(t, ys))

fn keff_join(xs) = match xs
    Nil        => ""
    Cons(h, t) => if isnil(t) == 1 then h else h + ", " + keff_join(t)

fn kprim_eff(cnm) = if cnm == "io_write" or cnm == "io_read" or cnm == "println" or cnm == "read" or cnm == "readall" or cnm == "emit" or cnm == "flush" then "io" else if cnm == "fs_read" or cnm == "fs_write" or cnm == "fs_open" then "fs" else if cnm == "net_send" or cnm == "net_recv" or cnm == "net_connect" or cnm == "db_exec" then "net" else if cnm == "rc_new" or cnm == "arc_new" or cnm == "alloc_heap" or cnm == "table_new" or cnm == "box_new" then "alloc" else if cnm == "rand_int" or cnm == "prob_sample" or cnm == "llm_complete" then "rand" else if cnm == "time_now" or cnm == "clock_now" or cnm == "sleep_ms" then "time" else if cnm == "fail_err" or cnm == "raise_err" then "fail" else if cnm == "panic_msg" then "panic" else if cnm == "async_await" or cnm == "spawn_task" then "async" else ""

fn kinfer_call_effs(cnm, ksigs, edecls, fns, d) = let pe = kprim_eff(cnm) in let ue = kop_effect(cnm, edecls) in let base = keff_add(pe, keff_add(ue, Nil)) in let mks = keffsig_lookup(cnm, ksigs) in match mks
    Cons(ks, r) => keff_union(base, keff_diff(ks.effs, Cons("pure", Nil)))
    Nil         => if d <= 0 then base else keff_union(base, kinfer_fn_lookup(cnm, fns, ksigs, edecls, d - 1))

fn kinfer_fn_lookup(cnm, fns, ksigs, edecls, d) = match fns
    Nil        => Nil
    Cons(f, r) => if f.nm == cnm then kinfer_effs_e(f.body, ksigs, edecls, fns, d) else kinfer_fn_lookup(cnm, r, ksigs, edecls, d)

fn kinfer_effs_e(e, ksigs, edecls, fns, d) = match e
    Bin(op, l, r)           => keff_union(kinfer_effs_e(l, ksigs, edecls, fns, d), kinfer_effs_e(r, ksigs, edecls, fns, d))
    If(c, t, e2)            => keff_union(kinfer_effs_e(c, ksigs, edecls, fns, d), keff_union(kinfer_effs_e(t, ksigs, edecls, fns, d), kinfer_effs_e(e2, ksigs, edecls, fns, d)))
    LetIn(nm, v, b)         => keff_union(kinfer_effs_e(v, ksigs, edecls, fns, d), kinfer_effs_e(b, ksigs, edecls, fns, d))
    VarIn(nm, v, b)         => keff_union(kinfer_effs_e(v, ksigs, edecls, fns, d), kinfer_effs_e(b, ksigs, edecls, fns, d))
    OwnE(inner)             => kinfer_effs_e(inner, ksigs, edecls, fns, d)
    MutE(inner)             => kinfer_effs_e(inner, ksigs, edecls, fns, d)
    DeferE(c, b)            => keff_union(kinfer_effs_e(c, ksigs, edecls, fns, d), kinfer_effs_e(b, ksigs, edecls, fns, d))
    ErrDeferE(c, b)         => keff_union(kinfer_effs_e(c, ksigs, edecls, fns, d), kinfer_effs_e(b, ksigs, edecls, fns, d))
    WithAllocE(a, b)        => keff_union(kinfer_effs_e(a, ksigs, edecls, fns, d), orem("alloc", kinfer_effs_e(b, ksigs, edecls, fns, d)))
    WithHandlerE(en, hs, b) => keff_union(kinfer_hops(hs, ksigs, edecls, fns, d), orem(en, kinfer_effs_e(b, ksigs, edecls, fns, d)))
    Call(cnm, args)         => keff_union(kinfer_call_effs(cnm, ksigs, edecls, fns, d), kinfer_args(args, ksigs, edecls, fns, d))
    Match(sc, arms)         => keff_union(kinfer_effs_e(sc, ksigs, edecls, fns, d), kinfer_arms(arms, ksigs, edecls, fns, d))
    Field(o, fld)           => kinfer_effs_e(o, ksigs, edecls, fns, d)
    Rec(items)              => kinfer_rec(items, ksigs, edecls, fns, d)
    RecT(tn, items)         => kinfer_rec(items, ksigs, edecls, fns, d)
    _                       => Nil

fn kinfer_hops(hs, ksigs, edecls, fns, d) = match hs
    Nil        => Nil
    Cons(h, t) => keff_union(kinfer_effs_e(h.body, ksigs, edecls, fns, d), kinfer_hops(t, ksigs, edecls, fns, d))

fn kinfer_args(xs, ksigs, edecls, fns, d) = match xs
    Nil        => Nil
    Cons(h, t) => keff_union(kinfer_effs_e(h, ksigs, edecls, fns, d), kinfer_args(t, ksigs, edecls, fns, d))

fn kinfer_arms(xs, ksigs, edecls, fns, d) = match xs
    Nil        => Nil
    Cons(h, t) => keff_union(kinfer_effs_e(h.body, ksigs, edecls, fns, d), kinfer_arms(t, ksigs, edecls, fns, d))

fn kinfer_rec(xs, ksigs, edecls, fns, d) = match xs
    Nil        => Nil
    Cons(h, t) => keff_union(kinfer_effs_e(h.val, ksigs, edecls, fns, d), kinfer_rec(t, ksigs, edecls, fns, d))

fn kchk_fn_effs(nm, pubf, body, ot) = let mks = keffsig_lookup(nm, ot.ksigs) in if pubf == 0 and isnil(mks) == 1 and isnil(ot.caps) == 1 then 1 else let inf = kinfer_effs_e(body, ot.ksigs, ot.edecls, ot.fns, 4) in let dec = kget_dec_effs(mks) in let missing_pub = if pubf == 1 and isnil(mks) == 1 then inf else keff_diff(inf, dec) in if (pubf == 1 or isnil(mks) == 0) and isnil(missing_pub) == 0 then ctfail("lume: effect error [E0200]: function '" + nm + "' performs undeclared effect '{" + keff_join(missing_pub) + "}' (fix-it: add '/ {" + keff_join(keff_union(dec, inf)) + "}' to the signature of '" + nm + "' or handle it with 'with handler')\n") else if isnil(ot.caps) == 0 and isnil(keff_diff(inf, ot.caps)) == 0 then let uncap = keff_diff(inf, ot.caps) in ctfail("lume: capability error [E0200]: function '" + nm + "' requires capability '{" + keff_join(uncap) + "}' not granted to this module (fix-it: add '@capability " + ohd_s(uncap, "io") + "' or declare it in lume.toml)\n") else 1

fn kget_dec_effs(mks) = match mks
    Nil         => Nil
    Cons(ks, r) => ks.effs

fn osiglookup(nm, osigs) = match osigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else osiglookup(nm, t)

fn otypelookup(nm, otypes) = match otypes
    Nil        => ""
    Cons(h, t) => if h.nm == nm then h.kind else otypelookup(nm, t)

fn oisgctype(ty, otypes) = match ty
    TyName(n)     => if otypelookup(n, otypes) == "gc" then 1 else 0
    TyList(e)     => oisgctype(e, otypes)
    TyApply(n, e) => oisgctype(e, otypes)
    _             => 0

fn oisreftype(ty) = match ty
    TyApply(n, e) => if n == "Ref" or n == "View" then 1 else 0
    _             => 0

fn obparams_pl(pl) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 0 or p.cf == 3 then Cons(p.pn, obparams_pl(r)) else obparams_pl(r)

fn omvars_pl(pl) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 2 or p.cf == 3 then Cons(p.pn, omvars_pl(r)) else omvars_pl(r)

fn oinit_origins(ps) = match ps
    Nil        => Nil
    Cons(h, t) => Cons({k: h, v: "param:" + h}, oinit_origins(t))

fn olookup_origin(x, orgs) = match orgs
    Nil        => ""
    Cons(h, t) => if h.k == x then h.v else olookup_origin(x, t)

fn obind_origin(x, v, orgs) = Cons({k: x, v: v}, orgs)

## Intra-module quick origin inference for private helper functions (`borrow(p)` -> `p`)
fn oquick_origin(e, orgs) = match e
    Var(x)           => olookup_origin(x, orgs)
    Field(o, fld)    => oquick_origin(o, orgs)
    LetIn(nm, v, b)  => let vo = oquick_origin(v, orgs) in oquick_origin(b, obind_origin(nm, if vo != "" then vo else "local:" + nm, orgs))
    VarIn(nm, v, b)  => let vo = oquick_origin(v, orgs) in oquick_origin(b, obind_origin(nm, if vo != "" then vo else "local:" + nm, orgs))
    If(c, t, e2)     => let to = oquick_origin(t, orgs) in if to != "" then to else oquick_origin(e2, orgs)
    DeferE(c, b)     => oquick_origin(b, orgs)
    ErrDeferE(c, b)  => oquick_origin(b, orgs)
    WithAllocE(a, b) => oquick_origin(b, orgs)
    Call(nm, args)   => if (nm == "borrow" or nm == "borrow_mut") and len(args) == 1 then "borrow:" + oquick_origin(ohd_e(args), orgs) else ""
    _                => ""

fn ohd_e(xs) = match xs
    Nil        => Num(0)
    Cons(h, t) => h

fn ohd_s(xs, def) = match xs
    Nil        => def
    Cons(h, t) => h

fn ostrip_borrow(org) = if ostarts(org, "borrow:") == 1 then ostrip_borrow(slice(org, 7, count(org))) else org

fn oinfer_priv_osigs(fns, osigs) = match fns
    Nil        => osigs
    Cons(f, r) => oinfer_priv_one(f, oinfer_priv_osigs(r, osigs))

fn oinfer_priv_one(f, osigs) = if oanye(f.body) == 0 then osigs else let m = osiglookup(f.nm, osigs) in match m
    Cons(sg, r) => osigs
    Nil         => let bo = oquick_origin(f.body, oinit_origins(f.ps)) in if ostarts(bo, "borrow:param:") == 1 then Cons({nm: f.nm, pubf: 0, freef: 0, pl: Nil, rty: TyAny, fromp: slice(ostrip_borrow(bo), 6, count(ostrip_borrow(bo)))}, osigs) else osigs

## --- call-site conflict & mode helpers ---
fn ois_own_expr(e) = match e
    OwnE(inner)    => 1
    Call(nm, args) => if nm == "move" and len(args) == 1 then 1 else 0
    _              => 0

fn ois_mut_expr(e) = match e
    MutE(inner) => 1
    _           => 0

fn omentions_var(x, e) = match e
    Var(nm)          => if nm == x then 1 else 0
    OwnE(inner)      => omentions_var(x, inner)
    MutE(inner)      => omentions_var(x, inner)
    Field(o, fld)    => omentions_var(x, o)
    Bin(op, l, r)    => if omentions_var(x, l) == 1 then 1 else omentions_var(x, r)
    If(c, t, e2)     => if omentions_var(x, c) == 1 then 1 else if omentions_var(x, t) == 1 then 1 else omentions_var(x, e2)
    LetIn(nm, v, b)  => if omentions_var(x, v) == 1 then 1 else if nm == x then 0 else omentions_var(x, b)
    VarIn(nm, v, b)  => if omentions_var(x, v) == 1 then 1 else if nm == x then 0 else omentions_var(x, b)
    Call(nm, args)   => omentions_args(x, args)
    Rec(items)       => omentions_rec(x, items)
    RecT(tn, items)  => omentions_rec(x, items)
    _                => 0

fn omentions_args(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if omentions_var(x, h) == 1 then 1 else omentions_args(x, t)

fn omentions_rec(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if omentions_var(x, h.val) == 1 then 1 else omentions_rec(x, t)

fn ocount_var_args(x, args) = match args
    Nil        => 0
    Cons(h, t) => omentions_var(x, h) + ocount_var_args(x, t)

fn omut_root(e) = match e
    MutE(inner)    => omut_root_plain(inner)
    Call(nm, args) => if nm == "borrow_mut" and len(args) == 1 then omut_root_plain(ohd_e(args)) else ""
    _              => ""

fn omut_root_plain(e) = match e
    Var(x)        => x
    MutE(inner)   => omut_root_plain(inner)
    Field(o, fld) => omut_root_plain(o)
    _             => ""

fn ocollect_mut_args(args, pl) = match args
    Nil        => Nil
    Cons(a, r) => ocollect_mut_arg1(a, r, pl)

fn ocollect_mut_arg1(a, r, pl) = let mr = omut_root(a) in let rest = ocollect_mut_args(r, opl_tl(pl)) in if mr != "" then Cons(mr, rest) else if opl_cf(pl) == 3 then let pr = omut_root_plain(a) in (if pr != "" then Cons(pr, rest) else rest) else rest

fn opl_cf(pl) = match pl
    Nil        => 0
    Cons(p, r) => p.cf

fn opl_pn(pl) = match pl
    Nil        => ""
    Cons(p, r) => p.pn

fn opl_tl(pl) = match pl
    Nil        => Nil
    Cons(p, r) => r

fn ochk_conflicts(fnm, muts, args) = match muts
    Nil         => 0
    Cons(mx, r) => if ocount_var_args(mx, args) > 1 then ctfail("lume: borrow error [O0011]: conflicting borrow of '" + mx + "' in call to '" + fnm + "' (cannot borrow '" + mx + "' as mutable while also borrowing it in the same call)\n") else ochk_conflicts(fnm, r, args)

fn ochk_call_modes(fnm, args, pl, ctx) = match pl
    Nil        => 0
    Cons(p, r) => if p.cf == 1 then ochk_call_modes(fnm, args, r, ctx) else ochk_call_mode1(fnm, args, p, r, ctx)

fn ochk_call_mode1(fnm, args, p, r, ctx) = match args
    Nil         => 0
    Cons(a, ar) => if p.cf == 2 and ois_own_expr(a) == 0 then ctfail("lume: ownership error [O0012]: parameter '" + p.pn + "' of '" + fnm + "' takes ownership; mark argument with 'own' at call site (help: write 'own <arg>')\n") else if p.cf == 3 then ochk_mut_param(fnm, p.pn, a, ar, r, ctx) else ochk_call_modes(fnm, ar, r, ctx)

fn ochk_mut_param(fnm, pn, a, ar, r, ctx) = let vnm = omut_root_plain(a) in if vnm != "" and omem(vnm, ctx.mvars) == 0 then ctfail("lume: borrow error [O0010]: cannot pass immutable binding '" + vnm + "' to 'mut' parameter '" + pn + "' of '" + fnm + "' (help: declare 'var " + vnm + "' instead of 'let " + vnm + "')\n") else ochk_call_modes(fnm, ar, r, ctx)

fn oarg_for_param(fromp, args, pl) = match pl
    Nil        => Num(0)
    Cons(p, r) => if p.cf == 1 then oarg_for_param(fromp, args, r) else oarg_for_param2(fromp, args, p, r)

fn oarg_for_param2(fromp, args, p, r) = match args
    Nil         => Num(0)
    Cons(a, ar) => if p.pn == fromp then a else oarg_for_param(fromp, ar, r)

fn ois_heap_alloc(nm) = if nm == "rc_new" or nm == "arc_new" or nm == "alloc_heap" or nm == "table_new" or nm == "box_new" then 1 else 0

## --- core expression ownership/borrow/region check: returns {moved, origin} ---
fn ochk_own_field(o, fld, ctx, moved) = match o
    Var(x) => if omem(x, moved) == 1 then ctfail("lume: ownership error [O0001]: use of moved value '" + x + "' (moved earlier via 'own " + x + "'; help: borrow '" + x + "' instead or call 'clone(" + x + ")')\n") else if omem(x, ctx.bparams) == 1 or ostarts(olookup_origin(x, ctx.origins), "borrow:") == 1 then ctfail("lume: ownership error [O0002]: cannot move out of borrowed field '" + x + "." + fld + "' (help: borrow '" + x + "." + fld + "' or clone the field)\n") else {moved: Cons(x, moved), origin: ""}
    _      => let r = ochke(o, ctx, moved) in {moved: r.moved, origin: ""}

fn ochk_own_target(inner, ctx, moved) = match inner
    Var(x)        => if omem(x, moved) == 1 then ctfail("lume: ownership error [O0001]: use of moved value '" + x + "' (moved earlier via 'own " + x + "'; help: borrow '" + x + "' instead or call 'clone(" + x + ")')\n") else if omem(x, ctx.bparams) == 1 or ostarts(olookup_origin(x, ctx.origins), "borrow:") == 1 then ctfail("lume: ownership error [O0002]: cannot move out of borrowed parameter '" + x + "' (help: change parameter mode to 'own " + x + "' or call 'clone(" + x + ")')\n") else {moved: Cons(x, moved), origin: ""}
    Field(o, fld) => ochk_own_field(o, fld, ctx, moved)
    _             => let r = ochke(inner, ctx, moved) in {moved: r.moved, origin: ""}

fn ochk_mut_field(o, fld, ctx, moved) = match o
    Var(x) => if omem(x, moved) == 1 then ctfail("lume: ownership error [O0001]: use of moved value '" + x + "' (moved earlier via 'own " + x + "'; help: borrow '" + x + "' instead or call 'clone(" + x + ")')\n") else if omem(x, ctx.mvars) == 0 then ctfail("lume: borrow error [O0010]: cannot borrow field of immutable binding '" + x + "' as 'mut' (help: declare 'var " + x + "' instead of 'let " + x + "')\n") else {moved: moved, origin: "borrow:" + olookup_origin(x, ctx.origins)}
    _      => let r = ochke(o, ctx, moved) in {moved: r.moved, origin: ""}

fn ochk_mut_target(inner, ctx, moved) = match inner
    Var(x)        => if omem(x, moved) == 1 then ctfail("lume: ownership error [O0001]: use of moved value '" + x + "' (moved earlier via 'own " + x + "'; help: borrow '" + x + "' instead or call 'clone(" + x + ")')\n") else if omem(x, ctx.mvars) == 0 then ctfail("lume: borrow error [O0010]: cannot borrow immutable binding '" + x + "' as 'mut' (help: declare 'var " + x + "' instead of 'let " + x + "')\n") else {moved: moved, origin: "borrow:" + olookup_origin(x, ctx.origins)}
    Field(o, fld) => ochk_mut_field(o, fld, ctx, moved)
    _             => let r = ochke(inner, ctx, moved) in {moved: r.moved, origin: ""}

fn octx_bind(ctx, nm, ismut, org) = {fnm: ctx.fnm, pubf: ctx.pubf, freef: ctx.freef, halloc: ctx.halloc, bparams: orem(nm, ctx.bparams), mvars: if ismut == 1 then Cons(nm, orem(nm, ctx.mvars)) else orem(nm, ctx.mvars), pnames: ctx.pnames, locals: Cons(nm, ctx.locals), origins: obind_origin(nm, if org != "" then org else "local:" + nm, ctx.origins), osigs: ctx.osigs, otypes: ctx.otypes}

fn octx_with_alloc(ctx) = {fnm: ctx.fnm, pubf: ctx.pubf, freef: ctx.freef, halloc: 1, bparams: ctx.bparams, mvars: ctx.mvars, pnames: ctx.pnames, locals: ctx.locals, origins: ctx.origins, osigs: ctx.osigs, otypes: ctx.otypes}

fn ochke(e, ctx, moved) = match e
    Var(x) => if omem(x, moved) == 1 then ctfail("lume: ownership error [O0001]: use of moved value '" + x + "' (moved earlier via 'own " + x + "'; help: borrow '" + x + "' instead or call 'clone(" + x + ")')\n") else {moved: moved, origin: olookup_origin(x, ctx.origins)}
    Field(o, fld) => let ro = ochke(o, ctx, moved) in {moved: ro.moved, origin: ro.origin}
    OwnE(inner) => ochk_own_target(inner, ctx, moved)
    MutE(inner) => ochk_mut_target(inner, ctx, moved)
    LetIn(nm, v, b) => let rv = ochke(v, ctx, moved) in ochke(b, octx_bind(ctx, nm, 0, rv.origin), orem(nm, rv.moved))
    VarIn(nm, v, b) => let rv = ochke(v, ctx, moved) in ochke(b, octx_bind(ctx, nm, 1, rv.origin), orem(nm, rv.moved))
    DeferE(c, b) => let rb = ochke(b, ctx, moved) in let rc = ochke(c, ctx, rb.moved) in {moved: rc.moved, origin: rb.origin}
    ErrDeferE(c, b) => let rb = ochke(b, ctx, moved) in let rc = ochke(c, ctx, rb.moved) in {moved: rc.moved, origin: rb.origin}
    WithAllocE(a, b) => let ra = ochke(a, ctx, moved) in ochke(b, octx_with_alloc(ctx), ra.moved)
    WithHandlerE(en, hs, b) => let mvh = ochkhops(hs, ctx, moved) in ochke(b, ctx, mvh)
    ScopeE(snm, b) => ochke(b, ctx, moved)
    SpawnE(inner) => ochke(inner, ctx, moved)
    Bin(op, l, r) => let rl = ochke(l, ctx, moved) in let rr = ochke(r, ctx, rl.moved) in {moved: rr.moved, origin: ""}
    If(c, t, e2) => let rc = ochke(c, ctx, moved) in let rt = ochke(t, ctx, rc.moved) in let re = ochke(e2, ctx, rc.moved) in {moved: app(rt.moved, re.moved), origin: if rt.origin != "" then rt.origin else re.origin}
    Rec(items) => {moved: ochkrec(items, ctx, moved), origin: ""}
    RecT(tn, items) => {moved: ochkrec(items, ctx, moved), origin: ""}
    Match(sc, arms) => let rsc = ochke(sc, ctx, moved) in {moved: ochkarms(arms, ctx, rsc.moved), origin: ""}
    CT(inner) => ochke(inner, ctx, moved)
    Call(nm, args) => ochkcall(nm, args, ctx, moved)
    _ => {moved: moved, origin: ""}

fn ochkhops(hs, ctx, moved) = match hs
    Nil        => moved
    Cons(h, t) => let r = ochke(h.body, ctx, moved) in ochkhops(t, ctx, r.moved)

fn ochkrec(items, ctx, moved) = match items
    Nil        => moved
    Cons(h, t) => let r = ochke(h.val, ctx, moved) in ochkrec(t, ctx, r.moved)

fn ochkarms(arms, ctx, moved) = match arms
    Nil        => moved
    Cons(h, t) => let r = ochke(h.body, ctx, moved) in app(r.moved, ochkarms(t, ctx, moved))

fn ochkargs(args, ctx, moved) = match args
    Nil        => moved
    Cons(h, t) => let r = ochke(h, ctx, moved) in ochkargs(t, ctx, r.moved)

fn ochkcall(fnm, args, ctx, moved) = if ois_free(ctx.freef) == 1 and ctx.halloc == 0 and ois_heap_alloc(fnm) == 1 then ctfail("lume: ownership error [O0030]: ambient heap allocation '" + fnm + "' in '@freestanding' function '" + ctx.fnm + "' (help: pass an explicit allocator via 'with alloc = <arena> in ...')\n") else if fnm == "move" and len(args) == 1 then ochk_own_target(ohd_e(args), ctx, moved) else if fnm == "borrow" and len(args) == 1 then let ra = ochke(ohd_e(args), ctx, moved) in {moved: ra.moved, origin: "borrow:" + ra.origin} else if fnm == "borrow_mut" and len(args) == 1 then ochk_mut_target(ohd_e(args), ctx, moved) else ochkcall_sig(fnm, args, osiglookup(fnm, ctx.osigs), ctx, moved)

fn ochkcall_sig(fnm, args, msig, ctx, moved) = match msig
    Nil          => let z = ochk_conflicts(fnm, ocollect_mut_args(args, Nil), args) in {moved: ochkargs(args, ctx, moved), origin: ""}
    Cons(sg, sr) => let z1 = ochk_call_modes(fnm, args, sg.pl, ctx) in let z2 = ochk_conflicts(fnm, ocollect_mut_args(args, sg.pl), args) in let mv2 = ochkargs(args, ctx, moved) in if sg.fromp != "" then let fa = oarg_for_param(sg.fromp, args, sg.pl) in let rfa = ochke(fa, ctx, moved) in {moved: mv2, origin: "borrow:" + rfa.origin} else {moved: mv2, origin: ""}

## --- check function return region rules O0020 & O0021 ---
fn ochk_ret_origin(nm, pubf, fromp, rty, pnames, org) = let core_org = ostrip_borrow(org) in if ostarts(org, "borrow:") == 1 and ostarts(core_org, "local:") == 1 then let lx = slice(core_org, 6, count(core_org)) in ctfail("lume: region error [O0020]: borrowed value '" + lx + "' does not live long enough (escapes local scope of '" + nm + "')\n") else if ostarts(org, "borrow:") == 1 and ostarts(core_org, "param:") == 1 then let px = slice(core_org, 6, count(core_org)) in (if pubf == 1 and fromp == "" then ctfail("lume: region error [O0021]: public function '" + nm + "' returns a borrow from parameter '" + px + "' without an origin clause (help: add 'from " + px + "' to the return type)\n") else if fromp != "" and fromp != px then ctfail("lume: region error [O0021]: function '" + nm + "' declares 'from " + fromp + "' but returns a borrow from parameter '" + px + "' (help: change origin clause to 'from " + px + "')\n") else 1) else if pubf == 1 and oisreftype(rty) == 1 and fromp == "" then ctfail("lume: region error [O0021]: public function '" + nm + "' returns a borrowed view without a 'from <param>' origin clause\n") else 1

## ============================================================================================================
## Track A1: Typed holes (`_`, `_hole*`) + hole-driven candidate synthesis (`[A0001]`)
## ============================================================================================================
fn asynth_vars(expty, lenv) = match lenv
    Nil        => Nil
    Cons(h, t) => if tystr(h.v) != "?" and tcompat(expty, h.v) == 1 then Cons(h.k, asynth_vars(expty, t)) else asynth_vars(expty, t)

fn asynth_fn_arg(pt, lenv) = match lenv
    Nil        => ""
    Cons(h, t) => if tystr(h.v) != "?" and tcompat(pt, h.v) == 1 then h.k else asynth_fn_arg(pt, t)

fn asynth_fns(expty, lenv, sigs, curfn) = match sigs
    Nil        => Nil
    Cons(sg, r) => if sg.fname == curfn or tystr(sg.rt) == "?" or tcompat(expty, sg.rt) == 0 then asynth_fns(expty, lenv, r, curfn) else if len(sg.pt) == 0 then Cons(sg.fname + "()", asynth_fns(expty, lenv, r, curfn)) else if len(sg.pt) == 1 then let v = asynth_fn_arg(ohd_ty(sg.pt), lenv) in (if v != "" then Cons(sg.fname + "(" + v + ")", asynth_fns(expty, lenv, r, curfn)) else asynth_fns(expty, lenv, r, curfn)) else asynth_fns(expty, lenv, r, curfn)

fn ohd_ty(xs) = match xs
    Nil        => TyAny
    Cons(h, t) => h

fn asynth_default(expty) = match expty
    TyName(n) => if n == "int" then Cons("0", Nil) else if n == "str" then Cons("\"\"", Nil) else Nil
    TyList(e) => Cons("Nil", Nil)
    _         => Nil

fn asynth_cands(expty, lenv, sigs, curfn) = app(asynth_vars(expty, lenv), app(asynth_fns(expty, lenv, sigs, curfn), asynth_default(expty)))

fn aquick_ty(e, lenv, sigs) = match e
    Num(n)        => TyName("int")
    Str(s)        => TyName("str")
    Var(nm)       => if ais_hole_name(nm) == 1 then TyAny else aquick_var_ty(nm, lenv)
    Bin(op, a, b) => if op == "+" then aquick_plus_ty(aquick_ty(a, lenv, sigs), aquick_ty(b, lenv, sigs)) else TyName("int")
    Call(nm, xs)  => aquick_call_ty(tsiglookup(nm, sigs))
    _             => TyAny

fn aquick_var_ty(nm, lenv) = match lenv
    Nil        => TyAny
    Cons(h, t) => if h.k == nm then h.v else aquick_var_ty(nm, t)

fn aquick_plus_ty(ta, tb) = if tystr(ta) != "?" then ta else tb

fn aquick_call_ty(msig) = match msig
    Nil        => TyAny
    Cons(sg, r) => sg.rt

fn abin_expty(op, other_e, expty, lenv, sigs) = if op == "+" then let ot = aquick_ty(other_e, lenv, sigs) in (if tystr(ot) != "?" then ot else if tystr(expty) != "?" then expty else TyName("int")) else if op == "-" or op == "*" or op == "/" or op == "%" then TyName("int") else let ot = aquick_ty(other_e, lenv, sigs) in if tystr(ot) != "?" then ot else TyName("int")

fn achk_hole_var(hnm, expty, lenv, hctx) = let cands = asynth_cands(expty, lenv, hctx.sigs, hctx.fnm) in let best = ohd_s(cands, "0") in if hctx.pubf == 1 or tystr(expty) == "?" then ctfail("lume: hole error [A0001]: unfilled typed hole '" + hnm + "' of expected type " + tystr(expty) + " in '" + hctx.fnm + "' (fix-it: replace '" + hnm + "' with '" + best + "')\n") else 1

fn achk_holes_e(e, expty, lenv, hctx) = match e
    Var(nm)         => if ais_hole_name(nm) == 1 then achk_hole_var(nm, expty, lenv, hctx) else 0
    Bin(op, a, b)   => achk_holes_e(a, abin_expty(op, b, expty, lenv, hctx.sigs), lenv, hctx) + achk_holes_e(b, abin_expty(op, a, expty, lenv, hctx.sigs), lenv, hctx)
    If(c, t, e2)    => achk_holes_e(c, TyName("int"), lenv, hctx) + achk_holes_e(t, expty, lenv, hctx) + achk_holes_e(e2, expty, lenv, hctx)
    LetIn(nm, v, b) => let vt = aquick_ty(v, lenv, hctx.sigs) in achk_holes_e(v, vt, lenv, hctx) + achk_holes_e(b, expty, Cons({k: nm, v: vt}, lenv), hctx)
    VarIn(nm, v, b) => let vt = aquick_ty(v, lenv, hctx.sigs) in achk_holes_e(v, vt, lenv, hctx) + achk_holes_e(b, expty, Cons({k: nm, v: vt}, lenv), hctx)
    DeferE(c, b)    => achk_holes_e(c, TyAny, lenv, hctx) + achk_holes_e(b, expty, lenv, hctx)
    ErrDeferE(c, b) => achk_holes_e(c, TyAny, lenv, hctx) + achk_holes_e(b, expty, lenv, hctx)
    WithAllocE(a, b) => achk_holes_e(a, TyName("int"), lenv, hctx) + achk_holes_e(b, expty, lenv, hctx)
    Call(nm, args)  => achk_holes_call(nm, args, tsiglookup(nm, hctx.sigs), lenv, hctx)
    Match(sc, arms) => achk_holes_e(sc, TyAny, lenv, hctx) + achk_holes_arms(arms, expty, lenv, hctx)
    _               => 0

fn achk_holes_call(nm, args, msig, lenv, hctx) = match msig
    Nil        => achk_holes_args_any(args, lenv, hctx)
    Cons(sg, r) => achk_holes_args_typed(args, sg.pt, lenv, hctx)

fn achk_holes_args_any(args, lenv, hctx) = match args
    Nil        => 0
    Cons(h, t) => achk_holes_e(h, TyAny, lenv, hctx) + achk_holes_args_any(t, lenv, hctx)

fn achk_holes_args_typed(args, pts, lenv, hctx) = match args
    Nil        => 0
    Cons(h, t) => achk_holes_e(h, ohd_ty(pts), lenv, hctx) + achk_holes_args_typed(t, ptl(pts), lenv, hctx)

fn achk_holes_arms(arms, expty, lenv, hctx) = match arms
    Nil        => 0
    Cons(h, t) => achk_holes_e(h.body, expty, lenv, hctx) + achk_holes_arms(t, expty, lenv, hctx)

## ============================================================================================================
## Track A2: `total fn` termination & structural/measure recursion checker (`[A0002]`)
## ============================================================================================================
fn apat_binds(p) = match p
    PBind(v)        => Cons(v, Nil)
    PCons(tag, sub) => apat_bind_list(sub)
    _               => Nil

fn apat_bind_list(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(apat_binds(h), apat_bind_list(t))

fn apat_subvars(p) = match p
    PCons(tag, sub) => apat_bind_list(sub)
    _               => Nil

fn aguard_params(ps, c, guarded) = match ps
    Nil        => guarded
    Cons(p, r) => if omentions_var(p, c) == 1 and omem(p, guarded) == 0 then Cons(p, aguard_params(r, c, guarded)) else aguard_params(r, c, guarded)

fn ais_pos_num(e, minv) = match e
    Num(k) => if k >= minv then 1 else 0
    _      => 0

fn ais_dec_bin(op, l, r, ps, guarded) = match l
    Var(p) => if omem(p, ps) == 1 and omem(p, guarded) == 1 then (if op == "-" and ais_pos_num(r, 1) == 1 then 1 else if op == "/" and ais_pos_num(r, 2) == 1 then 1 else 0) else 0
    _      => 0

fn ais_dec_arg(arg, ps, subvars, guarded) = match arg
    Var(v)        => omem(v, subvars)
    OwnE(inner)   => ais_dec_arg(inner, ps, subvars, guarded)
    MutE(inner)   => ais_dec_arg(inner, ps, subvars, guarded)
    Bin(op, l, r) => ais_dec_bin(op, l, r, ps, guarded)
    _             => 0

fn ahas_dec_arg(args, ps, subvars, guarded) = match args
    Nil        => 0
    Cons(a, r) => if ais_dec_arg(a, ps, subvars, guarded) == 1 then 1 else ahas_dec_arg(r, ps, subvars, guarded)

fn afn_calls_self(nm, e) = match e
    Call(cnm, args) => if cnm == nm then 1 else afn_calls_args(nm, args)
    Bin(op, l, r)   => if afn_calls_self(nm, l) == 1 then 1 else afn_calls_self(nm, r)
    If(c, t, e2)    => if afn_calls_self(nm, c) == 1 then 1 else if afn_calls_self(nm, t) == 1 then 1 else afn_calls_self(nm, e2)
    LetIn(x, v, b)  => if afn_calls_self(nm, v) == 1 then 1 else afn_calls_self(nm, b)
    VarIn(x, v, b)  => if afn_calls_self(nm, v) == 1 then 1 else afn_calls_self(nm, b)
    Match(sc, arms) => if afn_calls_self(nm, sc) == 1 then 1 else afn_calls_arms(nm, arms)
    _               => 0

fn afn_calls_args(nm, xs) = match xs
    Nil        => 0
    Cons(h, t) => if afn_calls_self(nm, h) == 1 then 1 else afn_calls_args(nm, t)

fn afn_calls_arms(nm, xs) = match xs
    Nil        => 0
    Cons(h, t) => if afn_calls_self(nm, h.body) == 1 then 1 else afn_calls_arms(nm, t)

fn ais_fn_marked_total(nm, osigs) = match osiglookup(nm, osigs)
    Nil        => 0
    Cons(sg, r) => ois_total(sg.freef)

fn ais_nontotal_rec(cnm, fns, osigs) = if ais_fn_marked_total(cnm, osigs) == 1 then 0 else ais_nontotal_rec2(cnm, fns)

fn ais_nontotal_rec2(cnm, fns) = match fns
    Nil        => 0
    Cons(f, r) => if f.nm == cnm then afn_calls_self(cnm, f.body) else ais_nontotal_rec2(cnm, r)

fn amatch_is_param(sc, ps, subvars) = match sc
    Var(x) => if omem(x, ps) == 1 or omem(x, subvars) == 1 then 1 else 0
    _      => 0

fn achk_total_e(e, tctx, subvars, guarded) = match e
    Call(cnm, args) => let z = achk_total_args(args, tctx, subvars, guarded) in if cnm == tctx.fnm then (if ahas_dec_arg(args, tctx.ps, subvars, guarded) == 1 then 1 else ctfail("lume: totality error [A0002]: cannot prove termination of 'total fn " + tctx.fnm + "': recursive call '" + cnm + "(...)' does not decrease any parameter (fix-it: recurse on a structural pattern subterm or a guarded 'n - 1' measure)\n")) else if ais_nontotal_rec(cnm, tctx.fns, tctx.osigs) == 1 then ctfail("lume: totality error [A0002]: 'total fn " + tctx.fnm + "' cannot call non-total recursive function '" + cnm + "' (fix-it: mark 'total fn " + cnm + "' and prove its termination)\n") else 1
    If(c, t, e2)    => let g2 = aguard_params(tctx.ps, c, guarded) in achk_total_e(c, tctx, subvars, guarded) + achk_total_e(t, tctx, subvars, g2) + achk_total_e(e2, tctx, subvars, g2)
    Bin(op, l, r)   => achk_total_e(l, tctx, subvars, guarded) + achk_total_e(r, tctx, subvars, guarded)
    LetIn(nm, v, b) => achk_total_e(v, tctx, subvars, guarded) + achk_total_e(b, tctx, subvars, guarded)
    VarIn(nm, v, b) => achk_total_e(v, tctx, subvars, guarded) + achk_total_e(b, tctx, subvars, guarded)
    DeferE(c, b)    => achk_total_e(c, tctx, subvars, guarded) + achk_total_e(b, tctx, subvars, guarded)
    ErrDeferE(c, b) => achk_total_e(c, tctx, subvars, guarded) + achk_total_e(b, tctx, subvars, guarded)
    WithAllocE(a, b) => achk_total_e(a, tctx, subvars, guarded) + achk_total_e(b, tctx, subvars, guarded)
    Match(sc, arms) => achk_total_e(sc, tctx, subvars, guarded) + achk_total_arms(arms, amatch_is_param(sc, tctx.ps, subvars), tctx, subvars, guarded)
    _               => 0

fn achk_total_args(args, tctx, subvars, guarded) = match args
    Nil        => 0
    Cons(h, t) => achk_total_e(h, tctx, subvars, guarded) + achk_total_args(t, tctx, subvars, guarded)

fn achk_total_arms(arms, is_p, tctx, subvars, guarded) = match arms
    Nil        => 0
    Cons(h, t) => let sv2 = if is_p == 1 then app(apat_subvars(h.pat), subvars) else subvars in achk_total_e(h.body, tctx, sv2, guarded) + achk_total_arms(t, is_p, tctx, subvars, guarded)

## ============================================================================================================
## Track A3: Provenance & uncertainty in the type (`unverified[T]`, `llm fn`, `prob_sample`) (`[A0003]`)
## ============================================================================================================
fn auinit_vars(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, pr) => if ois_unverified_ty(ohd_ty(pts)) == 1 then Cons(pn, auinit_vars(pr, ptl(pts))) else auinit_vars(pr, ptl(pts))

fn auinit_from_sig(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => auinit_vars(sg.pn, sg.pt)

fn ais_unverified_fn(cnm, osigs, sigs) = if cnm == "llm_complete" or cnm == "prob_sample" then 1 else if ais_llm_osig(osiglookup(cnm, osigs)) == 1 then 1 else ais_unverified_ret(tsiglookup(cnm, sigs))

fn ais_llm_osig(msig) = match msig
    Nil        => 0
    Cons(sg, r) => ois_llm(sg.freef)

fn ais_unverified_ret(msig) = match msig
    Nil        => 0
    Cons(sg, r) => ois_unverified_ty(sg.rt)

fn ais_trusted_sink(cnm, osigs) = if cnm == "io_write" or cnm == "db_exec" or cnm == "net_send" or cnm == "fs_write" or cnm == "trusted_sink" or cnm == "law_assert" then 1 else ais_pub_nonllm(osiglookup(cnm, osigs))

fn ais_pub_nonllm(msig) = match msig
    Nil        => 0
    Cons(sg, r) => if sg.pubf == 1 and ois_llm(sg.freef) == 0 then 1 else 0

fn asig_pts(cnm, sigs) = match tsiglookup(cnm, sigs)
    Nil        => Nil
    Cons(sg, r) => sg.pt

fn ais_cmp_guard(c) = match c
    Bin(op, l, r) => if tiscmp(op) == 1 then 1 else 0
    _             => 0

fn adischarge_vars(uvars, c) = if ais_cmp_guard(c) == 0 then uvars else adischarge_vars2(uvars, c)

fn adischarge_vars2(uvars, c) = match uvars
    Nil        => Nil
    Cons(v, r) => if omentions_var(v, c) == 1 then adischarge_vars2(r, c) else Cons(v, adischarge_vars2(r, c))

fn achk_prov_e(e, fnm, uvars, ot) = match e
    Var(x)           => omem(x, uvars)
    Field(o, fld)    => achk_prov_e(o, fnm, uvars, ot)
    OwnE(inner)      => achk_prov_e(inner, fnm, uvars, ot)
    MutE(inner)      => achk_prov_e(inner, fnm, uvars, ot)
    Bin(op, l, r)    => let tl = achk_prov_e(l, fnm, uvars, ot) in let tr = achk_prov_e(r, fnm, uvars, ot) in if tl == 1 or tr == 1 then 1 else 0
    If(c, t, e2)     => let tc = achk_prov_e(c, fnm, uvars, ot) in let uvt = adischarge_vars(uvars, c) in let tt = achk_prov_e(t, fnm, uvt, ot) in let te = achk_prov_e(e2, fnm, uvars, ot) in if tt == 1 or te == 1 then 1 else 0
    LetIn(nm, v, b)  => let tv = achk_prov_e(v, fnm, uvars, ot) in let uv2 = if tv == 1 then Cons(nm, orem(nm, uvars)) else orem(nm, uvars) in achk_prov_e(b, fnm, uv2, ot)
    VarIn(nm, v, b)  => let tv = achk_prov_e(v, fnm, uvars, ot) in let uv2 = if tv == 1 then Cons(nm, orem(nm, uvars)) else orem(nm, uvars) in achk_prov_e(b, fnm, uv2, ot)
    DeferE(c, b)     => let tc = achk_prov_e(c, fnm, uvars, ot) in achk_prov_e(b, fnm, uvars, ot)
    ErrDeferE(c, b)  => let tc = achk_prov_e(c, fnm, uvars, ot) in achk_prov_e(b, fnm, uvars, ot)
    WithAllocE(a, b) => let ta = achk_prov_e(a, fnm, uvars, ot) in achk_prov_e(b, fnm, uvars, ot)
    Match(sc, arms)  => let tsc = achk_prov_e(sc, fnm, uvars, ot) in achk_prov_arms(arms, tsc, fnm, uvars, ot)
    Call(cnm, args)  => achk_prov_call(cnm, args, fnm, uvars, ot)
    _                => 0

fn achk_prov_arms(arms, tsc, fnm, uvars, ot) = match arms
    Nil        => 0
    Cons(h, t) => let uv2 = if tsc == 1 then app(apat_binds(h.pat), uvars) else uvars in let tb = achk_prov_e(h.body, fnm, uv2, ot) in let tr = achk_prov_arms(t, tsc, fnm, uvars, ot) in if tb == 1 or tr == 1 then 1 else 0

fn achk_prov_args(args, fnm, uvars, ot) = match args
    Nil        => 0
    Cons(h, t) => let th = achk_prov_e(h, fnm, uvars, ot) in let tt = achk_prov_args(t, fnm, uvars, ot) in if th == 1 or tt == 1 then 1 else 0

fn achk_sink_args(fnm, cnm, args, pts, uvars, ot) = match args
    Nil        => 0
    Cons(a, r) => let ta = achk_prov_e(a, fnm, uvars, ot) in if ta == 1 and ois_unverified_ty(ohd_ty(pts)) == 0 then ctfail("lume: provenance error [A0003]: unverified AI/probabilistic value in '" + fnm + "' cannot flow into trusted sink '" + cnm + "' without verification (fix-it: validate with 'verify(x, <contract>)' before calling '" + cnm + "')\n") else achk_sink_args(fnm, cnm, r, ptl(pts), uvars, ot)

fn achk_prov_call(cnm, args, fnm, uvars, ot) = if cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" then let z = achk_prov_args(args, fnm, uvars, ot) in 0 else if ais_trusted_sink(cnm, ot.osigs) == 1 then let z = achk_sink_args(fnm, cnm, args, asig_pts(cnm, ot.sigs), uvars, ot) in ais_unverified_fn(cnm, ot.osigs, ot.sigs) else let ta = achk_prov_args(args, fnm, uvars, ot) in if ais_unverified_fn(cnm, ot.osigs, ot.sigs) == 1 or ta == 1 then 1 else 0

## ============================================================================================================
## Track S1: Structured concurrency (`scope` / `spawn`) & static `Send`/`Sync` checking (`[S0001]`)
## ============================================================================================================
fn sis_nonsend_ty(ty) = match ty
    TyApply(n, e) => if n == "rc" or n == "cell" or n == "Ref" then 1 else sis_nonsend_ty(e)
    TyList(e)     => sis_nonsend_ty(e)
    _             => 0

fn sis_nonsend_init(e) = match e
    Call(cnm, args) => if cnm == "rc_new" or cnm == "cell_new" or cnm == "borrow_mut" then 1 else 0
    MutE(inner)     => 1
    _               => 0

fn sinit_nonsend(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, r) => if sis_nonsend_ty(ohd_ty(pts)) == 1 then Cons(pn, sinit_nonsend(r, ptl(pts))) else sinit_nonsend(r, ptl(pts))

fn sinit_nonsend_sig(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => sinit_nonsend(sg.pn, sg.pt)

fn schk_spawn_body(e, fnm, nsvars, mvars) = match e
    Var(x)                  => if omem(x, nsvars) == 1 then ctfail("lume: concurrency error [S0001]: cannot capture non-Send value '" + x + "' across 'spawn' in '" + fnm + "' (fix-it: use 'arc_new' instead of 'rc_new'/'cell_new' or pass an owned message over 'chan[T]')\n") else if omem(x, mvars) == 1 then ctfail("lume: concurrency error [S0001]: cannot capture mutable binding '" + x + "' across 'spawn' in '" + fnm + "' without 'own' transfer (fix-it: move ownership with 'own " + x + "' or share via 'arc[T]' / 'chan[T]')\n") else 0
    OwnE(inner)             => schk_spawn_own(inner, fnm, nsvars)
    MutE(inner)             => ctfail("lume: concurrency error [S0001]: cannot capture mutable borrow 'mut' across 'spawn' in '" + fnm + "' (fix-it: transfer ownership with 'own' or synchronize via 'chan[T]')\n")
    Field(o, fld)           => schk_spawn_body(o, fnm, nsvars, mvars)
    Bin(op, l, r)           => schk_spawn_body(l, fnm, nsvars, mvars) + schk_spawn_body(r, fnm, nsvars, mvars)
    If(c, t, e2)            => schk_spawn_body(c, fnm, nsvars, mvars) + schk_spawn_body(t, fnm, nsvars, mvars) + schk_spawn_body(e2, fnm, nsvars, mvars)
    LetIn(nm, v, b)         => schk_spawn_body(v, fnm, nsvars, mvars) + schk_spawn_body(b, fnm, orem(nm, nsvars), orem(nm, mvars))
    VarIn(nm, v, b)         => schk_spawn_body(v, fnm, nsvars, mvars) + schk_spawn_body(b, fnm, orem(nm, nsvars), orem(nm, mvars))
    Call(cnm, args)         => if cnm == "borrow_mut" then ctfail("lume: concurrency error [S0001]: cannot capture mutable borrow 'borrow_mut' across 'spawn' in '" + fnm + "' (fix-it: transfer ownership with 'own' or synchronize via 'chan[T]')\n") else schk_spawn_args(args, fnm, nsvars, mvars)
    ScopeE(snm, b)          => schk_spawn_body(b, fnm, nsvars, mvars)
    SpawnE(inner)           => schk_spawn_body(inner, fnm, nsvars, mvars)
    _                       => 0

fn schk_spawn_own(inner, fnm, nsvars) = match inner
    Var(x) => if omem(x, nsvars) == 1 then ctfail("lume: concurrency error [S0001]: cannot transfer non-Send value '" + x + "' across 'spawn' in '" + fnm + "' (fix-it: convert 'rc[T]'/'cell[T]' to 'arc[T]')\n") else 0
    _      => schk_spawn_body(inner, fnm, nsvars, Nil)

fn schk_spawn_args(args, fnm, nsvars, mvars) = match args
    Nil        => 0
    Cons(h, t) => schk_spawn_body(h, fnm, nsvars, mvars) + schk_spawn_args(t, fnm, nsvars, mvars)

fn schk_conc_e(e, fnm, in_scope, nsvars, mvars) = match e
    ScopeE(snm, b)          => schk_conc_e(b, fnm, 1, nsvars, mvars)
    SpawnE(inner)           => if in_scope == 0 then ctfail("lume: concurrency error [S0001]: unstructured 'spawn' in '" + fnm + "' is forbidden outside a lexical 'scope' block (fix-it: wrap the task in 'scope s in spawn(...)')\n") else schk_spawn_body(inner, fnm, nsvars, mvars) + schk_conc_e(inner, fnm, in_scope, nsvars, mvars)
    LetIn(nm, v, b)         => let z1 = schk_conc_e(v, fnm, in_scope, nsvars, mvars) in let ns2 = if sis_nonsend_init(v) == 1 then Cons(nm, orem(nm, nsvars)) else orem(nm, nsvars) in schk_conc_e(b, fnm, in_scope, ns2, orem(nm, mvars))
    VarIn(nm, v, b)         => let z1 = schk_conc_e(v, fnm, in_scope, nsvars, mvars) in let ns2 = if sis_nonsend_init(v) == 1 then Cons(nm, orem(nm, nsvars)) else orem(nm, nsvars) in schk_conc_e(b, fnm, in_scope, ns2, Cons(nm, orem(nm, mvars)))
    Bin(op, l, r)           => schk_conc_e(l, fnm, in_scope, nsvars, mvars) + schk_conc_e(r, fnm, in_scope, nsvars, mvars)
    If(c, t, e2)            => schk_conc_e(c, fnm, in_scope, nsvars, mvars) + schk_conc_e(t, fnm, in_scope, nsvars, mvars) + schk_conc_e(e2, fnm, in_scope, nsvars, mvars)
    DeferE(c, b)            => schk_conc_e(c, fnm, in_scope, nsvars, mvars) + schk_conc_e(b, fnm, in_scope, nsvars, mvars)
    ErrDeferE(c, b)         => schk_conc_e(c, fnm, in_scope, nsvars, mvars) + schk_conc_e(b, fnm, in_scope, nsvars, mvars)
    WithAllocE(a, b)        => schk_conc_e(a, fnm, in_scope, nsvars, mvars) + schk_conc_e(b, fnm, in_scope, nsvars, mvars)
    WithHandlerE(en, hs, b) => schk_conc_e(b, fnm, in_scope, nsvars, mvars)
    Call(cnm, args)         => if cnm == "spawn_task" and in_scope == 0 then ctfail("lume: concurrency error [S0001]: unstructured 'spawn_task' in '" + fnm + "' is forbidden outside a lexical 'scope' block (fix-it: wrap the task in 'scope s in ...')\n") else if cnm == "spawn_task" then schk_spawn_args(args, fnm, nsvars, mvars) else schk_conc_args(args, fnm, in_scope, nsvars, mvars)
    Match(sc, arms)         => schk_conc_e(sc, fnm, in_scope, nsvars, mvars) + schk_conc_arms(arms, fnm, in_scope, nsvars, mvars)
    _                       => 0

fn schk_conc_args(args, fnm, in_scope, nsvars, mvars) = match args
    Nil        => 0
    Cons(h, t) => schk_conc_e(h, fnm, in_scope, nsvars, mvars) + schk_conc_args(t, fnm, in_scope, nsvars, mvars)

fn schk_conc_arms(arms, fnm, in_scope, nsvars, mvars) = match arms
    Nil        => 0
    Cons(h, t) => schk_conc_e(h.body, fnm, in_scope, nsvars, mvars) + schk_conc_arms(t, fnm, in_scope, nsvars, mvars)

## ============================================================================================================
## Track V: Contract Verification (`requires` / `ensures` / `invariant` / `old`), QF_LIA Prover & `law` (`[V0001]`)
## ============================================================================================================
fn vcollect_vsigs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => vcollect_vsig1(h, vcollect_vsigs(t))

fn vcollect_vsig1(st, rest) = match st
    VContractSig(nm, ps, reqs, enss) => Cons({nm: nm, ps: ps, reqs: reqs, enss: enss}, rest)
    _                                => rest

fn vcollect_invs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => vcollect_inv1(h, vcollect_invs(t))

fn vcollect_inv1(st, rest) = match st
    VTypeInvariant(nm, fs, inv) => Cons({nm: nm, fs: fs, inv: inv}, rest)
    _                           => rest

fn vsiglookup(nm, vsigs) = match vsigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else vsiglookup(nm, t)

fn vinvlookup(nm, invs) = match invs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else vinvlookup(nm, t)

fn vfnlookup(nm, fns) = match fns
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else vfnlookup(nm, t)

fn vv_int(n) = {ok: 1, i: n, fields: Nil}
fn vv_rec(fs) = {ok: 1, i: 0, fields: fs}
fn vv_err() = {ok: 0, i: 0, fields: Nil}

fn vlookup(nm, env) = match env
    Nil        => vv_err()
    Cons(h, t) => if h.k == nm then h.v else vlookup(nm, t)

fn vflookup(fld, fs) = match fs
    Nil        => vv_err()
    Cons(h, t) => if h.key == fld then h.val else vflookup(fld, t)

fn vbind_ps(ps, vs) = match ps
    Nil        => Nil
    Cons(p, r) => vbind_p1(p, r, vs)

fn vbind_p1(p, r, vs) = match vs
    Nil         => Nil
    Cons(v, vr) => Cons({k: p, v: v}, vbind_ps(r, vr))

fn vfields_env(fs) = match fs
    Nil        => Nil
    Cons(h, t) => Cons({k: h.key, v: h.val}, vfields_env(t))

fn veval_bin(op, rl, rr) = if rl.ok == 0 or rr.ok == 0 then vv_err() else let x = rl.i in let y = rr.i in if op == "+" then vv_int(x + y) else if op == "-" then vv_int(x - y) else if op == "*" then vv_int(x * y) else if op == "/" then (if y == 0 then vv_err() else vv_int(x / y)) else if op == "%" then (if y == 0 then vv_err() else vv_int(x % y)) else if op == "==" then vv_int(if x == y then 1 else 0) else if op == "!=" then vv_int(if x != y then 1 else 0) else if op == "<" then vv_int(if x < y then 1 else 0) else if op == ">" then vv_int(if x > y then 1 else 0) else if op == "<=" then vv_int(if x <= y then 1 else 0) else if op == ">=" then vv_int(if x >= y then 1 else 0) else if op == "and" then vv_int(if x != 0 and y != 0 then 1 else 0) else if op == "or" then vv_int(if x != 0 or y != 0 then 1 else 0) else vv_err()

fn vadd_hops_fns(hs, fns) = match hs
    Nil        => fns
    Cons(h, t) => Cons({nm: h.op, ps: h.ps, body: h.body}, vadd_hops_fns(t, fns))

fn veval(e, env, old_env, fns, d) = if d > 20 then vv_err() else veval1(e, env, old_env, fns, d)

fn veval1(e, env, old_env, fns, d) = match e
    Num(n)                  => vv_int(n)
    Str(s)                  => vv_int(0)
    Var(nm)                 => vlookup(nm, env)
    OwnE(inner)             => veval(inner, env, old_env, fns, d)
    MutE(inner)             => veval(inner, env, old_env, fns, d)
    CT(inner)               => veval(inner, env, old_env, fns, d)
    WithHandlerE(en, hs, b) => veval(b, env, old_env, vadd_hops_fns(hs, fns), d)
    ScopeE(snm, b)          => veval(b, Cons({k: snm, v: vv_int(1)}, env), old_env, fns, d)
    SpawnE(inner)           => veval(inner, env, old_env, fns, d)
    Bin(op, l, r)           => veval_bin(op, veval(l, env, old_env, fns, d), veval(r, env, old_env, fns, d))
    If(c, t, e2)            => let rc = veval(c, env, old_env, fns, d) in if rc.ok == 0 then vv_err() else if rc.i != 0 then veval(t, env, old_env, fns, d) else veval(e2, env, old_env, fns, d)
    LetIn(nm, v, b)         => let rv = veval(v, env, old_env, fns, d) in if rv.ok == 0 then vv_err() else veval(b, Cons({k: nm, v: rv}, env), old_env, fns, d)
    VarIn(nm, v, b)         => let rv = veval(v, env, old_env, fns, d) in if rv.ok == 0 then vv_err() else veval(b, Cons({k: nm, v: rv}, env), old_env, fns, d)
    Rec(items)              => veval_rec(items, env, old_env, fns, d)
    RecT(tn, items)         => veval_rec(items, env, old_env, fns, d)
    Field(o, fld)           => let ro = veval(o, env, old_env, fns, d) in if ro.ok == 0 then vv_err() else vflookup(fld, ro.fields)
    Call(cnm, args)         => veval_call(cnm, args, env, old_env, fns, d)
    _                       => vv_err()

fn veval_rec(items, env, old_env, fns, d) = match items
    Nil        => vv_rec(Nil)
    Cons(h, t) => let rv = veval(h.val, env, old_env, fns, d) in if rv.ok == 0 then vv_err() else let rt = veval_rec(t, env, old_env, fns, d) in if rt.ok == 0 then vv_err() else vv_rec(Cons({key: h.key, val: rv}, rt.fields))

fn veval_args(args, env, old_env, fns, d) = match args
    Nil        => {ok: 1, vals: Nil}
    Cons(h, t) => let rh = veval(h, env, old_env, fns, d) in if rh.ok == 0 then {ok: 0, vals: Nil} else let rt = veval_args(t, env, old_env, fns, d) in if rt.ok == 0 then {ok: 0, vals: Nil} else {ok: 1, vals: Cons(rh, rt.vals)}

fn veval_call(cnm, args, env, old_env, fns, d) = if cnm == "old" and len(args) == 1 then veval(ohd_e(args), old_env, old_env, fns, d) else if (cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" or cnm == "borrow" or cnm == "borrow_mut" or cnm == "move" or cnm == "clone") and len(args) >= 1 then veval(ohd_e(args), env, old_env, fns, d) else if cnm == "dec_add" and len(args) == 2 then veval_bin("+", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_sub" and len(args) == 2 then veval_bin("-", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_eq" and len(args) == 2 then veval_bin("==", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_lt" and len(args) == 2 then veval_bin("<", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_le" and len(args) == 2 then veval_bin("<=", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_gt" and len(args) == 2 then veval_bin(">", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_ge" and len(args) == 2 then veval_bin(">=", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else veval_ufn(vfnlookup(cnm, fns), veval_args(args, env, old_env, fns, d), fns, d)

fn veval_ufn(mf, ra, fns, d) = match mf
    Nil        => vv_err()
    Cons(f, r) => if ra.ok == 0 then vv_err() else let fenv = vbind_ps(f.ps, ra.vals) in veval(f.body, fenv, fenv, fns, d + 1)

fn vpts_a() = Cons(0, Cons(1, Cons(0 - 1, Nil)))
fn vpts_b() = Cons(0, Cons(1, Nil))
fn vpts_c() = Cons(0, Cons(1, Nil))
fn vpts_for(idx, total) = if total <= 1 then vpts_a() else if total == 2 then vpts_b() else if idx < 3 then vpts_c() else Cons(0, Nil)

fn vgen_envs(ps, idx, total) = match ps
    Nil        => Cons(Nil, Nil)
    Cons(p, r) => vcross_p(p, vpts_for(idx, total), vgen_envs(r, idx + 1, total))

fn vcross_p(p, pts, envs) = match pts
    Nil         => Nil
    Cons(x, xr) => app(vbind_all(p, vv_int(x), envs), vcross_p(p, xr, envs))

fn vbind_all(p, v, envs) = match envs
    Nil         => Nil
    Cons(e, er) => Cons(Cons({k: p, v: v}, e), vbind_all(p, v, er))

fn vfmt_env(env) = match env
    Nil        => ""
    Cons(h, t) => let s = h.k + " = " + str((h.v).i) in if isnil(t) == 1 then s else s + ", " + vfmt_env(t)

fn veval_all_true(es, env, old_env, fns) = match es
    Nil        => {ok: 1, hold: 1}
    Cons(h, t) => let rh = veval(h, env, old_env, fns, 0) in if rh.ok == 0 then {ok: 0, hold: 0} else if rh.i == 0 then {ok: 1, hold: 0} else veval_all_true(t, env, old_env, fns)

fn vprove_envs(envs, reqs, enss, body, fns, undec) = match envs
    Nil          => {status: 0, cex: ""}
    Cons(env, r) => let rq = veval_all_true(reqs, env, env, fns) in if rq.ok == 0 then vprove_envs(r, reqs, enss, body, fns, 1) else if rq.hold == 0 then vprove_envs(r, reqs, enss, body, fns, undec) else if isnil(enss) == 1 then vprove_envs(r, reqs, enss, body, fns, undec) else let rb = veval(body, env, env, fns, 0) in if rb.ok == 0 then vprove_envs(r, reqs, enss, body, fns, 1) else let penv = Cons({k: "result", v: rb}, Cons({k: "ret", v: rb}, env)) in let eq = veval_all_true(enss, penv, env, fns) in if eq.ok == 0 then vprove_envs(r, reqs, enss, body, fns, 1) else if eq.hold == 0 then {status: 0 - 1, cex: vfmt_env(env) + " (result = " + str(rb.i) + ")"} else vprove_envs(r, reqs, enss, body, fns, undec)

## --- Stage B: Sound QF_LIA (Quantifier-Free Linear Integer Arithmetic) Decision Procedure (Fourier-Motzkin) ---
fn vlin_const(n) = {ok: 1, c0: n, cs: Nil}
fn vlin_var(nm) = {ok: 1, c0: 0, cs: Cons({k: nm, c: 1}, Nil)}
fn vlin_err() = {ok: 0, c0: 0, cs: Nil}

fn vlin_coeff(nm, cs) = match cs
    Nil        => 0
    Cons(h, t) => if h.k == nm then h.c else vlin_coeff(nm, t)

fn vlin_add_term(nm, c, cs) = if c == 0 then cs else vlin_add_t1(nm, c, cs)

fn vlin_add_t1(nm, c, cs) = match cs
    Nil        => Cons({k: nm, c: c}, Nil)
    Cons(h, t) => if h.k == nm then (if h.c + c == 0 then t else Cons({k: nm, c: h.c + c}, t)) else Cons(h, vlin_add_t1(nm, c, t))

fn vlin_add_cs(cs1, cs2) = match cs1
    Nil        => cs2
    Cons(h, t) => vlin_add_cs(t, vlin_add_term(h.k, h.c, cs2))

fn vlin_scale_cs(k, cs) = if k == 0 then Nil else vlin_scale_cs1(k, cs)

fn vlin_scale_cs1(k, cs) = match cs
    Nil        => Nil
    Cons(h, t) => Cons({k: h.k, c: k * h.c}, vlin_scale_cs1(k, t))

fn vlin_add(a, b) = if a.ok == 0 or b.ok == 0 then vlin_err() else {ok: 1, c0: a.c0 + b.c0, cs: vlin_add_cs(a.cs, b.cs)}
fn vlin_scale(k, a) = if a.ok == 0 then vlin_err() else {ok: 1, c0: k * a.c0, cs: vlin_scale_cs(k, a.cs)}
fn vlin_sub(a, b) = vlin_add(a, vlin_scale(0 - 1, b))
fn vlin_mul(a, b) = if a.ok == 0 or b.ok == 0 then vlin_err() else if isnil(a.cs) == 1 then vlin_scale(a.c0, b) else if isnil(b.cs) == 1 then vlin_scale(b.c0, a) else vlin_err()

fn vlin_is_contra(l) = if l.ok == 1 and isnil(l.cs) == 1 and l.c0 < 0 then 1 else 0

fn vfm_any_contra(hyps) = match hyps
    Nil        => 0
    Cons(h, t) => if vlin_is_contra(h) == 1 then 1 else vfm_any_contra(t)

fn vfm_vars_cs(cs, acc) = match cs
    Nil        => acc
    Cons(h, t) => vfm_vars_cs(t, if omem(h.k, acc) == 1 then acc else Cons(h.k, acc))

fn vfm_vars(hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => vfm_vars(t, vfm_vars_cs(h.cs, acc))

fn vfm_part_pos(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if vlin_coeff(v, h.cs) > 0 then Cons(h, vfm_part_pos(v, t)) else vfm_part_pos(v, t)

fn vfm_part_neg(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if vlin_coeff(v, h.cs) < 0 then Cons(h, vfm_part_neg(v, t)) else vfm_part_neg(v, t)

fn vfm_part_zer(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if vlin_coeff(v, h.cs) == 0 then Cons(h, vfm_part_zer(v, t)) else vfm_part_zer(v, t)

fn vfm_pair1(v, p, cp, negs) = match negs
    Nil        => Nil
    Cons(n, r) => let cn = 0 - vlin_coeff(v, n.cs) in Cons(vlin_add(vlin_scale(cn, p), vlin_scale(cp, n)), vfm_pair1(v, p, cp, r))

fn vfm_pairs(v, pos, negs) = match pos
    Nil        => Nil
    Cons(p, r) => let pairs1 = vfm_pair1(v, p, vlin_coeff(v, p.cs), negs) in if len(pairs1) > 24 then pairs1 else app(pairs1, vfm_pairs(v, r, negs))

fn vfm_elim_var(v, hyps) = app(vfm_part_zer(v, hyps), vfm_pairs(v, vfm_part_pos(v, hyps), vfm_part_neg(v, hyps)))

fn vfm_unsat(hyps, vars) = if vfm_any_contra(hyps) == 1 then 1 else vfm_unsat1(hyps, vars)

fn vfm_unsat1(hyps, vars) = match vars
    Nil        => vfm_any_contra(hyps)
    Cons(v, r) => let next = vfm_elim_var(v, hyps) in if vfm_any_contra(next) == 1 then 1 else if len(next) > 48 then 0 else vfm_unsat(next, r)

fn vfm_check_unsat(hyps) = vfm_unsat(hyps, vfm_vars(hyps, Nil))

fn vlin_init_env(ps) = match ps
    Nil        => Nil
    Cons(p, r) => Cons({k: p, v: vlin_var(p)}, vlin_init_env(r))

fn vlin_lookup(nm, lenv) = match lenv
    Nil        => vlin_err()
    Cons(h, t) => if h.k == nm then h.v else vlin_lookup(nm, t)

fn vlin_bind_ps(ps, vs) = match ps
    Nil        => Nil
    Cons(p, r) => vlin_bind_p1(p, r, vs)

fn vlin_bind_p1(p, r, vs) = match vs
    Nil         => Nil
    Cons(v, vr) => Cons({k: p, v: v}, vlin_bind_ps(r, vr))

fn vlin_expr(e, hyps, lenv, fns, d) = if d > 6 then vlin_err() else vlin_expr1(e, hyps, lenv, fns, d)

fn vlin_expr1(e, hyps, lenv, fns, d) = match e
    Num(n)          => vlin_const(n)
    Var(nm)         => vlin_lookup(nm, lenv)
    OwnE(inner)     => vlin_expr(inner, hyps, lenv, fns, d)
    MutE(inner)     => vlin_expr(inner, hyps, lenv, fns, d)
    CT(inner)       => vlin_expr(inner, hyps, lenv, fns, d)
    DeferE(c, b)    => vlin_expr(b, hyps, lenv, fns, d)
    ErrDeferE(c, b) => vlin_expr(b, hyps, lenv, fns, d)
    LetIn(nm, v, b) => let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then vlin_err() else vlin_expr(b, hyps, Cons({k: nm, v: lv}, lenv), fns, d)
    VarIn(nm, v, b) => let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then vlin_err() else vlin_expr(b, hyps, Cons({k: nm, v: lv}, lenv), fns, d)
    Bin(op, l, r)   => if op == "+" then vlin_add(vlin_expr(l, hyps, lenv, fns, d), vlin_expr(r, hyps, lenv, fns, d)) else if op == "-" then vlin_sub(vlin_expr(l, hyps, lenv, fns, d), vlin_expr(r, hyps, lenv, fns, d)) else if op == "*" then vlin_mul(vlin_expr(l, hyps, lenv, fns, d), vlin_expr(r, hyps, lenv, fns, d)) else vlin_err()
    If(c, t, e2)    => let rp = vcond_pos(c, hyps, lenv, fns, d) in let rn = vcond_neg(c, hyps, lenv, fns, d) in if rp.ok == 1 and rn.ok == 1 and vfm_check_unsat(app(rn.hyps, hyps)) == 1 then vlin_expr(t, hyps, lenv, fns, d) else if rp.ok == 1 and rn.ok == 1 and vfm_check_unsat(app(rp.hyps, hyps)) == 1 then vlin_expr(e2, hyps, lenv, fns, d) else vlin_err()
    Call(cnm, args) => vlin_call(cnm, args, hyps, lenv, fns, d)
    _               => vlin_err()

fn vlin_args(args, hyps, lenv, fns, d) = match args
    Nil        => {ok: 1, vals: Nil}
    Cons(h, t) => let rh = vlin_expr(h, hyps, lenv, fns, d) in if rh.ok == 0 then {ok: 0, vals: Nil} else let rt = vlin_args(t, hyps, lenv, fns, d) in if rt.ok == 0 then {ok: 0, vals: Nil} else {ok: 1, vals: Cons(rh, rt.vals)}

fn vlin_call(cnm, args, hyps, lenv, fns, d) = if cnm == "old" and len(args) == 1 then vlin_expr(ohd_e(args), hyps, lenv, fns, d) else if (cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" or cnm == "borrow" or cnm == "borrow_mut" or cnm == "move" or cnm == "clone") and len(args) >= 1 then vlin_expr(ohd_e(args), hyps, lenv, fns, d) else if cnm == "dec_add" and len(args) == 2 then vlin_add(vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_sub" and len(args) == 2 then vlin_sub(vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else vlin_ufn(vfnlookup(cnm, fns), vlin_args(args, hyps, lenv, fns, d), hyps, fns, d)

fn vlin_ufn(mf, ra, hyps, fns, d) = match mf
    Nil        => vlin_err()
    Cons(f, r) => if ra.ok == 0 then vlin_err() else vlin_expr(f.body, hyps, vlin_bind_ps(f.ps, ra.vals), fns, d + 1)

fn vcond_cmp_pos(op, la, lb) = if la.ok == 0 or lb.ok == 0 then {ok: 0, hyps: Nil} else if op == ">=" then {ok: 1, hyps: Cons(vlin_sub(la, lb), Nil)} else if op == ">" then {ok: 1, hyps: Cons(vlin_sub(vlin_sub(la, lb), vlin_const(1)), Nil)} else if op == "<=" then {ok: 1, hyps: Cons(vlin_sub(lb, la), Nil)} else if op == "<" then {ok: 1, hyps: Cons(vlin_sub(vlin_sub(lb, la), vlin_const(1)), Nil)} else if op == "==" then {ok: 1, hyps: Cons(vlin_sub(la, lb), Cons(vlin_sub(lb, la), Nil))} else {ok: 0, hyps: Nil}

fn vcond_cmp_neg(op, la, lb) = if la.ok == 0 or lb.ok == 0 then {ok: 0, hyps: Nil} else if op == ">=" then vcond_cmp_pos("<", la, lb) else if op == ">" then vcond_cmp_pos("<=", la, lb) else if op == "<=" then vcond_cmp_pos(">", la, lb) else if op == "<" then vcond_cmp_pos(">=", la, lb) else if op == "!=" then vcond_cmp_pos("==", la, lb) else {ok: 0, hyps: Nil}

fn vcond_pos(e, hyps, lenv, fns, d) = match e
    Bin(op, a, b)   => if op == "and" then (let r1 = vcond_pos(a, hyps, lenv, fns, d) in let r2 = vcond_pos(b, hyps, lenv, fns, d) in if r1.ok == 1 and r2.ok == 1 then {ok: 1, hyps: app(r1.hyps, r2.hyps)} else {ok: 0, hyps: Nil}) else vcond_cmp_pos(op, vlin_expr(a, hyps, lenv, fns, d), vlin_expr(b, hyps, lenv, fns, d))
    Call(cnm, args) => if cnm == "dec_eq" and len(args) == 2 then vcond_cmp_pos("==", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_ge" and len(args) == 2 then vcond_cmp_pos(">=", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_gt" and len(args) == 2 then vcond_cmp_pos(">", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_le" and len(args) == 2 then vcond_cmp_pos("<=", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_lt" and len(args) == 2 then vcond_cmp_pos("<", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else {ok: 0, hyps: Nil}
    _               => {ok: 0, hyps: Nil}

fn vcond_neg(e, hyps, lenv, fns, d) = match e
    Bin(op, a, b)   => vcond_cmp_neg(op, vlin_expr(a, hyps, lenv, fns, d), vlin_expr(b, hyps, lenv, fns, d))
    Call(cnm, args) => if cnm == "dec_ge" and len(args) == 2 then vcond_cmp_neg(">=", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_gt" and len(args) == 2 then vcond_cmp_neg(">", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_le" and len(args) == 2 then vcond_cmp_neg("<=", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_lt" and len(args) == 2 then vcond_cmp_neg("<", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else {ok: 0, hyps: Nil}
    _               => {ok: 0, hyps: Nil}

fn vprove_reqs_hyps(reqs, lenv, fns) = match reqs
    Nil        => {ok: 1, hyps: Nil}
    Cons(h, t) => let r1 = vcond_pos(h, Nil, lenv, fns, 0) in if r1.ok == 0 then {ok: 0, hyps: Nil} else let r2 = vprove_reqs_hyps(t, lenv, fns) in if r2.ok == 0 then {ok: 0, hyps: Nil} else {ok: 1, hyps: app(r1.hyps, r2.hyps)}

fn vprove_goal(g, hyps, lenv, fns, d) = match g
    Num(n)          => if n != 0 then 1 else 0
    LetIn(nm, v, b) => let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then 0 else vprove_goal(b, hyps, Cons({k: nm, v: lv}, lenv), fns, d)
    VarIn(nm, v, b) => let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then 0 else vprove_goal(b, hyps, Cons({k: nm, v: lv}, lenv), fns, d)
    DeferE(c, b)    => vprove_goal(b, hyps, lenv, fns, d)
    ErrDeferE(c, b) => vprove_goal(b, hyps, lenv, fns, d)
    If(c, t, e2)    => let rp = vcond_pos(c, hyps, lenv, fns, d) in let rn = vcond_neg(c, hyps, lenv, fns, d) in if rp.ok == 1 and vprove_goal(t, app(rp.hyps, hyps), lenv, fns, d) == 1 and (vprove_goal(e2, hyps, lenv, fns, d) == 1 or (rn.ok == 1 and vprove_goal(e2, app(rn.hyps, hyps), lenv, fns, d) == 1)) then 1 else 0
    Bin(op, a, b)   => if op == "and" then (if vprove_goal(a, hyps, lenv, fns, d) == 1 and vprove_goal(b, hyps, lenv, fns, d) == 1 then 1 else 0) else if op == "or" then (let rna = vcond_neg(a, hyps, lenv, fns, d) in if rna.ok == 1 and vprove_goal(b, app(rna.hyps, hyps), lenv, fns, d) == 1 then 1 else let rnb = vcond_neg(b, hyps, lenv, fns, d) in if rnb.ok == 1 and vprove_goal(a, app(rnb.hyps, hyps), lenv, fns, d) == 1 then 1 else 0) else if op == "==" then (if vprove_goal(Bin(">=", a, b), hyps, lenv, fns, d) == 1 and vprove_goal(Bin("<=", a, b), hyps, lenv, fns, d) == 1 then 1 else 0) else (let rn = vcond_neg(g, hyps, lenv, fns, d) in if rn.ok == 1 then vfm_check_unsat(app(rn.hyps, hyps)) else 0)
    Call(cnm, args) => if cnm == "dec_eq" and len(args) == 2 then vprove_goal(Bin("==", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "dec_ge" and len(args) == 2 then vprove_goal(Bin(">=", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "dec_gt" and len(args) == 2 then vprove_goal(Bin(">", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "dec_le" and len(args) == 2 then vprove_goal(Bin("<=", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "dec_lt" and len(args) == 2 then vprove_goal(Bin("<", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else 0
    _               => 0

fn vprove_goals_all(enss, hyps, lenv, fns, d) = match enss
    Nil        => 1
    Cons(h, t) => if vprove_goal(h, hyps, lenv, fns, d) == 1 then vprove_goals_all(t, hyps, lenv, fns, d) else 0

fn vprove_body(body, hyps, lenv, enss, fns, d) = match body
    LetIn(nm, v, b) => let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then 0 else vprove_body(b, hyps, Cons({k: nm, v: lv}, lenv), enss, fns, d)
    VarIn(nm, v, b) => let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then 0 else vprove_body(b, hyps, Cons({k: nm, v: lv}, lenv), enss, fns, d)
    DeferE(c, b)    => vprove_body(b, hyps, lenv, enss, fns, d)
    ErrDeferE(c, b) => vprove_body(b, hyps, lenv, enss, fns, d)
    If(c, t, e2)    => let rp = vcond_pos(c, hyps, lenv, fns, d) in let rn = vcond_neg(c, hyps, lenv, fns, d) in if rp.ok == 1 and rn.ok == 1 and vprove_body(t, app(rp.hyps, hyps), lenv, enss, fns, d) == 1 and vprove_body(e2, app(rn.hyps, hyps), lenv, enss, fns, d) == 1 then 1 else 0
    _               => let lb = vlin_expr(body, hyps, lenv, fns, d) in if lb.ok == 0 then 0 else let penv = Cons({k: "result", v: lb}, Cons({k: "ret", v: lb}, lenv)) in vprove_goals_all(enss, hyps, penv, fns, d)

fn vqflia_prove_fn(ps, reqs, enss, body, fns) = if isnil(enss) == 1 then 0 else let lenv = vlin_init_env(ps) in let rh = vprove_reqs_hyps(reqs, lenv, fns) in if rh.ok == 0 then 0 else vprove_body(body, rh.hyps, lenv, enss, fns, 0)

fn vqflia_prove_law(ps, body, fns) = let lenv = vlin_init_env(ps) in if vprove_goal(body, Nil, lenv, fns, 0) == 1 then 1 else if len(ps) == 1 then let p0 = vlin_var(phd(ps)) in let hneg = Cons(vlin_sub(vlin_const(0 - 1), p0), Nil) in let hpos = Cons(p0, Nil) in if vprove_goal(body, hneg, lenv, fns, 0) == 1 and vprove_goal(body, hpos, lenv, fns, 0) == 1 then 1 else 0 else 0

fn vneg_goal_hyps(g, hyps, lenv, fns, d) = match g
    Bin(op, a, b) => if op == "and" then app(vneg_goal_hyps(a, hyps, lenv, fns, d), vneg_goal_hyps(b, hyps, lenv, fns, d)) else if op == "==" then app((vcond_cmp_pos(">", vlin_expr(a, hyps, lenv, fns, d), vlin_expr(b, hyps, lenv, fns, d))).hyps, (vcond_cmp_pos("<", vlin_expr(a, hyps, lenv, fns, d), vlin_expr(b, hyps, lenv, fns, d))).hyps) else (vcond_neg(g, hyps, lenv, fns, d)).hyps
    _             => Nil

fn vneg_goals_hyps(enss, hyps, penv, fns, d) = match enss
    Nil        => Nil
    Cons(g, r) => app(vneg_goal_hyps(g, hyps, penv, fns, d), vneg_goals_hyps(r, hyps, penv, fns, d))

fn vcollect_body_hyps(body, hyps, lenv, enss, fns, d) = match body
    LetIn(nm, v, b) => let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then hyps else vcollect_body_hyps(b, hyps, Cons({k: nm, v: lv}, lenv), enss, fns, d)
    VarIn(nm, v, b) => let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then hyps else vcollect_body_hyps(b, hyps, Cons({k: nm, v: lv}, lenv), enss, fns, d)
    DeferE(c, b)    => vcollect_body_hyps(b, hyps, lenv, enss, fns, d)
    ErrDeferE(c, b) => vcollect_body_hyps(b, hyps, lenv, enss, fns, d)
    If(c, t, e2)    => let rp = vcond_pos(c, hyps, lenv, fns, d) in let rn = vcond_neg(c, hyps, lenv, fns, d) in app(vcollect_body_hyps(t, app(rp.hyps, hyps), lenv, enss, fns, d), vcollect_body_hyps(e2, app(rn.hyps, hyps), lenv, enss, fns, d))
    _               => let lb = vlin_expr(body, hyps, lenv, fns, d) in if lb.ok == 0 then hyps else let penv = Cons({k: "result", v: lb}, Cons({k: "ret", v: lb}, lenv)) in app(vneg_goals_hyps(enss, hyps, penv, fns, d), hyps)

fn vmem_int(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else vmem_int(x, t)

fn vadd_int_uniq(x, xs) = if vmem_int(x, xs) == 1 or len(xs) >= 6 then xs else app(xs, Cons(x, Nil))

fn vpts_from_hyps(p, hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => let c = vlin_coeff(p, h.cs) in if c == 0 then vpts_from_hyps(p, t, acc) else let b = (0 - h.c0) / c in vpts_from_hyps(p, t, vadd_int_uniq(b + 1, vadd_int_uniq(b, acc)))

fn vfm_trace_hyps(hyps, vars) = match vars
    Nil        => hyps
    Cons(v, r) => let next = vfm_elim_var(v, hyps) in if len(next) > 32 then hyps else app(hyps, vfm_trace_hyps(next, r))

fn vgen_envs_hyps(ps, idx, total, chyps) = match ps
    Nil        => Cons(Nil, Nil)
    Cons(p, r) => vcross_p(p, vpts_from_hyps(p, chyps, vpts_for(idx, total)), vgen_envs_hyps(r, idx + 1, total, chyps))

fn vprove_fn_status(nm, ps, body, vsigs, fns) = vprove_fn1(nm, ps, body, vsiglookup(nm, vsigs), fns)

fn vprove_fn1(nm, ps, body, mvs, fns) = match mvs
    Nil          => 1
    Cons(vsg, r) => let lenv = vlin_init_env(ps) in let raw_hyps = vcollect_body_hyps(body, (vprove_reqs_hyps(vsg.reqs, lenv, fns)).hyps, lenv, vsg.enss, fns, 0) in let chyps = vfm_trace_hyps(raw_hyps, vfm_vars(raw_hyps, Nil)) in let pr = vprove_envs(vgen_envs_hyps(ps, 0, len(ps), chyps), vsg.reqs, vsg.enss, body, fns, 0) in if pr.status < 0 then ctfail("lume: contract verification error [V0001]: cannot prove 'ensures' postcondition of '" + nm + "' — refuted with counterexample: " + pr.cex + " (fix-it: strengthen 'requires' precondition or fix implementation of '" + nm + "')\n") else vqflia_prove_fn(ps, vsg.reqs, vsg.enss, body, fns)

fn vprove_law_envs(envs, body, fns) = match envs
    Nil          => {status: 1, cex: ""}
    Cons(env, r) => let rb = veval(body, env, env, fns, 0) in if rb.ok == 1 and rb.i == 0 then {status: 0 - 1, cex: vfmt_env(env)} else vprove_law_envs(r, body, fns)

fn vchk_law(nm, ps, body, fns) = let lenv = vlin_init_env(ps) in let chyps = vcollect_body_hyps(body, Nil, lenv, Cons(body, Nil), fns, 0) in let pr = vprove_law_envs(vgen_envs_hyps(ps, 0, len(ps), chyps), body, fns) in if pr.status < 0 then ctfail("lume: contract verification error [V0001]: law '" + nm + "' refuted with counterexample: " + pr.cex + " (fix-it: fix the implementation or refine law '" + nm + "')\n") else 1

fn vchk_call_req(cnm, args, fnm, mvs, fns) = match mvs
    Nil          => 0
    Cons(vsg, r) => if isnil(vsg.reqs) == 1 then 0 else let ra = veval_args(args, Nil, Nil, fns, 0) in if ra.ok == 0 then 0 else let env = vbind_ps(vsg.ps, ra.vals) in let rq = veval_all_true(vsg.reqs, env, env, fns) in if rq.ok == 1 and rq.hold == 0 then ctfail("lume: contract verification error [V0001]: call to '" + cnm + "' in '" + fnm + "' violates 'requires' precondition with counterexample: " + vfmt_env(env) + " (fix-it: ensure arguments passed to '" + cnm + "' satisfy its 'requires' contract)\n") else 0

fn vchk_rect_inv(tn, items, fnm, miv, fns) = match miv
    Nil         => 0
    Cons(iv, r) => let rr = veval_rec(items, Nil, Nil, fns, 0) in if rr.ok == 0 then 0 else let env = vfields_env(rr.fields) in let ri = veval(iv.inv, env, env, fns, 0) in if ri.ok == 1 and ri.i == 0 then ctfail("lume: contract verification error [V0001]: record construction of '" + tn + "' in '" + fnm + "' violates type 'invariant' with counterexample: " + vfmt_env(env) + " (fix-it: satisfy the 'invariant' of '" + tn + "' before constructing the record)\n") else 0

fn vchk_expr_e(e, fnm, ot) = match e
    Call(cnm, args)         => vchk_call_req(cnm, args, fnm, vsiglookup(cnm, ot.vsigs), ot.fns) + vchk_args_e(args, fnm, ot)
    RecT(tn, items)         => vchk_rect_inv(tn, items, fnm, vinvlookup(tn, ot.invs), ot.fns) + vchk_rec_e(items, fnm, ot)
    Rec(items)              => vchk_rec_e(items, fnm, ot)
    Field(o, fld)           => vchk_expr_e(o, fnm, ot)
    Bin(op, l, r)           => vchk_expr_e(l, fnm, ot) + vchk_expr_e(r, fnm, ot)
    If(c, t, e2)            => vchk_expr_e(c, fnm, ot) + vchk_expr_e(t, fnm, ot) + vchk_expr_e(e2, fnm, ot)
    LetIn(nm, v, b)         => vchk_expr_e(v, fnm, ot) + vchk_expr_e(b, fnm, ot)
    VarIn(nm, v, b)         => vchk_expr_e(v, fnm, ot) + vchk_expr_e(b, fnm, ot)
    DeferE(c, b)            => vchk_expr_e(c, fnm, ot) + vchk_expr_e(b, fnm, ot)
    ErrDeferE(c, b)         => vchk_expr_e(c, fnm, ot) + vchk_expr_e(b, fnm, ot)
    WithAllocE(a, b)        => vchk_expr_e(a, fnm, ot) + vchk_expr_e(b, fnm, ot)
    WithHandlerE(en, hs, b) => vchk_expr_e(b, fnm, ot)
    ScopeE(snm, b)          => vchk_expr_e(b, fnm, ot)
    SpawnE(inner)           => vchk_expr_e(inner, fnm, ot)
    Match(sc, arms)         => vchk_expr_e(sc, fnm, ot) + vchk_arms_e(arms, fnm, ot)
    _                       => 0

fn vchk_args_e(args, fnm, ot) = match args
    Nil        => 0
    Cons(h, t) => vchk_expr_e(h, fnm, ot) + vchk_args_e(t, fnm, ot)

fn vchk_rec_e(items, fnm, ot) = match items
    Nil        => 0
    Cons(h, t) => vchk_expr_e(h.val, fnm, ot) + vchk_rec_e(t, fnm, ot)

fn vchk_arms_e(arms, fnm, ot) = match arms
    Nil        => 0
    Cons(h, t) => vchk_expr_e(h.body, fnm, ot) + vchk_arms_e(t, fnm, ot)

## ============================================================================================================
## Combined function driver for Track O, Track A, Track K, Track S & Track V (`ochkfn`)
## ============================================================================================================
fn aget_fn_rty(msig, mosig) = match mosig
    Cons(osg, r) => if isany(osg.rty) == 0 then osg.rty else aget_sig_rty(msig)
    Nil          => aget_sig_rty(msig)

fn aget_sig_rty(msig) = match msig
    Cons(sg, r) => sg.rt
    Nil         => TyAny

fn aget_fn_lenv(msig) = match msig
    Cons(sg, r) => tparamlenv(sg)
    Nil         => Nil

fn ochkfn(nm, ps, body, ot) = ochkfn2(nm, ps, body, osiglookup(nm, ot.osigs), tsiglookup(nm, ot.sigs), ot)

fn ochkfn2(nm, ps, body, mosig, msig, ot) = match mosig
    Nil          => let zv = vprove_fn_status(nm, ps, body, ot.vsigs, ot.fns) + (if isnil(ot.vsigs) == 1 and isnil(ot.invs) == 1 then 0 else vchk_expr_e(body, nm, ot)) in let zk = kchk_fn_effs(nm, 0, body, ot) in if oanye(body) == 0 and isnil(ot.osigs) == 1 and isnil(ot.otypes) == 1 and isnil(auinit_from_sig(msig)) == 1 then 1 else let rty = aget_sig_rty(msig) in let lenv = aget_fn_lenv(msig) in let zs = schk_conc_e(body, nm, 0, sinit_nonsend_sig(msig), Nil) in let zh = achk_holes_e(body, rty, lenv, {fnm: nm, pubf: 0, sigs: ot.sigs}) in let zp = achk_prov_e(body, nm, auinit_from_sig(msig), ot) in let ctx = {fnm: nm, pubf: 0, freef: 0, halloc: 0, bparams: ps, mvars: Nil, pnames: ps, locals: Nil, origins: oinit_origins(ps), osigs: ot.osigs, otypes: ot.otypes} in let rb = ochke(body, ctx, Nil) in ochk_ret_origin(nm, 0, "", rty, ps, rb.origin)
    Cons(sg, sr) => if sg.pubf == 1 and oisgctype(sg.rty, ot.otypes) == 1 then ctfail("lume: ownership error [O0030]: public function '" + nm + "' cannot expose '@gc' region type across a public module boundary\n") else let rty = aget_fn_rty(msig, mosig) in let lenv = aget_fn_lenv(msig) in let mvars = omvars_pl(sg.pl) in let zv = vprove_fn_status(nm, ps, body, ot.vsigs, ot.fns) + vchk_expr_e(body, nm, ot) in let zk = kchk_fn_effs(nm, sg.pubf, body, ot) in let zs = schk_conc_e(body, nm, 0, sinit_nonsend_sig(msig), mvars) in let zh = achk_holes_e(body, rty, lenv, {fnm: nm, pubf: sg.pubf, sigs: ot.sigs}) in let zt = (if ois_total(sg.freef) == 1 then achk_total_e(body, {fnm: nm, ps: ps, fns: ot.fns, osigs: ot.osigs}, Nil, Nil) else 0) in let tret = achk_prov_e(body, nm, auinit_from_sig(msig), ot) in if sg.pubf == 1 and ois_llm(sg.freef) == 0 and ois_unverified_ty(rty) == 0 and tret == 1 then ctfail("lume: provenance error [A0003]: unverified AI/probabilistic value cannot be returned from trusted 'pub fn " + nm + "' without verification (fix-it: wrap the return value in 'verify(val, <contract>)' or validate with a contract guard before returning)\n") else let bparams = if isnil(sg.pl) == 1 then ps else obparams_pl(sg.pl) in let ctx = {fnm: nm, pubf: sg.pubf, freef: sg.freef, halloc: 0, bparams: bparams, mvars: mvars, pnames: ps, locals: Nil, origins: oinit_origins(ps), osigs: ot.osigs, otypes: ot.otypes} in let rb = ochke(body, ctx, Nil) in ochk_ret_origin(nm, sg.pubf, sg.fromp, rty, ps, rb.origin)

fn ochkstmts(prog, ot, moved) = match prog
    Nil        => 1
    Cons(h, t) => ochkstmt1(h, t, ot, moved)

fn ochkstmt1(st, rest, ot, moved) = match st
    VLawDecl(nm, ps, body) => let zl = vchk_law(nm, ps, body, ot.fns) in ochkstmts(rest, ot, moved)
    Fn(nm, ps, body)       => let z = ochkfn(nm, ps, body, ot) in ochkstmts(rest, ot, moved)
    Print(v)               => let zv = vchk_expr_e(v, "<main>", ot) in let zs = schk_conc_e(v, "<main>", 0, Nil, Nil) in let zp = achk_prov_e(v, "<main>", Nil, ot) in let ctx = {fnm: "<main>", pubf: 0, freef: 0, halloc: 0, bparams: Nil, mvars: Nil, pnames: Nil, locals: Nil, origins: Nil, osigs: ot.osigs, otypes: ot.otypes} in let r = ochke(v, ctx, moved) in ochkstmts(rest, ot, r.moved)
    ExprS(v)               => let zv = vchk_expr_e(v, "<main>", ot) in let zs = schk_conc_e(v, "<main>", 0, Nil, Nil) in let zp = achk_prov_e(v, "<main>", Nil, ot) in let ctx = {fnm: "<main>", pubf: 0, freef: 0, halloc: 0, bparams: Nil, mvars: Nil, pnames: Nil, locals: Nil, origins: Nil, osigs: ot.osigs, otypes: ot.otypes} in let r = ochke(v, ctx, moved) in ochkstmts(rest, ot, r.moved)
    _                      => ochkstmts(rest, ot, moved)

## --- lower Track O, Track A, Track K, Track S & Track V surface AST nodes into canonical Lume-Core (`LetIn`/`If`) ---
fn ois_intrinsic(nm, ufns) = if (nm == "borrow" or nm == "borrow_mut" or nm == "move" or nm == "clone" or nm == "evolve_approve" or nm == "old") and omem(nm, ufns) == 0 then 1 else 0

fn ois_verify_call(nm, ufns) = if (nm == "verify" or nm == "law_check") and omem(nm, ufns) == 0 then 1 else 0

fn olower_verify(args, lctx, d) = if len(args) == 1 then olowere(ohd_e(args), lctx, d) else if len(args) >= 2 then let val_e = ohd_e(args) in let cond_e = ohd_e(ptl(args)) in let vn = "_v_val_" + str(d) in LetIn(vn, olowere(val_e, lctx, d + 1), If(olowere(cond_e, lctx, d + 2), Var(vn), Call("ctfail", Cons(Str("lume: runtime verification failed for unverified value\n"), Nil)))) else Num(0)

fn ois_str_expr(e) = match e
    Str(s) => 1
    _      => 0

fn khop_lookup(nm, hops) = match hops
    Nil        => Nil
    Cons(h, t) => if h.op == nm then Cons(h, Nil) else khop_lookup(nm, t)

fn ksubst_lookup(nm, renv) = match renv
    Nil        => nm
    Cons(h, t) => if h.k == nm then h.v else ksubst_lookup(nm, t)

fn kmk_renv(ps, pfx) = match ps
    Nil        => Nil
    Cons(p, r) => Cons({k: p, v: pfx + p}, kmk_renv(r, pfx))

fn kmk_rps(ps, pfx) = match ps
    Nil        => Nil
    Cons(p, r) => Cons(pfx + p, kmk_rps(r, pfx))

fn ksubst_e(e, renv, pfx) = match e
    Var(nm)                 => Var(ksubst_lookup(nm, renv))
    LetIn(nm, v, b)         => let nnm = pfx + nm in LetIn(nnm, ksubst_e(v, renv, pfx), ksubst_e(b, Cons({k: nm, v: nnm}, renv), pfx))
    VarIn(nm, v, b)         => let nnm = pfx + nm in LetIn(nnm, ksubst_e(v, renv, pfx), ksubst_e(b, Cons({k: nm, v: nnm}, renv), pfx))
    OwnE(inner)             => OwnE(ksubst_e(inner, renv, pfx))
    MutE(inner)             => MutE(ksubst_e(inner, renv, pfx))
    DeferE(c, b)            => DeferE(ksubst_e(c, renv, pfx), ksubst_e(b, renv, pfx))
    ErrDeferE(c, b)         => ErrDeferE(ksubst_e(c, renv, pfx), ksubst_e(b, renv, pfx))
    WithAllocE(a, b)        => WithAllocE(ksubst_e(a, renv, pfx), ksubst_e(b, renv, pfx))
    WithHandlerE(en, hs, b) => WithHandlerE(en, hs, ksubst_e(b, renv, pfx))
    ScopeE(snm, b)          => ScopeE(snm, ksubst_e(b, renv, pfx))
    SpawnE(inner)           => SpawnE(ksubst_e(inner, renv, pfx))
    If(c, t, e2)            => If(ksubst_e(c, renv, pfx), ksubst_e(t, renv, pfx), ksubst_e(e2, renv, pfx))
    Bin(op, l, r)           => Bin(op, ksubst_e(l, renv, pfx), ksubst_e(r, renv, pfx))
    Call(cnm, args)         => Call(cnm, ksubst_args(args, renv, pfx))
    Field(o, fld)           => Field(ksubst_e(o, renv, pfx), fld)
    Rec(items)              => Rec(ksubst_rec(items, renv, pfx))
    RecT(tn, items)         => RecT(tn, ksubst_rec(items, renv, pfx))
    Match(sc, arms)         => Match(ksubst_e(sc, renv, pfx), ksubst_arms(arms, renv, pfx))
    CT(inner)               => CT(ksubst_e(inner, renv, pfx))
    _                       => e

fn ksubst_args(xs, renv, pfx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(ksubst_e(h, renv, pfx), ksubst_args(t, renv, pfx))

fn ksubst_rec(xs, renv, pfx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: ksubst_e(h.val, renv, pfx)}, ksubst_rec(t, renv, pfx))

fn ksubst_arms(xs, renv, pfx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: ksubst_e(h.body, renv, pfx)}, ksubst_arms(t, renv, pfx))

fn kuses_hop(e, hops, fns, d) = if d > 6 then 0 else kuses_hop1(e, hops, fns, d)

fn kuses_hop1(e, hops, fns, d) = match e
    Call(cnm, args)         => if isnil(khop_lookup(cnm, hops)) == 0 then 1 else if kuses_hop_args(args, hops, fns, d) == 1 then 1 else kuses_hop_fn(vfnlookup(cnm, fns), hops, fns, d)
    Bin(op, l, r)           => if kuses_hop(l, hops, fns, d) == 1 then 1 else kuses_hop(r, hops, fns, d)
    If(c, t, e2)            => if kuses_hop(c, hops, fns, d) == 1 then 1 else if kuses_hop(t, hops, fns, d) == 1 then 1 else kuses_hop(e2, hops, fns, d)
    LetIn(nm, v, b)         => if kuses_hop(v, hops, fns, d) == 1 then 1 else kuses_hop(b, hops, fns, d)
    VarIn(nm, v, b)         => if kuses_hop(v, hops, fns, d) == 1 then 1 else kuses_hop(b, hops, fns, d)
    OwnE(inner)             => kuses_hop(inner, hops, fns, d)
    MutE(inner)             => kuses_hop(inner, hops, fns, d)
    DeferE(c, b)            => if kuses_hop(c, hops, fns, d) == 1 then 1 else kuses_hop(b, hops, fns, d)
    ErrDeferE(c, b)         => if kuses_hop(c, hops, fns, d) == 1 then 1 else kuses_hop(b, hops, fns, d)
    WithAllocE(a, b)        => if kuses_hop(a, hops, fns, d) == 1 then 1 else kuses_hop(b, hops, fns, d)
    WithHandlerE(en, hs, b) => kuses_hop(b, hops, fns, d)
    ScopeE(snm, b)          => kuses_hop(b, hops, fns, d)
    SpawnE(inner)           => kuses_hop(inner, hops, fns, d)
    Field(o, fld)           => kuses_hop(o, hops, fns, d)
    Rec(items)              => kuses_hop_rec(items, hops, fns, d)
    RecT(tn, items)         => kuses_hop_rec(items, hops, fns, d)
    Match(sc, arms)         => if kuses_hop(sc, hops, fns, d) == 1 then 1 else kuses_hop_arms(arms, hops, fns, d)
    _                       => 0

fn kuses_hop_fn(mf, hops, fns, d) = match mf
    Nil        => 0
    Cons(f, r) => kuses_hop(f.body, hops, fns, d + 1)

fn kuses_hop_args(xs, hops, fns, d) = match xs
    Nil        => 0
    Cons(h, t) => if kuses_hop(h, hops, fns, d) == 1 then 1 else kuses_hop_args(t, hops, fns, d)

fn kuses_hop_rec(xs, hops, fns, d) = match xs
    Nil        => 0
    Cons(h, t) => if kuses_hop(h.val, hops, fns, d) == 1 then 1 else kuses_hop_rec(t, hops, fns, d)

fn kuses_hop_arms(xs, hops, fns, d) = match xs
    Nil        => 0
    Cons(h, t) => if kuses_hop(h.body, hops, fns, d) == 1 then 1 else kuses_hop_arms(t, hops, fns, d)

fn kbind_hop_args(ps, args, body, pfx, lctx, d) = kbind_hop_r(kmk_rps(ps, pfx), args, ksubst_e(body, kmk_renv(ps, pfx), pfx), lctx, d)

fn kbind_hop_r(rps, args, sbody, lctx, d) = match rps
    Nil         => olowere(sbody, lctx, d + 1)
    Cons(np, r) => kbind_hop_arg1(np, r, args, sbody, lctx, d)

fn kbind_hop_arg1(np, r, args, sbody, lctx, d) = match args
    Nil         => LetIn(np, Num(0), kbind_hop_r(r, Nil, sbody, lctx, d + 1))
    Cons(a, ar) => LetIn(np, olowere(a, lctx, d), kbind_hop_r(r, ar, sbody, lctx, d + 1))

fn ktry_perceus_arm(sc_v, pat, body, lctx, d) = match pat
    PCons(ptag, psubs) => let ar = len(psubs) in if ar == 1 or ar == 2 then ktry_perceus_body(sc_v, ptag, ar, body, lctx, d) else olowere(body, lctx, d)
    _                  => olowere(body, lctx, d)

fn ktry_perceus_body(sc_v, ptag, ar, body, lctx, d) = match body
    Call(ctag, cargs) => if ctag == ptag and len(cargs) == ar and omentions_args(sc_v, cargs) == 0 then Call("__perceus_reuse_" + str(ar), Cons(Var(sc_v), olowerargs(cargs, lctx, d))) else olowere(body, lctx, d)
    LetIn(nm, v, b)   => if nm == sc_v or omentions_var(sc_v, v) == 1 then olowere(body, lctx, d) else LetIn(nm, olowere(v, lctx, d), ktry_perceus_body(sc_v, ptag, ar, b, lctx, d + 1))
    _                 => olowere(body, lctx, d)

fn ksc_own_var(sc, ownps) = match sc
    Var(x) => if omem(x, ownps) == 1 then x else ""
    _      => ""

fn olowere(e, lctx, d) = match e
    Var(nm)                 => if ais_hole_name(nm) == 1 then Num(0) else Var(nm)
    VarIn(nm, v, b)         => LetIn(nm, olowere(v, lctx, d + 1), olowere(b, lctx, d + 17))
    OwnE(inner)             => olowere(inner, lctx, d)
    MutE(inner)             => olowere(inner, lctx, d)
    DeferE(c, b)            => let vn = "_d_val_" + str(d) in let rn = "_d_run_" + str(d) in LetIn(vn, olowere(b, lctx, d + 1), LetIn(rn, olowere(c, lctx, d + 2), Var(vn)))
    ErrDeferE(c, b)         => let vn = "_ed_val_" + str(d) in let rn = "_ed_run_" + str(d) in LetIn(vn, olowere(b, lctx, d + 1), If(Bin("<", Var(vn), Num(0)), LetIn(rn, olowere(c, lctx, d + 2), Var(vn)), Var(vn)))
    WithAllocE(a, b)        => LetIn("_alloc_ctx_" + str(d), olowere(a, lctx, d + 1), olowere(b, lctx, d + 2))
    WithHandlerE(en, hs, b) => olowere(b, {ufns: lctx.ufns, hops: app(hs, lctx.hops), ownps: lctx.ownps, fns: lctx.fns}, d + 1)
    ScopeE(snm, b)          => LetIn(snm, Num(1), olowere(b, lctx, d + 1))
    SpawnE(inner)           => olowere(inner, lctx, d + 1)
    LetIn(nm, v, b)         => LetIn(nm, olowere(v, lctx, d + 1), olowere(b, {ufns: lctx.ufns, hops: lctx.hops, ownps: orem(nm, lctx.ownps), fns: lctx.fns}, d + 17))
    If(c, t, e2)            => If(olowere(c, lctx, d + 1), olowere(t, lctx, d + 17), olowere(e2, lctx, d + 33))
    Bin(op, l, r)           => olowerbin(op, l, r, lctx, d)
    Call(nm, args)          => olowercall(nm, args, khop_lookup(nm, lctx.hops), lctx, d)
    Field(o, fld)           => Field(olowere(o, lctx, d), fld)
    Rec(items)              => Rec(olowerrec(items, lctx, d))
    RecT(tn, items)         => RecT(tn, olowerrec(items, lctx, d))
    Match(sc, arms)         => Match(olowere(sc, lctx, d), olowerarms(arms, ksc_own_var(sc, lctx.ownps), lctx, d + 1))
    CT(inner)               => CT(olowere(inner, lctx, d))
    _                       => e

fn olowercall(nm, args, mhop, lctx, d) = match mhop
    Cons(hop, r) => kbind_hop_args(hop.ps, args, hop.body, "_khop_" + str(d) + "_" + hop.op + "_", lctx, d)
    Nil          => if ois_intrinsic(nm, lctx.ufns) == 1 and len(args) == 1 then olowere(ohd_e(args), lctx, d) else if ois_verify_call(nm, lctx.ufns) == 1 then olower_verify(args, lctx, d) else if isnil(lctx.hops) == 0 and d < 200 then olowercall_fn(nm, args, vfnlookup(nm, lctx.fns), lctx, d) else Call(nm, olowerargs(args, lctx, d))

fn olowercall_fn(nm, args, mf, lctx, d) = match mf
    Nil        => Call(nm, olowerargs(args, lctx, d))
    Cons(f, r) => if kuses_hop(f.body, lctx.hops, lctx.fns, 0) == 1 then kbind_hop_args(f.ps, args, f.body, "_khfn_" + str(d) + "_" + nm + "_", lctx, d) else Call(nm, olowerargs(args, lctx, d))

fn olowerbin(op, l, r, lctx, d) = if op == "+" and ois_str_expr(l) == 1 and ois_hole_expr(r) == 1 then Bin(op, olowere(l, lctx, d + 1), Str("")) else if op == "+" and ois_hole_expr(l) == 1 and ois_str_expr(r) == 1 then Bin(op, Str(""), olowere(r, lctx, d + 17)) else Bin(op, olowere(l, lctx, d + 1), olowere(r, lctx, d + 17))

fn ois_hole_expr(e) = match e
    Var(nm) => ais_hole_name(nm)
    _       => 0

fn olowerargs(xs, lctx, d) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(olowere(h, lctx, d + 1), olowerargs(t, lctx, d + 17))

fn olowerrec(xs, lctx, d) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: olowere(h.val, lctx, d + 1)}, olowerrec(t, lctx, d + 17))

fn olowerarms(xs, sc_v, lctx, d) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: if sc_v != "" then ktry_perceus_arm(sc_v, h.pat, h.body, lctx, d + 1) else olowere(h.body, lctx, d + 1)}, olowerarms(t, sc_v, lctx, d + 17))

fn kfn_ownps(nm, osigs) = match osiglookup(nm, osigs)
    Nil          => Nil
    Cons(osg, r) => kownps_pl(osg.pl)

fn kownps_pl(pl) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 2 then Cons(p.pn, kownps_pl(r)) else kownps_pl(r)

fn vconj_conds(cs, lctx, d) = match cs
    Nil        => Num(1)
    Cons(c, r) => if isnil(r) == 1 then olowere(c, lctx, d) else Bin("and", olowere(c, lctx, d), vconj_conds(r, lctx, d + 1))

fn vwrap_fn_contract(nm, ps, raw_body, low_body, lctx, vctx) = vwrap_fn_c1(nm, ps, raw_body, low_body, lctx, vsiglookup(nm, vctx.vsigs))

fn vwrap_fn_c1(nm, ps, raw_body, low_body, lctx, mvs) = match mvs
    Nil          => low_body
    Cons(vsg, r) => if vqflia_prove_fn(ps, vsg.reqs, vsg.enss, raw_body, lctx.fns) == 1 then low_body else let post = if isnil(vsg.enss) == 1 then low_body else LetIn("result", low_body, LetIn("ret", Var("result"), LetIn("_vens_ok", If(vconj_conds(vsg.enss, lctx, 100), Num(1), Call("ctfail", Cons(Str("lume: runtime contract violation (ensures) in '" + nm + "'\n"), Nil))), Var("result")))) in if isnil(vsg.reqs) == 1 then post else LetIn("_vreq_ok", If(vconj_conds(vsg.reqs, lctx, 200), Num(1), Call("ctfail", Cons(Str("lume: runtime contract violation (requires) in '" + nm + "'\n"), Nil))), post)

fn klower_eff_ops(ops, ufns, rest) = match ops
    Nil         => rest
    Cons(op, r) => if omem(op.op, ufns) == 1 then klower_eff_ops(r, ufns, rest) else Cons(Fn(op.op, op.ps, Num(0)), klower_eff_ops(r, Cons(op.op, ufns), rest))

fn olowerprog(prog, ufns, osigs, vctx) = match prog
    Nil        => Nil
    Cons(h, t) => olowerstmt(h, olowerprog(t, ufns, osigs, vctx), ufns, osigs, vctx)

fn olowerstmt(st, rest, ufns, osigs, vctx) = match st
    OSig(nm, pubf, freef, pl, rty, fromp) => rest
    OType(nm, k)                          => rest
    KEffSig(nm, effs)                     => rest
    KEffectDecl(enm, ops)                 => klower_eff_ops(ops, ufns, rest)
    KCapGrant(effs)                       => rest
    VContractSig(nm, ps, reqs, enss)      => rest
    VTypeInvariant(nm, fs, inv)           => rest
    VLawDecl(nm, ps, body)                => rest
    Fn(nm, ps, body)                      => let lctx = {ufns: ufns, hops: Nil, ownps: kfn_ownps(nm, osigs), fns: vctx.fns} in let lb = if oanye(body) == 0 and isnil(lctx.ownps) == 1 then body else olowere(body, lctx, 0) in let wb = vwrap_fn_contract(nm, ps, body, lb, lctx, vctx) in Cons(Fn(nm, ps, wb), rest)
    Print(v)                              => Cons(Print(olowere(v, {ufns: ufns, hops: Nil, ownps: Nil, fns: vctx.fns}, 0)), rest)
    ExprS(v)                              => Cons(ExprS(olowere(v, {ufns: ufns, hops: Nil, ownps: Nil, fns: vctx.fns}, 0)), rest)
    _                                     => Cons(st, rest)

fn ocheck(prog) = if oany(prog) == 0 then prog else ocheckforce(prog)
fn ocheckforce(prog) = let raw_osigs = ocollects(prog) in let fns = ocollectf(prog) in let osigs = oinfer_priv_osigs(fns, raw_osigs) in let otypes = ocollectt(prog) in let sigs = tcollects(prog) in let ksigs = kcollect_effsigs(prog) in let edecls = kcollect_effdecls(prog) in let caps = kcollect_caps(prog) in let vsigs = vcollect_vsigs(prog) in let invs = vcollect_invs(prog) in let ufns = ocollectfnms(prog) in let z = ochkstmts(prog, {osigs: osigs, otypes: otypes, sigs: sigs, fns: fns, ksigs: ksigs, edecls: edecls, caps: caps, vsigs: vsigs, invs: invs}, Nil) in olowerprog(prog, ufns, osigs, {vsigs: vsigs, fns: fns})
