## --- Phase 3 Track O & Track A (`06b_phase3.src`) ---
## Track O: ownership (`own`), borrow checker (`shared`/`mut`), regions (`from <param>`), LIFO `defer`/`errdefer`,
##          and memory tiers (`rc`/`arc`/`weak`/`cell`/arena, `@gc`, `@freestanding` + `with alloc`).
## Track A: AI-native authoring:
##   - A1: Typed holes (`_`, `_hole*`) + hole-driven candidate synthesis (`[A0001]`).
##   - A2: `total fn` termination & structural/measure recursion checker (`[A0002]`).
##   - A3: Provenance & uncertainty in the type (`unverified[T]`, `llm fn`, `prob_sample`) with contract/law/evolve
##         discharge (`verify`, `law_check`, `evolve_approve`, or branch guard) before trusted boundaries (`[A0003]`).
## Gradual & fixpoint-safe: when `oany(prog) == 0`, `ocheck(prog)` returns `prog` immediately with zero allocation.

fn omem(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else omem(x, t)

fn orem(x, xs) = match xs
    Nil        => Nil
    Cons(h, t) => if h == x then orem(x, t) else Cons(h, orem(x, t))

fn ostarts(s, p) = if count(s) < count(p) then 0 else slice(s, 0, count(p)) == p

fn ois_free(mflags) = mflags % 2
fn ois_total(mflags) = (mflags / 2) % 2
fn ois_llm(mflags) = (mflags / 4) % 2
fn ois_kernel(mflags) = (mflags / 8) % 2
fn ois_interrupt(mflags) = (mflags / 16) % 2
fn ois_ffi(mflags) = (mflags / 32) % 2
fn ois_protect(mflags) = (mflags / 64) % 2
fn ois_async(mflags) = (mflags / 128) % 2

fn w33_is_cred_lit(s) = if count(s) < 6 then 0 else if ostarts(s, "sk-") == 1 or ostarts(s, "ghp_") == 1 or ostarts(s, "AKIA") == 1 or ostarts(s, "-----BEGIN ") == 1 then 1 else 0

fn w33_chk_sec_e(e, fnm) = match e
    Str(s)          => if w33_is_cred_lit(s) == 1 then ctfail("lume: secret hygiene error [W0001]: hardcoded credential literal in '" + fnm + "' must be wrapped in 'secret_new(...)' from 'std.secret' so it never leaks to plaintext '.rodata' or logs (fix-it: replace literal with 'secret_new(\"<redacted>\")' or load via 'env.secret')\n") else 0
    Bin(op, l, r)   => w33_chk_sec_e(l, fnm) + w33_chk_sec_e(r, fnm)
    If(c, t, e2)    => w33_chk_sec_e(c, fnm) + w33_chk_sec_e(t, fnm) + w33_chk_sec_e(e2, fnm)
    LetIn(nm, v, b) => w33_chk_sec_e(v, fnm) + w33_chk_sec_e(b, fnm)
    VarIn(nm, v, b) => w33_chk_sec_e(v, fnm) + w33_chk_sec_e(b, fnm)
    Call(cnm, args) => if cnm == "secret_new" then 0 else w33_chk_sec_args(args, fnm)
    _               => 0

fn w33_chk_sec_args(xs, fnm) = match xs
    Nil        => 0
    Cons(h, t) => w33_chk_sec_e(h, fnm) + w33_chk_sec_args(t, fnm)

fn ais_hole_name(nm) = if nm == "_" or ostarts(nm, "_hole") == 1 then 1 else 0

fn ois_unverified_ty(ty) = match ty
    TyApply(n, e) => if n == "unverified" then 1 else 0
    _             => 0

fn ohas_unverified_tys(tys) = match tys
    Nil        => 0
    Cons(h, t) => if ois_unverified_ty(h) == 1 then 1 else ohas_unverified_tys(t)

fn ois_tensor_ty(ty) = match ty
    TyTensor(e, ds) => 1
    _               => 0

fn ohas_tensor_tys(tys) = match tys
    Nil        => 0
    Cons(h, t) => if ois_tensor_ty(h) == 1 then 1 else ohas_tensor_tys(t)

fn ois_refine_ty(ty) = match ty
    TyRefine(bty, pr) => 1
    _                 => 0

fn ohas_refine_tys(tys) = match tys
    Nil        => 0
    Cons(h, t) => if ois_refine_ty(h) == 1 then 1 else ohas_refine_tys(t)

fn ois_tier_ty(ty) = match ty
    TyApply(n, e) => if n == "rc" or n == "arc" or n == "weak" or n == "promise" or n == "signal" then 1 else ois_tier_ty(e)
    _             => 0

fn ohas_tier_tys(tys) = match tys
    Nil        => 0
    Cons(h, t) => if ois_tier_ty(h) == 1 then 1 else ohas_tier_tys(t)

fn oany(prog) = match prog
    Nil        => 0
    Cons(h, t) => if oanystmt(h) == 1 then 1 else oany(t)

fn oanystmt(st) = match st
    OSig(nm, pubf, freef, pl, rty, fromp) => 1
    OType(nm, k)                          => 1
    KEffSig(nm, effs)                     => 1
    KEffectDecl(enm, ops)                 => 1
    KCapGrant(effs)                       => 1
    VContractSig(nm, ps, reqs, enss)      => 1
    VTypeInvariant(nm, fs, inv)           => 1
    VLawDecl(nm, ps, body)                => 1
    WcetSig(nm, bound)                    => 1
    TypeRefineS(nm, bty, pr)              => 1
    TraitDecl(tnm, ops)                   => 1
    ImplDecl(tnm, tty, mths)              => 1
    Sig(nm, ps, ts, rt)                   => if ohas_unverified_tys(ts) == 1 or ois_unverified_ty(rt) == 1 or ohas_tensor_tys(ts) == 1 or ois_tensor_ty(rt) == 1 or ohas_refine_tys(ts) == 1 or ois_refine_ty(rt) == 1 or ohas_tier_tys(ts) == 1 or ois_tier_ty(rt) == 1 then 1 else 0
    Fn(nm, ps, body)                      => oanye(body)
    Print(v)                              => oanye(v)
    ExprS(v)                              => oanye(v)
    _                                     => 0

fn oanye(e) = match e
    Var(nm)                    => ais_hole_name(nm)
    VarIn(nm, v, b)            => 1
    OwnE(inner)                => 1
    MutE(inner)                => 1
    DeferE(c, b)               => 1
    ErrDeferE(c, b)            => 1
    WithAllocE(a, b)           => 1
    WithHandlerE(en, hs, b)    => 1
    ScopeE(snm, b)             => 1
    SpawnE(inner)              => 1
    LambdaE(ps, tys, rt, body) => 1
    AwaitE(inner)              => 1
    ShardE(vnm, lo, hi, body)  => 1
    LetIn(nm, v, b)            => if oanye(v) == 1 then 1 else oanye(b)
    If(c, t, e2)               => if oanye(c) == 1 then 1 else if oanye(t) == 1 then 1 else oanye(e2)
    Bin(op, l, r)              => if oanye(l) == 1 then 1 else oanye(r)
    Call(nm, args)             => if nm == "borrow" or nm == "borrow_mut" or nm == "move" or nm == "clone" or nm == "verify" or nm == "law_check" or nm == "evolve_approve" or nm == "llm_complete" or nm == "prob_sample" or nm == "sample_dist" or nm == "observe_lik" or nm == "old" or nm == "grad" or nm == "jvp" or nm == "vjp" or nm == "vmap" or nm == "jit" or nm == "matmul" or nm == "tensor_matmul" or nm == "tensor_add" or nm == "tensor_sub" or nm == "tensor_mul" or nm == "tensor_add_bias" or nm == "cap_page_map" or nm == "rc" or nm == "arc" or nm == "rc_new" or nm == "arc_new" or nm == "rc_clone" or nm == "arc_clone" or nm == "rc_drop" or nm == "arc_drop" or nm == "rc_get" or nm == "arc_get" or nm == "rc_strong_count" or nm == "arc_strong_count" or nm == "weak_downgrade" or nm == "weak_upgrade" or nm == "downgrade" or nm == "upgrade" or nm == "strong_count" or (nm == "drop" and len(args) == 1) or (nm == "get" and len(args) == 1) or nm == "promise" or nm == "promise_new" or nm == "promise_resolve" or nm == "promise_await" or (nm == "resolve" and len(args) == 2) or nm == "signal" or nm == "signal_new" or nm == "signal_get" or nm == "signal_set" or nm == "signal_version" or (nm == "set" and len(args) == 2) or (nm == "version" and len(args) == 1) or nm == "block_on" or nm == "shard" or nm == "_call" then 1 else oanyargs(args)
    Field(o, fld)           => oanye(o)
    Rec(items)              => oanyrec(items)
    RecT(tn, items)         => oanyrec(items)
    Match(sc, arms)         => if oanye(sc) == 1 then 1 else oanyarms(arms)
    CT(inner)               => oanye(inner)
    _                       => 0

fn oanyhops(xs) = match xs
    Nil        => 0
    Cons(h, t) => if oanye(h.body) == 1 then 1 else oanyhops(t)

fn oanyargs(xs) = match xs
    Nil        => 0
    Cons(h, t) => if oanye(h) == 1 then 1 else oanyargs(t)

fn oanyrec(xs) = match xs
    Nil        => 0
    Cons(h, t) => if oanye(h.val) == 1 then 1 else oanyrec(t)

fn oanyarms(xs) = match xs
    Nil        => 0
    Cons(h, t) => if oanye(h.body) == 1 then 1 else oanyarms(t)

## --- collect OSig, OType, and user functions ---
fn ocollects(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ocollects1(h, ocollects(t))

fn ocollects1(st, rest) = match st
    OSig(nm, pubf, freef, pl, rty, fromp) => Cons({nm: nm, pubf: pubf, freef: freef, pl: pl, rty: rty, fromp: fromp}, rest)
    _                                     => rest

fn ocollectt(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ocollectt1(h, ocollectt(t))

fn ocollectt1(st, rest) = match st
    OType(nm, k) => Cons({nm: nm, kind: k}, rest)
    _            => rest

fn ocollectf(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ocollectf1(h, ocollectf(t))

fn ocollectf1(st, rest) = match st
    Fn(nm, ps, body) => Cons({nm: nm, ps: ps, body: body}, rest)
    _                => rest

fn ocollectfnms(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ocollectfnms1(h, ocollectfnms(t))

fn ocollectfnms1(st, rest) = match st
    Fn(nm, ps, body) => Cons(nm, rest)
    _                => rest

fn kcollect_effsigs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => kcollect_effsig1(h, kcollect_effsigs(t))

fn kcollect_effsig1(st, rest) = match st
    KEffSig(nm, effs) => Cons({nm: nm, effs: effs}, rest)
    _                 => rest

fn kcollect_effdecls(prog) = match prog
    Nil        => Nil
    Cons(h, t) => kcollect_effdecl1(h, kcollect_effdecls(t))

fn kcollect_effdecl1(st, rest) = match st
    KEffectDecl(enm, ops) => Cons({enm: enm, ops: ops}, rest)
    _                     => rest

fn kcollect_caps(prog) = match prog
    Nil        => Nil
    Cons(h, t) => kcollect_cap1(h, kcollect_caps(t))

fn kcollect_cap1(st, rest) = match st
    KCapGrant(effs) => app(effs, rest)
    _               => rest

fn keffsig_lookup(nm, ksigs) = match ksigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else keffsig_lookup(nm, t)

fn kop_effect(opnm, edecls) = match edecls
    Nil        => ""
    Cons(d, r) => if kop_in_ops(opnm, d.ops) == 1 then d.enm else kop_effect(opnm, r)

fn kop_in_ops(opnm, ops) = match ops
    Nil        => 0
    Cons(o, r) => if o.op == opnm then 1 else kop_in_ops(opnm, r)

fn keff_add(eff, xs) = if eff == "" or eff == "pure" or omem(eff, xs) == 1 then xs else Cons(eff, xs)

fn keff_union(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => keff_union(t, keff_add(h, ys))

fn keff_diff(xs, ys) = match xs
    Nil        => Nil
    Cons(h, t) => if h == "pure" or omem(h, ys) == 1 then keff_diff(t, ys) else Cons(h, keff_diff(t, ys))

fn keff_join(xs) = match xs
    Nil        => ""
    Cons(h, t) => if isnil(t) == 1 then h else h + ", " + keff_join(t)

fn kprim_eff(cnm) = if cnm == "io_write" or cnm == "io_read" or cnm == "println" or cnm == "read" or cnm == "readall" or cnm == "emit" or cnm == "flush" then "io" else if cnm == "fs_read" or cnm == "fs_write" or cnm == "fs_open" then "fs" else if cnm == "net_send" or cnm == "net_recv" or cnm == "net_connect" or cnm == "db_exec" then "net" else if cnm == "rc_new" or cnm == "arc_new" or cnm == "alloc_heap" or cnm == "table_new" or cnm == "box_new" then "alloc" else if cnm == "rand_int" or cnm == "prob_sample" or cnm == "llm_complete" then "rand" else if cnm == "sample_dist" or cnm == "observe_lik" then "prob" else if cnm == "llm_prompt" then "llm" else if cnm == "wasm_module_new" or cnm == "wasm_call_add" or cnm == "wasm_store32" or cnm == "wasm_load32" or cnm == "wasm_call_host_fs" then "wasm" else if cnm == "ffi_call" then "ffi" else if cnm == "time_now" or cnm == "clock_now" or cnm == "sleep_ms" then "time" else if cnm == "fail_err" or cnm == "raise_err" then "fail" else if cnm == "panic_msg" then "panic" else if cnm == "async_await" or cnm == "spawn_task" then "async" else ""

fn kinfer_call_effs(cnm, ksigs, edecls, fns, d) = let pe = kprim_eff(cnm) in let ue = kop_effect(cnm, edecls) in let host_e = if cnm == "wasm_call_host_fs" then "fs" else if cnm == "wasm_call_host_net" then "net" else "" in let base = keff_add(host_e, keff_add(pe, keff_add(ue, Nil))) in let mks = keffsig_lookup(cnm, ksigs) in match mks
    Cons(ks, r) => keff_union(base, keff_diff(ks.effs, Cons("pure", Nil)))
    Nil         => if d <= 0 then base else keff_union(base, kinfer_fn_lookup(cnm, fns, ksigs, edecls, d - 1))

fn kinfer_fn_lookup(cnm, fns, ksigs, edecls, d) = match fns
    Nil        => Nil
    Cons(f, r) => if f.nm == cnm then kinfer_effs_e(f.body, ksigs, edecls, fns, d) else kinfer_fn_lookup(cnm, r, ksigs, edecls, d)

fn kinfer_effs_e(e, ksigs, edecls, fns, d) = match e
    Bin(op, l, r)           => keff_union(kinfer_effs_e(l, ksigs, edecls, fns, d), kinfer_effs_e(r, ksigs, edecls, fns, d))
    If(c, t, e2)            => keff_union(kinfer_effs_e(c, ksigs, edecls, fns, d), keff_union(kinfer_effs_e(t, ksigs, edecls, fns, d), kinfer_effs_e(e2, ksigs, edecls, fns, d)))
    LetIn(nm, v, b)         => keff_union(kinfer_effs_e(v, ksigs, edecls, fns, d), kinfer_effs_e(b, ksigs, edecls, fns, d))
    VarIn(nm, v, b)         => keff_union(kinfer_effs_e(v, ksigs, edecls, fns, d), kinfer_effs_e(b, ksigs, edecls, fns, d))
    OwnE(inner)             => kinfer_effs_e(inner, ksigs, edecls, fns, d)
    MutE(inner)             => kinfer_effs_e(inner, ksigs, edecls, fns, d)
    DeferE(c, b)            => keff_union(kinfer_effs_e(c, ksigs, edecls, fns, d), kinfer_effs_e(b, ksigs, edecls, fns, d))
    ErrDeferE(c, b)         => keff_union(kinfer_effs_e(c, ksigs, edecls, fns, d), kinfer_effs_e(b, ksigs, edecls, fns, d))
    WithAllocE(a, b)        => keff_union(kinfer_effs_e(a, ksigs, edecls, fns, d), orem("alloc", kinfer_effs_e(b, ksigs, edecls, fns, d)))
    WithHandlerE(en, hs, b) => keff_union(kinfer_hops(hs, ksigs, edecls, fns, d), orem(en, kinfer_effs_e(b, ksigs, edecls, fns, d)))
    AwaitE(inner)           => keff_add("async", kinfer_effs_e(inner, ksigs, edecls, fns, d))
    ShardE(vnm, lo, hi, b)  => keff_union(kinfer_effs_e(lo, ksigs, edecls, fns, d), keff_union(kinfer_effs_e(hi, ksigs, edecls, fns, d), kinfer_effs_e(b, ksigs, edecls, fns, d)))
    Call(cnm, args)         => if cnm == "block_on" then orem("async", kinfer_args(args, ksigs, edecls, fns, d)) else keff_union(kinfer_call_effs(cnm, ksigs, edecls, fns, d), kinfer_args(args, ksigs, edecls, fns, d))
    Match(sc, arms)         => keff_union(kinfer_effs_e(sc, ksigs, edecls, fns, d), kinfer_arms(arms, ksigs, edecls, fns, d))
    Field(o, fld)           => kinfer_effs_e(o, ksigs, edecls, fns, d)
    Rec(items)              => kinfer_rec(items, ksigs, edecls, fns, d)
    RecT(tn, items)         => kinfer_rec(items, ksigs, edecls, fns, d)
    _                       => Nil

fn kinfer_hops(hs, ksigs, edecls, fns, d) = match hs
    Nil        => Nil
    Cons(h, t) => keff_union(kinfer_effs_e(h.body, ksigs, edecls, fns, d), kinfer_hops(t, ksigs, edecls, fns, d))

fn kinfer_args(xs, ksigs, edecls, fns, d) = match xs
    Nil        => Nil
    Cons(h, t) => keff_union(kinfer_effs_e(h, ksigs, edecls, fns, d), kinfer_args(t, ksigs, edecls, fns, d))

fn kinfer_arms(xs, ksigs, edecls, fns, d) = match xs
    Nil        => Nil
    Cons(h, t) => keff_union(kinfer_effs_e(h.body, ksigs, edecls, fns, d), kinfer_arms(t, ksigs, edecls, fns, d))

fn kinfer_rec(xs, ksigs, edecls, fns, d) = match xs
    Nil        => Nil
    Cons(h, t) => keff_union(kinfer_effs_e(h.val, ksigs, edecls, fns, d), kinfer_rec(t, ksigs, edecls, fns, d))

fn ais_ffi_osig(msig) = match msig
    Nil        => 0
    Cons(sg, r) => if ois_ffi(sg.freef) == 1 and sg.pubf == 0 then 1 else 0

fn kuses_ffi_e(e, osigs) = match e
    Call(cnm, args) => if ais_ffi_osig(osiglookup(cnm, osigs)) == 1 then 1 else kuses_ffi_args(args, osigs)
    Bin(op, l, r)   => if kuses_ffi_e(l, osigs) == 1 then 1 else kuses_ffi_e(r, osigs)
    If(c, t, e2)    => if kuses_ffi_e(c, osigs) == 1 then 1 else if kuses_ffi_e(t, osigs) == 1 then 1 else kuses_ffi_e(e2, osigs)
    LetIn(nm, v, b) => if kuses_ffi_e(v, osigs) == 1 then 1 else kuses_ffi_e(b, osigs)
    VarIn(nm, v, b) => if kuses_ffi_e(v, osigs) == 1 then 1 else kuses_ffi_e(b, osigs)
    _               => 0

fn kuses_ffi_args(xs, osigs) = match xs
    Nil        => 0
    Cons(h, t) => if kuses_ffi_e(h, osigs) == 1 then 1 else kuses_ffi_args(t, osigs)

fn khas_await_e(e) = match e
    AwaitE(inner)   => 1
    Bin(op, l, r)   => if khas_await_e(l) == 1 then 1 else khas_await_e(r)
    If(c, t, e2)    => if khas_await_e(c) == 1 then 1 else if khas_await_e(t) == 1 then 1 else khas_await_e(e2)
    LetIn(nm, v, b) => if khas_await_e(v) == 1 then 1 else khas_await_e(b)
    VarIn(nm, v, b) => if khas_await_e(v) == 1 then 1 else khas_await_e(b)
    Call(cnm, args) => if cnm == "block_on" then 0 else khas_await_args(args)
    _               => 0

fn khas_await_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => if khas_await_e(h) == 1 then 1 else khas_await_args(t)

fn kchk_shard_e(e, fnm, ot) = match e
    ShardE(vnm, lo, hi, b) => let inf = kinfer_effs_e(b, ot.ksigs, ot.edecls, ot.fns, 4) in if isnil(inf) == 0 then ctfail("lume: effect error [E0200]: data-parallel 'shard' in '" + fnm + "' cannot perform effect '{" + keff_join(inf) + "}' (fix-it: keep 'shard' body pure)\n") else kchk_shard_e(lo, fnm, ot) + kchk_shard_e(hi, fnm, ot)
    Call(cnm, args)        => let z = kchk_shard_args(args, fnm, ot) in if cnm == "shard" and isnil(args) == 0 then kchk_shard_target(ohd_e(args), fnm, ot) else z
    Bin(op, l, r)          => kchk_shard_e(l, fnm, ot) + kchk_shard_e(r, fnm, ot)
    If(c, t, e2)           => kchk_shard_e(c, fnm, ot) + kchk_shard_e(t, fnm, ot) + kchk_shard_e(e2, fnm, ot)
    LetIn(nm, v, b)        => kchk_shard_e(v, fnm, ot) + kchk_shard_e(b, fnm, ot)
    VarIn(nm, v, b)        => kchk_shard_e(v, fnm, ot) + kchk_shard_e(b, fnm, ot)
    _                      => 0

fn kchk_shard_args(xs, fnm, ot) = match xs
    Nil        => 0
    Cons(h, t) => kchk_shard_e(h, fnm, ot) + kchk_shard_args(t, fnm, ot)

fn kchk_shard_target(fe, fnm, ot) = match fe
    Var(tnm) => let inf = kinfer_call_effs(tnm, ot.ksigs, ot.edecls, ot.fns, 4) in if isnil(inf) == 0 then ctfail("lume: effect error [E0200]: data-parallel 'shard' function '" + tnm + "' in '" + fnm + "' cannot perform effect '{" + keff_join(inf) + "}' (fix-it: pass a pure function to 'shard')\n") else 0
    _        => 0

fn kchk_fn_effs(nm, pubf, body, ot) = let zsh = kchk_shard_e(body, nm, ot) in let mks = keffsig_lookup(nm, ot.ksigs) in let dec = kget_dec_effs(mks) in if khas_await_e(body) == 1 and omem("async", dec) == 0 then ctfail("lume: effect error [E0200]: '.await' in synchronous function '" + nm + "' requires 'async fn' or effect '/ {async}' (fix-it: mark 'async fn " + nm + "' or wrap the future in 'block_on(...)')\n") else if pubf == 0 and isnil(mks) == 1 and isnil(ot.caps) == 1 then 1 else let inf0 = kinfer_effs_e(body, ot.ksigs, ot.edecls, ot.fns, 4) in let inf = if kuses_ffi_e(body, ot.osigs) == 1 then keff_add("ffi", inf0) else inf0 in let missing_pub = if pubf == 1 and isnil(mks) == 1 then inf else keff_diff(inf, dec) in if (pubf == 1 or isnil(mks) == 0) and isnil(missing_pub) == 0 then ctfail("lume: effect error [E0200]: function '" + nm + "' performs undeclared effect '{" + keff_join(missing_pub) + "}' (fix-it: add '/ {" + keff_join(keff_union(dec, inf)) + "}' to the signature of '" + nm + "' or handle it with 'with handler')\n") else if isnil(ot.caps) == 0 and isnil(keff_diff(inf, ot.caps)) == 0 then let uncap = keff_diff(inf, ot.caps) in ctfail("lume: capability error [E0200]: function '" + nm + "' requires capability '{" + keff_join(uncap) + "}' not granted to this module (fix-it: add '@capability " + ohd_s(uncap, "io") + "' or declare it in lume.toml)\n") else 1

fn kget_dec_effs(mks) = match mks
    Nil         => Nil
    Cons(ks, r) => ks.effs

fn osiglookup(nm, osigs) = match osigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else osiglookup(nm, t)

fn otypelookup(nm, otypes) = match otypes
    Nil        => ""
    Cons(h, t) => if h.nm == nm then h.kind else otypelookup(nm, t)

fn oisgctype(ty, otypes) = match ty
    TyName(n)     => if otypelookup(n, otypes) == "gc" then 1 else 0
    TyList(e)     => oisgctype(e, otypes)
    TyApply(n, e) => oisgctype(e, otypes)
    _             => 0

fn oisreftype(ty) = match ty
    TyApply(n, e) => if n == "Ref" or n == "View" then 1 else 0
    _             => 0

fn obparams_pl(pl) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 0 or p.cf == 3 then Cons(p.pn, obparams_pl(r)) else obparams_pl(r)

fn omvars_pl(pl) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 2 or p.cf == 3 then Cons(p.pn, omvars_pl(r)) else omvars_pl(r)

fn oinit_origins(ps) = match ps
    Nil        => Nil
    Cons(h, t) => Cons({k: h, v: "param:" + h}, oinit_origins(t))

fn olookup_origin(x, orgs) = match orgs
    Nil        => ""
    Cons(h, t) => if h.k == x then h.v else olookup_origin(x, t)

fn obind_origin(x, v, orgs) = Cons({k: x, v: v}, orgs)

## Intra-module quick origin inference for private helper functions (`borrow(p)` -> `p`)
fn oquick_origin(e, orgs) = match e
    Var(x)           => olookup_origin(x, orgs)
    Field(o, fld)    => oquick_origin(o, orgs)
    LetIn(nm, v, b)  => let vo = oquick_origin(v, orgs) in oquick_origin(b, obind_origin(nm, if vo != "" then vo else "local:" + nm, orgs))
    VarIn(nm, v, b)  => let vo = oquick_origin(v, orgs) in oquick_origin(b, obind_origin(nm, if vo != "" then vo else "local:" + nm, orgs))
    If(c, t, e2)     => let to = oquick_origin(t, orgs) in if to != "" then to else oquick_origin(e2, orgs)
    DeferE(c, b)     => oquick_origin(b, orgs)
    ErrDeferE(c, b)  => oquick_origin(b, orgs)
    WithAllocE(a, b) => oquick_origin(b, orgs)
    Call(nm, args)   => if (nm == "borrow" or nm == "borrow_mut") and len(args) == 1 then "borrow:" + oquick_origin(ohd_e(args), orgs) else ""
    _                => ""

fn ohd_e(xs) = match xs
    Nil        => Num(0)
    Cons(h, t) => h

fn ohd_s(xs, def) = match xs
    Nil        => def
    Cons(h, t) => h

fn ostrip_borrow(org) = if ostarts(org, "borrow:") == 1 then ostrip_borrow(slice(org, 7, count(org))) else org

fn oinfer_priv_osigs(fns, osigs) = match fns
    Nil        => osigs
    Cons(f, r) => oinfer_priv_one(f, oinfer_priv_osigs(r, osigs))

fn oinfer_priv_one(f, osigs) = if oanye(f.body) == 0 then osigs else let m = osiglookup(f.nm, osigs) in match m
    Cons(sg, r) => osigs
    Nil         => let bo = oquick_origin(f.body, oinit_origins(f.ps)) in if ostarts(bo, "borrow:param:") == 1 then Cons({nm: f.nm, pubf: 0, freef: 0, pl: Nil, rty: TyAny, fromp: slice(ostrip_borrow(bo), 6, count(ostrip_borrow(bo)))}, osigs) else osigs

## --- call-site conflict & mode helpers ---
fn ois_own_expr(e) = match e
    OwnE(inner)    => 1
    Call(nm, args) => if nm == "move" and len(args) == 1 then 1 else 0
    _              => 0

fn ois_mut_expr(e) = match e
    MutE(inner) => 1
    _           => 0

fn omentions_var(x, e) = match e
    Var(nm)          => if nm == x then 1 else 0
    OwnE(inner)      => omentions_var(x, inner)
    MutE(inner)      => omentions_var(x, inner)
    Field(o, fld)    => omentions_var(x, o)
    Bin(op, l, r)    => if omentions_var(x, l) == 1 then 1 else omentions_var(x, r)
    If(c, t, e2)     => if omentions_var(x, c) == 1 then 1 else if omentions_var(x, t) == 1 then 1 else omentions_var(x, e2)
    LetIn(nm, v, b)  => if omentions_var(x, v) == 1 then 1 else if nm == x then 0 else omentions_var(x, b)
    VarIn(nm, v, b)  => if omentions_var(x, v) == 1 then 1 else if nm == x then 0 else omentions_var(x, b)
    Call(nm, args)   => omentions_args(x, args)
    Rec(items)       => omentions_rec(x, items)
    RecT(tn, items)  => omentions_rec(x, items)
    _                => 0

fn omentions_args(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if omentions_var(x, h) == 1 then 1 else omentions_args(x, t)

fn omentions_rec(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if omentions_var(x, h.val) == 1 then 1 else omentions_rec(x, t)

fn ocount_var_args(x, args) = match args
    Nil        => 0
    Cons(h, t) => omentions_var(x, h) + ocount_var_args(x, t)

fn omut_root(e) = match e
    MutE(inner)    => omut_root_plain(inner)
    Call(nm, args) => if nm == "borrow_mut" and len(args) == 1 then omut_root_plain(ohd_e(args)) else ""
    _              => ""

fn omut_root_plain(e) = match e
    Var(x)        => x
    MutE(inner)   => omut_root_plain(inner)
    Field(o, fld) => omut_root_plain(o)
    _             => ""

fn ocollect_mut_args(args, pl) = match args
    Nil        => Nil
    Cons(a, r) => ocollect_mut_arg1(a, r, pl)

fn ocollect_mut_arg1(a, r, pl) = let mr = omut_root(a) in let rest = ocollect_mut_args(r, opl_tl(pl)) in if mr != "" then Cons(mr, rest) else if opl_cf(pl) == 3 then let pr = omut_root_plain(a) in (if pr != "" then Cons(pr, rest) else rest) else rest

fn opl_cf(pl) = match pl
    Nil        => 0
    Cons(p, r) => p.cf

fn opl_pn(pl) = match pl
    Nil        => ""
    Cons(p, r) => p.pn

fn opl_tl(pl) = match pl
    Nil        => Nil
    Cons(p, r) => r

fn ochk_conflicts(fnm, muts, args) = match muts
    Nil         => 0
    Cons(mx, r) => if ocount_var_args(mx, args) > 1 then ctfail("lume: borrow error [O0011]: conflicting borrow of '" + mx + "' in call to '" + fnm + "' (cannot borrow '" + mx + "' as mutable while also borrowing it in the same call)\n") else ochk_conflicts(fnm, r, args)

fn ochk_call_modes(fnm, args, pl, ctx) = match pl
    Nil        => 0
    Cons(p, r) => if p.cf == 1 then ochk_call_modes(fnm, args, r, ctx) else ochk_call_mode1(fnm, args, p, r, ctx)

fn ochk_call_mode1(fnm, args, p, r, ctx) = match args
    Nil         => 0
    Cons(a, ar) => if p.cf == 2 and ois_own_expr(a) == 0 then ctfail("lume: ownership error [O0012]: parameter '" + p.pn + "' of '" + fnm + "' takes ownership; mark argument with 'own' at call site (help: write 'own <arg>')\n") else if p.cf == 3 then ochk_mut_param(fnm, p.pn, a, ar, r, ctx) else ochk_call_modes(fnm, ar, r, ctx)

fn ochk_mut_param(fnm, pn, a, ar, r, ctx) = let vnm = omut_root_plain(a) in if vnm != "" and omem(vnm, ctx.mvars) == 0 then ctfail("lume: borrow error [O0010]: cannot pass immutable binding '" + vnm + "' to 'mut' parameter '" + pn + "' of '" + fnm + "' (help: declare 'var " + vnm + "' instead of 'let " + vnm + "')\n") else ochk_call_modes(fnm, ar, r, ctx)

fn oarg_for_param(fromp, args, pl) = match pl
    Nil        => Num(0)
    Cons(p, r) => if p.cf == 1 then oarg_for_param(fromp, args, r) else oarg_for_param2(fromp, args, p, r)

fn oarg_for_param2(fromp, args, p, r) = match args
    Nil         => Num(0)
    Cons(a, ar) => if p.pn == fromp then a else oarg_for_param(fromp, ar, r)

fn ois_heap_alloc(nm) = if nm == "rc" or nm == "arc" or nm == "rc_new" or nm == "arc_new" or nm == "promise" or nm == "signal" or nm == "promise_new" or nm == "signal_new" or nm == "alloc_heap" or nm == "table_new" or nm == "box_new" then 1 else 0

## --- core expression ownership/borrow/region check: returns {moved, origin} ---
fn ochk_own_field(o, fld, ctx, moved) = match o
    Var(x) => if omem(x, moved) == 1 then ctfail("lume: ownership error [O0001]: use of moved value '" + x + "' (moved earlier via 'own " + x + "'; help: borrow '" + x + "' instead or call 'clone(" + x + ")')\n") else if omem(x, ctx.bparams) == 1 or ostarts(olookup_origin(x, ctx.origins), "borrow:") == 1 then ctfail("lume: ownership error [O0002]: cannot move out of borrowed field '" + x + "." + fld + "' (help: borrow '" + x + "." + fld + "' or clone the field)\n") else {moved: Cons(x, moved), origin: ""}
    _      => let r = ochke(o, ctx, moved) in {moved: r.moved, origin: ""}

fn ochk_own_target(inner, ctx, moved) = match inner
    Var(x)        => if omem(x, moved) == 1 then ctfail("lume: ownership error [O0001]: use of moved value '" + x + "' (moved earlier via 'own " + x + "'; help: borrow '" + x + "' instead or call 'clone(" + x + ")')\n") else if omem(x, ctx.bparams) == 1 or ostarts(olookup_origin(x, ctx.origins), "borrow:") == 1 then ctfail("lume: ownership error [O0002]: cannot move out of borrowed parameter '" + x + "' (help: change parameter mode to 'own " + x + "' or call 'clone(" + x + ")')\n") else {moved: Cons(x, moved), origin: ""}
    Field(o, fld) => ochk_own_field(o, fld, ctx, moved)
    _             => let r = ochke(inner, ctx, moved) in {moved: r.moved, origin: ""}

fn ochk_mut_field(o, fld, ctx, moved) = match o
    Var(x) => if omem(x, moved) == 1 then ctfail("lume: ownership error [O0001]: use of moved value '" + x + "' (moved earlier via 'own " + x + "'; help: borrow '" + x + "' instead or call 'clone(" + x + ")')\n") else if omem(x, ctx.mvars) == 0 then ctfail("lume: borrow error [O0010]: cannot borrow field of immutable binding '" + x + "' as 'mut' (help: declare 'var " + x + "' instead of 'let " + x + "')\n") else {moved: moved, origin: "borrow:" + olookup_origin(x, ctx.origins)}
    _      => let r = ochke(o, ctx, moved) in {moved: r.moved, origin: ""}

fn ochk_mut_target(inner, ctx, moved) = match inner
    Var(x)        => if omem(x, moved) == 1 then ctfail("lume: ownership error [O0001]: use of moved value '" + x + "' (moved earlier via 'own " + x + "'; help: borrow '" + x + "' instead or call 'clone(" + x + ")')\n") else if omem(x, ctx.mvars) == 0 then ctfail("lume: borrow error [O0010]: cannot borrow immutable binding '" + x + "' as 'mut' (help: declare 'var " + x + "' instead of 'let " + x + "')\n") else {moved: moved, origin: "borrow:" + olookup_origin(x, ctx.origins)}
    Field(o, fld) => ochk_mut_field(o, fld, ctx, moved)
    _             => let r = ochke(inner, ctx, moved) in {moved: r.moved, origin: ""}

fn octx_bind(ctx, nm, ismut, org) = {fnm: ctx.fnm, pubf: ctx.pubf, freef: ctx.freef, halloc: ctx.halloc, bparams: orem(nm, ctx.bparams), mvars: if ismut == 1 then Cons(nm, orem(nm, ctx.mvars)) else orem(nm, ctx.mvars), pnames: ctx.pnames, locals: Cons(nm, ctx.locals), origins: obind_origin(nm, if org != "" then org else "local:" + nm, ctx.origins), osigs: ctx.osigs, otypes: ctx.otypes}

fn octx_with_alloc(ctx) = {fnm: ctx.fnm, pubf: ctx.pubf, freef: ctx.freef, halloc: 1, bparams: ctx.bparams, mvars: ctx.mvars, pnames: ctx.pnames, locals: ctx.locals, origins: ctx.origins, osigs: ctx.osigs, otypes: ctx.otypes}

fn ochke(e, ctx, moved) = match e
    Var(x) => if omem(x, moved) == 1 then ctfail("lume: ownership error [O0001]: use of moved value '" + x + "' (moved earlier via 'own " + x + "'; help: borrow '" + x + "' instead or call 'clone(" + x + ")')\n") else {moved: moved, origin: olookup_origin(x, ctx.origins)}
    Field(o, fld) => let ro = ochke(o, ctx, moved) in {moved: ro.moved, origin: ro.origin}
    OwnE(inner) => ochk_own_target(inner, ctx, moved)
    MutE(inner) => ochk_mut_target(inner, ctx, moved)
    LetIn(nm, v, b) => let rv = ochke(v, ctx, moved) in ochke(b, octx_bind(ctx, nm, 0, rv.origin), orem(nm, rv.moved))
    VarIn(nm, v, b) => let rv = ochke(v, ctx, moved) in ochke(b, octx_bind(ctx, nm, 1, rv.origin), orem(nm, rv.moved))
    DeferE(c, b) => let rb = ochke(b, ctx, moved) in let rc = ochke(c, ctx, rb.moved) in {moved: rc.moved, origin: rb.origin}
    ErrDeferE(c, b) => let rb = ochke(b, ctx, moved) in let rc = ochke(c, ctx, rb.moved) in {moved: rc.moved, origin: rb.origin}
    WithAllocE(a, b) => let ra = ochke(a, ctx, moved) in ochke(b, octx_with_alloc(ctx), ra.moved)
    WithHandlerE(en, hs, b) => let mvh = ochkhops(hs, ctx, moved) in ochke(b, ctx, mvh)
    ScopeE(snm, b) => ochke(b, ctx, moved)
    SpawnE(inner) => ochke(inner, ctx, moved)
    Bin(op, l, r) => let rl = ochke(l, ctx, moved) in let rr = ochke(r, ctx, rl.moved) in {moved: rr.moved, origin: ""}
    If(c, t, e2) => let rc = ochke(c, ctx, moved) in let rt = ochke(t, ctx, rc.moved) in let re = ochke(e2, ctx, rc.moved) in {moved: app(rt.moved, re.moved), origin: if rt.origin != "" then rt.origin else re.origin}
    Rec(items) => {moved: ochkrec(items, ctx, moved), origin: ""}
    RecT(tn, items) => {moved: ochkrec(items, ctx, moved), origin: ""}
    Match(sc, arms) => let rsc = ochke(sc, ctx, moved) in {moved: ochkarms(arms, ctx, rsc.moved), origin: ""}
    CT(inner) => ochke(inner, ctx, moved)
    AwaitE(inner) => ochke(inner, ctx, moved)
    ShardE(vnm, lo, hi, body) => let rlo = ochke(lo, ctx, moved) in let rhi = ochke(hi, ctx, rlo.moved) in let rb = ochke(body, octx_bind(ctx, vnm, 0, ""), orem(vnm, rhi.moved)) in {moved: rb.moved, origin: ""}
    Call(nm, args) => ochkcall(nm, args, ctx, moved)
    _ => {moved: moved, origin: ""}

fn ochkhops(hs, ctx, moved) = match hs
    Nil        => moved
    Cons(h, t) => let r = ochke(h.body, ctx, moved) in ochkhops(t, ctx, r.moved)

fn ochkrec(items, ctx, moved) = match items
    Nil        => moved
    Cons(h, t) => let r = ochke(h.val, ctx, moved) in ochkrec(t, ctx, r.moved)

fn ochkarms(arms, ctx, moved) = match arms
    Nil        => moved
    Cons(h, t) => let r = ochke(h.body, ctx, moved) in app(r.moved, ochkarms(t, ctx, moved))

fn ochkargs(args, ctx, moved) = match args
    Nil        => moved
    Cons(h, t) => let r = ochke(h, ctx, moved) in ochkargs(t, ctx, r.moved)

fn ochkcall(fnm, args, ctx, moved) = if ois_free(ctx.freef) == 1 and ctx.halloc == 0 and ois_heap_alloc(fnm) == 1 then ctfail("lume: ownership error [O0030]: ambient heap allocation '" + fnm + "' in '@freestanding' function '" + ctx.fnm + "' (help: pass an explicit allocator via 'with alloc = <arena> in ...')\n") else if (fnm == "move" or fnm == "drop" or fnm == "rc_drop" or fnm == "arc_drop") and len(args) == 1 then ochk_own_target(ohd_e(args), ctx, moved) else if fnm == "cap_page_map" and len(args) >= 1 then let r0 = ochk_own_target(ohd_e(args), ctx, moved) in {moved: ochkargs(ptl(args), ctx, r0.moved), origin: ""} else if fnm == "borrow" and len(args) == 1 then let ra = ochke(ohd_e(args), ctx, moved) in {moved: ra.moved, origin: "borrow:" + ra.origin} else if fnm == "borrow_mut" and len(args) == 1 then ochk_mut_target(ohd_e(args), ctx, moved) else ochkcall_sig(fnm, args, osiglookup(fnm, ctx.osigs), ctx, moved)

fn ochkcall_sig(fnm, args, msig, ctx, moved) = match msig
    Nil          => let z = ochk_conflicts(fnm, ocollect_mut_args(args, Nil), args) in {moved: ochkargs(args, ctx, moved), origin: ""}
    Cons(sg, sr) => let z1 = ochk_call_modes(fnm, args, sg.pl, ctx) in let z2 = ochk_conflicts(fnm, ocollect_mut_args(args, sg.pl), args) in let mv2 = ochkargs(args, ctx, moved) in if sg.fromp != "" then let fa = oarg_for_param(sg.fromp, args, sg.pl) in let rfa = ochke(fa, ctx, moved) in {moved: mv2, origin: "borrow:" + rfa.origin} else {moved: mv2, origin: ""}

## --- check function return region rules O0020 & O0021 ---
fn ochk_ret_origin(nm, pubf, fromp, rty, pnames, org) = let core_org = ostrip_borrow(org) in if ostarts(org, "borrow:") == 1 and ostarts(core_org, "local:") == 1 then let lx = slice(core_org, 6, count(core_org)) in ctfail("lume: region error [O0020]: borrowed value '" + lx + "' does not live long enough (escapes local scope of '" + nm + "')\n") else if ostarts(org, "borrow:") == 1 and ostarts(core_org, "param:") == 1 then let px = slice(core_org, 6, count(core_org)) in (if pubf == 1 and fromp == "" then ctfail("lume: region error [O0021]: public function '" + nm + "' returns a borrow from parameter '" + px + "' without an origin clause (help: add 'from " + px + "' to the return type)\n") else if fromp != "" and fromp != px then ctfail("lume: region error [O0021]: function '" + nm + "' declares 'from " + fromp + "' but returns a borrow from parameter '" + px + "' (help: change origin clause to 'from " + px + "')\n") else 1) else if pubf == 1 and oisreftype(rty) == 1 and fromp == "" then ctfail("lume: region error [O0021]: public function '" + nm + "' returns a borrowed view without a 'from <param>' origin clause\n") else 1

## ============================================================================================================
## Track A1: Typed holes (`_`, `_hole*`) + hole-driven candidate synthesis (`[A0001]`)
## ============================================================================================================
fn asynth_vars(expty, lenv) = match lenv
    Nil        => Nil
    Cons(h, t) => if tystr(h.v) != "?" and tcompat(expty, h.v) == 1 then Cons(h.k, asynth_vars(expty, t)) else asynth_vars(expty, t)

fn asynth_fn_arg(pt, lenv) = match lenv
    Nil        => ""
    Cons(h, t) => if tystr(h.v) != "?" and tcompat(pt, h.v) == 1 then h.k else asynth_fn_arg(pt, t)

fn asynth_fns(expty, lenv, sigs, curfn) = match sigs
    Nil        => Nil
    Cons(sg, r) => if sg.fname == curfn or tystr(sg.rt) == "?" or tcompat(expty, sg.rt) == 0 then asynth_fns(expty, lenv, r, curfn) else if len(sg.pt) == 0 then Cons(sg.fname + "()", asynth_fns(expty, lenv, r, curfn)) else if len(sg.pt) == 1 then let v = asynth_fn_arg(ohd_ty(sg.pt), lenv) in (if v != "" then Cons(sg.fname + "(" + v + ")", asynth_fns(expty, lenv, r, curfn)) else asynth_fns(expty, lenv, r, curfn)) else asynth_fns(expty, lenv, r, curfn)

fn ohd_ty(xs) = match xs
    Nil        => TyAny
    Cons(h, t) => h

fn asynth_default(expty) = match expty
    TyName(n) => if n == "int" then Cons("0", Cons("1", Nil)) else if n == "str" then Cons("\"\"", Nil) else Nil
    TyList(e) => Cons("Nil", Nil)
    _         => Nil

fn asynth_int_pairs(v, vs) = match vs
    Nil        => Cons(v + " + 1", Cons(v + " - 1", Nil))
    Cons(w, r) => Cons(v + " + " + w, Cons(v + " - " + w, Cons(w + " - " + v, Cons("if " + v + " >= " + w + " then " + v + " else " + w, Cons("if " + v + " <= " + w + " then " + v + " else " + w, asynth_int_pairs(v, r))))))

fn asynth_int_ops(vs) = match vs
    Nil        => Nil
    Cons(v, r) => app(asynth_int_pairs(v, r), asynth_int_ops(r))

fn asynth_cands(expty, lenv, sigs, curfn) = let vs = asynth_vars(expty, lenv) in let ops = if tystr(expty) == "int" then asynth_int_ops(vs) else Nil in app(vs, app(ops, app(asynth_fns(expty, lenv, sigs, curfn), asynth_default(expty))))

fn aexpr_str(e) = match e
    Num(n)        => str(n)
    Str(s)        => "\"" + s + "\""
    Var(nm)       => nm
    Bin(op, a, b) => aexpr_str(a) + " " + op + " " + aexpr_str(b)
    If(c, t, e2)  => "if " + aexpr_str(c) + " then " + aexpr_str(t) + " else " + aexpr_str(e2)
    Call(nm, xs)  => nm + "(" + aexprs_str(xs) + ")"
    _             => "0"

fn aexprs_str(xs) = match xs
    Nil        => ""
    Cons(h, t) => if isnil(t) == 1 then aexpr_str(h) else aexpr_str(h) + ", " + aexprs_str(t)

fn asynth_var_exprs(expty, lenv) = match lenv
    Nil        => Nil
    Cons(h, t) => if tystr(h.v) != "?" and tcompat(expty, h.v) == 1 then Cons(Var(h.k), asynth_var_exprs(expty, t)) else asynth_var_exprs(expty, t)

fn asynth_int_pair_es(v, vs) = match vs
    Nil        => Cons(Bin("+", Var(v), Num(1)), Cons(Bin("-", Var(v), Num(1)), Nil))
    Cons(w, r) => Cons(Bin("+", Var(v), Var(w)), Cons(Bin("-", Var(v), Var(w)), Cons(Bin("-", Var(w), Var(v)), Cons(If(Bin(">=", Var(v), Var(w)), Var(v), Var(w)), Cons(If(Bin("<=", Var(v), Var(w)), Var(v), Var(w)), asynth_int_pair_es(v, r))))))

fn asynth_int_op_es(vs) = match vs
    Nil        => Nil
    Cons(v, r) => app(asynth_int_pair_es(v, r), asynth_int_op_es(r))

fn asynth_fn_es(expty, lenv, sigs, curfn) = match sigs
    Nil        => Nil
    Cons(sg, r) => if sg.fname == curfn or tystr(sg.rt) == "?" or tcompat(expty, sg.rt) == 0 then asynth_fn_es(expty, lenv, r, curfn) else if len(sg.pt) == 0 then Cons(Call(sg.fname, Nil), asynth_fn_es(expty, lenv, r, curfn)) else if len(sg.pt) == 1 then let v = asynth_fn_arg(ohd_ty(sg.pt), lenv) in (if v != "" then Cons(Call(sg.fname, Cons(Var(v), Nil)), asynth_fn_es(expty, lenv, r, curfn)) else asynth_fn_es(expty, lenv, r, curfn)) else asynth_fn_es(expty, lenv, r, curfn)

fn asynth_def_es(expty) = match expty
    TyName(n) => if n == "int" then Cons(Num(0), Cons(Num(1), Nil)) else if n == "str" then Cons(Str(""), Nil) else Nil
    TyList(e) => Cons(Var("Nil"), Nil)
    _         => Nil

fn asynth_cand_es(expty, lenv, sigs, curfn) = let vs = asynth_vars(expty, lenv) in let ves = asynth_var_exprs(expty, lenv) in let oes = if tystr(expty) == "int" then asynth_int_op_es(vs) else Nil in app(ves, app(oes, app(asynth_fn_es(expty, lenv, sigs, curfn), asynth_def_es(expty))))

fn asubst_hole_e(e, hnm, rep) = match e
    Var(nm)         => if nm == hnm or (hnm == "_" and ais_hole_name(nm) == 1) then rep else e
    Bin(op, a, b)   => Bin(op, asubst_hole_e(a, hnm, rep), asubst_hole_e(b, hnm, rep))
    If(c, t, e2)    => If(asubst_hole_e(c, hnm, rep), asubst_hole_e(t, hnm, rep), asubst_hole_e(e2, hnm, rep))
    LetIn(nm, v, b) => LetIn(nm, asubst_hole_e(v, hnm, rep), asubst_hole_e(b, hnm, rep))
    VarIn(nm, v, b) => VarIn(nm, asubst_hole_e(v, hnm, rep), asubst_hole_e(b, hnm, rep))
    Call(nm, args)  => Call(nm, asubst_hole_args(args, hnm, rep))
    _               => e

fn asubst_hole_args(xs, hnm, rep) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(asubst_hole_e(h, hnm, rep), asubst_hole_args(t, hnm, rep))

fn aupdate_fn_ft(fnm, ps, nbody, fns) = match fns
    Nil        => Cons({nm: fnm, ps: ps, body: nbody}, Nil)
    Cons(f, r) => if f.nm == fnm then Cons({nm: fnm, ps: ps, body: nbody}, r) else Cons(f, aupdate_fn_ft(fnm, ps, nbody, r))

fn alaws_mention_fn(fnm, laws) = match laws
    Nil        => Nil
    Cons(l, r) => if omentions_call(fnm, l.body) == 1 then Cons(l, alaws_mention_fn(fnm, r)) else alaws_mention_fn(fnm, r)

fn omentions_call(fnm, e) = match e
    Call(cnm, args) => if cnm == fnm then 1 else omentions_call_args(fnm, args)
    Bin(op, a, b)   => if omentions_call(fnm, a) == 1 then 1 else omentions_call(fnm, b)
    If(c, t, e2)    => if omentions_call(fnm, c) == 1 then 1 else if omentions_call(fnm, t) == 1 then 1 else omentions_call(fnm, e2)
    LetIn(nm, v, b) => if omentions_call(fnm, v) == 1 then 1 else omentions_call(fnm, b)
    _               => 0

fn omentions_call_args(fnm, xs) = match xs
    Nil        => 0
    Cons(h, t) => if omentions_call(fnm, h) == 1 then 1 else omentions_call_args(fnm, t)

fn acheck_cand_laws(laws, fns) = match laws
    Nil        => 2
    Cons(l, r) => let lenv = vlin_init_env(l.ps) in let chyps = vcollect_body_hyps(l.body, Nil, lenv, Cons(l.body, Nil), fns, 0) in let pr = vprove_law_envs(vgen_envs_hyps(l.ps, 0, len(l.ps), chyps), l.body, fns) in if pr.status < 0 then 0 - 1 else let qf = vqflia_prove_law(l.ps, l.body, fns) in let rest = acheck_cand_laws(r, fns) in if rest < 0 then 0 - 1 else if qf == 1 and rest == 2 then 2 else 1

fn ascore_cand_e(ce, hnm, hctx) = let nbody = asubst_hole_e(hctx.body, hnm, ce) in let fns2 = aupdate_fn_ft(hctx.fnm, hctx.ps, nbody, hctx.fns) in let mvs = vsiglookup(hctx.fnm, hctx.vsigs) in let mlaws = alaws_mention_fn(hctx.fnm, hctx.laws) in let c_sc = ascore_cand_vsig(hctx.ps, nbody, mvs, fns2) in if c_sc < 0 then 0 - 1 else if isnil(mlaws) == 1 then c_sc else let l_sc = acheck_cand_laws(mlaws, fns2) in if l_sc < 0 then 0 - 1 else if c_sc == 2 or l_sc == 2 then 2 else 1

fn ascore_cand_vsig(ps, nbody, mvs, fns2) = match mvs
    Nil          => 1
    Cons(vsg, r) => let lenv = vlin_init_env(ps) in let raw_hyps = vcollect_body_hyps(nbody, (vprove_reqs_hyps(vsg.reqs, lenv, fns2)).hyps, lenv, vsg.enss, fns2, 0) in let chyps = vfm_trace_hyps(raw_hyps, vfm_vars(raw_hyps, Nil)) in let pr = vprove_envs(vgen_envs_hyps(ps, 0, len(ps), chyps), vsg.reqs, vsg.enss, nbody, fns2, 0) in if pr.status < 0 then 0 - 1 else if vqflia_prove_fn(ps, vsg.reqs, vsg.enss, nbody, fns2) == 1 then 2 else 1

fn afilter_proven_es(ces, hnm, hctx) = match ces
    Nil         => Nil
    Cons(ce, r) => if ascore_cand_e(ce, hnm, hctx) == 2 then Cons(ce, afilter_proven_es(r, hnm, hctx)) else afilter_proven_es(r, hnm, hctx)

fn afilter_valid_es(ces, hnm, hctx) = match ces
    Nil         => Nil
    Cons(ce, r) => if ascore_cand_e(ce, hnm, hctx) == 1 then Cons(ce, afilter_valid_es(r, hnm, hctx)) else afilter_valid_es(r, hnm, hctx)

fn arank_cand_es(expty, lenv, hnm, hctx) = let raw = asynth_cand_es(expty, lenv, hctx.sigs, hctx.fnm) in let prv = afilter_proven_es(raw, hnm, hctx) in let val = afilter_valid_es(raw, hnm, hctx) in let ranked = app(prv, val) in if isnil(ranked) == 0 then ranked else raw

fn abest_hole_expr(expty, lenv, hnm, hctx) = match arank_cand_es(expty, lenv, hnm, hctx)
    Nil         => Num(0)
    Cons(ce, r) => ce

fn aquick_ty(e, lenv, sigs) = match e
    Num(n)        => TyName("int")
    Str(s)        => TyName("str")
    Var(nm)       => if ais_hole_name(nm) == 1 then TyAny else aquick_var_ty(nm, lenv)
    Bin(op, a, b) => if op == "+" then aquick_plus_ty(aquick_ty(a, lenv, sigs), aquick_ty(b, lenv, sigs)) else TyName("int")
    Call(nm, xs)  => aquick_call_ty(tsiglookup(nm, sigs))
    _             => TyAny

fn aquick_var_ty(nm, lenv) = match lenv
    Nil        => TyAny
    Cons(h, t) => if h.k == nm then h.v else aquick_var_ty(nm, t)

fn aquick_plus_ty(ta, tb) = if tystr(ta) != "?" then ta else tb

fn aquick_call_ty(msig) = match msig
    Nil        => TyAny
    Cons(sg, r) => sg.rt

fn abin_expty(op, other_e, expty, lenv, sigs) = if op == "+" then let ot = aquick_ty(other_e, lenv, sigs) in (if tystr(ot) != "?" then ot else if tystr(expty) != "?" then expty else TyName("int")) else if op == "-" or op == "*" or op == "/" or op == "%" then TyName("int") else let ot = aquick_ty(other_e, lenv, sigs) in if tystr(ot) != "?" then ot else TyName("int")

fn achk_hole_var(hnm, expty, lenv, hctx) = let best = aexpr_str(abest_hole_expr(expty, lenv, hnm, hctx)) in if hctx.pubf == 1 or tystr(expty) == "?" then ctfail("lume: hole error [A0001]: unfilled typed hole '" + hnm + "' of expected type " + tystr(expty) + " in '" + hctx.fnm + "' (fix-it: replace '" + hnm + "' with '" + best + "')\n") else 1

fn achk_holes_e(e, expty, lenv, hctx) = match e
    Var(nm)         => if ais_hole_name(nm) == 1 then achk_hole_var(nm, expty, lenv, hctx) else 0
    Bin(op, a, b)   => achk_holes_e(a, abin_expty(op, b, expty, lenv, hctx.sigs), lenv, hctx) + achk_holes_e(b, abin_expty(op, a, expty, lenv, hctx.sigs), lenv, hctx)
    If(c, t, e2)    => achk_holes_e(c, TyName("int"), lenv, hctx) + achk_holes_e(t, expty, lenv, hctx) + achk_holes_e(e2, expty, lenv, hctx)
    LetIn(nm, v, b) => let vt = aquick_ty(v, lenv, hctx.sigs) in achk_holes_e(v, vt, lenv, hctx) + achk_holes_e(b, expty, Cons({k: nm, v: vt}, lenv), hctx)
    VarIn(nm, v, b) => let vt = aquick_ty(v, lenv, hctx.sigs) in achk_holes_e(v, vt, lenv, hctx) + achk_holes_e(b, expty, Cons({k: nm, v: vt}, lenv), hctx)
    DeferE(c, b)    => achk_holes_e(c, TyAny, lenv, hctx) + achk_holes_e(b, expty, lenv, hctx)
    ErrDeferE(c, b) => achk_holes_e(c, TyAny, lenv, hctx) + achk_holes_e(b, expty, lenv, hctx)
    WithAllocE(a, b) => achk_holes_e(a, TyName("int"), lenv, hctx) + achk_holes_e(b, expty, lenv, hctx)
    Call(nm, args)  => achk_holes_call(nm, args, tsiglookup(nm, hctx.sigs), lenv, hctx)
    Match(sc, arms) => achk_holes_e(sc, TyAny, lenv, hctx) + achk_holes_arms(arms, expty, lenv, hctx)
    _               => 0

fn achk_holes_call(nm, args, msig, lenv, hctx) = match msig
    Nil        => achk_holes_args_any(args, lenv, hctx)
    Cons(sg, r) => achk_holes_args_typed(args, sg.pt, lenv, hctx)

fn achk_holes_args_any(args, lenv, hctx) = match args
    Nil        => 0
    Cons(h, t) => achk_holes_e(h, TyAny, lenv, hctx) + achk_holes_args_any(t, lenv, hctx)

fn achk_holes_args_typed(args, pts, lenv, hctx) = match args
    Nil        => 0
    Cons(h, t) => achk_holes_e(h, ohd_ty(pts), lenv, hctx) + achk_holes_args_typed(t, ptl(pts), lenv, hctx)

fn achk_holes_arms(arms, expty, lenv, hctx) = match arms
    Nil        => 0
    Cons(h, t) => achk_holes_e(h.body, expty, lenv, hctx) + achk_holes_arms(t, expty, lenv, hctx)

## ============================================================================================================
## Track A2: `total fn` termination & structural/measure recursion checker (`[A0002]`)
## ============================================================================================================
fn apat_binds(p) = match p
    PBind(v)        => Cons(v, Nil)
    PCons(tag, sub) => apat_bind_list(sub)
    _               => Nil

fn apat_bind_list(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(apat_binds(h), apat_bind_list(t))

fn apat_subvars(p) = match p
    PCons(tag, sub) => apat_bind_list(sub)
    _               => Nil

fn aguard_params(ps, c, guarded) = match ps
    Nil        => guarded
    Cons(p, r) => if omentions_var(p, c) == 1 and omem(p, guarded) == 0 then Cons(p, aguard_params(r, c, guarded)) else aguard_params(r, c, guarded)

fn ais_pos_num(e, minv) = match e
    Num(k) => if k >= minv then 1 else 0
    _      => 0

fn ais_guarded_var(e, ps, guarded) = match e
    Var(p) => if omem(p, ps) == 1 and omem(p, guarded) == 1 then 1 else 0
    _      => 0

fn ais_dec_bin(op, l, r, ps, guarded) = if op == "%" and (ais_guarded_var(r, ps, guarded) == 1 or ais_pos_num(r, 2) == 1) then 1 else match l
    Var(p) => if omem(p, ps) == 1 and omem(p, guarded) == 1 then (if op == "-" and ais_pos_num(r, 1) == 1 then 1 else if op == "/" and ais_pos_num(r, 2) == 1 then 1 else 0) else 0
    _      => 0

fn ais_dec_arg(arg, ps, subvars, guarded) = match arg
    Var(v)        => omem(v, subvars)
    OwnE(inner)   => ais_dec_arg(inner, ps, subvars, guarded)
    MutE(inner)   => ais_dec_arg(inner, ps, subvars, guarded)
    Bin(op, l, r) => ais_dec_bin(op, l, r, ps, guarded)
    _             => 0

fn ais_same_param(arg, p) = match arg
    Var(v)      => if v == p then 1 else 0
    OwnE(inner) => ais_same_param(inner, p)
    MutE(inner) => ais_same_param(inner, p)
    _           => 0

fn ais_inc_bin(op, l, r, p) = match l
    Var(v) => if v == p and ((op == "+" and ais_pos_num(r, 1) == 1) or (op == "*" and ais_pos_num(r, 2) == 1)) then 1 else 0
    _      => 0

fn ais_inc_arg_for(arg, p) = match arg
    OwnE(inner)   => ais_inc_arg_for(inner, p)
    MutE(inner)   => ais_inc_arg_for(inner, p)
    Bin(op, l, r) => ais_inc_bin(op, l, r, p)
    _             => 0

fn ahas_fixed_guarded(args, ps, guarded) = match args
    Nil        => 0
    Cons(a, r) => ahas_fixed_g1(a, r, ps, guarded)

fn ahas_fixed_g1(a, ar, ps, guarded) = match ps
    Nil         => 0
    Cons(p, pr) => if omem(p, guarded) == 1 and ais_same_param(a, p) == 1 then 1 else ahas_fixed_guarded(ar, pr, guarded)

fn ahas_dec_arg(args, ps, subvars, guarded) = alex_dec_args(args, ps, ps, subvars, guarded)

fn alex_dec_args(args, cur_ps, all_ps, subvars, guarded) = match args
    Nil        => 0
    Cons(a, r) => alex_dec_step(a, r, cur_ps, all_ps, subvars, guarded)

fn alex_dec_step(a, ar, cur_ps, all_ps, subvars, guarded) = match cur_ps
    Nil         => if ais_dec_arg(a, all_ps, subvars, guarded) == 1 then 1 else alex_dec_args(ar, Nil, all_ps, subvars, guarded)
    Cons(p, pr) => if ais_dec_arg(a, all_ps, subvars, guarded) == 1 then 1 else if ais_inc_arg_for(a, p) == 1 then (if omem(p, guarded) == 1 and ahas_fixed_guarded(ar, pr, guarded) == 1 then 1 else 0) else alex_dec_args(ar, pr, all_ps, subvars, guarded)

fn afn_calls_self(nm, e) = match e
    Call(cnm, args) => if cnm == nm then 1 else afn_calls_args(nm, args)
    Bin(op, l, r)   => if afn_calls_self(nm, l) == 1 then 1 else afn_calls_self(nm, r)
    If(c, t, e2)    => if afn_calls_self(nm, c) == 1 then 1 else if afn_calls_self(nm, t) == 1 then 1 else afn_calls_self(nm, e2)
    LetIn(x, v, b)  => if afn_calls_self(nm, v) == 1 then 1 else afn_calls_self(nm, b)
    VarIn(x, v, b)  => if afn_calls_self(nm, v) == 1 then 1 else afn_calls_self(nm, b)
    Match(sc, arms) => if afn_calls_self(nm, sc) == 1 then 1 else afn_calls_arms(nm, arms)
    _               => 0

fn afn_calls_args(nm, xs) = match xs
    Nil        => 0
    Cons(h, t) => if afn_calls_self(nm, h) == 1 then 1 else afn_calls_args(nm, t)

fn afn_calls_arms(nm, xs) = match xs
    Nil        => 0
    Cons(h, t) => if afn_calls_self(nm, h.body) == 1 then 1 else afn_calls_arms(nm, t)

fn ais_fn_marked_total(nm, osigs) = match osiglookup(nm, osigs)
    Nil        => 0
    Cons(sg, r) => ois_total(sg.freef)

fn ais_nontotal_rec(cnm, fns, osigs) = if ais_fn_marked_total(cnm, osigs) == 1 then 0 else ais_nontotal_rec2(cnm, fns)

fn ais_nontotal_rec2(cnm, fns) = match fns
    Nil        => 0
    Cons(f, r) => if f.nm == cnm then afn_calls_self(cnm, f.body) else ais_nontotal_rec2(cnm, r)

fn amatch_is_param(sc, ps, subvars) = match sc
    Var(x) => if omem(x, ps) == 1 or omem(x, subvars) == 1 then 1 else 0
    _      => 0

fn achk_total_e(e, tctx, subvars, guarded) = match e
    Call(cnm, args) => let z = achk_total_args(args, tctx, subvars, guarded) in if cnm == tctx.fnm then (if ahas_dec_arg(args, tctx.ps, subvars, guarded) == 1 then 1 else ctfail("lume: totality error [A0002]: cannot prove termination of 'total fn " + tctx.fnm + "': recursive call '" + cnm + "(...)' does not decrease any parameter (fix-it: recurse on a structural pattern subterm or a guarded 'n - 1' measure)\n")) else if ais_nontotal_rec(cnm, tctx.fns, tctx.osigs) == 1 then ctfail("lume: totality error [A0002]: 'total fn " + tctx.fnm + "' cannot call non-total recursive function '" + cnm + "' (fix-it: mark 'total fn " + cnm + "' and prove its termination)\n") else 1
    If(c, t, e2)    => let g2 = aguard_params(tctx.ps, c, guarded) in achk_total_e(c, tctx, subvars, guarded) + achk_total_e(t, tctx, subvars, g2) + achk_total_e(e2, tctx, subvars, g2)
    Bin(op, l, r)   => achk_total_e(l, tctx, subvars, guarded) + achk_total_e(r, tctx, subvars, guarded)
    LetIn(nm, v, b) => achk_total_e(v, tctx, subvars, guarded) + achk_total_e(b, tctx, subvars, guarded)
    VarIn(nm, v, b) => achk_total_e(v, tctx, subvars, guarded) + achk_total_e(b, tctx, subvars, guarded)
    DeferE(c, b)    => achk_total_e(c, tctx, subvars, guarded) + achk_total_e(b, tctx, subvars, guarded)
    ErrDeferE(c, b) => achk_total_e(c, tctx, subvars, guarded) + achk_total_e(b, tctx, subvars, guarded)
    WithAllocE(a, b) => achk_total_e(a, tctx, subvars, guarded) + achk_total_e(b, tctx, subvars, guarded)
    Match(sc, arms) => achk_total_e(sc, tctx, subvars, guarded) + achk_total_arms(arms, amatch_is_param(sc, tctx.ps, subvars), tctx, subvars, guarded)
    _               => 0

fn achk_total_args(args, tctx, subvars, guarded) = match args
    Nil        => 0
    Cons(h, t) => achk_total_e(h, tctx, subvars, guarded) + achk_total_args(t, tctx, subvars, guarded)

fn achk_total_arms(arms, is_p, tctx, subvars, guarded) = match arms
    Nil        => 0
    Cons(h, t) => let sv2 = if is_p == 1 then app(apat_subvars(h.pat), subvars) else subvars in achk_total_e(h.body, tctx, sv2, guarded) + achk_total_arms(t, is_p, tctx, subvars, guarded)

## ============================================================================================================
## Track A3: Provenance & uncertainty in the type (`unverified[T]`, `llm fn`, `prob_sample`) (`[A0003]`)
## ============================================================================================================
fn auinit_vars(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, pr) => if ois_unverified_ty(ohd_ty(pts)) == 1 then Cons(pn, auinit_vars(pr, ptl(pts))) else auinit_vars(pr, ptl(pts))

fn auinit_from_sig(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => auinit_vars(sg.pn, sg.pt)

fn vhas_ensures_sig(mvs) = match mvs
    Nil          => 0
    Cons(vsg, r) => if isnil(vsg.enss) == 0 then 1 else 0

fn ais_unverified_fn(cnm, osigs, sigs, vsigs) = if cnm == "llm_complete" or cnm == "prob_sample" or cnm == "sample_dist" or cnm == "llm_prompt" or cnm == "ffi_call" then 1 else if ais_llm_osig(osiglookup(cnm, osigs)) == 1 or ais_ffi_osig(osiglookup(cnm, osigs)) == 1 then (if vhas_ensures_sig(vsiglookup(cnm, vsigs)) == 1 then 0 else 1) else ais_unverified_ret(tsiglookup(cnm, sigs))

fn ais_llm_osig(msig) = match msig
    Nil        => 0
    Cons(sg, r) => ois_llm(sg.freef)

fn ais_unverified_ret(msig) = match msig
    Nil        => 0
    Cons(sg, r) => ois_unverified_ty(sg.rt)

fn ais_trusted_sink(cnm, osigs) = if cnm == "io_write" or cnm == "db_exec" or cnm == "net_send" or cnm == "fs_write" or cnm == "trusted_sink" or cnm == "law_assert" then 1 else ais_pub_nonllm(osiglookup(cnm, osigs))

fn ais_pub_nonllm(msig) = match msig
    Nil        => 0
    Cons(sg, r) => if sg.pubf == 1 and ois_llm(sg.freef) == 0 then 1 else 0

fn asig_pts(cnm, sigs) = match tsiglookup(cnm, sigs)
    Nil        => Nil
    Cons(sg, r) => sg.pt

fn ais_cmp_guard(c) = match c
    Bin(op, l, r) => if tiscmp(op) == 1 then 1 else 0
    _             => 0

fn adischarge_vars(uvars, c) = if ais_cmp_guard(c) == 0 then uvars else adischarge_vars2(uvars, c)

fn adischarge_vars2(uvars, c) = match uvars
    Nil        => Nil
    Cons(v, r) => if omentions_var(v, c) == 1 then adischarge_vars2(r, c) else Cons(v, adischarge_vars2(r, c))

fn achk_prov_e(e, fnm, uvars, ot) = match e
    Var(x)           => omem(x, uvars)
    Field(o, fld)    => achk_prov_e(o, fnm, uvars, ot)
    OwnE(inner)      => achk_prov_e(inner, fnm, uvars, ot)
    MutE(inner)      => achk_prov_e(inner, fnm, uvars, ot)
    Bin(op, l, r)    => let tl = achk_prov_e(l, fnm, uvars, ot) in let tr = achk_prov_e(r, fnm, uvars, ot) in if tl == 1 or tr == 1 then 1 else 0
    If(c, t, e2)     => let tc = achk_prov_e(c, fnm, uvars, ot) in let uvt = adischarge_vars(uvars, c) in let tt = achk_prov_e(t, fnm, uvt, ot) in let te = achk_prov_e(e2, fnm, uvars, ot) in if tt == 1 or te == 1 then 1 else 0
    LetIn(nm, v, b)  => let tv = achk_prov_e(v, fnm, uvars, ot) in let uv2 = if tv == 1 then Cons(nm, orem(nm, uvars)) else orem(nm, uvars) in achk_prov_e(b, fnm, uv2, ot)
    VarIn(nm, v, b)  => let tv = achk_prov_e(v, fnm, uvars, ot) in let uv2 = if tv == 1 then Cons(nm, orem(nm, uvars)) else orem(nm, uvars) in achk_prov_e(b, fnm, uv2, ot)
    DeferE(c, b)     => let tc = achk_prov_e(c, fnm, uvars, ot) in achk_prov_e(b, fnm, uvars, ot)
    ErrDeferE(c, b)  => let tc = achk_prov_e(c, fnm, uvars, ot) in achk_prov_e(b, fnm, uvars, ot)
    WithAllocE(a, b) => let ta = achk_prov_e(a, fnm, uvars, ot) in achk_prov_e(b, fnm, uvars, ot)
    Match(sc, arms)  => let tsc = achk_prov_e(sc, fnm, uvars, ot) in achk_prov_arms(arms, tsc, fnm, uvars, ot)
    Call(cnm, args)  => achk_prov_call(cnm, args, fnm, uvars, ot)
    _                => 0

fn achk_prov_arms(arms, tsc, fnm, uvars, ot) = match arms
    Nil        => 0
    Cons(h, t) => let uv2 = if tsc == 1 then app(apat_binds(h.pat), uvars) else uvars in let tb = achk_prov_e(h.body, fnm, uv2, ot) in let tr = achk_prov_arms(t, tsc, fnm, uvars, ot) in if tb == 1 or tr == 1 then 1 else 0

fn achk_prov_args(args, fnm, uvars, ot) = match args
    Nil        => 0
    Cons(h, t) => let th = achk_prov_e(h, fnm, uvars, ot) in let tt = achk_prov_args(t, fnm, uvars, ot) in if th == 1 or tt == 1 then 1 else 0

fn achk_sink_args(fnm, cnm, args, pts, uvars, ot) = match args
    Nil        => 0
    Cons(a, r) => let ta = achk_prov_e(a, fnm, uvars, ot) in if ta == 1 and ois_unverified_ty(ohd_ty(pts)) == 0 then ctfail("lume: provenance error [A0003]: unverified AI/probabilistic value in '" + fnm + "' cannot flow into trusted sink '" + cnm + "' without verification (fix-it: validate with 'verify(x, <contract>)' before calling '" + cnm + "')\n") else achk_sink_args(fnm, cnm, r, ptl(pts), uvars, ot)

fn achk_prov_call(cnm, args, fnm, uvars, ot) = if cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" then let z = achk_prov_args(args, fnm, uvars, ot) in 0 else if ais_trusted_sink(cnm, ot.osigs) == 1 then let z = achk_sink_args(fnm, cnm, args, asig_pts(cnm, ot.sigs), uvars, ot) in ais_unverified_fn(cnm, ot.osigs, ot.sigs, ot.vsigs) else let ta = achk_prov_args(args, fnm, uvars, ot) in if ais_unverified_fn(cnm, ot.osigs, ot.sigs, ot.vsigs) == 1 or ta == 1 then 1 else 0

## ============================================================================================================
## Track S1: Structured concurrency (`scope` / `spawn`) & static `Send`/`Sync` checking (`[S0001]`)
## ============================================================================================================
fn sis_nonsend_ty(ty) = match ty
    TyApply(n, e) => if n == "rc" or n == "cell" or n == "Ref" then 1 else sis_nonsend_ty(e)
    TyList(e)     => sis_nonsend_ty(e)
    _             => 0

fn sis_nonsend_init(e, nsvars, mvars) = match e
    Call(cnm, args) => if cnm == "rc" or cnm == "rc_new" or cnm == "rc_clone" or cnm == "cell_new" or cnm == "borrow_mut" then 1 else sis_nonsend_args(args, nsvars, mvars)
    MutE(inner)     => 1
    Var(x)          => if omem(x, nsvars) == 1 or omem(x, mvars) == 1 then 1 else 0
    Field(o, fld)   => sis_nonsend_init(o, nsvars, mvars)
    Rec(items)      => sis_nonsend_rec(items, nsvars, mvars)
    RecT(tn, items) => sis_nonsend_rec(items, nsvars, mvars)
    _               => 0

fn sis_nonsend_args(xs, nsvars, mvars) = match xs
    Nil        => 0
    Cons(h, t) => if sis_nonsend_init(h, nsvars, mvars) == 1 then 1 else sis_nonsend_args(t, nsvars, mvars)

fn sis_nonsend_rec(xs, nsvars, mvars) = match xs
    Nil        => 0
    Cons(h, t) => if sis_nonsend_init(h.val, nsvars, mvars) == 1 then 1 else sis_nonsend_rec(t, nsvars, mvars)

fn sinit_nonsend(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, r) => if sis_nonsend_ty(ohd_ty(pts)) == 1 then Cons(pn, sinit_nonsend(r, ptl(pts))) else sinit_nonsend(r, ptl(pts))

fn sinit_nonsend_sig(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => sinit_nonsend(sg.pn, sg.pt)

fn schk_spawn_body(e, fnm, nsvars, mvars) = match e
    Var(x)                  => if omem(x, nsvars) == 1 then ctfail("lume: concurrency error [S0001]: cannot capture non-Send value '" + x + "' across 'spawn' in '" + fnm + "' (fix-it: use 'arc_new' instead of 'rc_new'/'cell_new' or pass an owned message over 'chan[T]')\n") else if omem(x, mvars) == 1 then ctfail("lume: concurrency error [S0001]: cannot capture mutable binding '" + x + "' across 'spawn' in '" + fnm + "' without 'own' transfer (fix-it: move ownership with 'own " + x + "' or share via 'arc[T]' / 'chan[T]')\n") else 0
    OwnE(inner)             => schk_spawn_own(inner, fnm, nsvars)
    MutE(inner)             => ctfail("lume: concurrency error [S0001]: cannot capture mutable borrow 'mut' across 'spawn' in '" + fnm + "' (fix-it: transfer ownership with 'own' or synchronize via 'chan[T]')\n")
    Field(o, fld)           => schk_spawn_body(o, fnm, nsvars, mvars)
    Bin(op, l, r)           => schk_spawn_body(l, fnm, nsvars, mvars) + schk_spawn_body(r, fnm, nsvars, mvars)
    If(c, t, e2)            => schk_spawn_body(c, fnm, nsvars, mvars) + schk_spawn_body(t, fnm, nsvars, mvars) + schk_spawn_body(e2, fnm, nsvars, mvars)
    LetIn(nm, v, b)         => schk_spawn_body(v, fnm, nsvars, mvars) + schk_spawn_body(b, fnm, orem(nm, nsvars), orem(nm, mvars))
    VarIn(nm, v, b)         => schk_spawn_body(v, fnm, nsvars, mvars) + schk_spawn_body(b, fnm, orem(nm, nsvars), orem(nm, mvars))
    Call(cnm, args)         => if cnm == "borrow_mut" then ctfail("lume: concurrency error [S0001]: cannot capture mutable borrow 'borrow_mut' across 'spawn' in '" + fnm + "' (fix-it: transfer ownership with 'own' or synchronize via 'chan[T]')\n") else schk_spawn_args(args, fnm, nsvars, mvars)
    Rec(items)              => schk_spawn_rec(items, fnm, nsvars, mvars)
    RecT(tn, items)         => schk_spawn_rec(items, fnm, nsvars, mvars)
    ScopeE(snm, b)          => schk_spawn_body(b, fnm, nsvars, mvars)
    SpawnE(inner)           => schk_spawn_body(inner, fnm, nsvars, mvars)
    ShardE(vnm, lo, hi, b)  => schk_spawn_body(lo, fnm, nsvars, mvars) + schk_spawn_body(hi, fnm, nsvars, mvars) + schk_spawn_body(b, fnm, orem(vnm, nsvars), orem(vnm, mvars))
    _                       => 0

fn schk_spawn_rec(items, fnm, nsvars, mvars) = match items
    Nil        => 0
    Cons(h, t) => schk_spawn_body(h.val, fnm, nsvars, mvars) + schk_spawn_rec(t, fnm, nsvars, mvars)

fn schk_spawn_own(inner, fnm, nsvars) = match inner
    Var(x) => if omem(x, nsvars) == 1 then ctfail("lume: concurrency error [S0001]: cannot transfer non-Send value '" + x + "' across 'spawn' in '" + fnm + "' (fix-it: convert 'rc[T]'/'cell[T]' to 'arc[T]')\n") else 0
    _      => schk_spawn_body(inner, fnm, nsvars, Nil)

fn schk_spawn_args(args, fnm, nsvars, mvars) = match args
    Nil        => 0
    Cons(h, t) => schk_spawn_body(h, fnm, nsvars, mvars) + schk_spawn_args(t, fnm, nsvars, mvars)

fn schk_conc_e(e, fnm, in_scope, nsvars, mvars) = match e
    ScopeE(snm, b)          => schk_conc_e(b, fnm, 1, nsvars, mvars)
    SpawnE(inner)           => if in_scope == 0 then ctfail("lume: concurrency error [S0001]: unstructured 'spawn' in '" + fnm + "' is forbidden outside a lexical 'scope' block (fix-it: wrap the task in 'scope s in spawn(...)')\n") else schk_spawn_body(inner, fnm, nsvars, mvars) + schk_conc_e(inner, fnm, in_scope, nsvars, mvars)
    ShardE(vnm, lo, hi, b)  => schk_conc_e(lo, fnm, in_scope, nsvars, mvars) + schk_conc_e(hi, fnm, in_scope, nsvars, mvars) + schk_spawn_body(b, fnm, orem(vnm, nsvars), orem(vnm, mvars)) + schk_conc_e(b, fnm, in_scope, orem(vnm, nsvars), orem(vnm, mvars))
    LetIn(nm, v, b)         => let z1 = schk_conc_e(v, fnm, in_scope, nsvars, mvars) in let ns2 = if sis_nonsend_init(v, nsvars, mvars) == 1 then Cons(nm, orem(nm, nsvars)) else orem(nm, nsvars) in schk_conc_e(b, fnm, in_scope, ns2, orem(nm, mvars))
    VarIn(nm, v, b)         => let z1 = schk_conc_e(v, fnm, in_scope, nsvars, mvars) in let ns2 = if sis_nonsend_init(v, nsvars, mvars) == 1 then Cons(nm, orem(nm, nsvars)) else orem(nm, nsvars) in schk_conc_e(b, fnm, in_scope, ns2, Cons(nm, orem(nm, mvars)))
    Bin(op, l, r)           => schk_conc_e(l, fnm, in_scope, nsvars, mvars) + schk_conc_e(r, fnm, in_scope, nsvars, mvars)
    If(c, t, e2)            => schk_conc_e(c, fnm, in_scope, nsvars, mvars) + schk_conc_e(t, fnm, in_scope, nsvars, mvars) + schk_conc_e(e2, fnm, in_scope, nsvars, mvars)
    DeferE(c, b)            => schk_conc_e(c, fnm, in_scope, nsvars, mvars) + schk_conc_e(b, fnm, in_scope, nsvars, mvars)
    ErrDeferE(c, b)         => schk_conc_e(c, fnm, in_scope, nsvars, mvars) + schk_conc_e(b, fnm, in_scope, nsvars, mvars)
    WithAllocE(a, b)        => schk_conc_e(a, fnm, in_scope, nsvars, mvars) + schk_conc_e(b, fnm, in_scope, nsvars, mvars)
    WithHandlerE(en, hs, b) => schk_conc_e(b, fnm, in_scope, nsvars, mvars)
    Call(cnm, args)         => if cnm == "spawn_task" and in_scope == 0 then ctfail("lume: concurrency error [S0001]: unstructured 'spawn_task' in '" + fnm + "' is forbidden outside a lexical 'scope' block (fix-it: wrap the task in 'scope s in ...')\n") else if cnm == "spawn_task" or cnm == "shard" then schk_spawn_args(args, fnm, nsvars, mvars) else schk_conc_args(args, fnm, in_scope, nsvars, mvars)
    Match(sc, arms)         => schk_conc_e(sc, fnm, in_scope, nsvars, mvars) + schk_conc_arms(arms, fnm, in_scope, nsvars, mvars)
    _                       => 0

fn schk_conc_args(args, fnm, in_scope, nsvars, mvars) = match args
    Nil        => 0
    Cons(h, t) => schk_conc_e(h, fnm, in_scope, nsvars, mvars) + schk_conc_args(t, fnm, in_scope, nsvars, mvars)

fn schk_conc_arms(arms, fnm, in_scope, nsvars, mvars) = match arms
    Nil        => 0
    Cons(h, t) => schk_conc_e(h.body, fnm, in_scope, nsvars, mvars) + schk_conc_arms(t, fnm, in_scope, nsvars, mvars)

## ============================================================================================================
## Track V: Contract Verification (`requires` / `ensures` / `invariant` / `old`), QF_LIA Prover & `law` (`[V0001]`)
## ============================================================================================================
fn vcollect_rtypes(prog) = match prog
    Nil        => Nil
    Cons(h, t) => vcollect_rtype1(h, vcollect_rtypes(t))

fn vcollect_rtype1(st, rest) = match st
    TypeRefineS(nm, bty, pr) => Cons({nm: nm, bty: bty, pr: pr}, rest)
    _                        => rest

fn vrtype_lookup(nm, rtypes) = match rtypes
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else vrtype_lookup(nm, t)

fn vsubst_self(e, vnm) = match e
    Var(nm)         => if nm == "self" then Var(vnm) else e
    Bin(op, l, r)   => Bin(op, vsubst_self(l, vnm), vsubst_self(r, vnm))
    If(c, t, e2)    => If(vsubst_self(c, vnm), vsubst_self(t, vnm), vsubst_self(e2, vnm))
    LetIn(nm, v, b) => LetIn(nm, vsubst_self(v, vnm), if nm == "self" then b else vsubst_self(b, vnm))
    Call(cnm, args) => Call(cnm, vsubst_self_args(args, vnm))
    Field(o, fld)   => Field(vsubst_self(o, vnm), fld)
    _               => e

fn vsubst_self_args(xs, vnm) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(vsubst_self(h, vnm), vsubst_self_args(t, vnm))

fn vrefine_preds(ty, vnm, rtypes) = match ty
    TyRefine(bty, pr) => app(vrefine_preds(bty, vnm, rtypes), Cons(vsubst_self(pr, vnm), Nil))
    TyName(tn)        => vrefine_preds_nm(tn, vnm, vrtype_lookup(tn, rtypes), rtypes)
    _                 => Nil

fn vrefine_preds_nm(tn, vnm, m, rtypes) = match m
    Nil         => Nil
    Cons(rt, r) => app(vrefine_preds(rt.bty, vnm, rtypes), Cons(vsubst_self(rt.pr, vnm), Nil))

fn vrefine_param_reqs(ps, ts, rtypes) = match ps
    Nil        => Nil
    Cons(p, r) => vrefine_param_reqs2(p, r, ts, rtypes)

fn vrefine_param_reqs2(p, r, ts, rtypes) = match ts
    Nil         => Nil
    Cons(ty, tr) => app(vrefine_preds(ty, p, rtypes), vrefine_param_reqs(r, tr, rtypes))

fn vmerge_vsig(nm, ps, reqs, enss, vsigs) = if isnil(reqs) == 1 and isnil(enss) == 1 then vsigs else vmerge_vsig2(nm, ps, reqs, enss, vsigs)

fn vmerge_vsig2(nm, ps, reqs, enss, vsigs) = match vsigs
    Nil         => Cons({nm: nm, ps: ps, reqs: reqs, enss: enss}, Nil)
    Cons(v, vr) => if v.nm == nm then Cons({nm: nm, ps: v.ps, reqs: app(reqs, v.reqs), enss: app(enss, v.enss)}, vr) else Cons(v, vmerge_vsig2(nm, ps, reqs, enss, vr))

fn vcollect_vsigs(prog) = vcollect_vsigs_r(prog, vcollect_rtypes(prog), vcollect_vsigs_raw(prog))

fn vcollect_vsigs_raw(prog) = match prog
    Nil        => Nil
    Cons(h, t) => vcollect_vsig1(h, vcollect_vsigs_raw(t))

fn vcollect_vsig1(st, rest) = match st
    VContractSig(nm, ps, reqs, enss) => Cons({nm: nm, ps: ps, reqs: reqs, enss: enss}, rest)
    _                                => rest

fn vcollect_vsigs_r(prog, rtypes, acc) = match prog
    Nil        => acc
    Cons(h, t) => vcollect_vsigs_r(t, rtypes, vcollect_vsig_sig(h, rtypes, acc))

fn vcollect_vsig_sig(st, rtypes, acc) = match st
    Sig(nm, ps, ts, rt) => vmerge_vsig(nm, ps, vrefine_param_reqs(ps, ts, rtypes), vrefine_preds(rt, "result", rtypes), acc)
    _                   => acc

fn vcollect_invs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => vcollect_inv1(h, vcollect_invs(t))

fn vcollect_inv1(st, rest) = match st
    VTypeInvariant(nm, fs, inv) => Cons({nm: nm, fs: fs, inv: inv}, rest)
    _                           => rest

fn vcollect_laws(prog) = match prog
    Nil        => Nil
    Cons(h, t) => vcollect_law1(h, vcollect_laws(t))

fn vcollect_law1(st, rest) = match st
    VLawDecl(nm, ps, body) => Cons({nm: nm, ps: ps, body: body}, rest)
    _                      => rest

fn vsiglookup(nm, vsigs) = match vsigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else vsiglookup(nm, t)

fn vinvlookup(nm, invs) = match invs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else vinvlookup(nm, t)

fn vfnlookup(nm, fns) = match fns
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else vfnlookup(nm, t)

fn vv_int(n) = {ok: 1, i: n, fields: Nil}
fn vv_rec(fs) = {ok: 1, i: 0, fields: fs}
fn vv_err() = {ok: 0, i: 0, fields: Nil}

fn vlookup(nm, env) = match env
    Nil        => vv_err()
    Cons(h, t) => if h.k == nm then h.v else vlookup(nm, t)

fn vflookup(fld, fs) = match fs
    Nil        => vv_err()
    Cons(h, t) => if h.key == fld then h.val else vflookup(fld, t)

fn vbind_ps(ps, vs) = match ps
    Nil        => Nil
    Cons(p, r) => vbind_p1(p, r, vs)

fn vbind_p1(p, r, vs) = match vs
    Nil         => Nil
    Cons(v, vr) => Cons({k: p, v: v}, vbind_ps(r, vr))

fn vfields_env(fs) = match fs
    Nil        => Nil
    Cons(h, t) => Cons({k: h.key, v: h.val}, vfields_env(t))

fn veval_bin(op, rl, rr) = if rl.ok == 0 or rr.ok == 0 then vv_err() else let x = rl.i in let y = rr.i in if op == "+" then vv_int(x + y) else if op == "-" then vv_int(x - y) else if op == "*" then vv_int(x * y) else if op == "/" then (if y == 0 then vv_err() else vv_int(x / y)) else if op == "%" then (if y == 0 then vv_err() else vv_int(x % y)) else if op == "==" then vv_int(if x == y then 1 else 0) else if op == "!=" then vv_int(if x != y then 1 else 0) else if op == "<" then vv_int(if x < y then 1 else 0) else if op == ">" then vv_int(if x > y then 1 else 0) else if op == "<=" then vv_int(if x <= y then 1 else 0) else if op == ">=" then vv_int(if x >= y then 1 else 0) else if op == "and" then vv_int(if x != 0 and y != 0 then 1 else 0) else if op == "or" then vv_int(if x != 0 or y != 0 then 1 else 0) else vv_err()

fn vadd_hops_fns(hs, fns) = match hs
    Nil        => fns
    Cons(h, t) => Cons({nm: h.op, ps: h.ps, body: h.body}, vadd_hops_fns(t, fns))

fn veval(e, env, old_env, fns, d) = if d > 20 then vv_err() else veval1(e, env, old_env, fns, d)

fn veval1(e, env, old_env, fns, d) = match e
    Num(n)                  => vv_int(n)
    Str(s)                  => vv_int(0)
    Var(nm)                 => vlookup(nm, env)
    OwnE(inner)             => veval(inner, env, old_env, fns, d)
    MutE(inner)             => veval(inner, env, old_env, fns, d)
    CT(inner)               => veval(inner, env, old_env, fns, d)
    WithHandlerE(en, hs, b) => veval(b, env, old_env, vadd_hops_fns(hs, fns), d)
    ScopeE(snm, b)          => veval(b, Cons({k: snm, v: vv_int(1)}, env), old_env, fns, d)
    SpawnE(inner)           => veval(inner, env, old_env, fns, d)
    AwaitE(inner)           => veval(inner, env, old_env, fns, d)
    Bin(op, l, r)           => veval_bin(op, veval(l, env, old_env, fns, d), veval(r, env, old_env, fns, d))
    If(c, t, e2)            => let rc = veval(c, env, old_env, fns, d) in if rc.ok == 0 then vv_err() else if rc.i != 0 then veval(t, env, old_env, fns, d) else veval(e2, env, old_env, fns, d)
    LetIn(nm, v, b)         => let rv = veval(v, env, old_env, fns, d) in if rv.ok == 0 then vv_err() else veval(b, Cons({k: nm, v: rv}, env), old_env, fns, d)
    VarIn(nm, v, b)         => let rv = veval(v, env, old_env, fns, d) in if rv.ok == 0 then vv_err() else veval(b, Cons({k: nm, v: rv}, env), old_env, fns, d)
    Rec(items)              => veval_rec(items, env, old_env, fns, d)
    RecT(tn, items)         => veval_rec(items, env, old_env, fns, d)
    Field(o, fld)           => let ro = veval(o, env, old_env, fns, d) in if ro.ok == 0 then vv_err() else vflookup(fld, ro.fields)
    Call(cnm, args)         => veval_call(cnm, args, env, old_env, fns, d)
    _                       => vv_err()

fn veval_rec(items, env, old_env, fns, d) = match items
    Nil        => vv_rec(Nil)
    Cons(h, t) => let rv = veval(h.val, env, old_env, fns, d) in if rv.ok == 0 then vv_err() else let rt = veval_rec(t, env, old_env, fns, d) in if rt.ok == 0 then vv_err() else vv_rec(Cons({key: h.key, val: rv}, rt.fields))

fn veval_args(args, env, old_env, fns, d) = match args
    Nil        => {ok: 1, vals: Nil}
    Cons(h, t) => let rh = veval(h, env, old_env, fns, d) in if rh.ok == 0 then {ok: 0, vals: Nil} else let rt = veval_args(t, env, old_env, fns, d) in if rt.ok == 0 then {ok: 0, vals: Nil} else {ok: 1, vals: Cons(rh, rt.vals)}

fn vbv_pow2(k) = if k <= 0 then 1 else if k >= 16 then 65536 * vbv_pow2(k - 16) else if k >= 8 then 256 * vbv_pow2(k - 8) else if k >= 4 then 16 * vbv_pow2(k - 4) else 2 * vbv_pow2(k - 1)
fn vbv_mod(x, m) = let r = x % m in if r < 0 then r + m else r
fn vbv_and(x, y, b) = if b <= 0 or x <= 0 or y <= 0 then 0 else ((x % 2) * (y % 2)) + 2 * vbv_and(x / 2, y / 2, b - 1)
fn vbv_or(x, y, b) = if b <= 0 or (x <= 0 and y <= 0) then 0 else (if (x % 2) + (y % 2) >= 1 then 1 else 0) + 2 * vbv_or(x / 2, y / 2, b - 1)
fn vbv_xor(x, y, b) = if b <= 0 or (x <= 0 and y <= 0) then 0 else (((x % 2) + (y % 2)) % 2) + 2 * vbv_xor(x / 2, y / 2, b - 1)

fn veval_arr_lookup(k, ar) = let r = vflookup(k, ar.fields) in if r.ok == 1 then r else let d = vflookup("__def", ar.fields) in if d.ok == 1 then d else vv_int(ar.i)

fn veval_forall_loop(vnm, k, hi, pred, env, fns) = if k > hi then vv_int(1) else let r = veval(pred, Cons({k: vnm, v: vv_int(k)}, env), env, fns, 0) in if r.ok == 0 then vv_err() else if r.i == 0 then vv_int(0) else veval_forall_loop(vnm, k + 1, hi, pred, env, fns)

fn veval_exists_loop(vnm, k, hi, pred, env, fns) = if k > hi then vv_int(0) else let r = veval(pred, Cons({k: vnm, v: vv_int(k)}, env), env, fns, 0) in if r.ok == 0 then vv_err() else if r.i != 0 then vv_int(1) else veval_exists_loop(vnm, k + 1, hi, pred, env, fns)

fn veval_m1_call(cnm, args, env, old_env, fns, d) = if (cnm == "bv_and" or cnm == "bit_and") and len(args) == 2 then (let a = veval(ohd_e(args), env, old_env, fns, d) in let b = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if a.ok == 0 or b.ok == 0 then vv_err() else vv_int(vbv_and(vbv_mod(a.i, 65536), vbv_mod(b.i, 65536), 16))) else if (cnm == "bv_or" or cnm == "bit_or") and len(args) == 2 then (let a = veval(ohd_e(args), env, old_env, fns, d) in let b = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if a.ok == 0 or b.ok == 0 then vv_err() else vv_int(vbv_or(vbv_mod(a.i, 65536), vbv_mod(b.i, 65536), 16))) else if (cnm == "bv_xor" or cnm == "bit_xor") and len(args) == 2 then (let a = veval(ohd_e(args), env, old_env, fns, d) in let b = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if a.ok == 0 or b.ok == 0 then vv_err() else vv_int(vbv_xor(vbv_mod(a.i, 65536), vbv_mod(b.i, 65536), 16))) else if (cnm == "bv_shl" or cnm == "bit_shl") and len(args) == 2 then (let a = veval(ohd_e(args), env, old_env, fns, d) in let b = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if a.ok == 0 or b.ok == 0 or b.i < 0 then vv_err() else vv_int(a.i * vbv_pow2(b.i))) else if (cnm == "bv_shr" or cnm == "bit_shr") and len(args) == 2 then (let a = veval(ohd_e(args), env, old_env, fns, d) in let b = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if a.ok == 0 or b.ok == 0 or b.i < 0 then vv_err() else vv_int(a.i / vbv_pow2(b.i))) else if cnm == "bv_u8" and len(args) == 1 then (let a = veval(ohd_e(args), env, old_env, fns, d) in if a.ok == 0 then vv_err() else vv_int(vbv_mod(a.i, 256))) else if cnm == "bv_not_u8" and len(args) == 1 then (let a = veval(ohd_e(args), env, old_env, fns, d) in if a.ok == 0 then vv_err() else vv_int(255 - vbv_mod(a.i, 256))) else if cnm == "bv_add_u8" and len(args) == 2 then (let a = veval(ohd_e(args), env, old_env, fns, d) in let b = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if a.ok == 0 or b.ok == 0 then vv_err() else vv_int(vbv_mod(a.i + b.i, 256))) else if cnm == "bv_sub_u8" and len(args) == 2 then (let a = veval(ohd_e(args), env, old_env, fns, d) in let b = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if a.ok == 0 or b.ok == 0 then vv_err() else vv_int(vbv_mod(a.i - b.i, 256))) else if cnm == "bv_mul_u8" and len(args) == 2 then (let a = veval(ohd_e(args), env, old_env, fns, d) in let b = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if a.ok == 0 or b.ok == 0 then vv_err() else vv_int(vbv_mod(a.i * b.i, 256))) else if (cnm == "array_new" or cnm == "array_const") and len(args) == 1 then (let dv = veval(ohd_e(args), env, old_env, fns, d) in if dv.ok == 0 then vv_err() else vv_rec(Cons({key: "__def", val: dv}, Nil))) else if (cnm == "array_store" or cnm == "heap_write") and len(args) == 3 then (let ar = veval(ohd_e(args), env, old_env, fns, d) in let ix = veval(ohd_e(ptl(args)), env, old_env, fns, d) in let vl = veval(ohd_e(ptl(ptl(args))), env, old_env, fns, d) in if ar.ok == 0 or ix.ok == 0 or vl.ok == 0 then vv_err() else let d0 = vflookup("__def", ar.fields) in let fs0 = if d0.ok == 1 then ar.fields else Cons({key: "__def", val: vv_int(ar.i)}, ar.fields) in vv_rec(Cons({key: str(ix.i), val: vl}, fs0))) else if (cnm == "array_select" or cnm == "heap_read") and len(args) == 2 then (let ar = veval(ohd_e(args), env, old_env, fns, d) in let ix = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if ar.ok == 0 or ix.ok == 0 then vv_err() else veval_arr_lookup(str(ix.i), ar)) else if (cnm == "points_to" or cnm == "heap_new") and len(args) == 2 then (let pt = veval(ohd_e(args), env, old_env, fns, d) in let vl = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if pt.ok == 0 or vl.ok == 0 then vv_err() else vv_rec(Cons({key: str(pt.i), val: vl}, Cons({key: "__dom", val: vv_int(pt.i)}, Cons({key: "__valid", val: vv_int(1)}, Nil))))) else if cnm == "sep_disjoint" and len(args) == 2 then (let p1 = veval(ohd_e(args), env, old_env, fns, d) in let p2 = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if p1.ok == 0 or p2.ok == 0 then vv_err() else vv_int(if p1.i != p2.i then 1 else 0)) else if cnm == "sep_conj" and len(args) == 2 then (let h1 = veval(ohd_e(args), env, old_env, fns, d) in let h2 = veval(ohd_e(ptl(args)), env, old_env, fns, d) in if h1.ok == 0 or h2.ok == 0 then vv_err() else let d1 = vflookup("__dom", h1.fields) in let d2 = vflookup("__dom", h2.fields) in let v1 = vflookup("__valid", h1.fields) in let v2 = vflookup("__valid", h2.fields) in let ok_sep = if d1.ok == 1 and d2.ok == 1 and d1.i != d2.i and (v1.ok == 0 or v1.i != 0) and (v2.ok == 0 or v2.i != 0) then 1 else 0 in {ok: 1, i: ok_sep, fields: Cons({key: "__valid", val: vv_int(ok_sep)}, app(h1.fields, h2.fields))}) else if cnm == "sep_valid" and len(args) == 1 then (let h = veval(ohd_e(args), env, old_env, fns, d) in if h.ok == 0 then vv_err() else let v = vflookup("__valid", h.fields) in if v.ok == 1 then v else vv_int(h.i)) else if cnm == "forall_range" and len(args) == 4 then (let vnm = n4_var_name(ohd_e(args)) in let lo = veval(ohd_e(ptl(args)), env, old_env, fns, d) in let hi = veval(ohd_e(ptl(ptl(args))), env, old_env, fns, d) in if vnm == "" or lo.ok == 0 or hi.ok == 0 or hi.i - lo.i > 32 then vv_err() else veval_forall_loop(vnm, lo.i, hi.i, ohd_e(ptl(ptl(ptl(args)))), env, fns)) else if cnm == "exists_range" and len(args) == 4 then (let vnm = n4_var_name(ohd_e(args)) in let lo = veval(ohd_e(ptl(args)), env, old_env, fns, d) in let hi = veval(ohd_e(ptl(ptl(args))), env, old_env, fns, d) in if vnm == "" or lo.ok == 0 or hi.ok == 0 or hi.i - lo.i > 32 then vv_err() else veval_exists_loop(vnm, lo.i, hi.i, ohd_e(ptl(ptl(ptl(args)))), env, fns)) else veval_ufn(vfnlookup(cnm, fns), veval_args(args, env, old_env, fns, d), fns, d)

fn veval_call(cnm, args, env, old_env, fns, d) = if cnm == "old" and len(args) == 1 then veval(ohd_e(args), old_env, old_env, fns, d) else if (cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" or cnm == "borrow" or cnm == "borrow_mut" or cnm == "move" or cnm == "clone" or cnm == "block_on" or cnm == "rc" or cnm == "arc" or cnm == "rc_new" or cnm == "arc_new" or cnm == "rc_clone" or cnm == "arc_clone" or cnm == "rc_get" or cnm == "arc_get" or cnm == "get" or cnm == "promise" or cnm == "promise_new" or cnm == "promise_await" or cnm == "signal" or cnm == "signal_new" or cnm == "signal_get") and len(args) >= 1 then veval(ohd_e(args), env, old_env, fns, d) else if cnm == "grad" and len(args) >= 2 then veval_call("__ad_grad_" + n4_var_name(ohd_e(args)), ptl(args), env, old_env, fns, d) else if cnm == "jit" and len(args) >= 2 then veval_call(n4_var_name(ohd_e(args)), ptl(args), env, old_env, fns, d) else if cnm == "dec_add" and len(args) == 2 then veval_bin("+", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_sub" and len(args) == 2 then veval_bin("-", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_eq" and len(args) == 2 then veval_bin("==", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_lt" and len(args) == 2 then veval_bin("<", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_le" and len(args) == 2 then veval_bin("<=", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_gt" and len(args) == 2 then veval_bin(">", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else if cnm == "dec_ge" and len(args) == 2 then veval_bin(">=", veval(ohd_e(args), env, old_env, fns, d), veval(ohd_e(ptl(args)), env, old_env, fns, d)) else veval_m1_call(cnm, args, env, old_env, fns, d)

fn veval_ufn(mf, ra, fns, d) = match mf
    Nil        => vv_err()
    Cons(f, r) => if ra.ok == 0 then vv_err() else let fenv = vbind_ps(f.ps, ra.vals) in veval(f.body, fenv, fenv, fns, d + 1)

fn vpts_a() = Cons(0, Cons(1, Cons(0 - 1, Nil)))
fn vpts_b() = Cons(0, Cons(1, Nil))
fn vpts_c() = Cons(0, Cons(1, Nil))
fn vpts_for(idx, total) = if total <= 1 then vpts_a() else if total == 2 then vpts_b() else if idx < 3 then vpts_c() else Cons(0, Nil)

fn vgen_envs(ps, idx, total) = match ps
    Nil        => Cons(Nil, Nil)
    Cons(p, r) => vcross_p(p, vpts_for(idx, total), vgen_envs(r, idx + 1, total))

fn vcross_p(p, pts, envs) = match pts
    Nil         => Nil
    Cons(x, xr) => app(vbind_all(p, vv_int(x), envs), vcross_p(p, xr, envs))

fn vbind_all(p, v, envs) = match envs
    Nil         => Nil
    Cons(e, er) => Cons(Cons({k: p, v: v}, e), vbind_all(p, v, er))

fn vfmt_env(env) = match env
    Nil        => ""
    Cons(h, t) => let s = h.k + " = " + str((h.v).i) in if isnil(t) == 1 then s else s + ", " + vfmt_env(t)

fn veval_all_true(es, env, old_env, fns) = match es
    Nil        => {ok: 1, hold: 1}
    Cons(h, t) => let rh = veval(h, env, old_env, fns, 0) in if rh.ok == 0 then {ok: 0, hold: 0} else if rh.i == 0 then {ok: 1, hold: 0} else veval_all_true(t, env, old_env, fns)

fn vprove_envs(envs, reqs, enss, body, fns, undec) = match envs
    Nil          => {status: 0, cex: ""}
    Cons(env, r) => let rq = veval_all_true(reqs, env, env, fns) in if rq.ok == 0 then vprove_envs(r, reqs, enss, body, fns, 1) else if rq.hold == 0 then vprove_envs(r, reqs, enss, body, fns, undec) else if isnil(enss) == 1 then vprove_envs(r, reqs, enss, body, fns, undec) else let rb = veval(body, env, env, fns, 0) in if rb.ok == 0 then vprove_envs(r, reqs, enss, body, fns, 1) else let penv = Cons({k: "result", v: rb}, Cons({k: "ret", v: rb}, env)) in let eq = veval_all_true(enss, penv, env, fns) in if eq.ok == 0 then vprove_envs(r, reqs, enss, body, fns, 1) else if eq.hold == 0 then {status: 0 - 1, cex: vfmt_env(env) + " (result = " + str(rb.i) + ")"} else vprove_envs(r, reqs, enss, body, fns, undec)

## --- Stage B: Sound QF_LIA (Quantifier-Free Linear Integer Arithmetic) Decision Procedure (Fourier-Motzkin) ---
fn vlin_const(n) = {ok: 1, c0: n, cs: Nil}
fn vlin_var(nm) = {ok: 1, c0: 0, cs: Cons({k: nm, c: 1}, Nil)}
fn vlin_err() = {ok: 0, c0: 0, cs: Nil}

fn vlin_coeff(nm, cs) = match cs
    Nil        => 0
    Cons(h, t) => if h.k == nm then h.c else vlin_coeff(nm, t)

fn vlin_add_term(nm, c, cs) = if c == 0 then cs else vlin_add_t1(nm, c, cs)

fn vlin_add_t1(nm, c, cs) = match cs
    Nil        => Cons({k: nm, c: c}, Nil)
    Cons(h, t) => if h.k == nm then (if h.c + c == 0 then t else Cons({k: nm, c: h.c + c}, t)) else Cons(h, vlin_add_t1(nm, c, t))

fn vlin_add_cs(cs1, cs2) = match cs1
    Nil        => cs2
    Cons(h, t) => vlin_add_cs(t, vlin_add_term(h.k, h.c, cs2))

fn vlin_scale_cs(k, cs) = if k == 0 then Nil else vlin_scale_cs1(k, cs)

fn vlin_scale_cs1(k, cs) = match cs
    Nil        => Nil
    Cons(h, t) => Cons({k: h.k, c: k * h.c}, vlin_scale_cs1(k, t))

fn vlin_add(a, b) = if a.ok == 0 or b.ok == 0 then vlin_err() else {ok: 1, c0: a.c0 + b.c0, cs: vlin_add_cs(a.cs, b.cs)}
fn vlin_scale(k, a) = if a.ok == 0 then vlin_err() else {ok: 1, c0: k * a.c0, cs: vlin_scale_cs(k, a.cs)}
fn vlin_sub(a, b) = vlin_add(a, vlin_scale(0 - 1, b))

fn vmono_key(k1, k2) = if k1 <= k2 then k1 + "*" + k2 else k2 + "*" + k1

fn vlin_mul_term_cs(k1, c1, cs2) = match cs2
    Nil        => Nil
    Cons(h, t) => vlin_add_term(vmono_key(k1, h.k), c1 * h.c, vlin_mul_term_cs(k1, c1, t))

fn vlin_mul_cs(cs1, cs2) = match cs1
    Nil        => Nil
    Cons(h, t) => vlin_add_cs(vlin_mul_term_cs(h.k, h.c, cs2), vlin_mul_cs(t, cs2))

fn vlin_mul(a, b) = if a.ok == 0 or b.ok == 0 then vlin_err() else if isnil(a.cs) == 1 then vlin_scale(a.c0, b) else if isnil(b.cs) == 1 then vlin_scale(b.c0, a) else let t0 = vlin_add(vlin_scale(a.c0, b), vlin_scale(b.c0, {ok: 1, c0: 0, cs: a.cs})) in {ok: 1, c0: t0.c0, cs: vlin_add_cs(t0.cs, vlin_mul_cs(a.cs, b.cs))}

fn vlin_is_zero(l) = if l.ok == 1 and l.c0 == 0 and isnil(l.cs) == 1 then 1 else 0
fn vlin_eq(a, b) = vlin_is_zero(vlin_sub(a, b))

fn vlin_key_cs(cs) = match cs
    Nil        => ""
    Cons(h, t) => str(h.c) + "*" + h.k + (if isnil(t) == 1 then "" else "+" + vlin_key_cs(t))

fn vlin_key_str(l) = if l.ok == 0 then "?" else if isnil(l.cs) == 1 then str(l.c0) else if l.c0 == 0 and len(l.cs) == 1 and vlin_coeff((phd_cs(l.cs)).k, l.cs) == 1 then (phd_cs(l.cs)).k else str(l.c0) + "+" + vlin_key_cs(l.cs)

fn phd_cs(cs) = match cs
    Nil        => {k: "", c: 0}
    Cons(h, t) => h

fn vlin_is_contra(l) = if l.ok == 1 and isnil(l.cs) == 1 and l.c0 < 0 then 1 else 0

fn vfm_any_contra(hyps) = match hyps
    Nil        => 0
    Cons(h, t) => if vlin_is_contra(h) == 1 then 1 else vfm_any_contra(t)

fn vfm_vars_cs(cs, acc) = match cs
    Nil        => acc
    Cons(h, t) => vfm_vars_cs(t, if omem(h.k, acc) == 1 then acc else Cons(h.k, acc))

fn vfm_vars(hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => vfm_vars(t, vfm_vars_cs(h.cs, acc))

fn vfm_part_pos(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if vlin_coeff(v, h.cs) > 0 then Cons(h, vfm_part_pos(v, t)) else vfm_part_pos(v, t)

fn vfm_part_neg(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if vlin_coeff(v, h.cs) < 0 then Cons(h, vfm_part_neg(v, t)) else vfm_part_neg(v, t)

fn vfm_part_zer(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if vlin_coeff(v, h.cs) == 0 then Cons(h, vfm_part_zer(v, t)) else vfm_part_zer(v, t)

fn vfm_pair1(v, p, cp, negs) = match negs
    Nil        => Nil
    Cons(n, r) => let cn = 0 - vlin_coeff(v, n.cs) in Cons(vlin_add(vlin_scale(cn, p), vlin_scale(cp, n)), vfm_pair1(v, p, cp, r))

fn vfm_pairs(v, pos, negs) = match pos
    Nil        => Nil
    Cons(p, r) => let pairs1 = vfm_pair1(v, p, vlin_coeff(v, p.cs), negs) in if len(pairs1) > 24 then pairs1 else app(pairs1, vfm_pairs(v, r, negs))

fn vfm_elim_var(v, hyps) = app(vfm_part_zer(v, hyps), vfm_pairs(v, vfm_part_pos(v, hyps), vfm_part_neg(v, hyps)))

fn vfm_unsat(hyps, vars) = if vfm_any_contra(hyps) == 1 then 1 else vfm_unsat1(hyps, vars)

fn vfm_unsat1(hyps, vars) = match vars
    Nil        => vfm_any_contra(hyps)
    Cons(v, r) => let next = vfm_elim_var(v, hyps) in if vfm_any_contra(next) == 1 then 1 else if len(next) > 48 then 0 else vfm_unsat(next, r)

fn vfm_check_unsat(hyps) = vfm_unsat(hyps, vfm_vars(hyps, Nil))

## --- Multiplier M1 (#255): QF_NIA Positivstellensatz / Monotonicity / Div-Mod / QF_BV / QF_ALIA / Separation ---
fn vnia_var_lb(v, hyps) = match hyps
    Nil        => 0 - 999999
    Cons(h, t) => let r = vnia_var_lb(v, t) in if len(h.cs) == 1 and vlin_coeff(v, h.cs) == 1 then (let b = 0 - h.c0 in if b > r then b else r) else r

fn vnia_split_star(s, idx, n) = if idx >= n then Nil else if at(s, idx) == "*" then Cons(slice(s, 0, idx), Cons(slice(s, idx + 1, n), Nil)) else vnia_split_star(s, idx + 1, n)

fn vnia_add_bvar(v, acc) = if v == "" or omem(v, acc) == 1 then acc else Cons(v, acc)

fn vnia_add_bvars(vs, acc) = match vs
    Nil        => acc
    Cons(v, r) => vnia_add_bvars(r, vnia_add_bvar(v, acc))

fn vnia_vars_cs(cs, acc) = match cs
    Nil        => acc
    Cons(h, t) => vnia_vars_cs(t, vnia_add_bvars(vnia_split_star(h.k, 0, count(h.k)), acc))

fn vnia_base_vars(hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => vnia_base_vars(t, if len(h.cs) <= 3 then vnia_vars_cs(h.cs, acc) else acc)

fn vnia_sq_hyps(vars) = match vars
    Nil        => Nil
    Cons(v, r) => Cons(vlin_var(vmono_key(v, v)), vnia_sq_hyps(r))

fn vnia_diff_sq_pairs(v1, vars) = match vars
    Nil        => Nil
    Cons(v2, r) => let dv = vlin_sub(vlin_var(v1), vlin_var(v2)) in let sv = vlin_add(vlin_var(v1), vlin_var(v2)) in Cons(vlin_mul(dv, dv), Cons(vlin_mul(sv, sv), vnia_diff_sq_pairs(v1, r)))

fn vnia_all_diff_sq(vars) = match vars
    Nil        => Nil
    Cons(v, r) => app(vnia_diff_sq_pairs(v, r), vnia_all_diff_sq(r))

fn vnia_prod_pair(v1, lb1, vars, hyps) = match vars
    Nil        => Nil
    Cons(v2, r) => let lb2 = vnia_var_lb(v2, hyps) in let rest = vnia_prod_pair(v1, lb1, r, hyps) in if lb1 >= 0 and lb2 >= 0 then Cons({ok: 1, c0: 0 - (lb1 * lb2), cs: Cons({k: vmono_key(v1, v2), c: 1}, Nil)}, Cons(vlin_mul(vlin_sub(vlin_var(v1), vlin_const(lb1)), vlin_sub(vlin_var(v2), vlin_const(lb2))), rest)) else rest

fn vnia_prod_hyps(vars, hyps) = match vars
    Nil        => Nil
    Cons(v1, r) => let lb1 = vnia_var_lb(v1, hyps) in app(if lb1 >= 0 then vnia_prod_pair(v1, lb1, vars, hyps) else Nil, vnia_prod_hyps(r, hyps))

fn vnia_mono_z(x, y, vars, hyps) = match vars
    Nil        => Nil
    Cons(z, r) => let lbz = vnia_var_lb(z, hyps) in let rest = vnia_mono_z(x, y, r, hyps) in if lbz >= 0 then Cons(vlin_sub(vlin_var(vmono_key(x, z)), vlin_var(vmono_key(y, z))), rest) else rest

fn vnia_mono_h1(h, vars, hyps) = if h.c0 <= 0 and len(h.cs) == 2 then (let c1 = phd_cs(h.cs) in let c2 = phd_cs(ptl(h.cs)) in if c1.c == 1 and c2.c == 0 - 1 then vnia_mono_z(c1.k, c2.k, vars, hyps) else if c2.c == 1 and c1.c == 0 - 1 then vnia_mono_z(c2.k, c1.k, vars, hyps) else Nil) else Nil

fn vnia_mono_hyps(cur, vars, hyps) = match cur
    Nil        => Nil
    Cons(h, t) => app(vnia_mono_h1(h, vars, hyps), vnia_mono_hyps(t, vars, hyps))

fn vnia_enrich_hyps(goal_hyps, hyps) = let bvars = vnia_base_vars(goal_hyps, vnia_base_vars(hyps, Nil)) in let sqs = if isnil(bvars) == 0 then app(vnia_sq_hyps(bvars), vnia_all_diff_sq(bvars)) else Nil in app(sqs, app(vnia_prod_hyps(bvars, hyps), app(vnia_mono_hyps(hyps, bvars, hyps), hyps)))

fn vlin_div_hyps(la, k, q) = let r = vlin_sub(la, vlin_scale(k, q)) in Cons(r, Cons(vlin_sub(vlin_const(k - 1), r), Nil))

fn vis_struct_call(cnm) = if cnm == "array_new" or cnm == "array_const" or cnm == "array_store" or cnm == "heap_write" or cnm == "points_to" or cnm == "heap_new" or cnm == "sep_conj" then 1 else 0

fn vis_struct_expr(e) = match e
    Call(cnm, args) => vis_struct_call(cnm)
    _               => 0

fn vsep_dom_ptr(e) = match e
    Call(cnm, args) => if (cnm == "points_to" or cnm == "heap_new") and len(args) == 2 then Cons(ohd_e(args), Nil) else if cnm == "sep_conj" and len(args) == 2 then app(vsep_dom_ptr(ohd_e(args)), vsep_dom_ptr(ohd_e(ptl(args)))) else if cnm == "heap_write" and len(args) == 3 then vsep_dom_ptr(ohd_e(args)) else Nil
    _               => Nil

fn vsep_disjoint_one(p, ps, hyps, lenv, fns, d) = match ps
    Nil         => 1
    Cons(q, qr) => if (vprove_goal(Bin(">", p, q), hyps, lenv, fns, d) == 1 or vprove_goal(Bin("<", p, q), hyps, lenv, fns, d) == 1 or vprove_goal(Bin(">=", Bin("*", Bin("-", p, q), Bin("-", p, q)), Num(1)), hyps, lenv, fns, d) == 1) and vsep_disjoint_one(p, qr, hyps, lenv, fns, d) == 1 then 1 else 0

fn vsep_disjoint_lists(ps1, ps2, hyps, lenv, fns, d) = match ps1
    Nil         => 1
    Cons(p, pr) => if vsep_disjoint_one(p, ps2, hyps, lenv, fns, d) == 1 then vsep_disjoint_lists(pr, ps2, hyps, lenv, fns, d) else 0

fn vsep_valid(e, hyps, lenv, fns, d) = match e
    Call(cnm, args) => if (cnm == "points_to" or cnm == "heap_new") and len(args) == 2 then 1 else if cnm == "sep_conj" and len(args) == 2 then (let h1 = ohd_e(args) in let h2 = ohd_e(ptl(args)) in if vsep_valid(h1, hyps, lenv, fns, d) == 1 and vsep_valid(h2, hyps, lenv, fns, d) == 1 and vsep_disjoint_lists(vsep_dom_ptr(h1), vsep_dom_ptr(h2), hyps, lenv, fns, d) == 1 then 1 else 0) else if cnm == "heap_write" and len(args) == 3 then vsep_valid(ohd_e(args), hyps, lenv, fns, d) else 0
    _               => 0

fn varr_select(arr_e, idx_e, hyps, lenv, fns, d) = match arr_e
    Call(cnm, args) => if (cnm == "array_store" or cnm == "heap_write") and len(args) == 3 then (let base_a = ohd_e(args) in let st_i = ohd_e(ptl(args)) in let st_v = ohd_e(ptl(ptl(args))) in if cnm == "heap_write" and vsep_valid(base_a, hyps, lenv, fns, d) == 0 and n4_var_name(base_a) == "" then vlin_err() else if vprove_goal(Bin("==", idx_e, st_i), hyps, lenv, fns, d) == 1 then vlin_expr(st_v, hyps, lenv, fns, d) else if vprove_goal(Bin(">", idx_e, st_i), hyps, lenv, fns, d) == 1 or vprove_goal(Bin("<", idx_e, st_i), hyps, lenv, fns, d) == 1 or vprove_goal(Bin(">=", Bin("*", Bin("-", idx_e, st_i), Bin("-", idx_e, st_i)), Num(1)), hyps, lenv, fns, d) == 1 then varr_select(base_a, idx_e, hyps, lenv, fns, d) else vlin_err()) else if (cnm == "array_new" or cnm == "array_const") and len(args) == 1 then vlin_expr(ohd_e(args), hyps, lenv, fns, d) else if (cnm == "points_to" or cnm == "heap_new") and len(args) == 2 then (if vprove_goal(Bin("==", idx_e, ohd_e(args)), hyps, lenv, fns, d) == 1 then vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d) else vlin_err()) else if cnm == "sep_conj" and len(args) == 2 then (if vsep_valid(arr_e, hyps, lenv, fns, d) == 0 then vlin_err() else let r1 = varr_select(ohd_e(args), idx_e, hyps, lenv, fns, d) in if r1.ok == 1 then r1 else varr_select(ohd_e(ptl(args)), idx_e, hyps, lenv, fns, d)) else vlin_err()
    Var(anm)        => let li = vlin_expr(idx_e, hyps, lenv, fns, d) in if li.ok == 0 then vlin_err() else vlin_var("select(" + anm + "," + vlin_key_str(li) + ")")
    _               => vlin_err()

fn vlin_xor_cancel(a, lb, hyps, lenv, fns, d) = match a
    Call(cnm, args) => if (cnm == "bv_xor" or cnm == "bit_xor") and len(args) == 2 then (let x = ohd_e(args) in let k = ohd_e(ptl(args)) in let lx = vlin_expr(x, hyps, lenv, fns, d) in let lk = vlin_expr(k, hyps, lenv, fns, d) in if lk.ok == 1 and vlin_eq(lk, lb) == 1 then lx else if lx.ok == 1 and vlin_eq(lx, lb) == 1 then lk else vlin_err()) else vlin_err()
    _               => vlin_err()

fn vlin_and_idem(a, lb, hyps, lenv, fns, d) = match a
    Call(cnm, args) => if (cnm == "bv_and" or cnm == "bit_and") and len(args) == 2 then (let lk = vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d) in if lk.ok == 1 and vlin_eq(lk, lb) == 1 then vlin_expr(a, hyps, lenv, fns, d) else vlin_err()) else vlin_err()
    _               => vlin_err()

fn vlin_bv_xor(a, b, hyps, lenv, fns, d) = let la = vlin_expr(a, hyps, lenv, fns, d) in let lb = vlin_expr(b, hyps, lenv, fns, d) in if la.ok == 0 or lb.ok == 0 then vlin_err() else if vlin_eq(la, lb) == 1 then vlin_const(0) else if vlin_is_zero(la) == 1 then lb else if vlin_is_zero(lb) == 1 then la else if isnil(la.cs) == 1 and isnil(lb.cs) == 1 then vlin_const(vbv_xor(vbv_mod(la.c0, 65536), vbv_mod(lb.c0, 65536), 16)) else let cx = vlin_xor_cancel(a, lb, hyps, lenv, fns, d) in if cx.ok == 1 then cx else let cy = vlin_xor_cancel(b, la, hyps, lenv, fns, d) in if cy.ok == 1 then cy else vlin_var("bv_xor(" + vmono_key(vlin_key_str(la), vlin_key_str(lb)) + ")")

fn vlin_bv_and(a, b, hyps, lenv, fns, d) = let la = vlin_expr(a, hyps, lenv, fns, d) in let lb = vlin_expr(b, hyps, lenv, fns, d) in if la.ok == 0 or lb.ok == 0 then vlin_err() else if vlin_is_zero(la) == 1 or vlin_is_zero(lb) == 1 then vlin_const(0) else if vlin_eq(la, lb) == 1 then la else if isnil(la.cs) == 1 and isnil(lb.cs) == 1 then vlin_const(vbv_and(vbv_mod(la.c0, 65536), vbv_mod(lb.c0, 65536), 16)) else let ci = vlin_and_idem(a, lb, hyps, lenv, fns, d) in if ci.ok == 1 then ci else if isnil(lb.cs) == 1 and (lb.c0 == 1 or lb.c0 == 3 or lb.c0 == 7 or lb.c0 == 15 or lb.c0 == 31 or lb.c0 == 63 or lb.c0 == 127 or lb.c0 == 255) then (if vfm_check_unsat(Cons(vlin_sub(vlin_const(0 - 1), la), hyps)) == 1 and vfm_check_unsat(Cons(vlin_sub(la, vlin_const(lb.c0 + 1)), hyps)) == 1 then la else vlin_sub(la, vlin_scale(lb.c0 + 1, vlin_var("div(" + vlin_key_str(la) + "," + str(lb.c0 + 1) + ")")))) else vlin_var("bv_and(" + vmono_key(vlin_key_str(la), vlin_key_str(lb)) + ")")

fn vlin_bv_or(a, b, hyps, lenv, fns, d) = let la = vlin_expr(a, hyps, lenv, fns, d) in let lb = vlin_expr(b, hyps, lenv, fns, d) in if la.ok == 0 or lb.ok == 0 then vlin_err() else if vlin_is_zero(la) == 1 then lb else if vlin_is_zero(lb) == 1 then la else if vlin_eq(la, lb) == 1 then la else if isnil(la.cs) == 1 and isnil(lb.cs) == 1 then vlin_const(vbv_or(vbv_mod(la.c0, 65536), vbv_mod(lb.c0, 65536), 16)) else vlin_var("bv_or(" + vmono_key(vlin_key_str(la), vlin_key_str(lb)) + ")")

fn vlin_bv_u8(a, hyps, lenv, fns, d) = let la = vlin_expr(a, hyps, lenv, fns, d) in if la.ok == 0 then vlin_err() else if isnil(la.cs) == 1 then vlin_const(vbv_mod(la.c0, 256)) else if vfm_check_unsat(Cons(vlin_sub(vlin_const(0 - 1), la), hyps)) == 1 and vfm_check_unsat(Cons(vlin_sub(la, vlin_const(256)), hyps)) == 1 then la else if vfm_check_unsat(Cons(vlin_sub(vlin_const(255), la), hyps)) == 1 and vfm_check_unsat(Cons(vlin_sub(la, vlin_const(512)), hyps)) == 1 then vlin_sub(la, vlin_const(256)) else vlin_sub(la, vlin_scale(256, vlin_var("div(" + vlin_key_str(la) + ",256)")))

fn vcollect_div_hyps_e(e, hyps, lenv, fns, d) = match e
    Bin(op, a, b)   => let h1 = app(vcollect_div_hyps_e(a, hyps, lenv, fns, d), vcollect_div_hyps_e(b, hyps, lenv, fns, d)) in if (op == "/" or op == "%") then (let la = vlin_expr(a, hyps, lenv, fns, d) in let lb = vlin_expr(b, hyps, lenv, fns, d) in if la.ok == 1 and lb.ok == 1 and isnil(lb.cs) == 1 and lb.c0 > 0 then app(vlin_div_hyps(la, lb.c0, vlin_var("div(" + vlin_key_str(la) + "," + str(lb.c0) + ")")), h1) else h1) else h1
    Call(cnm, args) => let h1 = vcollect_div_hyps_args(args, hyps, lenv, fns, d) in if (cnm == "bv_and" or cnm == "bit_and") and len(args) == 2 then (let la = vlin_expr(ohd_e(args), hyps, lenv, fns, d) in let lb = vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d) in if la.ok == 1 and lb.ok == 1 and isnil(lb.cs) == 1 and (lb.c0 == 1 or lb.c0 == 3 or lb.c0 == 7 or lb.c0 == 15 or lb.c0 == 31 or lb.c0 == 63 or lb.c0 == 127 or lb.c0 == 255) then app(vlin_div_hyps(la, lb.c0 + 1, vlin_var("div(" + vlin_key_str(la) + "," + str(lb.c0 + 1) + ")")), h1) else h1) else if (cnm == "bv_u8" or cnm == "bv_not_u8") and len(args) == 1 then (let la = vlin_expr(ohd_e(args), hyps, lenv, fns, d) in if la.ok == 1 then app(vlin_div_hyps(la, 256, vlin_var("div(" + vlin_key_str(la) + ",256)")), h1) else h1) else if cnm == "bv_add_u8" and len(args) == 2 then (let la = vlin_expr(Bin("+", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) in if la.ok == 1 then app(vlin_div_hyps(la, 256, vlin_var("div(" + vlin_key_str(la) + ",256)")), h1) else h1) else h1
    If(c, t, e2)    => app(vcollect_div_hyps_e(c, hyps, lenv, fns, d), app(vcollect_div_hyps_e(t, hyps, lenv, fns, d), vcollect_div_hyps_e(e2, hyps, lenv, fns, d)))
    LetIn(nm, v, b) => app(vcollect_div_hyps_e(v, hyps, lenv, fns, d), vcollect_div_hyps_e(b, hyps, lenv, fns, d))
    _               => Nil

fn vcollect_div_hyps_args(xs, hyps, lenv, fns, d) = match xs
    Nil        => Nil
    Cons(h, t) => app(vcollect_div_hyps_e(h, hyps, lenv, fns, d), vcollect_div_hyps_args(t, hyps, lenv, fns, d))

fn vlin_init_env(ps) = match ps
    Nil        => Nil
    Cons(p, r) => Cons({k: p, v: vlin_var(p)}, vlin_init_env(r))

fn vlin_lookup(nm, lenv) = match lenv
    Nil        => vlin_err()
    Cons(h, t) => if h.k == nm then h.v else vlin_lookup(nm, t)

fn vlin_bind_ps(ps, vs) = match ps
    Nil        => Nil
    Cons(p, r) => vlin_bind_p1(p, r, vs)

fn vlin_bind_p1(p, r, vs) = match vs
    Nil         => Nil
    Cons(v, vr) => Cons({k: p, v: v}, vlin_bind_ps(r, vr))

fn vlin_bin_op(op, l, r, hyps, lenv, fns, d) = let la = vlin_expr(l, hyps, lenv, fns, d) in let lb = vlin_expr(r, hyps, lenv, fns, d) in if op == "+" then vlin_add(la, lb) else if op == "-" then vlin_sub(la, lb) else if op == "*" then vlin_mul(la, lb) else if op == "/" then (if la.ok == 0 or lb.ok == 0 then vlin_err() else if isnil(lb.cs) == 1 and lb.c0 > 0 then (if isnil(la.cs) == 1 then vlin_const(la.c0 / lb.c0) else vlin_var("div(" + vlin_key_str(la) + "," + str(lb.c0) + ")")) else vlin_err()) else if op == "%" then (if la.ok == 0 or lb.ok == 0 then vlin_err() else if isnil(lb.cs) == 1 and lb.c0 > 0 then (if isnil(la.cs) == 1 then vlin_const(la.c0 % lb.c0) else vlin_sub(la, vlin_scale(lb.c0, vlin_var("div(" + vlin_key_str(la) + "," + str(lb.c0) + ")")))) else vlin_err()) else vlin_err()

fn vlin_expr(e, hyps, lenv, fns, d) = if d > 6 then vlin_err() else vlin_expr1(e, hyps, lenv, fns, d)

fn vlin_expr1(e, hyps, lenv, fns, d) = match e
    Num(n)          => vlin_const(n)
    Var(nm)         => vlin_lookup(nm, lenv)
    OwnE(inner)     => vlin_expr(inner, hyps, lenv, fns, d)
    MutE(inner)     => vlin_expr(inner, hyps, lenv, fns, d)
    CT(inner)       => vlin_expr(inner, hyps, lenv, fns, d)
    AwaitE(inner)   => vlin_expr(inner, hyps, lenv, fns, d)
    DeferE(c, b)    => vlin_expr(b, hyps, lenv, fns, d)
    ErrDeferE(c, b) => vlin_expr(b, hyps, lenv, fns, d)
    LetIn(nm, v, b) => let gfn = n4_is_grad_let(v) in if gfn != "" then vlin_expr(n4_subst_call(b, nm, "__ad_grad_" + gfn), hyps, lenv, fns, d) else if vis_struct_expr(v) == 1 then vlin_expr(vtemp_subst_var(b, nm, v), hyps, lenv, fns, d) else let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then vlin_err() else vlin_expr(b, hyps, Cons({k: nm, v: lv}, lenv), fns, d)
    VarIn(nm, v, b) => if vis_struct_expr(v) == 1 then vlin_expr(vtemp_subst_var(b, nm, v), hyps, lenv, fns, d) else let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then vlin_err() else vlin_expr(b, hyps, Cons({k: nm, v: lv}, lenv), fns, d)
    Bin(op, l, r)   => vlin_bin_op(op, l, r, hyps, lenv, fns, d)
    If(c, t, e2)    => let rp = vcond_pos(c, hyps, lenv, fns, d) in let rn = vcond_neg(c, hyps, lenv, fns, d) in if rp.ok == 1 and rn.ok == 1 and vfm_check_unsat(app(rn.hyps, hyps)) == 1 then vlin_expr(t, hyps, lenv, fns, d) else if rp.ok == 1 and rn.ok == 1 and vfm_check_unsat(app(rp.hyps, hyps)) == 1 then vlin_expr(e2, hyps, lenv, fns, d) else vlin_err()
    Call(cnm, args) => vlin_call(cnm, args, hyps, lenv, fns, d)
    _               => vlin_err()

fn vlin_args(args, hyps, lenv, fns, d) = match args
    Nil        => {ok: 1, vals: Nil}
    Cons(h, t) => let rh = vlin_expr(h, hyps, lenv, fns, d) in if rh.ok == 0 then {ok: 0, vals: Nil} else let rt = vlin_args(t, hyps, lenv, fns, d) in if rt.ok == 0 then {ok: 0, vals: Nil} else {ok: 1, vals: Cons(rh, rt.vals)}

fn vlin_m1_call(cnm, args, hyps, lenv, fns, d) = if (cnm == "bv_xor" or cnm == "bit_xor") and len(args) == 2 then vlin_bv_xor(ohd_e(args), ohd_e(ptl(args)), hyps, lenv, fns, d) else if (cnm == "bv_and" or cnm == "bit_and") and len(args) == 2 then vlin_bv_and(ohd_e(args), ohd_e(ptl(args)), hyps, lenv, fns, d) else if (cnm == "bv_or" or cnm == "bit_or") and len(args) == 2 then vlin_bv_or(ohd_e(args), ohd_e(ptl(args)), hyps, lenv, fns, d) else if (cnm == "bv_shl" or cnm == "bit_shl") and len(args) == 2 then (let lk = vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d) in if lk.ok == 1 and isnil(lk.cs) == 1 and lk.c0 >= 0 then vlin_scale(vbv_pow2(lk.c0), vlin_expr(ohd_e(args), hyps, lenv, fns, d)) else vlin_err()) else if (cnm == "bv_shr" or cnm == "bit_shr") and len(args) == 2 then (let lk = vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d) in if lk.ok == 1 and isnil(lk.cs) == 1 and lk.c0 >= 0 then vlin_bin_op("/", ohd_e(args), Num(vbv_pow2(lk.c0)), hyps, lenv, fns, d) else vlin_err()) else if cnm == "bv_u8" and len(args) == 1 then vlin_bv_u8(ohd_e(args), hyps, lenv, fns, d) else if cnm == "bv_not_u8" and len(args) == 1 then vlin_sub(vlin_const(255), vlin_bv_u8(ohd_e(args), hyps, lenv, fns, d)) else if cnm == "bv_add_u8" and len(args) == 2 then vlin_bv_u8(Bin("+", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "bv_sub_u8" and len(args) == 2 then vlin_bv_u8(Bin("-", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if (cnm == "array_select" or cnm == "heap_read") and len(args) == 2 then varr_select(ohd_e(args), ohd_e(ptl(args)), hyps, lenv, fns, d) else if cnm == "sep_valid" and len(args) == 1 then (if vsep_valid(ohd_e(args), hyps, lenv, fns, d) == 1 then vlin_const(1) else vlin_err()) else if cnm == "sep_disjoint" and len(args) == 2 then (if vprove_goal(Bin("!=", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) == 1 then vlin_const(1) else vlin_err()) else if cnm == "forall_range" and len(args) == 4 then (if vprove_forall_range(args, hyps, lenv, fns, d) == 1 then vlin_const(1) else vlin_err()) else if cnm == "exists_range" and len(args) == 4 then (if vprove_exists_range(args, hyps, lenv, fns, d) == 1 then vlin_const(1) else vlin_err()) else vlin_ufn(vfnlookup(cnm, fns), vlin_args(args, hyps, lenv, fns, d), hyps, fns, d)

fn vlin_call(cnm, args, hyps, lenv, fns, d) = if cnm == "old" and len(args) == 1 then vlin_expr(ohd_e(args), hyps, lenv, fns, d) else if (cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" or cnm == "borrow" or cnm == "borrow_mut" or cnm == "move" or cnm == "clone" or cnm == "block_on") and len(args) >= 1 then vlin_expr(ohd_e(args), hyps, lenv, fns, d) else if cnm == "grad" and len(args) >= 2 then vlin_call("__ad_grad_" + n4_var_name(ohd_e(args)), ptl(args), hyps, lenv, fns, d) else if cnm == "jvp" and len(args) == 3 then vlin_mul(vlin_call("__ad_grad_" + n4_var_name(ohd_e(args)), Cons(ohd_e(ptl(args)), Nil), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(ptl(args))), hyps, lenv, fns, d)) else if cnm == "vjp" and len(args) == 3 then vlin_mul(vlin_expr(ohd_e(ptl(ptl(args))), hyps, lenv, fns, d), vlin_call("__ad_grad_" + n4_var_name(ohd_e(args)), Cons(ohd_e(ptl(args)), Nil), hyps, lenv, fns, d)) else if cnm == "jit" and len(args) >= 2 then vlin_call(n4_var_name(ohd_e(args)), ptl(args), hyps, lenv, fns, d) else if cnm == "dec_add" and len(args) == 2 then vlin_add(vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_sub" and len(args) == 2 then vlin_sub(vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else vlin_m1_call(cnm, args, hyps, lenv, fns, d)

fn vlin_ufn(mf, ra, hyps, fns, d) = match mf
    Nil        => vlin_err()
    Cons(f, r) => if ra.ok == 0 then vlin_err() else vlin_expr(f.body, hyps, vlin_bind_ps(f.ps, ra.vals), fns, d + 1)

fn vcond_cmp_pos(op, la, lb) = if la.ok == 0 or lb.ok == 0 then {ok: 0, hyps: Nil} else if op == ">=" then {ok: 1, hyps: Cons(vlin_sub(la, lb), Nil)} else if op == ">" then {ok: 1, hyps: Cons(vlin_sub(vlin_sub(la, lb), vlin_const(1)), Nil)} else if op == "<=" then {ok: 1, hyps: Cons(vlin_sub(lb, la), Nil)} else if op == "<" then {ok: 1, hyps: Cons(vlin_sub(vlin_sub(lb, la), vlin_const(1)), Nil)} else if op == "==" then {ok: 1, hyps: Cons(vlin_sub(la, lb), Cons(vlin_sub(lb, la), Nil))} else if op == "!=" then (let d = vlin_sub(la, lb) in {ok: 1, hyps: Cons(vlin_sub(vlin_mul(d, d), vlin_const(1)), Nil)}) else {ok: 0, hyps: Nil}

fn vcond_cmp_neg(op, la, lb) = if la.ok == 0 or lb.ok == 0 then {ok: 0, hyps: Nil} else if op == ">=" then vcond_cmp_pos("<", la, lb) else if op == ">" then vcond_cmp_pos("<=", la, lb) else if op == "<=" then vcond_cmp_pos(">", la, lb) else if op == "<" then vcond_cmp_pos(">=", la, lb) else if op == "!=" then vcond_cmp_pos("==", la, lb) else if op == "==" then vcond_cmp_pos("!=", la, lb) else {ok: 0, hyps: Nil}

fn vcond_pos(e, hyps, lenv, fns, d) = match e
    Bin(op, a, b)   => if op == "and" then (let r1 = vcond_pos(a, hyps, lenv, fns, d) in let r2 = vcond_pos(b, hyps, lenv, fns, d) in if r1.ok == 1 and r2.ok == 1 then {ok: 1, hyps: app(r1.hyps, r2.hyps)} else {ok: 0, hyps: Nil}) else vcond_cmp_pos(op, vlin_expr(a, hyps, lenv, fns, d), vlin_expr(b, hyps, lenv, fns, d))
    Call(cnm, args) => if cnm == "dec_eq" and len(args) == 2 then vcond_cmp_pos("==", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_ge" and len(args) == 2 then vcond_cmp_pos(">=", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_gt" and len(args) == 2 then vcond_cmp_pos(">", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_le" and len(args) == 2 then vcond_cmp_pos("<=", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_lt" and len(args) == 2 then vcond_cmp_pos("<", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "sep_disjoint" and len(args) == 2 then vcond_cmp_neg("==", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else {ok: 0, hyps: Nil}
    _               => {ok: 0, hyps: Nil}

fn vcond_neg(e, hyps, lenv, fns, d) = match e
    Bin(op, a, b)   => vcond_cmp_neg(op, vlin_expr(a, hyps, lenv, fns, d), vlin_expr(b, hyps, lenv, fns, d))
    Call(cnm, args) => if cnm == "dec_ge" and len(args) == 2 then vcond_cmp_neg(">=", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_gt" and len(args) == 2 then vcond_cmp_neg(">", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_le" and len(args) == 2 then vcond_cmp_neg("<=", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "dec_lt" and len(args) == 2 then vcond_cmp_neg("<", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else if cnm == "sep_disjoint" and len(args) == 2 then vcond_cmp_pos("==", vlin_expr(ohd_e(args), hyps, lenv, fns, d), vlin_expr(ohd_e(ptl(args)), hyps, lenv, fns, d)) else {ok: 0, hyps: Nil}
    _               => {ok: 0, hyps: Nil}

fn vprove_reqs_hyps(reqs, lenv, fns) = match reqs
    Nil        => {ok: 1, hyps: Nil}
    Cons(h, t) => let r1 = vcond_pos(h, Nil, lenv, fns, 0) in if r1.ok == 0 then {ok: 0, hyps: Nil} else let r2 = vprove_reqs_hyps(t, lenv, fns) in if r2.ok == 0 then {ok: 0, hyps: Nil} else {ok: 1, hyps: app(r1.hyps, r2.hyps)}

fn vprove_let_val(nm, v, b, hyps, lenv, fns) = match v
    If(c, t, e2) => let rp = vcond_pos(c, hyps, lenv, fns, 0) in let rn = vcond_neg(c, hyps, lenv, fns, 0) in if rp.ok == 1 and rn.ok == 1 and vprove_let_val(nm, t, b, app(rp.hyps, hyps), lenv, fns) == 1 and vprove_let_val(nm, e2, b, app(rn.hyps, hyps), lenv, fns) == 1 then 1 else 0
    _            => if vis_struct_expr(v) == 1 then vprove_goal(vtemp_subst_var(b, nm, v), hyps, lenv, fns, 0) else let lv = vlin_expr(v, hyps, lenv, fns, 0) in if lv.ok == 0 then 0 else vprove_goal(b, app(vcollect_div_hyps_e(v, hyps, lenv, fns, 0), hyps), Cons({k: nm, v: lv}, lenv), fns, 0)

fn vprove_forall_range(args, hyps, lenv, fns, d) = let vnm = n4_var_name(ohd_e(args)) in let lo_e = ohd_e(ptl(args)) in let hi_e = ohd_e(ptl(ptl(args))) in let pred_e = ohd_e(ptl(ptl(ptl(args)))) in let llo = vlin_expr(lo_e, hyps, lenv, fns, d) in let lhi = vlin_expr(hi_e, hyps, lenv, fns, d) in if vnm == "" or llo.ok == 0 or lhi.ok == 0 then 0 else let lv = vlin_var("_q_" + vnm) in let hyps2 = Cons(vlin_sub(lv, llo), Cons(vlin_sub(lhi, lv), hyps)) in vprove_goal(pred_e, hyps2, Cons({k: vnm, v: lv}, lenv), fns, d + 1)

fn vprove_exists_w(vnm, w, lo_e, hi_e, pred_e, ctx) = if vprove_goal(Bin(">=", w, lo_e), ctx.hyps, ctx.lenv, ctx.fns, ctx.d) == 1 and vprove_goal(Bin("<=", w, hi_e), ctx.hyps, ctx.lenv, ctx.fns, ctx.d) == 1 and vprove_goal(vtemp_subst_var(pred_e, vnm, w), ctx.hyps, ctx.lenv, ctx.fns, ctx.d) == 1 then 1 else 0

fn vprove_exists_list(vnm, ws, lo_e, hi_e, pred_e, ctx) = match ws
    Nil         => 0
    Cons(w, wr) => if vprove_exists_w(vnm, w, lo_e, hi_e, pred_e, ctx) == 1 then 1 else vprove_exists_list(vnm, wr, lo_e, hi_e, pred_e, ctx)

fn vprove_exists_range(args, hyps, lenv, fns, d) = let vnm = n4_var_name(ohd_e(args)) in let lo_e = ohd_e(ptl(args)) in let hi_e = ohd_e(ptl(ptl(args))) in let pred_e = ohd_e(ptl(ptl(ptl(args)))) in if vnm == "" then 0 else let ws = Cons(lo_e, Cons(hi_e, Cons(Bin("+", lo_e, Num(1)), Cons(Bin("-", hi_e, Num(1)), Cons(Bin("/", Bin("+", lo_e, hi_e), Num(2)), Nil))))) in vprove_exists_list(vnm, ws, lo_e, hi_e, pred_e, {hyps: hyps, lenv: lenv, fns: fns, d: d + 1})

fn vprove_goal(g, hyps, lenv, fns, d) = match g
    Num(n)          => if n != 0 then 1 else 0
    LetIn(nm, v, b) => let gfn = n4_is_grad_let(v) in if gfn != "" then vprove_goal(n4_subst_call(b, nm, "__ad_grad_" + gfn), hyps, lenv, fns, d) else vprove_let_val(nm, v, b, hyps, lenv, fns)
    VarIn(nm, v, b) => vprove_let_val(nm, v, b, hyps, lenv, fns)
    DeferE(c, b)    => vprove_goal(b, hyps, lenv, fns, d)
    ErrDeferE(c, b) => vprove_goal(b, hyps, lenv, fns, d)
    If(c, t, e2)    => let rp = vcond_pos(c, hyps, lenv, fns, d) in let rn = vcond_neg(c, hyps, lenv, fns, d) in if rp.ok == 1 and vprove_goal(t, app(rp.hyps, hyps), lenv, fns, d) == 1 and (vprove_goal(e2, hyps, lenv, fns, d) == 1 or (rn.ok == 1 and vprove_goal(e2, app(rn.hyps, hyps), lenv, fns, d) == 1)) then 1 else 0
    Bin(op, a, b)   => if op == "and" then (if vprove_goal(a, hyps, lenv, fns, d) == 1 and vprove_goal(b, hyps, lenv, fns, d) == 1 then 1 else 0) else if op == "or" then (if vprove_goal(a, hyps, lenv, fns, d) == 1 or vprove_goal(b, hyps, lenv, fns, d) == 1 then 1 else let rna = vcond_neg(a, hyps, lenv, fns, d) in if rna.ok == 1 and vprove_goal(b, app(rna.hyps, hyps), lenv, fns, d) == 1 then 1 else let rnb = vcond_neg(b, hyps, lenv, fns, d) in if rnb.ok == 1 and vprove_goal(a, app(rnb.hyps, hyps), lenv, fns, d) == 1 then 1 else 0) else if op == "==" then (if vprove_goal(Bin(">=", a, b), hyps, lenv, fns, d) == 1 and vprove_goal(Bin("<=", a, b), hyps, lenv, fns, d) == 1 then 1 else 0) else if op == "!=" then (if vprove_goal(Bin(">", a, b), hyps, lenv, fns, d) == 1 or vprove_goal(Bin("<", a, b), hyps, lenv, fns, d) == 1 or vprove_goal(Bin(">=", Bin("*", Bin("-", a, b), Bin("-", a, b)), Num(1)), hyps, lenv, fns, d) == 1 then 1 else 0) else (let dhyps = app(vcollect_div_hyps_e(g, hyps, lenv, fns, d), hyps) in let rn = vcond_neg(g, dhyps, lenv, fns, d) in if rn.ok == 1 then vfm_check_unsat(app(rn.hyps, vnia_enrich_hyps(rn.hyps, dhyps))) else 0)
    Call(cnm, args) => if cnm == "dec_eq" and len(args) == 2 then vprove_goal(Bin("==", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "dec_ge" and len(args) == 2 then vprove_goal(Bin(">=", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "dec_gt" and len(args) == 2 then vprove_goal(Bin(">", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "dec_le" and len(args) == 2 then vprove_goal(Bin("<=", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "dec_lt" and len(args) == 2 then vprove_goal(Bin("<", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "sep_disjoint" and len(args) == 2 then vprove_goal(Bin("!=", ohd_e(args), ohd_e(ptl(args))), hyps, lenv, fns, d) else if cnm == "sep_valid" and len(args) == 1 then vsep_valid(ohd_e(args), hyps, lenv, fns, d) else if cnm == "sep_conj" and len(args) == 2 then vsep_valid(g, hyps, lenv, fns, d) else if cnm == "forall_range" and len(args) == 4 then vprove_forall_range(args, hyps, lenv, fns, d) else if cnm == "exists_range" and len(args) == 4 then vprove_exists_range(args, hyps, lenv, fns, d) else 0
    _               => 0

fn vprove_goals_all(enss, hyps, lenv, fns, d) = match enss
    Nil        => 1
    Cons(h, t) => if vprove_goal(h, hyps, lenv, fns, d) == 1 then vprove_goals_all(t, hyps, lenv, fns, d) else 0

fn vprove_body(body, hyps, lenv, enss, fns, d) = match body
    LetIn(nm, v, b) => let gfn = n4_is_grad_let(v) in if gfn != "" then vprove_body(n4_subst_call(b, nm, "__ad_grad_" + gfn), hyps, lenv, enss, fns, d) else if vis_struct_expr(v) == 1 then vprove_body(vtemp_subst_var(b, nm, v), hyps, lenv, enss, fns, d) else let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then 0 else vprove_body(b, app(vcollect_div_hyps_e(v, hyps, lenv, fns, d), hyps), Cons({k: nm, v: lv}, lenv), enss, fns, d)
    VarIn(nm, v, b) => if vis_struct_expr(v) == 1 then vprove_body(vtemp_subst_var(b, nm, v), hyps, lenv, enss, fns, d) else let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then 0 else vprove_body(b, app(vcollect_div_hyps_e(v, hyps, lenv, fns, d), hyps), Cons({k: nm, v: lv}, lenv), enss, fns, d)
    DeferE(c, b)    => vprove_body(b, hyps, lenv, enss, fns, d)
    ErrDeferE(c, b) => vprove_body(b, hyps, lenv, enss, fns, d)
    If(c, t, e2)    => let rp = vcond_pos(c, hyps, lenv, fns, d) in let rn = vcond_neg(c, hyps, lenv, fns, d) in if rp.ok == 1 and rn.ok == 1 and vprove_body(t, app(rp.hyps, hyps), lenv, enss, fns, d) == 1 and vprove_body(e2, app(rn.hyps, hyps), lenv, enss, fns, d) == 1 then 1 else 0
    _               => let dhyps = app(vcollect_div_hyps_e(body, hyps, lenv, fns, d), hyps) in let lb = vlin_expr(body, dhyps, lenv, fns, d) in if lb.ok == 0 then 0 else let penv = Cons({k: "result", v: lb}, Cons({k: "ret", v: lb}, lenv)) in vprove_goals_all(enss, dhyps, penv, fns, d)

fn vqflia_prove_fn(ps, reqs, enss, body, fns) = if isnil(enss) == 1 then 0 else let lenv = vlin_init_env(ps) in let rh = vprove_reqs_hyps(reqs, lenv, fns) in if rh.ok == 0 then 0 else vprove_body(body, rh.hyps, lenv, enss, fns, 0)

fn vqflia_prove_law(ps, body, fns) = let lenv = vlin_init_env(ps) in if vprove_goal(body, Nil, lenv, fns, 0) == 1 then 1 else if len(ps) == 1 then let p0 = vlin_var(phd(ps)) in let hneg = Cons(vlin_sub(vlin_const(0 - 1), p0), Nil) in let hpos = Cons(p0, Nil) in if vprove_goal(body, hneg, lenv, fns, 0) == 1 and vprove_goal(body, hpos, lenv, fns, 0) == 1 then 1 else 0 else 0

fn vneg_goal_hyps(g, hyps, lenv, fns, d) = match g
    Bin(op, a, b) => if op == "and" then app(vneg_goal_hyps(a, hyps, lenv, fns, d), vneg_goal_hyps(b, hyps, lenv, fns, d)) else if op == "==" then app((vcond_cmp_pos(">", vlin_expr(a, hyps, lenv, fns, d), vlin_expr(b, hyps, lenv, fns, d))).hyps, (vcond_cmp_pos("<", vlin_expr(a, hyps, lenv, fns, d), vlin_expr(b, hyps, lenv, fns, d))).hyps) else (vcond_neg(g, hyps, lenv, fns, d)).hyps
    _             => Nil

fn vneg_goals_hyps(enss, hyps, penv, fns, d) = match enss
    Nil        => Nil
    Cons(g, r) => app(vneg_goal_hyps(g, hyps, penv, fns, d), vneg_goals_hyps(r, hyps, penv, fns, d))

fn vcollect_body_hyps(body, hyps, lenv, enss, fns, d) = match body
    LetIn(nm, v, b) => let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then hyps else vcollect_body_hyps(b, hyps, Cons({k: nm, v: lv}, lenv), enss, fns, d)
    VarIn(nm, v, b) => let lv = vlin_expr(v, hyps, lenv, fns, d) in if lv.ok == 0 then hyps else vcollect_body_hyps(b, hyps, Cons({k: nm, v: lv}, lenv), enss, fns, d)
    DeferE(c, b)    => vcollect_body_hyps(b, hyps, lenv, enss, fns, d)
    ErrDeferE(c, b) => vcollect_body_hyps(b, hyps, lenv, enss, fns, d)
    If(c, t, e2)    => let rp = vcond_pos(c, hyps, lenv, fns, d) in let rn = vcond_neg(c, hyps, lenv, fns, d) in app(vcollect_body_hyps(t, app(rp.hyps, hyps), lenv, enss, fns, d), vcollect_body_hyps(e2, app(rn.hyps, hyps), lenv, enss, fns, d))
    _               => let lb = vlin_expr(body, hyps, lenv, fns, d) in if lb.ok == 0 then hyps else let penv = Cons({k: "result", v: lb}, Cons({k: "ret", v: lb}, lenv)) in app(vneg_goals_hyps(enss, hyps, penv, fns, d), hyps)

fn vmem_int(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else vmem_int(x, t)

fn vadd_int_uniq(x, xs) = if vmem_int(x, xs) == 1 or len(xs) >= 6 then xs else app(xs, Cons(x, Nil))

fn vpts_from_hyps(p, hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => let c = vlin_coeff(p, h.cs) in if c == 0 then vpts_from_hyps(p, t, acc) else let b = (0 - h.c0) / c in vpts_from_hyps(p, t, vadd_int_uniq(b + 1, vadd_int_uniq(b, acc)))

fn vfm_trace_hyps(hyps, vars) = match vars
    Nil        => hyps
    Cons(v, r) => let next = vfm_elim_var(v, hyps) in if len(next) > 32 then hyps else app(hyps, vfm_trace_hyps(next, r))

fn vgen_envs_hyps(ps, idx, total, chyps) = match ps
    Nil        => Cons(Nil, Nil)
    Cons(p, r) => vcross_p(p, vpts_from_hyps(p, chyps, vpts_for(idx, total)), vgen_envs_hyps(r, idx + 1, total, chyps))

fn vprove_fn_status(nm, ps, body, vsigs, fns) = vprove_fn1(nm, ps, body, vsiglookup(nm, vsigs), fns)

fn vprove_fn1(nm, ps, body, mvs, fns) = match mvs
    Nil          => 1
    Cons(vsg, r) => let lenv = vlin_init_env(ps) in let raw_hyps = vcollect_body_hyps(body, (vprove_reqs_hyps(vsg.reqs, lenv, fns)).hyps, lenv, vsg.enss, fns, 0) in let chyps = vfm_trace_hyps(raw_hyps, vfm_vars(raw_hyps, Nil)) in let pr = vprove_envs(vgen_envs_hyps(ps, 0, len(ps), chyps), vsg.reqs, vsg.enss, body, fns, 0) in if pr.status < 0 then ctfail("lume: contract verification error [V0001]: cannot prove 'ensures' postcondition of '" + nm + "' — refuted with counterexample: " + pr.cex + " (fix-it: strengthen 'requires' precondition or fix implementation of '" + nm + "')\n") else vqflia_prove_fn(ps, vsg.reqs, vsg.enss, body, fns)

fn vprove_law_envs(envs, body, fns) = match envs
    Nil          => {status: 1, cex: ""}
    Cons(env, r) => let rb = veval(body, env, env, fns, 0) in if rb.ok == 1 and rb.i == 0 then {status: 0 - 1, cex: vfmt_env(env)} else vprove_law_envs(r, body, fns)

## --- Horizon H1 (#198): Real LTL Temporal Logic Prover (`always` □, `eventually` ◇, `until` U, `leads_to` ~>) ---
fn vtemp_subst_var(e, vnm, rep) = match e
    Var(nm)         => if nm == vnm then rep else e
    Bin(op, a, b)   => Bin(op, vtemp_subst_var(a, vnm, rep), vtemp_subst_var(b, vnm, rep))
    If(c, t, e2)    => If(vtemp_subst_var(c, vnm, rep), vtemp_subst_var(t, vnm, rep), vtemp_subst_var(e2, vnm, rep))
    LetIn(nm, v, b) => LetIn(nm, vtemp_subst_var(v, vnm, rep), if nm == vnm then b else vtemp_subst_var(b, vnm, rep))
    VarIn(nm, v, b) => VarIn(nm, vtemp_subst_var(v, vnm, rep), if nm == vnm then b else vtemp_subst_var(b, vnm, rep))
    Call(cnm, args) => Call(cnm, vtemp_subst_args(args, vnm, rep))
    _               => e

fn vtemp_subst_args(xs, vnm, rep) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(vtemp_subst_var(h, vnm, rep), vtemp_subst_args(t, vnm, rep))

fn vtemp_subst_ps(body, ps, args) = match ps
    Nil        => body
    Cons(p, r) => vtemp_subst_ps1(body, p, r, args)

fn vtemp_subst_ps1(body, p, r, args) = match args
    Nil         => body
    Cons(a, ar) => vtemp_subst_ps(vtemp_subst_var(body, p, a), r, ar)

fn vtemp_inline_ufn(cnm, cargs, mf, fns, d) = match mf
    Nil        => Call(cnm, cargs)
    Cons(f, r) => vtemp_inline_e(vtemp_subst_ps(f.body, f.ps, cargs), fns, d + 1)

fn vtemp_inline_args(xs, fns, d) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(vtemp_inline_e(h, fns, d), vtemp_inline_args(t, fns, d))

fn vtemp_inline_e(e, fns, d) = if d > 4 then e else vtemp_inline_e1(e, fns, d)

fn vtemp_inline_e1(e, fns, d) = match e
    Call(cnm, args) => let cargs = vtemp_inline_args(args, fns, d) in vtemp_inline_ufn(cnm, cargs, vfnlookup(cnm, fns), fns, d)
    Bin(op, a, b)   => Bin(op, vtemp_inline_e(a, fns, d), vtemp_inline_e(b, fns, d))
    If(c, t, e2)    => If(vtemp_inline_e(c, fns, d), vtemp_inline_e(t, fns, d), vtemp_inline_e(e2, fns, d))
    LetIn(nm, v, b) => LetIn(nm, vtemp_inline_e(v, fns, d), vtemp_inline_e(b, fns, d))
    VarIn(nm, v, b) => LetIn(nm, vtemp_inline_e(v, fns, d), vtemp_inline_e(b, fns, d))
    _               => e

fn vtemp_is_bool_e(e) = match e
    Bin(op, a, b) => if tiscmp(op) == 1 or op == "and" or op == "or" then 1 else 0
    _             => 0

fn vtemp_init_cond(sv, init_e) = if vtemp_is_bool_e(init_e) == 1 then init_e else Bin("==", Var(sv), init_e)

fn vtemp_neg_op(op) = if op == "<=" then ">" else if op == "<" then ">=" else if op == ">=" then "<" else if op == ">" then "<=" else if op == "==" then ">" else "!="

fn vtemp_neg_cond(goal_e, rank_e) = match goal_e
    Bin(op, a, b) => if op == "==" then Bin(">", rank_e, Num(0)) else Bin(vtemp_neg_op(op), a, b)
    _             => Bin(">", rank_e, Num(0))

fn vtemp_default_rank(sv, goal_e) = match goal_e
    Bin(op, a, b) => if op == "<=" or op == "==" then Bin("-", a, b) else if op == "<" then Bin("+", Bin("-", a, b), Num(1)) else if op == ">=" then Bin("-", b, a) else if op == ">" then Bin("+", Bin("-", b, a), Num(1)) else Var(sv)
    _             => Var(sv)

fn vtemp_infer_rank(sv, goal_e, rest_args) = match rest_args
    Nil        => vtemp_default_rank(sv, goal_e)
    Cons(r, t) => r

fn vtemp_arg3(args) = ohd_e(ptl(ptl(args)))
fn vtemp_arg4(args) = ohd_e(ptl(ptl(ptl(args))))
fn vtemp_rest3(args) = ptl(ptl(ptl(args)))
fn vtemp_rest4(args) = ptl(ptl(ptl(ptl(args))))

fn vtemp_cand_ints() = Cons(0, Cons(1, Cons(2, Cons(4, Cons(5, Cons(10, Cons(0 - 1, Cons(0 - 3, Nil))))))))

fn vtemp_filter_seeds(sv, init_c, xs, fns) = match xs
    Nil        => Nil
    Cons(x, r) => let env = Cons({k: sv, v: vv_int(x)}, Nil) in let rv = veval(init_c, env, env, fns, 0) in if rv.ok == 1 and rv.i != 0 then Cons(x, vtemp_filter_seeds(sv, init_c, r, fns)) else vtemp_filter_seeds(sv, init_c, r, fns)

fn vtemp_seeds(sv, init_e, fns) = if vtemp_is_bool_e(init_e) == 0 then (let rv = veval(init_e, Nil, Nil, fns, 0) in if rv.ok == 1 then Cons(rv.i, Nil) else vtemp_cand_ints()) else vtemp_filter_seeds(sv, init_e, vtemp_cand_ints(), fns)

fn vtemp_trace_always(sv, s_cur, step_e, inv_e, fns, t_step) = let env = Cons({k: sv, v: vv_int(s_cur)}, Nil) in let ri = veval(inv_e, env, env, fns, 0) in if ri.ok == 1 and ri.i == 0 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (violates always invariant at t=" + str(t_step) + ")"} else if t_step >= 12 then {ok: 1, cex: ""} else let rn = veval(step_e, env, env, fns, 0) in if rn.ok == 0 or rn.i == s_cur then {ok: 1, cex: ""} else let rr = vtemp_trace_always(sv, rn.i, step_e, inv_e, fns, t_step + 1) in if rr.ok == 0 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> " + rr.cex} else {ok: 1, cex: ""}

fn vtemp_sim_always_list(sv, seeds, step_e, inv_e, fns) = match seeds
    Nil         => {ok: 1, cex: ""}
    Cons(s0, r) => let tr = vtemp_trace_always(sv, s0, step_e, inv_e, fns, 0) in if tr.ok == 0 then {ok: 0, cex: "trace: " + tr.cex} else vtemp_sim_always_list(sv, r, step_e, inv_e, fns)

fn vtemp_ind_cex_list(sv, xs, step_e, inv_e, fns) = match xs
    Nil        => {ok: 1, cex: ""}
    Cons(x, r) => let env = Cons({k: sv, v: vv_int(x)}, Nil) in let ri = veval(inv_e, env, env, fns, 0) in if ri.ok == 1 and ri.i != 0 then (let rn = veval(step_e, env, env, fns, 0) in if rn.ok == 1 then (let env2 = Cons({k: sv, v: vv_int(rn.i)}, Nil) in let ri2 = veval(inv_e, env2, env2, fns, 0) in if ri2.ok == 1 and ri2.i == 0 then {ok: 0, cex: "inductive step counterexample: " + sv + "=" + str(x) + " -> " + sv + "'=" + str(rn.i) + " (invariant holds at " + str(x) + " but fails at next state " + str(rn.i) + ")"} else vtemp_ind_cex_list(sv, r, step_e, inv_e, fns)) else vtemp_ind_cex_list(sv, r, step_e, inv_e, fns)) else vtemp_ind_cex_list(sv, r, step_e, inv_e, fns)

fn vtemp_prove_always(sv, init_e, step_e, inv_e, fns) = let sim = vtemp_sim_always_list(sv, vtemp_seeds(sv, init_e, fns), step_e, inv_e, fns) in if sim.ok == 0 then {status: 0 - 1, cex: sim.cex} else let lenv = Cons({k: sv, v: vlin_var(sv)}, Nil) in let init_c = vtemp_inline_e(vtemp_init_cond(sv, init_e), fns, 0) in let inv_in = vtemp_inline_e(inv_e, fns, 0) in let step_in = vtemp_inline_e(step_e, fns, 0) in let next_goal = LetIn("_s_next", step_in, vtemp_subst_var(inv_in, sv, Var("_s_next"))) in let rh_base = vcond_pos(init_c, Nil, lenv, fns, 0) in let rh_step = vcond_pos(inv_in, Nil, lenv, fns, 0) in if rh_base.ok == 1 and rh_step.ok == 1 and vprove_goal(inv_in, rh_base.hyps, lenv, fns, 0) == 1 and vprove_goal(next_goal, rh_step.hyps, lenv, fns, 0) == 1 then {status: 1, cex: ""} else let ic = vtemp_ind_cex_list(sv, vtemp_cand_ints(), step_e, inv_e, fns) in if ic.ok == 0 then {status: 0 - 1, cex: ic.cex} else {status: 0 - 1, cex: "inductive step (inv => inv[s := step(s)]) is not provable in QF_LIA"}

fn vtemp_trace_ev(sv, s_cur, cfg, seen, fns, t_step) = let env = Cons({k: sv, v: vv_int(s_cur)}, Nil) in let rg = veval(cfg.goal_e, env, env, fns, 0) in if rg.ok == 1 and rg.i != 0 then {ok: 1, cex: ""} else if vmem_int(s_cur, seen) == 1 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (lasso cycle at " + sv + "=" + str(s_cur) + " while eventually goal false)"} else if t_step >= 16 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (eventually goal not reached within bounded horizon)"} else let rn = veval(cfg.step_e, env, env, fns, 0) in let r_cur = veval(cfg.rank_e, env, env, fns, 0) in if rn.ok == 0 then {ok: 1, cex: ""} else if rn.i == s_cur then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> t=" + str(t_step + 1) + ": " + sv + "=" + str(rn.i) + " (lasso cycle at " + sv + "=" + str(rn.i) + " while eventually goal false)"} else let env2 = Cons({k: sv, v: vv_int(rn.i)}, Nil) in let rg2 = veval(cfg.goal_e, env2, env2, fns, 0) in let r_nxt = veval(cfg.rank_e, env2, env2, fns, 0) in if rg2.ok == 1 and rg2.i == 0 and r_cur.ok == 1 and r_nxt.ok == 1 and r_nxt.i >= r_cur.i then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> t=" + str(t_step + 1) + ": " + sv + "=" + str(rn.i) + " (diverging rank " + str(r_nxt.i) + " >= " + str(r_cur.i) + " while eventually goal false)"} else let rr = vtemp_trace_ev(sv, rn.i, cfg, Cons(s_cur, seen), fns, t_step + 1) in if rr.ok == 0 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> " + rr.cex} else {ok: 1, cex: ""}

fn vtemp_sim_ev_list(sv, seeds, cfg, fns) = match seeds
    Nil         => {ok: 1, cex: ""}
    Cons(s0, r) => let tr = vtemp_trace_ev(sv, s0, cfg, Nil, fns, 0) in if tr.ok == 0 then {ok: 0, cex: "lasso/diverging trace: " + tr.cex} else vtemp_sim_ev_list(sv, r, cfg, fns)

fn vtemp_prove_eventually(sv, init_e, step_e, goal_e, rank_e, fns) = let cfg = {step_e: step_e, goal_e: goal_e, rank_e: rank_e, hold_e: Num(1)} in let sim = vtemp_sim_ev_list(sv, vtemp_seeds(sv, init_e, fns), cfg, fns) in if sim.ok == 0 then {status: 0 - 1, cex: sim.cex} else let lenv = Cons({k: sv, v: vlin_var(sv)}, Nil) in let rank_in = vtemp_inline_e(rank_e, fns, 0) in let step_in = vtemp_inline_e(step_e, fns, 0) in let ng_in = vtemp_inline_e(vtemp_neg_cond(goal_e, rank_in), fns, 0) in let bnd_goal = Bin(">", rank_in, Num(0)) in let dec_goal = LetIn("_s_next", step_in, Bin("<", vtemp_subst_var(rank_in, sv, Var("_s_next")), rank_in)) in let rh_ng = vcond_pos(ng_in, Nil, lenv, fns, 0) in if rh_ng.ok == 1 and vprove_goal(bnd_goal, rh_ng.hyps, lenv, fns, 0) == 1 and vprove_goal(dec_goal, rh_ng.hyps, lenv, fns, 0) == 1 then {status: 1, cex: ""} else {status: 0 - 1, cex: "ranking function '" + sv + "' does not strictly decrease under transition step in QF_LIA"}

fn vtemp_trace_until(sv, s_cur, cfg, seen, fns, t_step) = let env = Cons({k: sv, v: vv_int(s_cur)}, Nil) in let rg = veval(cfg.goal_e, env, env, fns, 0) in if rg.ok == 1 and rg.i != 0 then {ok: 1, cex: ""} else let rh = veval(cfg.hold_e, env, env, fns, 0) in if rh.ok == 1 and rh.i == 0 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (violates until hold condition before goal at t=" + str(t_step) + ")"} else if vmem_int(s_cur, seen) == 1 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (lasso cycle at " + sv + "=" + str(s_cur) + " before until goal reached)"} else if t_step >= 16 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (until goal not reached within bounded horizon)"} else let rn = veval(cfg.step_e, env, env, fns, 0) in if rn.ok == 0 then {ok: 1, cex: ""} else if rn.i == s_cur then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> t=" + str(t_step + 1) + ": " + sv + "=" + str(rn.i) + " (lasso cycle at " + sv + "=" + str(rn.i) + " before until goal reached)"} else let rr = vtemp_trace_until(sv, rn.i, cfg, Cons(s_cur, seen), fns, t_step + 1) in if rr.ok == 0 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> " + rr.cex} else {ok: 1, cex: ""}

fn vtemp_sim_until_list(sv, seeds, cfg, fns) = match seeds
    Nil         => {ok: 1, cex: ""}
    Cons(s0, r) => let tr = vtemp_trace_until(sv, s0, cfg, Nil, fns, 0) in if tr.ok == 0 then {ok: 0, cex: "until trace: " + tr.cex} else vtemp_sim_until_list(sv, r, cfg, fns)

fn vtemp_prove_until(sv, init_e, step_e, hold_e, goal_e, fns) = let rank_e = vtemp_default_rank(sv, goal_e) in let cfg = {step_e: step_e, goal_e: goal_e, rank_e: rank_e, hold_e: hold_e} in let sim = vtemp_sim_until_list(sv, vtemp_seeds(sv, init_e, fns), cfg, fns) in if sim.ok == 0 then {status: 0 - 1, cex: sim.cex} else let ev = vtemp_prove_eventually(sv, init_e, step_e, goal_e, rank_e, fns) in if ev.status < 0 then ev else let lenv = Cons({k: sv, v: vlin_var(sv)}, Nil) in let init_c = vtemp_inline_e(vtemp_init_cond(sv, init_e), fns, 0) in let hold_in = vtemp_inline_e(hold_e, fns, 0) in let goal_in = vtemp_inline_e(goal_e, fns, 0) in let step_in = vtemp_inline_e(step_e, fns, 0) in let ng_in = vtemp_inline_e(vtemp_neg_cond(goal_e, vtemp_inline_e(rank_e, fns, 0)), fns, 0) in let rh_init = vcond_pos(init_c, Nil, lenv, fns, 0) in let rh_step = vcond_pos(Bin("and", ng_in, hold_in), Nil, lenv, fns, 0) in let next_hold = LetIn("_s_next", step_in, Bin("or", vtemp_subst_var(hold_in, sv, Var("_s_next")), vtemp_subst_var(goal_in, sv, Var("_s_next")))) in if rh_init.ok == 1 and rh_step.ok == 1 and vprove_goal(Bin("or", goal_in, hold_in), rh_init.hyps, lenv, fns, 0) == 1 and vprove_goal(next_hold, rh_step.hyps, lenv, fns, 0) == 1 then {status: 1, cex: ""} else {status: 0 - 1, cex: "until hold invariant is not preserved prior to reaching goal in QF_LIA"}

fn vchk_temporal_call(nm, sv, cnm, args, fns) = if cnm == "always" and len(args) >= 3 then (let r = vtemp_prove_always(sv, ohd_e(args), ohd_e(ptl(args)), vtemp_arg3(args), fns) in if r.status < 0 then ctfail("lume: temporal verification error [V0005]: temporal law '" + nm + "' (always) refuted with counterexample: " + r.cex + " (fix-it: strengthen the state invariant or fix the transition function so the invariant holds initially and is preserved across every step)\n") else 1) else if cnm == "eventually" and len(args) >= 3 then (let g = vtemp_arg3(args) in let rk = vtemp_infer_rank(sv, g, vtemp_rest3(args)) in let r = vtemp_prove_eventually(sv, ohd_e(args), ohd_e(ptl(args)), g, rk, fns) in if r.status < 0 then ctfail("lume: temporal verification error [V0005]: temporal law '" + nm + "' (eventually) refuted with counterexample: " + r.cex + " (fix-it: ensure the transition step strictly decreases a well-founded ranking measure until the goal holds)\n") else 1) else if cnm == "until" and len(args) >= 4 then (let r = vtemp_prove_until(sv, ohd_e(args), ohd_e(ptl(args)), vtemp_arg3(args), vtemp_arg4(args), fns) in if r.status < 0 then ctfail("lume: temporal verification error [V0005]: temporal law '" + nm + "' (until) refuted with counterexample: " + r.cex + " (fix-it: ensure the hold predicate holds until the goal predicate is reached)\n") else 1) else if cnm == "leads_to" and len(args) >= 4 then (let g = vtemp_arg4(args) in let rk = vtemp_infer_rank(sv, g, vtemp_rest4(args)) in let r = vtemp_prove_eventually(sv, vtemp_arg3(args), ohd_e(ptl(args)), g, rk, fns) in if r.status < 0 then ctfail("lume: temporal verification error [V0005]: temporal law '" + nm + "' (leads_to) refuted with counterexample: " + r.cex + " (fix-it: ensure states satisfying the trigger eventually reach the response goal)\n") else 1) else 0 - 1

fn vchk_law(nm, ps, body, fns) = match body
    Call(cnm, args) => let tr = vchk_temporal_call(nm, if isnil(ps) == 1 then "s" else phd(ps), cnm, args, fns) in if tr >= 0 then tr else (let lenv = vlin_init_env(ps) in let chyps = vcollect_body_hyps(body, Nil, lenv, Cons(body, Nil), fns, 0) in let pr = vprove_law_envs(vgen_envs_hyps(ps, 0, len(ps), chyps), body, fns) in if pr.status < 0 then ctfail("lume: contract verification error [V0001]: law '" + nm + "' refuted with counterexample: " + pr.cex + " (fix-it: fix the implementation or refine law '" + nm + "')\n") else 1)
    _               => let lenv = vlin_init_env(ps) in let chyps = vcollect_body_hyps(body, Nil, lenv, Cons(body, Nil), fns, 0) in let pr = vprove_law_envs(vgen_envs_hyps(ps, 0, len(ps), chyps), body, fns) in if pr.status < 0 then ctfail("lume: contract verification error [V0001]: law '" + nm + "' refuted with counterexample: " + pr.cex + " (fix-it: fix the implementation or refine law '" + nm + "')\n") else 1

fn vchk_call_req(cnm, args, fnm, mvs, fns) = match mvs
    Nil          => 0
    Cons(vsg, r) => if isnil(vsg.reqs) == 1 then 0 else let ra = veval_args(args, Nil, Nil, fns, 0) in if ra.ok == 0 then 0 else let env = vbind_ps(vsg.ps, ra.vals) in let rq = veval_all_true(vsg.reqs, env, env, fns) in if rq.ok == 1 and rq.hold == 0 then ctfail("lume: contract verification error [V0001]: call to '" + cnm + "' in '" + fnm + "' violates 'requires' precondition with counterexample: " + vfmt_env(env) + " (fix-it: ensure arguments passed to '" + cnm + "' satisfy its 'requires' contract)\n") else 0

fn vchk_rect_inv(tn, items, fnm, miv, fns) = match miv
    Nil         => 0
    Cons(iv, r) => let rr = veval_rec(items, Nil, Nil, fns, 0) in if rr.ok == 0 then 0 else let env = vfields_env(rr.fields) in let ri = veval(iv.inv, env, env, fns, 0) in if ri.ok == 1 and ri.i == 0 then ctfail("lume: contract verification error [V0001]: record construction of '" + tn + "' in '" + fnm + "' violates type 'invariant' with counterexample: " + vfmt_env(env) + " (fix-it: satisfy the 'invariant' of '" + tn + "' before constructing the record)\n") else 0

fn vchk_expr_e(e, fnm, ot) = match e
    Call(cnm, args)         => vchk_call_req(cnm, args, fnm, vsiglookup(cnm, ot.vsigs), ot.fns) + vchk_args_e(args, fnm, ot)
    RecT(tn, items)         => vchk_rect_inv(tn, items, fnm, vinvlookup(tn, ot.invs), ot.fns) + vchk_rec_e(items, fnm, ot)
    Rec(items)              => vchk_rec_e(items, fnm, ot)
    Field(o, fld)           => vchk_expr_e(o, fnm, ot)
    Bin(op, l, r)           => vchk_expr_e(l, fnm, ot) + vchk_expr_e(r, fnm, ot)
    If(c, t, e2)            => vchk_expr_e(c, fnm, ot) + vchk_expr_e(t, fnm, ot) + vchk_expr_e(e2, fnm, ot)
    LetIn(nm, v, b)         => vchk_expr_e(v, fnm, ot) + vchk_expr_e(b, fnm, ot)
    VarIn(nm, v, b)         => vchk_expr_e(v, fnm, ot) + vchk_expr_e(b, fnm, ot)
    DeferE(c, b)            => vchk_expr_e(c, fnm, ot) + vchk_expr_e(b, fnm, ot)
    ErrDeferE(c, b)         => vchk_expr_e(c, fnm, ot) + vchk_expr_e(b, fnm, ot)
    WithAllocE(a, b)        => vchk_expr_e(a, fnm, ot) + vchk_expr_e(b, fnm, ot)
    WithHandlerE(en, hs, b) => vchk_expr_e(b, fnm, ot)
    ScopeE(snm, b)          => vchk_expr_e(b, fnm, ot)
    SpawnE(inner)           => vchk_expr_e(inner, fnm, ot)
    Match(sc, arms)         => vchk_expr_e(sc, fnm, ot) + vchk_arms_e(arms, fnm, ot)
    _                       => 0

fn vchk_args_e(args, fnm, ot) = match args
    Nil        => 0
    Cons(h, t) => vchk_expr_e(h, fnm, ot) + vchk_args_e(t, fnm, ot)

fn vchk_rec_e(items, fnm, ot) = match items
    Nil        => 0
    Cons(h, t) => vchk_expr_e(h.val, fnm, ot) + vchk_rec_e(t, fnm, ot)

fn vchk_arms_e(arms, fnm, ot) = match arms
    Nil        => 0
    Cons(h, t) => vchk_expr_e(h.body, fnm, ot) + vchk_arms_e(t, fnm, ot)

## ============================================================================================================
## Combined function driver for Track O, Track A, Track K, Track S & Track V (`ochkfn`)
## ============================================================================================================
fn aget_fn_rty(msig, mosig) = match mosig
    Cons(osg, r) => if isany(osg.rty) == 0 then osg.rty else aget_sig_rty(msig)
    Nil          => aget_sig_rty(msig)

fn aget_sig_rty(msig) = match msig
    Cons(sg, r) => sg.rt
    Nil         => TyAny

fn aget_fn_lenv(msig) = match msig
    Cons(sg, r) => tparamlenv(sg)
    Nil         => Nil

fn ahas_hole_e(e) = match e
    Var(nm)         => ais_hole_name(nm)
    Bin(op, a, b)   => if ahas_hole_e(a) == 1 then 1 else ahas_hole_e(b)
    If(c, t, e2)    => if ahas_hole_e(c) == 1 then 1 else if ahas_hole_e(t) == 1 then 1 else ahas_hole_e(e2)
    LetIn(nm, v, b) => if ahas_hole_e(v) == 1 then 1 else ahas_hole_e(b)
    VarIn(nm, v, b) => if ahas_hole_e(v) == 1 then 1 else ahas_hole_e(b)
    Call(nm, args)  => ahas_hole_args(args)
    _               => 0

fn ahas_hole_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => if ahas_hole_e(h) == 1 then 1 else ahas_hole_args(t)

fn afill_holes_e(e, expty, lenv, hctx) = match e
    Var(nm)         => if ais_hole_name(nm) == 1 then (if isnil(vsiglookup(hctx.fnm, hctx.vsigs)) == 1 and isnil(alaws_mention_fn(hctx.fnm, hctx.laws)) == 1 then Num(0) else abest_hole_expr(expty, lenv, nm, hctx)) else e
    Bin(op, a, b)   => Bin(op, afill_holes_e(a, abin_expty(op, b, expty, lenv, hctx.sigs), lenv, hctx), afill_holes_e(b, abin_expty(op, a, expty, lenv, hctx.sigs), lenv, hctx))
    If(c, t, e2)    => If(afill_holes_e(c, TyName("int"), lenv, hctx), afill_holes_e(t, expty, lenv, hctx), afill_holes_e(e2, expty, lenv, hctx))
    LetIn(nm, v, b) => let vt = aquick_ty(v, lenv, hctx.sigs) in LetIn(nm, afill_holes_e(v, vt, lenv, hctx), afill_holes_e(b, expty, Cons({k: nm, v: vt}, lenv), hctx))
    VarIn(nm, v, b) => let vt = aquick_ty(v, lenv, hctx.sigs) in VarIn(nm, afill_holes_e(v, vt, lenv, hctx), afill_holes_e(b, expty, Cons({k: nm, v: vt}, lenv), hctx))
    Call(nm, args)  => Call(nm, afill_holes_args(args, expty, lenv, hctx))
    _               => e

fn afill_holes_args(xs, expty, lenv, hctx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(afill_holes_e(h, expty, lenv, hctx), afill_holes_args(t, expty, lenv, hctx))

fn afill_prog_holes(prog, sigs, osigs, vsigs, laws, fns) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(afill_stmt_holes(h, sigs, osigs, vsigs, laws, fns), afill_prog_holes(t, sigs, osigs, vsigs, laws, fns))

fn afill_stmt_holes(st, sigs, osigs, vsigs, laws, fns) = match st
    Fn(nm, ps, body) => if ahas_hole_e(body) == 0 then st else let mosig = osiglookup(nm, osigs) in if apub_osig(mosig) == 1 then st else let msig = tsiglookup(nm, sigs) in let rty = aget_fn_rty(msig, mosig) in if tystr(rty) == "?" then st else let lenv = aget_fn_lenv(msig) in Fn(nm, ps, afill_holes_e(body, rty, lenv, {fnm: nm, pubf: 0, ps: ps, body: body, sigs: sigs, vsigs: vsigs, laws: laws, fns: fns}))
    _                => st

fn apub_osig(mosig) = match mosig
    Nil          => 0
    Cons(osg, r) => osg.pubf

## ============================================================================================================
## Phase 4 Track N1: Symbolic Tensor Shape Unification & `[T0300]` Shape Verification
## ============================================================================================================
fn n4_is_digits(s) = if count(s) == 0 then 0 else isdigit(at(s, 0))

fn n4_tdims(ty) = match ty
    TyTensor(e, ds) => ds
    _               => Nil

fn n4_dim0(ds) = phd(ds)
fn n4_dim1(ds) = phd(ptl(ds))

fn n4_dim_compat(d1, d2) = if d1 == "" or d2 == "" or d1 == d2 or d1 == "_" or d2 == "_" then 1 else 0

fn n4_lookup_tenv(k, tenv) = match tenv
    Nil        => Nil
    Cons(h, t) => if h.k == k then h.ds else n4_lookup_tenv(k, t)

fn n4_rec_fields(tn, recs) = match recs
    Nil        => Nil
    Cons(h, t) => if h.rname == tn then h.fields else n4_rec_fields(tn, t)

fn n4_bind_rec_fields(p, fields, rest) = match fields
    Nil        => rest
    Cons(f, r) => let ds = n4_tdims(f.fty) in let next = n4_bind_rec_fields(p, r, rest) in if isnil(ds) == 0 then Cons({k: p + "." + f.fname, ds: ds}, next) else next

fn n4_init_tenv_ps(pns, pts, recs) = match pns
    Nil         => Nil
    Cons(pn, r) => let ty = ohd_ty(pts) in let ds = n4_tdims(ty) in let rest = n4_init_tenv_ps(r, ptl(pts), recs) in if isnil(ds) == 0 then Cons({k: pn, ds: ds}, rest) else n4_init_tenv_rec(pn, ty, recs, rest)

fn n4_init_tenv_rec(pn, ty, recs, rest) = match ty
    TyName(tn) => n4_bind_rec_fields(pn, n4_rec_fields(tn, recs), rest)
    _          => rest

fn n4_init_tenv(msig, recs) = match msig
    Nil        => Nil
    Cons(sg, r) => n4_init_tenv_ps(sg.pn, sg.pt, recs)

fn n4_num_str(e) = match e
    Num(n) => str(n)
    _      => ""

fn n4_infer_dims(e, fnm, tenv, ot) = match e
    Var(x)          => n4_lookup_tenv(x, tenv)
    Field(o, fld)   => n4_infer_field_dims(o, fld, tenv)
    LetIn(nm, v, b) => let dv = n4_infer_dims(v, fnm, tenv, ot) in n4_infer_dims(b, fnm, if isnil(dv) == 0 then Cons({k: nm, ds: dv}, tenv) else tenv, ot)
    VarIn(nm, v, b) => let dv = n4_infer_dims(v, fnm, tenv, ot) in n4_infer_dims(b, fnm, if isnil(dv) == 0 then Cons({k: nm, ds: dv}, tenv) else tenv, ot)
    If(c, t, e2)    => let dc = n4_infer_dims(c, fnm, tenv, ot) in let dt = n4_infer_dims(t, fnm, tenv, ot) in let de = n4_infer_dims(e2, fnm, tenv, ot) in dt
    Bin(op, l, r)   => let dl = n4_infer_dims(l, fnm, tenv, ot) in let dr = n4_infer_dims(r, fnm, tenv, ot) in Nil
    Call(cnm, args) => n4_infer_call_dims(cnm, args, fnm, tenv, ot)
    _               => Nil

fn n4_infer_field_dims(o, fld, tenv) = match o
    Var(x) => n4_lookup_tenv(x + "." + fld, tenv)
    _      => Nil

fn n4_infer_args_dims(args, fnm, tenv, ot) = match args
    Nil        => Nil
    Cons(a, r) => Cons(n4_infer_dims(a, fnm, tenv, ot), n4_infer_args_dims(r, fnm, tenv, ot))

fn n4_senv_lookup(s, senv) = match senv
    Nil        => s
    Cons(h, t) => if h.k == s then h.v else n4_senv_lookup(s, t)

fn n4_bind_dim(pat_d, act_d, cnm, fnm, senv) = if act_d == "" then senv else if n4_is_digits(pat_d) == 1 then (if n4_dim_compat(pat_d, act_d) == 0 then ctfail("lume: tensor shape error [T0300]: argument to '" + cnm + "' in '" + fnm + "' has dimension " + act_d + " but parameter expects " + pat_d + " (fix-it: reshape tensor dimension " + act_d + " to " + pat_d + ")\n") else senv) else let prev = n4_senv_lookup(pat_d, senv) in if prev == pat_d then Cons({k: pat_d, v: act_d}, senv) else if n4_dim_compat(prev, act_d) == 0 then ctfail("lume: tensor shape error [T0300]: symbolic tensor dimension '" + pat_d + "' in call to '" + cnm + "' in '" + fnm + "' unified to " + prev + " and conflicts with " + act_d + " (fix-it: ensure all '" + pat_d + "' dimensions match " + prev + ")\n") else senv

fn n4_unify_dims_list(pds, ads, cnm, fnm, senv) = match pds
    Nil          => senv
    Cons(pd, pr) => n4_unify_dims_step(pd, pr, ads, cnm, fnm, senv)

fn n4_unify_dims_step(pd, pr, ads, cnm, fnm, senv) = match ads
    Nil          => senv
    Cons(ad, ar) => n4_unify_dims_list(pr, ar, cnm, fnm, n4_bind_dim(pd, ad, cnm, fnm, senv))

fn n4_unify_sig_args(pts, adims, cnm, fnm, senv) = match pts
    Nil          => senv
    Cons(pt, pr) => n4_unify_sig_arg1(n4_tdims(pt), pr, adims, cnm, fnm, senv)

fn n4_unify_sig_arg1(pds, pr, adims, cnm, fnm, senv) = match adims
    Nil          => senv
    Cons(ad, ar) => let senv2 = if isnil(pds) == 0 and isnil(ad) == 0 then (if len(pds) != len(ad) then ctfail("lume: tensor shape error [T0300]: argument to '" + cnm + "' in '" + fnm + "' has rank " + str(len(ad)) + " but parameter expects rank " + str(len(pds)) + "\n") else n4_unify_dims_list(pds, ad, cnm, fnm, senv)) else senv in n4_unify_sig_args(pr, ar, cnm, fnm, senv2)

fn n4_subst_dims(ds, senv) = match ds
    Nil        => Nil
    Cons(d, r) => Cons(n4_senv_lookup(d, senv), n4_subst_dims(r, senv))

fn n4_call_sig_dims(cnm, adims, fnm, msig) = match msig
    Nil        => Nil
    Cons(sg, r) => let senv = n4_unify_sig_args(sg.pt, adims, cnm, fnm, Nil) in n4_subst_dims(n4_tdims(sg.rt), senv)

fn n4_infer_call_dims(cnm, args, fnm, tenv, ot) = let adims = n4_infer_args_dims(args, fnm, tenv, ot) in if (cnm == "tensor_zeros" or cnm == "tensor_ones" or cnm == "tensor_mat") and len(args) >= 2 then (let r0 = n4_num_str(ohd_e(args)) in let c0 = n4_num_str(ohd_e(ptl(args))) in if r0 != "" and c0 != "" then Cons(r0, Cons(c0, Nil)) else Nil) else if (cnm == "matmul" or cnm == "tensor_matmul" or cnm == "einsum_ij_jk") and len(args) == 2 then (let da = phd_l(adims) in let db = phd_l(ptl(adims)) in if len(da) == 2 and len(db) == 2 then (let r1 = n4_dim0(da) in let c1 = n4_dim1(da) in let r2 = n4_dim0(db) in let c2 = n4_dim1(db) in if n4_dim_compat(c1, r2) == 0 then ctfail("lume: tensor shape error [T0300]: cannot multiply tensor of shape [" + r1 + ", " + c1 + "] by tensor of shape [" + r2 + ", " + c2 + "] in '" + fnm + "' — inner dimensions " + c1 + " != " + r2 + " (fix-it: transpose one operand or change weight shape to [" + c1 + ", " + c2 + "])\n") else Cons(r1, Cons(c2, Nil))) else Nil) else if (cnm == "tensor_add" or cnm == "tensor_sub" or cnm == "tensor_mul") and len(args) == 2 then (let da = phd_l(adims) in let db = phd_l(ptl(adims)) in if len(da) == 2 and len(db) == 2 then (let r1 = n4_dim0(da) in let c1 = n4_dim1(da) in let r2 = n4_dim0(db) in let c2 = n4_dim1(db) in if n4_dim_compat(c1, c2) == 0 or (n4_dim_compat(r1, r2) == 0 and r1 != "1" and r2 != "1") then ctfail("lume: tensor shape error [T0300]: elementwise tensor operation '" + cnm + "' in '" + fnm + "' has incompatible shapes [" + r1 + ", " + c1 + "] and [" + r2 + ", " + c2 + "] (fix-it: align tensor shapes to [" + r1 + ", " + c1 + "])\n") else da) else Nil) else if cnm == "tensor_add_bias" and len(args) == 2 then (let da = phd_l(adims) in let db = phd_l(ptl(adims)) in if len(da) == 2 and len(db) == 2 then (let r1 = n4_dim0(da) in let c1 = n4_dim1(da) in let r2 = n4_dim0(db) in let c2 = n4_dim1(db) in if n4_dim_compat(c1, c2) == 0 then ctfail("lume: tensor shape error [T0300]: bias addition in '" + fnm + "' has matrix columns " + c1 + " != bias columns " + c2 + " (fix-it: change bias shape to [1, " + c1 + "])\n") else da) else Nil) else if cnm == "tensor_transpose" and len(args) == 1 then (let da = phd_l(adims) in if len(da) == 2 then Cons(n4_dim1(da), Cons(n4_dim0(da), Nil)) else Nil) else if (cnm == "tensor_relu" or cnm == "tensor_scale") and len(args) >= 1 then phd_l(adims) else n4_call_sig_dims(cnm, adims, fnm, tsiglookup(cnm, ot.sigs))

fn phd_l(xs) = match xs
    Nil        => Nil
    Cons(h, t) => h

fn n4_chk_fn_tensors(nm, body, msig, ot) = let tenv = n4_init_tenv(msig, ot.recs) in let db = n4_infer_dims(body, nm, tenv, ot) in let rds = n4_tdims(aget_sig_rty(msig)) in if len(db) == 2 and len(rds) == 2 then (if n4_dim_compat(n4_dim0(db), n4_dim0(rds)) == 0 or n4_dim_compat(n4_dim1(db), n4_dim1(rds)) == 0 then ctfail("lume: tensor shape error [T0300]: function '" + nm + "' returns tensor of shape [" + n4_dim0(db) + ", " + n4_dim1(db) + "] but signature declares [" + n4_dim0(rds) + ", " + n4_dim1(rds) + "] (fix-it: change return shape annotation or final projection layer)\n") else 1) else 1

## ============================================================================================================
## Phase 4 Track N2: Symbolic Reverse/Forward Autodiff (`grad`/`jvp`/`vjp`/`vmap`/`jit`) & `kernel fn` Check
## ============================================================================================================
fn n4_lookup_dvar(nm, dvars) = match dvars
    Nil        => Num(0)
    Cons(h, t) => if h.k == nm then h.dv else n4_lookup_dvar(nm, t)

fn n4_diff_call(cnm, args, v, dvars, fnm) = if cnm == "relu" and len(args) == 1 then (let u = ohd_e(args) in If(Bin(">", u, Num(0)), n4_diff_e(u, v, dvars, fnm), Num(0))) else if cnm == "sq" and len(args) == 1 then (let u = ohd_e(args) in Bin("*", Bin("*", Num(2), u), n4_diff_e(u, v, dvars, fnm))) else if cnm == "cube" and len(args) == 1 then (let u = ohd_e(args) in Bin("*", Bin("*", Num(3), Bin("*", u, u)), n4_diff_e(u, v, dvars, fnm))) else if cnm == "abs" and len(args) == 1 then (let u = ohd_e(args) in let du = n4_diff_e(u, v, dvars, fnm) in If(Bin(">=", u, Num(0)), du, Bin("-", Num(0), du))) else if cnm == "clamp" and len(args) == 3 then (let u = ohd_e(args) in let lo = ohd_e(ptl(args)) in let hi = ohd_e(ptl(ptl(args))) in If(Bin("<", u, lo), Num(0), If(Bin(">", u, hi), Num(0), n4_diff_e(u, v, dvars, fnm)))) else if cnm == "leaky_relu" and len(args) == 2 then (let u = ohd_e(args) in let k = ohd_e(ptl(args)) in let du = n4_diff_e(u, v, dvars, fnm) in If(Bin(">", u, Num(0)), du, Bin("*", k, du))) else if cnm == "quot" and len(args) == 2 then (let a = ohd_e(args) in let b = ohd_e(ptl(args)) in let da = n4_diff_e(a, v, dvars, fnm) in let db = n4_diff_e(b, v, dvars, fnm) in Bin("/", Bin("-", Bin("*", da, b), Bin("*", a, db)), Bin("*", b, b))) else ctfail("lume: autodiff error [N0400]: cannot differentiate unhandled call '" + cnm + "' in '" + fnm + "' (inline the function or restrict 'grad' to the polynomial fragment +, -, *, if, let)\n")

fn n4_diff_e(e, v, dvars, fnm) = match e
    Num(n)          => Num(0)
    Var(nm)         => if nm == v then Num(1) else n4_lookup_dvar(nm, dvars)
    OwnE(inner)     => n4_diff_e(inner, v, dvars, fnm)
    MutE(inner)     => n4_diff_e(inner, v, dvars, fnm)
    Bin(op, a, b)   => if op == "+" then Bin("+", n4_diff_e(a, v, dvars, fnm), n4_diff_e(b, v, dvars, fnm)) else if op == "-" then Bin("-", n4_diff_e(a, v, dvars, fnm), n4_diff_e(b, v, dvars, fnm)) else if op == "*" then Bin("+", Bin("*", n4_diff_e(a, v, dvars, fnm), b), Bin("*", a, n4_diff_e(b, v, dvars, fnm))) else ctfail("lume: autodiff error [N0400]: cannot differentiate non-polynomial operator '" + op + "' in '" + fnm + "' (supported exact differentiable fragment: +, -, *, if, let)\n")
    If(c, t, e2)    => If(c, n4_diff_e(t, v, dvars, fnm), n4_diff_e(e2, v, dvars, fnm))
    LetIn(nm, x, b) => let dx = n4_diff_e(x, v, dvars, fnm) in let dnm = "_ad_d_" + nm in LetIn(dnm, dx, LetIn(nm, x, n4_diff_e(b, v, Cons({k: nm, dv: Var(dnm)}, dvars), fnm)))
    VarIn(nm, x, b) => let dx = n4_diff_e(x, v, dvars, fnm) in let dnm = "_ad_d_" + nm in LetIn(dnm, dx, LetIn(nm, x, n4_diff_e(b, v, Cons({k: nm, dv: Var(dnm)}, dvars), fnm)))
    Call(cnm, args) => n4_diff_call(cnm, args, v, dvars, fnm)
    _               => ctfail("lume: autodiff error [N0400]: cannot differentiate non-polynomial expression in '" + fnm + "' (supported exact differentiable fragment: +, -, *, if, let)\n")

fn n4_collect_grads_e(e, acc) = match e
    Call(nm, args)  => let acc2 = n4_collect_grads_args(args, acc) in if (nm == "grad" or nm == "value_and_grad" or nm == "jvp" or nm == "vjp") and isnil(args) == 0 then n4_add_grad_target(ohd_e(args), acc2) else acc2
    Field(o, nm)    => n4_collect_grads_e(o, acc)
    Bin(op, l, r)   => n4_collect_grads_e(r, n4_collect_grads_e(l, acc))
    If(c, t, e2)    => n4_collect_grads_e(e2, n4_collect_grads_e(t, n4_collect_grads_e(c, acc)))
    LetIn(nm, v, b) => n4_collect_grads_e(b, n4_collect_grads_e(v, acc))
    VarIn(nm, v, b) => n4_collect_grads_e(b, n4_collect_grads_e(v, acc))
    _               => acc

fn n4_collect_grads_args(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => n4_collect_grads_args(t, n4_collect_grads_e(h, acc))

fn n4_add_grad_target(e, acc) = match e
    Var(fnm) => if omem(fnm, acc) == 1 then acc else Cons(fnm, acc)
    _        => acc

fn n4_collect_grads_prog(prog, acc) = match prog
    Nil        => acc
    Cons(h, t) => n4_collect_grads_stmt(h, n4_collect_grads_prog(t, acc))

fn n4_collect_grads_stmt(st, acc) = match st
    Fn(nm, ps, body)                  => n4_collect_grads_e(body, acc)
    VContractSig(nm, ps, reqs, enss)  => n4_collect_grads_args(reqs, n4_collect_grads_args(enss, acc))
    VLawDecl(nm, ps, body)            => n4_collect_grads_e(body, acc)
    Print(v)                          => n4_collect_grads_e(v, acc)
    ExprS(v)                          => n4_collect_grads_e(v, acc)
    _                                 => acc

fn n4_synth_grad_fns(targets, raw_fns) = match targets
    Nil          => Nil
    Cons(fnm, r) => n4_synth_grad_one(fnm, vfnlookup(fnm, raw_fns), n4_synth_grad_fns(r, raw_fns))

fn n4_synth_grad_one(fnm, mf, rest) = match mf
    Nil        => rest
    Cons(f, r) => Cons(Fn("__ad_grad_" + fnm, f.ps, n4_diff_e(f.body, phd(f.ps), Nil, fnm)), rest)

fn n4_grad_fn_name(fnm, ufns) = if omem("grad_" + fnm, ufns) == 1 then "grad_" + fnm else if omem("mlp2_grad", ufns) == 1 and fnm == "mlp2_loss" then "mlp2_grad" else "__ad_grad_" + fnm

fn n4_subst_call(e, vnm, gfn) = match e
    Call(cnm, args) => Call(if cnm == vnm then gfn else cnm, n4_subst_call_args(args, vnm, gfn))
    Bin(op, l, r)   => Bin(op, n4_subst_call(l, vnm, gfn), n4_subst_call(r, vnm, gfn))
    If(c, t, e2)    => If(n4_subst_call(c, vnm, gfn), n4_subst_call(t, vnm, gfn), n4_subst_call(e2, vnm, gfn))
    LetIn(nm, v, b) => LetIn(nm, n4_subst_call(v, vnm, gfn), if nm == vnm then b else n4_subst_call(b, vnm, gfn))
    VarIn(nm, v, b) => VarIn(nm, n4_subst_call(v, vnm, gfn), if nm == vnm then b else n4_subst_call(b, vnm, gfn))
    _               => e

fn n4_subst_call_args(xs, vnm, gfn) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(n4_subst_call(h, vnm, gfn), n4_subst_call_args(t, vnm, gfn))

fn n4_is_grad_let(v) = match v
    Call(cnm, args) => if cnm == "grad" and len(args) == 1 then n4_var_name(ohd_e(args)) else ""
    _               => ""

fn n4_var_name(e) = match e
    Var(nm) => nm
    Str(nm) => nm
    _       => ""

fn n4_chk_kernel_fn(nm, freef, body, ot) = let inf = kinfer_effs_e(body, ot.ksigs, ot.edecls, ot.fns, 4) in if ois_kernel(freef) == 1 and (omem("io", inf) == 1 or omem("fs", inf) == 1 or omem("net", inf) == 1) then ctfail("lume: effect error [E0200]: accelerator 'kernel fn " + nm + "' cannot perform host I/O effect '{" + keff_join(inf) + "}' (fix-it: keep 'kernel fn' pure/data-parallel and move host I/O outside the kernel)\n") else if ois_interrupt(freef) == 1 and (omem("alloc", inf) == 1 or omem("io", inf) == 1 or omem("fs", inf) == 1 or omem("net", inf) == 1 or omem("async", inf) == 1) then ctfail("lume: effect error [E0200]: interrupt handler '@interrupt fn " + nm + "' cannot allocate or block (performs '{" + keff_join(inf) + "}') (fix-it: pre-allocate state in a static capability region and remove blocking I/O from the ISR)\n") else 0

fn vcollect_wcets(prog) = match prog
    Nil        => Nil
    Cons(h, t) => vcollect_wcet1(h, vcollect_wcets(t))

fn vcollect_wcet1(st, rest) = match st
    WcetSig(nm, bound) => Cons({nm: nm, bound: bound}, rest)
    _                  => rest

fn vwcet_lookup(nm, wcets) = match wcets
    Nil        => 0
    Cons(h, t) => if h.nm == nm then h.bound else vwcet_lookup(nm, t)

fn vwcet_max(a, b) = if a >= b then a else b

fn vwcet_e(e, fns, d) = if d <= 0 then 100000 else vwcet_e1(e, fns, d)

fn vwcet_e1(e, fns, d) = match e
    Num(n)          => 1
    Str(s)          => 1
    Var(x)          => 1
    Field(o, fld)   => 2 + vwcet_e(o, fns, d)
    Bin(op, l, r)   => (if op == "*" or op == "/" or op == "%" then 4 else 1) + vwcet_e(l, fns, d) + vwcet_e(r, fns, d)
    If(c, t, e2)    => 2 + vwcet_e(c, fns, d) + vwcet_max(vwcet_e(t, fns, d), vwcet_e(e2, fns, d))
    LetIn(nm, v, b) => 1 + vwcet_e(v, fns, d) + vwcet_e(b, fns, d)
    VarIn(nm, v, b) => 1 + vwcet_e(v, fns, d) + vwcet_e(b, fns, d)
    Call(cnm, args) => 4 + vwcet_args(args, fns, d) + vwcet_call(cnm, vfnlookup(cnm, fns), fns, d)
    _               => 2

fn vwcet_args(xs, fns, d) = match xs
    Nil        => 0
    Cons(h, t) => vwcet_e(h, fns, d) + vwcet_args(t, fns, d)

fn vwcet_call(cnm, mf, fns, d) = match mf
    Nil        => 0
    Cons(f, r) => if afn_calls_self(cnm, f.body) == 1 then 100000 else vwcet_e(f.body, fns, d - 1)

fn vwcet_chk_fn(nm, body, wcets, fns) = let bound = vwcet_lookup(nm, wcets) in if bound <= 0 then 0 else let est = (if afn_calls_self(nm, body) == 1 then 100000 else vwcet_e(body, fns, 4)) in if est > bound then ctfail("lume: wcet budget error [V0002]: function '" + nm + "' has structural cycle cost of " + str(est) + " cycles, exceeding '@bound(cycles: " + str(bound) + ")' (fix-it: remove recursion/loops on the critical path or increase '@bound(cycles: " + str(est) + ")')\n") else 1

fn ochkfn(nm, ps, body, ot) = ochkfn2(nm, ps, body, osiglookup(nm, ot.osigs), tsiglookup(nm, ot.sigs), ot)

fn ochkfn2(nm, ps, body, mosig, msig, ot) = match mosig
    Nil          => let zwc = vwcet_chk_fn(nm, body, ot.wcets, ot.fns) in let ztn = n4_chk_fn_tensors(nm, body, msig, ot) in let zv = vprove_fn_status(nm, ps, body, ot.vsigs, ot.fns) + (if isnil(ot.vsigs) == 1 and isnil(ot.invs) == 1 then 0 else vchk_expr_e(body, nm, ot)) in let zk = kchk_fn_effs(nm, 0, body, ot) in if oanye(body) == 0 and isnil(ot.osigs) == 1 and isnil(ot.otypes) == 1 and isnil(auinit_from_sig(msig)) == 1 then 1 else let rty = aget_sig_rty(msig) in let lenv = aget_fn_lenv(msig) in let zs = schk_conc_e(body, nm, 0, sinit_nonsend_sig(msig), Nil) in let zh = achk_holes_e(body, rty, lenv, {fnm: nm, pubf: 0, ps: ps, body: body, sigs: ot.sigs, vsigs: ot.vsigs, laws: ot.laws, fns: ot.fns}) in let zp = achk_prov_e(body, nm, auinit_from_sig(msig), ot) in let ctx = {fnm: nm, pubf: 0, freef: 0, halloc: 0, bparams: ps, mvars: Nil, pnames: ps, locals: Nil, origins: oinit_origins(ps), osigs: ot.osigs, otypes: ot.otypes} in let rb = ochke(body, ctx, Nil) in ochk_ret_origin(nm, 0, "", rty, ps, rb.origin)
    Cons(sg, sr) => if sg.pubf == 1 and oisgctype(sg.rty, ot.otypes) == 1 then ctfail("lume: ownership error [O0030]: public function '" + nm + "' cannot expose '@gc' region type across a public module boundary\n") else let zsec = (if sg.pubf == 1 or ois_protect(sg.freef) == 1 then w33_chk_sec_e(body, nm) else 0) in let zwc = vwcet_chk_fn(nm, body, ot.wcets, ot.fns) in let ztn = n4_chk_fn_tensors(nm, body, msig, ot) in let zkn = n4_chk_kernel_fn(nm, sg.freef, body, ot) in let rty = aget_fn_rty(msig, mosig) in let lenv = aget_fn_lenv(msig) in let mvars = omvars_pl(sg.pl) in let zv = vprove_fn_status(nm, ps, body, ot.vsigs, ot.fns) + vchk_expr_e(body, nm, ot) in let zk = kchk_fn_effs(nm, sg.pubf, body, ot) in let zs = schk_conc_e(body, nm, 0, sinit_nonsend_sig(msig), mvars) in let zh = achk_holes_e(body, rty, lenv, {fnm: nm, pubf: sg.pubf, ps: ps, body: body, sigs: ot.sigs, vsigs: ot.vsigs, laws: ot.laws, fns: ot.fns}) in let zt = (if ois_total(sg.freef) == 1 then achk_total_e(body, {fnm: nm, ps: ps, fns: ot.fns, osigs: ot.osigs}, Nil, Nil) else 0) in let tret = achk_prov_e(body, nm, auinit_from_sig(msig), ot) in if sg.pubf == 1 and ois_llm(sg.freef) == 0 and ois_unverified_ty(rty) == 0 and tret == 1 then ctfail("lume: provenance error [A0003]: unverified AI/probabilistic value cannot be returned from trusted 'pub fn " + nm + "' without verification (fix-it: wrap the return value in 'verify(val, <contract>)' or validate with a contract guard before returning)\n") else let bparams = if isnil(sg.pl) == 1 then ps else obparams_pl(sg.pl) in let ctx = {fnm: nm, pubf: sg.pubf, freef: sg.freef, halloc: 0, bparams: bparams, mvars: mvars, pnames: ps, locals: Nil, origins: oinit_origins(ps), osigs: ot.osigs, otypes: ot.otypes} in let rb = ochke(body, ctx, Nil) in ochk_ret_origin(nm, sg.pubf, sg.fromp, rty, ps, rb.origin)

fn ochkstmts(prog, ot, moved) = match prog
    Nil        => 1
    Cons(h, t) => ochkstmt1(h, t, ot, moved)

fn ochkstmt1(st, rest, ot, moved) = match st
    VLawDecl(nm, ps, body) => let zl = vchk_law(nm, ps, body, ot.fns) in ochkstmts(rest, ot, moved)
    Fn(nm, ps, body)       => let z = ochkfn(nm, ps, body, ot) in ochkstmts(rest, ot, moved)
    Print(v)               => let zv = vchk_expr_e(v, "<main>", ot) in let zs = schk_conc_e(v, "<main>", 0, Nil, Nil) in let zp = achk_prov_e(v, "<main>", Nil, ot) in let ctx = {fnm: "<main>", pubf: 0, freef: 0, halloc: 0, bparams: Nil, mvars: Nil, pnames: Nil, locals: Nil, origins: Nil, osigs: ot.osigs, otypes: ot.otypes} in let r = ochke(v, ctx, moved) in ochkstmts(rest, ot, r.moved)
    ExprS(v)               => let zv = vchk_expr_e(v, "<main>", ot) in let zs = schk_conc_e(v, "<main>", 0, Nil, Nil) in let zp = achk_prov_e(v, "<main>", Nil, ot) in let ctx = {fnm: "<main>", pubf: 0, freef: 0, halloc: 0, bparams: Nil, mvars: Nil, pnames: Nil, locals: Nil, origins: Nil, osigs: ot.osigs, otypes: ot.otypes} in let r = ochke(v, ctx, moved) in ochkstmts(rest, ot, r.moved)
    _                      => ochkstmts(rest, ot, moved)

## --- lower Track O, Track A, Track K, Track S & Track V surface AST nodes into canonical Lume-Core (`LetIn`/`If`) ---
fn ois_intrinsic(nm, ufns) = if (nm == "borrow" or nm == "borrow_mut" or nm == "move" or nm == "evolve_approve" or nm == "old") and omem(nm, ufns) == 0 then 1 else 0

fn ois_verify_call(nm, ufns) = if (nm == "verify" or nm == "law_check") and omem(nm, ufns) == 0 then 1 else 0

fn olower_verify(args, lctx, d) = if len(args) == 1 then olowere(ohd_e(args), lctx, d) else if len(args) >= 2 then let val_e = ohd_e(args) in let cond_e = ohd_e(ptl(args)) in let vn = "_v_val_" + str(d) in LetIn(vn, olowere(val_e, lctx, d + 1), If(olowere(cond_e, lctx, d + 2), Var(vn), Call("ctfail", Cons(Str("lume: runtime verification failed for unverified value\n"), Nil)))) else Num(0)

fn ois_str_expr(e) = match e
    Str(s) => 1
    _      => 0

fn khop_lookup(nm, hops) = match hops
    Nil        => Nil
    Cons(h, t) => if h.op == nm then Cons(h, Nil) else khop_lookup(nm, t)

fn ksubst_lookup(nm, renv) = match renv
    Nil        => nm
    Cons(h, t) => if h.k == nm then h.v else ksubst_lookup(nm, t)

fn kmk_renv(ps, pfx) = match ps
    Nil        => Nil
    Cons(p, r) => Cons({k: p, v: pfx + p}, kmk_renv(r, pfx))

fn kmk_rps(ps, pfx) = match ps
    Nil        => Nil
    Cons(p, r) => Cons(pfx + p, kmk_rps(r, pfx))

fn ksubst_e(e, renv, pfx) = match e
    Var(nm)                 => Var(ksubst_lookup(nm, renv))
    LetIn(nm, v, b)         => let nnm = pfx + nm in LetIn(nnm, ksubst_e(v, renv, pfx), ksubst_e(b, Cons({k: nm, v: nnm}, renv), pfx))
    VarIn(nm, v, b)         => let nnm = pfx + nm in LetIn(nnm, ksubst_e(v, renv, pfx), ksubst_e(b, Cons({k: nm, v: nnm}, renv), pfx))
    OwnE(inner)             => OwnE(ksubst_e(inner, renv, pfx))
    MutE(inner)             => MutE(ksubst_e(inner, renv, pfx))
    DeferE(c, b)            => DeferE(ksubst_e(c, renv, pfx), ksubst_e(b, renv, pfx))
    ErrDeferE(c, b)         => ErrDeferE(ksubst_e(c, renv, pfx), ksubst_e(b, renv, pfx))
    WithAllocE(a, b)        => WithAllocE(ksubst_e(a, renv, pfx), ksubst_e(b, renv, pfx))
    WithHandlerE(en, hs, b) => WithHandlerE(en, hs, ksubst_e(b, renv, pfx))
    ScopeE(snm, b)          => ScopeE(snm, ksubst_e(b, renv, pfx))
    SpawnE(inner)           => SpawnE(ksubst_e(inner, renv, pfx))
    If(c, t, e2)            => If(ksubst_e(c, renv, pfx), ksubst_e(t, renv, pfx), ksubst_e(e2, renv, pfx))
    Bin(op, l, r)           => Bin(op, ksubst_e(l, renv, pfx), ksubst_e(r, renv, pfx))
    Call(cnm, args)         => Call(cnm, ksubst_args(args, renv, pfx))
    Field(o, fld)           => Field(ksubst_e(o, renv, pfx), fld)
    Rec(items)              => Rec(ksubst_rec(items, renv, pfx))
    RecT(tn, items)         => RecT(tn, ksubst_rec(items, renv, pfx))
    Match(sc, arms)         => Match(ksubst_e(sc, renv, pfx), ksubst_arms(arms, renv, pfx))
    CT(inner)               => CT(ksubst_e(inner, renv, pfx))
    _                       => e

fn ksubst_args(xs, renv, pfx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(ksubst_e(h, renv, pfx), ksubst_args(t, renv, pfx))

fn ksubst_rec(xs, renv, pfx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: ksubst_e(h.val, renv, pfx)}, ksubst_rec(t, renv, pfx))

fn ksubst_arms(xs, renv, pfx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: ksubst_e(h.body, renv, pfx)}, ksubst_arms(t, renv, pfx))

fn kuses_hop(e, hops, fns, d) = if d > 6 then 0 else kuses_hop1(e, hops, fns, d)

fn kuses_hop1(e, hops, fns, d) = match e
    Call(cnm, args)         => if isnil(khop_lookup(cnm, hops)) == 0 then 1 else if kuses_hop_args(args, hops, fns, d) == 1 then 1 else kuses_hop_fn(vfnlookup(cnm, fns), hops, fns, d)
    Bin(op, l, r)           => if kuses_hop(l, hops, fns, d) == 1 then 1 else kuses_hop(r, hops, fns, d)
    If(c, t, e2)            => if kuses_hop(c, hops, fns, d) == 1 then 1 else if kuses_hop(t, hops, fns, d) == 1 then 1 else kuses_hop(e2, hops, fns, d)
    LetIn(nm, v, b)         => if kuses_hop(v, hops, fns, d) == 1 then 1 else kuses_hop(b, hops, fns, d)
    VarIn(nm, v, b)         => if kuses_hop(v, hops, fns, d) == 1 then 1 else kuses_hop(b, hops, fns, d)
    OwnE(inner)             => kuses_hop(inner, hops, fns, d)
    MutE(inner)             => kuses_hop(inner, hops, fns, d)
    DeferE(c, b)            => if kuses_hop(c, hops, fns, d) == 1 then 1 else kuses_hop(b, hops, fns, d)
    ErrDeferE(c, b)         => if kuses_hop(c, hops, fns, d) == 1 then 1 else kuses_hop(b, hops, fns, d)
    WithAllocE(a, b)        => if kuses_hop(a, hops, fns, d) == 1 then 1 else kuses_hop(b, hops, fns, d)
    WithHandlerE(en, hs, b) => kuses_hop(b, hops, fns, d)
    ScopeE(snm, b)          => kuses_hop(b, hops, fns, d)
    SpawnE(inner)           => kuses_hop(inner, hops, fns, d)
    Field(o, fld)           => kuses_hop(o, hops, fns, d)
    Rec(items)              => kuses_hop_rec(items, hops, fns, d)
    RecT(tn, items)         => kuses_hop_rec(items, hops, fns, d)
    Match(sc, arms)         => if kuses_hop(sc, hops, fns, d) == 1 then 1 else kuses_hop_arms(arms, hops, fns, d)
    _                       => 0

fn kuses_hop_fn(mf, hops, fns, d) = match mf
    Nil        => 0
    Cons(f, r) => kuses_hop(f.body, hops, fns, d + 1)

fn kuses_hop_args(xs, hops, fns, d) = match xs
    Nil        => 0
    Cons(h, t) => if kuses_hop(h, hops, fns, d) == 1 then 1 else kuses_hop_args(t, hops, fns, d)

fn kuses_hop_rec(xs, hops, fns, d) = match xs
    Nil        => 0
    Cons(h, t) => if kuses_hop(h.val, hops, fns, d) == 1 then 1 else kuses_hop_rec(t, hops, fns, d)

fn kuses_hop_arms(xs, hops, fns, d) = match xs
    Nil        => 0
    Cons(h, t) => if kuses_hop(h.body, hops, fns, d) == 1 then 1 else kuses_hop_arms(t, hops, fns, d)

fn kbind_hop_args(ps, args, body, pfx, lctx, d) = kbind_hop_r(kmk_rps(ps, pfx), args, ksubst_e(body, kmk_renv(ps, pfx), pfx), lctx, d)

fn kbind_hop_r(rps, args, sbody, lctx, d) = match rps
    Nil         => olowere(sbody, lctx, d + 1)
    Cons(np, r) => kbind_hop_arg1(np, r, args, sbody, lctx, d)

fn kbind_hop_arg1(np, r, args, sbody, lctx, d) = match args
    Nil         => LetIn(np, Num(0), kbind_hop_r(r, Nil, sbody, lctx, d + 1))
    Cons(a, ar) => LetIn(np, olowere(a, lctx, d), kbind_hop_r(r, ar, sbody, lctx, d + 1))

fn ktry_perceus_arm(sc_v, pat, body, lctx, d) = match pat
    PCons(ptag, psubs) => let ar = len(psubs) in if ar == 1 or ar == 2 then ktry_perceus_body(sc_v, ptag, ar, body, lctx, d) else olowere(body, lctx, d)
    _                  => olowere(body, lctx, d)

fn ktry_perceus_body(sc_v, ptag, ar, body, lctx, d) = match body
    Call(ctag, cargs) => if ctag == ptag and len(cargs) == ar and omentions_args(sc_v, cargs) == 0 then Call("__perceus_reuse_" + str(ar), Cons(Var(sc_v), olowerargs(cargs, lctx, d))) else olowere(body, lctx, d)
    LetIn(nm, v, b)   => if nm == sc_v or omentions_var(sc_v, v) == 1 then olowere(body, lctx, d) else LetIn(nm, olowere(v, lctx, d), ktry_perceus_body(sc_v, ptag, ar, b, lctx, d + 1))
    _                 => olowere(body, lctx, d)

fn ksc_own_var(sc, ownps) = match sc
    Var(x) => if omem(x, ownps) == 1 then x else ""
    _      => ""

fn olowere(e, lctx, d) = match e
    Var(nm)                 => if ais_hole_name(nm) == 1 then Num(0) else Var(nm)
    VarIn(nm, v, b)         => LetIn(nm, olowere(v, lctx, d + 1), olowere(b, lctx, d + 17))
    OwnE(inner)             => olowere(inner, lctx, d)
    MutE(inner)             => olowere(inner, lctx, d)
    DeferE(c, b)            => let vn = "_d_val_" + str(d) in let rn = "_d_run_" + str(d) in LetIn(vn, olowere(b, lctx, d + 1), LetIn(rn, olowere(c, lctx, d + 2), Var(vn)))
    ErrDeferE(c, b)         => let vn = "_ed_val_" + str(d) in let rn = "_ed_run_" + str(d) in LetIn(vn, olowere(b, lctx, d + 1), If(Bin("<", Var(vn), Num(0)), LetIn(rn, olowere(c, lctx, d + 2), Var(vn)), Var(vn)))
    WithAllocE(a, b)        => LetIn("_alloc_ctx_" + str(d), olowere(a, lctx, d + 1), olowere(b, lctx, d + 2))
    WithHandlerE(en, hs, b) => olowere(b, {ufns: lctx.ufns, hops: app(hs, lctx.hops), ownps: lctx.ownps, fns: lctx.fns}, d + 1)
    ScopeE(snm, b)          => LetIn(snm, Num(1), olowere(b, lctx, d + 1))
    SpawnE(inner)           => olowere(inner, lctx, d + 1)
    AwaitE(inner)           => Call("__lume_rc_get", Cons(olowere(inner, lctx, d + 1), Nil))
    ShardE(vnm, lo, hi, b)  => let v_lo = "_sh_lo_" + str(d) in let v_hi = "_sh_hi_" + str(d) in LetIn(v_lo, olowere(lo, lctx, d + 1), LetIn(v_hi, olowere(hi, lctx, d + 2), Bin("+", LetIn(vnm, Var(v_lo), olowere(b, lctx, d + 3)), LetIn(vnm, Var(v_hi), olowere(b, lctx, d + 4)))))
    LetIn(nm, v, b)         => let gfn = n4_is_grad_let(v) in if gfn != "" then olowere(n4_subst_call(b, nm, n4_grad_fn_name(gfn, lctx.ufns)), {ufns: lctx.ufns, hops: lctx.hops, ownps: orem(nm, lctx.ownps), fns: lctx.fns}, d + 17) else LetIn(nm, olowere(v, lctx, d + 1), olowere(b, {ufns: lctx.ufns, hops: lctx.hops, ownps: orem(nm, lctx.ownps), fns: lctx.fns}, d + 17))
    If(c, t, e2)            => If(olowere(c, lctx, d + 1), olowere(t, lctx, d + 17), olowere(e2, lctx, d + 33))
    Bin(op, l, r)           => olowerbin(op, l, r, lctx, d)
    Call(nm, args)          => olowercall(nm, args, khop_lookup(nm, lctx.hops), lctx, d)
    Field(o, fld)           => Field(olowere(o, lctx, d), fld)
    Rec(items)              => Rec(olowerrec(items, lctx, d))
    RecT(tn, items)         => RecT(tn, olowerrec(items, lctx, d))
    Match(sc, arms)         => Match(olowere(sc, lctx, d), olowerarms(arms, ksc_own_var(sc, lctx.ownps), lctx, d + 1))
    CT(inner)               => CT(olowere(inner, lctx, d))
    _                       => e

fn n4_jlookup(nm, jenv) = match jenv
    Nil        => Var(nm)
    Cons(h, t) => if h.k == nm then h.v else n4_jlookup(nm, t)

fn n4_is_num_e(e) = match e
    Num(n) => 1
    _      => 0

fn n4_num_val(e) = match e
    Num(n) => n
    _      => 0

fn n4_jit_bin(op, l, r) = if n4_is_num_e(l) == 1 and n4_is_num_e(r) == 1 then (let rv = veval_bin(op, vv_int(n4_num_val(l)), vv_int(n4_num_val(r))) in if rv.ok == 1 then Num(rv.i) else Bin(op, l, r)) else if op == "+" and n4_is_num_e(l) == 1 and n4_num_val(l) == 0 then r else if (op == "+" or op == "-") and n4_is_num_e(r) == 1 and n4_num_val(r) == 0 then l else if op == "*" and n4_is_num_e(l) == 1 and n4_num_val(l) == 1 then r else if op == "*" and n4_is_num_e(r) == 1 and n4_num_val(r) == 1 then l else if op == "*" and ((n4_is_num_e(l) == 1 and n4_num_val(l) == 0) or (n4_is_num_e(r) == 1 and n4_num_val(r) == 0)) then Num(0) else Bin(op, l, r)

fn n4_jit_spec(e, jenv) = match e
    Num(n)          => Num(n)
    Str(s)          => Str(s)
    Var(nm)         => n4_jlookup(nm, jenv)
    OwnE(inner)     => n4_jit_spec(inner, jenv)
    MutE(inner)     => n4_jit_spec(inner, jenv)
    Bin(op, l, r)   => n4_jit_bin(op, n4_jit_spec(l, jenv), n4_jit_spec(r, jenv))
    If(c, t, e2)    => let sc = n4_jit_spec(c, jenv) in if n4_is_num_e(sc) == 1 then (if n4_num_val(sc) != 0 then n4_jit_spec(t, jenv) else n4_jit_spec(e2, jenv)) else If(sc, n4_jit_spec(t, jenv), n4_jit_spec(e2, jenv))
    LetIn(nm, v, b) => let sv = n4_jit_spec(v, jenv) in if n4_is_num_e(sv) == 1 then n4_jit_spec(b, Cons({k: nm, v: sv}, jenv)) else LetIn(nm, sv, n4_jit_spec(b, Cons({k: nm, v: Var(nm)}, jenv)))
    VarIn(nm, v, b) => let sv = n4_jit_spec(v, jenv) in if n4_is_num_e(sv) == 1 then n4_jit_spec(b, Cons({k: nm, v: sv}, jenv)) else LetIn(nm, sv, n4_jit_spec(b, Cons({k: nm, v: Var(nm)}, jenv)))
    _               => e

fn n4_jit_bind(ps, largs, body, jenv, pfx) = match ps
    Nil        => n4_jit_spec(body, jenv)
    Cons(p, r) => n4_jit_bind1(p, r, largs, body, jenv, pfx)

fn n4_jit_bind1(p, r, largs, body, jenv, pfx) = match largs
    Nil         => n4_jit_bind(r, Nil, body, Cons({k: p, v: Num(0)}, jenv), pfx)
    Cons(a, ar) => let sa = n4_jit_spec(a, Nil) in if n4_is_num_e(sa) == 1 then n4_jit_bind(r, ar, body, Cons({k: p, v: sa}, jenv), pfx) else let np = pfx + p in LetIn(np, sa, n4_jit_bind(r, ar, body, Cons({k: p, v: Var(np)}, jenv), pfx))

fn n4_lower_jit_call(fnm, largs, mf, d) = match mf
    Nil        => Call(fnm, largs)
    Cons(f, r) => if afn_calls_self(fnm, f.body) == 1 then Call(fnm, largs) else n4_jit_bind(f.ps, largs, f.body, Nil, "_jit_" + str(d) + "_")

fn olower_shard_call(fe, a, b, lctx, d) = let la = olowere(a, lctx, d + 1) in let lb = olowere(b, lctx, d + 2) in let fnm = n4_var_name(fe) in let c1 = if fnm != "" and omem(fnm, lctx.ufns) == 1 then Call(fnm, Cons(la, Nil)) else Call("__closure_call_1", Cons(olowere(fe, lctx, d), Cons(la, Nil))) in let c2 = if fnm != "" and omem(fnm, lctx.ufns) == 1 then Call(fnm, Cons(lb, Nil)) else Call("__closure_call_1", Cons(olowere(fe, lctx, d), Cons(lb, Nil))) in let v1 = "_sh_a_" + str(d) in let v2 = "_sh_b_" + str(d) in LetIn(v1, c1, LetIn(v2, c2, Rec(Cons({key: "fst", val: Var(v1)}, Cons({key: "snd", val: Var(v2)}, Cons({key: "sum", val: Bin("+", Var(v1), Var(v2))}, Nil))))))

fn n4_lower_ad_call(nm, args, lctx, d) = if nm == "grad" and len(args) >= 2 then Call(n4_grad_fn_name(n4_var_name(ohd_e(args)), lctx.ufns), olowerargs(ptl(args), lctx, d)) else if nm == "value_and_grad" and len(args) >= 2 then (let fnm = n4_var_name(ohd_e(args)) in let largs = olowerargs(ptl(args), lctx, d) in Rec(Cons({key: "val", val: Call(fnm, largs)}, Cons({key: "grad", val: Call(n4_grad_fn_name(fnm, lctx.ufns), largs)}, Nil)))) else if nm == "jvp" and len(args) == 3 then Bin("*", Call(n4_grad_fn_name(n4_var_name(ohd_e(args)), lctx.ufns), Cons(olowere(ohd_e(ptl(args)), lctx, d), Nil)), olowere(ohd_e(ptl(ptl(args))), lctx, d + 1)) else if nm == "vjp" and len(args) == 3 then Bin("*", olowere(ohd_e(ptl(ptl(args))), lctx, d + 1), Call(n4_grad_fn_name(n4_var_name(ohd_e(args)), lctx.ufns), Cons(olowere(ohd_e(ptl(args)), lctx, d), Nil))) else if nm == "jit" and len(args) >= 2 then (let fnm = n4_var_name(ohd_e(args)) in let largs = olowerargs(ptl(args), lctx, d) in n4_lower_jit_call(fnm, largs, vfnlookup(fnm, lctx.fns), d)) else Call(nm, olowerargs(args, lctx, d))

fn olower_tier_conc_nm(nm, ar) = if (nm == "rc" or nm == "rc_new") and ar == 1 then "__lume_rc_new" else if (nm == "arc" or nm == "arc_new") and ar == 1 then "__lume_arc_new" else if (nm == "clone" or nm == "rc_clone" or nm == "arc_clone") and ar == 1 then "__lume_rc_clone" else if (nm == "drop" or nm == "rc_drop" or nm == "arc_drop") and ar == 1 then "__lume_rc_drop" else if (nm == "get" or nm == "rc_get" or nm == "arc_get" or nm == "promise_await" or nm == "signal_get" or nm == "block_on") and ar == 1 then "__lume_rc_get" else if (nm == "strong_count" or nm == "rc_strong_count" or nm == "arc_strong_count") and ar == 1 then "__lume_rc_strong_count" else if (nm == "downgrade" or nm == "weak_downgrade") and ar == 1 then "__lume_weak_downgrade" else if (nm == "upgrade" or nm == "weak_upgrade") and ar == 2 then "__lume_weak_upgrade" else if (nm == "promise" or nm == "promise_new") and ar == 1 then "__lume_promise_new" else if (nm == "resolve" or nm == "promise_resolve") and ar == 2 then "__lume_promise_resolve" else if (nm == "signal" or nm == "signal_new") and ar == 1 then "__lume_signal_new" else if (nm == "set" or nm == "signal_set") and ar == 2 then "__lume_signal_set" else if (nm == "version" or nm == "signal_version") and ar == 1 then "__lume_signal_version" else ""

fn olowercall(nm, args, mhop, lctx, d) = match mhop
    Cons(hop, r) => kbind_hop_args(hop.ps, args, hop.body, "_khop_" + str(d) + "_" + hop.op + "_", lctx, d)
    Nil          => let tnm = if omem(nm, lctx.ufns) == 0 then olower_tier_conc_nm(nm, len(args)) else "" in if ois_intrinsic(nm, lctx.ufns) == 1 and len(args) == 1 then olowere(ohd_e(args), lctx, d) else if tnm != "" then Call(tnm, olowerargs(args, lctx, d)) else if (nm == "shard" or nm == "vmap") and len(args) == 3 and omem(nm, lctx.ufns) == 0 then olower_shard_call(ohd_e(args), ohd_e(ptl(args)), ohd_e(ptl(ptl(args))), lctx, d) else if ois_verify_call(nm, lctx.ufns) == 1 then olower_verify(args, lctx, d) else if (nm == "grad" or nm == "value_and_grad" or nm == "jvp" or nm == "vjp" or nm == "jit") and omem(nm, lctx.ufns) == 0 then n4_lower_ad_call(nm, args, lctx, d) else if isnil(lctx.hops) == 0 and d < 200 then olowercall_fn(nm, args, vfnlookup(nm, lctx.fns), lctx, d) else Call(nm, olowerargs(args, lctx, d))

fn olowercall_fn(nm, args, mf, lctx, d) = match mf
    Nil        => Call(nm, olowerargs(args, lctx, d))
    Cons(f, r) => if kuses_hop(f.body, lctx.hops, lctx.fns, 0) == 1 then kbind_hop_args(f.ps, args, f.body, "_khfn_" + str(d) + "_" + nm + "_", lctx, d) else Call(nm, olowerargs(args, lctx, d))

fn olowerbin(op, l, r, lctx, d) = if op == "+" and ois_str_expr(l) == 1 and ois_hole_expr(r) == 1 then Bin(op, olowere(l, lctx, d + 1), Str("")) else if op == "+" and ois_hole_expr(l) == 1 and ois_str_expr(r) == 1 then Bin(op, Str(""), olowere(r, lctx, d + 17)) else Bin(op, olowere(l, lctx, d + 1), olowere(r, lctx, d + 17))

fn ois_hole_expr(e) = match e
    Var(nm) => ais_hole_name(nm)
    _       => 0

fn olowerargs(xs, lctx, d) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(olowere(h, lctx, d + 1), olowerargs(t, lctx, d + 17))

fn olowerrec(xs, lctx, d) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: olowere(h.val, lctx, d + 1)}, olowerrec(t, lctx, d + 17))

fn olowerarms(xs, sc_v, lctx, d) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: if sc_v != "" then ktry_perceus_arm(sc_v, h.pat, h.body, lctx, d + 1) else olowere(h.body, lctx, d + 1)}, olowerarms(t, sc_v, lctx, d + 17))

fn kfn_ownps(nm, osigs) = match osiglookup(nm, osigs)
    Nil          => Nil
    Cons(osg, r) => kownps_pl(osg.pl)

fn kownps_pl(pl) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 2 then Cons(p.pn, kownps_pl(r)) else kownps_pl(r)

fn vconj_conds(cs, lctx, d) = match cs
    Nil        => Num(1)
    Cons(c, r) => if isnil(r) == 1 then olowere(c, lctx, d) else Bin("and", olowere(c, lctx, d), vconj_conds(r, lctx, d + 1))

fn vwrap_fn_contract(nm, ps, raw_body, low_body, lctx, vctx) = vwrap_fn_c1(nm, ps, raw_body, low_body, lctx, vsiglookup(nm, vctx.vsigs))

fn vwrap_fn_c1(nm, ps, raw_body, low_body, lctx, mvs) = match mvs
    Nil          => low_body
    Cons(vsg, r) => if vqflia_prove_fn(ps, vsg.reqs, vsg.enss, raw_body, lctx.fns) == 1 then low_body else let post = if isnil(vsg.enss) == 1 then low_body else LetIn("result", low_body, LetIn("ret", Var("result"), LetIn("_vens_ok", If(vconj_conds(vsg.enss, lctx, 100), Num(1), Call("ctfail", Cons(Str("lume: runtime contract violation (ensures) in '" + nm + "'\n"), Nil))), Var("result")))) in if isnil(vsg.reqs) == 1 then post else LetIn("_vreq_ok", If(vconj_conds(vsg.reqs, lctx, 200), Num(1), Call("ctfail", Cons(Str("lume: runtime contract violation (requires) in '" + nm + "'\n"), Nil))), post)

fn klower_eff_ops(ops, ufns, rest) = match ops
    Nil         => rest
    Cons(op, r) => if omem(op.op, ufns) == 1 then klower_eff_ops(r, ufns, rest) else Cons(Fn(op.op, op.ps, Num(0)), klower_eff_ops(r, Cons(op.op, ufns), rest))

fn ois_async_fn(nm, osigs) = match osiglookup(nm, osigs)
    Nil          => 0
    Cons(osg, r) => ois_async(osg.freef)

fn owrap_async_body(nm, wb, osigs) = if ois_async_fn(nm, osigs) == 1 then Call("__lume_promise_new", Cons(wb, Nil)) else wb

fn olowerprog(prog, ufns, osigs, vctx) = match prog
    Nil        => Nil
    Cons(h, t) => olowerstmt(h, olowerprog(t, ufns, osigs, vctx), ufns, osigs, vctx)

fn olowerstmt(st, rest, ufns, osigs, vctx) = match st
    OSig(nm, pubf, freef, pl, rty, fromp) => if ois_ffi(freef) == 1 or ois_free(freef) == 1 or ois_interrupt(freef) == 1 then Cons(st, rest) else rest
    OType(nm, k)                          => rest
    KEffSig(nm, effs)                     => rest
    KEffectDecl(enm, ops)                 => klower_eff_ops(ops, ufns, rest)
    KCapGrant(effs)                       => rest
    VContractSig(nm, ps, reqs, enss)      => rest
    VTypeInvariant(nm, fs, inv)           => rest
    VLawDecl(nm, ps, body)                => rest
    WcetSig(nm, bound)                    => rest
    TypeRefineS(nm, bty, pr)              => Cons(st, rest)
    TraitDecl(tnm, ops)                   => Cons(st, rest)
    ImplDecl(tnm, tty, mths)              => rest
    Fn(nm, ps, body)                      => let lctx = {ufns: ufns, hops: Nil, ownps: kfn_ownps(nm, osigs), fns: vctx.fns} in let lb = if oanye(body) == 0 and isnil(lctx.ownps) == 1 then body else olowere(body, lctx, 0) in let wb = vwrap_fn_contract(nm, ps, body, lb, lctx, vctx) in Cons(Fn(nm, ps, owrap_async_body(nm, wb, osigs)), rest)
    Print(v)                              => Cons(Print(olowere(v, {ufns: ufns, hops: Nil, ownps: Nil, fns: vctx.fns}, 0)), rest)
    ExprS(v)                              => Cons(ExprS(olowere(v, {ufns: ufns, hops: Nil, ownps: Nil, fns: vctx.fns}, 0)), rest)
    _                                     => Cons(st, rest)

## ============================================================================================================
## Issue #197: Trait / Impl Checking (`[T0400]`, `[T0401]`) & Static Method Dispatch Lowering
## ============================================================================================================
fn t4_collect_traits(prog) = match prog
    Nil        => Nil
    Cons(h, t) => t4_collect_trait1(h, t4_collect_traits(t))

fn t4_collect_trait1(st, rest) = match st
    TraitDecl(tnm, ops) => Cons({tnm: tnm, ops: ops}, rest)
    _                   => rest

fn t4_collect_impls(prog) = match prog
    Nil        => Nil
    Cons(h, t) => t4_collect_impl1(h, t4_collect_impls(t))

fn t4_collect_impl1(st, rest) = match st
    ImplDecl(tnm, tty, mths) => Cons({tnm: tnm, tty: tty, mths: mths}, rest)
    _                        => rest

fn t4_trait_lookup(tnm, traits) = match traits
    Nil        => Nil
    Cons(h, t) => if h.tnm == tnm then Cons(h, Nil) else t4_trait_lookup(tnm, t)

fn t4_has_mth(opnm, ar, mths) = match mths
    Nil        => 0
    Cons(m, r) => if m.op == opnm and m.ar == ar then 1 else t4_has_mth(opnm, ar, r)

fn t4_chk_impl_ops(tnm, tty, ops, mths) = match ops
    Nil         => 1
    Cons(op, r) => if t4_has_mth(op.op, len(op.ps), mths) == 0 then ctfail("lume: trait error [T0400]: 'impl " + tnm + " for " + tty + "' is missing required trait method '" + op.op + "' (fix-it: implement 'fn " + op.op + "(...)' in 'impl " + tnm + " for " + tty + "')\n") else t4_chk_impl_ops(tnm, tty, r, mths)

fn t4_chk_impl1(im, traits) = match t4_trait_lookup(im.tnm, traits)
    Nil         => ctfail("lume: trait error [T0400]: cannot implement undeclared trait '" + im.tnm + "' for '" + im.tty + "'\n")
    Cons(tr, r) => t4_chk_impl_ops(im.tnm, im.tty, tr.ops, im.mths)

fn t4_chk_impls(impls, traits) = match impls
    Nil         => 1
    Cons(im, r) => t4_chk_impl1(im, traits) + t4_chk_impls(r, traits)

fn t4_has_op(opnm, ops) = match ops
    Nil         => 0
    Cons(op, r) => if op.op == opnm then 1 else t4_has_op(opnm, r)

fn t4_find_trait_op(opnm, traits) = match traits
    Nil         => ""
    Cons(tr, r) => if t4_has_op(opnm, tr.ops) == 1 then tr.tnm else t4_find_trait_op(opnm, r)

fn t4_has_impl(tnm, tty, impls) = match impls
    Nil         => 0
    Cons(im, r) => if im.tnm == tnm and im.tty == tty then 1 else t4_has_impl(tnm, tty, r)

fn t4_ty_name(ty) = match ty
    TyName(n)         => n
    TyRefine(bty, pr) => t4_ty_name(bty)
    TyApply(kn, sub)  => if kn == "rc" or kn == "arc" or kn == "weak" or kn == "promise" or kn == "signal" then t4_ty_name(sub) else ""
    _                 => ""

fn t4_env_lookup(nm, tenv) = match tenv
    Nil        => ""
    Cons(h, t) => if h.k == nm then h.v else t4_env_lookup(nm, t)

fn t4_init_tenv_ps(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, r) => let tnm = t4_ty_name(ohd_ty(pts)) in if tnm != "" then Cons({k: pn, v: tnm}, t4_init_tenv_ps(r, ptl(pts))) else t4_init_tenv_ps(r, ptl(pts))

fn t4_init_tenv_sig(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => t4_init_tenv_ps(sg.pn, sg.pt)

fn t4_expr_tyname(e, tenv, tctx) = match e
    Num(n)          => "int"
    Str(s)          => "str"
    Var(nm)         => let lt = t4_env_lookup(nm, tenv) in if lt != "" then lt else t4_ctor_tyname(nm, tctx.ctors)
    RecT(tn, items) => tn
    AwaitE(inner)   => t4_expr_tyname(inner, tenv, tctx)
    Call(cnm, args) => if (cnm == "rc" or cnm == "arc" or cnm == "rc_new" or cnm == "arc_new" or cnm == "clone" or cnm == "rc_clone" or cnm == "arc_clone" or cnm == "get" or cnm == "rc_get" or cnm == "arc_get" or cnm == "downgrade" or cnm == "weak_downgrade" or cnm == "promise" or cnm == "promise_new" or cnm == "promise_await" or cnm == "signal" or cnm == "signal_new" or cnm == "signal_get") and len(args) == 1 then t4_expr_tyname(ohd_e(args), tenv, tctx) else if (cnm == "upgrade" or cnm == "weak_upgrade") and len(args) == 2 then (let t0 = t4_expr_tyname(ohd_e(args), tenv, tctx) in if t0 != "" then t0 else t4_expr_tyname(ohd_e(ptl(args)), tenv, tctx)) else let ct = t4_ctor_tyname(cnm, tctx.ctors) in if ct != "" then ct else t4_sig_ret_tyname(tsiglookup(cnm, tctx.sigs))
    _               => ""

fn t4_ctor_tyname(nm, ctors) = if isctor(nm) == 0 then "" else t4_ctor_tyname2(tctorlookup(nm, ctors))

fn t4_ctor_tyname2(m) = match m
    Nil        => ""
    Cons(v, r) => v.en

fn t4_sig_ret_tyname(msig) = match msig
    Nil        => ""
    Cons(sg, r) => t4_ty_name(sg.rt)

fn t4_resolve_args(xs, tenv, tctx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(t4_resolve_e(h, tenv, tctx), t4_resolve_args(t, tenv, tctx))

fn t4_resolve_rec(xs, tenv, tctx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: t4_resolve_e(h.val, tenv, tctx)}, t4_resolve_rec(t, tenv, tctx))

fn t4_resolve_arms(xs, tenv, tctx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: t4_resolve_e(h.body, tenv, tctx)}, t4_resolve_arms(t, tenv, tctx))

fn t4_resolve_call(cnm, args, tenv, tctx) = let rargs = t4_resolve_args(args, tenv, tctx) in let tnm = t4_find_trait_op(cnm, tctx.traits) in if tnm == "" or isnil(rargs) == 1 then Call(cnm, rargs) else let rty = t4_expr_tyname(ohd_e(args), tenv, tctx) in if rty == "" then Call(cnm, rargs) else if t4_has_impl(tnm, rty, tctx.impls) == 0 then ctfail("lume: trait error [T0401]: type '" + rty + "' does not implement trait '" + tnm + "' required by method '" + cnm + "' (fix-it: add 'impl " + tnm + " for " + rty + " { fn " + cnm + "(...) = ... }')\n") else Call("__impl_" + rty + "_" + cnm, rargs)

fn t4_resolve_e(e, tenv, tctx) = match e
    Bin(op, l, r)              => Bin(op, t4_resolve_e(l, tenv, tctx), t4_resolve_e(r, tenv, tctx))
    If(c, t, e2)               => If(t4_resolve_e(c, tenv, tctx), t4_resolve_e(t, tenv, tctx), t4_resolve_e(e2, tenv, tctx))
    LetIn(nm, v, b)            => let rv = t4_resolve_e(v, tenv, tctx) in let vt = t4_expr_tyname(v, tenv, tctx) in let tenv2 = if vt != "" then Cons({k: nm, v: vt}, tenv) else tenv in LetIn(nm, rv, t4_resolve_e(b, tenv2, tctx))
    VarIn(nm, v, b)            => let rv = t4_resolve_e(v, tenv, tctx) in let vt = t4_expr_tyname(v, tenv, tctx) in let tenv2 = if vt != "" then Cons({k: nm, v: vt}, tenv) else tenv in VarIn(nm, rv, t4_resolve_e(b, tenv2, tctx))
    OwnE(inner)                => OwnE(t4_resolve_e(inner, tenv, tctx))
    MutE(inner)                => MutE(t4_resolve_e(inner, tenv, tctx))
    DeferE(c, b)               => DeferE(t4_resolve_e(c, tenv, tctx), t4_resolve_e(b, tenv, tctx))
    ErrDeferE(c, b)            => ErrDeferE(t4_resolve_e(c, tenv, tctx), t4_resolve_e(b, tenv, tctx))
    WithAllocE(a, b)           => WithAllocE(t4_resolve_e(a, tenv, tctx), t4_resolve_e(b, tenv, tctx))
    WithHandlerE(en, hs, b)    => WithHandlerE(en, hs, t4_resolve_e(b, tenv, tctx))
    ScopeE(snm, b)             => ScopeE(snm, t4_resolve_e(b, tenv, tctx))
    SpawnE(inner)              => SpawnE(t4_resolve_e(inner, tenv, tctx))
    AwaitE(inner)              => AwaitE(t4_resolve_e(inner, tenv, tctx))
    ShardE(vnm, lo, hi, b)     => ShardE(vnm, t4_resolve_e(lo, tenv, tctx), t4_resolve_e(hi, tenv, tctx), t4_resolve_e(b, Cons({k: vnm, v: "int"}, tenv), tctx))
    LambdaE(ps, tys, rt, body) => LambdaE(ps, tys, rt, t4_resolve_e(body, app(t4_init_tenv_ps(ps, tys), tenv), tctx))
    Call(cnm, args)            => t4_resolve_call(cnm, args, tenv, tctx)
    Field(o, fld)              => Field(t4_resolve_e(o, tenv, tctx), fld)
    Rec(items)                 => Rec(t4_resolve_rec(items, tenv, tctx))
    RecT(tn, items)            => RecT(tn, t4_resolve_rec(items, tenv, tctx))
    Match(sc, arms)            => Match(t4_resolve_e(sc, tenv, tctx), t4_resolve_arms(arms, tenv, tctx))
    CT(inner)                  => CT(t4_resolve_e(inner, tenv, tctx))
    _                          => e

fn t4_resolve_stmt(st, tctx) = match st
    Fn(nm, ps, body)                 => Fn(nm, ps, t4_resolve_e(body, t4_init_tenv_sig(tsiglookup(nm, tctx.sigs)), tctx))
    VContractSig(nm, ps, reqs, enss) => let tenv = t4_init_tenv_sig(tsiglookup(nm, tctx.sigs)) in VContractSig(nm, ps, t4_resolve_args(reqs, tenv, tctx), t4_resolve_args(enss, tenv, tctx))
    VLawDecl(nm, ps, body)           => VLawDecl(nm, ps, t4_resolve_e(body, Nil, tctx))
    Print(v)                         => Print(t4_resolve_e(v, Nil, tctx))
    ExprS(v)                         => ExprS(t4_resolve_e(v, Nil, tctx))
    _                                => st

fn t4_resolve_prog(prog, traits, impls, sigs, ctors) = t4_resolve_stmts(prog, {traits: traits, impls: impls, sigs: sigs, ctors: ctors})

fn t4_resolve_stmts(prog, tctx) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(t4_resolve_stmt(h, tctx), t4_resolve_stmts(t, tctx))

## ============================================================================================================
## Issue #197: First-Class Closures with Lexical Environment Capture (`cl_convert_prog`)
## ============================================================================================================
fn cl_has_lambda_e(e) = match e
    LambdaE(ps, tys, rt, body) => 1
    Bin(op, l, r)              => if cl_has_lambda_e(l) == 1 then 1 else cl_has_lambda_e(r)
    If(c, t, e2)               => if cl_has_lambda_e(c) == 1 then 1 else if cl_has_lambda_e(t) == 1 then 1 else cl_has_lambda_e(e2)
    LetIn(nm, v, b)            => if cl_has_lambda_e(v) == 1 then 1 else cl_has_lambda_e(b)
    VarIn(nm, v, b)            => if cl_has_lambda_e(v) == 1 then 1 else cl_has_lambda_e(b)
    OwnE(inner)                => cl_has_lambda_e(inner)
    MutE(inner)                => cl_has_lambda_e(inner)
    DeferE(c, b)               => if cl_has_lambda_e(c) == 1 then 1 else cl_has_lambda_e(b)
    ErrDeferE(c, b)            => if cl_has_lambda_e(c) == 1 then 1 else cl_has_lambda_e(b)
    WithAllocE(a, b)           => if cl_has_lambda_e(a) == 1 then 1 else cl_has_lambda_e(b)
    WithHandlerE(en, hs, b)    => cl_has_lambda_e(b)
    ScopeE(snm, b)             => cl_has_lambda_e(b)
    SpawnE(inner)              => cl_has_lambda_e(inner)
    AwaitE(inner)              => cl_has_lambda_e(inner)
    ShardE(vnm, lo, hi, b)     => if cl_has_lambda_e(lo) == 1 then 1 else if cl_has_lambda_e(hi) == 1 then 1 else cl_has_lambda_e(b)
    Call(cnm, args)            => if cnm == "_call" then 1 else cl_has_lambda_args(args)
    Field(o, fld)              => cl_has_lambda_e(o)
    Rec(items)                 => cl_has_lambda_rec(items)
    RecT(tn, items)            => cl_has_lambda_rec(items)
    Match(sc, arms)            => if cl_has_lambda_e(sc) == 1 then 1 else cl_has_lambda_arms(arms)
    _                          => 0

fn cl_has_lambda_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => if cl_has_lambda_e(h) == 1 then 1 else cl_has_lambda_args(t)

fn cl_has_lambda_rec(xs) = match xs
    Nil        => 0
    Cons(h, t) => if cl_has_lambda_e(h.val) == 1 then 1 else cl_has_lambda_rec(t)

fn cl_has_lambda_arms(xs) = match xs
    Nil        => 0
    Cons(h, t) => if cl_has_lambda_e(h.body) == 1 then 1 else cl_has_lambda_arms(t)

fn cl_has_lambda_prog(prog) = match prog
    Nil        => 0
    Cons(h, t) => if cl_has_lambda_stmt(h) == 1 then 1 else cl_has_lambda_prog(t)

fn cl_has_lambda_stmt(st) = match st
    Fn(nm, ps, body) => cl_has_lambda_e(body)
    Print(v)         => cl_has_lambda_e(v)
    ExprS(v)         => cl_has_lambda_e(v)
    _                => 0

fn cl_free_vars(e, bound, env_vars, acc) = match e
    Var(nm)                    => if omem(nm, bound) == 0 and omem(nm, env_vars) == 1 and omem(nm, acc) == 0 then Cons(nm, acc) else acc
    Bin(op, l, r)              => cl_free_vars(r, bound, env_vars, cl_free_vars(l, bound, env_vars, acc))
    If(c, t, e2)               => cl_free_vars(e2, bound, env_vars, cl_free_vars(t, bound, env_vars, cl_free_vars(c, bound, env_vars, acc)))
    LetIn(nm, v, b)            => cl_free_vars(b, Cons(nm, bound), env_vars, cl_free_vars(v, bound, env_vars, acc))
    VarIn(nm, v, b)            => cl_free_vars(b, Cons(nm, bound), env_vars, cl_free_vars(v, bound, env_vars, acc))
    LambdaE(ps, tys, rt, body) => cl_free_vars(body, app(ps, bound), env_vars, acc)
    OwnE(inner)                => cl_free_vars(inner, bound, env_vars, acc)
    MutE(inner)                => cl_free_vars(inner, bound, env_vars, acc)
    DeferE(c, b)               => cl_free_vars(b, bound, env_vars, cl_free_vars(c, bound, env_vars, acc))
    ErrDeferE(c, b)            => cl_free_vars(b, bound, env_vars, cl_free_vars(c, bound, env_vars, acc))
    WithAllocE(a, b)           => cl_free_vars(b, bound, env_vars, cl_free_vars(a, bound, env_vars, acc))
    ScopeE(snm, b)             => cl_free_vars(b, Cons(snm, bound), env_vars, acc)
    SpawnE(inner)              => cl_free_vars(inner, bound, env_vars, acc)
    AwaitE(inner)              => cl_free_vars(inner, bound, env_vars, acc)
    ShardE(vnm, lo, hi, b)     => cl_free_vars(b, Cons(vnm, bound), env_vars, cl_free_vars(hi, bound, env_vars, cl_free_vars(lo, bound, env_vars, acc)))
    Call(cnm, args)            => let acc0 = if omem(cnm, bound) == 0 and omem(cnm, env_vars) == 1 and omem(cnm, acc) == 0 then Cons(cnm, acc) else acc in cl_free_vars_args(args, bound, env_vars, acc0)
    Field(o, fld)              => cl_free_vars(o, bound, env_vars, acc)
    Rec(items)                 => cl_free_vars_rec(items, bound, env_vars, acc)
    RecT(tn, items)            => cl_free_vars_rec(items, bound, env_vars, acc)
    Match(sc, arms)            => cl_free_vars_arms(arms, bound, env_vars, cl_free_vars(sc, bound, env_vars, acc))
    _                          => acc

fn cl_free_vars_args(xs, bound, env_vars, acc) = match xs
    Nil        => acc
    Cons(h, t) => cl_free_vars_args(t, bound, env_vars, cl_free_vars(h, bound, env_vars, acc))

fn cl_free_vars_rec(xs, bound, env_vars, acc) = match xs
    Nil        => acc
    Cons(h, t) => cl_free_vars_rec(t, bound, env_vars, cl_free_vars(h.val, bound, env_vars, acc))

fn cl_free_vars_arms(xs, bound, env_vars, acc) = match xs
    Nil        => acc
    Cons(h, t) => cl_free_vars_arms(t, bound, env_vars, cl_free_vars(h.body, app(apat_binds(h.pat), bound), env_vars, acc))

fn cl_subst_caps(e, caps) = match e
    Var(nm)         => if omem(nm, caps) == 1 then Field(Var("__env"), nm) else e
    Bin(op, l, r)   => Bin(op, cl_subst_caps(l, caps), cl_subst_caps(r, caps))
    If(c, t, e2)    => If(cl_subst_caps(c, caps), cl_subst_caps(t, caps), cl_subst_caps(e2, caps))
    LetIn(nm, v, b) => LetIn(nm, cl_subst_caps(v, caps), cl_subst_caps(b, orem(nm, caps)))
    VarIn(nm, v, b) => VarIn(nm, cl_subst_caps(v, caps), cl_subst_caps(b, orem(nm, caps)))
    OwnE(inner)     => OwnE(cl_subst_caps(inner, caps))
    MutE(inner)     => MutE(cl_subst_caps(inner, caps))
    DeferE(c, b)    => DeferE(cl_subst_caps(c, caps), cl_subst_caps(b, caps))
    ErrDeferE(c, b) => ErrDeferE(cl_subst_caps(c, caps), cl_subst_caps(b, caps))
    ScopeE(snm, b)  => ScopeE(snm, cl_subst_caps(b, orem(snm, caps)))
    SpawnE(inner)   => SpawnE(cl_subst_caps(inner, caps))
    AwaitE(inner)   => AwaitE(cl_subst_caps(inner, caps))
    ShardE(v, l, h, b) => ShardE(v, cl_subst_caps(l, caps), cl_subst_caps(h, caps), cl_subst_caps(b, orem(v, caps)))
    Call(cnm, args) => let args2 = cl_subst_caps_args(args, caps) in if omem(cnm, caps) == 1 then (if len(args2) == 1 then Call("__closure_call_1", Cons(Field(Var("__env"), cnm), args2)) else Call("__closure_call_2", Cons(Field(Var("__env"), cnm), args2))) else Call(cnm, args2)
    Field(o, fld)   => Field(cl_subst_caps(o, caps), fld)
    Rec(items)      => Rec(cl_subst_caps_rec(items, caps))
    RecT(tn, items) => RecT(tn, cl_subst_caps_rec(items, caps))
    Match(sc, arms) => Match(cl_subst_caps(sc, caps), cl_subst_caps_arms(arms, caps))
    _               => e

fn cl_subst_caps_args(xs, caps) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cl_subst_caps(h, caps), cl_subst_caps_args(t, caps))

fn cl_subst_caps_rec(xs, caps) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: cl_subst_caps(h.val, caps)}, cl_subst_caps_rec(t, caps))

fn cl_subst_caps_arms(xs, caps) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: cl_subst_caps(h.body, caps)}, cl_subst_caps_arms(t, caps))

fn cl_env_rec_items(caps) = match caps
    Nil        => Nil
    Cons(c, r) => Cons({key: c, val: Var(c)}, cl_env_rec_items(r))

fn cl_conv_e(e, env_vars, top_fns, lid) = match e
    LambdaE(ps, tys, rt, body) => let rb = cl_conv_e(body, app(ps, env_vars), top_fns, lid) in let my_id = rb.lid in let caps = cl_free_vars(rb.e, ps, env_vars, Nil) in let lbody = cl_subst_caps(rb.e, caps) in let lfn = {id: my_id, ar: len(ps), fstmt: Fn("__lambda_" + str(my_id), Cons("__env", ps), lbody)} in let crec = Rec(Cons({key: "__fn_id", val: Num(my_id)}, Cons({key: "__env", val: Rec(cl_env_rec_items(caps))}, Nil))) in {e: crec, lifted: app(rb.lifted, Cons(lfn, Nil)), lid: my_id + 1}
    Bin(op, l, r)              => let rl = cl_conv_e(l, env_vars, top_fns, lid) in let rr = cl_conv_e(r, env_vars, top_fns, rl.lid) in {e: Bin(op, rl.e, rr.e), lifted: app(rl.lifted, rr.lifted), lid: rr.lid}
    If(c, t, e2)               => let rc = cl_conv_e(c, env_vars, top_fns, lid) in let rt = cl_conv_e(t, env_vars, top_fns, rc.lid) in let re = cl_conv_e(e2, env_vars, top_fns, rt.lid) in {e: If(rc.e, rt.e, re.e), lifted: app(rc.lifted, app(rt.lifted, re.lifted)), lid: re.lid}
    LetIn(nm, v, b)            => let rv = cl_conv_e(v, env_vars, top_fns, lid) in let rb = cl_conv_e(b, Cons(nm, env_vars), top_fns, rv.lid) in {e: LetIn(nm, rv.e, rb.e), lifted: app(rv.lifted, rb.lifted), lid: rb.lid}
    VarIn(nm, v, b)            => let rv = cl_conv_e(v, env_vars, top_fns, lid) in let rb = cl_conv_e(b, Cons(nm, env_vars), top_fns, rv.lid) in {e: VarIn(nm, rv.e, rb.e), lifted: app(rv.lifted, rb.lifted), lid: rb.lid}
    OwnE(inner)                => let r = cl_conv_e(inner, env_vars, top_fns, lid) in {e: OwnE(r.e), lifted: r.lifted, lid: r.lid}
    MutE(inner)                => let r = cl_conv_e(inner, env_vars, top_fns, lid) in {e: MutE(r.e), lifted: r.lifted, lid: r.lid}
    DeferE(c, b)               => let rc = cl_conv_e(c, env_vars, top_fns, lid) in let rb = cl_conv_e(b, env_vars, top_fns, rc.lid) in {e: DeferE(rc.e, rb.e), lifted: app(rc.lifted, rb.lifted), lid: rb.lid}
    ErrDeferE(c, b)            => let rc = cl_conv_e(c, env_vars, top_fns, lid) in let rb = cl_conv_e(b, env_vars, top_fns, rc.lid) in {e: ErrDeferE(rc.e, rb.e), lifted: app(rc.lifted, rb.lifted), lid: rb.lid}
    ScopeE(snm, b)             => let rb = cl_conv_e(b, Cons(snm, env_vars), top_fns, lid) in {e: ScopeE(snm, rb.e), lifted: rb.lifted, lid: rb.lid}
    SpawnE(inner)              => let r = cl_conv_e(inner, env_vars, top_fns, lid) in {e: SpawnE(r.e), lifted: r.lifted, lid: r.lid}
    AwaitE(inner)              => let r = cl_conv_e(inner, env_vars, top_fns, lid) in {e: AwaitE(r.e), lifted: r.lifted, lid: r.lid}
    ShardE(vnm, lo, hi, b)     => let rlo = cl_conv_e(lo, env_vars, top_fns, lid) in let rhi = cl_conv_e(hi, env_vars, top_fns, rlo.lid) in let rb = cl_conv_e(b, Cons(vnm, env_vars), top_fns, rhi.lid) in {e: ShardE(vnm, rlo.e, rhi.e, rb.e), lifted: app(rlo.lifted, app(rhi.lifted, rb.lifted)), lid: rb.lid}
    Call(cnm, args)            => let ra = cl_conv_args(args, env_vars, top_fns, lid) in if cnm == "_call" and len(ra.es) >= 2 then (let fexpr = ohd_e(ra.es) in let cargs = ptl(ra.es) in let dnm = if len(cargs) == 2 then "__closure_call_2" else "__closure_call_1" in {e: Call(dnm, Cons(fexpr, cargs)), lifted: ra.lifted, lid: ra.lid}) else if omem(cnm, env_vars) == 1 and omem(cnm, top_fns) == 0 then (let dnm = if len(ra.es) == 2 then "__closure_call_2" else "__closure_call_1" in {e: Call(dnm, Cons(Var(cnm), ra.es)), lifted: ra.lifted, lid: ra.lid}) else {e: Call(cnm, ra.es), lifted: ra.lifted, lid: ra.lid}
    Field(o, fld)              => let ro = cl_conv_e(o, env_vars, top_fns, lid) in {e: Field(ro.e, fld), lifted: ro.lifted, lid: ro.lid}
    Rec(items)                 => let rr = cl_conv_rec(items, env_vars, top_fns, lid) in {e: Rec(rr.items), lifted: rr.lifted, lid: rr.lid}
    RecT(tn, items)            => let rr = cl_conv_rec(items, env_vars, top_fns, lid) in {e: RecT(tn, rr.items), lifted: rr.lifted, lid: rr.lid}
    Match(sc, arms)            => let rsc = cl_conv_e(sc, env_vars, top_fns, lid) in let rarms = cl_conv_arms(arms, env_vars, top_fns, rsc.lid) in {e: Match(rsc.e, rarms.arms), lifted: app(rsc.lifted, rarms.lifted), lid: rarms.lid}
    _                          => {e: e, lifted: Nil, lid: lid}

fn cl_conv_args(xs, env_vars, top_fns, lid) = match xs
    Nil        => {es: Nil, lifted: Nil, lid: lid}
    Cons(h, t) => let rh = cl_conv_e(h, env_vars, top_fns, lid) in let rt = cl_conv_args(t, env_vars, top_fns, rh.lid) in {es: Cons(rh.e, rt.es), lifted: app(rh.lifted, rt.lifted), lid: rt.lid}

fn cl_conv_rec(xs, env_vars, top_fns, lid) = match xs
    Nil        => {items: Nil, lifted: Nil, lid: lid}
    Cons(h, t) => let rh = cl_conv_e(h.val, env_vars, top_fns, lid) in let rt = cl_conv_rec(t, env_vars, top_fns, rh.lid) in {items: Cons({key: h.key, val: rh.e}, rt.items), lifted: app(rh.lifted, rt.lifted), lid: rt.lid}

fn cl_conv_arms(xs, env_vars, top_fns, lid) = match xs
    Nil        => {arms: Nil, lifted: Nil, lid: lid}
    Cons(h, t) => let rh = cl_conv_e(h.body, app(apat_binds(h.pat), env_vars), top_fns, lid) in let rt = cl_conv_arms(t, env_vars, top_fns, rh.lid) in {arms: Cons({pat: h.pat, body: rh.e}, rt.arms), lifted: app(rh.lifted, rt.lifted), lid: rt.lid}

fn cl_conv_stmt(st, top_fns, lid) = match st
    Fn(nm, ps, body) => let r = cl_conv_e(body, ps, top_fns, lid) in {st: Fn(nm, ps, r.e), lifted: r.lifted, lid: r.lid}
    Print(v)         => let r = cl_conv_e(v, Nil, top_fns, lid) in {st: Print(r.e), lifted: r.lifted, lid: r.lid}
    ExprS(v)         => let r = cl_conv_e(v, Nil, top_fns, lid) in {st: ExprS(r.e), lifted: r.lifted, lid: r.lid}
    _                => {st: st, lifted: Nil, lid: lid}

fn cl_conv_stmts(prog, top_fns, lid) = match prog
    Nil        => {stmts: Nil, lifted: Nil, lid: lid}
    Cons(h, t) => let rh = cl_conv_stmt(h, top_fns, lid) in let rt = cl_conv_stmts(t, top_fns, rh.lid) in {stmts: Cons(rh.st, rt.stmts), lifted: app(rh.lifted, rt.lifted), lid: rt.lid}

fn cl_lifted_stmts(lifted) = match lifted
    Nil        => Nil
    Cons(h, t) => Cons(h.fstmt, cl_lifted_stmts(t))

fn cl_dispatch_1(lifted) = match lifted
    Nil        => Num(0)
    Cons(h, t) => if h.ar == 1 then If(Bin("==", Field(Var("__cl"), "__fn_id"), Num(h.id)), Call("__lambda_" + str(h.id), Cons(Field(Var("__cl"), "__env"), Cons(Var("__a0"), Nil))), cl_dispatch_1(t)) else cl_dispatch_1(t)

fn cl_dispatch_2(lifted) = match lifted
    Nil        => Num(0)
    Cons(h, t) => if h.ar == 2 then If(Bin("==", Field(Var("__cl"), "__fn_id"), Num(h.id)), Call("__lambda_" + str(h.id), Cons(Field(Var("__cl"), "__env"), Cons(Var("__a0"), Cons(Var("__a1"), Nil)))), cl_dispatch_2(t)) else cl_dispatch_2(t)

fn cl_convert_prog(prog) = if cl_has_lambda_prog(prog) == 0 then prog else let top_fns = ocollectfnms(prog) in let r = cl_conv_stmts(prog, top_fns, 1) in if isnil(r.lifted) == 1 then r.stmts else let disp1 = Fn("__closure_call_1", Cons("__cl", Cons("__a0", Nil)), cl_dispatch_1(r.lifted)) in let disp2 = Fn("__closure_call_2", Cons("__cl", Cons("__a0", Cons("__a1", Nil))), cl_dispatch_2(r.lifted)) in app(cl_lifted_stmts(r.lifted), Cons(disp1, Cons(disp2, r.stmts)))

fn ocheck(prog) = if oany(prog) == 0 then prog else ocheckforce(prog)
fn ocheckforce(prog0) = let traits = t4_collect_traits(prog0) in let impls = t4_collect_impls(prog0) in let ztr = t4_chk_impls(impls, traits) in let prog_tr = if isnil(traits) == 1 then prog0 else t4_resolve_prog(prog0, traits, impls, tcollects(prog0), tcollectc(prog0)) in let zhm = if cl_has_lambda_prog(prog_tr) == 1 then (let p_hm = tcheck(prog_tr) in 1) else 0 in let prog = cl_convert_prog(prog_tr) in let raw_osigs = ocollects(prog) in let raw_fns0 = ocollectf(prog) in let grad_fns = n4_synth_grad_fns(n4_collect_grads_prog(prog, Nil), raw_fns0) in let prog1 = app(grad_fns, prog) in let raw_fns = ocollectf(prog1) in let osigs = oinfer_priv_osigs(raw_fns, raw_osigs) in let otypes = ocollectt(prog1) in let recs = tcollectr(prog1) in let sigs = tcollects(prog1) in let ksigs = kcollect_effsigs(prog1) in let edecls = kcollect_effdecls(prog1) in let caps = kcollect_caps(prog1) in let vsigs = vcollect_vsigs(prog1) in let invs = vcollect_invs(prog1) in let laws = vcollect_laws(prog1) in let wcets = vcollect_wcets(prog1) in let prog2 = afill_prog_holes(prog1, sigs, osigs, vsigs, laws, raw_fns) in let fns = ocollectf(prog2) in let ufns = ocollectfnms(prog2) in let z = ochkstmts(prog2, {osigs: osigs, otypes: otypes, recs: recs, sigs: sigs, fns: fns, ksigs: ksigs, edecls: edecls, caps: caps, vsigs: vsigs, invs: invs, laws: laws, wcets: wcets}, Nil) in olowerprog(prog2, ufns, osigs, {vsigs: vsigs, fns: fns})
