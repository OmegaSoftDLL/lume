## --- code generator: x86-64 asm for the core (port of lcgen.lume, R6a; strings/records/ctors R6b) ---
## Same output shape as `agen` in data_asmgen.lume for fn/print statements over Num/Var/Bin/Call/If/LetIn/Str/Rec/Field.
## No mutation: the state {nl, ns, dt} (label counter, string-label counter, rodata chunks) is threaded through
## every call and returned in {code, nl, ns, dt}; the per-function context is the immutable record {locals, bound}.
## List/index nodes are out of scope and emit the same placeholder as agen. Output is joined pairwise
## (O(n log k)), never grown with a long right-nested `+` chain.

## --- list helpers ---
fn app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, app(t, ys))
fn len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + len(t)
fn isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn drop(xs, k) = if k <= 0 then xs else drop2(xs, k)
fn drop2(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => drop(t, k - 1)
fn revacc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => revacc(t, Cons(h, acc))
fn rev(xs) = revacc(xs, Nil)
fn pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => pairs2(a, t)
fn pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, pairs(r))
fn joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if isnil(t) == 1 then a else joinall(pairs(xs))

## --- registers, operators, frame slots ---
fn areg(i) = if i == 0 then "%rdi" else if i == 1 then "%rsi" else if i == 2 then "%rdx" else if i == 3 then "%rcx" else if i == 4 then "%r8" else "%r9"
fn abin(op) = if op == "+" then "    addq %rcx, %rax\n" else if op == "-" then "    subq %rcx, %rax\n" else if op == "*" then "    imulq %rcx, %rax\n" else if op == "/" then "    cqto\n    idivq %rcx\n" else if op == "%" then "    cqto\n    idivq %rcx\n    movq %rdx, %rax\n" else if op == "<" then "    cmpq %rcx, %rax\n    setl %al\n    movzbq %al, %rax\n" else if op == ">" then "    cmpq %rcx, %rax\n    setg %al\n    movzbq %al, %rax\n" else if op == "<=" then "    cmpq %rcx, %rax\n    setle %al\n    movzbq %al, %rax\n" else if op == ">=" then "    cmpq %rcx, %rax\n    setge %al\n    movzbq %al, %rax\n" else if op == "==" then "    cmpq %rcx, %rax\n    sete %al\n    movzbq %al, %rax\n" else if op == "!=" then "    cmpq %rcx, %rax\n    setne %al\n    movzbq %al, %rax\n" else if op == "and" then "    cmpq $0, %rax\n    setne %al\n    cmpq $0, %rcx\n    setne %cl\n    andb %cl, %al\n    movzbq %al, %rax\n" else if op == "or" then "    cmpq $0, %rax\n    setne %al\n    cmpq $0, %rcx\n    setne %cl\n    orb %cl, %al\n    movzbq %al, %rax\n" else ""
fn lidxfrom(xs, name, i) = match xs
    Nil        => 0 - 1
    Cons(h, t) => if h == name then i else lidxfrom(t, name, i + 1)
fn lidxof(xs, name) = lidxfrom(xs, name, 0)
fn lslot(k) = str(0 - 8 * (k + 1))
fn lframe(n) = if (n * 8) % 16 != 0 then n * 8 + 8 else n * 8

## --- let-bound names reachable in an expression, in agen's collect_lets order ---
fn lcollect(e) = match e
    LetIn(nm, v, b) => Cons(nm, app(lcollect(v), lcollect(b)))
    Bin(op, l, r)   => app(lcollect(l), lcollect(r))
    If(c, t, e2)    => app(lcollect(c), app(lcollect(t), lcollect(e2)))
    Call(nm, args)  => lcollectargs(args)
    Field(o, nm)    => lcollect(o)
    Rec(items)      => lcollectrec(items)
    RecT(tn, items) => lcollectrec(items)
    Match(sc, arms) => app(lcollect(sc), lcollectarms(arms))
    _               => Nil
fn lcollectargs(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lcollect(h), lcollectargs(t))
fn lcollectrec(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lcollect(h.val), lcollectrec(t))
fn lcollectarms(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lpatbinds(h.pat), app(lcollect(h.body), lcollectarms(t)))

## --- patterns: the names a pattern binds (frame slots), and match nesting depth (scrutinee slots _sd<k>) ---
fn lpatbinds(p) = match p
    PBind(nm)       => Cons(nm, Nil)
    PCons(tag, subs) => lpatbindsl(subs)
    _               => Nil
fn lpatbindsl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lpatbinds(h), lpatbindsl(t))
fn imax(a, b) = if a > b then a else b
fn lmdepth(e) = match e
    Match(sc, arms) => imax(lmdepth(sc), lmdarms(arms)) + 1
    If(c, t, e2)    => imax(lmdepth(c), imax(lmdepth(t), lmdepth(e2)))
    Bin(op, l, r)   => imax(lmdepth(l), lmdepth(r))
    LetIn(nm, v, b) => imax(lmdepth(v), lmdepth(b))
    Call(nm, args)  => lmdargs(args)
    Field(o, nm)    => lmdepth(o)
    Rec(items)      => lmdrec(items)
    RecT(tn, items) => lmdrec(items)
    _               => 0
fn lmdarms(xs) = match xs
    Nil        => 0
    Cons(h, t) => imax(lmdepth(h.body), lmdarms(t))
fn lmdargs(xs) = match xs
    Nil        => 0
    Cons(h, t) => imax(lmdepth(h), lmdargs(t))
fn lmdrec(xs) = match xs
    Nil        => 0
    Cons(h, t) => imax(lmdepth(h.val), lmdrec(t))
fn lsds(i, n) = if i >= n then Nil else Cons("_sd" + str(i), lsds(i + 1, n))

## --- binary operators ---
fn lsetc(op) = if op == ">" then "    setg %al\n" else if op == "<=" then "    setle %al\n" else if op == ">=" then "    setge %al\n" else "    setl %al\n"
fn lbintail(op) = if op == "==" then "    popq %rsi\n    popq %rdi\n    call eqv\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n" else if op == "!=" then "    popq %rsi\n    popq %rdi\n    call eqv\n    xorq $1, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n" else if op == "+" then "    popq %rsi\n    popq %rdi\n    call addv\n    pushq %rax\n" else if op == "<" or op == ">" or op == "<=" or op == ">=" then "    popq %rsi\n    popq %rdi\n    call cmpv\n    cmpq $0, %rax\n" + lsetc(op) + "    movzbq %al, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n" else "    popq %rcx\n    popq %rax\n    movq 8(%rax), %rax\n    movq 8(%rcx), %rcx\n" + abin(op) + "    movq %rax, %rdi\n    call mkint\n    pushq %rax\n"

fn ldec_key(items, key) = match items
    Nil        => 0
    Cons(h, t) => if h.key == key then 1 else ldec_key(t, key)
fn ldec_name(names, name) = match names
    Nil        => 0
    Cons(h, t) => if h == name then 1 else ldec_name(t, name)
fn ldec_remove(names, name) = match names
    Nil        => Nil
    Cons(h, t) => if h == name then ldec_remove(t, name) else Cons(h, ldec_remove(t, name))
fn ldec_expr(e, names) = match e
    Rec(items)    => len(items) == 3 and ldec_key(items, "coefficient") == 1 and ldec_key(items, "scale") == 1 and ldec_key(items, "precision") == 1
    Call(nm, args) => nm == "decimal" or nm == "decimal_make" or nm == "decimal_parse" or nm == "decimal_cast" or nm == "decimal_div_exact" or nm == "decimal_add" or nm == "decimal_sub" or nm == "decimal_mul" or nm == "decimal_div"
    Var(nm)       => ldec_name(names, nm)
    If(c, t, e2) => ldec_expr(t, names) and ldec_expr(e2, names)
    LetIn(nm, v, body) => ldec_expr(body, if ldec_expr(v, names) then Cons(nm, ldec_remove(names, nm)) else ldec_remove(names, nm))
    _             => 0
fn ldec_tail(op) = if op == "+" then "    popq %rsi\n    popq %rdi\n    call decimal_add\n    pushq %rax\n" else if op == "-" then "    popq %rsi\n    popq %rdi\n    call decimal_sub\n    pushq %rax\n" else if op == "*" then "    popq %rsi\n    popq %rdi\n    call decimal_mul\n    pushq %rax\n" else if op == "/" then "    popq %rsi\n    popq %rdi\n    call decimal_div\n    pushq %rax\n" else "    popq %rsi\n    popq %rdi\n    call decimal_compare\n    movq 8(%rax), %rax\n    cmpq $0, %rax\n" + (if op == "==" then "    sete %al\n" else if op == "!=" then "    setne %al\n" else lsetc(op)) + "    movzbq %al, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n"

## --- state and results ---
## The threaded state is the record {nl, ns, dt}: nl = next free code label, ns = next free string label,
## dt = rodata chunks emitted so far (newest first). Every result is {code, nl, ns, dt}, so a result IS the
## next state and is passed straight to the following sibling; lres copies the state fields into a result.
fn lres(code, s) = {code: code, nl: s.nl, ns: s.ns, dt: s.dt}
fn lnext(s) = {nl: s.nl + 1, ns: s.ns, dt: s.dt}

## --- constructors (ML-core convention: a capitalised identifier is a constructor) ---
fn isctor(name) = let c = at(name, 0) in c >= "A" and c <= "Z"

## --- string literals: escape for .asciz and emit a .rodata label (port of sesc / strlabel) ---
fn lsesc1(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\t" then "\\t" else if c == "\r" then "\\r" else c
fn lsescl(s, i, n) = if i >= n then Nil else Cons(lsesc1(at(s, i)), lsescl(s, i + 1, n))
fn lsesc(s) = joinall(lsescl(s, 0, count(s)))
fn lstrlabel(v, s) = let lab = ".Ls" + str(s.ns) in {lab: lab, nl: s.nl, ns: s.ns + 1, dt: Cons(lab + ":\n    .asciz \"" + lsesc(v) + "\"\n", s.dt)}
fn lstr(sl) = lres("    leaq " + sl.lab + "(%rip), %rdi\n    call mkstr\n    pushq %rax\n", sl)

## --- calls: stack args (7th and later, last first), register args, pops ---
fn lstackargs(xs, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => lstackmore(laexpr(h, ctx, s), t, ctx)
fn lstackmore(a, t, ctx) = let rest = lstackargs(t, ctx, a) in lres(a.code + rest.code, rest)
fn lregargs(xs, q, m, ctx, s) = if q >= m then lres("", s) else lregargs2(xs, q, m, ctx, s)
fn lregargs2(xs, q, m, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => lregmore(laexpr(h, ctx, s), t, q, m, ctx)
fn lregmore(a, t, q, m, ctx) = let rest = lregargs(t, q + 1, m, ctx, a) in lres(a.code + rest.code, rest)
fn lpops(i) = if i < 0 then "" else "    popq " + areg(i) + "\n" + lpops(i - 1)
fn lcall(nm, args, ctx, s) = let n = len(args) in let m = if n > 6 then 6 else n in let st = lstackargs(rev(drop(args, 6)), ctx, s) in let rg = lregargs(args, 0, m, ctx, st) in let adj = if n > 6 then "    addq $" + str((n - 6) * 8) + ", %rsp\n" else "" in lres(st.code + rg.code + lpops(m - 1) + "    call " + nm + "\n" + adj + "    pushq %rax\n", rg)

## --- constructors and records: args evaluated in order, then popped into a fresh k*8-byte block ---
fn lpopstore(k) = if k < 0 then "" else "    popq %rax\n    movq %rax, " + str(k * 8) + "(%rcx)\n" + lpopstore(k - 1)
fn lctor(nm, args, ctx, s) = lctor2(lstrlabel(nm, s), len(args), args, ctx)
fn lctor2(sl, n, args, ctx) = if n == 0 then lres("    leaq " + sl.lab + "(%rip), %rdi\n    movq $0, %rsi\n    movq $0, %rdx\n    call mkctor\n    pushq %rax\n", sl) else lctor3(sl, n, lstackargs(args, ctx, sl))
fn lctor3(sl, n, ar) = lres(ar.code + "    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rcx\n" + lpopstore(n - 1) + "    leaq " + sl.lab + "(%rip), %rdi\n    movq $" + str(n) + ", %rsi\n    movq %rcx, %rdx\n    call mkctor\n    pushq %rax\n", ar)
fn lrecvals(items, ctx, s) = match items
    Nil        => lres("", s)
    Cons(h, t) => lrecvmore(laexpr(h.val, ctx, s), t, ctx)
fn lrecvmore(a, t, ctx) = let rest = lrecvals(t, ctx, a) in lres(a.code + rest.code, rest)
fn lreckeys(items, j, s) = match items
    Nil        => lres("", s)
    Cons(h, t) => lreckmore(lstrlabel(h.key, s), t, j)
fn lreckmore(sl, t, j) = let rest = lreckeys(t, j + 1, sl) in lres("    leaq " + sl.lab + "(%rip), %rax\n    movq %rax, " + str(j * 8) + "(%rdx)\n" + rest.code, rest)
fn lrec(items, ctx, s) = if isnil(items) == 1 then lres("    movq $0, %rdi\n    movq $0, %rsi\n    movq $0, %rdx\n    call mkrec\n    pushq %rax\n", s) else lrec2(items, len(items), lrecvals(items, ctx, s))
fn lrec2(items, n, vs) = let ks = lreckeys(items, 0, vs) in lres(vs.code + "    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rcx\n" + lpopstore(n - 1) + "    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rdx\n" + ks.code + "    movq %rdx, %rdi\n    movq %rcx, %rsi\n    movq $" + str(n) + ", %rdx\n    call mkrec\n    pushq %rax\n", ks)
fn lfield(sl, o, ctx) = let ob = laexpr(o, ctx, sl) in lres(ob.code + "    popq %rdi\n    leaq " + sl.lab + "(%rip), %rsi\n    call recget\n    pushq %rax\n", ob)

## --- match (port of DMatch / atest / abind in data_asmgen.lume; same label + strlabel allocation order) ---
## `acc` is asm that loads the value pointer into %rax; sub-pattern k of a constructor loads field k from it.
fn lacck(acc, k) = acc + "    movq 24(%rax), %rax\n    movq " + str(k * 8) + "(%rax), %rax\n"
fn latest(p, acc, flbl, s) = match p
    PInt(n)          => lres(acc + "    cmpq $0, (%rax)\n    jne " + flbl + "\n    cmpq $" + str(n) + ", 8(%rax)\n    jne " + flbl + "\n", s)
    PStr(v)          => lateststr(lstrlabel(v, s), acc, flbl)
    PCons(tag, subs) => latestcons(lstrlabel(tag, s), acc, subs, flbl)
    _                => lres("", s)
fn lateststr(sl, acc, flbl) = lres(acc + "    cmpq $1, (%rax)\n    jne " + flbl + "\n    movq 16(%rax), %rdi\n    leaq " + sl.lab + "(%rip), %rsi\n    call streq\n    testq %rax, %rax\n    jz " + flbl + "\n", sl)
fn latestcons(sl, acc, subs, flbl) = let sb = latestsubs(subs, 0, acc, flbl, sl) in lres(acc + "    cmpq $2, (%rax)\n    jne " + flbl + "\n    movq 16(%rax), %rdi\n    leaq " + sl.lab + "(%rip), %rsi\n    call streq\n    testq %rax, %rax\n    jz " + flbl + "\n" + sb.code, sb)
fn latestsubs(subs, k, acc, flbl, s) = match subs
    Nil        => lres("", s)
    Cons(h, t) => latestsub(latest(h, lacck(acc, k), flbl, s), t, k, acc, flbl)
fn latestsub(r, t, k, acc, flbl) = let rest = latestsubs(t, k + 1, acc, flbl, r) in lres(r.code + rest.code, rest)
fn labind(p, acc, locals) = match p
    PBind(nm)        => acc + "    movq %rax, " + lslot(lidxof(locals, nm)) + "(%rbp)\n"
    PCons(tag, subs) => labinds(subs, 0, acc, locals)
    _                => ""
fn labinds(subs, k, acc, locals) = match subs
    Nil        => ""
    Cons(h, t) => labind(h, lacck(acc, k), locals) + labinds(t, k + 1, acc, locals)
fn lmatch(lab, ctx, sc, arms, s1) = let c2 = {locals: ctx.locals, bound: ctx.bound, dvars: ctx.dvars, depth: ctx.depth + 1} in lmatch1(lab, lslot(lidxof(ctx.locals, "_sd" + str(ctx.depth))), arms, c2, laexpr(sc, c2, s1))
fn lmatch1(lab, soff, arms, c2, scr) = let ar = lmarms(lab, 0, "    movq " + soff + "(%rbp), %rax\n", arms, c2, scr) in lres(scr.code + "    popq %rax\n    movq %rax, " + soff + "(%rbp)\n" + ar.code + ".Lm" + lab + "_" + str(len(arms)) + ":\n    movq $0, %rdi\n    call mkint\n    pushq %rax\n.Lm" + lab + "_end:\n", ar)
fn lmarms(lab, i, acc, arms, c2, s) = match arms
    Nil        => lres("", s)
    Cons(h, t) => lmarm(lab, i, acc, h, t, c2, laexpr(h.body, {locals: c2.locals, bound: app(c2.bound, lpatbinds(h.pat)), dvars: c2.dvars, depth: c2.depth}, s))
fn lmarm(lab, i, acc, h, t, c2, bd) = lmarm2(lab, i, acc, h, t, c2, bd, latest(h.pat, acc, ".Lm" + lab + "_" + str(i + 1), bd))
fn lmarm2(lab, i, acc, h, t, c2, bd, ts) = let rest = lmarms(lab, i + 1, acc, t, c2, ts) in lres(".Lm" + lab + "_" + str(i) + ":\n" + ts.code + labind(h.pat, acc, c2.locals) + bd.code + "    jmp .Lm" + lab + "_end\n" + rest.code, rest)

## --- expressions: asm that leaves the value of `e` pushed; `s` is the threaded state ---
fn lbin(op, l, lr, r, ctx) = let rr = laexpr(r, ctx, lr) in lres(lr.code + rr.code + (if ldec_expr(l, ctx.dvars) and ldec_expr(r, ctx.dvars) then ldec_tail(op) else lbintail(op)), rr)
fn lif(lab, cr, t, e2, ctx) = let tr = laexpr(t, ctx, cr) in let er = laexpr(e2, ctx, tr) in lres(cr.code + "    popq %rax\n    movq 8(%rax), %rax\n    testq %rax, %rax\n    jz .Le" + lab + "\n" + tr.code + "    jmp .Lx" + lab + "\n.Le" + lab + ":\n" + er.code + ".Lx" + lab + ":\n", er)
fn llet(nm, v, vr, b, ctx) = let inner = {locals: ctx.locals, bound: app(ctx.bound, Cons(nm, Nil)), dvars: if ldec_expr(v, ctx.dvars) then Cons(nm, ldec_remove(ctx.dvars, nm)) else ldec_remove(ctx.dvars, nm), depth: ctx.depth} in let br = laexpr(b, inner, vr) in lres(vr.code + "    popq %rax\n    movq %rax, " + lslot(lidxof(ctx.locals, nm)) + "(%rbp)\n" + br.code, br)
fn lvar(nm, ctx, s) = if isctor(nm) then lctor(nm, Nil, ctx, s) else lres("    movq " + lslot(lidxof(ctx.locals, nm)) + "(%rbp), %rax\n    pushq %rax\n", s)
fn lreuse1(args, ctx, s) = let ar = lstackargs(args, ctx, s) in lres(ar.code + "    popq %rsi\n    popq %rax\n    movq 24(%rax), %rcx\n    movq %rsi, 0(%rcx)\n    pushq %rax\n", ar)
fn lreuse2(args, ctx, s) = let ar = lstackargs(args, ctx, s) in lres(ar.code + "    popq %rdx\n    popq %rsi\n    popq %rax\n    movq 24(%rax), %rcx\n    movq %rsi, 0(%rcx)\n    movq %rdx, 8(%rcx)\n    pushq %rax\n", ar)
fn lcallx(nm, args, ctx, s) = if isctor(nm) then lctor(nm, args, ctx, s) else if nm == "__perceus_reuse_2" then lreuse2(args, ctx, s) else if nm == "__perceus_reuse_1" then lreuse1(args, ctx, s) else lcall(nm, args, ctx, s)
fn laexpr(e, ctx, s) = match e
    Num(n)         => lres("    movq $" + str(n) + ", %rdi\n    call mkint\n    pushq %rax\n", s)
    Str(v)         => lstr(lstrlabel(v, s))
    Var(nm)        => lvar(nm, ctx, s)
    Bin(op, l, r)  => lbin(op, l, laexpr(l, ctx, s), r, ctx)
    If(c, t, e2)   => lif(str(s.nl), laexpr(c, ctx, lnext(s)), t, e2, ctx)
    LetIn(nm, v, b) => llet(nm, v, laexpr(v, ctx, s), b, ctx)
    Call(nm, args) => lcallx(nm, args, ctx, s)
    Rec(items)     => lrec(items, ctx, s)
    RecT(tn, items) => lrec(items, ctx, s)
    Field(o, nm)   => lfield(lstrlabel(nm, s), o, ctx)
    Match(sc, arms) => lmatch(str(s.nl), ctx, sc, arms, lnext(s))
    _              => lres("    movq $0, %rax\n    pushq %rax\n    # unsupported expr\n", s)

## --- functions ---
fn lparams(ps, i) = match ps
    Nil        => ""
    Cons(h, t) => if i < 6 then "    movq " + areg(i) + ", " + lslot(i) + "(%rbp)\n" + lparams(t, i + 1) else "    movq " + str(16 + 8 * (i - 6)) + "(%rbp), %rax\n    movq %rax, " + lslot(i) + "(%rbp)\n" + lparams(t, i + 1)
fn lafn(nm, params, body, s) = lafn_typed(nm, params, body, Nil, s)
fn lafn_typed(nm, params, body, dvars, s) = let locals = app(params, app(lcollect(body), lsds(0, lmdepth(body)))) in let frame = lframe(len(locals)) in let br = laexpr(body, {locals: locals, bound: params, dvars: dvars, depth: 0}, s) in let sub = if frame > 0 then "    subq $" + str(frame) + ", %rsp\n" else "" in lres(nm + ":\n    pushq %rbp\n    movq %rsp, %rbp\n" + sub + lparams(params, 0) + br.code + "    popq %rax\n    movq %rbp, %rsp\n    popq %rbp\n    ret\n", br)

## --- statements: one pass in source order threading the state ---
fn lmlocals(prog) = match prog
    Nil        => Nil
    Cons(h, t) => app(lmlocalsone(h), lmlocals(t))
fn lmlocalsone(s) = match s
    Print(v) => lcollect(v)
    ExprS(v) => lcollect(v)
    _        => Nil
fn lmdprog(prog) = match prog
    Nil        => 0
    Cons(h, t) => imax(lmdone(h), lmdprog(t))
fn lmdone(s) = match s
    Print(v) => lmdepth(v)
    ExprS(v) => lmdepth(v)
    _        => 0
fn lstmts(prog, mlocals, s) = match prog
    Nil        => {funcs: Nil, mains: Nil, nl: s.nl, ns: s.ns, dt: s.dt}
    Cons(h, t) => lstmt(h, t, mlocals, s)
fn lstmt(s0, t, mlocals, s) = match s0
    Fn(nm, ps, body) => lstmtfn(lafn(nm, ps, body, s), t, mlocals)
    Sig(nm, ps, tys, rt) => lstmt_sig(nm, ps, tys, t, mlocals, s)
    Print(v)         => lstmtprint(laexpr(v, {locals: mlocals, bound: Nil, dvars: Nil, depth: 0}, s), t, mlocals)
    ExprS(v)         => lstmtexpr(laexpr(v, {locals: mlocals, bound: Nil, dvars: Nil, depth: 0}, s), t, mlocals)
    _                => lstmts(t, mlocals, s)
fn lstmt_sig(nm, pnames, ptypes, rest, mlocals, s) = match rest
    Nil => lstmts(rest, mlocals, s)
    Cons(Fn(nm2, ps, body), tail) => lstmtfn(lafn_typed(nm2, ps, body, ldecimal_params(pnames, ptypes), s), tail, mlocals)
    _ => lstmts(rest, mlocals, s)
fn ldecimal_params(pnames, ptypes) = match pnames
    Nil => Nil
    Cons(pn, pr) => ldecimal_param(pn, pr, ptypes)
fn ldecimal_param(pn, rest, ptypes) = match ptypes
    Nil => ldecimal_params(rest, Nil)
    Cons(ty, tr) => app(if ldecimal_type(ty) then Cons(pn, Nil) else Nil, ldecimal_params(rest, tr))
fn ldecimal_type(ty) = match ty
    TyDecimal(p, s) => 1
    _ => 0
fn lstmtfn(f, t, mlocals) = let rest = lstmts(t, mlocals, f) in {funcs: Cons(f.code, rest.funcs), mains: rest.mains, nl: rest.nl, ns: rest.ns, dt: rest.dt}
fn lstmtprint(pr, t, mlocals) = let rest = lstmts(t, mlocals, pr) in {funcs: rest.funcs, mains: Cons(pr.code + "    popq %rdi\n    call printval\n", rest.mains), nl: rest.nl, ns: rest.ns, dt: rest.dt}
## an expression statement: evaluate `v` for its effect and DISCARD the pushed value (popq %rax, no printval)
fn lstmtexpr(er, t, mlocals) = let rest = lstmts(t, mlocals, er) in {funcs: rest.funcs, mains: Cons(er.code + "    popq %rax\n", rest.mains), nl: rest.nl, ns: rest.ns, dt: rest.dt}

## --- the program: bss + rodata (oom_msg + string chunks) + text(funcs, runtime, _start, main) ---
fn lgen(prog) = let mlocals = app(lmlocals(prog), lsds(0, lmdprog(prog))) in let gs = lstmts(prog, mlocals, {nl: 0, ns: 0, dt: Nil}) in let mframe = lframe(len(mlocals)) in let mprol = "    movq %rsp, %rbp\n" + (if mframe > 0 then "    subq $" + str(mframe) + ", %rsp\n" else "") in let bss = "    .section .bss\n    .lcomm pbuf, 32\n    .lcomm heap_cur, 8\n    .lcomm heap_end, 8\n    .lcomm emit_buf, 8\n    .lcomm emit_len, 8\n    .lcomm emit_cap, 8\n" in let rodata = "    .section .rodata\noom_msg:\n    .asciz \"lume: out of memory (heap exhausted, brk failed)\\n\"\n" in let heapinit = "    movq $12, %rax\n    xorq %rdi, %rdi\n    syscall\n    movq %rax, heap_cur(%rip)\n    leaq 67108864(%rax), %rdi\n    movq %rdi, %rsi\n    movq $12, %rax\n    syscall\n    cmpq %rsi, %rax\n    jne alloc_oom\n    movq %rsi, heap_end(%rip)\n" in joinall(Cons(bss, Cons(rodata, Cons(joinall(rev(gs.dt)), Cons("    .section .text\n", Cons(joinall(gs.funcs), Cons(runtime_tail(), Cons("    .globl _start\n_start:\n", Cons(heapinit, Cons(mprol, Cons(joinall(gs.mains), Cons("    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n", Nil))))))))))))


