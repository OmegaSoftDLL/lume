## async_rt.src -- Track L (`#257`) Standard Library: Async I/O Runtime at Scale (`use std.async_rt` / `use async_rt`).
##
## Provides:
##   1. Readiness-polled I/O event loop reactor (`reactor_new`, `reactor_submit_io`, `reactor_notify_fd_ready`)
##   2. Deadline-ordered timer wheel (`reactor_schedule_timer`, `reactor_advance_clock`)
##   3. Bounded backpressure admission control (`max_inflight` enforcement & rejection accounting)
##   4. Multi-worker work-stealing scheduler (`ws_pool_new`, `ws_step`, `ws_run_all`)
##   5. Native Linux x86-64 kernel `epoll` (`epoll_create1`/`epoll_ctl`/`epoll_wait`) + `pipe` readiness driver

fn art_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + art_len(t)

fn art_snoc(xs, v) = match xs
    Nil        => Cons(v, Nil)
    Cons(h, t) => Cons(h, art_snoc(t, v))

fn art_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, art_app(t, ys))

fn art_take(xs, k) = if k <= 0 then Nil else art_take2(xs, k)
fn art_take2(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(h, art_take(t, k - 1))

fn art_drop(xs, k) = if k <= 0 then xs else art_drop2(xs, k)
fn art_drop2(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => art_drop(t, k - 1)

## --- 1. Readiness-Polled I/O Reactor & Timer Wheel ---
fn reactor_new(max_inflight) = {max_inflight: max_inflight, inflight: 0, now_ms: 0, ready_q: Nil, wait_io: Nil, timers: Nil, completed: Nil, rejected: 0}

fn reactor_submit_io(rt, task_id, fd, mult) = if rt.inflight >= rt.max_inflight then {ok: 0, rt: {max_inflight: rt.max_inflight, inflight: rt.inflight, now_ms: rt.now_ms, ready_q: rt.ready_q, wait_io: rt.wait_io, timers: rt.timers, completed: rt.completed, rejected: rt.rejected + 1}} else let entry = {task_id: task_id, fd: fd, mult: mult} in {ok: 1, rt: {max_inflight: rt.max_inflight, inflight: rt.inflight + 1, now_ms: rt.now_ms, ready_q: rt.ready_q, wait_io: art_snoc(rt.wait_io, entry), timers: rt.timers, completed: rt.completed, rejected: rt.rejected}}

fn art_insert_timer(tm, timers) = match timers
    Nil        => Cons(tm, Nil)
    Cons(h, t) => if tm.deadline_ms < h.deadline_ms then Cons(tm, Cons(h, t)) else Cons(h, art_insert_timer(tm, t))

fn reactor_schedule_timer(rt, task_id, deadline_ms, val) = if rt.inflight >= rt.max_inflight then {ok: 0, rt: {max_inflight: rt.max_inflight, inflight: rt.inflight, now_ms: rt.now_ms, ready_q: rt.ready_q, wait_io: rt.wait_io, timers: rt.timers, completed: rt.completed, rejected: rt.rejected + 1}} else let tm = {task_id: task_id, deadline_ms: deadline_ms, val: val} in {ok: 1, rt: {max_inflight: rt.max_inflight, inflight: rt.inflight + 1, now_ms: rt.now_ms, ready_q: rt.ready_q, wait_io: rt.wait_io, timers: art_insert_timer(tm, rt.timers), completed: rt.completed, rejected: rt.rejected}}

fn art_partition_fd(wait_io, fd, io_val) = match wait_io
    Nil        => {woken: Nil, rem: Nil}
    Cons(w, r) => let sub = art_partition_fd(r, fd, io_val) in if w.fd == fd then {woken: Cons({task_id: w.task_id, val: io_val * w.mult}, sub.woken), rem: sub.rem} else {woken: sub.woken, rem: Cons(w, sub.rem)}

fn reactor_notify_fd_ready(rt, fd, io_val) = let p = art_partition_fd(rt.wait_io, fd, io_val) in {max_inflight: rt.max_inflight, inflight: rt.inflight, now_ms: rt.now_ms, ready_q: art_app(rt.ready_q, p.woken), wait_io: p.rem, timers: rt.timers, completed: rt.completed, rejected: rt.rejected}

fn art_partition_timers(timers, now_ms) = match timers
    Nil         => {fired: Nil, pending: Nil}
    Cons(tm, r) => if tm.deadline_ms <= now_ms then (let sub = art_partition_timers(r, now_ms) in {fired: Cons({task_id: tm.task_id, val: tm.val}, sub.fired), pending: sub.pending}) else {fired: Nil, pending: Cons(tm, r)}

fn reactor_advance_clock(rt, new_now_ms) = let p = art_partition_timers(rt.timers, new_now_ms) in {max_inflight: rt.max_inflight, inflight: rt.inflight, now_ms: new_now_ms, ready_q: art_app(rt.ready_q, p.fired), wait_io: rt.wait_io, timers: p.pending, completed: rt.completed, rejected: rt.rejected}

fn reactor_drain_ready(rt) = let n_ready = art_len(rt.ready_q) in {max_inflight: rt.max_inflight, inflight: rt.inflight - n_ready, now_ms: rt.now_ms, ready_q: Nil, wait_io: rt.wait_io, timers: rt.timers, completed: art_app(rt.completed, rt.ready_q), rejected: rt.rejected}

fn reactor_completed_val(completed, task_id) = match completed
    Nil        => 0 - 1
    Cons(c, r) => if c.task_id == task_id then c.val else reactor_completed_val(r, task_id)

fn reactor_first_completed_id(completed) = match completed
    Nil        => 0 - 1
    Cons(c, r) => c.task_id

## --- 2. Multi-Worker Work-Stealing Scheduler ---
fn ws_pool_new(q0, q1) = {q0: q0, q1: q1, stolen: 0, exec0: 0, exec1: 0, total: 0}

fn ws_steal_if_needed(pool) = let n0 = art_len(pool.q0) in let n1 = art_len(pool.q1) in if n0 == 0 and n1 >= 2 then (let half = n1 / 2 in {q0: art_drop(pool.q1, n1 - half), q1: art_take(pool.q1, n1 - half), stolen: pool.stolen + half, exec0: pool.exec0, exec1: pool.exec1, total: pool.total}) else if n1 == 0 and n0 >= 2 then (let half = n0 / 2 in {q0: art_take(pool.q0, n0 - half), q1: art_drop(pool.q0, n0 - half), stolen: pool.stolen + half, exec0: pool.exec0, exec1: pool.exec1, total: pool.total}) else pool

fn ws_pop_one(q) = match q
    Nil        => {has: 0, v: 0, rest: Nil}
    Cons(h, t) => {has: 1, v: h, rest: t}

fn ws_step(pool) = let b = ws_steal_if_needed(pool) in let p0 = ws_pop_one(b.q0) in let p1 = ws_pop_one(b.q1) in {q0: p0.rest, q1: p1.rest, stolen: b.stolen, exec0: b.exec0 + p0.has, exec1: b.exec1 + p1.has, total: b.total + p0.v + p1.v}

fn ws_run_all(pool) = if art_len(pool.q0) == 0 and art_len(pool.q1) == 0 then pool else ws_run_all(ws_step(pool))

## --- 3. Native Kernel `epoll` Readiness Event Loop (`epoll_create1`/`epoll_ctl`/`epoll_wait`) ---
fn reactor_epoll_pipe_exchange(v1, v2) = let epfd = epoll_create_fd() in let pk1 = os_pipe_new() in let rfd1 = pk1 / 10000 in let wfd1 = pk1 % 10000 in let pk2 = os_pipe_new() in let rfd2 = pk2 / 10000 in let wfd2 = pk2 % 10000 in let a1 = epoll_add_in(epfd, rfd1, 101) in let a2 = epoll_add_in(epfd, rfd2, 202) in let w2 = os_pipe_write_int(wfd2, v2) in let ev1 = epoll_wait_one(epfd, 1000) in let got2 = os_pipe_read_int(rfd2) in let w1 = os_pipe_write_int(wfd1, v1) in let ev2 = epoll_wait_one(epfd, 1000) in let got1 = os_pipe_read_int(rfd1) in let z1 = net_close(rfd1) in let z2 = net_close(wfd1) in let z3 = net_close(rfd2) in let z4 = net_close(wfd2) in let z5 = net_close(epfd) in let tag1 = ev1 % 1000 in let tag2 = ev2 % 1000 in {ok: if tag1 == 202 and got2 == v2 and tag2 == 101 and got1 == v1 then 1 else 0, tag1: tag1, val1: got2, tag2: tag2, val2: got1}

## --- Unit tests (`lume test compiler/stage1/async_rt.src`) ---
fn test_reactor_io_readiness_and_wakeup() = let r0 = reactor_new(8) in let s1 = reactor_submit_io(r0, 10, 3, 2) in let s2 = reactor_submit_io(s1.rt, 20, 4, 5) in let r_w1 = reactor_notify_fd_ready(s2.rt, 4, 11) in let r_d1 = reactor_drain_ready(r_w1) in let r_w2 = reactor_notify_fd_ready(r_d1, 3, 15) in let r_d2 = reactor_drain_ready(r_w2) in r_d1.inflight == 1 and reactor_completed_val(r_d1.completed, 20) == 55 and r_d2.inflight == 0 and reactor_completed_val(r_d2.completed, 10) == 30

fn test_reactor_timer_wheel_deadline_ordering() = let r0 = reactor_new(8) in let t1 = reactor_schedule_timer(r0, 1, 50, 500) in let t2 = reactor_schedule_timer(t1.rt, 2, 10, 100) in let t3 = reactor_schedule_timer(t2.rt, 3, 30, 300) in let c25 = reactor_drain_ready(reactor_advance_clock(t3.rt, 25)) in let c60 = reactor_drain_ready(reactor_advance_clock(c25, 60)) in art_len(c25.completed) == 1 and reactor_first_completed_id(c25.completed) == 2 and art_len(c60.completed) == 3 and reactor_completed_val(c60.completed, 3) == 300 and reactor_completed_val(c60.completed, 1) == 500 and c60.inflight == 0

fn test_reactor_bounded_backpressure_rejection() = let r0 = reactor_new(2) in let s1 = reactor_submit_io(r0, 1, 10, 1) in let s2 = reactor_submit_io(s1.rt, 2, 11, 1) in let s3 = reactor_submit_io(s2.rt, 3, 12, 1) in let drained = reactor_drain_ready(reactor_notify_fd_ready(s3.rt, 10, 42)) in let s4 = reactor_submit_io(drained, 4, 13, 1) in s1.ok == 1 and s2.ok == 1 and s3.ok == 0 and (s3.rt).rejected == 1 and s4.ok == 1 and (s4.rt).inflight == 2

fn test_work_stealing_scheduler_load_balance() = let heavy = Cons(10, Cons(20, Cons(30, Cons(40, Cons(50, Cons(60, Nil)))))) in let pool0 = ws_pool_new(heavy, Nil) in let done = ws_run_all(pool0) in done.stolen >= 2 and done.exec0 >= 2 and done.exec1 >= 2 and done.total == 210

fn test_reactor_mixed_io_and_timers_scale() = let r0 = reactor_new(16) in let a1 = reactor_submit_io(r0, 101, 7, 3) in let a2 = reactor_schedule_timer(a1.rt, 102, 15, 77) in let a3 = reactor_submit_io(a2.rt, 103, 7, 4) in let a4 = reactor_schedule_timer(a3.rt, 104, 5, 88) in let step1 = reactor_drain_ready(reactor_advance_clock(a4.rt, 10)) in let step2 = reactor_drain_ready(reactor_notify_fd_ready(step1, 7, 10)) in let step3 = reactor_drain_ready(reactor_advance_clock(step2, 20)) in step1.inflight == 3 and step2.inflight == 1 and step3.inflight == 0 and reactor_completed_val(step3.completed, 101) == 30 and reactor_completed_val(step3.completed, 103) == 40 and reactor_completed_val(step3.completed, 102) == 77 and reactor_completed_val(step3.completed, 104) == 88
