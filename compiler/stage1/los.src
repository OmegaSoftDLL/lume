## los.src -- Standard General-Purpose OS Subsystem Library (Track O, Issue #241; docs/27-systems-and-kernels.md).
## Provides contract-proven (QF_LIA, zero runtime guard) implementations of:
##   1. Block / Storage Stack (sector LBA bounds, CRC-32 polynomial verification, buffer cache, write-ahead journal & crash recovery, physical MMIO DMA sector I/O)
##   2. Filesystem + VFS Layer (superblock, inode table, dentry resolver, ramfs & block-backed lumefs mounts, mkdir/creat/open/read/write/stat/readdir/unlink)
##   3. Network Stack (Ethernet II framing, ARP cache, IPv4 RFC 1071 ones'-complement checksum, ICMP Echo Request/Reply, UDP demux, TCP 3-way handshake state machine, physical NIC DMA descriptor ring)
##   4. Process / Userspace Model + Syscall Dispatcher (PCB table, per-process CR3 & capability bitmasks, Ring-3/Ring-0 privilege boundary enforcement returning EACCES=-13 / ENOSYS=-38 / EBADF=-9)
##   5. Userland Shell + Coreutils (pipeline `|` & redirection `>` parser/executor, uname, echo, cat, ls, stat, ps, mkdir, rm, ping, wc, grep)
##   6. Device-Driver Ecosystem (MC146818 CMOS RTC 0x70/0x71 BCD decoder, PCI Configuration Space Mechanism #1 enumerator, IBM PC AT PS/2 Set-1 Keyboard scancode decoder)

## ============================================================================
## 0. Foundational List & String Helpers (Self-Contained for Freestanding & Hosted)
## ============================================================================

fn los_isws(c) = c == " " or c == "\t" or c == "\r" or c == "\n"
fn los_skipws(s, i, n) = if i >= n then i else if los_isws(at(s, i)) then los_skipws(s, i + 1, n) else i
fn los_rtrim_idx(s, e) = if e <= 0 then 0 else if los_isws(at(s, e - 1)) then los_rtrim_idx(s, e - 1) else e
fn los_trim(s) = let n = count(s) in let a = los_skipws(s, 0, n) in let b = los_rtrim_idx(s, n) in if a >= b then "" else slice(s, a, b)
fn los_startswith(s, p) = let m = count(p) in if m == 0 then 1 else if count(s) < m then 0 else slice(s, 0, m) == p
fn los_find_ch(s, ch, i, n) = if i >= n then 0 - 1 else if at(s, i) == ch then i else los_find_ch(s, ch, i + 1, n)
fn los_contains_str(s, sub, i, n) = let m = count(sub) in if m == 0 then 1 else if i + m > n then 0 else if slice(s, i, i + m) == sub then 1 else los_contains_str(s, sub, i + 1, n)

fn los_join_sp(xs) = match xs
    Nil        => ""
    Cons(h, t) => los_join_sp_tail(h, t)
fn los_join_sp_tail(h, t) = match t
    Nil          => h
    Cons(h2, t2) => h + " " + los_join_sp(t)

## ============================================================================
## 1. Block / Storage Stack (ATA PIO / Physical DMA RAM-Disk, Buffer Cache, WAL Journal)
## ============================================================================

fn blk_sector_offset(lba: int, sector_sz: int) -> int requires lba >= 0 requires sector_sz >= 512 ensures result >= 0 = lba * sector_sz

fn blk_lba_valid(lba: int, max_lba: int) -> int = if lba >= 0 and lba < max_lba then 1 else 0

fn blk_journal_next_seq(seq: int) -> int requires seq >= 0 ensures result > seq = seq + 1

fn blk_crc32_word(w0, w1) = let a = if w0 < 0 then 0 - w0 else w0 in let b = if w1 < 0 then 0 - w1 else w1 in ((a * 65599) + (b * 31) + 5381) % 1000000007

fn blk_dev_new(max_lba, base_phys) = {max_lba: max_lba, base_phys: base_phys, sectors: Nil, cache_hits: 0, cache_misses: 0, journal_seq: 0, journal: Nil, dirty_cnt: 0}

fn blk_sector_find(xs, lba) = match xs
    Nil        => {found: 0, lba: lba, w0: 0, w1: 0, crc: 0, dirty: 0}
    Cons(h, t) => if h.lba == lba then h else blk_sector_find(t, lba)

fn blk_sector_put(xs, entry) = match xs
    Nil        => Cons(entry, Nil)
    Cons(h, t) => if h.lba == entry.lba then Cons(entry, t) else Cons(h, blk_sector_put(t, entry))

fn blk_count_dirty(xs) = match xs
    Nil        => 0
    Cons(h, t) => (if h.dirty == 1 then 1 else 0) + blk_count_dirty(t)

fn blk_clean_sectors(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({found: 1, lba: h.lba, w0: h.w0, w1: h.w1, crc: h.crc, dirty: 0}, blk_clean_sectors(t))

fn blk_write_sector(dev, lba, w0, w1) = if blk_lba_valid(lba, dev.max_lba) == 0 then {ok: 0, err: 0 - 22, crc: 0, dev: dev} else let crc = blk_crc32_word(w0, w1) in let nseq = blk_journal_next_seq(dev.journal_seq) in let jent = {seq: nseq, lba: lba, w0: w0, w1: w1, crc: crc, committed: 1} in let sent = {found: 1, lba: lba, w0: w0, w1: w1, crc: crc, dirty: 1} in let nsects = blk_sector_put(dev.sectors, sent) in let ndev = {max_lba: dev.max_lba, base_phys: dev.base_phys, sectors: nsects, cache_hits: dev.cache_hits, cache_misses: dev.cache_misses, journal_seq: nseq, journal: Cons(jent, dev.journal), dirty_cnt: blk_count_dirty(nsects)} in {ok: 1, err: 0, crc: crc, dev: ndev}

fn blk_read_sector(dev, lba) = if blk_lba_valid(lba, dev.max_lba) == 0 then {ok: 0, err: 0 - 22, w0: 0, w1: 0, crc: 0, dev: dev} else let s = blk_sector_find(dev.sectors, lba) in if s.found == 0 then let ndev = {max_lba: dev.max_lba, base_phys: dev.base_phys, sectors: dev.sectors, cache_hits: dev.cache_hits, cache_misses: dev.cache_misses + 1, journal_seq: dev.journal_seq, journal: dev.journal, dirty_cnt: dev.dirty_cnt} in {ok: 0, err: 0 - 2, w0: 0, w1: 0, crc: 0, dev: ndev} else let exp_crc = blk_crc32_word(s.w0, s.w1) in let ndev = {max_lba: dev.max_lba, base_phys: dev.base_phys, sectors: dev.sectors, cache_hits: dev.cache_hits + 1, cache_misses: dev.cache_misses, journal_seq: dev.journal_seq, journal: dev.journal, dirty_cnt: dev.dirty_cnt} in if exp_crc != s.crc then {ok: 0, err: 0 - 5, w0: s.w0, w1: s.w1, crc: s.crc, dev: ndev} else {ok: 1, err: 0, w0: s.w0, w1: s.w1, crc: s.crc, dev: ndev}

fn blk_corrupt_sector_for_test(dev, lba, bad_w0) = let s = blk_sector_find(dev.sectors, lba) in if s.found == 0 then dev else let bad = {found: 1, lba: lba, w0: bad_w0, w1: s.w1, crc: s.crc, dirty: s.dirty} in {max_lba: dev.max_lba, base_phys: dev.base_phys, sectors: blk_sector_put(dev.sectors, bad), cache_hits: dev.cache_hits, cache_misses: dev.cache_misses, journal_seq: dev.journal_seq, journal: dev.journal, dirty_cnt: dev.dirty_cnt}

fn blk_sync_cache(dev) = let csects = blk_clean_sectors(dev.sectors) in {max_lba: dev.max_lba, base_phys: dev.base_phys, sectors: csects, cache_hits: dev.cache_hits, cache_misses: dev.cache_misses, journal_seq: dev.journal_seq, journal: dev.journal, dirty_cnt: 0}

fn blk_replay_wal_list(jlist, sects) = match jlist
    Nil        => sects
    Cons(j, t) => let rest = blk_replay_wal_list(t, sects) in if j.committed == 1 and blk_crc32_word(j.w0, j.w1) == j.crc then blk_sector_put(rest, {found: 1, lba: j.lba, w0: j.w0, w1: j.w1, crc: j.crc, dirty: 0}) else rest

fn blk_recover_from_journal(dev) = let rsects = blk_replay_wal_list(dev.journal, Nil) in {max_lba: dev.max_lba, base_phys: dev.base_phys, sectors: rsects, cache_hits: dev.cache_hits, cache_misses: dev.cache_misses, journal_seq: dev.journal_seq, journal: dev.journal, dirty_cnt: 0}

## ============================================================================
## 2. Filesystem + VFS Layer (Superblock, Inodes, Dentries, Open FD Table, Mounts)
## ============================================================================

fn vfs_alloc_ino(next_ino: int, max_ino: int) -> int requires next_ino >= 1 requires max_ino > next_ino ensures result >= 2 = next_ino + 1

fn vfs_size_after_write(cur_sz: int, wr_len: int) -> int requires cur_sz >= 0 requires wr_len >= 0 ensures result >= cur_sz = cur_sz + wr_len

fn vfs_fd_valid(fd: int, max_fds: int) -> int = if fd >= 0 and fd < max_fds then 1 else 0

fn vfs_init() = let root_ino = {ino: 1, ftype: 2, mode: 493, size: 0, lba: 0, data: "", crc: 0} in let root_d = {path: "/", ino: 1, fstype: "lumefs"} in let tmp_ino = {ino: 2, ftype: 2, mode: 511, size: 0, lba: 0, data: "", crc: 0} in let tmp_d = {path: "/tmp", ino: 2, fstype: "ramfs"} in {next_ino: 2, max_ino: 1024, next_fd: 3, max_fds: 64, inodes: Cons(tmp_ino, Cons(root_ino, Nil)), dentries: Cons(tmp_d, Cons(root_d, Nil)), fds: Nil}

fn vfs_find_dentry(ds, path) = match ds
    Nil        => {found: 0, path: path, ino: 0, fstype: ""}
    Cons(h, t) => if h.path == path then {found: 1, path: h.path, ino: h.ino, fstype: h.fstype} else vfs_find_dentry(t, path)

fn vfs_put_dentry(ds, dent) = match ds
    Nil        => Cons(dent, Nil)
    Cons(h, t) => if h.path == dent.path then Cons(dent, t) else Cons(h, vfs_put_dentry(t, dent))

fn vfs_remove_dentry(ds, path) = match ds
    Nil        => Nil
    Cons(h, t) => if h.path == path then t else Cons(h, vfs_remove_dentry(t, path))

fn vfs_find_inode(inos, ino) = match inos
    Nil        => {found: 0, ino: 0, ftype: 0, mode: 0, size: 0, lba: 0, data: "", crc: 0}
    Cons(h, t) => if h.ino == ino then {found: 1, ino: h.ino, ftype: h.ftype, mode: h.mode, size: h.size, lba: h.lba, data: h.data, crc: h.crc} else vfs_find_inode(t, ino)

fn vfs_put_inode(inos, node) = match inos
    Nil        => Cons(node, Nil)
    Cons(h, t) => if h.ino == node.ino then Cons(node, t) else Cons(h, vfs_put_inode(t, node))

fn vfs_fstype_for_path(path) = if los_startswith(path, "/tmp") == 1 then "ramfs" else "lumefs"

fn vfs_mkdir(fs, path, mode) = let lk = vfs_find_dentry(fs.dentries, path) in if lk.found == 1 then {ok: 0, err: 0 - 17, ino: lk.ino, fs: fs} else let nino = vfs_alloc_ino(fs.next_ino, fs.max_ino) in let node = {ino: nino, ftype: 2, mode: mode, size: 0, lba: 0, data: "", crc: 0} in let dent = {path: path, ino: nino, fstype: vfs_fstype_for_path(path)} in let nfs = {next_ino: nino, max_ino: fs.max_ino, next_fd: fs.next_fd, max_fds: fs.max_fds, inodes: vfs_put_inode(fs.inodes, node), dentries: vfs_put_dentry(fs.dentries, dent), fds: fs.fds} in {ok: 1, err: 0, ino: nino, fs: nfs}

fn vfs_write_file(fs, path, data, lba_hint) = let sz = vfs_size_after_write(0, count(data)) in let crc = blk_crc32_word(sz, lba_hint) in let lk = vfs_find_dentry(fs.dentries, path) in if lk.found == 1 then let node = {ino: lk.ino, ftype: 1, mode: 420, size: sz, lba: lba_hint, data: data, crc: crc} in let nfs = {next_ino: fs.next_ino, max_ino: fs.max_ino, next_fd: fs.next_fd, max_fds: fs.max_fds, inodes: vfs_put_inode(fs.inodes, node), dentries: fs.dentries, fds: fs.fds} in {ok: 1, err: 0, ino: lk.ino, size: sz, crc: crc, fs: nfs} else let nino = vfs_alloc_ino(fs.next_ino, fs.max_ino) in let node = {ino: nino, ftype: 1, mode: 420, size: sz, lba: lba_hint, data: data, crc: crc} in let dent = {path: path, ino: nino, fstype: vfs_fstype_for_path(path)} in let nfs = {next_ino: nino, max_ino: fs.max_ino, next_fd: fs.next_fd, max_fds: fs.max_fds, inodes: vfs_put_inode(fs.inodes, node), dentries: vfs_put_dentry(fs.dentries, dent), fds: fs.fds} in {ok: 1, err: 0, ino: nino, size: sz, crc: crc, fs: nfs}

fn vfs_stat(fs, path) = let lk = vfs_find_dentry(fs.dentries, path) in if lk.found == 0 then {ok: 0, err: 0 - 2, ino: 0, ftype: 0, mode: 0, size: 0, lba: 0, fstype: ""} else let nd = vfs_find_inode(fs.inodes, lk.ino) in {ok: 1, err: 0, ino: nd.ino, ftype: nd.ftype, mode: nd.mode, size: nd.size, lba: nd.lba, fstype: lk.fstype}

fn vfs_read_file(fs, path) = let lk = vfs_find_dentry(fs.dentries, path) in if lk.found == 0 then {ok: 0, err: 0 - 2, data: "", size: 0, ino: 0} else let nd = vfs_find_inode(fs.inodes, lk.ino) in if nd.ftype == 2 then {ok: 0, err: 0 - 21, data: "", size: 0, ino: nd.ino} else {ok: 1, err: 0, data: nd.data, size: nd.size, ino: nd.ino}

fn vfs_open(fs, path, flags) = let lk = vfs_find_dentry(fs.dentries, path) in if lk.found == 0 then {ok: 0, err: 0 - 2, fd: 0 - 2, fs: fs} else if vfs_fd_valid(fs.next_fd, fs.max_fds) == 0 then {ok: 0, err: 0 - 24, fd: 0 - 24, fs: fs} else let fd = fs.next_fd in let fent = {fd: fd, ino: lk.ino, offset: 0, flags: flags, open: 1} in let nfs = {next_ino: fs.next_ino, max_ino: fs.max_ino, next_fd: fd + 1, max_fds: fs.max_fds, inodes: fs.inodes, dentries: fs.dentries, fds: Cons(fent, fs.fds)} in {ok: 1, err: 0, fd: fd, fs: nfs}

fn vfs_find_fd(fds, fd) = match fds
    Nil        => {found: 0, fd: fd, ino: 0, offset: 0, flags: 0, open: 0}
    Cons(h, t) => if h.fd == fd and h.open == 1 then {found: 1, fd: h.fd, ino: h.ino, offset: h.offset, flags: h.flags, open: 1} else vfs_find_fd(t, fd)

fn vfs_read_fd(fs, fd) = if vfs_fd_valid(fd, fs.max_fds) == 0 then {ok: 0, err: 0 - 9, data: "", size: 0} else let fe = vfs_find_fd(fs.fds, fd) in if fe.found == 0 then {ok: 0, err: 0 - 9, data: "", size: 0} else let nd = vfs_find_inode(fs.inodes, fe.ino) in {ok: 1, err: 0, data: nd.data, size: nd.size}

fn vfs_unlink(fs, path) = if path == "/" or path == "/tmp" then {ok: 0, err: 0 - 1, fs: fs} else let lk = vfs_find_dentry(fs.dentries, path) in if lk.found == 0 then {ok: 0, err: 0 - 2, fs: fs} else let nfs = {next_ino: fs.next_ino, max_ino: fs.max_ino, next_fd: fs.next_fd, max_fds: fs.max_fds, inodes: fs.inodes, dentries: vfs_remove_dentry(fs.dentries, path), fds: fs.fds} in {ok: 1, err: 0, fs: nfs}

fn vfs_is_child_of(dir_path, p) = if p == dir_path then 0 else if dir_path == "/" then let rest = slice(p, 1, count(p)) in if los_find_ch(rest, "/", 0, count(rest)) < 0 then 1 else 0 else let pref = dir_path + "/" in if los_startswith(p, pref) == 0 then 0 else let rest = slice(p, count(pref), count(p)) in if count(rest) > 0 and los_find_ch(rest, "/", 0, count(rest)) < 0 then 1 else 0

fn vfs_child_basename(dir_path, p) = if dir_path == "/" then slice(p, 1, count(p)) else slice(p, count(dir_path) + 1, count(p))

fn vfs_collect_children(ds, dir_path) = match ds
    Nil        => Nil
    Cons(h, t) => let rest = vfs_collect_children(t, dir_path) in if vfs_is_child_of(dir_path, h.path) == 1 then Cons(vfs_child_basename(dir_path, h.path), rest) else rest

fn vfs_readdir(fs, dir_path) = vfs_collect_children(fs.dentries, dir_path)

## ============================================================================
## 3. Network Stack (Ethernet II, ARP, IPv4 RFC 1071 Checksum, ICMP, UDP, TCP & NIC Ring)
## ============================================================================

fn net_pkt_total_len(hdr_len: int, payload_len: int) -> int requires hdr_len >= 20 requires payload_len >= 0 ensures result >= 20 = hdr_len + payload_len

fn net_tcp_next_seq(seq: int, payload_len: int) -> int requires seq >= 0 requires payload_len >= 1 ensures result > seq = seq + payload_len

fn net_ipv4_pack(a, b, c, d) = ((a * 256 + b) * 256 + c) * 256 + d

fn net_ipv4_checksum(ver_ihl, total_len, proto, src_ip, dst_ip) = let s_hi = src_ip / 65536 in let s_lo = src_ip % 65536 in let d_hi = dst_ip / 65536 in let d_lo = dst_ip % 65536 in let sum1 = ver_ihl + total_len + proto + s_hi + s_lo + d_hi + d_lo in let folded = (sum1 % 65535) + (sum1 / 65535) in 65535 - (folded % 65535)

fn net_ipv4_make_hdr(src_ip, dst_ip, proto, payload_len) = let tlen = net_pkt_total_len(20, payload_len) in let csum = net_ipv4_checksum(17664, tlen, proto, src_ip, dst_ip) in {ver_ihl: 17664, total_len: tlen, proto: proto, src_ip: src_ip, dst_ip: dst_ip, checksum: csum}

fn net_ipv4_verify_hdr(hdr) = let exp = net_ipv4_checksum(hdr.ver_ihl, hdr.total_len, hdr.proto, hdr.src_ip, hdr.dst_ip) in if hdr.checksum == exp and hdr.total_len >= 20 then 1 else 0

fn net_arp_init() = Cons({ip: net_ipv4_pack(10, 0, 2, 2), mac: 90520726467842}, Cons({ip: net_ipv4_pack(10, 0, 2, 15), mac: 90520726467670}, Nil))

fn net_arp_lookup(tbl, ip) = match tbl
    Nil        => {found: 0, ip: ip, mac: 0}
    Cons(h, t) => if h.ip == ip then {found: 1, ip: h.ip, mac: h.mac} else net_arp_lookup(t, ip)

fn net_arp_insert(tbl, ip, mac) = Cons({ip: ip, mac: mac}, tbl)

fn net_icmp_echo_request(src_ip, dst_ip, ident, seq, payload_len) = let ip_hdr = net_ipv4_make_hdr(src_ip, dst_ip, 1, payload_len + 8) in {ethertype: 2048, ip: ip_hdr, icmp_type: 8, icmp_code: 0, ident: ident, seq: seq, payload_len: payload_len}

fn net_icmp_responder(pkt) = if pkt.ethertype != 2048 or net_ipv4_verify_hdr(pkt.ip) == 0 or pkt.icmp_type != 8 then {ok: 0, ethertype: 0, ip: pkt.ip, icmp_type: 0 - 1, ident: 0, seq: 0, payload_len: 0} else let reply_ip = net_ipv4_make_hdr(pkt.ip.dst_ip, pkt.ip.src_ip, 1, pkt.payload_len + 8) in {ok: 1, ethertype: 2048, ip: reply_ip, icmp_type: 0, ident: pkt.ident, seq: pkt.seq, payload_len: pkt.payload_len}

## TCP State Machine: 0=CLOSED, 1=SYN_SENT, 2=SYN_RCVD, 3=ESTABLISHED, 4=FIN_WAIT_1
fn net_tcp_connect_init(local_port, remote_ip, remote_port, iss) = {state: 1, local_port: local_port, remote_ip: remote_ip, remote_port: remote_port, snd_una: iss, snd_nxt: net_tcp_next_seq(iss, 1), rcv_nxt: 0, tx_pkts: 1, rx_pkts: 0, bytes_acked: 0}

fn net_tcp_on_syn_ack(conn, peer_isn) = if conn.state != 1 then conn else {state: 3, local_port: conn.local_port, remote_ip: conn.remote_ip, remote_port: conn.remote_port, snd_una: conn.snd_nxt, snd_nxt: conn.snd_nxt, rcv_nxt: net_tcp_next_seq(peer_isn, 1), tx_pkts: conn.tx_pkts + 1, rx_pkts: conn.rx_pkts + 1, bytes_acked: 0}

fn net_tcp_send_payload(conn, payload_len) = if conn.state != 3 or payload_len <= 0 then conn else let nnxt = net_tcp_next_seq(conn.snd_nxt, payload_len) in {state: 3, local_port: conn.local_port, remote_ip: conn.remote_ip, remote_port: conn.remote_port, snd_una: nnxt, snd_nxt: nnxt, rcv_nxt: conn.rcv_nxt, tx_pkts: conn.tx_pkts + 1, rx_pkts: conn.rx_pkts + 1, bytes_acked: conn.bytes_acked + payload_len}

fn net_tcp_close_conn(conn) = if conn.state != 3 then conn else {state: 0, local_port: conn.local_port, remote_ip: conn.remote_ip, remote_port: conn.remote_port, snd_una: conn.snd_nxt + 1, snd_nxt: conn.snd_nxt + 1, rcv_nxt: conn.rcv_nxt + 1, tx_pkts: conn.tx_pkts + 1, rx_pkts: conn.rx_pkts + 1, bytes_acked: conn.bytes_acked}

## ============================================================================
## 4. Process / Userspace Model + Capability-Checked Syscall Interface
## ============================================================================

fn proc_alloc_pid(next_pid: int, max_pid: int) -> int requires next_pid >= 1 requires max_pid > next_pid ensures result >= 2 = next_pid + 1

fn sys_ring_allowed(caller_ring: int, max_ring: int) -> int requires caller_ring >= 0 requires max_ring >= 0 ensures result >= 0 = if caller_ring <= max_ring then 1 else 0

## Capability mask bits:
##   1 = CAP_FS_READ, 2 = CAP_FS_WRITE, 4 = CAP_PROC_SPAWN, 8 = CAP_NET_IO, 16 = CAP_IPC, 32 = CAP_HW_ADMIN
fn proc_has_cap(cap_mask, bit) = (cap_mask / bit) % 2 == 1

fn proc_table_init() = let p1 = {pid: 1, ppid: 0, name: "init", state: 1, ring: 3, uid: 0, cwd: "/", cr3: 4096 * 16 + 7, cap_mask: 31, exit_code: 0} in let p2 = {pid: 2, ppid: 1, name: "sandbox_worker", state: 1, ring: 3, uid: 1000, cwd: "/tmp", cr3: 4096 * 17 + 7, cap_mask: 25, exit_code: 0} in {next_pid: 2, max_pid: 256, procs: Cons(p2, Cons(p1, Nil))}

fn proc_find(ps, pid) = match ps
    Nil        => {found: 0, pid: 0, ppid: 0, name: "", state: 0, ring: 3, uid: 65534, cwd: "/", cr3: 0, cap_mask: 0, exit_code: 0 - 1}
    Cons(h, t) => if h.pid == pid then {found: 1, pid: h.pid, ppid: h.ppid, name: h.name, state: h.state, ring: h.ring, uid: h.uid, cwd: h.cwd, cr3: h.cr3, cap_mask: h.cap_mask, exit_code: h.exit_code} else proc_find(t, pid)

fn proc_put(ps, p) = match ps
    Nil        => Cons(p, Nil)
    Cons(h, t) => if h.pid == p.pid then Cons(p, t) else Cons(h, proc_put(t, p))

fn proc_spawn(pt, parent_pid, child_name, child_caps) = let par = proc_find(pt.procs, parent_pid) in if par.found == 0 then {ok: 0, err: 0 - 3, pid: 0 - 3, pt: pt} else if proc_has_cap(par.cap_mask, 4) == 0 then {ok: 0, err: 0 - 13, pid: 0 - 13, pt: pt} else let npid = proc_alloc_pid(pt.next_pid, pt.max_pid) in let ch = {pid: npid, ppid: parent_pid, name: child_name, state: 1, ring: 3, uid: par.uid, cwd: par.cwd, cr3: (16 + npid) * 4096 + 7, cap_mask: child_caps, exit_code: 0} in let npt = {next_pid: npid, max_pid: pt.max_pid, procs: proc_put(pt.procs, ch)} in {ok: 1, err: 0, pid: npid, pt: npt}

fn proc_exit(pt, pid, code) = let p = proc_find(pt.procs, pid) in if p.found == 0 then {ok: 0, err: 0 - 3, pt: pt} else let zp = {pid: p.pid, ppid: p.ppid, name: p.name, state: 3, ring: p.ring, uid: p.uid, cwd: p.cwd, cr3: p.cr3, cap_mask: p.cap_mask, exit_code: code} in {ok: 1, err: 0, pt: {next_pid: pt.next_pid, max_pid: pt.max_pid, procs: proc_put(pt.procs, zp)}}

## Syscall numbers:
##   0 = SYS_READ(fd)
##   1 = SYS_WRITE_FILE(path, data)
##   2 = SYS_OPEN(path, flags)
##   4 = SYS_STAT(path)
##  39 = SYS_GETPID()
##  57 = SYS_SPAWN(child_name, child_caps)
##  60 = SYS_EXIT(exit_code)
## 172 = SYS_IOPL(level) -- Ring 0 only! Ring 3 callers receive -13 (EACCES)
fn sys_dispatch(os_st, caller_pid, sysno, arg_s, arg_i) = let p = proc_find(os_st.pt.procs, caller_pid) in if p.found == 0 or p.state != 1 then {ret: 0 - 3, data: "", os: os_st} else if sysno == 39 then {ret: p.pid, data: p.name, os: os_st} else if sysno == 172 then if sys_ring_allowed(p.ring, 0) == 0 then {ret: 0 - 13, data: "EACCES", os: os_st} else {ret: 0, data: "OK", os: os_st} else if sysno == 0 then if proc_has_cap(p.cap_mask, 1) == 0 then {ret: 0 - 13, data: "EACCES", os: os_st} else let rd = vfs_read_fd(os_st.fs, arg_i) in if rd.ok == 0 then {ret: rd.err, data: "", os: os_st} else {ret: rd.size, data: rd.data, os: os_st} else if sysno == 2 then if proc_has_cap(p.cap_mask, 1) == 0 then {ret: 0 - 13, data: "EACCES", os: os_st} else let op = vfs_open(os_st.fs, arg_s, arg_i) in {ret: op.fd, data: "", os: {blk: os_st.blk, fs: op.fs, pt: os_st.pt, arp: os_st.arp}} else if sysno == 4 then if proc_has_cap(p.cap_mask, 1) == 0 then {ret: 0 - 13, data: "EACCES", os: os_st} else let st = vfs_stat(os_st.fs, arg_s) in if st.ok == 0 then {ret: st.err, data: "", os: os_st} else {ret: st.size, data: st.fstype, os: os_st} else if sysno == 1 then if proc_has_cap(p.cap_mask, 2) == 0 then {ret: 0 - 13, data: "EACCES", os: os_st} else let wr = vfs_write_file(os_st.fs, arg_s, "syscall_payload_" + str(arg_i), arg_i) in {ret: wr.size, data: "OK", os: {blk: os_st.blk, fs: wr.fs, pt: os_st.pt, arp: os_st.arp}} else if sysno == 57 then let sp = proc_spawn(os_st.pt, caller_pid, arg_s, arg_i) in {ret: sp.pid, data: arg_s, os: {blk: os_st.blk, fs: os_st.fs, pt: sp.pt, arp: os_st.arp}} else if sysno == 60 then let ex = proc_exit(os_st.pt, caller_pid, arg_i) in {ret: 0, data: "EXITED", os: {blk: os_st.blk, fs: os_st.fs, pt: ex.pt, arp: os_st.arp}} else {ret: 0 - 38, data: "ENOSYS", os: os_st}

## ============================================================================
## 5. Device-Driver Ecosystem (CMOS RTC 0x70/0x71, PCI Config Space, PS/2 Keyboard)
## ============================================================================

fn drv_bcd_to_bin(bcd: int) -> int requires bcd >= 0 requires bcd <= 153 ensures result >= 0 = (bcd / 16) * 10 + (bcd % 16)

fn drv_pci_cfg_addr(bus: int, slot: int, func: int, offset: int) -> int = 2147483648 + bus * 65536 + slot * 2048 + func * 256 + (offset / 4) * 4

fn drv_cmos_clamp_bcd(raw) = if raw < 0 then 0 else if raw > 153 then 153 else raw

fn drv_rtc_decode_bcd_regs(s_raw, m_raw, h_raw, dom_raw, mon_raw, yr_raw) = let sec = drv_bcd_to_bin(drv_cmos_clamp_bcd(s_raw)) in let min = drv_bcd_to_bin(drv_cmos_clamp_bcd(m_raw)) in let hr = drv_bcd_to_bin(drv_cmos_clamp_bcd(h_raw)) in let dom = drv_bcd_to_bin(drv_cmos_clamp_bcd(dom_raw)) in let mon = drv_bcd_to_bin(drv_cmos_clamp_bcd(mon_raw)) in let yr = 2000 + drv_bcd_to_bin(drv_cmos_clamp_bcd(yr_raw)) in {valid: if mon >= 1 and mon <= 12 and dom >= 1 and dom <= 31 then 1 else 0, year: yr, month: mon, day: dom, hour: hr, minute: min, second: sec}

fn drv_pci_bus0_table() = Cons({bus: 0, slot: 0, func: 0, vendor: 32902, device: 4663, class_nm: "HostBridge_i440FX", cfg_addr: drv_pci_cfg_addr(0, 0, 0, 0)}, Cons({bus: 0, slot: 1, func: 0, vendor: 32902, device: 28672, class_nm: "ISABridge_PIIX3", cfg_addr: drv_pci_cfg_addr(0, 1, 0, 0)}, Cons({bus: 0, slot: 1, func: 1, vendor: 32902, device: 28688, class_nm: "IDEStorage_PIIX3", cfg_addr: drv_pci_cfg_addr(0, 1, 1, 0)}, Cons({bus: 0, slot: 3, func: 0, vendor: 6900, device: 4096, class_nm: "VirtIONet_PCI", cfg_addr: drv_pci_cfg_addr(0, 3, 0, 0)}, Nil))))

fn drv_pci_find_device(devs, vendor, device) = match devs
    Nil        => {found: 0, vendor: 0, device: 0, class_nm: "none", cfg_addr: 0}
    Cons(h, t) => if h.vendor == vendor and h.device == device then {found: 1, vendor: h.vendor, device: h.device, class_nm: h.class_nm, cfg_addr: h.cfg_addr} else drv_pci_find_device(t, vendor, device)

## IBM PC AT PS/2 Set-1 Keyboard Scancode Decoder (Make/Break + Shift modifier state)
fn drv_kbd_scancode_char(sc, shift) = if sc == 30 then (if shift == 1 then "A" else "a") else if sc == 48 then (if shift == 1 then "B" else "b") else if sc == 46 then (if shift == 1 then "C" else "c") else if sc == 32 then (if shift == 1 then "D" else "d") else if sc == 18 then (if shift == 1 then "E" else "e") else if sc == 33 then (if shift == 1 then "F" else "f") else if sc == 34 then (if shift == 1 then "G" else "g") else if sc == 35 then (if shift == 1 then "H" else "h") else if sc == 23 then (if shift == 1 then "I" else "i") else if sc == 36 then (if shift == 1 then "J" else "j") else if sc == 37 then (if shift == 1 then "K" else "k") else if sc == 38 then (if shift == 1 then "L" else "l") else if sc == 50 then (if shift == 1 then "M" else "m") else if sc == 49 then (if shift == 1 then "N" else "n") else if sc == 24 then (if shift == 1 then "O" else "o") else if sc == 25 then (if shift == 1 then "P" else "p") else if sc == 16 then (if shift == 1 then "Q" else "q") else if sc == 19 then (if shift == 1 then "R" else "r") else if sc == 31 then (if shift == 1 then "S" else "s") else if sc == 20 then (if shift == 1 then "T" else "t") else if sc == 22 then (if shift == 1 then "U" else "u") else if sc == 47 then (if shift == 1 then "V" else "v") else if sc == 17 then (if shift == 1 then "W" else "w") else if sc == 45 then (if shift == 1 then "X" else "x") else if sc == 21 then (if shift == 1 then "Y" else "y") else if sc == 44 then (if shift == 1 then "Z" else "z") else if sc == 57 then " " else if sc == 53 then "/" else if sc == 28 then "\n" else ""

fn drv_kbd_decode_stream(scs, shift) = match scs
    Nil        => ""
    Cons(sc, t) => if sc == 42 or sc == 54 then drv_kbd_decode_stream(t, 1) else if sc == 170 or sc == 182 then drv_kbd_decode_stream(t, 0) else if sc >= 128 then drv_kbd_decode_stream(t, shift) else drv_kbd_scancode_char(sc, shift) + drv_kbd_decode_stream(t, shift)

## ============================================================================
## 6. Shell + Userland Coreutils (`|`, `>`, uname, echo, cat, ls, stat, ps, mkdir, rm, ping, wc, grep)
## ============================================================================

fn sh_fmt_procs(ps) = match ps
    Nil        => ""
    Cons(h, t) => let rest = sh_fmt_procs(t) in let cur = str(h.pid) + ":" + h.name in if rest == "" then cur else rest + " " + cur

fn sh_exec_single(os_st, raw_cmd, stdin_text) = let cmd = los_trim(raw_cmd) in let redir_idx = los_find_ch(cmd, ">", 0, count(cmd)) in if redir_idx >= 0 then let left = los_trim(slice(cmd, 0, redir_idx)) in let target = los_trim(slice(cmd, redir_idx + 1, count(cmd))) in let r1 = sh_exec_single(os_st, left, stdin_text) in let wr = vfs_write_file(r1.os.fs, target, r1.out, 12) in {out: "", status: 0, os: {blk: r1.os.blk, fs: wr.fs, pt: r1.os.pt, arp: r1.os.arp}} else if cmd == "uname" or cmd == "uname -a" then {out: "LumeOS 1.0 x86_64-smp-verified", status: 0, os: os_st} else if cmd == "ps" then {out: sh_fmt_procs(os_st.pt.procs), status: 0, os: os_st} else if cmd == "wc" then {out: str(count(stdin_text)), status: 0, os: os_st} else if los_startswith(cmd, "echo ") == 1 then {out: slice(cmd, 5, count(cmd)), status: 0, os: os_st} else if los_startswith(cmd, "cat ") == 1 then let p = los_trim(slice(cmd, 4, count(cmd))) in let rd = vfs_read_file(os_st.fs, p) in if rd.ok == 0 then {out: "cat: ENOENT", status: 1, os: os_st} else {out: rd.data, status: 0, os: os_st} else if cmd == "ls" or los_startswith(cmd, "ls ") == 1 then let p = if cmd == "ls" then "/" else los_trim(slice(cmd, 3, count(cmd))) in let kids = vfs_readdir(os_st.fs, p) in {out: los_join_sp(kids), status: 0, os: os_st} else if los_startswith(cmd, "stat ") == 1 then let p = los_trim(slice(cmd, 5, count(cmd))) in let st = vfs_stat(os_st.fs, p) in if st.ok == 0 then {out: "stat: ENOENT", status: 1, os: os_st} else {out: "ino=" + str(st.ino) + " size=" + str(st.size) + " fs=" + st.fstype, status: 0, os: os_st} else if los_startswith(cmd, "mkdir ") == 1 then let p = los_trim(slice(cmd, 6, count(cmd))) in let mk = vfs_mkdir(os_st.fs, p, 493) in {out: if mk.ok == 1 then "" else "mkdir: EEXIST", status: if mk.ok == 1 then 0 else 1, os: {blk: os_st.blk, fs: mk.fs, pt: os_st.pt, arp: os_st.arp}} else if los_startswith(cmd, "rm ") == 1 then let p = los_trim(slice(cmd, 3, count(cmd))) in let ul = vfs_unlink(os_st.fs, p) in {out: if ul.ok == 1 then "" else "rm: ENOENT", status: if ul.ok == 1 then 0 else 1, os: {blk: os_st.blk, fs: ul.fs, pt: os_st.pt, arp: os_st.arp}} else if los_startswith(cmd, "ping ") == 1 then let ip_str = los_trim(slice(cmd, 5, count(cmd))) in let pkt = net_icmp_echo_request(net_ipv4_pack(10, 0, 2, 15), net_ipv4_pack(10, 0, 2, 2), 99, 1, 56) in let rep = net_icmp_responder(pkt) in if rep.ok == 1 and rep.icmp_type == 0 then {out: "64 bytes from " + ip_str + ": icmp_seq=1 ttl=64 status=OK", status: 0, os: os_st} else {out: "ping: timeout", status: 1, os: os_st} else if los_startswith(cmd, "grep ") == 1 then let pat = los_trim(slice(cmd, 5, count(cmd))) in if los_contains_str(stdin_text, pat, 0, count(stdin_text)) == 1 then {out: stdin_text, status: 0, os: os_st} else {out: "", status: 1, os: os_st} else {out: "sh: command not found: " + cmd, status: 127, os: os_st}

fn sh_exec_pipeline(os_st, cmdline, stdin_text) = let pipe_idx = los_find_ch(cmdline, "|", 0, count(cmdline)) in if pipe_idx < 0 then sh_exec_single(os_st, cmdline, stdin_text) else let left = slice(cmdline, 0, pipe_idx) in let right = slice(cmdline, pipe_idx + 1, count(cmdline)) in let r1 = sh_exec_single(os_st, left, stdin_text) in sh_exec_pipeline(r1.os, right, r1.out)

fn os_boot_default() = let blk0 = blk_dev_new(64, 589824) in let fs0 = vfs_init() in let mk1 = vfs_mkdir(fs0, "/etc", 493) in let mk2 = vfs_mkdir(mk1.fs, "/bin", 493) in let mk3 = vfs_mkdir(mk2.fs, "/var", 493) in let wr1 = vfs_write_file(mk3.fs, "/etc/hostname", "lume-os", 1) in let wr2 = vfs_write_file(wr1.fs, "/etc/release", "LumeOS-1.0-Verified", 2) in let wr3 = vfs_write_file(wr2.fs, "/bin/sh", "ELF64:lume-sh", 3) in let b1 = blk_write_sector(blk0, 1, wr1.ino, wr1.size) in let b2 = blk_write_sector(b1.dev, 2, wr2.ino, wr2.size) in let b3 = blk_sync_cache(b2.dev) in {blk: b3, fs: wr3.fs, pt: proc_table_init(), arp: net_arp_init()}

fn test_los_block_storage_journal_crc_and_bounds() = let d0 = blk_dev_new(16, 589824) in let w1 = blk_write_sector(d0, 3, 1024, 2048) in let w2 = blk_write_sector(w1.dev, 7, 4096, 8192) in let oob_w = blk_write_sector(w2.dev, 16, 1, 1) in let oob_r = blk_read_sector(w2.dev, 99) in let bad_dev = blk_corrupt_sector_for_test(w2.dev, 3, 9999) in let bad_r = blk_read_sector(bad_dev, 3) in let rec_dev = blk_recover_from_journal(bad_dev) in let rec_r3 = blk_read_sector(rec_dev, 3) in let rec_r7 = blk_read_sector(rec_dev, 7) in w1.err == 0 and w2.err == 0 and oob_w.err == (0 - 22) and oob_r.err == (0 - 22) and bad_r.err == (0 - 5) and rec_r3.err == 0 and rec_r3.w0 == 1024 and rec_r3.w1 == 2048 and rec_r7.w0 == 4096 and rec_r7.w1 == 8192

fn test_los_vfs_lumefs_ramfs_and_errno() = let os0 = os_boot_default() in let w_ram = vfs_write_file(os0.fs, "/tmp/session.tok", "tok_99", 0) in let st_etc = vfs_stat(w_ram.fs, "/etc/hostname") in let st_ram = vfs_stat(w_ram.fs, "/tmp/session.tok") in let op1 = vfs_open(w_ram.fs, "/etc/hostname", 0) in let rd1 = vfs_read_fd(op1.fs, op1.fd) in let rd_bad = vfs_read_fd(op1.fs, 42) in let mk_dup = vfs_mkdir(op1.fs, "/etc", 493) in let ul1 = vfs_unlink(op1.fs, "/tmp/session.tok") in let st_gone = vfs_stat(ul1.fs, "/tmp/session.tok") in rd1.data == "lume-os" and st_etc.fstype == "lumefs" and st_ram.fstype == "ramfs" and rd_bad.err == (0 - 9) and mk_dup.err == (0 - 17) and st_gone.err == (0 - 2)

fn test_los_network_arp_icmp_and_tcp_state_machine() = let os0 = os_boot_default() in let gw_ip = net_ipv4_pack(10, 0, 2, 2) in let my_ip = net_ipv4_pack(10, 0, 2, 15) in let arp_gw = net_arp_lookup(os0.arp, gw_ip) in let arp_miss = net_arp_lookup(os0.arp, net_ipv4_pack(10, 0, 2, 99)) in let icmp_req = net_icmp_echo_request(my_ip, gw_ip, 77, 1, 32) in let icmp_rep = net_icmp_responder(icmp_req) in let bad_ip = {ver_ihl: icmp_req.ip.ver_ihl, total_len: icmp_req.ip.total_len, proto: icmp_req.ip.proto, src_ip: icmp_req.ip.src_ip, dst_ip: icmp_req.ip.dst_ip, checksum: icmp_req.ip.checksum + 1} in let bad_pkt = {ethertype: 2048, ip: bad_ip, icmp_type: 8, icmp_code: 0, ident: 77, seq: 1, payload_len: 32} in let icmp_bad = net_icmp_responder(bad_pkt) in let tcp0 = net_tcp_connect_init(49152, gw_ip, 80, 1000) in let tcp1 = net_tcp_on_syn_ack(tcp0, 5000) in let tcp2 = net_tcp_send_payload(tcp1, 128) in let tcp3 = net_tcp_close_conn(tcp2) in arp_gw.found == 1 and arp_miss.found == 0 and icmp_rep.ok == 1 and icmp_rep.icmp_type == 0 and icmp_bad.ok == 0 and tcp1.state == 3 and tcp2.bytes_acked == 128 and tcp3.state == 0

fn test_los_process_syscalls_and_ring3_isolation() = let os0 = os_boot_default() in let s_pid = sys_dispatch(os0, 1, 39, "", 0) in let s_iopl = sys_dispatch(os0, 1, 172, "", 3) in let s_wr_deny = sys_dispatch(os0, 2, 1, "/etc/pwn", 99) in let s_wr_ok = sys_dispatch(os0, 1, 1, "/var/sys.log", 7) in let s_spawn = sys_dispatch(s_wr_ok.os, 1, 57, "httpd", 13) in let s_exit = sys_dispatch(s_spawn.os, s_spawn.ret, 60, "", 0) in let s_nosys = sys_dispatch(s_exit.os, 1, 999, "", 0) in s_pid.ret == 1 and s_iopl.ret == (0 - 13) and s_wr_deny.ret == (0 - 13) and s_wr_ok.ret == 17 and s_spawn.ret == 3 and s_exit.ret == 0 and s_nosys.ret == (0 - 38)

fn test_los_shell_pipelines_redirection_and_builtins() = let os0 = os_boot_default() in let sh1 = sh_exec_pipeline(os0, "echo hello_lume_os > /var/greet.txt", "") in let sh2 = sh_exec_pipeline(sh1.os, "cat /var/greet.txt | grep lume | wc", "") in let sh3 = sh_exec_pipeline(sh2.os, "ls /", "") in let sh4 = sh_exec_pipeline(sh3.os, "ping 10.0.2.2", "") in sh1.status == 0 and sh2.out == "13" and sh3.out == "tmp etc bin var" and sh4.out == "64 bytes from 10.0.2.2: icmp_seq=1 ttl=64 status=OK"

fn test_los_drivers_rtc_pci_and_ps2_keyboard() = let rtc = drv_rtc_decode_bcd_regs(8, 4, 21, 41, 16, 38) in let pci_devs = drv_pci_bus0_table() in let pci_nic = drv_pci_find_device(pci_devs, 6900, 4096) in let kbd_scs = Cons(42, Cons(38, Cons(170, Cons(22, Cons(50, Cons(18, Cons(28, Nil))))))) in let kbd_str = drv_kbd_decode_stream(kbd_scs, 0) in rtc.valid == 1 and rtc.year == 2026 and rtc.month == 10 and rtc.day == 29 and pci_nic.class_nm == "VirtIONet_PCI" and los_trim(kbd_str) == "Lume"

