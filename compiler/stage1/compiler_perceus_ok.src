fn isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0

fn len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + len(t)

fn pairs(own xs) = match xs
    Nil        => Nil
    Cons(a, t) => pairs2(a, own t)

fn pairs2(a, own t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, pairs(own r))

fn joinall(own xs) = match xs
    Nil        => ""
    Cons(a, t) => if isnil(t) == 1 then a else joinall(own pairs2(a, own t))

fn geexpr(own e, gt) = match e
    Bin(op, a, b)  => Bin(op, geexpr(own a, gt), geexpr(own b, gt))
    Call(nm, args) => Call(nm, geargs(own args, gt))
    Rec(items)     => Rec(geargs(own items, gt))
    Field(o, nm)   => Field(geexpr(own o, gt), nm)
    CT(inner)      => CT(geexpr(own inner, gt))
    _              => e

fn geargs(own xs, gt) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(geexpr(own h, gt), geargs(own t, gt))

fn gestmt(own s0, gt) = match s0
    Fn(nm, ps, body) => Fn(nm, ps, geexpr(own body, gt))
    Print(v)         => Print(geexpr(own v, gt))
    ExprS(v)         => ExprS(geexpr(own v, gt))
    _                => s0

fn gestmts(own prog, gt) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(gestmt(own h, gt), gestmts(own t, gt))

fn eval_stmt(s) = match s
    Print(v) => eval_e(v)
    ExprS(v) => eval_e(v)
    _        => 0

fn eval_e(e) = match e
    Num(n)         => n
    Call(nm, args) => len(args) * 10 + eval_args(args)
    _              => 0

fn eval_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => eval_e(h) + eval_args(t)

fn sum_prog(prog) = match prog
    Nil        => 0
    Cons(h, t) => eval_stmt(h) + sum_prog(t)

fn run_join() = joinall(own Cons("lu", Cons("me", Cons("-", Cons("stage", Cons("-", Cons("d", Nil)))))))
fn run_erase() = sum_prog(gestmts(own Cons(Print(Call("id", Cons(Num(42), Nil))), Cons(ExprS(Call("id", Cons(Num(8), Nil))), Nil)), Nil))

print run_join()
print run_erase()
