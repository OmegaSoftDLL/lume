## ownership.src -- Lume Phase 3 Track O standard library for ownership tiers, interior mutability,
## and scoped arena allocators (`use ownership`, docs/16-phase3-plan.md O1-O4 & Issue #197).
##
## Provides:
##   - `rc[T]`: single-threaded reference-counted pointer backed by a shared heap control block (`rc_new`, `rc_get`, `rc_clone`, `rc_drop`, `rc_strong_count`, `rc_weak_count`, `rc_is_alive`)
##   - `arc[T]`: atomic/thread-safe (`Send + Sync`) reference-counted pointer using hardware `lock xaddq` (`atomic_xadd64`) on a shared control block (`arc_new`, `arc_get`, `arc_clone`, `arc_drop`, `arc_strong_count`, `arc_is_alive`)
##   - `weak[T]`: non-owning weak reference observing shared control block liveness (`weak_downgrade`, `weak_upgrade`, `weak_is_alive`, `weak_dead`)
##   - `cell[T]`: value-level interior mutability container backed by a shared slot (`cell_new`, `cell_get`, `cell_set`, `cell_writes`)
##   - `Arena`: deterministic bump/region allocator (`arena_new`, `arena_alloc`, `arena_used`, `arena_remaining`, `arena_reset`)

fn cb_alloc(v, init_strong, init_weak, init_alive) =
    let base = hw_scratch_addr() in
    let idx = atomic_xadd64(base + 32, 1) in
    let cb = base + 64 + (idx % 240) * 32 in
    let w0 = mmio_volatile_write64(cb, init_strong) in
    let w1 = mmio_volatile_write64(cb + 8, init_weak) in
    let w2 = mmio_volatile_write64(cb + 16, init_alive) in
    let w3 = mmio_volatile_write64(cb + 24, v) in
    cb

fn rc_new(v) =
    let cb = cb_alloc(v, 1, 0, 1) in
    {tier: "rc", cb: cb, val: v}

fn rc_get(r) =
    if mmio_volatile_read64(r.cb + 16) == 0 then ctfail("lume: ownership runtime error [O0001]: dereference of dropped rc[T]\n") else r.val

fn rc_strong_count(r) = mmio_volatile_read64(r.cb)
fn rc_weak_count(r) = mmio_volatile_read64(r.cb + 8)
fn rc_is_alive(r) = mmio_volatile_read64(r.cb + 16)

fn rc_clone(r) =
    let s = mmio_volatile_read64(r.cb) in
    if s <= 0 then ctfail("lume: ownership runtime error [O0001]: clone of dropped rc[T]\n") else
    let w = mmio_volatile_write64(r.cb, s + 1) in
    {tier: "rc", cb: r.cb, val: r.val}

fn rc_drop(r) =
    let s = mmio_volatile_read64(r.cb) in
    let next_s = if s > 0 then s - 1 else 0 in
    let w0 = mmio_volatile_write64(r.cb, next_s) in
    let w1 = if next_s == 0 then mmio_volatile_write64(r.cb + 16, 0) else 0 in
    {tier: "rc", cb: r.cb, val: r.val}

fn arc_new(v) =
    let cb = cb_alloc(v, 1, 0, 1) in
    {tier: "arc", cb: cb, val: v, sync: 1}

fn arc_get(a) =
    if mmio_volatile_read64(a.cb + 16) == 0 then ctfail("lume: ownership runtime error [O0001]: dereference of dropped arc[T]\n") else a.val

fn arc_strong_count(a) = mmio_volatile_read64(a.cb)
fn arc_is_alive(a) = mmio_volatile_read64(a.cb + 16)

fn arc_clone(a) =
    let prev = atomic_xadd64(a.cb, 1) in
    if prev <= 0 then ctfail("lume: ownership runtime error [O0001]: clone of dropped arc[T]\n") else
    {tier: "arc", cb: a.cb, val: a.val, sync: 1}

fn arc_drop(a) =
    let prev = atomic_xadd64(a.cb, 0 - 1) in
    let w = if prev <= 1 then mmio_volatile_write64(a.cb + 16, 0) else 0 in
    {tier: "arc", cb: a.cb, val: a.val, sync: 1}

fn weak_downgrade(r) =
    let wk = mmio_volatile_read64(r.cb + 8) in
    let w = mmio_volatile_write64(r.cb + 8, wk + 1) in
    {tier: "weak", cb: r.cb, val: r.val}

fn weak_dead(v) =
    let cb = cb_alloc(v, 0, 1, 0) in
    {tier: "weak", cb: cb, val: v}

fn weak_is_alive(w) = mmio_volatile_read64(w.cb + 16)
fn weak_upgrade(w, fallback) = if mmio_volatile_read64(w.cb + 16) == 1 then w.val else fallback

fn cell_new(v) =
    let cb = cb_alloc(v, 1, 0, 0) in
    {tier: "cell", cb: cb}

fn cell_get(c) = mmio_volatile_read64(c.cb + 24)
fn cell_writes(c) = mmio_volatile_read64(c.cb + 16)

fn cell_set(c, v) =
    let wr = mmio_volatile_read64(c.cb + 16) in
    let w0 = mmio_volatile_write64(c.cb + 24, v) in
    let w1 = mmio_volatile_write64(c.cb + 16, wr + 1) in
    c

fn arena_new(cap) = {cap: cap, used: 0, allocs: 0}
fn arena_used(a) = a.used
fn arena_remaining(a) = a.cap - a.used
fn arena_allocs(a) = a.allocs
fn arena_can_alloc(a, bytes) = if bytes >= 0 and a.used + bytes <= a.cap then 1 else 0
fn arena_alloc(a, bytes) = if a.used + bytes > a.cap then ctfail("lume: arena out of memory (requested " + str(bytes) + " bytes, remaining " + str(a.cap - a.used) + ")\n") else {cap: a.cap, used: a.used + bytes, allocs: a.allocs + 1}
fn arena_reset(a) = {cap: a.cap, used: 0, allocs: 0}

## --- unit tests (`lume test compiler/stage1/ownership.src`) ---
fn test_rc_lifecycle() =
    let r1 = rc_new(42) in
    let r2 = rc_clone(r1) in
    let c_both = rc_strong_count(r1) == 2 and rc_strong_count(r2) == 2 in
    let r3 = rc_drop(r2) in
    c_both and rc_get(r1) == 42 and rc_strong_count(r1) == 1 and rc_is_alive(r1) == 1

fn test_arc_lifecycle() =
    let a1 = arc_new(100) in
    let a2 = arc_clone(a1) in
    let c_both = arc_strong_count(a1) == 2 and arc_strong_count(a2) == 2 in
    let a3 = arc_drop(a2) in
    c_both and arc_get(a1) == 100 and arc_strong_count(a1) == 1 and arc_is_alive(a1) == 1

fn test_weak_upgrade_and_drop() =
    let r1 = rc_new(77) in
    let w = weak_downgrade(r1) in
    let live_before = weak_is_alive(w) == 1 and weak_upgrade(w, 0) == 77 in
    let r0 = rc_drop(r1) in
    let dead_after = weak_is_alive(w) == 0 and weak_upgrade(w, 999) == 999 in
    live_before and dead_after

fn test_cell_interior_mutability() =
    let c0 = cell_new(10) in
    let v_init = cell_get(c0) in
    let c1 = cell_set(c0, 25) in
    let c2 = cell_set(c1, cell_get(c0) + 5) in
    v_init == 10 and cell_get(c0) == 30 and cell_get(c2) == 30 and cell_writes(c0) == 2

fn test_arena_bump_and_reset() =
    let a0 = arena_new(256) in
    let a1 = arena_alloc(a0, 64) in
    let a2 = arena_alloc(a1, 128) in
    let a3 = arena_reset(a2) in
    arena_used(a2) == 192 and arena_remaining(a2) == 64 and arena_allocs(a2) == 2 and arena_used(a3) == 0 and arena_remaining(a3) == 256
