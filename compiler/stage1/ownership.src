## ownership.src -- Lume Phase 3 Track O standard library for interior mutability (`cell[T]`),
## scoped arena allocators (`Arena`), and conformance unit tests for compiler-native `rc[T]`, `arc[T]`,
## and `weak[T]` memory tiers (`use ownership`, docs/16-phase3-plan.md O1-O4 & Issue #197).
##
## Note: `rc[T]`, `arc[T]`, and `weak[T]` are first-class compiler types (`rc(v)`, `arc(v)`, `.clone()`,
## `.drop()`, `.get()`, `.strong_count()`, `.downgrade()`, `.upgrade(fallback)`) enforced by `lumec`
## (`06_typecheck.src`, `06b_phase3.src`, `05_codegen.src`) and `lcaas.src` (#245). The redundant
## user-function `rc_*`/`arc_*`/`weak_*` wrappers have been removed.
##
## Provides:
##   - `cell[T]`: value-level interior mutability container backed by a shared slot (`cell_new`, `cell_get`, `cell_set`, `cell_writes`)
##   - `Arena`: deterministic bump/region allocator (`arena_new`, `arena_alloc`, `arena_used`, `arena_remaining`, `arena_reset`)

fn cb_alloc(v, init_strong, init_weak, init_alive) = let base = hw_scratch_addr() in let idx = atomic_xadd64(base + 32, 1) in let cb = base + 64 + (idx % 240) * 32 in let w0 = mmio_volatile_write64(cb, init_strong) in let w1 = mmio_volatile_write64(cb + 8, init_weak) in let w2 = mmio_volatile_write64(cb + 16, init_alive) in let w3 = mmio_volatile_write64(cb + 24, v) in cb

fn cell_new(v) = let cb = cb_alloc(v, 1, 0, 0) in {tier: "cell", cb: cb}
fn cell_get(c) = mmio_volatile_read64(c.cb + 24)
fn cell_writes(c) = mmio_volatile_read64(c.cb + 16)
fn cell_set(c, v) = let wr = mmio_volatile_read64(c.cb + 16) in let w0 = mmio_volatile_write64(c.cb + 24, v) in let w1 = mmio_volatile_write64(c.cb + 16, wr + 1) in c

fn arena_new(cap) = {cap: cap, used: 0, allocs: 0}
fn arena_used(a) = a.used
fn arena_remaining(a) = a.cap - a.used
fn arena_allocs(a) = a.allocs
fn arena_can_alloc(a, bytes) = if bytes >= 0 and a.used + bytes <= a.cap then 1 else 0
fn arena_alloc(a, bytes) = if a.used + bytes > a.cap then ctfail("lume: arena out of memory (requested " + str(bytes) + " bytes, remaining " + str(a.cap - a.used) + ")\n") else {cap: a.cap, used: a.used + bytes, allocs: a.allocs + 1}
fn arena_reset(a) = {cap: a.cap, used: 0, allocs: 0}

## --- unit tests (`lume test compiler/stage1/ownership.src`) ---
fn test_rc_lifecycle() = let r1: rc[int] = rc(42) in let r2: rc[int] = r1.clone() in let c_both = r1.strong_count() == 2 and r2.strong_count() == 2 in let d2 = r2.drop() in let ok = c_both and r1.get() == 42 and r1.strong_count() == 1 in let d1 = r1.drop() in ok

fn test_arc_lifecycle() = let a1: arc[int] = arc(100) in let a2: arc[int] = a1.clone() in let c_both = a1.strong_count() == 2 and a2.strong_count() == 2 in let d2 = a2.drop() in let ok = c_both and a1.get() == 100 and a1.strong_count() == 1 in let d1 = a1.drop() in ok

fn test_weak_upgrade_and_drop() = let r1: rc[int] = rc(77) in let w: weak[int] = r1.downgrade() in let live_before = w.upgrade(0) == 77 in let d1 = r1.drop() in let dead_after = w.upgrade(999) == 999 in live_before and dead_after

fn test_cell_interior_mutability() = let c0 = cell_new(10) in let v_init = cell_get(c0) in let c1 = cell_set(c0, 25) in let c2 = cell_set(c1, cell_get(c0) + 5) in v_init == 10 and cell_get(c0) == 30 and cell_get(c2) == 30 and cell_writes(c0) == 2

fn test_arena_bump_and_reset() = let a0 = arena_new(256) in let a1 = arena_alloc(a0, 64) in let a2 = arena_alloc(a1, 128) in let a3 = arena_reset(a2) in arena_used(a2) == 192 and arena_remaining(a2) == 64 and arena_allocs(a2) == 2 and arena_used(a3) == 0 and arena_remaining(a3) == 256
