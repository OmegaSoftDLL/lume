fn argv_check() = if os_arg_count() != 4 then "argc mismatch" else if os_arg_at(0) == "" then "empty executable path" else if os_arg_at(1) != "alpha" then "first argument mismatch" else if os_arg_at(2) != "with space" then "spaced argument mismatch" else if os_arg_at(3) != "" then "empty argument mismatch" else if os_arg_at(0 - 1) != "" then "negative index accepted" else if os_arg_at(4) != "" then "out-of-range index accepted" else "argv:ok"
print argv_check()
flush()
