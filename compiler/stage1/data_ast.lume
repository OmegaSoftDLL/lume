## data_ast.lume — AST for a small ADT language with constructors and match (library module).
type Pat = enum
    PWild
    PBind(name: str)
    PInt(n: int)
    PCons(tag: str, subs: [Pat])

type DExpr = enum
    DInt(n: int)
    DStr(value: str)
    DVar(name: str)
    DCons(tag: str, args: [DExpr])
    DCall(name: str, args: [DExpr])
    DList(elems: [DExpr])
    DIndex(coll: DExpr, idx: DExpr)
    DRec(fields: [RecField])
    DField(obj: DExpr, name: str)
    DBin(op: str, l: DExpr, r: DExpr)
    DIf(cond: DExpr, then_val: DExpr, else_val: DExpr)
    DLetIn(name: str, value: DExpr, body: DExpr)
    DMatch(scrut: DExpr, arms: [Arm])

type Arm = record
    pat:  Pat
    body: DExpr

type RecField = record
    name:  str
    value: DExpr

type DStmt = enum
    DLet(name: str, value: DExpr)
    DPrint(value: DExpr)
    DFnS(name: str, params: [str], body: DExpr)
