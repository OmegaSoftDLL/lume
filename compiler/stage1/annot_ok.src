## F2 positive: optional type annotations on parameters and return types, used correctly.
## Annotations are compile-time only (no code change); unannotated fns stay valid (gradual).
type Color = enum Red | Green | Blue
type Shape = enum Circle(int) | Square(int)
fn greet(name: str) -> str = "hi " + name
fn add(a: int, b: int) -> int = a + b
fn mix(n: int, label) = label + str(n)
fn paint(c: Color) -> int = match c
    Red   => 1
    Green => 2
    Blue  => 3
fn area(s: Shape) -> int = match s
    Circle(r) => 3 * r * r
    Square(w) => w * w
fn five() -> int = 5
fn plain(x) = x + 1
print greet("lume")
print add(2, 40)
print mix(7, "n=")
print paint(Green)
print area(Square(6))
print add(five(), plain(1))
print greet(greet("a"))
