## block_codegen.lume — generate C from the block language (library module).
## Compiles functions, while/if/assignment/print/return/calls to C -> native.
use block_ast

fn bcop(op: str) -> str
    if op == "and"
        "&&"
    elif op == "or"
        "||"
    else
        op

fn bcexpr(e: Expr) -> str
    match e
        Num(v)        => "{v}"
        Name(id)      => id
        StrLit(txt)   => txt
        Call(nm, args) => nm + "(" + args.map(bcexpr).join(", ") + ")"
        Bin(op, l, r) => "(" + bcexpr(l) + " " + bcop(op) + " " + bcexpr(r) + ")"

fn collect_vars(stmts: [Stmt], acc: mut map[str, int])
    for s in stmts
        match s
            Assign(n, v) => do
                acc[n] = 1
            While(c, body) => do
                collect_vars(body, acc)
            If(c, t, e) => do
                collect_vars(t, acc)
                collect_vars(e, acc)
            Print(v) => do
                let _ = 0
            Return(v) => do
                let _ = 0
            Fn(nm, ps, b) => do
                let _ = 0

fn print_c(v: Expr, ind: str) -> str
    match v
        StrLit(txt) => ind + "printf(\"%s\\n\", " + txt + ");\n"
        _ => ind + "printf(\"%lld\\n\", (long long)(" + bcexpr(v) + "));\n"

fn emit_stmts(stmts: [Stmt], ind: str) -> str
    var out = ""
    for s in stmts
        match s
            Assign(n, v) => do
                out = out + ind + n + " = " + bcexpr(v) + ";\n"
            Print(v) => do
                out = out + print_c(v, ind)
            Return(v) => do
                out = out + ind + "return " + bcexpr(v) + ";\n"
            While(c, body) => do
                out = out + ind + "while (" + bcexpr(c) + ") {{\n" + emit_stmts(body, ind + "    ") + ind + "}}\n"
            If(c, t, e) => do
                out = out + ind + "if (" + bcexpr(c) + ") {{\n" + emit_stmts(t, ind + "    ") + ind + "}} else {{\n" + emit_stmts(e, ind + "    ") + ind + "}}\n"
            Fn(nm, ps, b) => do
                let _ = 0
    out

fn param_has(params: [str], k: str) -> bool
    for p in params
        if p == k
            return true
    false

fn cparams(params: [str]) -> str = params.map(|p| "long long " + p).join(", ")

fn cfun(nm: str, params: [str], body: [Stmt]) -> str
    var vars = {}
    collect_vars(body, vars)
    var decls = ""
    for k in vars.keys().sorted()
        if not param_has(params, k)
            decls = decls + "    long long " + k + " = 0;\n"
    "long long " + nm + "(" + cparams(params) + ") {{\n" + decls + emit_stmts(body, "    ") + "    return 0;\n}}\n"

fn cgen_block(prog: [Stmt]) -> str
    var funcs = ""
    var tops = []
    for s in prog
        match s
            Fn(nm, ps, b) => do
                funcs = funcs + cfun(nm, ps, b)
            Assign(n, v) => do
                tops.push(s)
            Print(v) => do
                tops.push(s)
            While(c, b) => do
                tops.push(s)
            If(c, a, b) => do
                tops.push(s)
            Return(v) => do
                tops.push(s)
    var vars = {}
    collect_vars(tops, vars)
    var decls = ""
    for k in vars.keys().sorted()
        decls = decls + "    long long " + k + " = 0;\n"
    "#include <stdio.h>\n" + funcs + "int main(void) {{\n" + decls + emit_stmts(tops, "    ") + "    return 0;\n}}\n"
