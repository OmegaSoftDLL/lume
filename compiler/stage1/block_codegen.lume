## block_codegen.lume — generate C from the block language (library module).
## while/if/assignment/print -> C; loops compile to native code via the system C compiler.
use block_ast

fn bcexpr(e: Expr) -> str
    match e
        Num(v)        => "{v}"
        Name(id)      => id
        Bin(op, l, r) => "(" + bcexpr(l) + " " + op + " " + bcexpr(r) + ")"

fn collect_vars(stmts: [Stmt], acc: mut map[str, int])
    for s in stmts
        match s
            Assign(n, v) => do
                acc[n] = 1
            While(c, body) => do
                collect_vars(body, acc)
            If(c, t, e) => do
                collect_vars(t, acc)
                collect_vars(e, acc)
            Print(v) => do
                let _ = 0

fn emit_stmts(stmts: [Stmt], ind: str) -> str
    var out = ""
    for s in stmts
        match s
            Assign(n, v) => do
                out = out + ind + n + " = " + bcexpr(v) + ";\n"
            Print(v) => do
                out = out + ind + "printf(\"%lld\\n\", (long long)(" + bcexpr(v) + "));\n"
            While(c, body) => do
                out = out + ind + "while (" + bcexpr(c) + ") {{\n" + emit_stmts(body, ind + "    ") + ind + "}}\n"
            If(c, t, e) => do
                out = out + ind + "if (" + bcexpr(c) + ") {{\n" + emit_stmts(t, ind + "    ") + ind + "}} else {{\n" + emit_stmts(e, ind + "    ") + ind + "}}\n"
    out

fn cgen_block(prog: [Stmt]) -> str
    var vars = {}
    collect_vars(prog, vars)
    var decls = ""
    for k in vars.keys().sorted()
        decls = decls + "    long long " + k + " = 0;\n"
    "#include <stdio.h>\nint main(void) {{\n" + decls + emit_stmts(prog, "    ") + "    return 0;\n}}\n"
