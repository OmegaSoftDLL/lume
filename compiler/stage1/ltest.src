## ltest.src -- Lume-Core native unit-test harness generator (Track T, brick T1).
## Reads a .src file from stdin, discovers all zero-argument `fn test_<name>()` functions, strips
## non-test top-level `print` statements, and appends a Lume-Core test runner that executes each
## `test_<name>()`, prints `  ok   test_<name>` or `  FAIL test_<name>`, prints `<P> passed, <F> failed`,
## and aborts with exit code 3 via `ctfail` if any test returned 0 (false).
## Compiled to a standalone native ELF by `lumec` + `lasm` with zero C in the loop.

## --- list & string helpers ---
fn app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, app(t, ys))
fn len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + len(t)
fn isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => pairs2(a, t)
fn pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, pairs(r))
fn joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if isnil(t) == 1 then a else joinall(pairs(xs))
fn addsep(xs, sep) = match xs
    Nil        => Nil
    Cons(h, t) => if isnil(t) == 1 then Cons(h, Nil) else Cons(h + sep, addsep(t, sep))
fn joinsep(xs, sep) = joinall(addsep(xs, sep))

fn nlpos(s, n, i) = if i >= n then i else if at(s, i) == "\n" then i else nlpos(s, n, i + 1)
fn rnlpos(s, i) = if i < 0 then 0 - 1 else if at(s, i) == "\n" then i else rnlpos(s, i - 1)
fn splitlines_leaf(s, n, i) = if i >= n then Nil else let e = nlpos(s, n, i) in Cons(slicen(s, n, i, e), splitlines_leaf(s, n, if e >= n then e else e + 1))
fn find_nl_from(s, n, mid) = let wn = if mid + 256 <= n then 256 else n - mid in let w = slicen(s, n, mid, mid + wn) in let k = nlpos(w, wn, 0) in if k < wn then mid + k else if mid + wn >= n then n else find_nl_from(s, n, mid + wn)
fn rfind_nl_from(s, n, end_pos) = if end_pos <= 0 then 0 - 1 else let start = if end_pos >= 256 then end_pos - 256 else 0 in let wn = end_pos - start in let w = slicen(s, n, start, end_pos) in let k = rnlpos(w, wn - 1) in if k >= 0 then start + k else rfind_nl_from(s, n, start)
fn splitlines_no_right_nl(s, n, half) = let sp0 = rfind_nl_from(s, n, half) in if sp0 < 0 then Cons(s, Nil) else app(splitlines_dc(slicen(s, n, 0, sp0), sp0), Cons(slicen(s, n, sp0 + 1, n), Nil))
fn splitlines_dc(s, n) = if n <= 256 then splitlines_leaf(s, n, 0) else let half = n / 2 in let sp = find_nl_from(s, n, half) in if sp >= n then splitlines_no_right_nl(s, n, half) else app(splitlines_dc(slicen(s, n, 0, sp), sp), splitlines_dc(slicen(s, n, sp + 1, n), n - sp - 1))
fn splitlines(s) = splitlines_dc(s, count(s))

fn isws(c) = c == " " or c == "\t" or c == "\r"
fn rtrimend(s, e) = if e <= 0 then 0 else if isws(at(s, e - 1)) then rtrimend(s, e - 1) else e
fn rtrim(s) = let n = count(s) in if n <= 0 then s else if isws(at(s, n - 1)) then slicen(s, n, 0, rtrimend(s, n - 1)) else s
fn startswith(s, p) = if count(s) < count(p) then 0 else slice(s, 0, count(p)) == p

fn isdigit(c) = c >= "0" and c <= "9"
fn isalpha(c) = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
fn isalnum(c) = isdigit(c) or isalpha(c)
fn idend(s, i) = if i >= count(s) then i else if isalnum(at(s, i)) then idend(s, i + 1) else i

## --- zero-arg `fn test_<name>()` detection ---
fn testfnname(raw) = if count(raw) < 10 then "" else if at(raw, 0) == "f" and startswith(raw, "fn test_") then testfnname2(raw, idend(raw, 3)) else ""
fn testfnname2(raw, e) = if e > 8 and startswith(slice(raw, e, count(raw)), "()") then slice(raw, 3, e) else ""

fn findtests(lines) = match lines
    Nil        => Nil
    Cons(h, t) => findtests1(testfnname(rtrim(h)), t)
fn findtests1(nm, t) = if nm == "" then findtests(t) else Cons(nm, findtests(t))

## Strip top-level `print ...` statements when synthesizing a unit-test harness
fn is_top_print(raw) = count(raw) >= 6 and at(raw, 0) == "p" and startswith(raw, "print ")
fn has_top_print(lines) = match lines
    Nil        => 0
    Cons(h, t) => if is_top_print(h) then 1 else has_top_print(t)
fn keepdef(lines) = match lines
    Nil        => Nil
    Cons(h, t) => keepdef1(rtrim(h), t)
fn keepdef1(raw, t) = if is_top_print(raw) then keepdef(t) else Cons(raw, keepdef(t))

## --- synthesize runner statements for discovered tests ---
fn printcalls(ts) = match ts
    Nil        => Nil
    Cons(h, t) => Cons("print _t_msg(" + h + "(), \"" + h + "\")", printcalls(t))
fn sumcalls(ts) = match ts
    Nil        => "0"
    Cons(h, t) => if isnil(t) == 1 then "_t_ok(" + h + "())" else "_t_ok(" + h + "()) + " + sumcalls(t)

fn synth(src, lines, ts) = if isnil(ts) == 1 then src else let n = str(len(ts)) in let sum = sumcalls(ts) in let defs = if has_top_print(lines) == 1 then joinsep(keepdef(lines), "\n") else rtrim(src) in let pcs = joinsep(printcalls(ts), "\n") in defs + "\nfn _t_ok(x) = if x != 0 then 1 else 0\nfn _t_msg(ok, nm) = if ok != 0 then \"  ok   \" + nm else \"  FAIL \" + nm\nfn _t_sum(p, tot) = str(p) + \" passed, \" + str(tot - p) + \" failed\"\nfn _t_chk(p, tot) = if p == tot then 0 else ctfail(\"lume test: failed\\n\")\n" + pcs + "\nprint _t_sum(" + sum + ", " + n + ")\n_t_chk(" + sum + ", " + n + ")"

fn run_ltest(src) = let lines = splitlines(src) in synth(src, lines, findtests(lines))

print rtrim(run_ltest(readall()))
