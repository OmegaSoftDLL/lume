## table.src — typed in-memory relations and strict CSV ingestion for ML-core.
## A schema is a Cons-list of {name: str, type: "str" | "int" | "decimal"} records.
## Rows are Cons-lists of tagged values, preserving the declared type of every column.

fn table_error(message) = {ok: 0, error: message, schema: Nil, rows: Nil}
fn table_success(schema, rows) = {ok: 1, error: "", schema: schema, rows: rows}

fn list_len(xs) = match xs
    Nil => 0
    Cons(head, tail) => 1 + list_len(tail)
fn list_reverse(xs) = list_reverse_acc(xs, Nil)
fn list_reverse_acc(xs, acc) = match xs
    Nil => acc
    Cons(head, tail) => list_reverse_acc(tail, Cons(head, acc))
fn list_head(xs) = match xs
    Nil => Nil
    Cons(head, tail) => head
fn list_tail(xs) = match xs
    Nil => Nil
    Cons(head, tail) => tail

fn csv_newline(s, i) = at(s, i) == "\n" or at(s, i) == "\r"
fn csv_after_newline(s, i) = if at(s, i) == "\r" and at(s, i + 1) == "\n" then i + 2 else i + 1

## A cell result carries the separator that ended it: comma=0, row boundary=1, EOF=2.
## Quoted fields allow separators/newlines and doubled quotes. After a closing quote only
## a separator, row boundary, or EOF is legal; malformed quoting is returned as an error.
fn csv_cell(s, i) = if i < count(s) and at(s, i) == "\"" then csv_quoted(s, i + 1, "") else csv_plain(s, i, "")
fn csv_plain(s, i, value) = if i >= count(s) then {ok: 1, value: value, pos: i, sep: 2} else if at(s, i) == "," then {ok: 1, value: value, pos: i + 1, sep: 0} else if csv_newline(s, i) then {ok: 1, value: value, pos: csv_after_newline(s, i), sep: 1} else if at(s, i) == "\"" then {ok: 0, value: "", pos: i, sep: 3} else csv_plain(s, i + 1, value + at(s, i))
fn csv_quoted(s, i, value) = if i >= count(s) then {ok: 0, value: "", pos: i, sep: 3} else if at(s, i) == "\"" then csv_quote_end(s, i, value) else csv_quoted(s, i + 1, value + at(s, i))
fn csv_quote_end(s, i, value) = if i + 1 < count(s) and at(s, i + 1) == "\"" then csv_quoted(s, i + 2, value + "\"") else csv_quote_sep(s, i + 1, value)
fn csv_quote_sep(s, i, value) = if i >= count(s) then {ok: 1, value: value, pos: i, sep: 2} else if at(s, i) == "," then {ok: 1, value: value, pos: i + 1, sep: 0} else if csv_newline(s, i) then {ok: 1, value: value, pos: csv_after_newline(s, i), sep: 1} else {ok: 0, value: "", pos: i, sep: 3}

fn csv_row(s, i, cells) = csv_row_step(s, csv_cell(s, i), cells)
fn csv_row_step(s, cell, cells) = if cell.ok == 0 then {ok: 0, pos: cell.pos, cells: Nil} else if cell.sep == 0 then csv_row(s, cell.pos, Cons(cell.value, cells)) else {ok: 1, pos: cell.pos, cells: Cons(cell.value, cells)}
fn csv_rows(s, i, rows) = if i >= count(s) then {ok: 1, rows: list_reverse(rows)} else csv_rows_step(s, csv_row(s, i, Nil), rows)
fn csv_rows_step(s, row, rows) = if row.ok == 0 then {ok: 0, rows: Nil} else if row.pos == count(s) then {ok: 1, rows: list_reverse(Cons(list_reverse(row.cells), rows))} else csv_rows(s, row.pos, Cons(list_reverse(row.cells), rows))

fn schema_names(schema) = match schema
    Nil => Nil
    Cons(column, rest) => Cons(column.name, schema_names(rest))
fn schema_valid(schema) = schema_valid_seen(schema, Nil)
fn schema_valid_seen(schema, seen) = match schema
    Nil => 1
    Cons(column, rest) => if column.name == "" or string_member(column.name, seen) == 1 then 0 else if column.type == "str" or column.type == "int" or column.type == "decimal" then schema_valid_seen(rest, Cons(column.name, seen)) else 0
fn string_member(value, values) = match values
    Nil => 0
    Cons(head, tail) => if value == head then 1 else string_member(value, tail)
fn same_strings(a, b) = match a
    Nil => same_strings_nil(b)
    Cons(head, tail) => same_strings_cons(head, tail, b)
fn same_strings_nil(b) = match b
    Nil => 1
    _ => 0
fn same_strings_cons(head, tail, b) = match b
    Nil => 0
    Cons(other, rest) => if head == other then same_strings(tail, rest) else 0

fn csv_int_valid(s, i, digits) = if i >= count(s) then digits else if i == 0 and (at(s, i) == "-" or at(s, i) == "+") then csv_int_valid(s, i + 1, digits) else if at(s, i) >= "0" and at(s, i) <= "9" then csv_int_valid(s, i + 1, digits + 1) else 0
fn csv_int_value(s) = if count(s) == 0 or csv_int_valid(s, 0, 0) == 0 or csv_int_valid(s, 0, 0) > 18 then {ok: 0, value: 0} else csv_int_value_valid(s, if at(s, 0) == "-" or at(s, 0) == "+" then 1 else 0, if at(s, 0) == "-" then 0 - 1 else 1)
fn csv_int_value_valid(s, start, sign) = {ok: 1, value: sign * csv_int_digits(s, start, 0)}
fn csv_int_digits(s, i, value) = if i >= count(s) then value else csv_int_digits(s, i + 1, value * 10 + toint(at(s, i)))
fn csv_decimal_valid(s, i, point, digit) = if i >= count(s) then digit else if i == 0 and (at(s, i) == "-" or at(s, i) == "+") then csv_decimal_valid(s, i + 1, point, digit) else if at(s, i) >= "0" and at(s, i) <= "9" then csv_decimal_valid(s, i + 1, point, 1) else if at(s, i) == "." and point == 0 then csv_decimal_valid(s, i + 1, 1, digit) else 0
fn csv_convert(value, kind) = if kind == "str" then {ok: 1, value: {kind: "str", value: value}} else if kind == "int" then csv_convert_int(csv_int_value(value)) else if kind == "decimal" then csv_convert_decimal(value, csv_decimal_valid(value, 0, 0, 0)) else {ok: 0, value: {kind: "error", value: "unsupported schema type"}}
fn csv_convert_int(parsed) = if parsed.ok == 1 then {ok: 1, value: {kind: "int", value: parsed.value}} else {ok: 0, value: {kind: "error", value: "invalid integer"}}
fn csv_convert_decimal(value, valid) = if valid == 1 then {ok: 1, value: {kind: "decimal", value: decimal_parse(value)}} else {ok: 0, value: {kind: "error", value: "invalid decimal"}}

fn csv_typed_row(cells, schema, row_index, acc) = if list_len(cells) != list_len(schema) then {ok: 0, rows: Nil, error: "CSV row " + str(row_index + 1) + " has " + str(list_len(cells)) + " cells; schema expects " + str(list_len(schema))} else csv_typed_cells(cells, schema, row_index, acc)
fn csv_typed_cells(cells, schema, row_index, acc) = match cells
    Nil => {ok: 1, values: list_reverse(acc), error: ""}
    Cons(cell, more_cells) => csv_typed_cells_cons(cell, more_cells, schema, row_index, acc)
fn csv_typed_cells_cons(cell, more_cells, schema, row_index, acc) = match schema
    Nil => {ok: 0, values: Nil, error: "CSV row width does not match schema"}
    Cons(column, more_schema) => csv_typed_cell(more_cells, column, more_schema, row_index, acc, csv_convert(cell, column.type))
fn csv_typed_cell(more_cells, column, more_schema, row_index, acc, converted) = if converted.ok == 0 then {ok: 0, values: Nil, error: "CSV row " + str(row_index + 1) + ", column '" + column.name + "': " + converted.value.value} else csv_typed_cells(more_cells, more_schema, row_index, Cons(converted.value, acc))
fn csv_typed_rows(rows, schema, acc) = match rows
    Nil => {ok: 1, rows: list_reverse(acc), error: ""}
    Cons(row, rest) => csv_typed_rows_step(rest, schema, list_len(acc), acc, csv_typed_row(row, schema, list_len(acc) + 1, Nil))
fn csv_typed_rows_step(rest, schema, row_index, acc, typed) = if typed.ok == 0 then {ok: 0, rows: Nil, error: typed.error} else csv_typed_rows(rest, schema, Cons(typed.values, acc))

## read_csv accepts CSV text and an explicit schema. It requires an exact header match,
## rejects malformed quoting, wrong row widths, and invalid cells, and never guesses types.
fn read_csv(text, schema) = if schema_valid(schema) == 0 then table_error("invalid CSV schema") else if count(text) == 0 then table_error("CSV input is empty") else read_csv_parsed(schema, csv_rows(text, 0, Nil))
fn read_csv_parsed(schema, parsed) = if parsed.ok == 0 then table_error("malformed CSV quoting") else read_csv_header(schema, parsed.rows)
fn read_csv_header(schema, rows) = match rows
    Nil => table_error("CSV input has no header")
    Cons(header, body) => if same_strings(header, schema_names(schema)) == 0 then table_error("CSV header does not match schema") else read_csv_body(schema, body, csv_typed_rows(body, schema, Nil))
fn read_csv_body(schema, source_rows, converted) = if converted.ok == 0 then table_error(converted.error) else table_success(schema, converted.rows)

fn table_row_count(table) = list_len(table.rows)
fn table_column_count(table) = list_len(table.schema)
fn table_cell(table, row, column) = if row < 0 or row >= table_row_count(table) or column < 0 or column >= table_column_count(table) then {ok: 0, error: "table index out of bounds", value: {kind: "error", value: "table index out of bounds"}} else table_cell_at(list_nth(table.rows, row), column)
fn list_nth(xs, index) = if index <= 0 then list_head(xs) else list_nth(list_tail(xs), index - 1)
fn table_cell_at(row, column) = if column <= 0 then {ok: 1, error: "", value: list_head(row)} else table_cell_at(list_tail(row), column - 1)

## --- Track D4 (#214): CSV serialization, embedded WAL persistence, versioned time-travel, money[CCY], and @soa ---
fn csv_needs_quote(s, i, n) = if i >= n then 0 else let c = at(s, i) in if c == "," or c == "\"" or c == "\n" or c == "\r" then 1 else csv_needs_quote(s, i + 1, n)
fn csv_escape_quotes(s, i, n) = if i >= n then "" else let c = at(s, i) in (if c == "\"" then "\"\"" else c) + csv_escape_quotes(s, i + 1, n)
fn csv_encode_str(s) = if csv_needs_quote(s, 0, count(s)) == 1 then "\"" + csv_escape_quotes(s, 0, count(s)) + "\"" else s
fn csv_encode_cell(cell) = if cell.kind == "int" then str(cell.value) else if cell.kind == "decimal" then decimal_format(cell.value) else csv_encode_str(cell.value)
fn csv_encode_row(cells) = match cells
    Nil        => ""
    Cons(h, t) => let s = csv_encode_cell(h) in if list_len(t) == 0 then s else s + "," + csv_encode_row(t)
fn csv_encode_header(schema) = match schema
    Nil        => ""
    Cons(c, r) => if list_len(r) == 0 then c.name else c.name + "," + csv_encode_header(r)
fn csv_encode_rows(rows) = match rows
    Nil        => ""
    Cons(h, t) => "\n" + csv_encode_row(h) + csv_encode_rows(t)
fn write_csv(table) = if table.ok == 0 then "" else csv_encode_header(table.schema) + csv_encode_rows(table.rows)

fn table_append_rows(a, b) = match a
    Nil        => b
    Cons(h, t) => Cons(h, table_append_rows(t, b))
fn table_insert_row(table, row) = if table.ok == 0 then table else if list_len(row) != list_len(table.schema) then table_error("inserted row width does not match schema") else table_success(table.schema, table_append_rows(table.rows, Cons(row, Nil)))

## Crash-safe durable on-disk WAL persistence (`persist table[T] ... at "path"`):
## Each committed snapshot carries a deterministic checksum over `<path>|<version>|<csv>` and is framed as
## `@tx|<version>|<committed>|<checksum>|<escaped_csv>|@endtx\n`, written to disk with `open` + `flock(LOCK_EX)`
## + `write` + `fsync` + `close` (`fs_write_sync` / `fs_append_sync`), and recovered from disk via `fs_read_file`.
## Torn, truncated, or corrupted writes are rejected on recovery and the store rolls back to the newest valid snapshot.
fn persist_checksum_i(s, i, n, acc) = if i >= n then acc else let next = (acc * 131 + ord(at(s, i)) + i + 17) % 1000000007 in persist_checksum_i(s, i + 1, n, if next < 0 then 0 - next else next)
fn persist_checksum(s) = str(persist_checksum_i(s, 0, count(s), 5381))
fn persist_payload(path, ver, csv) = path + "|" + str(ver) + "|" + csv
fn persist_is_disk_path(path) = if count(path) == 0 then 0 else if count(path) >= 9 and slice(path, 0, 9) == "memory://" then 0 else 1
fn persist_esc_i(s, i, n) = if i >= n then "" else let c = at(s, i) in let ec = (if c == "\n" then "~n" else if c == "\r" then "~r" else if c == "|" then "~p" else if c == "~" then "~t" else c) in ec + persist_esc_i(s, i + 1, n)
fn persist_esc_csv(s) = persist_esc_i(s, 0, count(s))
fn persist_unesc_i(s, i, n) = if i >= n then "" else let c = at(s, i) in if c == "~" and i + 1 < n then (let nx = at(s, i + 1) in let dc = (if nx == "n" then "\n" else if nx == "r" then "\r" else if nx == "p" then "|" else "~") in dc + persist_unesc_i(s, i + 2, n)) else c + persist_unesc_i(s, i + 1, n)
fn persist_unesc_csv(s) = persist_unesc_i(s, 0, count(s))
fn persist_format_snap(snap) = "@tx|" + str(snap.version) + "|" + str(snap.committed) + "|" + snap.checksum + "|" + persist_esc_csv(snap.csv) + "|@endtx\n"
fn persist_find_ch(s, ch, i, n) = if i >= n then n else if at(s, i) == ch then i else persist_find_ch(s, ch, i + 1, n)
fn persist_split_ch_i(s, ch, i, n) = if i >= n then Nil else let e = persist_find_ch(s, ch, i, n) in Cons(slice(s, i, e), persist_split_ch_i(s, ch, if e >= n then n else e + 1, n))
fn persist_split_ch(s, ch) = persist_split_ch_i(s, ch, 0, count(s))
fn persist_parse_line(line) = let parts = persist_split_ch(line, "|") in if list_len(parts) != 6 then {ok: 0, snap: {version: 0, csv: "", checksum: "", committed: 0}} else let p0 = list_nth(parts, 0) in let p1 = list_nth(parts, 1) in let p2 = list_nth(parts, 2) in let p3 = list_nth(parts, 3) in let p4 = list_nth(parts, 4) in let p5 = list_nth(parts, 5) in if p0 != "@tx" or p5 != "@endtx" then {ok: 0, snap: {version: 0, csv: "", checksum: "", committed: 0}} else {ok: 1, snap: {version: toint(p1), csv: persist_unesc_csv(p4), checksum: p3, committed: toint(p2)}}
fn persist_parse_lines(lines, acc) = match lines
    Nil        => acc
    Cons(l, r) => if count(l) == 0 then persist_parse_lines(r, acc) else let pl = persist_parse_line(l) in persist_parse_lines(r, if pl.ok == 1 then Cons(pl.snap, acc) else Cons({version: 0, csv: l, checksum: "torn_frame", committed: 0}, acc))
fn persist_parse_wal_text(raw) = if count(raw) == 0 then Nil else persist_parse_lines(persist_split_ch(raw, "\n"), Nil)
fn persist_open(path, schema, table) = if table.ok == 0 then {ok: 0, error: table.error, path: path, schema: schema, version: 0, wal: Nil, current: table} else let csv = write_csv(table) in let chk = persist_checksum(persist_payload(path, 1, csv)) in let snap = {version: 1, csv: csv, checksum: chk, committed: 1} in let w = (if persist_is_disk_path(path) == 1 then fs_write_sync(path, persist_format_snap(snap)) else 1) in {ok: w, error: if w == 1 then "" else "failed to write WAL file: " + path, path: path, schema: schema, version: 1, wal: Cons(snap, Nil), current: table}
fn persist_commit(store, next_table) = if store.ok == 0 then store else if next_table.ok == 0 then {ok: 0, error: next_table.error, path: store.path, schema: store.schema, version: store.version, wal: store.wal, current: store.current} else let v2 = store.version + 1 in let csv = write_csv(next_table) in let chk = persist_checksum(persist_payload(store.path, v2, csv)) in let snap = {version: v2, csv: csv, checksum: chk, committed: 1} in let w = (if persist_is_disk_path(store.path) == 1 then fs_append_sync(store.path, persist_format_snap(snap)) else 1) in {ok: w, error: if w == 1 then "" else "failed to append WAL file: " + store.path, path: store.path, schema: store.schema, version: v2, wal: Cons(snap, store.wal), current: next_table}
fn persist_append_torn(store, bad_csv) = let v2 = store.version + 1 in let snap = {version: v2, csv: bad_csv, checksum: "torn_uncommitted_write", committed: 0} in let w = (if persist_is_disk_path(store.path) == 1 then fs_append_sync(store.path, persist_format_snap(snap)) else 1) in {ok: store.ok, error: store.error, path: store.path, schema: store.schema, version: v2, wal: Cons(snap, store.wal), current: store.current}
fn persist_recover_wal(path, schema, wal) = match wal
    Nil        => {ok: 0, error: "no valid committed WAL snapshot found", path: path, schema: schema, version: 0, wal: Nil, current: table_error("unrecovered")}
    Cons(s, r) => let exp_chk = persist_checksum(persist_payload(path, s.version, s.csv)) in if s.committed == 1 and s.checksum == exp_chk then (let tbl = read_csv(s.csv, schema) in if tbl.ok == 1 then {ok: 1, error: "", path: path, schema: schema, version: s.version, wal: Cons(s, r), current: tbl} else persist_recover_wal(path, schema, r)) else persist_recover_wal(path, schema, r)
fn persist_recover_path(path, schema) = let raw = fs_read_file(path) in persist_recover_wal(path, schema, persist_parse_wal_text(raw))
fn persist_recover(store) = if persist_is_disk_path(store.path) == 1 then (let raw = fs_read_file(store.path) in if count(raw) > 0 then persist_recover_wal(store.path, store.schema, persist_parse_wal_text(raw)) else persist_recover_wal(store.path, store.schema, store.wal)) else persist_recover_wal(store.path, store.schema, store.wal)
fn persist_tx_insert_row(path, schema, row) = let rec = persist_recover_path(path, schema) in if rec.ok == 0 then rec else let next_tbl = table_insert_row(rec.current, row) in persist_commit(rec, next_tbl)

## Versioned tables (`versioned table[T]`): append-only log + snapshots & time-travel (`version_at`).
fn versioned_new(table) = persist_open("memory://versioned", table.schema, table)
fn versioned_commit(vstore, next_table) = persist_commit(vstore, next_table)
fn versioned_latest_version(vstore) = vstore.version
fn versioned_find_wal(wal, schema, target_ver) = match wal
    Nil        => table_error("version " + str(target_ver) + " not found in versioned table log")
    Cons(s, r) => if s.version == target_ver and s.committed == 1 then read_csv(s.csv, schema) else versioned_find_wal(r, schema, target_ver)
fn versioned_at(vstore, target_ver) = versioned_find_wal(vstore.wal, vstore.schema, target_ver)

## Unit-typed currency (`money[CCY]`): exact decimal amount paired with an ISO-4217 currency tag.
## Rejects cross-currency addition/subtraction/comparison without an explicit `money_convert_fx` rate.
fn money_make(ccy, dec_val) = if count(ccy) == 0 then ctfail("lume: money currency code must be non-empty\n") else {kind: "money", ccy: ccy, amount: decimal(14, 2, dec_val)}
fn money_parse(ccy, text) = money_make(ccy, decimal_parse(text))
fn money_format(m) = m.ccy + " " + decimal_format(m.amount)
fn money_require_same_ccy(a, b, op) = if a.ccy != b.ccy then ctfail("lume: currency mismatch in " + op + ": cannot mix money[" + a.ccy + "] and money[" + b.ccy + "]\n") else 1
fn money_add(a, b) = let ok = money_require_same_ccy(a, b, "money_add") in money_make(a.ccy, decimal_add(a.amount, b.amount))
fn money_sub(a, b) = let ok = money_require_same_ccy(a, b, "money_sub") in money_make(a.ccy, decimal_sub(a.amount, b.amount))
fn money_mul_int(m, qty) = money_make(m.ccy, decimal_mul(m.amount, decimal_make(qty, 0)))
fn money_cmp(a, b) = let ok = money_require_same_ccy(a, b, "money_cmp") in decimal_compare(a.amount, b.amount)
fn money_convert_fx(m, target_ccy, rate_num, rate_den) = if rate_den <= 0 then ctfail("lume: invalid FX rate denominator\n") else money_make(target_ccy, decimal_div_exact(decimal_mul(m.amount, decimal_make(rate_num, 0)), decimal_make(rate_den, 0), 2))

## Columnar Struct-of-Arrays (`@soa`) layout & vectorised column aggregations:
fn soa_extract_col(rows, col_idx) = match rows
    Nil        => Nil
    Cons(r, t) => Cons(list_nth(r, col_idx), soa_extract_col(t, col_idx))
fn soa_build_cols(schema, rows, idx) = match schema
    Nil        => Nil
    Cons(c, r) => Cons({name: c.name, type: c.type, values: soa_extract_col(rows, idx)}, soa_build_cols(r, rows, idx + 1))
fn table_to_soa(table) = if table.ok == 0 then {ok: 0, error: table.error, row_count: 0, schema: Nil, columns: Nil} else {ok: 1, error: "", row_count: table_row_count(table), schema: table.schema, columns: soa_build_cols(table.schema, table.rows, 0)}
fn soa_find_col(cols, name) = match cols
    Nil        => {ok: 0, type: "", values: Nil}
    Cons(c, r) => if c.name == name then {ok: 1, type: c.type, values: c.values} else soa_find_col(r, name)
fn soa_sum_ints(vals) = match vals
    Nil        => 0
    Cons(v, r) => v.value + soa_sum_ints(r)
fn soa_sum_decs(vals) = match vals
    Nil        => decimal_make(0, 2)
    Cons(v, r) => decimal_add(v.value, soa_sum_decs(r))
fn soa_sum_int(soa, col_name) = let c = soa_find_col(soa.columns, col_name) in if c.ok == 0 or c.type != "int" then ctfail("lume: @soa vectorised int sum requires an 'int' column\n") else soa_sum_ints(c.values)
fn soa_sum_decimal(soa, col_name) = let c = soa_find_col(soa.columns, col_name) in if c.ok == 0 or c.type != "decimal" then ctfail("lume: @soa vectorised decimal sum requires a 'decimal' column\n") else soa_sum_decs(c.values)
fn soa_count_where_int(vals, op, target) = match vals
    Nil        => 0
    Cons(v, r) => let hit = (if op == "==" then v.value == target else if op == "!=" then v.value != target else if op == ">" then v.value > target else if op == ">=" then v.value >= target else if op == "<" then v.value < target else if op == "<=" then v.value <= target else 0) in (if hit then 1 else 0) + soa_count_where_int(r, op, target)
fn soa_filter_count_int(soa, col_name, op, target) = let c = soa_find_col(soa.columns, col_name) in if c.ok == 0 or c.type != "int" then ctfail("lume: @soa vectorised filter requires an 'int' column\n") else soa_count_where_int(c.values, op, target)
