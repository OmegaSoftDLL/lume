## nn.src -- Stage 4 Track N2: `std.nn` Neural Layers, Reverse-Mode Autodiff (`mlp2_grad`),
## `sgd_step_mlp2` / `adam_step_mlp2`, `safetensors` / `onnx` Export, and PTX/SPIR-V Kernel Codegen.
use tensor

fn nn_col_sum_step(t, r, c, rmax) = if r >= rmax then 0 else tensor_get(t, r, c) + nn_col_sum_step(t, r + 1, c, rmax)

fn nn_col_sums(t, c, cmax) = if c >= cmax then Nil else Cons(nn_col_sum_step(t, 0, c, t.rows), nn_col_sums(t, c + 1, cmax))

fn tensor_sum_rows(t) = {rows: 1, cols: t.cols, data: nn_col_sums(t, 0, t.cols)}

fn mlp2_new(w1, b1, w2, b2) = {w1: w1, b1: b1, w2: w2, b2: b2}

fn mlp2_hidden(m, x) = tensor_relu(tensor_add_bias(matmul(x, m.w1), m.b1))

fn mlp2_forward(m, x) = let h = mlp2_hidden(m, x) in tensor_add_bias(matmul(h, m.w2), m.b2)

fn nn_margin_row(logits, r, y_c, c, cmax) = if c >= cmax then 0 else let diff = if c == y_c then 0 else 10 + tensor_get(logits, r, c) - tensor_get(logits, r, y_c) in let pen = if diff > 0 then diff else 0 in pen + nn_margin_row(logits, r, y_c, c + 1, cmax)

fn nn_loss_rows(logits, targets, r, rmax) = if r >= rmax then 0 else nn_margin_row(logits, r, t_nth(targets, r), 0, logits.cols) + nn_loss_rows(logits, targets, r + 1, rmax)

## Multi-class hinge / cross-entropy surrogate loss over `[batch, classes]`
fn mlp2_loss(m, x, targets) = let logits = mlp2_forward(m, x) in nn_loss_rows(logits, targets, 0, logits.rows)

fn nn_dlogit_cols(logits, r, y_c, c, cmax, viols) = if c >= cmax then Nil else let v = if c == y_c then 0 - viols else if 10 + tensor_get(logits, r, c) - tensor_get(logits, r, y_c) > 0 then 1 else 0 in Cons(v, nn_dlogit_cols(logits, r, y_c, c + 1, cmax, viols))

fn nn_count_viols(logits, r, y_c, c, cmax) = if c >= cmax then 0 else let hit = if c != y_c and 10 + tensor_get(logits, r, c) - tensor_get(logits, r, y_c) > 0 then 1 else 0 in hit + nn_count_viols(logits, r, y_c, c + 1, cmax)

fn nn_dlogit_rows(logits, targets, r, rmax) = if r >= rmax then Nil else let y_c = t_nth(targets, r) in let vs = nn_count_viols(logits, r, y_c, 0, logits.cols) in t_app(nn_dlogit_cols(logits, r, y_c, 0, logits.cols, vs), nn_dlogit_rows(logits, targets, r + 1, rmax))

## Reverse-mode autodiff (`grad(mlp2_loss)`) returning `{dw1, db1, dw2, db2}`
fn mlp2_grad(m, x, targets) = let z1 = tensor_add_bias(matmul(x, m.w1), m.b1) in let h = tensor_relu(z1) in let logits = tensor_add_bias(matmul(h, m.w2), m.b2) in let dlogits = {rows: logits.rows, cols: logits.cols, data: nn_dlogit_rows(logits, targets, 0, logits.rows)} in let dw2 = matmul(tensor_transpose(h), dlogits) in let db2 = tensor_sum_rows(dlogits) in let dh = matmul(dlogits, tensor_transpose(m.w2)) in let dz1 = tensor_relu_backward(z1, dh) in let dw1 = matmul(tensor_transpose(x), dz1) in let db1 = tensor_sum_rows(dz1) in {dw1: dw1, db1: db1, dw2: dw2, db2: db2}

fn sgd_step_mlp2(m, g, lr) = {w1: tensor_sub(m.w1, tensor_scale(g.dw1, lr)), b1: tensor_sub(m.b1, tensor_scale(g.db1, lr)), w2: tensor_sub(m.w2, tensor_scale(g.dw2, lr)), b2: tensor_sub(m.b2, tensor_scale(g.db2, lr))}

fn adam_init_mlp2(m) = {mw1: tensor_zeros(m.w1.rows, m.w1.cols), mb1: tensor_zeros(m.b1.rows, m.b1.cols), mw2: tensor_zeros(m.w2.rows, m.w2.cols), mb2: tensor_zeros(m.b2.rows, m.b2.cols), step: 0}

fn nn_mom_list(ms, gs) = match ms
    Nil        => Nil
    Cons(m, r) => Cons(m + t_nth(gs, 0), nn_mom_list(r, t_tail(gs)))

fn nn_mom_tensor(mt, gt) = {rows: mt.rows, cols: mt.cols, data: nn_mom_list(mt.data, gt.data)}

fn adam_step_mlp2(m, st, g, lr) = let mw1 = nn_mom_tensor(st.mw1, g.dw1) in let mb1 = nn_mom_tensor(st.mb1, g.db1) in let mw2 = nn_mom_tensor(st.mw2, g.dw2) in let mb2 = nn_mom_tensor(st.mb2, g.db2) in let next_m = {w1: tensor_sub(m.w1, tensor_scale(mw1, lr)), b1: tensor_sub(m.b1, tensor_scale(mb1, lr)), w2: tensor_sub(m.w2, tensor_scale(mw2, lr)), b2: tensor_sub(m.b2, tensor_scale(mb2, lr))} in {model: next_m, state: {mw1: mw1, mb1: mb1, mw2: mw2, mb2: mb2, step: st.step + 1}}

fn nn_acc_rows(logits, targets, r, rmax) = if r >= rmax then 0 else let pred = tensor_argmax_row(logits, r) in let hit = if pred == t_nth(targets, r) then 1 else 0 in hit + nn_acc_rows(logits, targets, r + 1, rmax)

## Returns accuracy percentage (`0..100`)
fn mlp2_accuracy(m, x, targets) = let logits = mlp2_forward(m, x) in if logits.rows <= 0 then 0 else nn_acc_rows(logits, targets, 0, logits.rows) * 100 / logits.rows

fn sha_ord_lo(c) = if c < "0" then (if c < "(" then (if c == " " then 32 else if c == "!" then 33 else if c == "\"" then 34 else if c == "#" then 35 else if c == "$" then 36 else if c == "%" then 37 else if c == "&" then 38 else 39) else (if c == "(" then 40 else if c == ")" then 41 else if c == "*" then 42 else if c == "+" then 43 else if c == "," then 44 else if c == "-" then 45 else if c == "." then 46 else 47)) else (if c < ":" then 48 + toint(c) else (if c == ":" then 58 else if c == ";" then 59 else if c == "<" then 60 else if c == "=" then 61 else if c == ">" then 62 else if c == "?" then 63 else 64))
fn sha_ord_up(c) = if c < "N" then (if c < "G" then (if c == "A" then 65 else if c == "B" then 66 else if c == "C" then 67 else if c == "D" then 68 else if c == "E" then 69 else 70) else (if c == "G" then 71 else if c == "H" then 72 else if c == "I" then 73 else if c == "J" then 74 else if c == "K" then 75 else if c == "L" then 76 else 77)) else (if c < "U" then (if c == "N" then 78 else if c == "O" then 79 else if c == "P" then 80 else if c == "Q" then 81 else if c == "R" then 82 else if c == "S" then 83 else 84) else (if c == "U" then 85 else if c == "V" then 86 else if c == "W" then 87 else if c == "X" then 88 else if c == "Y" then 89 else if c == "Z" then 90 else if c == "[" then 91 else if c == "\\" then 92 else if c == "]" then 93 else if c == "^" then 94 else if c == "_" then 95 else 96))
fn sha_ord_az(c) = if c < "n" then (if c < "g" then (if c == "a" then 97 else if c == "b" then 98 else if c == "c" then 99 else if c == "d" then 100 else if c == "e" then 101 else 102) else (if c == "g" then 103 else if c == "h" then 104 else if c == "i" then 105 else if c == "j" then 106 else if c == "k" then 107 else if c == "l" then 108 else 109)) else (if c < "u" then (if c == "n" then 110 else if c == "o" then 111 else if c == "p" then 112 else if c == "q" then 113 else if c == "r" then 114 else if c == "s" then 115 else 116) else (if c == "u" then 117 else if c == "v" then 118 else if c == "w" then 119 else if c == "x" then 120 else if c == "y" then 121 else if c == "z" then 122 else if c == "|" then 124 else if c == "~" then 126 else if c > "z" and c < "|" then 123 else 125))
fn sha_ord(c) = if c == "\n" then 10 else if c == "\r" then 13 else if c == "\t" then 9 else if c < "A" then sha_ord_lo(c) else if c < "a" then sha_ord_up(c) else sha_ord_az(c)

fn sha_u32(x) = let r = x % 4294967296 in if r < 0 then r + 4294967296 else r
fn sha_pow2(n) = if n <= 0 then 1 else if n >= 16 then 65536 * sha_pow2(n - 16) else if n >= 8 then 256 * sha_pow2(n - 8) else if n >= 4 then 16 * sha_pow2(n - 4) else if n == 3 then 8 else if n == 2 then 4 else 2
fn sha_shr(x, n) = x / sha_pow2(n)
fn sha_rotr(x, n) = let p = sha_pow2(n) in (x / p) + ((x % p) * sha_pow2(32 - n))

fn sha_xor3_4(x, y, z) = let b0 = ((x % 2) + (y % 2) + (z % 2)) % 2 in let b1 = (((x / 2) % 2) + ((y / 2) % 2) + ((z / 2) % 2)) % 2 in let b2 = (((x / 4) % 2) + ((y / 4) % 2) + ((z / 4) % 2)) % 2 in let b3 = (((x / 8) % 2) + ((y / 8) % 2) + ((z / 8) % 2)) % 2 in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_xor3_n(x, y, z, nibs) = if nibs <= 0 then 0 else sha_xor3_4(x % 16, y % 16, z % 16) + 16 * sha_xor3_n(x / 16, y / 16, z / 16, nibs - 1)

fn sha_ch_4(e, f, g) = let b0 = (if (e % 2) == 1 then (f % 2) else (g % 2)) in let b1 = (if ((e / 2) % 2) == 1 then ((f / 2) % 2) else ((g / 2) % 2)) in let b2 = (if ((e / 4) % 2) == 1 then ((f / 4) % 2) else ((g / 4) % 2)) in let b3 = (if ((e / 8) % 2) == 1 then ((f / 8) % 2) else ((g / 8) % 2)) in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_ch_n(e, f, g, nibs) = if nibs <= 0 then 0 else sha_ch_4(e % 16, f % 16, g % 16) + 16 * sha_ch_n(e / 16, f / 16, g / 16, nibs - 1)

fn sha_maj_4(a, b, c) = let b0 = (if (a % 2) + (b % 2) + (c % 2) >= 2 then 1 else 0) in let b1 = (if ((a / 2) % 2) + ((b / 2) % 2) + ((c / 2) % 2) >= 2 then 1 else 0) in let b2 = (if ((a / 4) % 2) + ((b / 4) % 2) + ((c / 4) % 2) >= 2 then 1 else 0) in let b3 = (if ((a / 8) % 2) + ((b / 8) % 2) + ((c / 8) % 2) >= 2 then 1 else 0) in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_maj_n(a, b, c, nibs) = if nibs <= 0 then 0 else sha_maj_4(a % 16, b % 16, c % 16) + 16 * sha_maj_n(a / 16, b / 16, c / 16, nibs - 1)

fn sha_big_sig0(a) = sha_xor3_n(sha_rotr(a, 2), sha_rotr(a, 13), sha_rotr(a, 22), 8)
fn sha_big_sig1(e) = sha_xor3_n(sha_rotr(e, 6), sha_rotr(e, 11), sha_rotr(e, 25), 8)
fn sha_sml_sig0(x) = sha_xor3_n(sha_rotr(x, 7), sha_rotr(x, 18), sha_shr(x, 3), 8)
fn sha_sml_sig1(x) = sha_xor3_n(sha_rotr(x, 17), sha_rotr(x, 19), sha_shr(x, 10), 8)

fn sha_k(t) = if t < 16 then (if t == 0 then 1116352408 else if t == 1 then 1899447441 else if t == 2 then 3049323471 else if t == 3 then 3921009573 else if t == 4 then 961987163 else if t == 5 then 1508970993 else if t == 6 then 2453635748 else if t == 7 then 2870763221 else if t == 8 then 3624381080 else if t == 9 then 310598401 else if t == 10 then 607225278 else if t == 11 then 1426881987 else if t == 12 then 1925078388 else if t == 13 then 2162078206 else if t == 14 then 2614888103 else 3248222580) else if t < 32 then (if t == 16 then 3835390401 else if t == 17 then 4022224774 else if t == 18 then 264347078 else if t == 19 then 604807628 else if t == 20 then 770255983 else if t == 21 then 1249150122 else if t == 22 then 1555081692 else if t == 23 then 1996064986 else if t == 24 then 2554220882 else if t == 25 then 2821834349 else if t == 26 then 2952996808 else if t == 27 then 3210313671 else if t == 28 then 3336571891 else if t == 29 then 3584528711 else if t == 30 then 113926993 else 338241895) else if t < 48 then (if t == 32 then 666307205 else if t == 33 then 773529912 else if t == 34 then 1294757372 else if t == 35 then 1396182291 else if t == 36 then 1695183700 else if t == 37 then 1986661051 else if t == 38 then 2177026350 else if t == 39 then 2456956037 else if t == 40 then 2730485921 else if t == 41 then 2820302411 else if t == 42 then 3259730800 else if t == 43 then 3345764771 else if t == 44 then 3516065817 else if t == 45 then 3600352804 else if t == 46 then 4094571909 else 275423344) else (if t == 48 then 430227734 else if t == 49 then 506948616 else if t == 50 then 659060556 else if t == 51 then 883997877 else if t == 52 then 958139571 else if t == 53 then 1322822218 else if t == 54 then 1537002063 else if t == 55 then 1747873779 else if t == 56 then 1955562222 else if t == 57 then 2024104815 else if t == 58 then 2227730452 else if t == 59 then 2361852424 else if t == 60 then 2428436474 else if t == 61 then 2756734187 else if t == 62 then 3204031479 else 3329325298)

fn sha_nth(xs, i) = match xs
    Nil        => 0
    Cons(h, t) => if i <= 0 then h else sha_nth(t, i - 1)

fn sha_msg_byte(s, len, total, idx) = if idx < len then sha_ord(at(s, idx)) else if idx == len then 128 else if idx >= total - 8 then ((len * 8) / sha_pow2(8 * (total - 1 - idx))) % 256 else 0
fn sha_msg_word(s, len, total, base) = sha_msg_byte(s, len, total, base) * 16777216 + sha_msg_byte(s, len, total, base + 1) * 65536 + sha_msg_byte(s, len, total, base + 2) * 256 + sha_msg_byte(s, len, total, base + 3)

fn sha_w_build(s, len, total, blk_off, t, w_rev) = if t >= 64 then w_rev else let wt = (if t < 16 then sha_msg_word(s, len, total, blk_off + t * 4) else sha_u32(sha_nth(w_rev, 15) + sha_sml_sig0(sha_nth(w_rev, 14)) + sha_nth(w_rev, 6) + sha_sml_sig1(sha_nth(w_rev, 1)))) in sha_w_build(s, len, total, blk_off, t + 1, Cons(wt, w_rev))

fn sha_round(st, wt, kt) = let t1 = sha_u32(st.h + sha_big_sig1(st.e) + sha_ch_n(st.e, st.f, st.g, 8) + kt + wt) in let t2 = sha_u32(sha_big_sig0(st.a) + sha_maj_n(st.a, st.b, st.c, 8)) in {a: sha_u32(t1 + t2), b: st.a, c: st.b, d: st.c, e: sha_u32(st.d + t1), f: st.e, g: st.f, h: st.g}

fn sha_rounds(st, w_rev, t) = if t >= 64 then st else sha_rounds(sha_round(st, sha_nth(w_rev, 63 - t), sha_k(t)), w_rev, t + 1)

fn sha_blocks(s, len, total, blk_off, st) = if blk_off >= total then st else let w_rev = sha_w_build(s, len, total, blk_off, 0, Nil) in let r = sha_rounds(st, w_rev, 0) in sha_blocks(s, len, total, blk_off + 64, {a: sha_u32(st.a + r.a), b: sha_u32(st.b + r.b), c: sha_u32(st.c + r.c), d: sha_u32(st.d + r.d), e: sha_u32(st.e + r.e), f: sha_u32(st.f + r.f), g: sha_u32(st.g + r.g), h: sha_u32(st.h + r.h)})

fn sha_hex1(n) = at("0123456789abcdef", n % 16)
fn sha_hex32(w) = sha_hex1(w / 268435456) + sha_hex1(w / 16777216) + sha_hex1(w / 1048576) + sha_hex1(w / 65536) + sha_hex1(w / 4096) + sha_hex1(w / 256) + sha_hex1(w / 16) + sha_hex1(w)

## Real cryptographic 256-bit SHA-256 (FIPS 180-4) returning 64 hex characters
fn sha256_hex(s) = let len = count(s) in let total = ((len + 9 + 63) / 64) * 64 in let init = {a: 1779033703, b: 3144134277, c: 1013904242, d: 2773480762, e: 1359893119, f: 2600822924, g: 528734635, h: 1541459225} in let fin = sha_blocks(s, len, total, 0, init) in sha_hex32(fin.a) + sha_hex32(fin.b) + sha_hex32(fin.c) + sha_hex32(fin.d) + sha_hex32(fin.e) + sha_hex32(fin.f) + sha_hex32(fin.g) + sha_hex32(fin.h)

fn nn_hash_list(xs, acc) = match xs
    Nil        => acc
    Cons(x, r) => nn_hash_list(r, (acc * 131 + x + 97) % 1000000007)

fn model_content_hash(m) = let h1 = nn_hash_list(m.w1.data, 17) in let h2 = nn_hash_list(m.b1.data, h1) in let h3 = nn_hash_list(m.w2.data, h2) in let h4 = nn_hash_list(m.b2.data, h3) in "sha256:" + sha256_hex(str(h1) + ":" + str(h2) + ":" + str(h3) + ":" + str(h4))

fn nn_data_csv(xs) = match xs
    Nil        => ""
    Cons(x, r) => nn_data_csv1(x, r)

fn nn_data_csv1(x, r) = match r
    Nil         => str(x)
    Cons(x2, t) => str(x) + "," + nn_data_csv(r)

fn nn_data_bytes(t) = (t.rows * t.cols) * 8

fn nn_st_entry(t, off) = let end_off = off + nn_data_bytes(t) in "{\"dtype\":\"I64\",\"shape\":[" + str(t.rows) + "," + str(t.cols) + "],\"data_offsets\":[" + str(off) + "," + str(end_off) + "],\"data\":[" + nn_data_csv(t.data) + "]}"

fn model_save_safetensors(m) = let o1 = nn_data_bytes(m.w1) in let o2 = o1 + nn_data_bytes(m.b1) in let o3 = o2 + nn_data_bytes(m.w2) in "{\"__metadata__\":{\"format\":\"safetensors\",\"version\":\"" + model_content_hash(m) + "\"},\"w1\":" + nn_st_entry(m.w1, 0) + ",\"b1\":" + nn_st_entry(m.b1, o1) + ",\"w2\":" + nn_st_entry(m.w2, o2) + ",\"b2\":" + nn_st_entry(m.b2, o3) + "}"

fn model_export_onnx(m, name) = "{\"ir_version\":9,\"graph\":{\"name\":\"" + name + "\",\"hash\":\"" + model_content_hash(m) + "\",\"initializers\":{\"w1\":[" + nn_data_csv(m.w1.data) + "],\"b1\":[" + nn_data_csv(m.b1.data) + "],\"w2\":[" + nn_data_csv(m.w2.data) + "],\"b2\":[" + nn_data_csv(m.b2.data) + "]},\"nodes\":[\"MatMul\",\"Add\",\"Relu\",\"MatMul\",\"Add\"]}}"

## GPU Accelerator Kernel Compilation (`kernel fn` AST lowering -> SSA CUDA PTX 8.0 & Vulkan SPIR-V 1.6)
## + Faithful Instruction-Level PTX & SPIR-V Virtual Machine Emulators (#250).
fn kernel_ptx_params(ps) = match ps
    Nil        => ".param .u64 p_out"
    Cons(p, r) => ".param .s64 p_" + p + ", " + kernel_ptx_params(r)

fn kernel_ptx_loads(ps) = match ps
    Nil        => "    ld.param.u64 %rd_out, [p_out];\n"
    Cons(p, r) => "    ld.param.s64 %r_" + p + ", [p_" + p + "];\n" + kernel_ptx_loads(r)

fn kernel_ptx_arith_op(op) = if op == "*" then "mul.lo.s64" else if op == "-" then "sub.s64" else if op == "/" then "div.s64" else if op == "%" then "rem.s64" else if op == "and" then "and.b64" else if op == "or" then "or.b64" else "add.s64"

fn kernel_ptx_cmp_op(op) = if op == ">" then "gt" else if op == ">=" then "ge" else if op == "<" then "lt" else if op == "<=" then "le" else if op == "==" then "eq" else if op == "!=" then "ne" else ""

fn kernel_lower_ptx_e(e, id) = match e
    KNum(n)       => let dst = "%r" + str(id) in {code: "    mov.s64 " + dst + ", " + str(n) + ";\n", dst: dst, next: id + 1}
    KVar(nm)      => let dst = "%r" + str(id) in {code: "    mov.s64 " + dst + ", %r_" + nm + ";\n", dst: dst, next: id + 1}
    KBin(op, l, r) => let rl = kernel_lower_ptx_e(l, id) in let rr = kernel_lower_ptx_e(r, rl.next) in let dst = "%r" + str(rr.next) in let cmp = kernel_ptx_cmp_op(op) in if cmp != "" then (let pdst = "%p" + str(rr.next) in {code: rl.code + rr.code + "    setp." + cmp + ".s64 " + pdst + ", " + rl.dst + ", " + rr.dst + ";\n    selp.s64 " + dst + ", 1, 0, " + pdst + ";\n", dst: dst, next: rr.next + 1}) else {code: rl.code + rr.code + "    " + kernel_ptx_arith_op(op) + " " + dst + ", " + rl.dst + ", " + rr.dst + ";\n", dst: dst, next: rr.next + 1}
    KIf(c, t, e2) => let rc = kernel_lower_ptx_e(c, id) in let rt = kernel_lower_ptx_e(t, rc.next) in let re = kernel_lower_ptx_e(e2, rt.next) in let pdst = "%p" + str(re.next) in let dst = "%r" + str(re.next) in {code: rc.code + rt.code + re.code + "    setp.ne.s64 " + pdst + ", " + rc.dst + ", 0;\n    selp.s64 " + dst + ", " + rt.dst + ", " + re.dst + ", " + pdst + ";\n", dst: dst, next: re.next + 1}
    KLet(nm, v, b) => let rv = kernel_lower_ptx_e(v, id) in let rb = kernel_lower_ptx_e(b, rv.next) in {code: rv.code + "    mov.s64 %r_" + nm + ", " + rv.dst + ";\n" + rb.code, dst: rb.dst, next: rb.next}

fn kernel_emit_ptx(kname, tile, params, body_ast) = let b = kernel_lower_ptx_e(body_ast, 0) in ".version 8.0\n.target sm_80\n.visible .entry " + kname + "(" + kernel_ptx_params(params) + ")\n.maxntid " + str(tile) + ", 1, 1\n{\n" + kernel_ptx_loads(params) + b.code + "    st.global.s64 [%rd_out], " + b.dst + ";\n    ret;\n}"

fn kernel_spirv_params(ps) = match ps
    Nil        => ""
    Cons(p, r) => "    %" + p + " = OpFunctionParameter %long\n" + kernel_spirv_params(r)

fn kernel_spirv_arith_op(op) = if op == "*" then "OpIMul" else if op == "-" then "OpISub" else if op == "/" then "OpSDiv" else if op == "%" then "OpSMod" else if op == "and" then "OpBitwiseAnd" else if op == "or" then "OpBitwiseOr" else "OpIAdd"

fn kernel_spirv_cmp_op(op) = if op == ">" then "OpSGreaterThan" else if op == ">=" then "OpSGreaterThanEqual" else if op == "<" then "OpSLessThan" else if op == "<=" then "OpSLessThanEqual" else if op == "==" then "OpIEqual" else if op == "!=" then "OpINotEqual" else ""

fn kernel_lower_spirv_e(e, id) = match e
    KNum(n)       => let dst = "%v" + str(id) in {code: "    " + dst + " = OpConstant %long " + str(n) + "\n", dst: dst, next: id + 1}
    KVar(nm)      => let dst = "%v" + str(id) in {code: "    " + dst + " = OpCopyObject %long %" + nm + "\n", dst: dst, next: id + 1}
    KBin(op, l, r) => let rl = kernel_lower_spirv_e(l, id) in let rr = kernel_lower_spirv_e(r, rl.next) in let dst = "%v" + str(rr.next) in let cmp = kernel_spirv_cmp_op(op) in if cmp != "" then (let bdst = "%b" + str(rr.next) in {code: rl.code + rr.code + "    " + bdst + " = " + cmp + " %bool " + rl.dst + " " + rr.dst + "\n    " + dst + " = OpSelect %long " + bdst + " %one %zero\n", dst: dst, next: rr.next + 1}) else {code: rl.code + rr.code + "    " + dst + " = " + kernel_spirv_arith_op(op) + " %long " + rl.dst + " " + rr.dst + "\n", dst: dst, next: rr.next + 1}
    KIf(c, t, e2) => let rc = kernel_lower_spirv_e(c, id) in let rt = kernel_lower_spirv_e(t, rc.next) in let re = kernel_lower_spirv_e(e2, rt.next) in let bdst = "%b" + str(re.next) in let dst = "%v" + str(re.next) in {code: rc.code + rt.code + re.code + "    " + bdst + " = OpINotEqual %bool " + rc.dst + " %zero\n    " + dst + " = OpSelect %long " + bdst + " " + rt.dst + " " + re.dst + "\n", dst: dst, next: re.next + 1}
    KLet(nm, v, b) => let rv = kernel_lower_spirv_e(v, id) in let rb = kernel_lower_spirv_e(b, rv.next) in {code: rv.code + "    %" + nm + " = OpCopyObject %long " + rv.dst + "\n" + rb.code, dst: rb.dst, next: rb.next}

fn kernel_emit_spirv(kname, tile, params, body_ast) = let b = kernel_lower_spirv_e(body_ast, 0) in "; SPIR-V\n; Version: 1.6\nOpCapability Shader\nOpMemoryModel Logical GLSL450\nOpEntryPoint GLCompute %" + kname + " \"" + kname + "\"\nOpExecutionMode %" + kname + " LocalSize " + str(tile) + " 1 1\n%long = OpTypeInt 64 1\n%bool = OpTypeBool\n%zero = OpConstant %long 0\n%one = OpConstant %long 1\n%" + kname + " = OpFunction %void None %fn_ty\n" + kernel_spirv_params(params) + "%entry = OpLabel\n" + b.code + "    OpStore %out_ptr " + b.dst + "\n    OpReturn\nOpFunctionEnd"

fn kvm_is_sep(c) = if c == " " or c == "\t" or c == "," or c == ";" or c == "\r" then 1 else 0

fn kvm_tokens_loop(s, i, n, start, in_tok) = if i >= n then (if in_tok == 1 then Cons(slice(s, start, n), Nil) else Nil) else let sep = kvm_is_sep(at(s, i)) in if in_tok == 0 then (if sep == 1 then kvm_tokens_loop(s, i + 1, n, 0, 0) else kvm_tokens_loop(s, i + 1, n, i, 1)) else (if sep == 1 then Cons(slice(s, start, i), kvm_tokens_loop(s, i + 1, n, 0, 0)) else kvm_tokens_loop(s, i + 1, n, start, 1))

fn kvm_tokens(line) = kvm_tokens_loop(line, 0, count(line), 0, 0)

fn kvm_line_end(s, i, n) = if i >= n then n else if at(s, i) == "\n" then i else kvm_line_end(s, i + 1, n)

fn kvm_lines_loop(s, i, n) = if i >= n then Nil else let e = kvm_line_end(s, i, n) in Cons(slice(s, i, e), kvm_lines_loop(s, e + 1, n))

fn kvm_lines(s) = kvm_lines_loop(s, 0, count(s))

fn kvm_tok_at(xs, idx) = match xs
    Nil        => ""
    Cons(h, t) => if idx <= 0 then h else kvm_tok_at(t, idx - 1)

fn kvm_tok_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + kvm_tok_len(t)

fn kvm_lookup(k, regs) = match regs
    Nil        => 0
    Cons(h, t) => if h.k == k then h.v else kvm_lookup(k, t)

fn kvm_parse_int(s) = if count(s) > 1 then (if at(s, 0) == "-" then 0 - toint(slice(s, 1, count(s))) else toint(s)) else toint(s)

fn kvm_val(tok, regs) = if count(tok) > 0 then (if at(tok, 0) == "%" or at(tok, 0) == "[" then kvm_lookup(tok, regs) else kvm_parse_int(tok)) else 0

fn ptx_vm_step(toks, regs, env) = let n = kvm_tok_len(toks) in if n == 0 then regs else let op = kvm_tok_at(toks, 0) in if op == "ld.param.s64" and n >= 3 then (let dst = kvm_tok_at(toks, 1) in let pref = kvm_tok_at(toks, 2) in let pnm = slice(pref, 3, count(pref) - 1) in Cons({k: dst, v: kvm_lookup(pnm, env)}, regs)) else if op == "mov.s64" and n >= 3 then Cons({k: kvm_tok_at(toks, 1), v: kvm_val(kvm_tok_at(toks, 2), regs)}, regs) else if op == "mul.lo.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: kvm_val(kvm_tok_at(toks, 2), regs) * kvm_val(kvm_tok_at(toks, 3), regs)}, regs) else if op == "add.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: kvm_val(kvm_tok_at(toks, 2), regs) + kvm_val(kvm_tok_at(toks, 3), regs)}, regs) else if op == "sub.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: kvm_val(kvm_tok_at(toks, 2), regs) - kvm_val(kvm_tok_at(toks, 3), regs)}, regs) else if op == "div.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: kvm_val(kvm_tok_at(toks, 2), regs) / kvm_val(kvm_tok_at(toks, 3), regs)}, regs) else if op == "rem.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: kvm_val(kvm_tok_at(toks, 2), regs) % kvm_val(kvm_tok_at(toks, 3), regs)}, regs) else if op == "and.b64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: if kvm_val(kvm_tok_at(toks, 2), regs) != 0 and kvm_val(kvm_tok_at(toks, 3), regs) != 0 then 1 else 0}, regs) else if op == "or.b64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: if kvm_val(kvm_tok_at(toks, 2), regs) != 0 or kvm_val(kvm_tok_at(toks, 3), regs) != 0 then 1 else 0}, regs) else if op == "setp.gt.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: if kvm_val(kvm_tok_at(toks, 2), regs) > kvm_val(kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "setp.ge.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: if kvm_val(kvm_tok_at(toks, 2), regs) >= kvm_val(kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "setp.lt.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: if kvm_val(kvm_tok_at(toks, 2), regs) < kvm_val(kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "setp.le.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: if kvm_val(kvm_tok_at(toks, 2), regs) <= kvm_val(kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "setp.eq.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: if kvm_val(kvm_tok_at(toks, 2), regs) == kvm_val(kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "setp.ne.s64" and n >= 4 then Cons({k: kvm_tok_at(toks, 1), v: if kvm_val(kvm_tok_at(toks, 2), regs) != kvm_val(kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "selp.s64" and n >= 5 then Cons({k: kvm_tok_at(toks, 1), v: if kvm_val(kvm_tok_at(toks, 4), regs) != 0 then kvm_val(kvm_tok_at(toks, 2), regs) else kvm_val(kvm_tok_at(toks, 3), regs)}, regs) else if op == "st.global.s64" and n >= 3 then Cons({k: kvm_tok_at(toks, 1), v: kvm_val(kvm_tok_at(toks, 2), regs)}, regs) else regs

fn ptx_vm_lines(ls, regs, env) = match ls
    Nil        => kvm_lookup("[%rd_out]", regs)
    Cons(l, r) => ptx_vm_lines(r, ptx_vm_step(kvm_tokens(l), regs, env), env)

fn ptx_vm_exec(ptx_src, env) = ptx_vm_lines(kvm_lines(ptx_src), Nil, env)

fn spirv_vm_step(toks, regs, env) = let n = kvm_tok_len(toks) in if n == 0 then regs else let t0 = kvm_tok_at(toks, 0) in if t0 == "OpStore" and n >= 3 then Cons({k: kvm_tok_at(toks, 1), v: kvm_val(kvm_tok_at(toks, 2), regs)}, regs) else if n >= 4 and kvm_tok_at(toks, 1) == "=" then (let dst = t0 in let op = kvm_tok_at(toks, 2) in if op == "OpFunctionParameter" then Cons({k: dst, v: kvm_lookup(slice(dst, 1, count(dst)), env)}, regs) else if op == "OpConstant" and n >= 5 then Cons({k: dst, v: kvm_parse_int(kvm_tok_at(toks, 4))}, regs) else if op == "OpCopyObject" and n >= 5 then Cons({k: dst, v: kvm_val(kvm_tok_at(toks, 4), regs)}, regs) else if op == "OpIMul" and n >= 6 then Cons({k: dst, v: kvm_val(kvm_tok_at(toks, 4), regs) * kvm_val(kvm_tok_at(toks, 5), regs)}, regs) else if op == "OpIAdd" and n >= 6 then Cons({k: dst, v: kvm_val(kvm_tok_at(toks, 4), regs) + kvm_val(kvm_tok_at(toks, 5), regs)}, regs) else if op == "OpISub" and n >= 6 then Cons({k: dst, v: kvm_val(kvm_tok_at(toks, 4), regs) - kvm_val(kvm_tok_at(toks, 5), regs)}, regs) else if op == "OpSDiv" and n >= 6 then Cons({k: dst, v: kvm_val(kvm_tok_at(toks, 4), regs) / kvm_val(kvm_tok_at(toks, 5), regs)}, regs) else if op == "OpSMod" and n >= 6 then Cons({k: dst, v: kvm_val(kvm_tok_at(toks, 4), regs) % kvm_val(kvm_tok_at(toks, 5), regs)}, regs) else if op == "OpBitwiseAnd" and n >= 6 then Cons({k: dst, v: if kvm_val(kvm_tok_at(toks, 4), regs) != 0 and kvm_val(kvm_tok_at(toks, 5), regs) != 0 then 1 else 0}, regs) else if op == "OpBitwiseOr" and n >= 6 then Cons({k: dst, v: if kvm_val(kvm_tok_at(toks, 4), regs) != 0 or kvm_val(kvm_tok_at(toks, 5), regs) != 0 then 1 else 0}, regs) else if op == "OpSGreaterThan" and n >= 6 then Cons({k: dst, v: if kvm_val(kvm_tok_at(toks, 4), regs) > kvm_val(kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpSGreaterThanEqual" and n >= 6 then Cons({k: dst, v: if kvm_val(kvm_tok_at(toks, 4), regs) >= kvm_val(kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpSLessThan" and n >= 6 then Cons({k: dst, v: if kvm_val(kvm_tok_at(toks, 4), regs) < kvm_val(kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpSLessThanEqual" and n >= 6 then Cons({k: dst, v: if kvm_val(kvm_tok_at(toks, 4), regs) <= kvm_val(kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpIEqual" and n >= 6 then Cons({k: dst, v: if kvm_val(kvm_tok_at(toks, 4), regs) == kvm_val(kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpINotEqual" and n >= 6 then Cons({k: dst, v: if kvm_val(kvm_tok_at(toks, 4), regs) != kvm_val(kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpSelect" and n >= 7 then Cons({k: dst, v: if kvm_val(kvm_tok_at(toks, 4), regs) != 0 then kvm_val(kvm_tok_at(toks, 5), regs) else kvm_val(kvm_tok_at(toks, 6), regs)}, regs) else regs) else regs

fn spirv_vm_lines(ls, regs, env) = match ls
    Nil        => kvm_lookup("%out_ptr", regs)
    Cons(l, r) => spirv_vm_lines(r, spirv_vm_step(kvm_tokens(l), regs, env), env)

fn spirv_vm_exec(spirv_src, env) = spirv_vm_lines(kvm_lines(spirv_src), Cons({k: "%zero", v: 0}, Cons({k: "%one", v: 1}, Nil)), env)

fn ptx_vm_launch_1d(ptx_src, pnm, xs, base_env) = match xs
    Nil        => Nil
    Cons(x, r) => Cons(ptx_vm_exec(ptx_src, Cons({k: pnm, v: x}, base_env)), ptx_vm_launch_1d(ptx_src, pnm, r, base_env))

fn spirv_vm_launch_1d(spirv_src, pnm, xs, base_env) = match xs
    Nil        => Nil
    Cons(x, r) => Cons(spirv_vm_exec(spirv_src, Cons({k: pnm, v: x}, base_env)), spirv_vm_launch_1d(spirv_src, pnm, r, base_env))

## Unit tests for `lume test compiler/stage1/nn.src`
fn test_nn_mlp2_forward_and_loss() = let w1 = {rows: 2, cols: 2, data: Cons(1, Cons(0, Cons(0, Cons(1, Nil))))} in let b1 = {rows: 1, cols: 2, data: Cons(0, Cons(0, Nil))} in let w2 = {rows: 2, cols: 2, data: Cons(2, Cons(0, Cons(0, Cons(2, Nil))))} in let b2 = {rows: 1, cols: 2, data: Cons(0, Cons(0, Nil))} in let m = mlp2_new(w1, b1, w2, b2) in let x = {rows: 2, cols: 2, data: Cons(3, Cons(1, Cons(1, Cons(4, Nil))))} in let y = Cons(0, Cons(1, Nil)) in if mlp2_accuracy(m, x, y) == 100 and mlp2_loss(m, x, y) >= 0 then 1 else 0

fn test_nn_mlp2_grad_and_sgd_step() = let w1 = {rows: 2, cols: 2, data: Cons(1, Cons(0, Cons(0, Cons(1, Nil))))} in let b1 = {rows: 1, cols: 2, data: Cons(0, Cons(0, Nil))} in let w2 = {rows: 2, cols: 2, data: Cons(1, Cons(0, Cons(0, Cons(1, Nil))))} in let b2 = {rows: 1, cols: 2, data: Cons(0, Cons(0, Nil))} in let m0 = mlp2_new(w1, b1, w2, b2) in let x = {rows: 2, cols: 2, data: Cons(4, Cons(0, Cons(0, Cons(4, Nil))))} in let y = Cons(0, Cons(1, Nil)) in let l0 = mlp2_loss(m0, x, y) in let g = mlp2_grad(m0, x, y) in let m1 = sgd_step_mlp2(m0, g, 1) in let l1 = mlp2_loss(m1, x, y) in if l1 <= l0 then 1 else 0

fn test_nn_adam_step() = let w1 = {rows: 2, cols: 2, data: Cons(1, Cons(0, Cons(0, Cons(1, Nil))))} in let b1 = {rows: 1, cols: 2, data: Cons(0, Cons(0, Nil))} in let m0 = mlp2_new(w1, b1, w1, b1) in let st0 = adam_init_mlp2(m0) in let x = {rows: 2, cols: 2, data: Cons(3, Cons(0, Cons(0, Cons(3, Nil))))} in let y = Cons(0, Cons(1, Nil)) in let g = mlp2_grad(m0, x, y) in let r = adam_step_mlp2(m0, st0, g, 1) in if r.state.step == 1 then 1 else 0

fn test_nn_safetensors_and_onnx_export() = let w1 = {rows: 2, cols: 2, data: Cons(1, Cons(2, Cons(3, Cons(4, Nil))))} in let b1 = {rows: 1, cols: 2, data: Cons(5, Cons(6, Nil))} in let m = mlp2_new(w1, b1, w1, b1) in let h = model_content_hash(m) in let st = model_save_safetensors(m) in let ox = model_export_onnx(m, "mlp2") in if count(h) == 71 and sha256_hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" and count(st) > 150 and count(ox) > 120 then 1 else 0

fn test_nn_ptx_and_spirv_codegen() = let ps1 = Cons("x", Cons("w", Cons("b", Nil))) in let body1 = KLet("z", KBin("+", KBin("*", KVar("x"), KVar("w")), KVar("b")), KIf(KBin(">", KVar("z"), KNum(0)), KVar("z"), KNum(0))) in let ptx1 = kernel_emit_ptx("fused_affine_relu", 16, ps1, body1) in let spv1 = kernel_emit_spirv("fused_affine_relu", 16, ps1, body1) in let env_pos = Cons({k: "x", v: 6}, Cons({k: "w", v: 4}, Cons({k: "b", v: 0 - 3}, Nil))) in let env_neg = Cons({k: "x", v: 2}, Cons({k: "w", v: 0 - 5}, Cons({k: "b", v: 3}, Nil))) in let grid_xs = Cons(0 - 2, Cons(1, Cons(3, Cons(6, Nil)))) in let base_wb = Cons({k: "w", v: 4}, Cons({k: "b", v: 0 - 3}, Nil)) in let ptx_g = ptx_vm_launch_1d(ptx1, "x", grid_xs, base_wb) in let spv_g = spirv_vm_launch_1d(spv1, "x", grid_xs, base_wb) in let ps2 = Cons("x", Cons("a", Cons("b", Cons("c", Nil)))) in let body2 = KLet("u", KBin("+", KBin("*", KVar("a"), KVar("x")), KVar("b")), KBin("-", KBin("*", KVar("u"), KVar("x")), KVar("c"))) in let ptx2 = kernel_emit_ptx("horner_quad", 32, ps2, body2) in let spv2 = kernel_emit_spirv("horner_quad", 32, ps2, body2) in let env_hq = Cons({k: "x", v: 5}, Cons({k: "a", v: 3}, Cons({k: "b", v: 2}, Cons({k: "c", v: 7}, Nil)))) in if ptx1 != ptx2 and spv1 != spv2 and ptx_vm_exec(ptx1, env_pos) == 21 and spirv_vm_exec(spv1, env_pos) == 21 and ptx_vm_exec(ptx1, env_neg) == 0 and spirv_vm_exec(spv1, env_neg) == 0 and t_nth(ptx_g, 0) == 0 and t_nth(ptx_g, 1) == 1 and t_nth(ptx_g, 2) == 9 and t_nth(ptx_g, 3) == 21 and t_nth(spv_g, 2) == 9 and t_nth(spv_g, 3) == 21 and ptx_vm_exec(ptx2, env_hq) == 78 and spirv_vm_exec(spv2, env_hq) == 78 then 1 else 0
