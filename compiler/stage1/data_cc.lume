## data_cc.lume — compile an ML-core (.src) program to C via data_codegen (transitional).
## Usage: lume0 run data_cc.lume in.src out.c  (then cc out.c -o prog ; ./prog)
## C here is only the bootstrap seed; this lowering is being ported to the native backend.
use data_ast
use data_parser
use data_codegen
use std.io

fn main()
    let args = env.args()
    if args.len() < 2
        io.println("usage: data_cc.lume <in.src> <out.c>")
    else
        let c = cgen_data(parse_data_program(io.read_file(args[0])))
        let w = io.write_file(args[1], c)
        io.println("compiled {args[0]} -> {args[1]}")
