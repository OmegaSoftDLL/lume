## lmesh.src -- versioned semantic intent negotiation and AST transactions (#337, partial P0).

use lcaas

fn ms_diag(code, phase, message, fixit) = cs_mkdiag(code, phase, message, fixit)
fn ms_error(mode, ds) = "{\"ok\":false,\"protocol\":\"lume-semantic-intent/0.1\",\"mode\":\"" + cs_jesc(mode) + "\",\"diagnostics\":[" + cs_diags_json(ds) + "]}"
fn ms_error1(mode, d) = ms_error(mode, Cons(d, Nil))
fn ms_field(s) = str(count(s)) + ":" + s
fn ms_bool(b) = if b == 1 then "true" else "false"
fn ms_strs_json(xs) = "[" + cs_strlist_json(xs) + "]"
fn ms_target(name) = if name == "x86_64-linux-elf" or name == "linux-x86_64" or name == "x86_64-unknown-linux-gnu" then {ok: 1, triple: "x86_64-linux-elf"} else if name == "lumb" or name == "lumb-portable-vm" then {ok: 1, triple: "lumb"} else {ok: 0, triple: name}

fn ms_ascii_i(s, i, n) = if i >= n then 1 else let c = at(s, i) in if c == "\n" or c == "\t" then ms_ascii_i(s, i + 1, n) else if c == "\r" then (if i + 1 < n and at(s, i + 1) == "\n" then ms_ascii_i(s, i + 1, n) else 0) else if c < " " or c > "~" then 0 else ms_ascii_i(s, i + 1, n)
fn ms_ascii(s) = ms_ascii_i(s, 0, count(s))
fn ms_digits_i(s, i, n) = if i >= n then 1 else if cs_isdigit(at(s, i)) == 1 then ms_digits_i(s, i + 1, n) else 0
fn ms_nat(s) = if count(s) == 0 then 0 else if ms_digits_i(s, 0, count(s)) == 0 then 0 else if toint(s) <= 0 then 0 else 1

fn ms_head(ls) = match ls
    Nil => ""
    Cons(h, t) => cs_chomp(h)
fn ms_tail(ls) = match ls
    Nil => Nil
    Cons(h, t) => t
fn ms_take(ls, prefix) = let line = ms_head(ls) in if cs_startswith(line, prefix) == 1 then {ok: 1, value: slice(line, count(prefix), count(line)), rest: ms_tail(ls)} else {ok: 0, value: "", rest: ls}
fn ms_expected(ls, prefix, mode) = let r = ms_take(ls, prefix) in if r.ok == 1 then r else {ok: 0, value: "", rest: ls, diagnostic: ms_diag("M1002", "payload", "invalid or ambiguous payload: expected exactly one '" + cs_chomp(prefix) + "' field", "follow the versioned field order and remove duplicate or unknown fields")}

fn ms_source_lines(ls, acc) = match ls
    Nil => {ok: 0, source: "", rest: Nil}
    Cons(h, t) => let line = cs_chomp(h) in if line == "@end" then {ok: 1, source: cs_joinsep(cs_rev(acc), "\n"), rest: t} else ms_source_lines(t, Cons(line, acc))
fn ms_source(ls) = let r = ms_take(ls, "@source") in if r.ok == 1 and r.value == "" then ms_source_lines(r.rest, Nil) else {ok: 0, source: "", rest: ls}

fn ms_cap_known(c) = c == "io" or c == "fs" or c == "net" or c == "alloc" or c == "async" or c == "fail" or c == "panic" or c == "rand" or c == "time" or c == "prob" or c == "llm" or c == "wasm" or c == "ffi"
fn ms_cap_insert(c, xs) = match xs
    Nil => Cons(c, Nil)
    Cons(h, t) => if c == h then Nil else if c < h then Cons(c, Cons(h, t)) else let r = ms_cap_insert(c, t) in if cs_isnil(r) == 1 then Nil else Cons(h, r)
fn ms_cap_parse_i(s, i, n, acc) = let j = lc_find_ch(s, i, n, ",") in let c = slice(s, i, j) in if count(c) == 0 or ms_cap_known(c) == 0 then Nil else let next = ms_cap_insert(c, acc) in if cs_isnil(next) == 1 then Nil else if j >= n then next else ms_cap_parse_i(s, j + 1, n, next)
fn ms_caps(s) = if s == "pure" then Nil else ms_cap_parse_i(s, 0, count(s), Nil)
fn ms_caps_text(caps) = if cs_isnil(caps) == 1 then "pure" else cs_joinsep(caps, ",")
fn ms_caps_missing(xs, ys) = match xs
    Nil => Nil
    Cons(h, t) => if cs_omem(h, ys) == 1 then ms_caps_missing(t, ys) else Cons(h, ms_caps_missing(t, ys))

fn ms_resources(s) = let p = lc_find_ch(s, 0, count(s), ",") in if p >= count(s) then {ok: 0, max_source: 0, max_tx: 0, text: s} else let a = slice(s, 0, p) in let b = slice(s, p + 1, count(s)) in if cs_startswith(a, "max_source_bytes=") == 1 and cs_startswith(b, "max_transactions=") == 1 then let av = slice(a, 17, count(a)) in let bv = slice(b, 17, count(b)) in if ms_nat(av) == 1 and ms_nat(bv) == 1 then {ok: 1, max_source: toint(av), max_tx: toint(bv), text: a + "," + b} else {ok: 0, max_source: 0, max_tx: 0, text: s} else {ok: 0, max_source: 0, max_tx: 0, text: s}

fn ms_parse_op(kind, ls) = if kind == "add_contract" or kind == "replace_contract" then let a = ms_expected(ls, "@symbol ", "transact") in if a.ok == 0 then {ok: 0, rest: ls, diagnostic: a.diagnostic} else let b = ms_expected(a.rest, "@kind ", "transact") in if b.ok == 0 then {ok: 0, rest: ls, diagnostic: b.diagnostic} else let c = ms_expected(b.rest, "@expr ", "transact") in if c.ok == 0 then {ok: 0, rest: ls, diagnostic: c.diagnostic} else let d = ms_take(c.rest, "@end") in if d.ok == 0 or d.value != "" then {ok: 0, rest: ls, diagnostic: ms_diag("M1002", "payload", "invalid or ambiguous contract operation terminator", "use one @end and no trailing fields")} else if count(a.value) == 0 or (b.value != "requires" and b.value != "ensures") or count(c.value) == 0 then {ok: 0, rest: ls, diagnostic: ms_diag("M1002", "payload", "invalid contract operation: symbol, kind, and expression are required", "use kind requires or ensures with a nonempty expression")} else {ok: 1, op: {kind: kind, symbol: a.value, ckind: b.value, expr: c.value, from_idx: 0, to: 0, target: ""}, rest: d.rest} else if kind == "set_target" then let a = ms_expected(ls, "@target ", "transact") in if a.ok == 0 then {ok: 0, rest: ls, diagnostic: a.diagnostic} else let d = ms_take(a.rest, "@end") in if d.ok == 0 or d.value != "" or count(a.value) == 0 then {ok: 0, rest: ls, diagnostic: ms_diag("M1002", "payload", "invalid set_target operation", "provide exactly one target and @end")} else {ok: 1, op: {kind: kind, symbol: "", ckind: "", expr: "", from_idx: 0, to: 0, target: a.value}, rest: d.rest} else if kind == "rollback" then let a = ms_expected(ls, "@to ", "transact") in if a.ok == 0 then {ok: 0, rest: ls, diagnostic: a.diagnostic} else let d = ms_take(a.rest, "@end") in if d.ok == 0 or d.value != "" or count(a.value) == 0 or ms_digits_i(a.value, 0, count(a.value)) == 0 then {ok: 0, rest: ls, diagnostic: ms_diag("M1002", "payload", "invalid rollback operation", "provide a nonnegative lineage index with @to and @end")} else {ok: 1, op: {kind: kind, symbol: "", ckind: "", expr: "", from_idx: 0, to: toint(a.value), target: ""}, rest: d.rest} else if kind == "replay" then let a = ms_expected(ls, "@from ", "transact") in if a.ok == 0 then {ok: 0, rest: ls, diagnostic: a.diagnostic} else let b = ms_expected(a.rest, "@to ", "transact") in if b.ok == 0 then {ok: 0, rest: ls, diagnostic: b.diagnostic} else let d = ms_take(b.rest, "@end") in if d.ok == 0 or d.value != "" or count(a.value) == 0 or ms_digits_i(a.value, 0, count(a.value)) == 0 or ms_nat(b.value) == 0 then {ok: 0, rest: ls, diagnostic: ms_diag("M1002", "payload", "invalid replay operation", "provide nonnegative @from and positive @to lineage indexes")} else {ok: 1, op: {kind: kind, symbol: "", ckind: "", expr: "", from_idx: toint(a.value), to: toint(b.value), target: ""}, rest: d.rest} else {ok: 0, rest: ls, diagnostic: ms_diag("M1003", "mode", "unknown transaction operation '" + kind + "'", "use add_contract, replace_contract, set_target, rollback, or replay")}

fn ms_parse_ops(ls, acc) = match ls
    Nil => {ok: 1, ops: cs_rev(acc)}
    Cons(h, t) => let line = cs_chomp(h) in if cs_startswith(line, "@op ") == 1 then let r = ms_parse_op(slice(line, 4, count(line)), t) in if r.ok == 0 then {ok: 0, ops: Nil, diagnostic: r.diagnostic} else ms_parse_ops(r.rest, Cons(r.op, acc)) else {ok: 0, ops: Nil, diagnostic: ms_diag("M1002", "payload", "unknown, duplicate, or trailing payload field '" + line + "'", "remove the field or place it in its exact protocol position")}

fn ms_parse(input) = if ms_ascii(input) == 0 then {ok: 0, mode: "unknown", diagnostic: ms_diag("M1001", "encoding", "payload must contain printable ASCII with only LF, CRLF, or tab whitespace", "encode non-ASCII content in a future versioned extension instead of relying on ambiguous bytes")} else let ls = lc_split_lines(input, 0, count(input)) in let p = ms_take(ls, "@protocol lume-semantic-intent/0.1") in if p.ok == 0 or p.value != "" then {ok: 0, mode: "unknown", diagnostic: ms_diag("M1002", "payload", "missing or unsupported protocol header", "start with @protocol lume-semantic-intent/0.1")} else let m = ms_expected(p.rest, "@mode ", "unknown") in if m.ok == 0 then {ok: 0, mode: "unknown", diagnostic: m.diagnostic} else if m.value != "negotiate" and m.value != "transact" then {ok: 0, mode: m.value, diagnostic: ms_diag("M1003", "mode", "unknown protocol mode '" + m.value + "'", "use negotiate or transact")} else let g = ms_expected(m.rest, "@goal ", m.value) in if g.ok == 0 then {ok: 0, mode: m.value, diagnostic: g.diagnostic} else let t = ms_expected(g.rest, "@target ", m.value) in if t.ok == 0 then {ok: 0, mode: m.value, diagnostic: t.diagnostic} else let c = ms_expected(t.rest, "@capabilities ", m.value) in if c.ok == 0 then {ok: 0, mode: m.value, diagnostic: c.diagnostic} else let r = ms_expected(c.rest, "@resources ", m.value) in if r.ok == 0 then {ok: 0, mode: m.value, diagnostic: r.diagnostic} else let a = ms_expected(r.rest, "@acceptance ", m.value) in if a.ok == 0 then {ok: 0, mode: m.value, diagnostic: a.diagnostic} else let s = ms_source(a.rest) in if s.ok == 0 then {ok: 0, mode: m.value, diagnostic: ms_diag("M1002", "payload", "missing or unterminated source block", "provide @source, a nonempty Lume program, and @end")} else let ops = ms_parse_ops(s.rest, Nil) in if ops.ok == 0 then {ok: 0, mode: m.value, diagnostic: ops.diagnostic} else let caps = ms_caps(c.value) in let resources = ms_resources(r.value) in if count(g.value) == 0 or count(t.value) == 0 or count(s.source) == 0 then {ok: 0, mode: m.value, diagnostic: ms_diag("M1002", "payload", "goal, target, and source must be nonempty", "provide all required negotiation fields")} else if c.value != "pure" and cs_isnil(caps) == 1 then {ok: 0, mode: m.value, diagnostic: ms_diag("M1002", "capabilities", "unknown, duplicate, or empty capability declaration", "use pure or a comma-separated set of supported capabilities without duplicates")} else if resources.ok == 0 then {ok: 0, mode: m.value, diagnostic: ms_diag("M1002", "resources", "invalid resource bounds", "use max_source_bytes=N,max_transactions=N with positive decimal integers in that order")} else if a.value != "compile" and a.value != "prove" then {ok: 0, mode: m.value, diagnostic: ms_diag("M1002", "acceptance", "unsupported acceptance criterion '" + a.value + "'", "use compile or prove")} else if m.value == "negotiate" and cs_isnil(ops.ops) == 0 then {ok: 0, mode: m.value, diagnostic: ms_diag("M1002", "payload", "negotiate does not accept transaction operations", "use mode transact")} else if m.value == "transact" and cs_isnil(ops.ops) == 1 then {ok: 0, mode: m.value, diagnostic: ms_diag("M1002", "payload", "transact requires at least one operation", "add a versioned @op block")} else if count(s.source) > resources.max_source or cs_len(ops.ops) > resources.max_tx then {ok: 0, mode: m.value, diagnostic: ms_diag("M2005", "resources", "request exceeds negotiated source or transaction bounds", "reduce the payload or negotiate larger explicit bounds")} else {ok: 1, mode: m.value, goal: g.value, target: t.value, caps: caps, resources: resources, acceptance: a.value, source: s.source, ops: ops.ops}

fn ms_ty_supported(ty) = match ty
    TyAny => 1
    TyName(nm) => if count(nm) > 0 then 1 else 0
    TyList(inner) => ms_ty_supported(inner)
    TyApply(kind, inner) => if count(kind) > 0 then ms_ty_supported(inner) else 0
    _ => 0
fn ms_tys_supported(tys) = match tys
    Nil => 1
    Cons(h, t) => if ms_ty_supported(h) == 1 then ms_tys_supported(t) else 0
fn ms_expr_supported(e) = match e
    Num(n) => 1
    Str(s) => 1
    Var(nm) => if count(nm) > 0 then 1 else 0
    Bin(op, a, b) => if cs_isvalidbinop(op) == 1 and ms_expr_supported(a) == 1 then ms_expr_supported(b) else 0
    If(c, t, e2) => if ms_expr_supported(c) == 1 and ms_expr_supported(t) == 1 then ms_expr_supported(e2) else 0
    LetIn(nm, v, b) => if count(nm) > 0 and ms_expr_supported(v) == 1 then ms_expr_supported(b) else 0
    VarIn(nm, v, b) => if count(nm) > 0 and ms_expr_supported(v) == 1 then ms_expr_supported(b) else 0
    Call(nm, args) => if count(nm) > 0 then ms_exprs_supported(args) else 0
    _ => 0
fn ms_exprs_supported(xs) = match xs
    Nil => 1
    Cons(h, t) => if ms_expr_supported(h) == 1 then ms_exprs_supported(t) else 0
fn ms_pl_supported(pl) = match pl
    Nil => 1
    Cons(h, t) => if h.cf == 0 and count(h.pn) > 0 and ms_ty_supported(h.pt) == 1 then ms_pl_supported(t) else 0
fn ms_stmt_supported(st) = match st
    Fn(nm, ps, body) => if count(nm) > 0 then ms_expr_supported(body) else 0
    Sig(nm, ps, tys, rt) => if count(nm) > 0 and ms_tys_supported(tys) == 1 then ms_ty_supported(rt) else 0
    OSig(nm, pubf, freef, pl, rt, fromp) => if count(nm) > 0 and freef == 0 and fromp == "" and ms_pl_supported(pl) == 1 then ms_ty_supported(rt) else 0
    KEffSig(nm, effs) => if count(nm) > 0 then 1 else 0
    VContractSig(nm, ps, reqs, enss) => if count(nm) > 0 and ms_exprs_supported(reqs) == 1 then ms_exprs_supported(enss) else 0
    KCapGrant(effs) => 1
    Print(v) => ms_expr_supported(v)
    ExprS(v) => ms_expr_supported(v)
    _ => 0
fn ms_prog_supported(prog) = match prog
    Nil => 1
    Cons(h, t) => if ms_stmt_supported(h) == 1 then ms_prog_supported(t) else 0

fn ms_expr(e) = match e
    Num(n) => str(n)
    Str(s) => "\"" + cs_jesc(s) + "\""
    Var(nm) => nm
    Bin(op, a, b) => "(" + ms_expr(a) + " " + op + " " + ms_expr(b) + ")"
    If(c, t, e2) => "(if " + ms_expr(c) + " then " + ms_expr(t) + " else " + ms_expr(e2) + ")"
    LetIn(nm, v, b) => "(let " + nm + " = " + ms_expr(v) + " in " + ms_expr(b) + ")"
    VarIn(nm, v, b) => "(var " + nm + " = " + ms_expr(v) + " in " + ms_expr(b) + ")"
    Call(nm, args) => nm + "(" + ms_exprs(args) + ")"
    _ => ""
fn ms_exprs(xs) = match xs
    Nil => ""
    Cons(h, t) => if cs_isnil(t) == 1 then ms_expr(h) else ms_expr(h) + ", " + ms_exprs(t)
fn ms_typed_params(ps, tys) = match ps
    Nil => ""
    Cons(p, pr) => ms_typed_params1(p, pr, tys)
fn ms_typed_params1(p, pr, tys) = match tys
    Nil => p
    Cons(ty, tr) => let one = p + ": " + cs_tystr(ty) in if cs_isnil(pr) == 1 then one else one + ", " + ms_typed_params(pr, tr)
fn ms_pl_params(pl) = match pl
    Nil => ""
    Cons(h, t) => let one = h.pn + (if ms_ty_supported(h.pt) == 1 then if cs_tystr(h.pt) == "any" then "" else ": " + cs_tystr(h.pt) else "") in if cs_isnil(t) == 1 then one else one + ", " + ms_pl_params(t)
fn ms_contract_exprs(kind, xs) = match xs
    Nil => ""
    Cons(h, t) => " " + kind + " " + ms_expr(h) + ms_contract_exprs(kind, t)
fn ms_vcontract(nm, ps, reqs, enss) = ms_contract_exprs("requires", reqs) + ms_contract_exprs("ensures", enss)
fn ms_fn_vcontract(nm, prog) = match cs_vsiglookup(nm, cs_vcollect_vsigs(prog))
    Nil => ""
    Cons(v, r) => ms_vcontract(nm, v.ps, v.reqs, v.enss)
fn ms_fn_effs(nm, prog) = match cs_keffsig_lookup(nm, cs_kcollect_effsigs(prog))
    Nil => ""
    Cons(k, r) => " / {" + cs_joinsep(k.effs, ", ") + "}"
fn ms_fn_sig(nm, ps, prog) = match cs_osiglookup(nm, cs_ocollects(prog))
    Cons(o, r) => (if o.pubf == 1 then "pub fn " else "fn ") + nm + "(" + ms_pl_params(o.pl) + ")" + (if cs_tystr(o.rty) == "any" then "" else " -> " + cs_tystr(o.rty))
    Nil => match cs_siglookup(nm, cs_tcollects(prog))
        Cons(s, r) => "fn " + nm + "(" + ms_typed_params(s.pn, s.pt) + ")" + (if cs_tystr(s.rt) == "any" then "" else " -> " + cs_tystr(s.rt))
        Nil => "fn " + nm + "(" + cs_joinsep(ps, ", ") + ")"
fn ms_render_fn(nm, ps, body, prog) = ms_fn_sig(nm, ps, prog) + ms_fn_effs(nm, prog) + ms_fn_vcontract(nm, prog) + " = " + ms_expr(body)
fn ms_cap_grant(effs) = "@capability {" + cs_joinsep(effs, ", ") + "}"
fn ms_stmt(st, prog) = match st
    Fn(nm, ps, body) => Cons(ms_render_fn(nm, ps, body, prog), Nil)
    KCapGrant(effs) => Cons(ms_cap_grant(effs), Nil)
    Print(v) => Cons("print " + ms_expr(v), Nil)
    ExprS(v) => Cons(ms_expr(v), Nil)
    _ => Nil
fn ms_stmts(prog, whole) = match prog
    Nil => Nil
    Cons(h, t) => cs_app(ms_stmt(h, whole), ms_stmts(t, whole))
fn ms_project(prog) = cs_joinsep(ms_stmts(prog, prog), "\n") + "\n"

fn ms_name_count(nm, prog, kind) = match prog
    Nil => 0
    Cons(h, t) => ms_name_count1(nm, t, kind, h)
fn ms_name_count1(nm, t, kind, st) = match st
    Fn(n, ps, body) => (if kind == "fn" and n == nm then 1 else 0) + ms_name_count(nm, t, kind)
    Sig(n, ps, tys, rt) => (if kind == "sig" and n == nm then 1 else 0) + ms_name_count(nm, t, kind)
    OSig(n, pubf, freef, pl, rt, fromp) => (if kind == "osig" and n == nm then 1 else 0) + ms_name_count(nm, t, kind)
    KEffSig(n, effs) => (if kind == "ksig" and n == nm then 1 else 0) + ms_name_count(nm, t, kind)
    VContractSig(n, ps, reqs, enss) => (if kind == "vsig" and n == nm then 1 else 0) + ms_name_count(nm, t, kind)
    _ => ms_name_count(nm, t, kind)
fn ms_fn_names(prog) = match prog
    Nil => Nil
    Cons(h, t) => ms_fn_names1(h, t)
fn ms_fn_names1(st, rest) = match st
    Fn(nm, ps, body) => Cons(nm, ms_fn_names(rest))
    _ => ms_fn_names(rest)
fn ms_unique_names(ns) = match ns
    Nil => 1
    Cons(h, t) => if cs_omem(h, t) == 1 then 0 else ms_unique_names(t)
fn ms_one_sig_kind(nm, prog, kind) = if ms_name_count(nm, prog, kind) <= 1 then 1 else 0
fn ms_sigs_unique(ns, prog) = match ns
    Nil => 1
    Cons(h, t) => if ms_one_sig_kind(h, prog, "sig") == 1 and ms_one_sig_kind(h, prog, "osig") == 1 and ms_one_sig_kind(h, prog, "ksig") == 1 and ms_one_sig_kind(h, prog, "vsig") == 1 then ms_sigs_unique(t, prog) else 0
fn ms_duplicate_name(ns) = match ns
    Nil => ""
    Cons(h, t) => if cs_omem(h, t) == 1 then h else ms_duplicate_name(t)
fn ms_sig_attached(st, prog) = match st
    Sig(nm, ps, tys, rt) => ms_name_count(nm, prog, "fn")
    OSig(nm, pubf, freef, pl, rt, fromp) => ms_name_count(nm, prog, "fn")
    KEffSig(nm, effs) => ms_name_count(nm, prog, "fn")
    VContractSig(nm, ps, reqs, enss) => ms_name_count(nm, prog, "fn")
    _ => 1
fn ms_sigs_attached(prog, whole) = match prog
    Nil => 1
    Cons(h, t) => if ms_sig_attached(h, whole) == 1 then ms_sigs_attached(t, whole) else 0

fn ms_fn_inferred(nm, prog, ksigs, edecls) = match cs_fnlookup(nm, cs_buildft(prog))
    Nil => Nil
    Cons(f, r) => match f
        Fn(n, ps, body) => cs_kinfer_effs_e(body, ksigs, edecls)
        _ => Nil
fn ms_all_effects(ns, prog, ksigs, edecls) = match ns
    Nil => Nil
    Cons(h, t) => cs_keff_union(ms_fn_inferred(h, prog, ksigs, edecls), ms_all_effects(t, prog, ksigs, edecls))
fn ms_declared_effects(ksigs) = match ksigs
    Nil => Nil
    Cons(h, t) => cs_keff_union(h.effs, ms_declared_effects(t))
fn ms_top_effects(prog, ksigs, edecls) = match prog
    Nil => Nil
    Cons(h, t) => ms_top_effects1(h, t, ksigs, edecls)
fn ms_top_effects1(st, rest, ksigs, edecls) = match st
    Print(v) => cs_keff_union(Cons("io", Nil), cs_keff_union(cs_kinfer_effs_e(v, ksigs, edecls), ms_top_effects(rest, ksigs, edecls)))
    ExprS(v) => cs_keff_union(cs_kinfer_effs_e(v, ksigs, edecls), ms_top_effects(rest, ksigs, edecls))
    _ => ms_top_effects(rest, ksigs, edecls)
fn ms_has_top_expr(prog) = match prog
    Nil => 0
    Cons(h, t) => ms_has_top_expr1(h, t)
fn ms_has_top_expr1(st, rest) = match st
    ExprS(v) => 1
    _ => ms_has_top_expr(rest)
fn ms_capability_missing(prog, caps) = let ksigs = cs_kcollect_effsigs(prog) in let edecls = cs_kcollect_effdecls(prog) in let inferred = ms_all_effects(ms_fn_names(prog), prog, ksigs, edecls) in let all = cs_keff_union(inferred, cs_keff_union(ms_declared_effects(ksigs), cs_keff_union(cs_kcollect_caps(prog), ms_top_effects(prog, ksigs, edecls)))) in ms_caps_missing(cs_keff_diff(all, Cons("pure", Nil)), caps)

fn ms_proof_status(proofs) = if cs_isnil(proofs) == 1 then "absent" else ms_proof_status1(proofs)
fn ms_proof_status1(proofs) = match proofs
    Nil => "proven"
    Cons(h, t) => if h.status == "refuted" then "refuted" else if h.status != "proven" then if h.status == "runtime_checked" and ms_all_runtime(t) == 1 then "runtime_checked" else "mixed" else ms_proof_status1(t)
fn ms_all_runtime(proofs) = match proofs
    Nil => 1
    Cons(h, t) => if h.status == "runtime_checked" then ms_all_runtime(t) else 0
fn ms_proof_details(proofs) = match proofs
    Nil => ""
    Cons(h, t) => h.name + "=" + h.status + (if cs_isnil(t) == 1 then "" else "," + ms_proof_details(t))

fn ms_state_canon(st) = ms_field("lume-semantic-intent-state/0.1") + ms_field(st.goal) + ms_field(st.target) + ms_field(ms_caps_text(st.caps)) + ms_field(st.resources.text) + ms_field(st.acceptance) + ms_field(cs_prog_sexpr(st.ast)) + ms_field(st.source)
fn ms_state_hash(st) = lc_sha256(ms_state_canon(st))
fn ms_node_canon(parent_id, op, st) = ms_field("lume-semantic-intent-node/0.1") + ms_field(parent_id) + ms_field(op) + ms_field(ms_state_hash(st))
fn ms_node_id(parent_id, op, st) = lc_sha256(ms_node_canon(parent_id, op, st))

fn ms_state_json(st) = "{\"goal\":\"" + cs_jesc(st.goal) + "\",\"target\":\"" + cs_jesc(st.target) + "\",\"capabilities\":[" + cs_strlist_json(st.caps) + "],\"resources\":{\"max_source_bytes\":" + str(st.resources.max_source) + ",\"max_transactions\":" + str(st.resources.max_tx) + "},\"acceptance\":\"" + cs_jesc(st.acceptance) + "\",\"ast\":\"" + cs_jesc(cs_prog_sexpr(st.ast)) + "\",\"source\":\"" + cs_jesc(st.source) + "\",\"state_sha256\":\"" + cs_jesc(ms_state_hash(st)) + "\"}"
fn ms_validation_json(st) = "{\"compiler_ok\":" + ms_bool(st.comp.ok) + ",\"target_supported\":true,\"proof_status\":\"" + ms_proof_status(st.comp.proofs) + "\",\"result\":\"" + cs_jesc(st.comp.result) + "\",\"proofs\":[" + cs_proofs_json(st.comp.proofs) + "]}"
fn ms_node_json(n) = "{\"index\":" + str(n.index) + ",\"id\":\"" + cs_jesc(n.id) + "\",\"parent_index\":" + str(n.parent_index) + ",\"parent_id\":" + (if n.parent_id == "" then "null" else "\"" + cs_jesc(n.parent_id) + "\"") + ",\"op\":\"" + cs_jesc(n.op) + "\",\"state_sha256\":\"" + cs_jesc(ms_state_hash(n.st)) + "\",\"affected_symbols\":" + ms_strs_json(n.affected) + ",\"invalidated_symbols\":" + ms_strs_json(n.invalidated) + "}"
fn ms_nodes_json(ns) = match ns
    Nil => ""
    Cons(h, t) => if cs_isnil(t) == 1 then ms_node_json(h) else ms_node_json(h) + "," + ms_nodes_json(t)
fn ms_branch_ids(n, ns) = if n.parent_index < 0 then Cons(n.id, Nil) else cs_app(ms_branch_ids(ms_node_at(n.parent_index, ns), ns), Cons(n.id, Nil))
fn ms_node_at(idx, ns) = match ns
    Nil => ms_root_sentinel()
    Cons(h, t) => if h.index == idx then h else ms_node_at(idx, t)
fn ms_root_sentinel() = {index: 0 - 1, id: "", parent_index: 0 - 1, parent_id: "", op: "invalid", st: Nil, affected: Nil, invalidated: Nil}
fn ms_response(req, current, nodes) = "{\"ok\":true,\"protocol\":\"lume-semantic-intent/0.1\",\"mode\":\"" + cs_jesc(req.mode) + "\",\"session\":\"" + cs_jesc((cs_asthead(nodes)).id) + "\",\"current\":\"" + cs_jesc(current.id) + "\",\"state\":" + ms_state_json(current.st) + ",\"validation\":" + ms_validation_json(current.st) + ",\"lineage\":[" + ms_nodes_json(nodes) + "],\"active_branch\":[" + cs_strlist_json(ms_branch_ids(current, nodes)) + "],\"diagnostics\":[" + cs_diags_json(current.st.comp.diagnostics) + "]}"

fn ms_first_diag(ds) = match ds
    Nil => ms_diag("M2001", "compiler", "compiler rejected the canonical AST without a diagnostic", "reject the request")
    Cons(h, t) => h
fn ms_validate(req, ast0, target_name) = if ms_prog_supported(ast0) == 0 then {ok: 0, diagnostic: ms_diag("M1004", "ast", "source uses a construct outside semantic protocol fragment 0.1", "use typed or untyped functions, capabilities, requires/ensures, calls, arithmetic, conditionals, let/var, and print")} else let names = ms_fn_names(ast0) in if ms_unique_names(names) == 0 or ms_sigs_unique(names, ast0) == 0 or ms_sigs_attached(ast0, ast0) == 0 then {ok: 0, diagnostic: ms_diag("M2002", "symbols", "duplicate, orphaned, or ambiguous function/signature name '" + ms_duplicate_name(names) + "'", "declare each function and each associated signature exactly once")} else let missing = ms_capability_missing(ast0, req.caps) in if cs_isnil(missing) == 0 then {ok: 0, diagnostic: ms_diag("M2004", "capability", "program requires capabilities outside the negotiated set: {" + cs_joinsep(missing, ", ") + "}", "renegotiate capabilities explicitly or remove the effects")} else if ms_has_top_expr(ast0) == 1 then {ok: 0, diagnostic: ms_diag("M1004", "target", "top-level expression statements are outside the semantic target fragment", "use a function or print so the selected backend cannot silently drop the expression")} else let source = ms_project(ast0) in let comp = caas_compile(source) in if comp.ok == 0 then {ok: 0, diagnostic: ms_first_diag(comp.diagnostics)} else if cs_prog_sexpr(comp.ast) != cs_prog_sexpr(ast0) or ms_project(comp.ast) != source then {ok: 0, diagnostic: ms_diag("M2001", "ast", "canonical AST/source projection did not reach an exact round-trip fixed point", "reject the source instead of continuing with a changed program")} else let tp = ms_target(target_name) in if tp.ok == 0 then {ok: 0, diagnostic: ms_diag("M2003", "target", "unsupported semantic target '" + target_name + "'", "use x86_64-linux-elf or lumb in protocol 0.1")} else let proof_status = ms_proof_status(comp.proofs) in if req.acceptance == "prove" and proof_status != "proven" then {ok: 0, diagnostic: ms_diag("M3001", "proof", "acceptance requires every obligation to be proven; actual status is " + proof_status + " [" + ms_proof_details(comp.proofs) + "]", "use acceptance compile or strengthen the QF_LIA obligations")} else {ok: 1, st: {goal: req.goal, target: tp.triple, caps: req.caps, resources: req.resources, acceptance: req.acceptance, ast: ast0, source: source, comp: comp}}

fn ms_initial(req) = let raw = caas_compile(req.source) in ms_validate(req, raw.ast, req.target)

fn ms_contract_wrapper_valid(p) = if cs_len(p) == 2 and cs_len(ms_fn_names(p)) == 1 and ms_name_count("__mesh_contract", p, "fn") == 1 and ms_name_count("__mesh_contract", p, "vsig") == 1 then 1 else 0
fn ms_contract_expr(text, kind) = let wrapped = "fn __mesh_contract() ensures " + text + " = 0\n" in let p = cs_parse(wrapped) in if ms_prog_supported(p) == 0 then {ok: 0, diagnostic: ms_diag("M1004", "contract", "contract expression is outside the semantic protocol fragment", "use a parsed boolean arithmetic expression")} else if ms_contract_wrapper_valid(p) == 0 then {ok: 0, diagnostic: ms_diag("M1002", "contract", "ambiguous contract expression payload", "provide exactly one expression without declaration tokens or trailing content")} else let vs = cs_vcollect_vsigs(p) in match vs
    Nil => {ok: 0, diagnostic: ms_diag("M1002", "contract", "contract expression did not parse", "provide one complete expression")}
    Cons(v, rest) => if cs_len(v.enss) != 1 or cs_isnil(v.reqs) == 0 then {ok: 0, diagnostic: ms_diag("M1002", "contract", "ambiguous contract expression payload", "provide exactly one expression without declaration tokens")} else let e = cs_asthead(v.enss) in let check = ms_validate_expr(e, text) in if check == 0 then {ok: 0, diagnostic: ms_diag("M1002", "contract", "contract expression failed canonical parse validation", "provide one complete expression without trailing tokens")} else {ok: 1, expr: e}
fn ms_validate_expr(e, text) = let projected = ms_expr(e) in let p = cs_parse("fn __mesh_contract() ensures " + projected + " = 0\n") in if ms_contract_wrapper_valid(p) == 0 then 0 else let vs = cs_vcollect_vsigs(p) in match vs
    Nil => 0
    Cons(v, rest) => if cs_len(v.enss) == 1 then if cs_expr_sexpr(cs_asthead(v.enss)) == cs_expr_sexpr(e) then 1 else 0 else 0

fn ms_contract_count(kind, v) = if kind == "requires" then cs_len(v.reqs) else cs_len(v.enss)
fn ms_contract_has(e, xs) = match xs
    Nil => 0
    Cons(h, t) => if cs_expr_sexpr(h) == cs_expr_sexpr(e) then 1 else ms_contract_has(e, t)
fn ms_contract_append(e, xs) = cs_app(xs, Cons(e, Nil))
fn ms_contract_replace(e, xs) = match xs
    Nil => Nil
    Cons(h, t) => Cons(e, t)
fn ms_update_vsig(v, kind, e, replace) = if kind == "requires" then VContractSig(v.nm, v.ps, if replace == 1 then ms_contract_replace(e, v.reqs) else ms_contract_append(e, v.reqs), v.enss) else VContractSig(v.nm, v.ps, v.reqs, if replace == 1 then ms_contract_replace(e, v.enss) else ms_contract_append(e, v.enss))
fn ms_edit_contract(prog, nm, kind, e, replace) = match prog
    Nil => Nil
    Cons(h, t) => Cons(ms_edit_contract1(h, nm, kind, e, replace), ms_edit_contract(t, nm, kind, e, replace))
fn ms_edit_contract1(st, nm, kind, e, replace) = match st
    VContractSig(n, ps, reqs, enss) => if n == nm then ms_update_vsig(st, kind, e, replace) else st
    _ => st

fn ms_contract_op(req, current, op) = if ms_name_count(op.symbol, current.st.ast, "fn") != 1 then {ok: 0, diagnostic: ms_diag("M3002", "transaction", "contract target is missing or ambiguous: '" + op.symbol + "'", "name exactly one parsed function")} else let parsed = ms_contract_expr(op.expr, op.ckind) in if parsed.ok == 0 then parsed else let mv = cs_vsiglookup(op.symbol, cs_vcollect_vsigs(current.st.ast)) in match mv
    Nil => if op.kind == "replace_contract" then {ok: 0, diagnostic: ms_diag("M3003", "transaction", "cannot replace a missing " + op.ckind + " contract on '" + op.symbol + "'", "use add_contract first")} else ms_contract_add(req, current, op, parsed.expr, Nil)
    Cons(v, rest) => let count_kind = ms_contract_count(op.ckind, v) in if op.kind == "replace_contract" and count_kind != 1 then {ok: 0, diagnostic: ms_diag("M3003", "transaction", "replace_contract requires exactly one existing " + op.ckind + " contract on '" + op.symbol + "'; found " + str(count_kind), "disambiguate the contract state before replacement")} else if op.kind == "add_contract" and ms_contract_has(parsed.expr, if op.ckind == "requires" then v.reqs else v.enss) == 1 then {ok: 0, diagnostic: ms_diag("M3003", "transaction", "duplicate contract expression on '" + op.symbol + "'", "do not add the same parsed obligation twice")} else ms_contract_add(req, current, op, parsed.expr, Cons(v, Nil))
fn ms_fn_params(f) = match f
    Fn(nm, ps, body) => ps
    _ => Nil
fn ms_contract_add(req, current, op, e, mv) = let ps = ms_fn_params(cs_asthead(cs_fnlookup(op.symbol, cs_buildft(current.st.ast)))) in let ast1 = if cs_isnil(mv) == 1 then Cons(VContractSig(op.symbol, ps, if op.ckind == "requires" then Cons(e, Nil) else Nil, if op.ckind == "ensures" then Cons(e, Nil) else Nil), current.st.ast) else ms_edit_contract(current.st.ast, op.symbol, op.ckind, e, if op.kind == "replace_contract" then 1 else 0) in {ok: 1, ast: ast1, expr: e}

fn ms_fn_fingerprint(nm, prog) = match cs_fnlookup(nm, cs_buildft(prog))
    Nil => ""
    Cons(f, rest) => match f
        Fn(n, ps, body) => ms_render_fn(n, ps, body, prog)
        _ => ""
fn ms_name_union(a, b) = match a
    Nil => b
    Cons(h, t) => if cs_omem(h, b) == 1 then ms_name_union(t, b) else Cons(h, ms_name_union(t, b))
fn ms_changed_names(ns, before, after) = match ns
    Nil => Nil
    Cons(h, t) => if ms_fn_fingerprint(h, before) != ms_fn_fingerprint(h, after) then Cons(h, ms_changed_names(t, before, after)) else ms_changed_names(t, before, after)
fn ms_changed(before, after) = ms_changed_names(ms_name_union(ms_fn_names(before), ms_fn_names(after)), before, after)
fn ms_callers_of(changed, prog) = match prog
    Nil => Nil
    Cons(h, t) => ms_callers_of1(h, t, changed, prog)
fn ms_callers_of1(st, rest, changed, prog) = match st
    Fn(nm, ps, body) => if ms_calls_any(cs_collect_callees_e(body, Nil), changed) == 1 then Cons(nm, ms_callers_of(rest, changed, prog)) else ms_callers_of(rest, changed, prog)
    _ => ms_callers_of(rest, changed, prog)
fn ms_calls_any(callees, changed) = match callees
    Nil => 0
    Cons(h, t) => if cs_omem(h, changed) == 1 then 1 else ms_calls_any(t, changed)
fn ms_closure_step(names, prog, acc) = match names
    Nil => acc
    Cons(h, t) => let callers = ms_callers_of(Cons(h, Nil), prog) in ms_closure_step(t, prog, ms_name_union(acc, callers))
fn ms_closure(names, prog) = let next = ms_closure_step(names, prog, names) in if cs_len(next) == cs_len(names) then names else ms_closure(next, prog)
fn ms_impact(before, after, changed) = if before.target != after.target then ms_name_union(ms_fn_names(before.ast), ms_fn_names(after.ast)) else ms_closure(changed, before.ast)

fn ms_mk_node(nodes, current, op, next_st, affected) = let idx = cs_len(nodes) in let id = ms_node_id(current.id, op, next_st) in let invalidated = ms_impact(current.st, next_st, affected) in let node = {index: idx, id: id, parent_index: current.index, parent_id: current.id, op: op, st: next_st, affected: affected, invalidated: invalidated} in {ok: 1, current: node, nodes: cs_app(nodes, Cons(node, Nil))}
fn ms_commit(req, nodes, current, op_text, ast1, target1, affected) = let next_req = {mode: req.mode, goal: req.goal, target: target1, caps: req.caps, resources: req.resources, acceptance: req.acceptance, source: req.source, ops: req.ops} in let validated = ms_validate(next_req, ast1, target1) in if validated.ok == 0 then validated else ms_mk_node(nodes, current, op_text, validated.st, affected)

fn ms_apply_regular(req, nodes, current, op) = if op.kind == "set_target" then let affected = ms_name_union(ms_fn_names(current.st.ast), Nil) in ms_commit(req, nodes, current, "set_target:" + op.target, current.st.ast, op.target, affected) else let edited = ms_contract_op(req, current, op) in if edited.ok == 0 then edited else ms_commit(req, nodes, current, op.kind + ":" + op.symbol + ":" + op.ckind + ":" + ms_expr(edited.expr), edited.ast, current.st.target, Cons(op.symbol, Nil))

fn ms_find_node_op(nodes, idx) = let n = ms_node_at(idx, nodes) in if n.index != idx then {ok: 0, diagnostic: ms_diag("M3004", "lineage", "lineage index " + str(idx) + " does not exist", "reference an index present in the current response")} else {ok: 1, node: n}
fn ms_same_state(a, b) = ms_state_hash(a) == ms_state_hash(b)
fn ms_rollback(req, nodes, current, op) = let found = ms_find_node_op(nodes, op.to) in if found.ok == 0 then found else let target_st = found.node.st in let changed = ms_changed(current.st.ast, target_st.ast) in let affected = if current.st.target != target_st.target then ms_name_union(ms_fn_names(current.st.ast), ms_fn_names(target_st.ast)) else changed in ms_mk_node(nodes, current, "rollback:" + found.node.id, target_st, affected)

fn ms_replay_range(req, nodes, current, originals, idx, to) = if idx > to then {ok: 1, nodes: nodes, current: current} else let original = ms_node_at(idx, originals) in if original.index != idx then {ok: 0, diagnostic: ms_diag("M3004", "lineage", "replay lineage index " + str(idx) + " does not exist", "choose a range from the supplied history")} else if original.parent_index < 0 then {ok: 0, diagnostic: ms_diag("M3004", "lineage", "cannot replay the negotiation root", "replay operation indexes greater than the from snapshot")} else if cs_startswith(original.op, "rollback:") == 1 or cs_startswith(original.op, "replay:") == 1 then {ok: 0, diagnostic: ms_diag("M3004", "lineage", "nested rollback/replay records are not replayable operations", "replay only add/replace/set_target records")} else let op = ms_original_op(original.op) in if op.ok == 0 then op else let r = ms_apply_regular(req, nodes, current, op) in if r.ok == 0 then r else let replayed = ms_relabel_last(r.nodes, r.current, "replay:" + original.id + ":" + original.op) in ms_replay_range(req, replayed.nodes, replayed.current, originals, idx + 1, to)
fn ms_relabel_last(nodes, current, op_text) = let id = ms_node_id(current.parent_id, op_text, current.st) in let n2 = {index: current.index, id: id, parent_index: current.parent_index, parent_id: current.parent_id, op: op_text, st: current.st, affected: current.affected, invalidated: current.invalidated} in {nodes: ms_replace_node(nodes, n2), current: n2}
fn ms_replace_node(nodes, replacement) = match nodes
    Nil => Nil
    Cons(h, t) => if h.index == replacement.index then Cons(replacement, t) else Cons(h, ms_replace_node(t, replacement))
fn ms_original_op(text) = let kind = ms_before_colon(text) in if kind == "set_target" then {ok: 1, op: {kind: kind, symbol: "", ckind: "", expr: "", from_idx: 0, to: 0, target: ms_after_colon(text)}} else if kind == "add_contract" or kind == "replace_contract" then let p1 = ms_after_colon(text) in let symbol = ms_before_colon(p1) in let p2 = ms_after_colon(p1) in let ckind = ms_before_colon(p2) in let expr = ms_after_colon(p2) in {ok: 1, op: {kind: kind, symbol: symbol, ckind: ckind, expr: expr, from_idx: 0, to: 0, target: ""}} else {ok: 0, diagnostic: ms_diag("M3004", "lineage", "unsupported replay operation '" + kind + "'", "replay only semantic contract and target operations")}
fn ms_before_colon(s) = let p = lc_find_ch(s, 0, count(s), ":") in slice(s, 0, p)
fn ms_after_colon(s) = let p = lc_find_ch(s, 0, count(s), ":") in if p >= count(s) then "" else slice(s, p + 1, count(s))

fn ms_replay(req, nodes, current, op) = if op.from_idx < 0 or op.to <= op.from_idx or op.to >= cs_len(nodes) then {ok: 0, diagnostic: ms_diag("M3004", "lineage", "replay range must satisfy 0 <= from < to < history length", "select a snapshot and later operation in the visible history")} else let found = ms_find_node_op(nodes, op.from_idx) in if found.ok == 0 then found else if ms_same_state(current.st, found.node.st) == 0 then {ok: 0, diagnostic: ms_diag("M3004", "lineage", "replay source snapshot does not match current canonical AST/target/contract state", "rollback to the source snapshot before replaying its branch")} else ms_replay_range(req, nodes, current, nodes, op.from_idx + 1, op.to)

fn ms_transact(req, root, nodes, ops) = match ops
    Nil => {ok: 1, nodes: nodes, current: root}
    Cons(h, t) => let r = if h.kind == "rollback" then ms_rollback(req, nodes, root, h) else if h.kind == "replay" then ms_replay(req, nodes, root, h) else ms_apply_regular(req, nodes, root, h) in if r.ok == 0 then r else ms_transact(req, r.current, r.nodes, t)

fn mesh_entry(input) = let req = ms_parse(input) in if req.ok == 0 then ms_error1(req.mode, req.diagnostic) else let initial = ms_initial(req) in if initial.ok == 0 then ms_error1(req.mode, initial.diagnostic) else let root_id = ms_node_id("", "negotiate", initial.st) in let root = {index: 0, id: root_id, parent_index: 0 - 1, parent_id: "", op: "negotiate", st: initial.st, affected: Nil, invalidated: Nil} in let nodes = Cons(root, Nil) in if req.mode == "negotiate" then ms_response(req, root, nodes) else let result = ms_transact(req, root, nodes, req.ops) in if result.ok == 1 then ms_response(req, result.current, result.nodes) else ms_error1(req.mode, result.diagnostic)

print mesh_entry(readall())
