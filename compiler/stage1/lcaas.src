## lcaas.src -- Lume Compiler-as-a-Service (Track E, brick E1; Principles P1, P28, P30, P31).
## Exposes `lumec` as both an in-process callable Lume-Core library (`use lcaas`) and a
## native JSON query agent (`lume agent`).
##
## Given any Lume source string `src`, `caas_compile(src)` runs lexing, parsing, symbol
## extraction, non-aborting multi-diagnostic F1/F2/C3/C1/M1/M2 checking with AI-first
## fix-it suggestions, C3 generic type-argument erasure, C1/C2/M1/M2 comptime & hygienic
## quasiquote expansion, x86-64 native assembly generation, and in-memory execution:
##   source in -> {ok, diagnostics, symbols, ast, ast_sexpr, expanded, expanded_sexpr, asm, result} out
## without ever aborting the host process on invalid user code.

## --- internal character, string & list helpers (prefixed `cs_` to avoid collisions on `use lcaas`) ---
fn cs_isws(c) = c == " " or c == "\t" or c == "\n" or c == "\r"
fn cs_isdigit(c) = c >= "0" and c <= "9"
fn cs_isalpha(c) = c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c == "_"
fn cs_isalnum(c) = cs_isdigit(c) or cs_isalpha(c)
fn cs_isupper(c) = c >= "A" and c <= "Z"

fn cs_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, cs_app(t, ys))
fn cs_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + cs_len(t)
fn cs_isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn cs_revacc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => cs_revacc(t, Cons(h, acc))
fn cs_rev(xs) = cs_revacc(xs, Nil)
fn cs_pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => cs_pairs2(a, t)
fn cs_pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, cs_pairs(r))
fn cs_joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if cs_isnil(t) == 1 then a else cs_joinall(cs_pairs(xs))
fn cs_addsep(xs, sep) = match xs
    Nil        => Nil
    Cons(h, t) => if cs_isnil(t) == 1 then Cons(h, Nil) else Cons(h + sep, cs_addsep(t, sep))
fn cs_joinsep(xs, sep) = cs_joinall(cs_addsep(xs, sep))
fn cs_rtrimnl(s, e) = if e <= 0 then 0 else if at(s, e - 1) == "\n" or at(s, e - 1) == "\r" or at(s, e - 1) == " " then cs_rtrimnl(s, e - 1) else e
fn cs_chomp(s) = slice(s, 0, cs_rtrimnl(s, count(s)))
fn cs_startswith(s, p) = if count(s) < count(p) then 0 else slice(s, 0, count(p)) == p

fn cs_jesc_clean(s, i, n) = if i >= n then 1 else let c = at(s, i) in if c == "\"" or c == "\\" or c == "\n" or c == "\r" or c == "\t" then 0 else cs_jesc_clean(s, i + 1, n)
fn cs_jesc_ch(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\r" then "\\r" else if c == "\t" then "\\t" else c
fn cs_jesc_i(s, i, n) = if i >= n then "" else cs_jesc_ch(at(s, i)) + cs_jesc_i(s, i + 1, n)
fn cs_jesc(s) = if cs_jesc_clean(s, 0, count(s)) == 1 then s else cs_jesc_i(s, 0, count(s))

## --- lexer ---
fn cs_numend(s, i, n) = if i >= n then i else if cs_isdigit(at(s, i)) then cs_numend(s, i + 1, n) else i
fn cs_idend(s, i, n) = if i >= n then i else if cs_isalnum(at(s, i)) then cs_idend(s, i + 1, n) else i
fn cs_lineend(s, i, n) = if i >= n then i else if at(s, i) == "\n" then i + 1 else cs_lineend(s, i + 1, n)
fn cs_escchar(c) = if c == "n" then "\n" else if c == "t" then "\t" else if c == "\"" then "\"" else if c == "\\" then "\\" else c
fn cs_strplain(s, i, n) = if i >= n then i else let c = at(s, i) in if c == "\"" or c == "\\" then i else cs_strplain(s, i + 1, n)
fn cs_strend(s, i, n, acc) = let j = cs_strplain(s, i, n) in let acc2 = if j > i then acc + slice(s, i, j) else acc in if j >= n then {txt: acc2, next: n} else if at(s, j) == "\"" then {txt: acc2, next: j + 1} else cs_strend(s, j + 2, n, acc2 + cs_escchar(at(s, j + 1)))
fn cs_istwo(s, i, n) = if i + 1 >= n then 0 else cs_istwopair(slice(s, i, i + 2))
fn cs_istwopair(p) = p == "==" or p == "!=" or p == "<=" or p == ">=" or p == "=>" or p == ".."
fn cs_lex(s, i) = if i >= count(s) then Nil else cs_lex1(s, i, count(s), at(s, i))
fn cs_lex1(s, i, n, c) = if cs_isws(c) then cs_lex(s, i + 1) else if c == "#" then cs_lex(s, cs_lineend(s, i + 1, n)) else if cs_isdigit(c) then cs_lexnum(s, i, cs_numend(s, i, n)) else if cs_isalpha(c) then cs_lexid(s, i, cs_idend(s, i, n)) else if c == "\"" then cs_lexstr(s, cs_strend(s, i + 1, n, "")) else if cs_istwo(s, i, n) == 1 then Cons({kind: "SY", text: slice(s, i, i + 2)}, cs_lex(s, i + 2)) else Cons({kind: "SY", text: c}, cs_lex(s, i + 1))
fn cs_lexnum(s, i, j) = Cons({kind: "NM", text: slice(s, i, j)}, cs_lex(s, j))
fn cs_lexid(s, i, j) = Cons({kind: "ID", text: slice(s, i, j)}, cs_lex(s, j))
fn cs_lexstr(s, r) = Cons({kind: "ST", text: r.txt}, cs_lex(s, r.next))

## --- parser ---
fn cs_hd(ts) = match ts
    Nil        => {kind: "EOF", text: ""}
    Cons(h, t) => h
fn cs_hdkind(ts) = (cs_hd(ts)).kind
fn cs_hdtext(ts) = (cs_hd(ts)).text
fn cs_drop1(ts) = match ts
    Nil        => Nil
    Cons(h, t) => t
fn cs_dropkw(ts, kw) = if cs_hdtext(ts) == kw then cs_drop1(ts) else ts
fn cs_skiprp(ts) = cs_dropkw(ts, ")")
fn cs_skiprk(ts) = cs_dropkw(ts, "]")

fn cs_prim(ts) = cs_postfix(cs_atom(ts))
fn cs_atom(ts) = if cs_hdkind(ts) == "NM" then {node: Num(toint(cs_hdtext(ts))), rest: cs_drop1(ts)} else if cs_hdkind(ts) == "ST" then {node: Str(cs_hdtext(ts)), rest: cs_drop1(ts)} else if cs_hdtext(ts) == "(" then cs_paren(cs_drop1(ts)) else if cs_hdtext(ts) == "[" then (let r = cs_expr(cs_drop1(ts)) in {node: Call("_tylist_", Cons(r.node, Nil)), rest: cs_skiprk(r.rest)}) else if cs_hdtext(ts) == "{" then cs_rec(cs_drop1(ts)) else if cs_hdtext(ts) == "if" then cs_if(cs_drop1(ts)) else if cs_hdtext(ts) == "let" then cs_let(cs_drop1(ts)) else if cs_hdtext(ts) == "var" then cs_var(cs_drop1(ts)) else if cs_hdtext(ts) == "own" then cs_owne(cs_drop1(ts)) else if cs_hdtext(ts) == "mut" then cs_mute(cs_drop1(ts)) else if cs_hdtext(ts) == "defer" then cs_defer(cs_drop1(ts)) else if cs_hdtext(ts) == "errdefer" then cs_errdefer(cs_drop1(ts)) else if cs_hdtext(ts) == "with" then cs_with(cs_drop1(ts)) else if cs_hdtext(ts) == "scope" then cs_scope(cs_drop1(ts)) else if cs_hdtext(ts) == "spawn" then cs_spawn(cs_drop1(ts)) else if cs_hdtext(ts) == "shard" then cs_shard(cs_drop1(ts)) else if cs_hdtext(ts) == "match" then cs_match(cs_drop1(ts)) else if cs_hdtext(ts) == "comptime" then cs_ct(cs_drop1(ts)) else if cs_hdtext(ts) == "quote" then cs_quote(cs_drop1(ts)) else if cs_hdtext(ts) == "splice" then cs_splice(cs_drop1(ts)) else if cs_hdkind(ts) == "ID" then cs_ident(cs_hdtext(ts), cs_drop1(ts)) else {node: Num(0), rest: cs_drop1(ts)}
fn cs_paren(ts) = let r = cs_expr(ts) in {node: r.node, rest: cs_skiprp(r.rest)}
fn cs_ident(nm, ts) = if cs_hdtext(ts) == "(" then cs_call(nm, cs_arglist(cs_drop1(ts))) else if cs_hdtext(ts) == "{" then cs_rect(nm, cs_rec(cs_drop1(ts))) else if cs_hdtext(ts) == "[" then (let ta = cs_expr(cs_drop1(ts)) in let t2 = cs_skiprk(ta.rest) in if cs_hdtext(t2) == "{" then cs_rect(nm, cs_rec(cs_drop1(t2))) else {node: Call("_tyapp_" + nm, Cons(ta.node, Nil)), rest: t2}) else {node: Var(nm), rest: ts}
fn cs_call(nm, a) = {node: Call(nm, a.items), rest: a.rest}
fn cs_rect(nm, r) = cs_rect2(nm, r.node, r.rest)
fn cs_rect2(nm, nd, rest) = match nd
    Rec(items) => {node: RecT(nm, items), rest: rest}
    _          => {node: nd, rest: rest}
fn cs_arglist(ts) = if cs_hdtext(ts) == ")" then {items: Nil, rest: cs_drop1(ts)} else cs_argmore(cs_expr(ts))
fn cs_argmore(r) = if cs_hdtext(r.rest) == "," then cs_argcons(r.node, cs_arglist(cs_drop1(r.rest))) else {items: Cons(r.node, Nil), rest: cs_skiprp(r.rest)}
fn cs_argcons(h, rr) = {items: Cons(h, rr.items), rest: rr.rest}
fn cs_rec(ts) = if cs_hdtext(ts) == "}" then {node: Rec(Nil), rest: cs_drop1(ts)} else cs_recfields(ts)
fn cs_recfields(ts) = let k = cs_hdtext(ts) in let r = cs_expr(cs_dropkw(cs_drop1(ts), ":")) in if cs_hdtext(r.rest) == "," then cs_reccons(k, r.node, cs_recfields(cs_drop1(r.rest))) else {node: Rec(Cons({key: k, val: r.node}, Nil)), rest: cs_dropkw(r.rest, "}")}
fn cs_reccons(k, v, rr) = cs_reccons2(k, v, rr.node, rr.rest)
fn cs_reccons2(k, v, nd, rest) = match nd
    Rec(items) => {node: Rec(Cons({key: k, val: v}, items)), rest: rest}
    _          => {node: nd, rest: rest}
fn cs_postdotcall(nd, mnm, a) = match nd
    Var(enm) => if cs_isupper(at(enm, 0)) then {node: Call(mnm, a.items), rest: a.rest} else {node: Call(mnm, Cons(nd, a.items)), rest: a.rest}
    _        => {node: Call(mnm, Cons(nd, a.items)), rest: a.rest}
fn cs_postfix(r) = if cs_hdtext(r.rest) == "." then (let t1 = cs_drop1(r.rest) in let mnm = cs_hdtext(t1) in let t2 = cs_drop1(t1) in if cs_hdtext(t2) == "(" then cs_postfix(cs_postdotcall(r.node, mnm, cs_arglist(cs_drop1(t2)))) else if mnm == "await" then cs_postfix({node: Call("await", Cons(r.node, Nil)), rest: t2}) else cs_postfix({node: Field(r.node, mnm), rest: t2})) else if cs_hdtext(r.rest) == "(" then (let a = cs_arglist(cs_drop1(r.rest)) in cs_postfix(cs_postcall(r.node, a))) else r
fn cs_postcall(nd, a) = match nd
    Var(nm) => {node: Call(nm, a.items), rest: a.rest}
    _       => {node: Call("_call", Cons(nd, a.items)), rest: a.rest}

fn cs_ct(ts) = let r = cs_prim(ts) in {node: CT(r.node), rest: r.rest}
fn cs_quote(ts) = let r = cs_prim(ts) in {node: Quote(r.node), rest: r.rest}
fn cs_splice(ts) = let r = cs_prim(ts) in {node: Splice(r.node), rest: r.rest}

fn cs_mul(ts) = cs_mulloop(cs_prim(ts))
fn cs_mulloop(l) = let op = cs_hdtext(l.rest) in if op == "*" or op == "/" or op == "%" then cs_mulloop(cs_mkbin(op, l.node, cs_prim(cs_drop1(l.rest)))) else l
fn cs_add(ts) = cs_addloop(cs_mul(ts))
fn cs_addloop(l) = let op = cs_hdtext(l.rest) in if op == "+" or op == "-" then cs_addloop(cs_mkbin(op, l.node, cs_mul(cs_drop1(l.rest)))) else l
fn cs_cmp(ts) = cs_cmploop(cs_add(ts))
fn cs_cmploop(l) = let op = cs_hdtext(l.rest) in if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" then cs_cmploop(cs_mkbin(op, l.node, cs_add(cs_drop1(l.rest)))) else l
fn cs_and(ts) = cs_andloop(cs_cmp(ts))
fn cs_andloop(l) = if cs_hdtext(l.rest) == "and" then cs_andloop(cs_mkbin("and", l.node, cs_cmp(cs_drop1(l.rest)))) else l
fn cs_or(ts) = cs_orloop(cs_and(ts))
fn cs_orloop(l) = if cs_hdtext(l.rest) == "or" then cs_orloop(cs_mkbin("or", l.node, cs_and(cs_drop1(l.rest)))) else l
fn cs_mkbin(op, a, r) = {node: Bin(op, a, r.node), rest: r.rest}
fn cs_expr(ts) = cs_or(ts)

fn cs_if(ts) = let c = cs_expr(ts) in let t = cs_expr(cs_dropkw(c.rest, "then")) in let e2 = cs_expr(cs_dropkw(t.rest, "else")) in {node: If(c.node, t.node, e2.node), rest: e2.rest}
fn cs_dropin(ts) = if cs_hdtext(ts) == "in" or cs_hdtext(ts) == ";" then cs_drop1(ts) else ts
fn cs_let(ts) = let nm = cs_hdtext(ts) in let t1 = cs_drop1(ts) in let t2 = if cs_hdtext(t1) == ":" then (cs_ptype1(cs_drop1(t1))).rest else t1 in let v = cs_expr(cs_dropkw(t2, "=")) in let b = cs_expr(cs_dropin(v.rest)) in {node: LetIn(nm, v.node, b.node), rest: b.rest}
fn cs_var(ts) = let nm = cs_hdtext(ts) in let t1 = cs_drop1(ts) in let t2 = if cs_hdtext(t1) == ":" then (cs_ptype1(cs_drop1(t1))).rest else t1 in let v = cs_expr(cs_dropkw(t2, "=")) in let b = cs_expr(cs_dropin(v.rest)) in {node: VarIn(nm, v.node, b.node), rest: b.rest}
fn cs_owne(ts) = let r = cs_prim(ts) in {node: OwnE(r.node), rest: r.rest}
fn cs_mute(ts) = let r = cs_prim(ts) in {node: MutE(r.node), rest: r.rest}
fn cs_defer(ts) = let c = cs_expr(ts) in let b = cs_expr(cs_dropin(c.rest)) in {node: DeferE(c.node, b.node), rest: b.rest}
fn cs_errdefer(ts) = let c = cs_expr(ts) in let b = cs_expr(cs_dropin(c.rest)) in {node: ErrDeferE(c.node, b.node), rest: b.rest}
fn cs_parsehop(ts) = let opnm = cs_hdtext(cs_drop1(ts)) in let ps = cs_pparams(cs_dropkw(cs_drop1(cs_drop1(ts)), "(")) in let rt = cs_pret(ps.rest) in let b = cs_expr(cs_dropkw(rt.rest, "=")) in {op: {op: opnm, ps: ps.items, body: b.node}, rest: cs_dropkw(b.rest, ";")}
fn cs_parsehops(ts) = if cs_hdtext(ts) == "fn" then let r = cs_parsehop(ts) in let rr = cs_parsehops(r.rest) in {items: Cons(r.op, rr.items), rest: rr.rest} else {items: Nil, rest: ts}
fn cs_withhandler(t) = let enm = cs_hdtext(t) in let hs = cs_parsehops(cs_dropkw(cs_drop1(t), "{")) in let b = cs_expr(cs_dropin(cs_dropkw(hs.rest, "}"))) in {node: WithHandlerE(enm, hs.items, b.node), rest: b.rest}
fn cs_with(ts) = if cs_hdtext(ts) == "alloc" then let a = cs_expr(cs_dropkw(cs_drop1(ts), "=")) in let b = cs_expr(cs_dropin(a.rest)) in {node: WithAllocE(a.node, b.node), rest: b.rest} else if cs_hdtext(ts) == "handler" then cs_withhandler(cs_drop1(ts)) else cs_expr(ts)
fn cs_scope(t) = if cs_hdtext(cs_drop1(t)) == "in" or cs_hdtext(cs_drop1(t)) == ";" or cs_hdtext(cs_drop1(t)) == "{" then (let snm = cs_hdtext(t) in let t1 = cs_drop1(t) in let hb = if cs_hdtext(t1) == "{" then 1 else 0 in let rb = cs_expr(if hb == 1 then cs_drop1(t1) else cs_dropin(t1)) in {node: ScopeE(snm, rb.node), rest: if hb == 1 then cs_dropkw(rb.rest, "}") else rb.rest}) else let hb = if cs_hdtext(t) == "{" then 1 else 0 in let rb = cs_expr(if hb == 1 then cs_drop1(t) else cs_dropin(t)) in {node: ScopeE("_scope", rb.node), rest: if hb == 1 then cs_dropkw(rb.rest, "}") else rb.rest}
fn cs_spawn(t) = if cs_hdtext(t) == "(" then let a = cs_arglist(cs_drop1(t)) in {node: SpawnE(cs_asthead(a.items)), rest: a.rest} else let r = cs_expr(t) in {node: SpawnE(r.node), rest: r.rest}
fn cs_shard(t) = let iv = cs_hdtext(t) in let rlo = cs_add(cs_dropkw(cs_drop1(t), "in")) in let rhi = cs_add(cs_dropkw(rlo.rest, "..")) in let rb = cs_expr(cs_dropkw(rhi.rest, "=>")) in {node: ShardE(iv, rlo.node, rhi.node, rb.node), rest: rb.rest}

fn cs_ispatstart(ts) = if cs_hdkind(ts) == "NM" or cs_hdkind(ts) == "ST" then 1 else if cs_hdkind(ts) == "ID" then cs_ispatid(cs_hdtext(ts)) else 0
fn cs_ispatid(s) = if s == "fn" or s == "pub" or s == "total" or s == "llm" or s == "effect" or s == "law" or s == "resource" or s == "print" or s == "type" or s == "let" or s == "var" or s == "if" or s == "then" or s == "else" or s == "in" or s == "match" or s == "and" or s == "or" then 0 else 1
fn cs_pat(ts) = if cs_hdkind(ts) == "NM" then {pat: PInt(toint(cs_hdtext(ts))), rest: cs_drop1(ts)} else if cs_hdkind(ts) == "ST" then {pat: PStr(cs_hdtext(ts)), rest: cs_drop1(ts)} else if cs_hdtext(ts) == "_" then {pat: PWild, rest: cs_drop1(ts)} else cs_patid(cs_hdtext(ts), cs_drop1(ts))
fn cs_patid(nm, ts) = if cs_isupper(at(nm, 0)) then cs_patctor(nm, ts) else {pat: PBind(nm), rest: ts}
fn cs_patctor(nm, ts) = if cs_hdtext(ts) == "(" then cs_patargs(nm, cs_patlist(cs_drop1(ts))) else {pat: PCons(nm, Nil), rest: ts}
fn cs_patargs(nm, r) = {pat: PCons(nm, r.items), rest: r.rest}
fn cs_patlist(ts) = if cs_hdtext(ts) == ")" then {items: Nil, rest: cs_drop1(ts)} else cs_patmore(cs_hdtext(ts), cs_drop1(ts))
fn cs_patmore(nm, ts) = if cs_hdtext(ts) == "," then cs_patcons(nm, cs_patlist(cs_drop1(ts))) else {items: Cons(nm, Nil), rest: cs_skiprp(ts)}
fn cs_patcons(nm, rr) = {items: Cons(nm, rr.items), rest: rr.rest}
fn cs_hasarm(ts) = if cs_ispatstart(ts) == 0 then 0 else cs_afterpat(cs_pat(ts))
fn cs_afterpat(p) = cs_hdtext(p.rest) == "=>"
fn cs_match(ts) = let sc = cs_expr(ts) in let a = cs_arms(sc.rest) in {node: Match(sc.node, a.items), rest: a.rest}
fn cs_arms(ts) = let p = cs_pat(ts) in let b = cs_expr(cs_dropkw(p.rest, "=>")) in if cs_hasarm(b.rest) == 1 then cs_armcons(p.pat, b.node, cs_arms(b.rest)) else {items: Cons({pat: p.pat, body: b.node}, Nil), rest: b.rest}
fn cs_armcons(p, b, rr) = {items: Cons({pat: p, body: b}, rr.items), rest: rr.rest}

## --- declarations (type / fn / print / expr) ---
fn cs_istyapp1(nm) = nm == "table" or nm == "rc" or nm == "arc" or nm == "weak" or nm == "promise" or nm == "signal" or nm == "cell" or nm == "chan" or nm == "Ref" or nm == "View" or nm == "unverified" or nm == "cap"
fn cs_ptype1(ts) = if cs_hdtext(ts) == "[" then cs_ptlist(cs_ptype1(cs_drop1(ts))) else if cs_hdtext(ts) == "tensor" and cs_hdtext(cs_drop1(ts)) == "[" then cs_pttensor(cs_ptype1(cs_drop1(cs_drop1(ts)))) else if cs_hdtext(ts) != "" and cs_hdtext(cs_drop1(ts)) == "[" then cs_ptapp(cs_hdtext(ts), cs_ptype1(cs_drop1(cs_drop1(ts)))) else {node: TyName(cs_hdtext(ts)), rest: cs_drop1(ts)}
fn cs_ptlist(r) = {node: TyList(r.node), rest: cs_skiprk(r.rest)}
fn cs_ptapp(kind, r) = {node: TyApply(kind, r.node), rest: cs_skiprk(r.rest)}
fn cs_ptdims(ts) = if cs_hdtext(ts) == "]" then {items: Nil, rest: cs_drop1(ts)} else let d = cs_hdtext(ts) in let t1 = cs_drop1(ts) in if cs_hdtext(t1) == "," then let rr = cs_ptdims(cs_drop1(t1)) in {items: Cons(d, rr.items), rest: rr.rest} else {items: Cons(d, Nil), rest: cs_skiprk(t1)}
fn cs_pttensor(r) = if cs_hdtext(r.rest) == "," then let ds = cs_ptdims(cs_drop1(r.rest)) in {node: TyTensor(r.node, ds.items), rest: ds.rest} else {node: TyTensor(r.node, Nil), rest: cs_skiprk(r.rest)}
fn cs_ptypes(ts) = if cs_hdtext(ts) == ")" then {items: Nil, rest: cs_drop1(ts)} else cs_ptmore(cs_ptype1(ts))
fn cs_ptmore(r) = if cs_hdtext(r.rest) == "," then cs_ptcons(r.node, cs_ptypes(cs_drop1(r.rest))) else {items: Cons(r.node, Nil), rest: cs_skiprp(r.rest)}
fn cs_ptcons(n, rr) = {items: Cons(n, rr.items), rest: rr.rest}

fn cs_pparams(ts) = if cs_hdtext(ts) == ")" then {items: Nil, tys: Nil, plist: Nil, rest: cs_drop1(ts)} else cs_pparamk(ts)
fn cs_pparamk(ts) = if cs_hdtext(ts) == "comptime" then cs_pparam(cs_hdtext(cs_drop1(ts)), 1, cs_drop1(cs_drop1(ts))) else if cs_hdtext(ts) == "own" then cs_pparam(cs_hdtext(cs_drop1(ts)), 2, cs_drop1(cs_drop1(ts))) else if cs_hdtext(ts) == "mut" then cs_pparam(cs_hdtext(cs_drop1(ts)), 3, cs_drop1(cs_drop1(ts))) else cs_pparam(cs_hdtext(ts), 0, cs_drop1(ts))
fn cs_pparam(nm, ct, ts) = if cs_hdtext(ts) == ":" then cs_pparamt(nm, ct, cs_ptype1(cs_drop1(ts))) else cs_pmore(nm, TyAny, ct, ts)
fn cs_pparamt(nm, ct, r) = if cs_hdtext(r.rest) == "where" then (let pr = cs_expr(cs_drop1(r.rest)) in cs_pmore(nm, TyRefine(r.node, pr.node), ct, pr.rest)) else cs_pmore(nm, r.node, ct, r.rest)
fn cs_pmore(nm, ty, ct, ts) = if cs_hdtext(ts) == "," then cs_pmcons(nm, ty, ct, cs_pparams(cs_drop1(ts))) else cs_pmend(nm, ty, ct, cs_skiprp(ts))
fn cs_pmcons(nm, ty, ct, rr) = {items: if ct != 1 then Cons(nm, rr.items) else rr.items, tys: Cons(ty, rr.tys), plist: Cons({cf: ct, pn: nm, pt: ty}, rr.plist), rest: rr.rest}
fn cs_pmend(nm, ty, ct, rest) = {items: if ct != 1 then Cons(nm, Nil) else Nil, tys: Cons(ty, Nil), plist: Cons({cf: ct, pn: nm, pt: ty}, Nil), rest: rest}
fn cs_peffitems(ts) = if cs_hdtext(ts) == "}" then {items: Nil, rest: cs_drop1(ts)} else let enm = cs_hdtext(ts) in let t1 = cs_drop1(ts) in if cs_hdtext(t1) == "," then let rr = cs_peffitems(cs_drop1(t1)) in {items: Cons(enm, rr.items), rest: rr.rest} else {items: Cons(enm, Nil), rest: cs_dropkw(t1, "}")}
fn cs_peffrow(ts) = if cs_hdtext(ts) == "/" then (let t1 = cs_drop1(ts) in if cs_hdtext(t1) == "{" then cs_peffitems(cs_drop1(t1)) else {items: Cons(cs_hdtext(t1), Nil), rest: cs_drop1(t1)}) else {items: Nil, rest: ts}
fn cs_pcontracts(ts) = if cs_hdtext(ts) == "requires" then let r = cs_expr(cs_drop1(ts)) in let rr = cs_pcontracts(r.rest) in {reqs: Cons(r.node, rr.reqs), enss: rr.enss, rest: rr.rest} else if cs_hdtext(ts) == "ensures" then let r = cs_expr(cs_drop1(ts)) in let rr = cs_pcontracts(r.rest) in {reqs: rr.reqs, enss: Cons(r.node, rr.enss), rest: rr.rest} else {reqs: Nil, enss: Nil, rest: ts}
fn cs_pret(ts) = if cs_hdtext(ts) == "-" and cs_hdtext(cs_drop1(ts)) == ">" then cs_pret2(cs_ptype1(cs_drop1(cs_drop1(ts)))) else let er = cs_peffrow(ts) in let vc = cs_pcontracts(er.rest) in {ty: TyAny, fromp: "", effs: er.items, reqs: vc.reqs, enss: vc.enss, rest: vc.rest}
fn cs_pret2(r) = if cs_hdtext(r.rest) == "where" then (let pr = cs_expr(cs_drop1(r.rest)) in let er = cs_peffrow(pr.rest) in let vc = cs_pcontracts(er.rest) in {ty: r.node, fromp: "", effs: er.items, reqs: vc.reqs, enss: Cons(pr.node, vc.enss), rest: vc.rest}) else if cs_hdtext(r.rest) == "from" then let rest2 = cs_drop1(cs_drop1(r.rest)) in let er = cs_peffrow(rest2) in let vc = cs_pcontracts(er.rest) in {ty: r.node, fromp: cs_hdtext(cs_drop1(r.rest)), effs: er.items, reqs: vc.reqs, enss: vc.enss, rest: vc.rest} else let er = cs_peffrow(r.rest) in let vc = cs_pcontracts(er.rest) in {ty: r.node, fromp: "", effs: er.items, reqs: vc.reqs, enss: vc.enss, rest: vc.rest}
fn cs_isany(t) = match t
    TyAny => 1
    _     => 0
fn cs_anyann(tys) = match tys
    Nil        => 0
    Cons(h, t) => if cs_isany(h) == 0 then 1 else cs_anyann(t)
fn cs_ganyct(pl) = match pl
    Nil        => 0
    Cons(p, r) => if p.cf == 1 then 1 else cs_ganyct(r)
fn cs_anyownp(pl) = match pl
    Nil        => 0
    Cons(p, r) => if p.cf >= 2 then 1 else cs_anyownp(r)
fn cs_mksig(nm, ps, rty) = if cs_ganyct(ps.plist) == 1 then GSig(nm, ps.plist, rty) else if cs_anyann(ps.tys) == 1 or cs_isany(rty) == 0 then Sig(nm, ps.items, ps.tys, rty) else Nil
fn cs_mkosig(nm, pubf, freef, pl, rty, fromp) = if pubf == 1 or freef > 0 or cs_anyownp(pl) == 1 or fromp != "" then OSig(nm, pubf, freef, pl, rty, fromp) else Nil
fn cs_mkksig(nm, effs) = if cs_isnil(effs) == 0 then KEffSig(nm, effs) else Nil
fn cs_mkvsig(nm, ps, reqs, enss) = if cs_isnil(reqs) == 0 or cs_isnil(enss) == 0 then VContractSig(nm, ps, reqs, enss) else Nil
fn cs_pfnp(ts, pubf, freef) = let nm = cs_hdtext(ts) in let ps = cs_pparams(cs_dropkw(cs_drop1(ts), "(")) in let rt = cs_pret(ps.rest) in let b = if cs_hdtext(rt.rest) == "=" then cs_expr(cs_drop1(rt.rest)) else if (freef / 4) % 2 == 1 then {node: Call("llm_prompt", Cons(Str(nm), Nil)), rest: rt.rest} else if (freef / 32) % 2 == 1 then {node: Nil, rest: rt.rest} else cs_expr(rt.rest) in {node: if cs_isnil(b.node) == 1 then Nil else Fn(nm, ps.items, b.node), sg: cs_mksig(nm, ps, rt.ty), osg: cs_mkosig(nm, pubf, freef, ps.plist, rt.ty, rt.fromp), ksg: cs_mkksig(nm, rt.effs), vsg: cs_mkvsig(nm, ps.items, rt.reqs, rt.enss), rest: b.rest}
fn cs_pfn(ts) = cs_pfnp(ts, 0, 0)

fn cs_skiptp1(ts, close, d) = if d <= 0 then ts else if cs_isnil(ts) == 1 then Nil else if cs_hdtext(ts) == "[" or cs_hdtext(ts) == "(" then cs_skiptp1(cs_drop1(ts), close, d + 1) else if cs_hdtext(ts) == close then cs_skiptp1(cs_drop1(ts), close, d - 1) else cs_skiptp1(cs_drop1(ts), close, d)
fn cs_skiptp(ts) = if cs_hdtext(ts) == "[" then cs_skiptp1(cs_drop1(ts), "]", 1) else if cs_hdtext(ts) == "(" then cs_skiptp1(cs_drop1(ts), ")", 1) else ts
fn cs_prefinety(nm, t) = let bty = TyName(cs_hdtext(t)) in let pr = cs_expr(cs_drop1(cs_drop1(t))) in {node: TypeRefineS(nm, bty, pr.node), inv: Nil, rest: pr.rest}
fn cs_prefinebrace(nm, t) = let t1 = cs_drop1(t) in let bty = TyName(cs_hdtext(cs_drop1(cs_drop1(t1)))) in let pr = cs_expr(cs_dropkw(cs_drop1(cs_drop1(cs_drop1(t1))), "|")) in {node: TypeRefineS(nm, bty, pr.node), inv: Nil, rest: cs_dropkw(pr.rest, "}")}
fn cs_ptype(ts) = let nm = cs_hdtext(ts) in let rest = cs_dropkw(cs_skiptp(cs_drop1(ts)), "=") in if cs_hdtext(rest) == "record" or cs_hdtext(rest) == "model" then cs_precordty(nm, cs_dropkw(cs_drop1(rest), "{")) else if cs_hdtext(rest) == "{" and cs_hdtext(cs_drop1(cs_drop1(cs_drop1(cs_drop1(rest))))) == "|" then cs_prefinebrace(nm, rest) else if cs_hdtext(rest) == "{" then cs_precordty(nm, cs_drop1(rest)) else if cs_hdtext(cs_drop1(rest)) == "where" then cs_prefinety(nm, rest) else cs_penumty(nm, cs_dropkw(rest, "enum"))
fn cs_penumty(nm, ts) = let vs = cs_pvariants(cs_dropkw(ts, "|")) in {node: TypeS(nm, "enum", vs.items), inv: Nil, rest: vs.rest}
fn cs_pvariants(ts) = cs_pvariant(cs_hdtext(ts), cs_drop1(ts))
fn cs_pvariant(tag, ts) = if cs_hdtext(ts) == "(" then let a = cs_ptypes(cs_drop1(ts)) in cs_pvariantend(tag, cs_len(a.items), a.rest) else cs_pvariantend(tag, 0, ts)
fn cs_pvariantend(tag, ar, ts) = if cs_hdtext(ts) == "|" then let rr = cs_pvariants(cs_drop1(ts)) in {items: Cons({tag: tag, ar: ar}, rr.items), rest: rr.rest} else {items: Cons({tag: tag, ar: ar}, Nil), rest: ts}
fn cs_precordty(nm, ts) = let fs = cs_pfields(ts) in let r1 = cs_dropkw(fs.rest, "}") in if cs_hdtext(r1) == "invariant" then let iv = cs_expr(cs_drop1(r1)) in {node: TypeS(nm, "record", fs.items), inv: VTypeInvariant(nm, fs.items, iv.node), rest: iv.rest} else {node: TypeS(nm, "record", fs.items), inv: Nil, rest: r1}
fn cs_pfields(ts) = let fnm = cs_hdtext(ts) in let r = cs_ptype1(cs_dropkw(cs_drop1(ts), ":")) in if cs_hdtext(r.rest) == "," then let rr = cs_pfields(cs_drop1(r.rest)) in {items: Cons({fname: fnm, fty: r.node}, rr.items), rest: rr.rest} else {items: Cons({fname: fnm, fty: r.node}, Nil), rest: r.rest}

fn cs_tdeclname(nd) = match nd
    TypeS(nm, k, items) => nm
    _                   => ""
fn cs_progtype(r) = cs_pprogfn2(r.inv, Cons(r.node, cs_pprog(r.rest)))
fn cs_progtyped(kind, r) = Cons(OType(cs_tdeclname(r.node), kind), cs_pprogfn2(r.inv, Cons(r.node, cs_pprog(r.rest))))
fn cs_lawrtarg3(args) = match args
    Cons(a, Cons(b, Cons(c, r))) => c
    _                            => Num(1)
fn cs_lawrtbody(e) = match e
    Call(nm, args) => if nm == "always" or nm == "eventually" or nm == "until" or nm == "leads_to" then cs_lawrtarg3(args) else e
    _              => e
fn cs_plaw(t) = let nm = cs_hdtext(t) in let ps = cs_pparams(cs_dropkw(cs_drop1(t), "(")) in let rt = cs_pret(ps.rest) in let b = cs_expr(cs_dropkw(rt.rest, "=")) in {law: VLawDecl(nm, ps.items, b.node), sg: cs_mksig("law_" + nm, ps, TyName("int")), fnnode: Fn("law_" + nm, ps.items, cs_lawrtbody(b.node)), rest: b.rest}
fn cs_proglaw(r) = Cons(r.law, cs_pprogfn2(r.sg, Cons(r.fnnode, cs_pprog(r.rest))))
fn cs_prule(t) = let nm = cs_hdtext(t) in let ps = cs_pparams(cs_dropkw(cs_drop1(t), "(")) in let rt = cs_pret(ps.rest) in let sep = if cs_hdtext(rt.rest) == "when" then cs_drop1(rt.rest) else if cs_hdtext(rt.rest) == ":" and cs_hdtext(cs_drop1(rt.rest)) == "-" then cs_drop1(cs_drop1(rt.rest)) else cs_dropkw(rt.rest, "=") in let b = cs_expr(sep) in {sg: cs_mksig(nm, ps, TyName("int")), fnnode: Fn(nm, ps.items, b.node), rest: b.rest}
fn cs_progrule(r) = cs_pprogfn2(r.sg, Cons(r.fnnode, cs_pprog(r.rest)))
fn cs_skipatparen1(ts, d) = if d <= 0 then ts else if cs_isnil(ts) == 1 then Nil else if cs_hdtext(ts) == "(" then cs_skipatparen1(cs_drop1(ts), d + 1) else if cs_hdtext(ts) == ")" then cs_skipatparen1(cs_drop1(ts), d - 1) else cs_skipatparen1(cs_drop1(ts), d)
fn cs_skipatparen(ts) = if cs_hdtext(ts) == "(" then cs_skipatparen1(cs_drop1(ts), 1) else ts
fn cs_peffop(ts) = let opnm = cs_hdtext(cs_drop1(ts)) in let ps = cs_pparams(cs_dropkw(cs_drop1(cs_drop1(ts)), "(")) in let rt = cs_pret(ps.rest) in {op: {op: opnm, ps: ps.items, pt: ps.tys, rt: rt.ty}, rest: cs_dropkw(rt.rest, ";")}
fn cs_peffops(ts) = if cs_hdtext(ts) == "fn" then let r = cs_peffop(ts) in let rr = cs_peffops(r.rest) in {items: Cons(r.op, rr.items), rest: rr.rest} else {items: Nil, rest: ts}
fn cs_peffect(t) = let enm = cs_hdtext(t) in let ops = cs_peffops(cs_dropkw(cs_drop1(t), "{")) in {node: KEffectDecl(enm, ops.items), rest: cs_dropkw(ops.rest, "}")}
fn cs_pcaplist(ts) = if cs_isnil(ts) == 1 then {items: Nil, rest: Nil} else if cs_hdtext(ts) == ")" then {items: Nil, rest: cs_drop1(ts)} else let tok = cs_hdtext(ts) in let rr = cs_pcaplist(cs_drop1(ts)) in if tok == "allow" or tok == ":" or tok == "[" or tok == "]" or tok == "," then rr else {items: Cons(tok, rr.items), rest: rr.rest}
fn cs_pcapat(t) = let t1 = cs_drop1(t) in let er = if cs_hdtext(t1) == "{" then cs_peffitems(cs_drop1(t1)) else if cs_hdtext(t1) == "(" then cs_pcaplist(cs_drop1(t1)) else {items: Cons(cs_hdtext(t1), Nil), rest: cs_drop1(t1)} in Cons(KCapGrant(er.items), cs_pprog(er.rest))
fn cs_pboundval(ts) = if cs_hdtext(ts) != "(" then 0 else let t1 = cs_drop1(ts) in if cs_hdtext(cs_drop1(t1)) == ":" then toint(cs_hdtext(cs_drop1(cs_drop1(t1)))) else toint(cs_hdtext(t1))
fn cs_progfnwcet(wcet, fnm, r) = if wcet > 0 then Cons(WcetSig(fnm, wcet), cs_pprogfn(r)) else cs_pprogfn(r)
fn cs_parseattrs(ts, freef, wcet) = if cs_hdtext(ts) == "@" then (let t1 = cs_drop1(ts) in let anm = cs_hdtext(t1) in let t2 = cs_drop1(t1) in if anm == "freestanding" then cs_parseattrs(cs_skipatparen(t2), freef + 1, wcet) else if anm == "interrupt" then cs_parseattrs(cs_skipatparen(t2), freef + 16, wcet) else if anm == "export" then cs_parseattrs(cs_skipatparen(t2), if (freef / 32) % 2 == 0 then freef + 32 else freef, wcet) else if anm == "protect" then cs_parseattrs(cs_skipatparen(t2), freef + 64, wcet) else if anm == "bound" then cs_parseattrs(cs_skipatparen(t2), freef, cs_pboundval(t2)) else cs_parseattrs(cs_skipatparen(t2), freef, wcet)) else if cs_hdtext(ts) == "pub" and cs_hdtext(cs_drop1(ts)) == "extern" then cs_progextern(cs_drop1(cs_drop1(ts)), 1) else if cs_hdtext(ts) == "extern" then cs_progextern(cs_drop1(ts), 0) else if cs_hdtext(ts) == "pub" and cs_hdtext(cs_drop1(ts)) == "fn" then let ft = cs_drop1(cs_drop1(ts)) in cs_progfnwcet(wcet, cs_hdtext(ft), cs_pfnp(ft, 1, freef)) else if cs_hdtext(ts) == "fn" then let ft = cs_drop1(ts) in cs_progfnwcet(wcet, cs_hdtext(ft), cs_pfnp(ft, if (freef / 32) % 2 == 1 then 1 else 0, freef)) else cs_pprog(ts)
fn cs_progat(t) = if cs_hdtext(t) == "gc" then cs_progtyped("gc", cs_ptype(cs_drop1(cs_drop1(t)))) else if cs_hdtext(t) == "soa" and cs_hdtext(cs_drop1(t)) == "type" then cs_progtyped("soa", cs_ptype(cs_drop1(cs_drop1(t)))) else if cs_hdtext(t) == "capability" or cs_hdtext(t) == "grant" then cs_pcapat(t) else if cs_hdtext(t) == "link" or cs_hdtext(t) == "need" then cs_pprog(cs_skipatparen(cs_drop1(t))) else cs_parseattrs(Cons({kind: "op", text: "@"}, t), 0, 0)
fn cs_progextern(t, pubf) = if cs_hdtext(t) == "llm" and cs_hdtext(cs_drop1(t)) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(cs_drop1(t)), pubf, 4)) else if cs_hdtext(cs_drop1(t)) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(cs_drop1(t)), pubf, 32)) else if cs_hdtext(t) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(t), pubf, 32)) else cs_pprogfn(cs_pfnp(cs_drop1(t), pubf, 4))
fn cs_progpub(t) = if cs_hdtext(t) == "total" and cs_hdtext(cs_drop1(t)) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(cs_drop1(t)), 1, 2)) else if cs_hdtext(t) == "llm" and cs_hdtext(cs_drop1(t)) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(cs_drop1(t)), 1, 4)) else if cs_hdtext(t) == "extern" then cs_progextern(cs_drop1(t), 1) else if cs_hdtext(t) == "kernel" and cs_hdtext(cs_drop1(t)) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(cs_drop1(t)), 1, 8)) else if cs_hdtext(t) == "rule" then cs_progrule(cs_prule(cs_drop1(t))) else if cs_hdtext(t) == "effect" then let r = cs_peffect(cs_drop1(t)) in Cons(r.node, cs_pprog(r.rest)) else if cs_hdtext(t) == "temporal" and cs_hdtext(cs_drop1(t)) == "law" then cs_proglaw(cs_plaw(cs_drop1(cs_drop1(t)))) else if cs_hdtext(t) == "law" then cs_proglaw(cs_plaw(cs_drop1(t))) else cs_pprogfn(cs_pfnp(cs_drop1(t), 1, 0))
fn cs_pprog(ts) = match ts
    Nil        => Nil
    Cons(h, t) => if h.text == "fn" then cs_pprogfn(cs_pfn(cs_drop1(ts))) else if h.text == "pub" and (cs_hdtext(t) == "fn" or cs_hdtext(t) == "total" or cs_hdtext(t) == "llm" or cs_hdtext(t) == "extern" or cs_hdtext(t) == "kernel" or cs_hdtext(t) == "rule" or cs_hdtext(t) == "effect" or cs_hdtext(t) == "temporal" or cs_hdtext(t) == "law") then cs_progpub(t) else if h.text == "total" and cs_hdtext(t) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(t), 0, 2)) else if h.text == "llm" and cs_hdtext(t) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(t), 0, 4)) else if h.text == "extern" then cs_progextern(t, 0) else if h.text == "kernel" and cs_hdtext(t) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(t), 0, 8)) else if h.text == "rule" then cs_progrule(cs_prule(t)) else if h.text == "effect" then let r = cs_peffect(t) in Cons(r.node, cs_pprog(r.rest)) else if h.text == "temporal" and cs_hdtext(t) == "law" then cs_proglaw(cs_plaw(cs_drop1(t))) else if h.text == "law" then cs_proglaw(cs_plaw(t)) else if h.text == "@" then cs_progat(t) else if h.text == "resource" and cs_hdtext(t) == "type" then cs_progtyped("resource", cs_ptype(cs_drop1(t))) else if h.text == "model" and cs_hdtext(t) == "type" then cs_progtyped("model", cs_ptype(cs_drop1(t))) else if h.text == "type" then (if cs_hdtext(cs_dropkw(cs_drop1(t), "=")) == "model" then cs_progtyped("model", cs_ptype(t)) else cs_progtype(cs_ptype(cs_drop1(ts)))) else if h.text == "print" then let r = cs_expr(cs_drop1(ts)) in Cons(Print(r.node), cs_pprog(r.rest)) else let r = cs_expr(ts) in Cons(ExprS(r.node), cs_pprog(r.rest))
fn cs_pprogfn(r) = cs_pprogfn2(r.vsg, cs_pprogfn2(r.ksg, cs_pprogfn2(r.osg, cs_pprogfn2(r.sg, cs_pprogfn2(r.node, cs_pprog(r.rest))))))
fn cs_pprogfn2(sg, rest) = match sg
    Nil => rest
    _   => Cons(sg, rest)
fn cs_parse(src) = cs_pprog(cs_lex(src, 0))

## --- symbol table extraction ---
fn cs_tystr(ty) = match ty
    TyAny            => "any"
    TyName(nm)       => nm
    TyRefine(bty, p) => cs_tystr(bty)
    TyList(inner)    => "[" + cs_tystr(inner) + "]"
    TyApply(c, arg)  => c + "[" + cs_tystr(arg) + "]"
    TyTensor(e, ds)  => "tensor[" + cs_tystr(e) + (if cs_isnil(ds) == 1 then "]" else ", " + cs_joinsep(ds, ", ") + "]")
    _                => "any"
fn cs_variants_str(vs) = match vs
    Nil        => ""
    Cons(h, t) => let s = h.tag + "(" + str(h.ar) + ")" in if cs_isnil(t) == 1 then s else s + " | " + cs_variants_str(t)
fn cs_fields_str(fs) = match fs
    Nil        => ""
    Cons(h, t) => let s = h.fname + ": " + cs_tystr(h.fty) in if cs_isnil(t) == 1 then s else s + ", " + cs_fields_str(t)
fn cs_params_str(ps) = cs_joinsep(ps, ", ")
fn cs_symbols(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_sym1(h, cs_symbols(t))
fn cs_sym1(s0, rest) = match s0
    TypeS(nm, k, items) => Cons({name: nm, kind: k, sig: if k == "enum" then cs_variants_str(items) else "{" + cs_fields_str(items) + "}"}, rest)
    Fn(nm, ps, body)    => Cons({name: nm, kind: "fn", sig: "fn(" + cs_params_str(ps) + ")"}, rest)
    _                   => rest

## --- AI-first fix-it suggestion helper (prefix / substring / length similarity) ---
fn cs_common_prefix(a, b, i, n) = if i >= n then i else if at(a, i) == at(b, i) then cs_common_prefix(a, b, i + 1, n) else i
fn cs_min(a, b) = if a < b then a else b
fn cs_abs(x) = if x < 0 then 0 - x else x
fn cs_sim(a, b) = let cp = cs_common_prefix(a, b, 0, cs_min(count(a), count(b))) in (cp * 4) - cs_abs(count(a) - count(b))
fn cs_best_cand(target, cands, best, best_score) = match cands
    Nil        => best
    Cons(h, t) => let sc = cs_sim(target, h) in if best == "" or sc > best_score then cs_best_cand(target, t, h, sc) else cs_best_cand(target, t, best, best_score)
fn cs_ctor_names(ctors) = match ctors
    Nil        => Nil
    Cons(h, t) => Cons(h.tag, cs_ctor_names(t))
fn cs_field_names(fs) = match fs
    Nil        => Nil
    Cons(h, t) => Cons(h.fname, cs_field_names(t))

## --- non-aborting multi-diagnostic collector (F1, F2, C3, C1/C2/M1/M2) ---
fn cs_tanydecl(prog) = match prog
    Nil        => 0
    Cons(h, t) => cs_tanydecl2(h, t)
fn cs_tanydecl2(h, t) = match h
    TypeS(nm, k, items) => 1
    _                   => cs_tanydecl(t)
fn cs_townerize(nm, items) = match items
    Nil        => Nil
    Cons(h, t) => Cons({tag: h.tag, ar: h.ar, en: nm}, cs_townerize(nm, t))
fn cs_tcollectc(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_tcollectc2(h, t)
fn cs_tcollectc2(h, t) = match h
    TypeS(nm, k, items) => if k == "enum" then cs_app(cs_townerize(nm, items), cs_tcollectc(t)) else cs_tcollectc(t)
    _                   => cs_tcollectc(t)
fn cs_tcollectr(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_tcollectr2(h, t)
fn cs_tcollectr2(h, t) = match h
    TypeS(nm, k, items) => if k == "record" then Cons({rname: nm, fields: items}, cs_tcollectr(t)) else cs_tcollectr(t)
    _                   => cs_tcollectr(t)
fn cs_tcollectrt(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_tcollectrt2(h, t)
fn cs_tcollectrt2(h, t) = match h
    TypeRefineS(nm, bty, pr) => Cons({nm: nm, bty: bty}, cs_tcollectrt(t))
    _                        => cs_tcollectrt(t)
fn cs_trtlookup(nm, rts) = match rts
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h.bty, Nil) else cs_trtlookup(nm, t)
fn cs_tstrip_refine(ty, rts) = match ty
    TyRefine(bty, pr) => cs_tstrip_refine(bty, rts)
    TyName(n)         => cs_tstrip_refine_nm(n, cs_trtlookup(n, rts), rts)
    TyList(e)         => TyList(cs_tstrip_refine(e, rts))
    TyApply(n, e)     => TyApply(n, cs_tstrip_refine(e, rts))
    _                 => ty
fn cs_tstrip_refine_nm(n, m, rts) = match m
    Nil          => TyName(n)
    Cons(bty, r) => cs_tstrip_refine(bty, rts)
fn cs_tstrip_refine_tys(tys, rts) = match tys
    Nil        => Nil
    Cons(h, t) => Cons(cs_tstrip_refine(h, rts), cs_tstrip_refine_tys(t, rts))
fn cs_tcollects(prog) = cs_tcollects_rts(prog, cs_tcollectrt(prog))
fn cs_tcollects_rts(prog, rts) = match prog
    Nil        => Nil
    Cons(h, t) => cs_tcollects2(h, t, rts)
fn cs_tcollects2(h, t, rts) = match h
    Sig(nm, ps, ts, rt) => Cons({fname: nm, pn: ps, pt: cs_tstrip_refine_tys(ts, rts), rt: cs_tstrip_refine(rt, rts)}, cs_tcollects_rts(t, rts))
    _                   => cs_tcollects_rts(t, rts)
fn cs_tcollectg(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_tcollectg2(h, t)
fn cs_tcollectg2(h, t) = match h
    GSig(nm, pl, rt) => Cons({fname: nm, params: pl, rt: rt}, cs_tcollectg(t))
    _                => cs_tcollectg(t)
fn cs_buildft(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_buildft2(h, cs_buildft(t))
fn cs_buildft2(h, rest) = match h
    Fn(nm, ps, body) => Cons(h, rest)
    _                => rest
fn cs_tcollect(prog) = {ctors: cs_tcollectc(prog), recs: cs_tcollectr(prog), sigs: cs_tcollects(prog), gsigs: cs_tcollectg(prog), decl: cs_tanydecl(prog), ft: cs_buildft(prog), lenv: Nil}

fn cs_clookup(tag, ctors) = match ctors
    Nil        => Nil
    Cons(h, t) => if h.tag == tag then Cons(h, Nil) else cs_clookup(tag, t)
fn cs_rlookup(nm, recs) = match recs
    Nil        => Nil
    Cons(h, t) => if h.rname == nm then Cons(h, Nil) else cs_rlookup(nm, t)
fn cs_hasfield(fnm, fs) = match fs
    Nil        => 0
    Cons(h, t) => if h.fname == fnm then 1 else cs_hasfield(fnm, t)
fn cs_siglookup(nm, sigs) = match sigs
    Nil        => Nil
    Cons(h, t) => if h.fname == nm then Cons(h, Nil) else cs_siglookup(nm, t)
fn cs_gsiglookup(nm, gsigs) = match gsigs
    Nil        => Nil
    Cons(h, t) => if h.fname == nm then Cons(h, Nil) else cs_gsiglookup(nm, t)
fn cs_fnname(f0) = match f0
    Fn(nm, ps, body) => nm
    _                => ""
fn cs_fnlookup(nm, ft) = match ft
    Nil        => Nil
    Cons(h, t) => if cs_fnname(h) == nm then Cons(h, Nil) else cs_fnlookup(nm, t)

fn cs_glookup_empty(nm, env) = match env
    Nil        => ""
    Cons(h, t) => if h.k == nm then h.v else cs_glookup_empty(nm, t)
fn cs_tier_inner(s) = if cs_startswith(s, "rc[") == 1 then slice(s, 3, count(s) - 1) else if cs_startswith(s, "arc[") == 1 then slice(s, 4, count(s) - 1) else if cs_startswith(s, "weak[") == 1 then slice(s, 5, count(s) - 1) else if cs_startswith(s, "promise[") == 1 then slice(s, 8, count(s) - 1) else if cs_startswith(s, "signal[") == 1 then slice(s, 7, count(s) - 1) else ""
fn cs_exprty_money(xs) = match xs
    Cons(Str(ccy), rest) => if ccy != "" then "money[" + ccy + "]" else ""
    _                    => ""
fn cs_exprty_tier(nm, args, tt) = if (nm == "rc" or nm == "rc_new") and cs_len(args) == 1 then (let sub = cs_exprty(cs_asthead(args), tt) in if sub != "" then "rc[" + sub + "]" else "") else if (nm == "arc" or nm == "arc_new") and cs_len(args) == 1 then (let sub = cs_exprty(cs_asthead(args), tt) in if sub != "" then "arc[" + sub + "]" else "") else if (nm == "clone" or nm == "rc_clone" or nm == "arc_clone") and cs_len(args) == 1 then cs_exprty(cs_asthead(args), tt) else if (nm == "downgrade" or nm == "weak_downgrade") and cs_len(args) == 1 then (let sub = cs_tier_inner(cs_exprty(cs_asthead(args), tt)) in if sub != "" then "weak[" + sub + "]" else "") else if (nm == "promise" or nm == "promise_new") and cs_len(args) == 1 then (let sub = cs_exprty(cs_asthead(args), tt) in if sub != "" then "promise[" + sub + "]" else "") else if (nm == "signal" or nm == "signal_new") and cs_len(args) == 1 then (let sub = cs_exprty(cs_asthead(args), tt) in if sub != "" then "signal[" + sub + "]" else "") else if (nm == "get" or nm == "rc_get" or nm == "arc_get" or nm == "signal_get" or nm == "await" or nm == "promise_await") and cs_len(args) == 1 then cs_tier_inner(cs_exprty(cs_asthead(args), tt)) else if (nm == "upgrade" or nm == "weak_upgrade") and cs_len(args) == 2 then cs_tier_inner(cs_exprty(cs_asthead(args), tt)) else if (nm == "strong_count" or nm == "rc_strong_count" or nm == "arc_strong_count" or nm == "version" or nm == "signal_version" or nm == "bv_u8" or nm == "bv_not_u8") and cs_len(args) == 1 then "int" else if (nm == "bv_xor" or nm == "bit_xor" or nm == "bv_and" or nm == "bit_and" or nm == "bv_or" or nm == "bit_or" or nm == "bv_shl" or nm == "bit_shl" or nm == "bv_shr" or nm == "bit_shr" or nm == "bv_add_u8" or nm == "bv_sub_u8" or nm == "bv_mul_u8") and cs_len(args) == 2 then "int" else if (nm == "forall_range" or nm == "exists_range") and cs_len(args) == 4 then "int" else ""
fn cs_exprty(e, tt) = match e
    Num(n)          => "int"
    Str(v)          => "str"
    RecT(tn, items) => tn
    Call(nm, args)  => let tr = cs_exprty_tier(nm, args, tt) in if tr != "" then tr else if nm == "money_parse" or nm == "money_make" then cs_exprty_money(args) else if cs_isupper(at(nm, 0)) then cs_ctorty(cs_clookup(nm, tt.ctors)) else ""
    Var(nm)         => if cs_isupper(at(nm, 0)) then cs_ctorty(cs_clookup(nm, tt.ctors)) else cs_glookup_empty(nm, tt.lenv)
    _               => ""
fn cs_ctorty(m) = match m
    Nil        => ""
    Cons(h, t) => h.en

fn cs_mkdiag(code, phase, msg, fix) = {code: code, severity: "error", phase: phase, message: msg, fixit: fix}
fn cs_mkwarn(code, phase, msg, fix) = {code: code, severity: "warning", phase: phase, message: msg, fixit: fix}
fn cs_has_error_diags(ds) = match ds
    Nil        => 0
    Cons(h, t) => if h.severity == "error" then 1 else cs_has_error_diags(t)

fn cs_chk_ctor(tag, ar, tt) = if tt.decl == 0 then Nil else cs_chk_ctor2(tag, ar, cs_clookup(tag, tt.ctors), tt)
fn cs_chk_ctor2(tag, ar, m, tt) = match m
    Nil        => let cand = cs_best_cand(tag, cs_ctor_names(tt.ctors), "", 0 - 999) in Cons(cs_mkdiag("T1001", "typecheck", "type error: constructor '" + tag + "' is not declared in any enum", if cand == "" then "declare '" + tag + "' in an enum type" else "replace '" + tag + "' with declared constructor '" + cand + "'"), Nil)
    Cons(c, r) => if c.ar == ar then Nil else Cons(cs_mkdiag("T1002", "typecheck", "type error: constructor '" + tag + "' expects " + str(c.ar) + " arguments, got " + str(ar), "pass " + str(c.ar) + " arguments to '" + tag + "'"), Nil)

fn cs_chk_rect(tn, items, tt) = if tt.decl == 0 then cs_chk_reclist(items, tt) else cs_chk_rect2(tn, items, cs_rlookup(tn, tt.recs), tt)
fn cs_chk_rect2(tn, items, m, tt) = match m
    Nil        => Cons(cs_mkdiag("T1003", "typecheck", "type error: record type '" + tn + "' is not declared", "declare 'type " + tn + " = record ...'"), cs_chk_reclist(items, tt))
    Cons(d, r) => cs_app(cs_chk_rfields(tn, items, d.fields), cs_chk_reclist(items, tt))
fn cs_chk_rfields(tn, items, declfs) = match items
    Nil        => Nil
    Cons(h, t) => if cs_hasfield(h.key, declfs) == 1 then cs_chk_rfields(tn, t, declfs) else let cand = cs_best_cand(h.key, cs_field_names(declfs), "", 0 - 999) in Cons(cs_mkdiag("T1003", "typecheck", "type error: record '" + tn + "' has no field '" + h.key + "'", if cand == "" then "remove unknown field '" + h.key + "'" else "replace unknown field '" + h.key + "' on '" + tn + "' with '" + cand + "'"), cs_chk_rfields(tn, t, declfs))

fn cs_chk_arg1(fnm, idx, pn, pt, a, tt) = match pt
    TyName(exp)      => let got = cs_exprty(a, tt) in if got == "" or got == exp then Nil else Cons(cs_mkdiag("T2001", "typecheck", "type error: argument " + str(idx) + " of '" + fnm + "' has type " + got + " but parameter '" + pn + "' expects " + exp, "change argument " + str(idx) + " of '" + fnm + "' (parameter '" + pn + "') to " + exp), Nil)
    TyApply(kn, sub) => let exp = kn + "[" + cs_tystr(sub) + "]" in let got = cs_exprty(a, tt) in if got == "" or got == exp then Nil else Cons(cs_mkdiag("T2001", "typecheck", "type error: argument " + str(idx) + " of '" + fnm + "' has type " + got + " but parameter '" + pn + "' expects " + exp, "change argument " + str(idx) + " of '" + fnm + "' (parameter '" + pn + "') to " + exp), Nil)
    _                => Nil
fn cs_chk_args(fnm, idx, pns, pts, args, tt) = match args
    Nil         => Nil
    Cons(a, ar) => cs_chk_args2(fnm, idx, pns, pts, a, ar, tt)
fn cs_chk_args2(fnm, idx, pns, pts, a, ar, tt) = match pns
    Nil          => Nil
    Cons(pn, pr) => cs_chk_args3(fnm, idx, pn, pr, pts, a, ar, tt)
fn cs_chk_args3(fnm, idx, pn, pr, pts, a, ar, tt) = match pts
    Nil          => Nil
    Cons(pt, tr) => cs_app(cs_chk_arg1(fnm, idx, pn, pt, a, tt), cs_chk_args(fnm, idx + 1, pr, tr, ar, tt))

fn cs_tyarg(e) = match e
    Var(nm)      => nm
    Call(nm, xs) => if nm == "_tylist_" and cs_len(xs) == 1 then "[" + cs_tyarg(cs_asthead(xs)) + "]" else if count(nm) > 7 and slice(nm, 0, 7) == "_tyapp_" and cs_len(xs) == 1 then slice(nm, 7, count(nm)) + "[" + cs_tyarg(cs_asthead(xs)) + "]" else ""
    _            => ""
fn cs_glookup(nm, env) = match env
    Nil        => nm
    Cons(h, t) => if h.k == nm then h.v else cs_glookup(nm, t)
fn cs_tsubst(ty, env) = match ty
    TyName(nm) => TyName(cs_glookup(nm, env))
    _          => ty
fn cs_chk_gparams(fnm, idx, pl, args, env, tt) = match pl
    Nil         => Nil
    Cons(p, pr) => cs_chk_gparams2(fnm, idx, p, pr, args, env, tt)
fn cs_chk_gparams2(fnm, idx, p, pr, args, env, tt) = match args
    Nil         => Nil
    Cons(a, ar) => if p.cf == 1 then let tnm = cs_tyarg(a) in (if tnm == "" then Cons(cs_mkdiag("T3001", "typecheck", "type error: comptime parameter '" + p.pn + "' of '" + fnm + "' expects a type name", "pass a type name such as 'int' or 'str'"), cs_chk_gparams(fnm, idx + 1, pr, ar, env, tt)) else cs_chk_gparams(fnm, idx + 1, pr, ar, Cons({k: p.pn, v: tnm}, env), tt)) else cs_app(cs_chk_arg1(fnm, idx, p.pn, cs_tsubst(p.pt, env), a, tt), cs_chk_gparams(fnm, idx + 1, pr, ar, env, tt))

fn cs_chk_tier_call(nm, args, tt) = if (nm == "resolve" or nm == "promise_resolve" or nm == "set" or nm == "signal_set" or nm == "upgrade" or nm == "weak_upgrade") and cs_len(args) == 2 then (let pty = cs_exprty(cs_asthead(args), tt) in let exp = cs_tier_inner(pty) in let got = cs_exprty(cs_asthead(cs_cvtl(args)), tt) in if exp != "" and got != "" and exp != got then Cons(cs_mkdiag("T2001", "typecheck", "type error: argument 2 of '" + nm + "' has type " + got + " but '" + pty + "' expects " + exp, "pass a value of type " + exp + " to '" + nm + "'"), Nil) else Nil) else Nil
fn cs_chk_callsig(nm, args, tt) = cs_app(cs_chk_tier_call(nm, args, tt), cs_chk_callsig2(nm, args, cs_gsiglookup(nm, tt.gsigs), tt))
fn cs_chk_callsig2(nm, args, gm, tt) = match gm
    Cons(g, gr) => cs_chk_gparams(nm, 1, g.params, args, Nil, tt)
    Nil         => cs_chk_callsig3(nm, args, cs_siglookup(nm, tt.sigs), tt)
fn cs_chk_callsig3(nm, args, sm, tt) = match sm
    Cons(sg, sr) => cs_chk_args(nm, 1, sg.pn, sg.pt, args, tt)
    Nil          => Nil

fn cs_chk_ret(nm, body, tt) = cs_chk_ret2(nm, body, cs_siglookup(nm, tt.sigs), tt)
fn cs_chk_ret2(nm, body, sm, tt) = match sm
    Nil          => Nil
    Cons(sg, sr) => cs_chk_ret3(nm, body, sg.rt, tt)
fn cs_chk_ret3(nm, body, rt, tt) = match rt
    TyName(exp) => let got = cs_exprty(body, tt) in if got == "" or got == exp then Nil else Cons(cs_mkdiag("T2002", "typecheck", "type error: function '" + nm + "' returns " + got + " but is declared to return " + exp, "change return type of '" + nm + "' to " + got + " or return a " + exp + " value"), Nil)
    _           => Nil

fn cs_chk_quote(e, tt) = match e
    Bin(op, a, b)   => cs_app(cs_chk_quote(a, tt), cs_chk_quote(b, tt))
    If(c, t, e2)    => cs_app(cs_chk_quote(c, tt), cs_app(cs_chk_quote(t, tt), cs_chk_quote(e2, tt)))
    LetIn(nm, v, b) => cs_app(cs_chk_quote(v, tt), cs_chk_quote(b, tt))
    Call(nm, args)  => if nm == "unquote" then (if cs_len(args) != 1 then Cons(cs_mkdiag("C1001", "comptime", "comptime error: 'unquote' expects exactly 1 argument", "pass a single expression to 'unquote(<expr>)'"), Nil) else cs_chk_expr(cs_asthead(args), tt)) else cs_chk_qlist(args, tt)
    _               => Nil
fn cs_chk_qlist(xs, tt) = match xs
    Nil        => Nil
    Cons(h, t) => cs_app(cs_chk_quote(h, tt), cs_chk_qlist(t, tt))

fn cs_asthead(xs) = match xs
    Nil        => Num(0)
    Cons(h, t) => h

fn cs_chk_expr(e, tt) = match e
    Var(nm)                 => if cs_isupper(at(nm, 0)) then cs_chk_ctor(nm, 0, tt) else Nil
    Bin(op, a, b)           => cs_app(cs_chk_expr(a, tt), cs_chk_expr(b, tt))
    If(c, t, e2)            => cs_app(cs_chk_expr(c, tt), cs_app(cs_chk_expr(t, tt), cs_chk_expr(e2, tt)))
    LetIn(nm, v, b)         => let vty = cs_exprty(v, tt) in let tt2 = if vty != "" then {ctors: tt.ctors, recs: tt.recs, sigs: tt.sigs, gsigs: tt.gsigs, decl: tt.decl, ft: tt.ft, lenv: Cons({k: nm, v: vty}, tt.lenv)} else tt in cs_app(cs_chk_expr(v, tt), cs_chk_expr(b, tt2))
    VarIn(nm, v, b)         => let vty = cs_exprty(v, tt) in let tt2 = if vty != "" then {ctors: tt.ctors, recs: tt.recs, sigs: tt.sigs, gsigs: tt.gsigs, decl: tt.decl, ft: tt.ft, lenv: Cons({k: nm, v: vty}, tt.lenv)} else tt in cs_app(cs_chk_expr(v, tt), cs_chk_expr(b, tt2))
    ShardE(iv, lo, hi, b)   => cs_app(cs_chk_expr(lo, tt), cs_app(cs_chk_expr(hi, tt), cs_chk_expr(b, tt)))
    Call(nm, args)          => if nm == "unquote" and cs_isnil(cs_fnlookup("unquote", tt.ft)) == 1 then Cons(cs_mkdiag("C1001", "comptime", "comptime error: 'unquote' may only appear inside 'quote(...)'", "wrap the expression in 'quote(...)' or remove 'unquote'"), cs_chk_elist(args, tt)) else cs_app(if cs_isupper(at(nm, 0)) then cs_chk_ctor(nm, cs_len(args), tt) else cs_chk_callsig(nm, args, tt), cs_chk_elist(args, tt))
    Rec(items)      => cs_chk_reclist(items, tt)
    RecT(tn, items) => cs_chk_rect(tn, items, tt)
    Field(o, nm)    => cs_chk_expr(o, tt)
    Match(sc, arms) => cs_app(cs_chk_expr(sc, tt), cs_chk_arms(arms, tt))
    CT(inner)       => cs_app(cs_chk_expr(inner, tt), cs_chk_ct(inner, tt))
    Quote(inner)    => cs_chk_quote(inner, tt)
    Splice(inner)   => cs_app(cs_chk_expr(inner, tt), cs_chk_splice(inner, tt))
    _               => Nil
fn cs_chk_elist(xs, tt) = match xs
    Nil        => Nil
    Cons(h, t) => cs_app(cs_chk_expr(h, tt), cs_chk_elist(t, tt))
fn cs_chk_reclist(xs, tt) = match xs
    Nil        => Nil
    Cons(h, t) => cs_app(cs_chk_expr(h.val, tt), cs_chk_reclist(t, tt))
fn cs_chk_arms(xs, tt) = match xs
    Nil        => Nil
    Cons(h, t) => cs_app(cs_chk_pat(h.pat, tt), cs_app(cs_chk_expr(h.body, tt), cs_chk_arms(t, tt)))
fn cs_chk_pat(p, tt) = match p
    PCons(tag, ps) => cs_chk_ctor(tag, cs_len(ps), tt)
    _              => Nil

## --- safe non-aborting comptime & AST evaluator for `caas` ---
fn cs_cv_ok(v) = {ok: 1, v: v, err: "", fix: ""}
fn cs_cv_err(msg, fix) = {ok: 0, v: {kind: "int", i: 0, s: "", items: Nil}, err: msg, fix: fix}
fn cs_cv_int(n) = {kind: "int", i: n, s: "", items: Nil}
fn cs_cv_str(s) = {kind: "str", i: 0, s: s, items: Nil}
fn cs_cv_ctor(tag, xs) = {kind: "ctor", i: 0, s: tag, items: xs}
fn cs_cv_rec(xs) = {kind: "rec", i: 0, s: "", items: xs}

fn cs_cveq(a, b) = if a.kind != b.kind then 0 else if a.kind == "int" then a.i == b.i else if a.kind == "str" then a.s == b.s else if a.kind == "ctor" then (if a.s != b.s then 0 else cs_cveqlist(a.items, b.items)) else 0
fn cs_cveqlist(xs, ys) = match xs
    Nil          => cs_isnil(ys)
    Cons(xh, xt) => cs_cveqlist2(xh, xt, ys)
fn cs_cveqlist2(xh, xt, ys) = match ys
    Nil          => 0
    Cons(yh, yt) => if cs_cveq(xh, yh) == 1 then cs_cveqlist(xt, yt) else 0

fn cs_envlookup(nm, env) = match env
    Nil        => {ok: 0, v: cs_cv_int(0)}
    Cons(h, t) => if h.k == nm then {ok: 1, v: h.v} else cs_envlookup(nm, t)
fn cs_qvar(nm, qenv) = match qenv
    Nil        => nm
    Cons(h, t) => if h.k == nm then h.v else cs_qvar(nm, t)

fn cs_isvalidbinop(op) = op == "+" or op == "-" or op == "*" or op == "/" or op == "%" or op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or"
fn cs_cvhd(xs) = match xs
    Nil        => cs_cv_int(0)
    Cons(h, t) => h
fn cs_cvtl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t

fn cs_unreify(cv) = if cv.kind != "ctor" then {ok: 0, node: Num(0), err: "comptime error: splice expects an AST constructor value (Num, Str, Var, Bin, If, LetIn, Call)", fix: "pass a quoted or constructed AST value to 'splice(...)'"} else cs_unreify_ctor(cv.s, cv.items)
fn cs_unreify_ctor(tag, xs) = if tag == "Num" and cs_len(xs) == 1 and (cs_cvhd(xs)).kind == "int" then {ok: 1, node: Num((cs_cvhd(xs)).i), err: "", fix: ""} else if tag == "Str" and cs_len(xs) == 1 and (cs_cvhd(xs)).kind == "str" then {ok: 1, node: Str((cs_cvhd(xs)).s), err: "", fix: ""} else if tag == "Var" and cs_len(xs) == 1 and (cs_cvhd(xs)).kind == "str" and count((cs_cvhd(xs)).s) > 0 then {ok: 1, node: Var((cs_cvhd(xs)).s), err: "", fix: ""} else if tag == "Bin" and cs_len(xs) == 3 and (cs_cvhd(xs)).kind == "str" and cs_isvalidbinop((cs_cvhd(xs)).s) then let l = cs_unreify(cs_cvhd(cs_cvtl(xs))) in (if l.ok == 0 then l else let r = cs_unreify(cs_cvhd(cs_cvtl(cs_cvtl(xs)))) in if r.ok == 0 then r else {ok: 1, node: Bin((cs_cvhd(xs)).s, l.node, r.node), err: "", fix: ""}) else if tag == "If" and cs_len(xs) == 3 then let c = cs_unreify(cs_cvhd(xs)) in (if c.ok == 0 then c else let t = cs_unreify(cs_cvhd(cs_cvtl(xs))) in if t.ok == 0 then t else let e2 = cs_unreify(cs_cvhd(cs_cvtl(cs_cvtl(xs)))) in if e2.ok == 0 then e2 else {ok: 1, node: If(c.node, t.node, e2.node), err: "", fix: ""}) else if tag == "LetIn" and cs_len(xs) == 3 and (cs_cvhd(xs)).kind == "str" and count((cs_cvhd(xs)).s) > 0 then let v = cs_unreify(cs_cvhd(cs_cvtl(xs))) in (if v.ok == 0 then v else let b = cs_unreify(cs_cvhd(cs_cvtl(cs_cvtl(xs)))) in if b.ok == 0 then b else {ok: 1, node: LetIn((cs_cvhd(xs)).s, v.node, b.node), err: "", fix: ""}) else if tag == "Call" and cs_len(xs) == 2 and (cs_cvhd(xs)).kind == "str" and count((cs_cvhd(xs)).s) > 0 then let rl = cs_unreify_list(cs_cvhd(cs_cvtl(xs))) in (if rl.ok == 0 then {ok: 0, node: Num(0), err: rl.err, fix: rl.fix} else {ok: 1, node: Call((cs_cvhd(xs)).s, rl.items), err: "", fix: ""}) else {ok: 0, node: Num(0), err: "comptime error: invalid AST node '" + tag + "' in splice", fix: "use valid AST constructors (Num, Str, Var, Bin, If, LetIn, Call) and operators"}
fn cs_unreify_list(cv) = if cv.kind != "ctor" then {ok: 0, items: Nil, err: "comptime error: Call arguments in splice must be a Cons/Nil list", fix: "build Call argument lists with Cons and Nil"} else if cv.s == "Nil" and cs_len(cv.items) == 0 then {ok: 1, items: Nil, err: "", fix: ""} else if cv.s == "Cons" and cs_len(cv.items) == 2 then let h = cs_unreify(cs_cvhd(cv.items)) in (if h.ok == 0 then {ok: 0, items: Nil, err: h.err, fix: h.fix} else let t = cs_unreify_list(cs_cvhd(cs_cvtl(cv.items))) in if t.ok == 0 then t else {ok: 1, items: Cons(h.node, t.items), err: "", fix: ""}) else {ok: 0, items: Nil, err: "comptime error: Call arguments in splice must be a Cons/Nil list", fix: "build Call argument lists with Cons and Nil"}

fn cs_qunquote(cv) = if cv.kind == "int" then cs_cv_ok(cs_cv_ctor("Num", Cons(cv, Nil))) else if cv.kind == "str" then cs_cv_ok(cs_cv_ctor("Str", Cons(cv, Nil))) else if cv.kind == "ctor" then cs_cv_ok(cv) else cs_cv_err("comptime error: unquote expects an AST, int, or str value", "pass an AST constructor, int, or str to 'unquote'")

fn cs_quasiquote(e, qenv, env, ft, cd) = match e
    Num(n)          => cs_cv_ok(cs_cv_ctor("Num", Cons(cs_cv_int(n), Nil)))
    Str(v)          => cs_cv_ok(cs_cv_ctor("Str", Cons(cs_cv_str(v), Nil)))
    Var(nm)         => cs_cv_ok(cs_cv_ctor("Var", Cons(cs_cv_str(cs_qvar(nm, qenv)), Nil)))
    Bin(op, a, b)   => let ra = cs_quasiquote(a, qenv, env, ft, cd) in if ra.ok == 0 then ra else let rb = cs_quasiquote(b, qenv, env, ft, cd) in if rb.ok == 0 then rb else cs_cv_ok(cs_cv_ctor("Bin", Cons(cs_cv_str(op), Cons(ra.v, Cons(rb.v, Nil)))))
    If(c, t, e2)    => let rc = cs_quasiquote(c, qenv, env, ft, cd) in if rc.ok == 0 then rc else let rt = cs_quasiquote(t, qenv, env, ft, cd) in if rt.ok == 0 then rt else let re = cs_quasiquote(e2, qenv, env, ft, cd) in if re.ok == 0 then re else cs_cv_ok(cs_cv_ctor("If", Cons(rc.v, Cons(rt.v, Cons(re.v, Nil)))))
    LetIn(nm, v, b) => let rv = cs_quasiquote(v, qenv, env, ft, cd) in if rv.ok == 0 then rv else let hnm = "_hyg_" + str(cd + 1) + "_" + nm in let rb = cs_quasiquote(b, Cons({k: nm, v: hnm}, qenv), env, ft, cd + 1) in if rb.ok == 0 then rb else cs_cv_ok(cs_cv_ctor("LetIn", Cons(cs_cv_str(hnm), Cons(rv.v, Cons(rb.v, Nil)))))
    Call(nm, args)  => if nm == "unquote" then (if cs_len(args) != 1 then cs_cv_err("comptime error: 'unquote' expects exactly 1 argument", "pass a single argument to 'unquote(<expr>)'") else let r = cs_ceval(cs_asthead(args), env, ft, cd) in if r.ok == 0 then r else cs_qunquote(r.v)) else let rl = cs_qqlist(args, qenv, env, ft, cd) in if rl.ok == 0 then rl else cs_cv_ok(cs_cv_ctor("Call", Cons(cs_cv_str(nm), Cons(rl.v, Nil))))
    _               => cs_cv_err("comptime error: unsupported AST node in quote", "use supported expressions inside 'quote(...)'")
fn cs_qqlist(xs, qenv, env, ft, cd) = match xs
    Nil        => cs_cv_ok(cs_cv_ctor("Nil", Nil))
    Cons(h, t) => let rh = cs_quasiquote(h, qenv, env, ft, cd) in if rh.ok == 0 then rh else let rt = cs_qqlist(t, qenv, env, ft, cd) in if rt.ok == 0 then rt else cs_cv_ok(cs_cv_ctor("Cons", Cons(rh.v, Cons(rt.v, Nil))))

fn cs_cmatch(sv, arms, env, ft, cd) = match arms
    Nil        => cs_cv_err("comptime error: non-exhaustive match at compile time", "add a wildcard '_' arm to match")
    Cons(h, t) => let m = cs_cpat(h.pat, sv, env) in if m.ok == 1 then cs_ceval(h.body, m.env, ft, cd) else cs_cmatch(sv, t, env, ft, cd)
fn cs_cpat(p, sv, env) = match p
    PWild          => {ok: 1, env: env}
    PBind(nm)      => {ok: 1, env: Cons({k: nm, v: sv}, env)}
    PInt(n)        => if sv.kind == "int" and sv.i == n then {ok: 1, env: env} else {ok: 0, env: env}
    PStr(s)        => if sv.kind == "str" and sv.s == s then {ok: 1, env: env} else {ok: 0, env: env}
    PCons(tag, ps) => if sv.kind == "ctor" and sv.s == tag and cs_len(ps) == cs_len(sv.items) then cs_cpatargs(ps, sv.items, env) else {ok: 0, env: env}
fn cs_cpatargs(ps, vs, env) = match ps
    Nil          => {ok: 1, env: env}
    Cons(p, pr)  => cs_cpatargs2(p, pr, vs, env)
fn cs_cpatargs2(p, pr, vs, env) = match vs
    Nil         => {ok: 0, env: env}
    Cons(v, vr) => cs_cpatargs(pr, vr, if p == "_" then env else Cons({k: p, v: v}, env))

fn cs_recfield(items, nm) = match items
    Nil        => cs_cv_err("comptime error: unknown record field '" + nm + "'", "check field name '" + nm + "'")
    Cons(h, t) => if h.key == nm then cs_cv_ok(h.val) else cs_recfield(t, nm)

fn cs_vsubst_hop(e, ps, env) = match e
    Var(nm)         => if cs_omem(nm, ps) == 1 then e else let lk = cs_envlookup(nm, env) in if lk.ok == 1 then cs_ctnode(lk.v) else e
    Bin(op, a, b)   => Bin(op, cs_vsubst_hop(a, ps, env), cs_vsubst_hop(b, ps, env))
    If(c, t, e2)    => If(cs_vsubst_hop(c, ps, env), cs_vsubst_hop(t, ps, env), cs_vsubst_hop(e2, ps, env))
    LetIn(nm, v, b) => LetIn(nm, cs_vsubst_hop(v, ps, env), cs_vsubst_hop(b, Cons(nm, ps), env))
    VarIn(nm, v, b) => VarIn(nm, cs_vsubst_hop(v, ps, env), cs_vsubst_hop(b, Cons(nm, ps), env))
    Call(nm, args)  => Call(nm, cs_vsubst_hop_args(args, ps, env))
    _               => e
fn cs_vsubst_hop_args(xs, ps, env) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_vsubst_hop(h, ps, env), cs_vsubst_hop_args(t, ps, env))
fn cs_vadd_hops_ft(hs, env, ft) = match hs
    Nil        => ft
    Cons(h, t) => Cons(Fn(h.op, h.ps, cs_vsubst_hop(h.body, h.ps, env)), cs_vadd_hops_ft(t, env, ft))

fn cs_ceval(e, env, ft, cd) = if cd > 64 then cs_cv_err("comptime error: comptime evaluation exceeded 64 call levels", "ensure comptime recursion has a terminating base case") else cs_ceval1(e, env, ft, cd)
fn cs_ceval1(e, env, ft, cd) = match e
    Num(n)                  => cs_cv_ok(cs_cv_int(n))
    Str(v)                  => cs_cv_ok(cs_cv_str(v))
    Var(nm)                 => let lk = cs_envlookup(nm, env) in if lk.ok == 1 then cs_cv_ok(lk.v) else if cs_isupper(at(nm, 0)) then cs_cv_ok(cs_cv_ctor(nm, Nil)) else cs_cv_err("comptime error: unbound variable '" + nm + "'", "bind '" + nm + "' before use")
    LetIn(nm, v, b)         => let rv = cs_ceval(v, env, ft, cd) in if rv.ok == 0 then rv else cs_ceval(b, Cons({k: nm, v: rv.v}, env), ft, cd)
    VarIn(nm, v, b)         => let rv = cs_ceval(v, env, ft, cd) in if rv.ok == 0 then rv else cs_ceval(b, Cons({k: nm, v: rv.v}, env), ft, cd)
    OwnE(inner)             => cs_ceval(inner, env, ft, cd)
    MutE(inner)             => cs_ceval(inner, env, ft, cd)
    WithHandlerE(en, hs, b) => cs_ceval(b, env, cs_vadd_hops_ft(hs, env, ft), cd)
    ScopeE(snm, b)          => cs_ceval(b, Cons({k: snm, v: cs_cv_int(1)}, env), ft, cd)
    SpawnE(inner)           => cs_ceval(inner, env, ft, cd)
    If(c, t, e2)            => let rc = cs_ceval(c, env, ft, cd) in if rc.ok == 0 then rc else if rc.v.i != 0 then cs_ceval(t, env, ft, cd) else cs_ceval(e2, env, ft, cd)
    Bin(op, a, b)           => let ra = cs_ceval(a, env, ft, cd) in if ra.ok == 0 then ra else let rb = cs_ceval(b, env, ft, cd) in if rb.ok == 0 then rb else cs_cbin(op, ra.v, rb.v)
    Match(sc, arms)         => let rsc = cs_ceval(sc, env, ft, cd) in if rsc.ok == 0 then rsc else cs_cmatch(rsc.v, arms, env, ft, cd)
    Quote(inner)            => cs_quasiquote(inner, Nil, env, ft, cd)
    Splice(inner)           => let r = cs_ceval(inner, env, ft, cd) in if r.ok == 0 then r else let u = cs_unreify(r.v) in if u.ok == 0 then cs_cv_err(u.err, u.fix) else cs_ceval(u.node, env, ft, cd)
    CT(inner)               => cs_ceval(inner, env, ft, cd)
    Rec(items)              => cs_ceval_rec(items, env, ft, cd)
    RecT(tn, items)         => cs_ceval_rec(items, env, ft, cd)
    Field(o, nm)            => let ro = cs_ceval(o, env, ft, cd) in if ro.ok == 0 then ro else if ro.v.kind == "rec" then cs_recfield(ro.v.items, nm) else cs_cv_err("comptime error: field access on non-record value", "access fields only on record values")
    Call(nm, args)          => if cs_isupper(at(nm, 0)) then let ra = cs_ceval_list(args, env, ft, cd) in (if ra.ok == 0 then cs_cv_err(ra.err, ra.fix) else cs_cv_ok(cs_cv_ctor(nm, ra.vals))) else cs_ccall(nm, args, env, ft, cd)
    _                       => cs_cv_err("comptime error: unsupported expression at compile time", "use pure expressions in comptime")
fn cs_ceval_rec(items, env, ft, cd) = match items
    Nil        => cs_cv_ok(cs_cv_rec(Nil))
    Cons(h, t) => let rv = cs_ceval(h.val, env, ft, cd) in if rv.ok == 0 then rv else let rt = cs_ceval_rec(t, env, ft, cd) in if rt.ok == 0 then rt else cs_cv_ok(cs_cv_rec(Cons({key: h.key, val: rv.v}, rt.v.items)))
fn cs_ceval_list(xs, env, ft, cd) = match xs
    Nil        => {ok: 1, vals: Nil, err: "", fix: ""}
    Cons(h, t) => let rh = cs_ceval(h, env, ft, cd) in if rh.ok == 0 then {ok: 0, vals: Nil, err: rh.err, fix: rh.fix} else let rt = cs_ceval_list(t, env, ft, cd) in if rt.ok == 0 then rt else {ok: 1, vals: Cons(rh.v, rt.vals), err: "", fix: ""}
fn cs_cbin_str(op, x, y) = if op == "+" then cs_cv_ok(cs_cv_str(x + y)) else if op == "<" then cs_cv_ok(cs_cv_int(if x < y then 1 else 0)) else if op == ">" then cs_cv_ok(cs_cv_int(if x > y then 1 else 0)) else if op == "<=" then cs_cv_ok(cs_cv_int(if x <= y then 1 else 0)) else if op == ">=" then cs_cv_ok(cs_cv_int(if x >= y then 1 else 0)) else cs_cv_err("comptime error: unknown string operator '" + op + "'", "use a valid string operator")
fn cs_cbin(op, l, r) = if op == "==" then cs_cv_ok(cs_cv_int(cs_cveq(l, r))) else if op == "!=" then cs_cv_ok(cs_cv_int(if cs_cveq(l, r) == 1 then 0 else 1)) else if l.kind == "str" and r.kind == "str" then cs_cbin_str(op, l.s, r.s) else if l.kind == "int" and r.kind == "int" then cs_cbin_int(op, l.i, r.i) else cs_cv_err("comptime error: type mismatch in operator '" + op + "'", "use matching operand types for '" + op + "'")
fn cs_cbin_int(op, x, y) = if op == "+" then cs_cv_ok(cs_cv_int(x + y)) else if op == "-" then cs_cv_ok(cs_cv_int(x - y)) else if op == "*" then cs_cv_ok(cs_cv_int(x * y)) else if op == "/" then (if y == 0 then cs_cv_err("comptime error: division by zero at compile time", "ensure divisor is non-zero") else cs_cv_ok(cs_cv_int(x / y))) else if op == "%" then (if y == 0 then cs_cv_err("comptime error: modulo by zero at compile time", "ensure modulus is non-zero") else cs_cv_ok(cs_cv_int(x % y))) else if op == "<" then cs_cv_ok(cs_cv_int(x < y)) else if op == ">" then cs_cv_ok(cs_cv_int(x > y)) else if op == "<=" then cs_cv_ok(cs_cv_int(x <= y)) else if op == ">=" then cs_cv_ok(cs_cv_int(x >= y)) else if op == "and" then cs_cv_ok(cs_cv_int(if x != 0 then (if y != 0 then 1 else 0) else 0)) else if op == "or" then cs_cv_ok(cs_cv_int(if x != 0 then 1 else if y != 0 then 1 else 0)) else cs_cv_err("comptime error: unknown operator '" + op + "'", "use a valid operator")

fn cs_cbind(ps, vals, env) = match ps
    Nil         => env
    Cons(p, pt) => cs_cbind2(p, pt, vals, env)
fn cs_cbind2(p, pt, vals, env) = match vals
    Nil         => env
    Cons(v, vt) => cs_cbind(pt, vt, Cons({k: p, v: v}, env))
fn cs_cquant_var(e) = match e
    Var(nm) => nm
    Str(s)  => s
    _       => ""
fn cs_cforall_loop(vnm, k, hi, pred, env, ft) = if k > hi then cs_cv_ok(cs_cv_int(1)) else let r = cs_ceval(pred, Cons({k: vnm, v: cs_cv_int(k)}, env), ft, 0) in if r.ok == 0 then r else if r.v.i == 0 then cs_cv_ok(cs_cv_int(0)) else cs_cforall_loop(vnm, k + 1, hi, pred, env, ft)
fn cs_cexists_loop(vnm, k, hi, pred, env, ft) = if k > hi then cs_cv_ok(cs_cv_int(0)) else let r = cs_ceval(pred, Cons({k: vnm, v: cs_cv_int(k)}, env), ft, 0) in if r.ok == 0 then r else if r.v.i != 0 then cs_cv_ok(cs_cv_int(1)) else cs_cexists_loop(vnm, k + 1, hi, pred, env, ft)
fn cs_is_cbv_builtin(nm) = nm == "bv_and" or nm == "bit_and" or nm == "bv_or" or nm == "bit_or" or nm == "bv_xor" or nm == "bit_xor" or nm == "bv_shl" or nm == "bit_shl" or nm == "bv_shr" or nm == "bit_shr" or nm == "bv_u8" or nm == "bv_not_u8" or nm == "bv_add_u8" or nm == "bv_sub_u8" or nm == "bv_mul_u8"
fn cs_cpure_bv(nm, vs) = let a = (cs_cvhd(vs)).i in if nm == "bv_u8" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_int(cs_vbv_mod(a, 256))) else if nm == "bv_not_u8" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_int(255 - cs_vbv_mod(a, 256))) else if cs_len(vs) == 2 then (let b = (cs_cvhd(cs_cvtl(vs))).i in if nm == "bv_and" or nm == "bit_and" then cs_cv_ok(cs_cv_int(cs_vbv_and(cs_vbv_mod(a, 65536), cs_vbv_mod(b, 65536), 16))) else if nm == "bv_or" or nm == "bit_or" then cs_cv_ok(cs_cv_int(cs_vbv_or(cs_vbv_mod(a, 65536), cs_vbv_mod(b, 65536), 16))) else if nm == "bv_xor" or nm == "bit_xor" then cs_cv_ok(cs_cv_int(cs_vbv_xor(cs_vbv_mod(a, 65536), cs_vbv_mod(b, 65536), 16))) else if nm == "bv_shl" or nm == "bit_shl" then cs_cv_ok(cs_cv_int(a * cs_vbv_pow2(b))) else if nm == "bv_shr" or nm == "bit_shr" then cs_cv_ok(cs_cv_int(a / cs_vbv_pow2(b))) else if nm == "bv_add_u8" then cs_cv_ok(cs_cv_int(cs_vbv_mod(a + b, 256))) else if nm == "bv_sub_u8" then cs_cv_ok(cs_cv_int(cs_vbv_mod(a - b, 256))) else cs_cv_ok(cs_cv_int(cs_vbv_mod(a * b, 256)))) else cs_cv_err("comptime error: invalid arguments to builtin '" + nm + "'", "check argument count")
fn cs_ccall(nm, args, env, ft, cd) = if (nm == "forall_range" or nm == "exists_range") and cs_len(args) == 4 then (let vnm = cs_cquant_var(cs_asthead(args)) in let rlo = cs_ceval(cs_astsecond(args), env, ft, cd) in let rhi = cs_ceval(cs_asthead(cs_cvtl(cs_cvtl(args))), env, ft, cd) in if vnm == "" or rlo.ok == 0 or rhi.ok == 0 then cs_cv_err("comptime error: invalid quantifier bounds", "") else let pred = cs_asthead(cs_cvtl(cs_cvtl(cs_cvtl(args)))) in if nm == "forall_range" then cs_cforall_loop(vnm, rlo.v.i, rhi.v.i, pred, env, ft) else cs_cexists_loop(vnm, rlo.v.i, rhi.v.i, pred, env, ft)) else cs_ccall2(nm, cs_fnlookup(nm, ft), args, env, ft, cd)
fn cs_ccall2(nm, mf, args, env, ft, cd) = match mf
    Cons(fn0, rr) => let ra = cs_ceval_list(args, env, ft, cd) in if ra.ok == 0 then cs_cv_err(ra.err, ra.fix) else cs_ccall3(fn0, ra.vals, ft, cd)
    Nil           => if nm == "str" or nm == "count" or nm == "at" or nm == "slice" or nm == "toint" or nm == "ord" or nm == "fs_write_sync" or nm == "fs_append_sync" or nm == "fs_read_file" or cs_is_cbv_builtin(nm) == 1 then let ra = cs_ceval_list(args, env, ft, cd) in (if ra.ok == 0 then cs_cv_err(ra.err, ra.fix) else if cs_is_cbv_builtin(nm) == 1 then cs_cpure_bv(nm, ra.vals) else cs_cpure(nm, ra.vals)) else cs_cv_err("comptime error: cannot evaluate '" + nm + "' at compile time: not pure", "remove impure call '" + nm + "' from comptime or define pure 'fn " + nm + "'")
fn cs_ccall3(fn0, vals, ft, cd) = match fn0
    Fn(fnm, ps, body) => cs_ceval(body, cs_cbind(ps, vals, Nil), ft, cd + 1)
    _                 => cs_cv_err("comptime error: invalid function", "")
fn cs_cpure(nm, vs) = if nm == "str" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_str(if (cs_cvhd(vs)).kind == "int" then str((cs_cvhd(vs)).i) else (cs_cvhd(vs)).s)) else if nm == "count" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_int(count((cs_cvhd(vs)).s))) else if nm == "toint" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_int(toint((cs_cvhd(vs)).s))) else if nm == "ord" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_int(ord((cs_cvhd(vs)).s))) else if nm == "at" and cs_len(vs) == 2 then cs_cv_ok(cs_cv_str(at((cs_cvhd(vs)).s, (cs_cvhd(cs_cvtl(vs))).i))) else if nm == "slice" and cs_len(vs) == 3 then cs_cv_ok(cs_cv_str(slice((cs_cvhd(vs)).s, (cs_cvhd(cs_cvtl(vs))).i, (cs_cvhd(cs_cvtl(cs_cvtl(vs)))).i))) else if nm == "fs_write_sync" and cs_len(vs) == 2 then cs_cv_ok(cs_cv_int(fs_write_sync((cs_cvhd(vs)).s, (cs_cvhd(cs_cvtl(vs))).s))) else if nm == "fs_append_sync" and cs_len(vs) == 2 then cs_cv_ok(cs_cv_int(fs_append_sync((cs_cvhd(vs)).s, (cs_cvhd(cs_cvtl(vs))).s))) else if nm == "fs_read_file" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_str(fs_read_file((cs_cvhd(vs)).s))) else cs_cv_err("comptime error: invalid arguments to builtin '" + nm + "'", "check argument types and count for '" + nm + "'")

fn cs_chk_ct(inner, tt) = let r = cs_ceval(inner, Nil, tt.ft, 0) in if r.ok == 1 then Nil else Cons(cs_mkdiag("C1001", "comptime", r.err, r.fix), Nil)
fn cs_chk_splice(inner, tt) = let r = cs_ceval(inner, Nil, tt.ft, 0) in if r.ok == 0 then Cons(cs_mkdiag("C1001", "comptime", r.err, r.fix), Nil) else let u = cs_unreify(r.v) in if u.ok == 0 then Cons(cs_mkdiag("C1001", "comptime", u.err, u.fix), Nil) else cs_chk_expr(u.node, tt)

## --- Phase 3 Track O non-aborting multi-diagnostic checker for `caas` (`O0001`–`O0030`) ---
fn cs_omem(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else cs_omem(x, t)
fn cs_orem(x, xs) = match xs
    Nil        => Nil
    Cons(h, t) => if h == x then cs_orem(x, t) else Cons(h, cs_orem(x, t))
fn cs_ocollects(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_ocollects1(h, cs_ocollects(t))
fn cs_ocollects1(st, rest) = match st
    OSig(nm, pubf, freef, pl, rty, fromp) => Cons({nm: nm, pubf: pubf, freef: freef, pl: pl, rty: rty, fromp: fromp}, rest)
    _                                     => rest
fn cs_p35_has_test(nm, prog) = match prog
    Nil        => 0
    Cons(h, t) => if cs_p35_has_test_stmt(h, nm) == 1 then 1 else cs_p35_has_test(nm, t)
fn cs_p35_has_test_stmt(st, nm) = match st
    Fn(test_nm, ps, body) => if test_nm == "test_" + nm and cs_isnil(ps) == 1 then 1 else 0
    _                     => 0
fn cs_p35_diags(osigs, prog) = match osigs
    Nil        => Nil
    Cons(h, t) => if h.pubf == 1 and cs_p35_has_test(h.nm, prog) == 0 then Cons(cs_mkwarn("P35", "test_coverage", "public function '" + h.nm + "' has no associated test; add 'fn test_" + h.nm + "()'", "add a 'test_" + h.nm + "' function that exercises the public API"), cs_p35_diags(t, prog)) else cs_p35_diags(t, prog)
fn cs_osiglookup(nm, osigs) = match osigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else cs_osiglookup(nm, t)
fn cs_obparams(pl) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 0 or p.cf == 3 then Cons(p.pn, cs_obparams(r)) else cs_obparams(r)
fn cs_omvars(pl) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 2 or p.cf == 3 then Cons(p.pn, cs_omvars(r)) else cs_omvars(r)
fn cs_oinit_orgs(ps) = match ps
    Nil        => Nil
    Cons(h, t) => Cons({k: h, v: "param:" + h}, cs_oinit_orgs(t))
fn cs_olookup_org(x, orgs) = match orgs
    Nil        => ""
    Cons(h, t) => if h.k == x then h.v else cs_olookup_org(x, t)
fn cs_ostrip_b(org) = if cs_startswith(org, "borrow:") == 1 then cs_ostrip_b(slice(org, 7, count(org))) else org
fn cs_ois_own(e) = match e
    OwnE(inner)    => 1
    Call(nm, args) => if nm == "move" and cs_len(args) == 1 then 1 else 0
    _              => 0
fn cs_omut_root(e) = match e
    Var(x)        => x
    MutE(inner)   => cs_omut_root(inner)
    Field(o, fld) => cs_omut_root(o)
    _             => ""
fn cs_ois_mut(e) = match e
    MutE(inner) => 1
    _           => 0
fn cs_omentions(x, e) = match e
    Var(nm)         => if nm == x then 1 else 0
    OwnE(inner)     => cs_omentions(x, inner)
    MutE(inner)     => cs_omentions(x, inner)
    Field(o, fld)   => cs_omentions(x, o)
    Bin(op, l, r)   => if cs_omentions(x, l) == 1 then 1 else cs_omentions(x, r)
    If(c, t, e2)    => if cs_omentions(x, c) == 1 then 1 else if cs_omentions(x, t) == 1 then 1 else cs_omentions(x, e2)
    LetIn(nm, v, b) => if cs_omentions(x, v) == 1 then 1 else if nm == x then 0 else cs_omentions(x, b)
    VarIn(nm, v, b) => if cs_omentions(x, v) == 1 then 1 else if nm == x then 0 else cs_omentions(x, b)
    Call(nm, args)  => cs_omentions_l(x, args)
    _               => 0
fn cs_omentions_l(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if cs_omentions(x, h) == 1 then 1 else cs_omentions_l(x, t)
fn cs_ocount_args(x, args) = match args
    Nil        => 0
    Cons(h, t) => cs_omentions(x, h) + cs_ocount_args(x, t)
fn cs_opl_cf(pl) = match pl
    Nil        => 0
    Cons(p, r) => p.cf
fn cs_opl_tl(pl) = match pl
    Nil        => Nil
    Cons(p, r) => r
fn cs_ocollect_muts(args, pl) = match args
    Nil        => Nil
    Cons(a, r) => let rest = cs_ocollect_muts(r, cs_opl_tl(pl)) in if cs_ois_mut(a) == 1 or cs_opl_cf(pl) == 3 then let mr = cs_omut_root(a) in (if mr != "" then Cons(mr, rest) else rest) else rest
fn cs_ochk_conf(fnm, muts, args) = match muts
    Nil         => Nil
    Cons(mx, r) => if cs_ocount_args(mx, args) > 1 then Cons(cs_mkdiag("O0011", "borrow", "borrow error: conflicting borrow of '" + mx + "' in call to '" + fnm + "'", "bind the shared read of '" + mx + "' to a temporary before borrowing 'mut " + mx + "'"), cs_ochk_conf(fnm, r, args)) else cs_ochk_conf(fnm, r, args)
fn cs_ochk_modes(fnm, args, pl, ctx) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 1 then cs_ochk_modes(fnm, args, r, ctx) else cs_ochk_mode1(fnm, args, p, r, ctx)
fn cs_ochk_mode1(fnm, args, p, r, ctx) = match args
    Nil         => Nil
    Cons(a, ar) => let d1 = if p.cf == 2 and cs_ois_own(a) == 0 then Cons(cs_mkdiag("O0012", "ownership", "ownership error: parameter '" + p.pn + "' of '" + fnm + "' takes ownership; mark argument with 'own'", "prefix argument with 'own' at call site"), Nil) else if p.cf == 3 then (let vnm = cs_omut_root(a) in if vnm != "" and cs_omem(vnm, ctx.mvars) == 0 then Cons(cs_mkdiag("O0010", "borrow", "borrow error: cannot pass immutable binding '" + vnm + "' to 'mut' parameter '" + p.pn + "'", "declare 'var " + vnm + "' instead of 'let " + vnm + "'"), Nil) else Nil) else Nil in cs_app(d1, cs_ochk_modes(fnm, ar, r, ctx))
fn cs_ochk_own_tgt(inner, ctx, moved) = match inner
    Var(x) => if cs_omem(x, moved) == 1 then {diags: Cons(cs_mkdiag("O0001", "ownership", "ownership error: use of moved value '" + x + "'", "borrow '" + x + "' instead or call 'clone(" + x + ")'"), Nil), moved: moved, origin: ""} else if cs_omem(x, ctx.bparams) == 1 then {diags: Cons(cs_mkdiag("O0002", "ownership", "ownership error: cannot move out of borrowed parameter '" + x + "'", "change parameter declaration to 'own " + x + "' or call 'clone(" + x + ")'"), Nil), moved: moved, origin: ""} else {diags: Nil, moved: Cons(x, moved), origin: ""}
    _      => cs_ochke(inner, ctx, moved)
fn cs_ochk_mut_tgt(inner, ctx, moved) = match inner
    Var(x) => if cs_omem(x, moved) == 1 then {diags: Cons(cs_mkdiag("O0001", "ownership", "ownership error: use of moved value '" + x + "'", "borrow '" + x + "' instead or call 'clone(" + x + ")'"), Nil), moved: moved, origin: ""} else if cs_omem(x, ctx.mvars) == 0 then {diags: Cons(cs_mkdiag("O0010", "borrow", "borrow error: cannot borrow immutable binding '" + x + "' as 'mut'", "declare 'var " + x + "' instead of 'let " + x + "'"), Nil), moved: moved, origin: ""} else {diags: Nil, moved: moved, origin: "borrow:" + cs_olookup_org(x, ctx.origins)}
    _      => cs_ochke(inner, ctx, moved)
fn cs_octx_bind(ctx, nm, ismut, org) = {fnm: ctx.fnm, pubf: ctx.pubf, freef: ctx.freef, halloc: ctx.halloc, bparams: cs_orem(nm, ctx.bparams), mvars: if ismut == 1 then Cons(nm, cs_orem(nm, ctx.mvars)) else cs_orem(nm, ctx.mvars), origins: Cons({k: nm, v: if org != "" then org else "local:" + nm}, ctx.origins), osigs: ctx.osigs}
fn cs_ochke(e, ctx, moved) = match e
    Var(x)           => if cs_omem(x, moved) == 1 then {diags: Cons(cs_mkdiag("O0001", "ownership", "ownership error: use of moved value '" + x + "'", "borrow '" + x + "' instead or call 'clone(" + x + ")'"), Nil), moved: moved, origin: ""} else {diags: Nil, moved: moved, origin: cs_olookup_org(x, ctx.origins)}
    Field(o, fld)    => cs_ochke(o, ctx, moved)
    OwnE(inner)      => cs_ochk_own_tgt(inner, ctx, moved)
    MutE(inner)      => cs_ochk_mut_tgt(inner, ctx, moved)
    LetIn(nm, v, b)  => let rv = cs_ochke(v, ctx, moved) in let rb = cs_ochke(b, cs_octx_bind(ctx, nm, 0, rv.origin), cs_orem(nm, rv.moved)) in {diags: cs_app(rv.diags, rb.diags), moved: rb.moved, origin: rb.origin}
    VarIn(nm, v, b)  => let rv = cs_ochke(v, ctx, moved) in let rb = cs_ochke(b, cs_octx_bind(ctx, nm, 1, rv.origin), cs_orem(nm, rv.moved)) in {diags: cs_app(rv.diags, rb.diags), moved: rb.moved, origin: rb.origin}
    DeferE(c, b)     => let rb = cs_ochke(b, ctx, moved) in let rc = cs_ochke(c, ctx, rb.moved) in {diags: cs_app(rb.diags, rc.diags), moved: rc.moved, origin: rb.origin}
    ErrDeferE(c, b)  => let rb = cs_ochke(b, ctx, moved) in let rc = cs_ochke(c, ctx, rb.moved) in {diags: cs_app(rb.diags, rc.diags), moved: rc.moved, origin: rb.origin}
    WithAllocE(a, b) => let ra = cs_ochke(a, ctx, moved) in let rb = cs_ochke(b, {fnm: ctx.fnm, pubf: ctx.pubf, freef: ctx.freef, halloc: 1, bparams: ctx.bparams, mvars: ctx.mvars, origins: ctx.origins, osigs: ctx.osigs}, ra.moved) in {diags: cs_app(ra.diags, rb.diags), moved: rb.moved, origin: rb.origin}
    Bin(op, l, r)    => let rl = cs_ochke(l, ctx, moved) in let rr = cs_ochke(r, ctx, rl.moved) in {diags: cs_app(rl.diags, rr.diags), moved: rr.moved, origin: ""}
    If(c, t, e2)     => let rc = cs_ochke(c, ctx, moved) in let rt = cs_ochke(t, ctx, rc.moved) in let re = cs_ochke(e2, ctx, rc.moved) in {diags: cs_app(rc.diags, cs_app(rt.diags, re.diags)), moved: cs_app(rt.moved, re.moved), origin: if rt.origin != "" then rt.origin else re.origin}
    Call(nm, args)   => cs_ochkcall(nm, args, ctx, moved)
    _                => {diags: Nil, moved: moved, origin: ""}
fn cs_ochkargs(args, ctx, moved) = match args
    Nil        => {diags: Nil, moved: moved}
    Cons(h, t) => let r1 = cs_ochke(h, ctx, moved) in let r2 = cs_ochkargs(t, ctx, r1.moved) in {diags: cs_app(r1.diags, r2.diags), moved: r2.moved}
fn cs_ois_heap(nm) = nm == "rc_new" or nm == "arc_new" or nm == "alloc_heap" or nm == "table_new" or nm == "box_new"
fn cs_ois_free(mf) = mf % 2
fn cs_ois_total(mf) = (mf / 2) % 2
fn cs_ois_llm(mf) = (mf / 4) % 2
fn cs_ois_kernel(mf) = (mf / 8) % 2
fn cs_ois_interrupt(mf) = (mf / 16) % 2
fn cs_ois_ffi(mf) = (mf / 32) % 2
fn cs_ois_protect(mf) = (mf / 64) % 2
fn cs_w33_is_cred(s) = if count(s) < 6 then 0 else if cs_startswith(s, "sk-") == 1 or cs_startswith(s, "ghp_") == 1 or cs_startswith(s, "AKIA") == 1 or cs_startswith(s, "-----BEGIN ") == 1 then 1 else 0
fn cs_w33_chk_sec_e(e, fnm) = match e
    Str(s)          => if cs_w33_is_cred(s) == 1 then Cons(cs_mkdiag("W0001", "secret", "secret hygiene error: hardcoded credential literal in '" + fnm + "' must be wrapped in 'secret_new(...)' from 'std.secret'", "replace literal with 'secret_new(\"<redacted>\")' or load via 'env.secret'"), Nil) else Nil
    Bin(op, l, r)   => cs_app(cs_w33_chk_sec_e(l, fnm), cs_w33_chk_sec_e(r, fnm))
    If(c, t, e2)    => cs_app(cs_w33_chk_sec_e(c, fnm), cs_app(cs_w33_chk_sec_e(t, fnm), cs_w33_chk_sec_e(e2, fnm)))
    LetIn(nm, v, b) => cs_app(cs_w33_chk_sec_e(v, fnm), cs_w33_chk_sec_e(b, fnm))
    VarIn(nm, v, b) => cs_app(cs_w33_chk_sec_e(v, fnm), cs_w33_chk_sec_e(b, fnm))
    Call(cnm, args) => if cnm == "secret_new" then Nil else cs_w33_chk_sec_args(args, fnm)
    _               => Nil
fn cs_w33_chk_sec_args(xs, fnm) = match xs
    Nil        => Nil
    Cons(h, t) => cs_app(cs_w33_chk_sec_e(h, fnm), cs_w33_chk_sec_args(t, fnm))
fn cs_ochkcall(fnm, args, ctx, moved) = let d0 = if cs_ois_free(ctx.freef) == 1 and ctx.halloc == 0 and cs_ois_heap(fnm) then Cons(cs_mkdiag("O0030", "ownership", "ownership error: ambient heap allocation '" + fnm + "' in '@freestanding' function '" + ctx.fnm + "'", "wrap allocation in 'with alloc = <arena> in ...'"), Nil) else Nil in if fnm == "borrow" and cs_len(args) == 1 then let ra = cs_ochke(cs_asthead(args), ctx, moved) in {diags: cs_app(d0, ra.diags), moved: ra.moved, origin: "borrow:" + ra.origin} else if (fnm == "move" or fnm == "drop" or fnm == "rc_drop" or fnm == "arc_drop") and cs_len(args) == 1 then let r0 = cs_ochk_own_tgt(cs_asthead(args), ctx, moved) in {diags: cs_app(d0, r0.diags), moved: r0.moved, origin: ""} else if fnm == "cap_page_map" and cs_len(args) >= 1 then let r0 = cs_ochk_own_tgt(cs_asthead(args), ctx, moved) in let r1 = cs_ochkargs(cs_cvtl(args), ctx, r0.moved) in {diags: cs_app(d0, cs_app(r0.diags, r1.diags)), moved: r1.moved, origin: ""} else cs_ochkcall_sig(fnm, args, cs_osiglookup(fnm, ctx.osigs), ctx, moved, d0)
fn cs_ochkcall_sig(fnm, args, msig, ctx, moved, d0) = match msig
    Nil          => let dc = cs_ochk_conf(fnm, cs_ocollect_muts(args, Nil), args) in let ra = cs_ochkargs(args, ctx, moved) in {diags: cs_app(d0, cs_app(dc, ra.diags)), moved: ra.moved, origin: ""}
    Cons(sg, sr) => let dm = cs_ochk_modes(fnm, args, sg.pl, ctx) in let dc = cs_ochk_conf(fnm, cs_ocollect_muts(args, sg.pl), args) in let ra = cs_ochkargs(args, ctx, moved) in {diags: cs_app(d0, cs_app(dm, cs_app(dc, ra.diags))), moved: ra.moved, origin: ""}
fn cs_ochk_ret(nm, pubf, fromp, org) = let core_org = cs_ostrip_b(org) in if cs_startswith(org, "borrow:") == 1 and cs_startswith(core_org, "local:") == 1 then let lx = slice(core_org, 6, count(core_org)) in Cons(cs_mkdiag("O0020", "region", "region error: borrowed value '" + lx + "' escapes local scope of '" + nm + "'", "return an owned value instead of borrowing local '" + lx + "'"), Nil) else if cs_startswith(org, "borrow:") == 1 and cs_startswith(core_org, "param:") == 1 then let px = slice(core_org, 6, count(core_org)) in (if pubf == 1 and fromp == "" then Cons(cs_mkdiag("O0021", "region", "region error: public function '" + nm + "' returns a borrow from '" + px + "' without an origin clause", "add 'from " + px + "' to the return type of '" + nm + "'"), Nil) else if fromp != "" and fromp != px then Cons(cs_mkdiag("O0021", "region", "region error: function '" + nm + "' declares 'from " + fromp + "' but returns a borrow from '" + px + "'", "change origin clause to 'from " + px + "'"), Nil) else Nil) else Nil

## --- Track A1/A2/A3 diagnostics & hole synthesis in lcaas ---
fn cs_is_hole(nm) = if nm == "_" or cs_startswith(nm, "_hole") == 1 then 1 else 0
fn cs_is_unv_ty(ty) = match ty
    TyApply(n, e) => if n == "unverified" then 1 else 0
    _             => 0
fn cs_hd_ty(xs) = match xs
    Nil        => TyAny
    Cons(h, t) => h
fn cs_tl_ty(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t
fn cs_hd_str(xs, def) = match xs
    Nil        => def
    Cons(h, t) => h
fn cs_plenv(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, r) => Cons({k: pn, v: cs_tystr(cs_hd_ty(pts))}, cs_plenv(r, cs_tl_ty(pts)))
fn cs_fn_lenv(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => cs_plenv(sg.pn, sg.pt)
fn cs_fn_rty(msig, mosig) = match mosig
    Cons(osg, r) => if cs_isany(osg.rty) == 0 then cs_tystr(osg.rty) else cs_sig_rty(msig)
    Nil          => cs_sig_rty(msig)
fn cs_sig_rty(msig) = match msig
    Cons(sg, r) => cs_tystr(sg.rt)
    Nil         => "int"
fn cs_synth_vars(ety, lenv) = match lenv
    Nil        => Nil
    Cons(h, t) => if h.v == ety then Cons(h.k, cs_synth_vars(ety, t)) else cs_synth_vars(ety, t)
fn cs_synth_fn_arg(pty, lenv) = match lenv
    Nil        => ""
    Cons(h, t) => if h.v == pty then h.k else cs_synth_fn_arg(pty, t)
fn cs_synth_fns(ety, lenv, sigs, curfn) = match sigs
    Nil        => Nil
    Cons(sg, r) => if sg.fname == curfn or cs_tystr(sg.rt) != ety then cs_synth_fns(ety, lenv, r, curfn) else if cs_len(sg.pt) == 0 then Cons(sg.fname + "()", cs_synth_fns(ety, lenv, r, curfn)) else if cs_len(sg.pt) == 1 then let v = cs_synth_fn_arg(cs_tystr(cs_hd_ty(sg.pt)), lenv) in (if v != "" then Cons(sg.fname + "(" + v + ")", cs_synth_fns(ety, lenv, r, curfn)) else cs_synth_fns(ety, lenv, r, curfn)) else cs_synth_fns(ety, lenv, r, curfn)
fn cs_synth_def(ety) = if ety == "int" then Cons("0", Cons("1", Nil)) else if ety == "str" then Cons("\"\"", Nil) else Cons("Nil", Nil)
fn cs_synth_int_unary(v) = Cons(v + " + 1", Cons(v + " - 1", Cons(v + " * " + v, Cons("if " + v + " >= 0 then " + v + " else 0 - " + v, Nil))))
fn cs_synth_int_pairs(v, vs) = match vs
    Nil        => Nil
    Cons(w, r) => Cons(v + " + " + w, Cons(v + " - " + w, Cons(w + " - " + v, Cons("if " + v + " >= " + w + " then " + v + " else " + w, Cons("if " + v + " <= " + w + " then " + v + " else " + w, Cons(v + " * " + w, Cons("(" + v + " - " + w + ") * (" + v + " - " + w + ")", cs_synth_int_pairs(v, r))))))))
fn cs_synth_int_ops_pairs(vs) = match vs
    Nil        => Nil
    Cons(v, r) => cs_app(cs_synth_int_pairs(v, r), cs_synth_int_ops_pairs(r))
fn cs_synth_int_ops(vs) = match vs
    Nil        => Nil
    Cons(v, r) => if cs_isnil(r) == 1 then cs_synth_int_unary(v) else cs_app(cs_synth_int_pairs(v, r), cs_synth_int_ops_pairs(r))
fn cs_synth_cands(ety, lenv, sigs, curfn) = let vs = cs_synth_vars(ety, lenv) in let ops = if ety == "int" then cs_synth_int_ops(vs) else Nil in cs_app(vs, cs_app(ops, cs_app(cs_synth_fns(ety, lenv, sigs, curfn), cs_synth_def(ety))))

fn cs_expr_atom_surface(e) = match e
    Bin(op, a, b) => "(" + cs_expr_surface(e) + ")"
    If(c, t, e2)  => "(" + cs_expr_surface(e) + ")"
    _             => cs_expr_surface(e)
fn cs_expr_surface(e) = match e
    Num(n)        => str(n)
    Str(s)        => "\"" + cs_jesc(s) + "\""
    Var(nm)       => nm
    Bin(op, a, b) => if op == "*" then cs_expr_atom_surface(a) + " * " + cs_expr_atom_surface(b) else cs_expr_surface(a) + " " + op + " " + cs_expr_surface(b)
    If(c, t, e2)  => "if " + cs_expr_surface(c) + " then " + cs_expr_surface(t) + " else " + cs_expr_surface(e2)
    Call(nm, xs)  => nm + "(" + cs_exprs_surface(xs) + ")"
    _             => "0"
fn cs_exprs_surface(xs) = match xs
    Nil        => ""
    Cons(h, t) => if cs_isnil(t) == 1 then cs_expr_surface(h) else cs_expr_surface(h) + ", " + cs_exprs_surface(t)
fn cs_exprs_surface_list(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_expr_surface(h), cs_exprs_surface_list(t))
fn cs_synth_var_es(ety, lenv) = match lenv
    Nil        => Nil
    Cons(h, t) => if h.v == ety then Cons(Var(h.k), cs_synth_var_es(ety, t)) else cs_synth_var_es(ety, t)
fn cs_synth_int_unary_es(v) = Cons(Bin("+", Var(v), Num(1)), Cons(Bin("-", Var(v), Num(1)), Cons(Bin("*", Var(v), Var(v)), Cons(If(Bin(">=", Var(v), Num(0)), Var(v), Bin("-", Num(0), Var(v))), Nil))))
fn cs_synth_int_pair_es(v, vs) = match vs
    Nil        => Nil
    Cons(w, r) => Cons(Bin("+", Var(v), Var(w)), Cons(Bin("-", Var(v), Var(w)), Cons(Bin("-", Var(w), Var(v)), Cons(If(Bin(">=", Var(v), Var(w)), Var(v), Var(w)), Cons(If(Bin("<=", Var(v), Var(w)), Var(v), Var(w)), Cons(Bin("*", Var(v), Var(w)), Cons(Bin("*", Bin("-", Var(v), Var(w)), Bin("-", Var(v), Var(w))), cs_synth_int_pair_es(v, r))))))))
fn cs_synth_int_op_pairs_es(vs) = match vs
    Nil        => Nil
    Cons(v, r) => cs_app(cs_synth_int_pair_es(v, r), cs_synth_int_op_pairs_es(r))
fn cs_synth_int_op_es(vs) = match vs
    Nil        => Nil
    Cons(v, r) => if cs_isnil(r) == 1 then cs_synth_int_unary_es(v) else cs_app(cs_synth_int_pair_es(v, r), cs_synth_int_op_pairs_es(r))
fn cs_has_hole_e(e) = match e
    Var(nm)         => cs_is_hole(nm)
    Bin(op, a, b)   => if cs_has_hole_e(a) == 1 then 1 else cs_has_hole_e(b)
    If(c, t, e2)    => if cs_has_hole_e(c) == 1 then 1 else if cs_has_hole_e(t) == 1 then 1 else cs_has_hole_e(e2)
    LetIn(nm, v, b) => if cs_has_hole_e(v) == 1 then 1 else cs_has_hole_e(b)
    VarIn(nm, v, b) => if cs_has_hole_e(v) == 1 then 1 else cs_has_hole_e(b)
    Call(nm, args)  => cs_has_hole_args(args)
    _               => 0
fn cs_has_hole_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => if cs_has_hole_e(h) == 1 then 1 else cs_has_hole_args(t)
fn cs_fnbody(f0) = match f0
    Fn(nm, ps, body) => body
    _                => Num(0)
fn cs_fn_has_hole(fnm, ft) = match ft
    Nil        => 0
    Cons(h, t) => if cs_fnname(h) == fnm then cs_has_hole_e(cs_fnbody(h)) else cs_fn_has_hole(fnm, t)
fn cs_synth_fn_es(ety, lenv, sigs, curfn, ft) = match sigs
    Nil        => Nil
    Cons(sg, r) => if sg.fname == curfn or cs_tystr(sg.rt) != ety or cs_fn_has_hole(sg.fname, ft) == 1 then cs_synth_fn_es(ety, lenv, r, curfn, ft) else if cs_len(sg.pt) == 0 then Cons(Call(sg.fname, Nil), cs_synth_fn_es(ety, lenv, r, curfn, ft)) else if cs_len(sg.pt) == 1 then let v = cs_synth_fn_arg(cs_tystr(cs_hd_ty(sg.pt)), lenv) in (if v != "" then Cons(Call(sg.fname, Cons(Var(v), Nil)), cs_synth_fn_es(ety, lenv, r, curfn, ft)) else cs_synth_fn_es(ety, lenv, r, curfn, ft)) else cs_synth_fn_es(ety, lenv, r, curfn, ft)
fn cs_synth_def_es(ety) = if ety == "int" then Cons(Num(0), Cons(Num(1), Nil)) else if ety == "str" then Cons(Str(""), Nil) else Cons(Var("Nil"), Nil)
fn cs_synth_cand_es(ety, lenv, sigs, curfn, ft) = let vs = cs_synth_vars(ety, lenv) in let ves = cs_synth_var_es(ety, lenv) in let oes = if ety == "int" then cs_synth_int_op_es(vs) else Nil in cs_app(ves, cs_app(oes, cs_app(cs_synth_fn_es(ety, lenv, sigs, curfn, ft), cs_synth_def_es(ety))))

fn cs_subst_hole_e(e, hnm, rep) = match e
    Var(nm)         => if nm == hnm or (hnm == "_" and cs_is_hole(nm) == 1) then rep else e
    Bin(op, a, b)   => Bin(op, cs_subst_hole_e(a, hnm, rep), cs_subst_hole_e(b, hnm, rep))
    If(c, t, e2)    => If(cs_subst_hole_e(c, hnm, rep), cs_subst_hole_e(t, hnm, rep), cs_subst_hole_e(e2, hnm, rep))
    LetIn(nm, v, b) => LetIn(nm, cs_subst_hole_e(v, hnm, rep), cs_subst_hole_e(b, hnm, rep))
    VarIn(nm, v, b) => VarIn(nm, cs_subst_hole_e(v, hnm, rep), cs_subst_hole_e(b, hnm, rep))
    Call(nm, args)  => Call(nm, cs_subst_hole_args(args, hnm, rep))
    _               => e
fn cs_subst_hole_args(xs, hnm, rep) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_subst_hole_e(h, hnm, rep), cs_subst_hole_args(t, hnm, rep))
fn cs_update_fn_ft(fnm, ps, nbody, ft) = match ft
    Nil        => Cons(Fn(fnm, ps, nbody), Nil)
    Cons(h, t) => if cs_fnname(h) == fnm then Cons(Fn(fnm, ps, nbody), t) else Cons(h, cs_update_fn_ft(fnm, ps, nbody, t))
fn cs_mentions_call(fnm, e) = match e
    Call(cnm, args) => if cnm == fnm then 1 else cs_mentions_call_args(fnm, args)
    Bin(op, a, b)   => if cs_mentions_call(fnm, a) == 1 then 1 else cs_mentions_call(fnm, b)
    If(c, t, e2)    => if cs_mentions_call(fnm, c) == 1 then 1 else if cs_mentions_call(fnm, t) == 1 then 1 else cs_mentions_call(fnm, e2)
    LetIn(nm, v, b) => if cs_mentions_call(fnm, v) == 1 then 1 else cs_mentions_call(fnm, b)
    _               => 0
fn cs_mentions_call_args(fnm, xs) = match xs
    Nil        => 0
    Cons(h, t) => if cs_mentions_call(fnm, h) == 1 then 1 else cs_mentions_call_args(fnm, t)
fn cs_laws_mention_fn(fnm, laws) = match laws
    Nil        => Nil
    Cons(l, r) => if cs_mentions_call(fnm, l.body) == 1 then Cons(l, cs_laws_mention_fn(fnm, r)) else cs_laws_mention_fn(fnm, r)
fn cs_check_cand_laws(laws, ft) = match laws
    Nil        => 2
    Cons(l, r) => let pr0 = cs_vprove_law_envs(cs_vgen_envs_hyps(l.ps, 0, cs_len(l.ps), Nil), l.body, ft, 0) in if pr0.status == "refuted" then 0 - 1 else let qf = cs_vqflia_prove_law(l.ps, l.body, ft) in let rest = cs_check_cand_laws(r, ft) in if rest < 0 then 0 - 1 else if qf == 1 and rest == 2 then 2 else 1
fn cs_score_cand_vsig(ps, nbody, mvs, ft2) = match mvs
    Nil          => 1
    Cons(vsg, r) => let pr0 = cs_vprove_envs(cs_vgen_envs_hyps(ps, 0, cs_len(ps), Nil), vsg.reqs, vsg.enss, nbody, ft2, 0) in if pr0.status == "refuted" then 0 - 1 else if cs_vqflia_prove_fn(ps, vsg.reqs, vsg.enss, nbody, ft2) == 1 then 2 else 1
fn cs_score_cand_e(ce, hnm, hctx) = let nbody = cs_subst_hole_e(hctx.body, hnm, ce) in let ft2 = cs_update_fn_ft(hctx.fnm, hctx.ps, nbody, hctx.ft) in let mvs = cs_vsiglookup(hctx.fnm, hctx.vsigs) in let mlaws = cs_laws_mention_fn(hctx.fnm, hctx.laws) in let c_sc = cs_score_cand_vsig(hctx.ps, nbody, mvs, ft2) in if c_sc < 0 then 0 - 1 else if cs_isnil(mlaws) == 1 then c_sc else let l_sc = cs_check_cand_laws(mlaws, ft2) in if l_sc < 0 then 0 - 1 else if c_sc == 2 or l_sc == 2 then 2 else 1
fn cs_partition_cands(ces, hnm, hctx) = match ces
    Nil         => {prv: Nil, val: Nil}
    Cons(ce, r) => let sc = cs_score_cand_e(ce, hnm, hctx) in let rr = cs_partition_cands(r, hnm, hctx) in if sc == 2 then {prv: Cons(ce, rr.prv), val: rr.val} else if sc == 1 then {prv: rr.prv, val: Cons(ce, rr.val)} else rr
fn cs_filter_proven_es(ces, hnm, hctx) = (cs_partition_cands(ces, hnm, hctx)).prv
fn cs_filter_valid_es(ces, hnm, hctx) = (cs_partition_cands(ces, hnm, hctx)).val
fn cs_rank_cand_es(ety, lenv, hnm, hctx) = let raw = cs_synth_cand_es(ety, lenv, hctx.sigs, hctx.fnm, hctx.ft) in let pt = cs_partition_cands(raw, hnm, hctx) in let ranked = cs_app(pt.prv, pt.val) in if cs_isnil(ranked) == 0 then ranked else raw
fn cs_best_hole_expr(ety, lenv, hnm, hctx) = match cs_rank_cand_es(ety, lenv, hnm, hctx)
    Nil         => Num(0)
    Cons(ce, r) => ce

fn cs_holes_e(e, ety, lenv, hctx) = match e
    Var(nm)         => if cs_is_hole(nm) == 1 then let raw_es = cs_synth_cand_es(ety, lenv, hctx.sigs, hctx.fnm, hctx.ft) in let pt = cs_partition_cands(raw_es, nm, hctx) in let prv_es = pt.prv in let rnk_es = (if cs_isnil(pt.prv) == 0 or cs_isnil(pt.val) == 0 then cs_app(pt.prv, pt.val) else raw_es) in let cands = cs_exprs_surface_list(rnk_es) in let prv_cands = cs_exprs_surface_list(prv_es) in let best = cs_hd_str(cands, "0") in {holes: Cons({hole: nm, fnm: hctx.fnm, expected_type: ety, context: lenv, candidates: cands, proven_candidates: prv_cands}, Nil), diags: Cons(cs_mkdiag("A0001", "hole", "hole error: unfilled typed hole '" + nm + "' of expected type " + ety + " in '" + hctx.fnm + "'", "replace '" + nm + "' with '" + best + "'"), Nil)} else {holes: Nil, diags: Nil}
    Bin(op, l, r)   => let r1 = cs_holes_e(l, ety, lenv, hctx) in let r2 = cs_holes_e(r, ety, lenv, hctx) in {holes: cs_app(r1.holes, r2.holes), diags: cs_app(r1.diags, r2.diags)}
    If(c, t, e2)    => let rc = cs_holes_e(c, "int", lenv, hctx) in let rt = cs_holes_e(t, ety, lenv, hctx) in let re = cs_holes_e(e2, ety, lenv, hctx) in {holes: cs_app(rc.holes, cs_app(rt.holes, re.holes)), diags: cs_app(rc.diags, cs_app(rt.diags, re.diags))}
    LetIn(nm, v, b) => let rv = cs_holes_e(v, ety, lenv, hctx) in let rb = cs_holes_e(b, ety, Cons({k: nm, v: ety}, lenv), hctx) in {holes: cs_app(rv.holes, rb.holes), diags: cs_app(rv.diags, rb.diags)}
    VarIn(nm, v, b) => let rv = cs_holes_e(v, ety, lenv, hctx) in let rb = cs_holes_e(b, ety, Cons({k: nm, v: ety}, lenv), hctx) in {holes: cs_app(rv.holes, rb.holes), diags: cs_app(rv.diags, rb.diags)}
    Call(cnm, args) => cs_holes_args(args, ety, lenv, hctx)
    _               => {holes: Nil, diags: Nil}
fn cs_holes_args(args, ety, lenv, hctx) = match args
    Nil        => {holes: Nil, diags: Nil}
    Cons(h, t) => let r1 = cs_holes_e(h, ety, lenv, hctx) in let r2 = cs_holes_args(t, ety, lenv, hctx) in {holes: cs_app(r1.holes, r2.holes), diags: cs_app(r1.diags, r2.diags)}
fn cs_collect_holes_stmts(prog, sigs, osigs, vsigs, laws, ft) = match prog
    Nil        => {holes: Nil, diags: Nil}
    Cons(h, t) => cs_collect_holes_stmt1(h, t, sigs, osigs, vsigs, laws, ft)
fn cs_collect_holes_stmt1(st, rest, sigs, osigs, vsigs, laws, ft) = match st
    Fn(nm, ps, body) => if cs_has_hole_e(body) == 0 then cs_collect_holes_stmts(rest, sigs, osigs, vsigs, laws, ft) else let msig = cs_siglookup(nm, sigs) in let mosig = cs_osiglookup(nm, osigs) in let r1 = cs_holes_e(body, cs_fn_rty(msig, mosig), cs_fn_lenv(msig), {fnm: nm, pubf: cs_pub_osig(mosig), ps: ps, body: body, sigs: sigs, vsigs: vsigs, laws: laws, ft: ft}) in let r2 = cs_collect_holes_stmts(rest, sigs, osigs, vsigs, laws, ft) in {holes: cs_app(r1.holes, r2.holes), diags: cs_app(r1.diags, r2.diags)}
    _                => cs_collect_holes_stmts(rest, sigs, osigs, vsigs, laws, ft)
fn cs_pub_osig(mosig) = match mosig
    Nil          => 0
    Cons(osg, r) => osg.pubf
fn cs_fill_holes_e(e, ety, lenv, hctx) = match e
    Var(nm)         => if cs_is_hole(nm) == 1 then (if cs_isnil(cs_vsiglookup(hctx.fnm, hctx.vsigs)) == 1 and cs_isnil(cs_laws_mention_fn(hctx.fnm, hctx.laws)) == 1 then Num(0) else cs_best_hole_expr(ety, lenv, nm, hctx)) else e
    Bin(op, a, b)   => Bin(op, cs_fill_holes_e(a, ety, lenv, hctx), cs_fill_holes_e(b, ety, lenv, hctx))
    If(c, t, e2)    => If(cs_fill_holes_e(c, "int", lenv, hctx), cs_fill_holes_e(t, ety, lenv, hctx), cs_fill_holes_e(e2, ety, lenv, hctx))
    LetIn(nm, v, b) => LetIn(nm, cs_fill_holes_e(v, ety, lenv, hctx), cs_fill_holes_e(b, ety, Cons({k: nm, v: ety}, lenv), hctx))
    VarIn(nm, v, b) => VarIn(nm, cs_fill_holes_e(v, ety, lenv, hctx), cs_fill_holes_e(b, ety, Cons({k: nm, v: ety}, lenv), hctx))
    Call(nm, args)  => Call(nm, cs_fill_holes_args(args, ety, lenv, hctx))
    _               => e
fn cs_fill_holes_args(xs, ety, lenv, hctx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_fill_holes_e(h, ety, lenv, hctx), cs_fill_holes_args(t, ety, lenv, hctx))
fn cs_fill_prog_holes(prog, sigs, osigs, vsigs, laws, ft) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(cs_fill_stmt_holes(h, sigs, osigs, vsigs, laws, ft), cs_fill_prog_holes(t, sigs, osigs, vsigs, laws, ft))
fn cs_fill_stmt_holes(st, sigs, osigs, vsigs, laws, ft) = match st
    Fn(nm, ps, body) => if cs_has_hole_e(body) == 0 then st else let mosig = cs_osiglookup(nm, osigs) in if cs_pub_osig(mosig) == 1 then st else let msig = cs_siglookup(nm, sigs) in let ety = cs_fn_rty(msig, mosig) in Fn(nm, ps, cs_fill_holes_e(body, ety, cs_fn_lenv(msig), {fnm: nm, ps: ps, body: body, sigs: sigs, vsigs: vsigs, laws: laws, ft: ft}))
    _                => st

## --- Track A2: totality check (`[A0002]`) ---
fn cs_pat_subvars(p) = match p
    PCons(tag, sub) => sub
    _               => Nil
fn cs_guard_ps(ps, c, guarded) = match ps
    Nil        => guarded
    Cons(p, r) => if cs_omentions(p, c) == 1 and cs_omem(p, guarded) == 0 then Cons(p, cs_guard_ps(r, c, guarded)) else cs_guard_ps(r, c, guarded)
fn cs_is_pos_num(e, minv) = match e
    Num(k) => if k >= minv then 1 else 0
    _      => 0
fn cs_is_guarded_var(e, ps, guarded) = match e
    Var(p) => if cs_omem(p, ps) == 1 and cs_omem(p, guarded) == 1 then 1 else 0
    _      => 0
fn cs_is_dec_bin(op, l, r, ps, guarded) = if op == "%" and (cs_is_guarded_var(r, ps, guarded) == 1 or cs_is_pos_num(r, 2) == 1) then 1 else match l
    Var(p) => if cs_omem(p, ps) == 1 and cs_omem(p, guarded) == 1 then (if op == "-" and cs_is_pos_num(r, 1) == 1 then 1 else if op == "/" and cs_is_pos_num(r, 2) == 1 then 1 else 0) else 0
    _      => 0
fn cs_is_dec_arg(arg, ps, subvars, guarded) = match arg
    Var(v)        => cs_omem(v, subvars)
    OwnE(inner)   => cs_is_dec_arg(inner, ps, subvars, guarded)
    MutE(inner)   => cs_is_dec_arg(inner, ps, subvars, guarded)
    Bin(op, l, r) => cs_is_dec_bin(op, l, r, ps, guarded)
    _             => 0
fn cs_is_same_param(arg, p) = match arg
    Var(v)      => if v == p then 1 else 0
    OwnE(inner) => cs_is_same_param(inner, p)
    MutE(inner) => cs_is_same_param(inner, p)
    _           => 0
fn cs_is_inc_bin(op, l, r, p) = match l
    Var(v) => if v == p and ((op == "+" and cs_is_pos_num(r, 1) == 1) or (op == "*" and cs_is_pos_num(r, 2) == 1)) then 1 else 0
    _      => 0
fn cs_is_inc_arg_for(arg, p) = match arg
    OwnE(inner)   => cs_is_inc_arg_for(inner, p)
    MutE(inner)   => cs_is_inc_arg_for(inner, p)
    Bin(op, l, r) => cs_is_inc_bin(op, l, r, p)
    _             => 0
fn cs_has_fixed_guarded(args, ps, guarded) = match args
    Nil        => 0
    Cons(a, r) => cs_has_fixed_g1(a, r, ps, guarded)
fn cs_has_fixed_g1(a, ar, ps, guarded) = match ps
    Nil         => 0
    Cons(p, pr) => if cs_omem(p, guarded) == 1 and cs_is_same_param(a, p) == 1 then 1 else cs_has_fixed_guarded(ar, pr, guarded)
fn cs_has_dec_arg(args, ps, subvars, guarded) = cs_lex_dec_args(args, ps, ps, subvars, guarded)
fn cs_lex_dec_args(args, cur_ps, all_ps, subvars, guarded) = match args
    Nil        => 0
    Cons(a, r) => cs_lex_dec_step(a, r, cur_ps, all_ps, subvars, guarded)
fn cs_lex_dec_step(a, ar, cur_ps, all_ps, subvars, guarded) = match cur_ps
    Nil         => if cs_is_dec_arg(a, all_ps, subvars, guarded) == 1 then 1 else cs_lex_dec_args(ar, Nil, all_ps, subvars, guarded)
    Cons(p, pr) => if cs_is_dec_arg(a, all_ps, subvars, guarded) == 1 then 1 else if cs_is_inc_arg_for(a, p) == 1 then (if cs_omem(p, guarded) == 1 and cs_has_fixed_guarded(ar, pr, guarded) == 1 then 1 else 0) else cs_lex_dec_args(ar, pr, all_ps, subvars, guarded)
fn cs_achk_total_e(e, fnm, ps, subvars, guarded) = match e
    Call(cnm, args) => let da = cs_achk_total_args(args, fnm, ps, subvars, guarded) in if cnm == fnm and cs_has_dec_arg(args, ps, subvars, guarded) == 0 then Cons(cs_mkdiag("A0002", "totality", "totality error: cannot prove termination of 'total fn " + fnm + "': recursive call does not decrease any parameter", "recurse on a structural pattern subterm or a guarded 'n - 1' measure"), da) else da
    If(c, t, e2)    => let g2 = cs_guard_ps(ps, c, guarded) in cs_app(cs_achk_total_e(c, fnm, ps, subvars, guarded), cs_app(cs_achk_total_e(t, fnm, ps, subvars, g2), cs_achk_total_e(e2, fnm, ps, subvars, g2)))
    Bin(op, l, r)   => cs_app(cs_achk_total_e(l, fnm, ps, subvars, guarded), cs_achk_total_e(r, fnm, ps, subvars, guarded))
    LetIn(nm, v, b) => cs_app(cs_achk_total_e(v, fnm, ps, subvars, guarded), cs_achk_total_e(b, fnm, ps, subvars, guarded))
    Match(sc, arms) => cs_achk_total_arms(arms, fnm, ps, subvars, guarded)
    _               => Nil
fn cs_achk_total_args(args, fnm, ps, subvars, guarded) = match args
    Nil        => Nil
    Cons(h, t) => cs_app(cs_achk_total_e(h, fnm, ps, subvars, guarded), cs_achk_total_args(t, fnm, ps, subvars, guarded))
fn cs_achk_total_arms(arms, fnm, ps, subvars, guarded) = match arms
    Nil        => Nil
    Cons(h, t) => cs_app(cs_achk_total_e(h.body, fnm, ps, cs_app(cs_pat_subvars(h.pat), subvars), guarded), cs_achk_total_arms(t, fnm, ps, subvars, guarded))

## --- Track A3: provenance check (`[A0003]`) ---
fn cs_uinit_vars(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, r) => if cs_is_unv_ty(cs_hd_ty(pts)) == 1 then Cons(pn, cs_uinit_vars(r, cs_tl_ty(pts))) else cs_uinit_vars(r, cs_tl_ty(pts))
fn cs_uinit_sig(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => cs_uinit_vars(sg.pn, sg.pt)
fn cs_vhas_ensures_sig(nm, vsigs) = match cs_vsiglookup(nm, vsigs)
    Nil          => 0
    Cons(vsg, r) => if cs_isnil(vsg.enss) == 0 then 1 else 0
fn cs_is_unv_fn(cnm, osigs, sigs, vsigs) = if cnm == "llm_complete" or cnm == "prob_sample" or cnm == "ffi_call" then 1 else if cs_is_llm_osig(cs_osiglookup(cnm, osigs)) == 1 or cs_is_ffi_osig(cs_osiglookup(cnm, osigs)) == 1 then (if cs_vhas_ensures_sig(cnm, vsigs) == 1 then 0 else 1) else cs_is_unv_ret(cs_siglookup(cnm, sigs))
fn cs_is_llm_osig(msig) = match msig
    Nil        => 0
    Cons(sg, r) => cs_ois_llm(sg.freef)
fn cs_is_ffi_osig(msig) = match msig
    Nil        => 0
    Cons(sg, r) => if cs_ois_ffi(sg.freef) == 1 and sg.pubf == 0 then 1 else 0
fn cs_is_unv_ret(msig) = match msig
    Nil        => 0
    Cons(sg, r) => cs_is_unv_ty(sg.rt)
fn cs_is_sink(cnm, osigs) = if cnm == "io_write" or cnm == "db_exec" or cnm == "net_send" or cnm == "fs_write" or cnm == "trusted_sink" or cnm == "law_assert" then 1 else cs_is_pub_nonllm(cs_osiglookup(cnm, osigs))
fn cs_is_pub_nonllm(msig) = match msig
    Nil        => 0
    Cons(sg, r) => if sg.pubf == 1 and cs_ois_llm(sg.freef) == 0 then 1 else 0
fn cs_discharge_vars(uvars, c) = match uvars
    Nil        => Nil
    Cons(v, r) => if cs_omentions(v, c) == 1 then cs_discharge_vars(r, c) else Cons(v, cs_discharge_vars(r, c))
fn cs_achk_prov_e(e, fnm, uvars, osigs, sigs, vsigs) = match e
    Var(x)          => {taint: cs_omem(x, uvars), diags: Nil}
    Bin(op, l, r)   => let rl = cs_achk_prov_e(l, fnm, uvars, osigs, sigs, vsigs) in let rr = cs_achk_prov_e(r, fnm, uvars, osigs, sigs, vsigs) in {taint: if rl.taint == 1 or rr.taint == 1 then 1 else 0, diags: cs_app(rl.diags, rr.diags)}
    If(c, t, e2)    => let rc = cs_achk_prov_e(c, fnm, uvars, osigs, sigs, vsigs) in let rt = cs_achk_prov_e(t, fnm, cs_discharge_vars(uvars, c), osigs, sigs, vsigs) in let re = cs_achk_prov_e(e2, fnm, uvars, osigs, sigs, vsigs) in {taint: if rt.taint == 1 or re.taint == 1 then 1 else 0, diags: cs_app(rc.diags, cs_app(rt.diags, re.diags))}
    LetIn(nm, v, b) => let rv = cs_achk_prov_e(v, fnm, uvars, osigs, sigs, vsigs) in let uv2 = if rv.taint == 1 then Cons(nm, cs_orem(nm, uvars)) else cs_orem(nm, uvars) in let rb = cs_achk_prov_e(b, fnm, uv2, osigs, sigs, vsigs) in {taint: rb.taint, diags: cs_app(rv.diags, rb.diags)}
    Call(cnm, args) => cs_achk_prov_call(cnm, args, fnm, uvars, osigs, {sigs: sigs, vsigs: vsigs})
    _               => {taint: 0, diags: Nil}
fn cs_achk_prov_args(args, fnm, uvars, osigs, sigs, vsigs) = match args
    Nil        => {taint: 0, diags: Nil}
    Cons(h, t) => let r1 = cs_achk_prov_e(h, fnm, uvars, osigs, sigs, vsigs) in let r2 = cs_achk_prov_args(t, fnm, uvars, osigs, sigs, vsigs) in {taint: if r1.taint == 1 or r2.taint == 1 then 1 else 0, diags: cs_app(r1.diags, r2.diags)}
fn cs_achk_prov_call(cnm, args, fnm, uvars, osigs, sv) = if cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" then let ra = cs_achk_prov_args(args, fnm, uvars, osigs, sv.sigs, sv.vsigs) in {taint: 0, diags: ra.diags} else let ra = cs_achk_prov_args(args, fnm, uvars, osigs, sv.sigs, sv.vsigs) in let d_sink = if cs_is_sink(cnm, osigs) == 1 and ra.taint == 1 then Cons(cs_mkdiag("A0003", "provenance", "provenance error: unverified AI/probabilistic value in '" + fnm + "' cannot flow into trusted sink '" + cnm + "' without verification", "validate with 'verify(x, <contract>)' before calling '" + cnm + "'"), Nil) else Nil in {taint: if cs_is_unv_fn(cnm, osigs, sv.sigs, sv.vsigs) == 1 or ra.taint == 1 then 1 else 0, diags: cs_app(ra.diags, d_sink)}

fn cs_kcollect_effsigs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_kcollect_effsig1(h, cs_kcollect_effsigs(t))
fn cs_kcollect_effsig1(st, rest) = match st
    KEffSig(nm, effs) => Cons({nm: nm, effs: effs}, rest)
    _                 => rest
fn cs_kcollect_effdecls(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_kcollect_effdecl1(h, cs_kcollect_effdecls(t))
fn cs_kcollect_effdecl1(st, rest) = match st
    KEffectDecl(enm, ops) => Cons({enm: enm, ops: ops}, rest)
    _                     => rest
fn cs_kcollect_caps(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_kcollect_cap1(h, cs_kcollect_caps(t))
fn cs_kcollect_cap1(st, rest) = match st
    KCapGrant(effs) => cs_app(effs, rest)
    _               => rest
fn cs_keffsig_lookup(nm, ksigs) = match ksigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else cs_keffsig_lookup(nm, t)
fn cs_kop_effect(opnm, edecls) = match edecls
    Nil        => ""
    Cons(d, r) => if cs_kop_in_ops(opnm, d.ops) == 1 then d.enm else cs_kop_effect(opnm, r)
fn cs_kop_in_ops(opnm, ops) = match ops
    Nil        => 0
    Cons(o, r) => if o.op == opnm then 1 else cs_kop_in_ops(opnm, r)
fn cs_keff_add(eff, xs) = if eff == "" or eff == "pure" or cs_omem(eff, xs) == 1 then xs else Cons(eff, xs)
fn cs_keff_union(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => cs_keff_union(t, cs_keff_add(h, ys))
fn cs_keff_diff(xs, ys) = match xs
    Nil        => Nil
    Cons(h, t) => if h == "pure" or cs_omem(h, ys) == 1 then cs_keff_diff(t, ys) else Cons(h, cs_keff_diff(t, ys))
fn cs_kprim_eff(cnm) = if cnm == "io_write" or cnm == "io_read" or cnm == "println" or cnm == "read" or cnm == "readall" or cnm == "emit" or cnm == "flush" or cnm == "os_exec" or cnm == "os_kill" or cnm == "os_waitpid_status" then "io" else if cnm == "fs_read" or cnm == "fs_write" or cnm == "fs_open" then "fs" else if cnm == "net_send" or cnm == "net_recv" or cnm == "net_connect" or cnm == "db_exec" then "net" else if cnm == "rc_new" or cnm == "arc_new" or cnm == "alloc_heap" or cnm == "table_new" or cnm == "box_new" then "alloc" else if cnm == "rand_int" or cnm == "prob_sample" or cnm == "llm_complete" then "rand" else if cnm == "sample_dist" or cnm == "observe_lik" then "prob" else if cnm == "llm_prompt" then "llm" else if cnm == "wasm_module_new" or cnm == "wasm_call_add" or cnm == "wasm_store32" or cnm == "wasm_load32" or cnm == "wasm_call_host_fs" then "wasm" else if cnm == "ffi_call" then "ffi" else if cnm == "time_now" or cnm == "clock_now" or cnm == "sleep_ms" then "time" else if cnm == "fail_err" or cnm == "raise_err" then "fail" else if cnm == "panic_msg" then "panic" else if cnm == "async_await" or cnm == "spawn_task" then "async" else ""
fn cs_kinfer_call_effs(cnm, ksigs, edecls) = let pe = cs_kprim_eff(cnm) in let ue = cs_kop_effect(cnm, edecls) in let base0 = cs_keff_add(pe, cs_keff_add(ue, Nil)) in let base = if cnm == "wasm_call_host_fs" then cs_keff_add("fs", base0) else if cnm == "wasm_call_host_net" then cs_keff_add("net", base0) else base0 in match cs_keffsig_lookup(cnm, ksigs)
    Cons(ks, r) => cs_keff_union(base, cs_keff_diff(ks.effs, Cons("pure", Nil)))
    Nil         => base
fn cs_kinfer_effs_e(e, ksigs, edecls) = match e
    Bin(op, l, r)           => cs_keff_union(cs_kinfer_effs_e(l, ksigs, edecls), cs_kinfer_effs_e(r, ksigs, edecls))
    If(c, t, e2)            => cs_keff_union(cs_kinfer_effs_e(c, ksigs, edecls), cs_keff_union(cs_kinfer_effs_e(t, ksigs, edecls), cs_kinfer_effs_e(e2, ksigs, edecls)))
    LetIn(nm, v, b)         => cs_keff_union(cs_kinfer_effs_e(v, ksigs, edecls), cs_kinfer_effs_e(b, ksigs, edecls))
    VarIn(nm, v, b)         => cs_keff_union(cs_kinfer_effs_e(v, ksigs, edecls), cs_kinfer_effs_e(b, ksigs, edecls))
    OwnE(inner)             => cs_kinfer_effs_e(inner, ksigs, edecls)
    MutE(inner)             => cs_kinfer_effs_e(inner, ksigs, edecls)
    DeferE(c, b)            => cs_keff_union(cs_kinfer_effs_e(c, ksigs, edecls), cs_kinfer_effs_e(b, ksigs, edecls))
    ErrDeferE(c, b)         => cs_keff_union(cs_kinfer_effs_e(c, ksigs, edecls), cs_kinfer_effs_e(b, ksigs, edecls))
    WithAllocE(a, b)        => cs_keff_union(cs_kinfer_effs_e(a, ksigs, edecls), cs_orem("alloc", cs_kinfer_effs_e(b, ksigs, edecls)))
    WithHandlerE(en, hs, b) => cs_keff_union(cs_kinfer_hops(hs, ksigs, edecls), cs_orem(en, cs_kinfer_effs_e(b, ksigs, edecls)))
    Call(cnm, args)         => cs_keff_union(cs_kinfer_call_effs(cnm, ksigs, edecls), cs_kinfer_args(args, ksigs, edecls))
    Match(sc, arms)         => cs_keff_union(cs_kinfer_effs_e(sc, ksigs, edecls), cs_kinfer_arms(arms, ksigs, edecls))
    _                       => Nil
fn cs_kinfer_hops(hs, ksigs, edecls) = match hs
    Nil        => Nil
    Cons(h, t) => cs_keff_union(cs_kinfer_effs_e(h.body, ksigs, edecls), cs_kinfer_hops(t, ksigs, edecls))
fn cs_kinfer_args(xs, ksigs, edecls) = match xs
    Nil        => Nil
    Cons(h, t) => cs_keff_union(cs_kinfer_effs_e(h, ksigs, edecls), cs_kinfer_args(t, ksigs, edecls))
fn cs_kinfer_arms(xs, ksigs, edecls) = match xs
    Nil        => Nil
    Cons(h, t) => cs_keff_union(cs_kinfer_effs_e(h.body, ksigs, edecls), cs_kinfer_arms(t, ksigs, edecls))
fn cs_kget_dec_effs(mks) = match mks
    Nil         => Nil
    Cons(ks, r) => ks.effs
fn cs_kuses_ffi_e(e, osigs) = match e
    Call(cnm, args) => if cs_is_ffi_osig(cs_osiglookup(cnm, osigs)) == 1 then 1 else cs_kuses_ffi_args(args, osigs)
    Bin(op, l, r)   => if cs_kuses_ffi_e(l, osigs) == 1 then 1 else cs_kuses_ffi_e(r, osigs)
    If(c, t, e2)    => if cs_kuses_ffi_e(c, osigs) == 1 then 1 else if cs_kuses_ffi_e(t, osigs) == 1 then 1 else cs_kuses_ffi_e(e2, osigs)
    LetIn(nm, v, b) => if cs_kuses_ffi_e(v, osigs) == 1 then 1 else cs_kuses_ffi_e(b, osigs)
    VarIn(nm, v, b) => if cs_kuses_ffi_e(v, osigs) == 1 then 1 else cs_kuses_ffi_e(b, osigs)
    _               => 0
fn cs_kuses_ffi_args(xs, osigs) = match xs
    Nil        => 0
    Cons(h, t) => if cs_kuses_ffi_e(h, osigs) == 1 then 1 else cs_kuses_ffi_args(t, osigs)
fn cs_kchk_trace(nm, inf, caps) = if nm == "rejected" then fs_write_sync("build/capability-trace.txt", "fn=" + nm + "\ninf=" + cs_joinsep(inf, ",") + "\ncaps=" + cs_joinsep(caps, ",") + "\nmissing=" + cs_joinsep(cs_keff_diff(inf, caps), ",") + "\n") else 0
fn cs_kchk_fn(nm, pubf, body, kt) = let inf0 = cs_kinfer_effs_e(body, kt.ksigs, kt.edecls) in let inf = if cs_kuses_ffi_e(body, kt.osigs) == 1 then cs_keff_add("ffi", inf0) else inf0 in let ktrace = cs_kchk_trace(nm, inf, kt.caps) in let mks = cs_keffsig_lookup(nm, kt.ksigs) in let dec = cs_kget_dec_effs(mks) in let missing_pub = if pubf == 1 and cs_isnil(mks) == 1 then inf else cs_keff_diff(inf, dec) in let d1 = if (pubf == 1 or cs_isnil(mks) == 0) and cs_isnil(missing_pub) == 0 then Cons(cs_mkdiag("E0200", "effect", "effect error: function '" + nm + "' performs undeclared effect '{" + cs_joinsep(missing_pub, ", ") + "}'", "add '/ {" + cs_joinsep(cs_keff_union(dec, inf), ", ") + "}' to the signature of '" + nm + "' or handle it with 'with handler'"), Nil) else Nil in let d2 = if cs_isnil(kt.caps) == 0 and cs_isnil(cs_keff_diff(inf, kt.caps)) == 0 then let uncap = cs_keff_diff(inf, kt.caps) in Cons(cs_mkdiag("E0200", "capability", "capability error: function '" + nm + "' requires capability '{" + cs_joinsep(uncap, ", ") + "}' not granted to this module", "add '@capability " + cs_hd_str(uncap, "io") + "' or declare it in lume.toml"), Nil) else Nil in cs_app(d1, d2)

## --- Track S1: structured concurrency (`scope` / `spawn`) & `Send`/`Sync` (`[S0001]`) ---
fn cs_sis_nonsend_ty(ty) = match ty
    TyApply(n, e) => if n == "rc" or n == "cell" or n == "Ref" then 1 else cs_sis_nonsend_ty(e)
    TyList(e)     => cs_sis_nonsend_ty(e)
    _             => 0
fn cs_sis_nonsend_init(e) = match e
    Call(cnm, args) => if cnm == "rc" or cnm == "rc_new" or cnm == "rc_clone" or cnm == "cell_new" or cnm == "borrow_mut" then 1 else 0
    MutE(inner)     => 1
    _               => 0
fn cs_sis_nonsend_clone(e, nsvars) = match e
    Call(cnm, args) => if cnm == "clone" and cs_len(args) == 1 then cs_sis_nonsend_clone_arg(cs_asthead(args), nsvars) else 0
    _               => 0
fn cs_sis_nonsend_clone_arg(a, nsvars) = match a
    Var(x) => cs_omem(x, nsvars)
    _      => 0
fn cs_sinit_ns(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, r) => if cs_sis_nonsend_ty(cs_hd_ty(pts)) == 1 then Cons(pn, cs_sinit_ns(r, cs_tl_ty(pts))) else cs_sinit_ns(r, cs_tl_ty(pts))
fn cs_sinit_ns_sig(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => cs_sinit_ns(sg.pn, sg.pt)
fn cs_schk_spawn_body(e, fnm, nsvars, mvars) = match e
    Var(x)          => if cs_omem(x, nsvars) == 1 then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: cannot capture non-Send value '" + x + "' across 'spawn' in '" + fnm + "'", "use 'arc_new' instead of 'rc_new'/'cell_new' or pass an owned message over 'chan[T]'"), Nil) else if cs_omem(x, mvars) == 1 then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: cannot capture mutable binding '" + x + "' across 'spawn' in '" + fnm + "' without 'own' transfer", "move ownership with 'own " + x + "' or share via 'arc[T]' / 'chan[T]'"), Nil) else Nil
    OwnE(inner)     => cs_schk_spawn_own(inner, fnm, nsvars)
    MutE(inner)     => Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: cannot capture mutable borrow 'mut' across 'spawn' in '" + fnm + "'", "transfer ownership with 'own' or synchronize via 'chan[T]'"), Nil)
    Field(o, fld)   => cs_schk_spawn_body(o, fnm, nsvars, mvars)
    Bin(op, l, r)   => cs_app(cs_schk_spawn_body(l, fnm, nsvars, mvars), cs_schk_spawn_body(r, fnm, nsvars, mvars))
    If(c, t, e2)    => cs_app(cs_schk_spawn_body(c, fnm, nsvars, mvars), cs_app(cs_schk_spawn_body(t, fnm, nsvars, mvars), cs_schk_spawn_body(e2, fnm, nsvars, mvars)))
    LetIn(nm, v, b) => cs_app(cs_schk_spawn_body(v, fnm, nsvars, mvars), cs_schk_spawn_body(b, fnm, cs_orem(nm, nsvars), cs_orem(nm, mvars)))
    VarIn(nm, v, b) => cs_app(cs_schk_spawn_body(v, fnm, nsvars, mvars), cs_schk_spawn_body(b, fnm, cs_orem(nm, nsvars), cs_orem(nm, mvars)))
    Call(cnm, args) => if cnm == "borrow_mut" then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: cannot capture mutable borrow 'borrow_mut' across 'spawn' in '" + fnm + "'", "transfer ownership with 'own' or synchronize via 'chan[T]'"), Nil) else cs_schk_spawn_args(args, fnm, nsvars, mvars)
    _               => Nil
fn cs_schk_spawn_own(inner, fnm, nsvars) = match inner
    Var(x) => if cs_omem(x, nsvars) == 1 then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: cannot transfer non-Send value '" + x + "' across 'spawn' in '" + fnm + "'", "convert 'rc[T]'/'cell[T]' to 'arc[T]'"), Nil) else Nil
    _      => cs_schk_spawn_body(inner, fnm, nsvars, Nil)
fn cs_schk_spawn_args(args, fnm, nsvars, mvars) = match args
    Nil        => Nil
    Cons(h, t) => cs_app(cs_schk_spawn_body(h, fnm, nsvars, mvars), cs_schk_spawn_args(t, fnm, nsvars, mvars))
fn cs_schk_conc_e(e, fnm, in_scope, nsvars, mvars) = match e
    ScopeE(snm, b)          => cs_schk_conc_e(b, fnm, 1, nsvars, mvars)
    SpawnE(inner)           => let d0 = if in_scope == 0 then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: unstructured 'spawn' in '" + fnm + "' is forbidden outside a lexical 'scope' block", "wrap the task in 'scope s in spawn(...)'"), Nil) else Nil in cs_app(d0, cs_app(cs_schk_spawn_body(inner, fnm, nsvars, mvars), cs_schk_conc_e(inner, fnm, in_scope, nsvars, mvars)))
    ShardE(iv, lo, hi, b)   => cs_app(cs_schk_conc_e(lo, fnm, in_scope, nsvars, mvars), cs_app(cs_schk_conc_e(hi, fnm, in_scope, nsvars, mvars), cs_app(cs_schk_spawn_body(b, fnm, cs_orem(iv, nsvars), cs_orem(iv, mvars)), cs_schk_conc_e(b, fnm, 1, cs_orem(iv, nsvars), cs_orem(iv, mvars)))))
    LetIn(nm, v, b)         => let d1 = cs_schk_conc_e(v, fnm, in_scope, nsvars, mvars) in let ns2 = if cs_sis_nonsend_init(v) == 1 or cs_sis_nonsend_clone(v, nsvars) == 1 then Cons(nm, cs_orem(nm, nsvars)) else cs_orem(nm, nsvars) in cs_app(d1, cs_schk_conc_e(b, fnm, in_scope, ns2, cs_orem(nm, mvars)))
    VarIn(nm, v, b)         => let d1 = cs_schk_conc_e(v, fnm, in_scope, nsvars, mvars) in let ns2 = if cs_sis_nonsend_init(v) == 1 or cs_sis_nonsend_clone(v, nsvars) == 1 then Cons(nm, cs_orem(nm, nsvars)) else cs_orem(nm, nsvars) in cs_app(d1, cs_schk_conc_e(b, fnm, in_scope, ns2, Cons(nm, cs_orem(nm, mvars))))
    Bin(op, l, r)           => cs_app(cs_schk_conc_e(l, fnm, in_scope, nsvars, mvars), cs_schk_conc_e(r, fnm, in_scope, nsvars, mvars))
    If(c, t, e2)            => cs_app(cs_schk_conc_e(c, fnm, in_scope, nsvars, mvars), cs_app(cs_schk_conc_e(t, fnm, in_scope, nsvars, mvars), cs_schk_conc_e(e2, fnm, in_scope, nsvars, mvars)))
    DeferE(c, b)            => cs_app(cs_schk_conc_e(c, fnm, in_scope, nsvars, mvars), cs_schk_conc_e(b, fnm, in_scope, nsvars, mvars))
    ErrDeferE(c, b)         => cs_app(cs_schk_conc_e(c, fnm, in_scope, nsvars, mvars), cs_schk_conc_e(b, fnm, in_scope, nsvars, mvars))
    WithAllocE(a, b)        => cs_app(cs_schk_conc_e(a, fnm, in_scope, nsvars, mvars), cs_schk_conc_e(b, fnm, in_scope, nsvars, mvars))
    WithHandlerE(en, hs, b) => cs_schk_conc_e(b, fnm, in_scope, nsvars, mvars)
    Call(cnm, args)         => if cnm == "spawn_task" then let d0 = if in_scope == 0 then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: unstructured 'spawn_task' in '" + fnm + "' is forbidden outside a lexical 'scope' block", "wrap the task in 'scope s in ...'"), Nil) else Nil in cs_app(d0, cs_schk_spawn_args(args, fnm, nsvars, mvars)) else cs_schk_conc_args(args, fnm, in_scope, nsvars, mvars)
    _                       => Nil
fn cs_schk_conc_args(args, fnm, in_scope, nsvars, mvars) = match args
    Nil        => Nil
    Cons(h, t) => cs_app(cs_schk_conc_e(h, fnm, in_scope, nsvars, mvars), cs_schk_conc_args(t, fnm, in_scope, nsvars, mvars))

## --- Track V: Contract Verification (`requires`/`ensures`/`invariant`/`old`/`law`, `[V0001]`, `proofs`) ---
fn cs_vcollect_rtypes(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_vcollect_rtype1(h, cs_vcollect_rtypes(t))
fn cs_vcollect_rtype1(st, rest) = match st
    TypeRefineS(nm, bty, pr) => Cons({nm: nm, bty: bty, pr: pr}, rest)
    _                        => rest
fn cs_vrtype_lookup(nm, rtypes) = match rtypes
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else cs_vrtype_lookup(nm, t)
fn cs_vsubst_self(e, vnm) = match e
    Var(nm)         => if nm == "self" then Var(vnm) else e
    Bin(op, l, r)   => Bin(op, cs_vsubst_self(l, vnm), cs_vsubst_self(r, vnm))
    If(c, t, e2)    => If(cs_vsubst_self(c, vnm), cs_vsubst_self(t, vnm), cs_vsubst_self(e2, vnm))
    LetIn(nm, v, b) => LetIn(nm, cs_vsubst_self(v, vnm), if nm == "self" then b else cs_vsubst_self(b, vnm))
    Call(cnm, args) => Call(cnm, cs_vsubst_self_args(args, vnm))
    Field(o, fld)   => Field(cs_vsubst_self(o, vnm), fld)
    _               => e
fn cs_vsubst_self_args(xs, vnm) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_vsubst_self(h, vnm), cs_vsubst_self_args(t, vnm))
fn cs_vrefine_preds(ty, vnm, rtypes) = match ty
    TyRefine(bty, pr) => cs_app(cs_vrefine_preds(bty, vnm, rtypes), Cons(cs_vsubst_self(pr, vnm), Nil))
    TyName(tn)        => cs_vrefine_preds_nm(tn, vnm, cs_vrtype_lookup(tn, rtypes), rtypes)
    _                 => Nil
fn cs_vrefine_preds_nm(tn, vnm, m, rtypes) = match m
    Nil         => Nil
    Cons(rt, r) => cs_app(cs_vrefine_preds(rt.bty, vnm, rtypes), Cons(cs_vsubst_self(rt.pr, vnm), Nil))
fn cs_vrefine_param_reqs(ps, ts, rtypes) = match ps
    Nil        => Nil
    Cons(p, r) => cs_vrefine_param_reqs2(p, r, ts, rtypes)
fn cs_vrefine_param_reqs2(p, r, ts, rtypes) = match ts
    Nil          => Nil
    Cons(ty, tr) => cs_app(cs_vrefine_preds(ty, p, rtypes), cs_vrefine_param_reqs(r, tr, rtypes))
fn cs_vmerge_vsig(nm, ps, reqs, enss, vsigs) = if cs_isnil(reqs) == 1 and cs_isnil(enss) == 1 then vsigs else cs_vmerge_vsig2(nm, ps, reqs, enss, vsigs)
fn cs_vmerge_vsig2(nm, ps, reqs, enss, vsigs) = match vsigs
    Nil         => Cons({nm: nm, ps: ps, reqs: reqs, enss: enss}, Nil)
    Cons(v, vr) => if v.nm == nm then Cons({nm: nm, ps: v.ps, reqs: cs_app(reqs, v.reqs), enss: cs_app(enss, v.enss)}, vr) else Cons(v, cs_vmerge_vsig2(nm, ps, reqs, enss, vr))
fn cs_vcollect_vsigs(prog) = cs_vcollect_vsigs_r(prog, cs_vcollect_rtypes(prog), cs_vcollect_vsigs_raw(prog))
fn cs_vcollect_vsigs_raw(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_vcollect_vsig1(h, cs_vcollect_vsigs_raw(t))
fn cs_vcollect_vsig1(st, rest) = match st
    VContractSig(nm, ps, reqs, enss) => Cons({nm: nm, ps: ps, reqs: reqs, enss: enss}, rest)
    _                                => rest
fn cs_vcollect_vsigs_r(prog, rtypes, acc) = match prog
    Nil        => acc
    Cons(h, t) => cs_vcollect_vsigs_r(t, rtypes, cs_vcollect_vsig_sig(h, rtypes, acc))
fn cs_vcollect_vsig_sig(st, rtypes, acc) = match st
    Sig(nm, ps, ts, rt) => cs_vmerge_vsig(nm, ps, cs_vrefine_param_reqs(ps, ts, rtypes), cs_vrefine_preds(rt, "result", rtypes), acc)
    _                   => acc
fn cs_vcollect_invs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_vcollect_inv1(h, cs_vcollect_invs(t))
fn cs_vcollect_inv1(st, rest) = match st
    VTypeInvariant(nm, fs, inv) => Cons({nm: nm, fs: fs, inv: inv}, rest)
    _                           => rest
fn cs_vcollect_laws(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_vcollect_law1(h, cs_vcollect_laws(t))
fn cs_vcollect_law1(st, rest) = match st
    VLawDecl(nm, ps, body) => Cons({nm: nm, ps: ps, body: body}, rest)
    _                      => rest
fn cs_vsiglookup(nm, vsigs) = match vsigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else cs_vsiglookup(nm, t)
fn cs_vinvlookup(nm, invs) = match invs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else cs_vinvlookup(nm, t)
fn cs_vv_int(n) = {ok: 1, i: n, fields: Nil}
fn cs_vv_rec(fs) = {ok: 1, i: 0, fields: fs}
fn cs_vv_err() = {ok: 0, i: 0, fields: Nil}
fn cs_vlookup(nm, env) = match env
    Nil        => cs_vv_err()
    Cons(h, t) => if h.k == nm then h.v else cs_vlookup(nm, t)
fn cs_vflookup(fld, fs) = match fs
    Nil        => cs_vv_err()
    Cons(h, t) => if h.key == fld then h.val else cs_vflookup(fld, t)
fn cs_vbind_ps(ps, vs) = match ps
    Nil        => Nil
    Cons(p, r) => cs_vbind_p1(p, r, vs)
fn cs_vbind_p1(p, r, vs) = match vs
    Nil         => Nil
    Cons(v, vr) => Cons({k: p, v: v}, cs_vbind_ps(r, vr))
fn cs_vfields_env(fs) = match fs
    Nil        => Nil
    Cons(h, t) => Cons({k: h.key, v: h.val}, cs_vfields_env(t))
fn cs_veval_bin(op, rl, rr) = if rl.ok == 0 or rr.ok == 0 then cs_vv_err() else let x = rl.i in let y = rr.i in if op == "+" then cs_vv_int(x + y) else if op == "-" then cs_vv_int(x - y) else if op == "*" then cs_vv_int(x * y) else if op == "/" then (if y == 0 then cs_vv_err() else cs_vv_int(x / y)) else if op == "%" then (if y == 0 then cs_vv_err() else cs_vv_int(x % y)) else if op == "==" then cs_vv_int(if x == y then 1 else 0) else if op == "!=" then cs_vv_int(if x != y then 1 else 0) else if op == "<" then cs_vv_int(if x < y then 1 else 0) else if op == ">" then cs_vv_int(if x > y then 1 else 0) else if op == "<=" then cs_vv_int(if x <= y then 1 else 0) else if op == ">=" then cs_vv_int(if x >= y then 1 else 0) else if op == "and" then cs_vv_int(if x != 0 and y != 0 then 1 else 0) else if op == "or" then cs_vv_int(if x != 0 or y != 0 then 1 else 0) else cs_vv_err()
fn cs_veval(e, env, old_env, ft, d) = if d > 20 then cs_vv_err() else cs_veval1(e, env, old_env, ft, d)
fn cs_veval1(e, env, old_env, ft, d) = match e
    Num(n)                  => cs_vv_int(n)
    Str(s)                  => cs_vv_int(0)
    Var(nm)                 => cs_vlookup(nm, env)
    OwnE(inner)             => cs_veval(inner, env, old_env, ft, d)
    MutE(inner)             => cs_veval(inner, env, old_env, ft, d)
    CT(inner)               => cs_veval(inner, env, old_env, ft, d)
    WithHandlerE(en, hs, b) => cs_veval(b, env, old_env, cs_vadd_hops_ft(hs, ft), d)
    ScopeE(snm, b)          => cs_veval(b, Cons({k: snm, v: cs_vv_int(1)}, env), old_env, ft, d)
    SpawnE(inner)           => cs_veval(inner, env, old_env, ft, d)
    Bin(op, l, r)           => cs_veval_bin(op, cs_veval(l, env, old_env, ft, d), cs_veval(r, env, old_env, ft, d))
    If(c, t, e2)            => let rc = cs_veval(c, env, old_env, ft, d) in if rc.ok == 0 then cs_vv_err() else if rc.i != 0 then cs_veval(t, env, old_env, ft, d) else cs_veval(e2, env, old_env, ft, d)
    LetIn(nm, v, b)         => let rv = cs_veval(v, env, old_env, ft, d) in if rv.ok == 0 then cs_vv_err() else cs_veval(b, Cons({k: nm, v: rv}, env), old_env, ft, d)
    VarIn(nm, v, b)         => let rv = cs_veval(v, env, old_env, ft, d) in if rv.ok == 0 then cs_vv_err() else cs_veval(b, Cons({k: nm, v: rv}, env), old_env, ft, d)
    Rec(items)              => cs_veval_rec(items, env, old_env, ft, d)
    RecT(tn, items)         => cs_veval_rec(items, env, old_env, ft, d)
    Field(o, fld)           => let ro = cs_veval(o, env, old_env, ft, d) in if ro.ok == 0 then cs_vv_err() else cs_vflookup(fld, ro.fields)
    Call(cnm, args)         => cs_veval_call(cnm, args, env, old_env, ft, d)
    _                       => cs_vv_err()
fn cs_veval_rec(items, env, old_env, ft, d) = match items
    Nil        => cs_vv_rec(Nil)
    Cons(h, t) => let rv = cs_veval(h.val, env, old_env, ft, d) in if rv.ok == 0 then cs_vv_err() else let rt = cs_veval_rec(t, env, old_env, ft, d) in if rt.ok == 0 then cs_vv_err() else cs_vv_rec(Cons({key: h.key, val: rv}, rt.fields))
fn cs_veval_args(args, env, old_env, ft, d) = match args
    Nil        => {ok: 1, vals: Nil}
    Cons(h, t) => let rh = cs_veval(h, env, old_env, ft, d) in if rh.ok == 0 then {ok: 0, vals: Nil} else let rt = cs_veval_args(t, env, old_env, ft, d) in if rt.ok == 0 then {ok: 0, vals: Nil} else {ok: 1, vals: Cons(rh, rt.vals)}
fn cs_astsecond(xs) = match xs
    Nil        => Num(0)
    Cons(h, t) => cs_asthead(t)
fn cs_n4_var_name(e) = match e
    Var(nm) => nm
    Str(s)  => s
    _       => ""
fn cs_n4_is_grad_let(e) = match e
    Call(nm, args) => if nm == "grad" and cs_len(args) == 1 then cs_n4_var_name(cs_asthead(args)) else ""
    _              => ""
fn cs_n4_subst_call(e, vnm, gfn) = match e
    Call(cnm, args) => Call(if cnm == vnm then gfn else cnm, cs_n4_subst_args(args, vnm, gfn))
    Bin(op, l, r)   => Bin(op, cs_n4_subst_call(l, vnm, gfn), cs_n4_subst_call(r, vnm, gfn))
    If(c, t, e2)    => If(cs_n4_subst_call(c, vnm, gfn), cs_n4_subst_call(t, vnm, gfn), cs_n4_subst_call(e2, vnm, gfn))
    LetIn(nm, v, b) => LetIn(nm, cs_n4_subst_call(v, vnm, gfn), if nm == vnm then b else cs_n4_subst_call(b, vnm, gfn))
    _               => e
fn cs_n4_subst_args(xs, vnm, gfn) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_n4_subst_call(h, vnm, gfn), cs_n4_subst_args(t, vnm, gfn))
fn cs_vbv_pow2(k) = if k <= 0 then 1 else if k >= 16 then 65536 * cs_vbv_pow2(k - 16) else if k >= 8 then 256 * cs_vbv_pow2(k - 8) else if k >= 4 then 16 * cs_vbv_pow2(k - 4) else 2 * cs_vbv_pow2(k - 1)
fn cs_vbv_mod(x, m) = let r = x % m in if r < 0 then r + m else r
fn cs_vbv_and(x, y, b) = if b <= 0 or x <= 0 or y <= 0 then 0 else ((x % 2) * (y % 2)) + 2 * cs_vbv_and(x / 2, y / 2, b - 1)
fn cs_vbv_or(x, y, b) = if b <= 0 or (x <= 0 and y <= 0) then 0 else (if (x % 2) + (y % 2) >= 1 then 1 else 0) + 2 * cs_vbv_or(x / 2, y / 2, b - 1)
fn cs_vbv_xor(x, y, b) = if b <= 0 or (x <= 0 and y <= 0) then 0 else (((x % 2) + (y % 2)) % 2) + 2 * cs_vbv_xor(x / 2, y / 2, b - 1)
fn cs_veval_arr_lookup(k, ar) = let r = cs_vflookup(k, ar.fields) in if r.ok == 1 then r else let d = cs_vflookup("__def", ar.fields) in if d.ok == 1 then d else cs_vv_int(ar.i)
fn cs_veval_forall_loop(vnm, k, hi, pred, env, ft) = if k > hi then cs_vv_int(1) else let r = cs_veval(pred, Cons({k: vnm, v: cs_vv_int(k)}, env), env, ft, 0) in if r.ok == 0 then cs_vv_err() else if r.i == 0 then cs_vv_int(0) else cs_veval_forall_loop(vnm, k + 1, hi, pred, env, ft)
fn cs_veval_exists_loop(vnm, k, hi, pred, env, ft) = if k > hi then cs_vv_int(0) else let r = cs_veval(pred, Cons({k: vnm, v: cs_vv_int(k)}, env), env, ft, 0) in if r.ok == 0 then cs_vv_err() else if r.i != 0 then cs_vv_int(1) else cs_veval_exists_loop(vnm, k + 1, hi, pred, env, ft)
fn cs_veval_m1_call(cnm, args, env, old_env, ft, d) = if (cnm == "bv_and" or cnm == "bit_and") and cs_len(args) == 2 then (let a = cs_veval(cs_asthead(args), env, old_env, ft, d) in let b = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if a.ok == 0 or b.ok == 0 then cs_vv_err() else cs_vv_int(cs_vbv_and(cs_vbv_mod(a.i, 65536), cs_vbv_mod(b.i, 65536), 16))) else if (cnm == "bv_or" or cnm == "bit_or") and cs_len(args) == 2 then (let a = cs_veval(cs_asthead(args), env, old_env, ft, d) in let b = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if a.ok == 0 or b.ok == 0 then cs_vv_err() else cs_vv_int(cs_vbv_or(cs_vbv_mod(a.i, 65536), cs_vbv_mod(b.i, 65536), 16))) else if (cnm == "bv_xor" or cnm == "bit_xor") and cs_len(args) == 2 then (let a = cs_veval(cs_asthead(args), env, old_env, ft, d) in let b = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if a.ok == 0 or b.ok == 0 then cs_vv_err() else cs_vv_int(cs_vbv_xor(cs_vbv_mod(a.i, 65536), cs_vbv_mod(b.i, 65536), 16))) else if (cnm == "bv_shl" or cnm == "bit_shl") and cs_len(args) == 2 then (let a = cs_veval(cs_asthead(args), env, old_env, ft, d) in let b = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if a.ok == 0 or b.ok == 0 or b.i < 0 then cs_vv_err() else cs_vv_int(a.i * cs_vbv_pow2(b.i))) else if (cnm == "bv_shr" or cnm == "bit_shr") and cs_len(args) == 2 then (let a = cs_veval(cs_asthead(args), env, old_env, ft, d) in let b = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if a.ok == 0 or b.ok == 0 or b.i < 0 then cs_vv_err() else cs_vv_int(a.i / cs_vbv_pow2(b.i))) else if cnm == "bv_u8" and cs_len(args) == 1 then (let a = cs_veval(cs_asthead(args), env, old_env, ft, d) in if a.ok == 0 then cs_vv_err() else cs_vv_int(cs_vbv_mod(a.i, 256))) else if cnm == "bv_not_u8" and cs_len(args) == 1 then (let a = cs_veval(cs_asthead(args), env, old_env, ft, d) in if a.ok == 0 then cs_vv_err() else cs_vv_int(255 - cs_vbv_mod(a.i, 256))) else if cnm == "bv_add_u8" and cs_len(args) == 2 then (let a = cs_veval(cs_asthead(args), env, old_env, ft, d) in let b = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if a.ok == 0 or b.ok == 0 then cs_vv_err() else cs_vv_int(cs_vbv_mod(a.i + b.i, 256))) else if cnm == "bv_sub_u8" and cs_len(args) == 2 then (let a = cs_veval(cs_asthead(args), env, old_env, ft, d) in let b = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if a.ok == 0 or b.ok == 0 then cs_vv_err() else cs_vv_int(cs_vbv_mod(a.i - b.i, 256))) else if cnm == "bv_mul_u8" and cs_len(args) == 2 then (let a = cs_veval(cs_asthead(args), env, old_env, ft, d) in let b = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if a.ok == 0 or b.ok == 0 then cs_vv_err() else cs_vv_int(cs_vbv_mod(a.i * b.i, 256))) else if (cnm == "array_new" or cnm == "array_const") and cs_len(args) == 1 then (let dv = cs_veval(cs_asthead(args), env, old_env, ft, d) in if dv.ok == 0 then cs_vv_err() else cs_vv_rec(Cons({key: "__def", val: dv}, Nil))) else if (cnm == "array_store" or cnm == "heap_write") and cs_len(args) == 3 then (let ar = cs_veval(cs_asthead(args), env, old_env, ft, d) in let ix = cs_veval(cs_astsecond(args), env, old_env, ft, d) in let vl = cs_veval(cs_asthead(cs_cvtl(cs_cvtl(args))), env, old_env, ft, d) in if ar.ok == 0 or ix.ok == 0 or vl.ok == 0 then cs_vv_err() else let d0 = cs_vflookup("__def", ar.fields) in let fs0 = if d0.ok == 1 then ar.fields else Cons({key: "__def", val: cs_vv_int(ar.i)}, ar.fields) in cs_vv_rec(Cons({key: str(ix.i), val: vl}, fs0))) else if (cnm == "array_select" or cnm == "heap_read") and cs_len(args) == 2 then (let ar = cs_veval(cs_asthead(args), env, old_env, ft, d) in let ix = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if ar.ok == 0 or ix.ok == 0 then cs_vv_err() else cs_veval_arr_lookup(str(ix.i), ar)) else if (cnm == "points_to" or cnm == "heap_new") and cs_len(args) == 2 then (let pt = cs_veval(cs_asthead(args), env, old_env, ft, d) in let vl = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if pt.ok == 0 or vl.ok == 0 then cs_vv_err() else cs_vv_rec(Cons({key: str(pt.i), val: vl}, Cons({key: "__dom", val: cs_vv_int(pt.i)}, Cons({key: "__valid", val: cs_vv_int(1)}, Nil))))) else if cnm == "sep_disjoint" and cs_len(args) == 2 then (let p1 = cs_veval(cs_asthead(args), env, old_env, ft, d) in let p2 = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if p1.ok == 0 or p2.ok == 0 then cs_vv_err() else cs_vv_int(if p1.i != p2.i then 1 else 0)) else if cnm == "sep_conj" and cs_len(args) == 2 then (let h1 = cs_veval(cs_asthead(args), env, old_env, ft, d) in let h2 = cs_veval(cs_astsecond(args), env, old_env, ft, d) in if h1.ok == 0 or h2.ok == 0 then cs_vv_err() else let d1 = cs_vflookup("__dom", h1.fields) in let d2 = cs_vflookup("__dom", h2.fields) in let v1 = cs_vflookup("__valid", h1.fields) in let v2 = cs_vflookup("__valid", h2.fields) in let ok_sep = if d1.ok == 1 and d2.ok == 1 and d1.i != d2.i and (v1.ok == 0 or v1.i != 0) and (v2.ok == 0 or v2.i != 0) then 1 else 0 in {ok: 1, i: ok_sep, fields: Cons({key: "__valid", val: cs_vv_int(ok_sep)}, cs_app(h1.fields, h2.fields))}) else if cnm == "sep_valid" and cs_len(args) == 1 then (let h = cs_veval(cs_asthead(args), env, old_env, ft, d) in if h.ok == 0 then cs_vv_err() else let v = cs_vflookup("__valid", h.fields) in if v.ok == 1 then v else cs_vv_int(h.i)) else if cnm == "forall_range" and cs_len(args) == 4 then (let vnm = cs_n4_var_name(cs_asthead(args)) in let lo = cs_veval(cs_astsecond(args), env, old_env, ft, d) in let hi = cs_veval(cs_asthead(cs_cvtl(cs_cvtl(args))), env, old_env, ft, d) in if vnm == "" or lo.ok == 0 or hi.ok == 0 or hi.i - lo.i > 32 then cs_vv_err() else cs_veval_forall_loop(vnm, lo.i, hi.i, cs_asthead(cs_cvtl(cs_cvtl(cs_cvtl(args)))), env, ft)) else if cnm == "exists_range" and cs_len(args) == 4 then (let vnm = cs_n4_var_name(cs_asthead(args)) in let lo = cs_veval(cs_astsecond(args), env, old_env, ft, d) in let hi = cs_veval(cs_asthead(cs_cvtl(cs_cvtl(args))), env, old_env, ft, d) in if vnm == "" or lo.ok == 0 or hi.ok == 0 or hi.i - lo.i > 32 then cs_vv_err() else cs_veval_exists_loop(vnm, lo.i, hi.i, cs_asthead(cs_cvtl(cs_cvtl(cs_cvtl(args)))), env, ft)) else cs_veval_ufn(cs_fnlookup(cnm, ft), cs_veval_args(args, env, old_env, ft, d), ft, d)
fn cs_veval_call(cnm, args, env, old_env, ft, d) = if cnm == "old" and cs_len(args) == 1 then cs_veval(cs_asthead(args), old_env, old_env, ft, d) else if (cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" or cnm == "borrow" or cnm == "borrow_mut" or cnm == "move" or cnm == "clone") and cs_len(args) >= 1 then cs_veval(cs_asthead(args), env, old_env, ft, d) else if cnm == "grad" and cs_len(args) >= 2 then cs_veval_call("__ad_grad_" + cs_n4_var_name(cs_asthead(args)), cs_cvtl(args), env, old_env, ft, d) else if cnm == "jit" and cs_len(args) >= 2 then cs_veval_call(cs_n4_var_name(cs_asthead(args)), cs_cvtl(args), env, old_env, ft, d) else if cnm == "dec_add" and cs_len(args) == 2 then cs_veval_bin("+", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_sub" and cs_len(args) == 2 then cs_veval_bin("-", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_eq" and cs_len(args) == 2 then cs_veval_bin("==", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_lt" and cs_len(args) == 2 then cs_veval_bin("<", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_le" and cs_len(args) == 2 then cs_veval_bin("<=", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_gt" and cs_len(args) == 2 then cs_veval_bin(">", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_ge" and cs_len(args) == 2 then cs_veval_bin(">=", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else cs_veval_m1_call(cnm, args, env, old_env, ft, d)
fn cs_veval_ufn(mf, ra, ft, d) = match mf
    Nil          => cs_vv_err()
    Cons(fn0, r) => if ra.ok == 0 then cs_vv_err() else cs_veval_ufn2(fn0, ra.vals, ft, d)
fn cs_veval_ufn2(fn0, vals, ft, d) = match fn0
    Fn(fnm, ps, body) => let fenv = cs_vbind_ps(ps, vals) in cs_veval(body, fenv, fenv, ft, d + 1)
    _                 => cs_vv_err()
fn cs_vpts_a() = Cons(0, Cons(1, Cons(0 - 1, Nil)))
fn cs_vpts_b() = Cons(0, Cons(1, Nil))
fn cs_vpts_c() = Cons(0, Cons(1, Nil))
fn cs_vpts_for(idx, total) = if total <= 1 then cs_vpts_a() else if total == 2 then cs_vpts_b() else if idx < 5 then cs_vpts_c() else Cons(0, Nil)
fn cs_vgen_envs(ps, idx, total) = match ps
    Nil        => Cons(Nil, Nil)
    Cons(p, r) => cs_vcross_p(p, cs_vpts_for(idx, total), cs_vgen_envs(r, idx + 1, total))
fn cs_vcross_p(p, pts, envs) = match pts
    Nil         => Nil
    Cons(x, xr) => cs_app(cs_vbind_all(p, cs_vv_int(x), envs), cs_vcross_p(p, xr, envs))
fn cs_vbind_all(p, v, envs) = match envs
    Nil         => Nil
    Cons(e, er) => Cons(Cons({k: p, v: v}, e), cs_vbind_all(p, v, er))
fn cs_vfmt_env(env) = match env
    Nil        => ""
    Cons(h, t) => let s = h.k + " = " + str((h.v).i) in if cs_isnil(t) == 1 then s else s + ", " + cs_vfmt_env(t)
fn cs_veval_all_true(es, env, old_env, ft) = match es
    Nil        => {ok: 1, hold: 1}
    Cons(h, t) => let rh = cs_veval(h, env, old_env, ft, 0) in if rh.ok == 0 then {ok: 0, hold: 0} else if rh.i == 0 then {ok: 1, hold: 0} else cs_veval_all_true(t, env, old_env, ft)
fn cs_vprove_envs(envs, reqs, enss, body, ft, undec) = match envs
    Nil          => {status: "runtime_checked", cex: ""}
    Cons(env, r) => let rq = cs_veval_all_true(reqs, env, env, ft) in if rq.ok == 0 then cs_vprove_envs(r, reqs, enss, body, ft, 1) else if rq.hold == 0 then cs_vprove_envs(r, reqs, enss, body, ft, undec) else if cs_isnil(enss) == 1 then cs_vprove_envs(r, reqs, enss, body, ft, undec) else let rb = cs_veval(body, env, env, ft, 0) in if rb.ok == 0 then cs_vprove_envs(r, reqs, enss, body, ft, 1) else let penv = Cons({k: "result", v: rb}, Cons({k: "ret", v: rb}, env)) in let eq = cs_veval_all_true(enss, penv, env, ft) in if eq.ok == 0 then cs_vprove_envs(r, reqs, enss, body, ft, 1) else if eq.hold == 0 then {status: "refuted", cex: cs_vfmt_env(env) + " (result = " + str(rb.i) + ")"} else cs_vprove_envs(r, reqs, enss, body, ft, undec)
fn cs_vprove_law_envs(envs, body, ft, undec) = match envs
    Nil          => {status: "runtime_checked", cex: ""}
    Cons(env, r) => let rb = cs_veval(body, env, env, ft, 0) in if rb.ok == 0 then cs_vprove_law_envs(r, body, ft, 1) else if rb.i == 0 then {status: "refuted", cex: cs_vfmt_env(env)} else cs_vprove_law_envs(r, body, ft, undec)

## --- Stage B: Sound QF_LIA (Quantifier-Free Linear Integer Arithmetic) Decision Procedure (Fourier-Motzkin) ---
fn cs_vlin_const(n) = {ok: 1, c0: n, cs: Nil}
fn cs_vlin_var(nm) = {ok: 1, c0: 0, cs: Cons({k: nm, c: 1}, Nil)}
fn cs_vlin_err() = {ok: 0, c0: 0, cs: Nil}
fn cs_vlin_coeff(nm, cs) = match cs
    Nil        => 0
    Cons(h, t) => if h.k == nm then h.c else cs_vlin_coeff(nm, t)
fn cs_vlin_add_term(nm, c, cs) = if c == 0 then cs else cs_vlin_add_t1(nm, c, cs)
fn cs_vlin_add_t1(nm, c, cs) = match cs
    Nil        => Cons({k: nm, c: c}, Nil)
    Cons(h, t) => if h.k == nm then (if h.c + c == 0 then t else Cons({k: nm, c: h.c + c}, t)) else Cons(h, cs_vlin_add_t1(nm, c, t))
fn cs_vlin_add_cs(cs1, cs2) = match cs1
    Nil        => cs2
    Cons(h, t) => cs_vlin_add_cs(t, cs_vlin_add_term(h.k, h.c, cs2))
fn cs_vlin_scale_cs(k, cs) = if k == 0 then Nil else cs_vlin_scale_cs1(k, cs)
fn cs_vlin_scale_cs1(k, cs) = match cs
    Nil        => Nil
    Cons(h, t) => Cons({k: h.k, c: k * h.c}, cs_vlin_scale_cs1(k, t))
fn cs_vlin_add(a, b) = if a.ok == 0 or b.ok == 0 then cs_vlin_err() else {ok: 1, c0: a.c0 + b.c0, cs: cs_vlin_add_cs(a.cs, b.cs)}
fn cs_vlin_scale(k, a) = if a.ok == 0 then cs_vlin_err() else {ok: 1, c0: k * a.c0, cs: cs_vlin_scale_cs(k, a.cs)}
fn cs_vlin_sub(a, b) = cs_vlin_add(a, cs_vlin_scale(0 - 1, b))
fn cs_vmono_key(k1, k2) = if k1 <= k2 then k1 + "*" + k2 else k2 + "*" + k1
fn cs_vlin_mul_term_cs(k1, c1, cs2) = match cs2
    Nil        => Nil
    Cons(h, t) => cs_vlin_add_term(cs_vmono_key(k1, h.k), c1 * h.c, cs_vlin_mul_term_cs(k1, c1, t))
fn cs_vlin_mul_cs(cs1, cs2) = match cs1
    Nil        => Nil
    Cons(h, t) => cs_vlin_add_cs(cs_vlin_mul_term_cs(h.k, h.c, cs2), cs_vlin_mul_cs(t, cs2))
fn cs_vlin_mul(a, b) = if a.ok == 0 or b.ok == 0 then cs_vlin_err() else if cs_isnil(a.cs) == 1 then cs_vlin_scale(a.c0, b) else if cs_isnil(b.cs) == 1 then cs_vlin_scale(b.c0, a) else let t0 = cs_vlin_add(cs_vlin_scale(a.c0, b), cs_vlin_scale(b.c0, {ok: 1, c0: 0, cs: a.cs})) in {ok: 1, c0: t0.c0, cs: cs_vlin_add_cs(t0.cs, cs_vlin_mul_cs(a.cs, b.cs))}
fn cs_vlin_is_zero(l) = if l.ok == 1 and l.c0 == 0 and cs_isnil(l.cs) == 1 then 1 else 0
fn cs_vlin_eq(a, b) = cs_vlin_is_zero(cs_vlin_sub(a, b))
fn cs_phd_cs(cs) = match cs
    Nil        => {k: "", c: 0}
    Cons(h, t) => h
fn cs_vlin_key_cs(cs) = match cs
    Nil        => ""
    Cons(h, t) => str(h.c) + "*" + h.k + (if cs_isnil(t) == 1 then "" else "+" + cs_vlin_key_cs(t))
fn cs_vlin_key_str(l) = if l.ok == 0 then "?" else if cs_isnil(l.cs) == 1 then str(l.c0) else if l.c0 == 0 and cs_len(l.cs) == 1 and cs_vlin_coeff((cs_phd_cs(l.cs)).k, l.cs) == 1 then (cs_phd_cs(l.cs)).k else str(l.c0) + "+" + cs_vlin_key_cs(l.cs)
fn cs_vlin_is_contra(l) = if l.ok == 1 and cs_isnil(l.cs) == 1 and l.c0 < 0 then 1 else 0
fn cs_vfm_any_contra(hyps) = match hyps
    Nil        => 0
    Cons(h, t) => if cs_vlin_is_contra(h) == 1 then 1 else cs_vfm_any_contra(t)
fn cs_vfm_vars_cs(cs, acc) = match cs
    Nil        => acc
    Cons(h, t) => cs_vfm_vars_cs(t, if cs_omem(h.k, acc) == 1 then acc else Cons(h.k, acc))
fn cs_vfm_vars(hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => cs_vfm_vars(t, cs_vfm_vars_cs(h.cs, acc))
fn cs_vfm_part_pos(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if cs_vlin_coeff(v, h.cs) > 0 then Cons(h, cs_vfm_part_pos(v, t)) else cs_vfm_part_pos(v, t)
fn cs_vfm_part_neg(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if cs_vlin_coeff(v, h.cs) < 0 then Cons(h, cs_vfm_part_neg(v, t)) else cs_vfm_part_neg(v, t)
fn cs_vfm_part_zer(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if cs_vlin_coeff(v, h.cs) == 0 then Cons(h, cs_vfm_part_zer(v, t)) else cs_vfm_part_zer(v, t)
fn cs_vfm_pair1(v, p, cp, negs) = match negs
    Nil        => Nil
    Cons(n, r) => let cn = 0 - cs_vlin_coeff(v, n.cs) in Cons(cs_vlin_add(cs_vlin_scale(cn, p), cs_vlin_scale(cp, n)), cs_vfm_pair1(v, p, cp, r))
fn cs_vfm_pairs(v, pos, negs) = match pos
    Nil        => Nil
    Cons(p, r) => let pairs1 = cs_vfm_pair1(v, p, cs_vlin_coeff(v, p.cs), negs) in if cs_len(pairs1) > 24 then pairs1 else cs_app(pairs1, cs_vfm_pairs(v, r, negs))
fn cs_vfm_elim_var(v, hyps) = cs_app(cs_vfm_part_zer(v, hyps), cs_vfm_pairs(v, cs_vfm_part_pos(v, hyps), cs_vfm_part_neg(v, hyps)))
fn cs_vfm_unsat(hyps, vars) = if cs_vfm_any_contra(hyps) == 1 then 1 else cs_vfm_unsat1(hyps, vars)
fn cs_vfm_unsat1(hyps, vars) = match vars
    Nil        => cs_vfm_any_contra(hyps)
    Cons(v, r) => let next = cs_vfm_elim_var(v, hyps) in if cs_vfm_any_contra(next) == 1 then 1 else if cs_len(next) > 48 then 0 else cs_vfm_unsat(next, r)
fn cs_vfm_check_unsat(hyps) = cs_vfm_unsat(hyps, cs_vfm_vars(hyps, Nil))

## --- Multiplier M1 (#255): QF_NIA / QF_BV / QF_ALIA / Separation Logic in `lcaas` ---
fn cs_vnia_var_lb(v, hyps) = match hyps
    Nil        => 0 - 999999
    Cons(h, t) => let r = cs_vnia_var_lb(v, t) in if cs_len(h.cs) == 1 and cs_vlin_coeff(v, h.cs) == 1 then (let b = 0 - h.c0 in if b > r then b else r) else r
fn cs_vnia_split_star(s, idx, n) = if idx >= n then Nil else if at(s, idx) == "*" then Cons(slice(s, 0, idx), Cons(slice(s, idx + 1, n), Nil)) else cs_vnia_split_star(s, idx + 1, n)
fn cs_vnia_add_bvar(v, acc) = if v == "" or cs_omem(v, acc) == 1 then acc else Cons(v, acc)
fn cs_vnia_add_bvars(vs, acc) = match vs
    Nil        => acc
    Cons(v, r) => cs_vnia_add_bvars(r, cs_vnia_add_bvar(v, acc))
fn cs_vnia_vars_cs(cs, acc) = match cs
    Nil        => acc
    Cons(h, t) => cs_vnia_vars_cs(t, cs_vnia_add_bvars(cs_vnia_split_star(h.k, 0, count(h.k)), acc))
fn cs_vnia_base_vars(hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => cs_vnia_base_vars(t, if cs_len(h.cs) <= 3 then cs_vnia_vars_cs(h.cs, acc) else acc)
fn cs_vnia_sq_hyps(vars) = match vars
    Nil        => Nil
    Cons(v, r) => Cons(cs_vlin_var(cs_vmono_key(v, v)), cs_vnia_sq_hyps(r))
fn cs_vnia_diff_sq_pairs(v1, vars) = match vars
    Nil         => Nil
    Cons(v2, r) => let dv = cs_vlin_sub(cs_vlin_var(v1), cs_vlin_var(v2)) in let sv = cs_vlin_add(cs_vlin_var(v1), cs_vlin_var(v2)) in Cons(cs_vlin_mul(dv, dv), Cons(cs_vlin_mul(sv, sv), cs_vnia_diff_sq_pairs(v1, r)))
fn cs_vnia_all_diff_sq(vars) = match vars
    Nil        => Nil
    Cons(v, r) => cs_app(cs_vnia_diff_sq_pairs(v, r), cs_vnia_all_diff_sq(r))
fn cs_vnia_prod_pair(v1, lb1, vars, hyps) = match vars
    Nil         => Nil
    Cons(v2, r) => let lb2 = cs_vnia_var_lb(v2, hyps) in let rest = cs_vnia_prod_pair(v1, lb1, r, hyps) in if lb1 >= 0 and lb2 >= 0 then Cons({ok: 1, c0: 0 - (lb1 * lb2), cs: Cons({k: cs_vmono_key(v1, v2), c: 1}, Nil)}, Cons(cs_vlin_mul(cs_vlin_sub(cs_vlin_var(v1), cs_vlin_const(lb1)), cs_vlin_sub(cs_vlin_var(v2), cs_vlin_const(lb2))), rest)) else rest
fn cs_vnia_prod_hyps(vars, hyps) = match vars
    Nil         => Nil
    Cons(v1, r) => let lb1 = cs_vnia_var_lb(v1, hyps) in cs_app(if lb1 >= 0 then cs_vnia_prod_pair(v1, lb1, vars, hyps) else Nil, cs_vnia_prod_hyps(r, hyps))
fn cs_vnia_mono_z(x, y, vars, hyps) = match vars
    Nil        => Nil
    Cons(z, r) => let lbz = cs_vnia_var_lb(z, hyps) in let rest = cs_vnia_mono_z(x, y, r, hyps) in if lbz >= 0 then Cons(cs_vlin_sub(cs_vlin_var(cs_vmono_key(x, z)), cs_vlin_var(cs_vmono_key(y, z))), rest) else rest
fn cs_vnia_mono_h1(h, vars, hyps) = if h.c0 <= 0 and cs_len(h.cs) == 2 then (let c1 = cs_phd_cs(h.cs) in let c2 = cs_phd_cs(cs_cvtl_cs(h.cs)) in if c1.c == 1 and c2.c == 0 - 1 then cs_vnia_mono_z(c1.k, c2.k, vars, hyps) else if c2.c == 1 and c1.c == 0 - 1 then cs_vnia_mono_z(c2.k, c1.k, vars, hyps) else Nil) else Nil
fn cs_cvtl_cs(cs) = match cs
    Nil        => Nil
    Cons(h, t) => t
fn cs_vnia_mono_hyps(cur, vars, hyps) = match cur
    Nil        => Nil
    Cons(h, t) => cs_app(cs_vnia_mono_h1(h, vars, hyps), cs_vnia_mono_hyps(t, vars, hyps))
fn cs_vnia_enrich_hyps(goal_hyps, hyps) = let bvars = cs_vnia_base_vars(goal_hyps, cs_vnia_base_vars(hyps, Nil)) in let sqs = if cs_isnil(bvars) == 0 then cs_app(cs_vnia_sq_hyps(bvars), cs_vnia_all_diff_sq(bvars)) else Nil in cs_app(sqs, cs_app(cs_vnia_prod_hyps(bvars, hyps), cs_app(cs_vnia_mono_hyps(hyps, bvars, hyps), hyps)))
fn cs_vlin_div_hyps(la, k, q) = let r = cs_vlin_sub(la, cs_vlin_scale(k, q)) in Cons(r, Cons(cs_vlin_sub(cs_vlin_const(k - 1), r), Nil))
fn cs_vis_struct_call(cnm) = if cnm == "array_new" or cnm == "array_const" or cnm == "array_store" or cnm == "heap_write" or cnm == "points_to" or cnm == "heap_new" or cnm == "sep_conj" then 1 else 0
fn cs_vis_struct_expr(e) = match e
    Call(cnm, args) => cs_vis_struct_call(cnm)
    _               => 0
fn cs_vsep_dom_ptr(e) = match e
    Call(cnm, args) => if (cnm == "points_to" or cnm == "heap_new") and cs_len(args) == 2 then Cons(cs_asthead(args), Nil) else if cnm == "sep_conj" and cs_len(args) == 2 then cs_app(cs_vsep_dom_ptr(cs_asthead(args)), cs_vsep_dom_ptr(cs_astsecond(args))) else if cnm == "heap_write" and cs_len(args) == 3 then cs_vsep_dom_ptr(cs_asthead(args)) else Nil
    _               => Nil
fn cs_vsep_disjoint_one(p, ps, hyps, lenv, ft, d) = match ps
    Nil         => 1
    Cons(q, qr) => if (cs_vprove_goal(Bin(">", p, q), hyps, lenv, ft, d) == 1 or cs_vprove_goal(Bin("<", p, q), hyps, lenv, ft, d) == 1 or cs_vprove_goal(Bin(">=", Bin("*", Bin("-", p, q), Bin("-", p, q)), Num(1)), hyps, lenv, ft, d) == 1) and cs_vsep_disjoint_one(p, qr, hyps, lenv, ft, d) == 1 then 1 else 0
fn cs_vsep_disjoint_lists(ps1, ps2, hyps, lenv, ft, d) = match ps1
    Nil         => 1
    Cons(p, pr) => if cs_vsep_disjoint_one(p, ps2, hyps, lenv, ft, d) == 1 then cs_vsep_disjoint_lists(pr, ps2, hyps, lenv, ft, d) else 0
fn cs_vsep_valid(e, hyps, lenv, ft, d) = match e
    Call(cnm, args) => if (cnm == "points_to" or cnm == "heap_new") and cs_len(args) == 2 then 1 else if cnm == "sep_conj" and cs_len(args) == 2 then (let h1 = cs_asthead(args) in let h2 = cs_astsecond(args) in if cs_vsep_valid(h1, hyps, lenv, ft, d) == 1 and cs_vsep_valid(h2, hyps, lenv, ft, d) == 1 and cs_vsep_disjoint_lists(cs_vsep_dom_ptr(h1), cs_vsep_dom_ptr(h2), hyps, lenv, ft, d) == 1 then 1 else 0) else if cnm == "heap_write" and cs_len(args) == 3 then cs_vsep_valid(cs_asthead(args), hyps, lenv, ft, d) else 0
    _               => 0
fn cs_varr_select(arr_e, idx_e, hyps, lenv, ft, d) = match arr_e
    Call(cnm, args) => if (cnm == "array_store" or cnm == "heap_write") and cs_len(args) == 3 then (let base_a = cs_asthead(args) in let st_i = cs_astsecond(args) in let st_v = cs_asthead(cs_cvtl(cs_cvtl(args))) in if cnm == "heap_write" and cs_vsep_valid(base_a, hyps, lenv, ft, d) == 0 and cs_n4_var_name(base_a) == "" then cs_vlin_err() else if cs_vprove_goal(Bin("==", idx_e, st_i), hyps, lenv, ft, d) == 1 then cs_vlin_expr(st_v, hyps, lenv, ft, d) else if cs_vprove_goal(Bin(">", idx_e, st_i), hyps, lenv, ft, d) == 1 or cs_vprove_goal(Bin("<", idx_e, st_i), hyps, lenv, ft, d) == 1 or cs_vprove_goal(Bin(">=", Bin("*", Bin("-", idx_e, st_i), Bin("-", idx_e, st_i)), Num(1)), hyps, lenv, ft, d) == 1 then cs_varr_select(base_a, idx_e, hyps, lenv, ft, d) else cs_vlin_err()) else if (cnm == "array_new" or cnm == "array_const") and cs_len(args) == 1 then cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d) else if (cnm == "points_to" or cnm == "heap_new") and cs_len(args) == 2 then (if cs_vprove_goal(Bin("==", idx_e, cs_asthead(args)), hyps, lenv, ft, d) == 1 then cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d) else cs_vlin_err()) else if cnm == "sep_conj" and cs_len(args) == 2 then (if cs_vsep_valid(arr_e, hyps, lenv, ft, d) == 0 then cs_vlin_err() else let r1 = cs_varr_select(cs_asthead(args), idx_e, hyps, lenv, ft, d) in if r1.ok == 1 then r1 else cs_varr_select(cs_astsecond(args), idx_e, hyps, lenv, ft, d)) else cs_vlin_err()
    Var(anm)        => let li = cs_vlin_expr(idx_e, hyps, lenv, ft, d) in if li.ok == 0 then cs_vlin_err() else cs_vlin_var("select(" + anm + "," + cs_vlin_key_str(li) + ")")
    _               => cs_vlin_err()
fn cs_vlin_xor_cancel(a, lb, hyps, lenv, ft, d) = match a
    Call(cnm, args) => if (cnm == "bv_xor" or cnm == "bit_xor") and cs_len(args) == 2 then (let x = cs_asthead(args) in let k = cs_astsecond(args) in let lx = cs_vlin_expr(x, hyps, lenv, ft, d) in let lk = cs_vlin_expr(k, hyps, lenv, ft, d) in if lk.ok == 1 and cs_vlin_eq(lk, lb) == 1 then lx else if lx.ok == 1 and cs_vlin_eq(lx, lb) == 1 then lk else cs_vlin_err()) else cs_vlin_err()
    _               => cs_vlin_err()
fn cs_vlin_and_idem(a, lb, hyps, lenv, ft, d) = match a
    Call(cnm, args) => if (cnm == "bv_and" or cnm == "bit_and") and cs_len(args) == 2 then (let lk = cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d) in if lk.ok == 1 and cs_vlin_eq(lk, lb) == 1 then cs_vlin_expr(a, hyps, lenv, ft, d) else cs_vlin_err()) else cs_vlin_err()
    _               => cs_vlin_err()
fn cs_vlin_bv_xor(a, b, hyps, lenv, ft, d) = let la = cs_vlin_expr(a, hyps, lenv, ft, d) in let lb = cs_vlin_expr(b, hyps, lenv, ft, d) in if la.ok == 0 or lb.ok == 0 then cs_vlin_err() else if cs_vlin_eq(la, lb) == 1 then cs_vlin_const(0) else if cs_vlin_is_zero(la) == 1 then lb else if cs_vlin_is_zero(lb) == 1 then la else if cs_isnil(la.cs) == 1 and cs_isnil(lb.cs) == 1 then cs_vlin_const(cs_vbv_xor(cs_vbv_mod(la.c0, 65536), cs_vbv_mod(lb.c0, 65536), 16)) else let cx = cs_vlin_xor_cancel(a, lb, hyps, lenv, ft, d) in if cx.ok == 1 then cx else let cy = cs_vlin_xor_cancel(b, la, hyps, lenv, ft, d) in if cy.ok == 1 then cy else cs_vlin_var("bv_xor(" + cs_vmono_key(cs_vlin_key_str(la), cs_vlin_key_str(lb)) + ")")
fn cs_vlin_bv_and(a, b, hyps, lenv, ft, d) = let la = cs_vlin_expr(a, hyps, lenv, ft, d) in let lb = cs_vlin_expr(b, hyps, lenv, ft, d) in if la.ok == 0 or lb.ok == 0 then cs_vlin_err() else if cs_vlin_is_zero(la) == 1 or cs_vlin_is_zero(lb) == 1 then cs_vlin_const(0) else if cs_vlin_eq(la, lb) == 1 then la else if cs_isnil(la.cs) == 1 and cs_isnil(lb.cs) == 1 then cs_vlin_const(cs_vbv_and(cs_vbv_mod(la.c0, 65536), cs_vbv_mod(lb.c0, 65536), 16)) else let ci = cs_vlin_and_idem(a, lb, hyps, lenv, ft, d) in if ci.ok == 1 then ci else if cs_isnil(lb.cs) == 1 and (lb.c0 == 1 or lb.c0 == 3 or lb.c0 == 7 or lb.c0 == 15 or lb.c0 == 31 or lb.c0 == 63 or lb.c0 == 127 or lb.c0 == 255) then (if cs_vfm_check_unsat(Cons(cs_vlin_sub(cs_vlin_const(0 - 1), la), hyps)) == 1 and cs_vfm_check_unsat(Cons(cs_vlin_sub(la, cs_vlin_const(lb.c0 + 1)), hyps)) == 1 then la else cs_vlin_sub(la, cs_vlin_scale(lb.c0 + 1, cs_vlin_var("div(" + cs_vlin_key_str(la) + "," + str(lb.c0 + 1) + ")")))) else cs_vlin_var("bv_and(" + cs_vmono_key(cs_vlin_key_str(la), cs_vlin_key_str(lb)) + ")")
fn cs_vlin_bv_or(a, b, hyps, lenv, ft, d) = let la = cs_vlin_expr(a, hyps, lenv, ft, d) in let lb = cs_vlin_expr(b, hyps, lenv, ft, d) in if la.ok == 0 or lb.ok == 0 then cs_vlin_err() else if cs_vlin_is_zero(la) == 1 then lb else if cs_vlin_is_zero(lb) == 1 then la else if cs_vlin_eq(la, lb) == 1 then la else if cs_isnil(la.cs) == 1 and cs_isnil(lb.cs) == 1 then cs_vlin_const(cs_vbv_or(cs_vbv_mod(la.c0, 65536), cs_vbv_mod(lb.c0, 65536), 16)) else cs_vlin_var("bv_or(" + cs_vmono_key(cs_vlin_key_str(la), cs_vlin_key_str(lb)) + ")")
fn cs_vlin_bv_u8(a, hyps, lenv, ft, d) = let la = cs_vlin_expr(a, hyps, lenv, ft, d) in if la.ok == 0 then cs_vlin_err() else if cs_isnil(la.cs) == 1 then cs_vlin_const(cs_vbv_mod(la.c0, 256)) else if cs_vfm_check_unsat(Cons(cs_vlin_sub(cs_vlin_const(0 - 1), la), hyps)) == 1 and cs_vfm_check_unsat(Cons(cs_vlin_sub(la, cs_vlin_const(256)), hyps)) == 1 then la else if cs_vfm_check_unsat(Cons(cs_vlin_sub(cs_vlin_const(255), la), hyps)) == 1 and cs_vfm_check_unsat(Cons(cs_vlin_sub(la, cs_vlin_const(512)), hyps)) == 1 then cs_vlin_sub(la, cs_vlin_const(256)) else cs_vlin_sub(la, cs_vlin_scale(256, cs_vlin_var("div(" + cs_vlin_key_str(la) + ",256)")))
fn cs_vcollect_div_hyps_e(e, hyps, lenv, ft, d) = match e
    Bin(op, a, b)   => let h1 = cs_app(cs_vcollect_div_hyps_e(a, hyps, lenv, ft, d), cs_vcollect_div_hyps_e(b, hyps, lenv, ft, d)) in if (op == "/" or op == "%") then (let la = cs_vlin_expr(a, hyps, lenv, ft, d) in let lb = cs_vlin_expr(b, hyps, lenv, ft, d) in if la.ok == 1 and lb.ok == 1 and cs_isnil(lb.cs) == 1 and lb.c0 > 0 then cs_app(cs_vlin_div_hyps(la, lb.c0, cs_vlin_var("div(" + cs_vlin_key_str(la) + "," + str(lb.c0) + ")")), h1) else h1) else h1
    Call(cnm, args) => let h1 = cs_vcollect_div_hyps_args(args, hyps, lenv, ft, d) in if (cnm == "bv_and" or cnm == "bit_and") and cs_len(args) == 2 then (let la = cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d) in let lb = cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d) in if la.ok == 1 and lb.ok == 1 and cs_isnil(lb.cs) == 1 and (lb.c0 == 1 or lb.c0 == 3 or lb.c0 == 7 or lb.c0 == 15 or lb.c0 == 31 or lb.c0 == 63 or lb.c0 == 127 or lb.c0 == 255) then cs_app(cs_vlin_div_hyps(la, lb.c0 + 1, cs_vlin_var("div(" + cs_vlin_key_str(la) + "," + str(lb.c0 + 1) + ")")), h1) else h1) else if (cnm == "bv_u8" or cnm == "bv_not_u8") and cs_len(args) == 1 then (let la = cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d) in if la.ok == 1 then cs_app(cs_vlin_div_hyps(la, 256, cs_vlin_var("div(" + cs_vlin_key_str(la) + ",256)")), h1) else h1) else if cnm == "bv_add_u8" and cs_len(args) == 2 then (let la = cs_vlin_expr(Bin("+", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) in if la.ok == 1 then cs_app(cs_vlin_div_hyps(la, 256, cs_vlin_var("div(" + cs_vlin_key_str(la) + ",256)")), h1) else h1) else h1
    If(c, t, e2)    => cs_app(cs_vcollect_div_hyps_e(c, hyps, lenv, ft, d), cs_app(cs_vcollect_div_hyps_e(t, hyps, lenv, ft, d), cs_vcollect_div_hyps_e(e2, hyps, lenv, ft, d)))
    LetIn(nm, v, b) => cs_app(cs_vcollect_div_hyps_e(v, hyps, lenv, ft, d), cs_vcollect_div_hyps_e(b, hyps, lenv, ft, d))
    _               => Nil
fn cs_vcollect_div_hyps_args(xs, hyps, lenv, ft, d) = match xs
    Nil        => Nil
    Cons(h, t) => cs_app(cs_vcollect_div_hyps_e(h, hyps, lenv, ft, d), cs_vcollect_div_hyps_args(t, hyps, lenv, ft, d))

fn cs_vlin_init_env(ps) = match ps
    Nil        => Nil
    Cons(p, r) => Cons({k: p, v: cs_vlin_var(p)}, cs_vlin_init_env(r))
fn cs_vlin_lookup(nm, lenv) = match lenv
    Nil        => cs_vlin_err()
    Cons(h, t) => if h.k == nm then h.v else cs_vlin_lookup(nm, t)
fn cs_vlin_bind_ps(ps, vs) = match ps
    Nil        => Nil
    Cons(p, r) => cs_vlin_bind_p1(p, r, vs)
fn cs_vlin_bind_p1(p, r, vs) = match vs
    Nil         => Nil
    Cons(v, vr) => Cons({k: p, v: v}, cs_vlin_bind_ps(r, vr))
fn cs_vlin_bin_op(op, l, r, hyps, lenv, ft, d) = let la = cs_vlin_expr(l, hyps, lenv, ft, d) in let lb = cs_vlin_expr(r, hyps, lenv, ft, d) in if op == "+" then cs_vlin_add(la, lb) else if op == "-" then cs_vlin_sub(la, lb) else if op == "*" then cs_vlin_mul(la, lb) else if op == "/" then (if la.ok == 0 or lb.ok == 0 then cs_vlin_err() else if cs_isnil(lb.cs) == 1 and lb.c0 > 0 then (if cs_isnil(la.cs) == 1 then cs_vlin_const(la.c0 / lb.c0) else cs_vlin_var("div(" + cs_vlin_key_str(la) + "," + str(lb.c0) + ")")) else cs_vlin_err()) else if op == "%" then (if la.ok == 0 or lb.ok == 0 then cs_vlin_err() else if cs_isnil(lb.cs) == 1 and lb.c0 > 0 then (if cs_isnil(la.cs) == 1 then cs_vlin_const(la.c0 % lb.c0) else cs_vlin_sub(la, cs_vlin_scale(lb.c0, cs_vlin_var("div(" + cs_vlin_key_str(la) + "," + str(lb.c0) + ")")))) else cs_vlin_err()) else cs_vlin_err()
fn cs_vlin_expr(e, hyps, lenv, ft, d) = if d > 6 then cs_vlin_err() else cs_vlin_expr1(e, hyps, lenv, ft, d)
fn cs_vlin_expr1(e, hyps, lenv, ft, d) = match e
    Num(n)          => cs_vlin_const(n)
    Var(nm)         => cs_vlin_lookup(nm, lenv)
    OwnE(inner)     => cs_vlin_expr(inner, hyps, lenv, ft, d)
    MutE(inner)     => cs_vlin_expr(inner, hyps, lenv, ft, d)
    CT(inner)       => cs_vlin_expr(inner, hyps, lenv, ft, d)
    DeferE(c, b)    => cs_vlin_expr(b, hyps, lenv, ft, d)
    ErrDeferE(c, b) => cs_vlin_expr(b, hyps, lenv, ft, d)
    LetIn(nm, v, b) => let gfn = cs_n4_is_grad_let(v) in if gfn != "" then cs_vlin_expr(cs_n4_subst_call(b, nm, "__ad_grad_" + gfn), hyps, lenv, ft, d) else if cs_vis_struct_expr(v) == 1 then cs_vlin_expr(cs_temp_subst_var(b, nm, v), hyps, lenv, ft, d) else let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then cs_vlin_err() else cs_vlin_expr(b, hyps, Cons({k: nm, v: lv}, lenv), ft, d)
    VarIn(nm, v, b) => if cs_vis_struct_expr(v) == 1 then cs_vlin_expr(cs_temp_subst_var(b, nm, v), hyps, lenv, ft, d) else let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then cs_vlin_err() else cs_vlin_expr(b, hyps, Cons({k: nm, v: lv}, lenv), ft, d)
    Bin(op, l, r)   => cs_vlin_bin_op(op, l, r, hyps, lenv, ft, d)
    If(c, t, e2)    => let rp = cs_vcond_pos(c, hyps, lenv, ft, d) in let rn = cs_vcond_neg(c, hyps, lenv, ft, d) in if rp.ok == 1 and rn.ok == 1 and cs_vfm_check_unsat(cs_app(rn.hyps, hyps)) == 1 then cs_vlin_expr(t, hyps, lenv, ft, d) else if rp.ok == 1 and rn.ok == 1 and cs_vfm_check_unsat(cs_app(rp.hyps, hyps)) == 1 then cs_vlin_expr(e2, hyps, lenv, ft, d) else cs_vlin_err()
    Call(cnm, args) => cs_vlin_call(cnm, args, hyps, lenv, ft, d)
    _               => cs_vlin_err()
fn cs_vlin_args(args, hyps, lenv, ft, d) = match args
    Nil        => {ok: 1, vals: Nil}
    Cons(h, t) => let rh = cs_vlin_expr(h, hyps, lenv, ft, d) in if rh.ok == 0 then {ok: 0, vals: Nil} else let rt = cs_vlin_args(t, hyps, lenv, ft, d) in if rt.ok == 0 then {ok: 0, vals: Nil} else {ok: 1, vals: Cons(rh, rt.vals)}
fn cs_vlin_m1_call(cnm, args, hyps, lenv, ft, d) = if (cnm == "bv_xor" or cnm == "bit_xor") and cs_len(args) == 2 then cs_vlin_bv_xor(cs_asthead(args), cs_astsecond(args), hyps, lenv, ft, d) else if (cnm == "bv_and" or cnm == "bit_and") and cs_len(args) == 2 then cs_vlin_bv_and(cs_asthead(args), cs_astsecond(args), hyps, lenv, ft, d) else if (cnm == "bv_or" or cnm == "bit_or") and cs_len(args) == 2 then cs_vlin_bv_or(cs_asthead(args), cs_astsecond(args), hyps, lenv, ft, d) else if (cnm == "bv_shl" or cnm == "bit_shl") and cs_len(args) == 2 then (let lk = cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d) in if lk.ok == 1 and cs_isnil(lk.cs) == 1 and lk.c0 >= 0 then cs_vlin_scale(cs_vbv_pow2(lk.c0), cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d)) else cs_vlin_err()) else if (cnm == "bv_shr" or cnm == "bit_shr") and cs_len(args) == 2 then (let lk = cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d) in if lk.ok == 1 and cs_isnil(lk.cs) == 1 and lk.c0 >= 0 then cs_vlin_bin_op("/", cs_asthead(args), Num(cs_vbv_pow2(lk.c0)), hyps, lenv, ft, d) else cs_vlin_err()) else if cnm == "bv_u8" and cs_len(args) == 1 then cs_vlin_bv_u8(cs_asthead(args), hyps, lenv, ft, d) else if cnm == "bv_not_u8" and cs_len(args) == 1 then cs_vlin_sub(cs_vlin_const(255), cs_vlin_bv_u8(cs_asthead(args), hyps, lenv, ft, d)) else if cnm == "bv_add_u8" and cs_len(args) == 2 then cs_vlin_bv_u8(Bin("+", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "bv_sub_u8" and cs_len(args) == 2 then cs_vlin_bv_u8(Bin("-", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if (cnm == "array_select" or cnm == "heap_read") and cs_len(args) == 2 then cs_varr_select(cs_asthead(args), cs_astsecond(args), hyps, lenv, ft, d) else if cnm == "sep_valid" and cs_len(args) == 1 then (if cs_vsep_valid(cs_asthead(args), hyps, lenv, ft, d) == 1 then cs_vlin_const(1) else cs_vlin_err()) else if cnm == "sep_disjoint" and cs_len(args) == 2 then (if cs_vprove_goal(Bin("!=", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) == 1 then cs_vlin_const(1) else cs_vlin_err()) else if cnm == "forall_range" and cs_len(args) == 4 then (if cs_vprove_forall_range(args, hyps, lenv, ft, d) == 1 then cs_vlin_const(1) else cs_vlin_err()) else if cnm == "exists_range" and cs_len(args) == 4 then (if cs_vprove_exists_range(args, hyps, lenv, ft, d) == 1 then cs_vlin_const(1) else cs_vlin_err()) else cs_vlin_ufn(cs_fnlookup(cnm, ft), cs_vlin_args(args, hyps, lenv, ft, d), hyps, ft, d)
fn cs_vlin_call(cnm, args, hyps, lenv, ft, d) = if cnm == "old" and cs_len(args) == 1 then cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d) else if (cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" or cnm == "borrow" or cnm == "borrow_mut" or cnm == "move" or cnm == "clone") and cs_len(args) >= 1 then cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d) else if cnm == "grad" and cs_len(args) >= 2 then cs_vlin_call("__ad_grad_" + cs_n4_var_name(cs_asthead(args)), cs_cvtl(args), hyps, lenv, ft, d) else if cnm == "jvp" and cs_len(args) == 3 then cs_vlin_mul(cs_vlin_call("__ad_grad_" + cs_n4_var_name(cs_asthead(args)), Cons(cs_astsecond(args), Nil), hyps, lenv, ft, d), cs_vlin_expr(cs_asthead(cs_cvtl(cs_cvtl(args))), hyps, lenv, ft, d)) else if cnm == "vjp" and cs_len(args) == 3 then cs_vlin_mul(cs_vlin_expr(cs_asthead(cs_cvtl(cs_cvtl(args))), hyps, lenv, ft, d), cs_vlin_call("__ad_grad_" + cs_n4_var_name(cs_asthead(args)), Cons(cs_astsecond(args), Nil), hyps, lenv, ft, d)) else if cnm == "jit" and cs_len(args) >= 2 then cs_vlin_call(cs_n4_var_name(cs_asthead(args)), cs_cvtl(args), hyps, lenv, ft, d) else if cnm == "dec_add" and cs_len(args) == 2 then cs_vlin_add(cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_sub" and cs_len(args) == 2 then cs_vlin_sub(cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else cs_vlin_m1_call(cnm, args, hyps, lenv, ft, d)
fn cs_vlin_ufn(mf, ra, hyps, ft, d) = match mf
    Nil          => cs_vlin_err()
    Cons(fn0, r) => if ra.ok == 0 then cs_vlin_err() else cs_vlin_ufn2(fn0, ra.vals, hyps, ft, d)
fn cs_vlin_ufn2(fn0, vals, hyps, ft, d) = match fn0
    Fn(fnm, ps, body) => cs_vlin_expr(body, hyps, cs_vlin_bind_ps(ps, vals), ft, d + 1)
    _                 => cs_vlin_err()
fn cs_vcond_cmp_pos(op, la, lb) = if la.ok == 0 or lb.ok == 0 then {ok: 0, hyps: Nil} else if op == ">=" then {ok: 1, hyps: Cons(cs_vlin_sub(la, lb), Nil)} else if op == ">" then {ok: 1, hyps: Cons(cs_vlin_sub(cs_vlin_sub(la, lb), cs_vlin_const(1)), Nil)} else if op == "<=" then {ok: 1, hyps: Cons(cs_vlin_sub(lb, la), Nil)} else if op == "<" then {ok: 1, hyps: Cons(cs_vlin_sub(cs_vlin_sub(lb, la), cs_vlin_const(1)), Nil)} else if op == "==" then {ok: 1, hyps: Cons(cs_vlin_sub(la, lb), Cons(cs_vlin_sub(lb, la), Nil))} else if op == "!=" then (let d = cs_vlin_sub(la, lb) in {ok: 1, hyps: Cons(cs_vlin_sub(cs_vlin_mul(d, d), cs_vlin_const(1)), Nil)}) else {ok: 0, hyps: Nil}
fn cs_vcond_cmp_neg(op, la, lb) = if la.ok == 0 or lb.ok == 0 then {ok: 0, hyps: Nil} else if op == ">=" then cs_vcond_cmp_pos("<", la, lb) else if op == ">" then cs_vcond_cmp_pos("<=", la, lb) else if op == "<=" then cs_vcond_cmp_pos(">", la, lb) else if op == "<" then cs_vcond_cmp_pos(">=", la, lb) else if op == "!=" then cs_vcond_cmp_pos("==", la, lb) else if op == "==" then cs_vcond_cmp_pos("!=", la, lb) else {ok: 0, hyps: Nil}
fn cs_vcond_pos(e, hyps, lenv, ft, d) = match e
    Bin(op, a, b)   => if op == "and" then (let r1 = cs_vcond_pos(a, hyps, lenv, ft, d) in let r2 = cs_vcond_pos(b, hyps, lenv, ft, d) in if r1.ok == 1 and r2.ok == 1 then {ok: 1, hyps: cs_app(r1.hyps, r2.hyps)} else {ok: 0, hyps: Nil}) else cs_vcond_cmp_pos(op, cs_vlin_expr(a, hyps, lenv, ft, d), cs_vlin_expr(b, hyps, lenv, ft, d))
    Call(cnm, args) => if cnm == "dec_eq" and cs_len(args) == 2 then cs_vcond_cmp_pos("==", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_ge" and cs_len(args) == 2 then cs_vcond_cmp_pos(">=", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_gt" and cs_len(args) == 2 then cs_vcond_cmp_pos(">", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_le" and cs_len(args) == 2 then cs_vcond_cmp_pos("<=", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_lt" and cs_len(args) == 2 then cs_vcond_cmp_pos("<", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "sep_disjoint" and cs_len(args) == 2 then cs_vcond_cmp_neg("==", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else {ok: 0, hyps: Nil}
    _               => {ok: 0, hyps: Nil}
fn cs_vcond_neg(e, hyps, lenv, ft, d) = match e
    Bin(op, a, b)   => cs_vcond_cmp_neg(op, cs_vlin_expr(a, hyps, lenv, ft, d), cs_vlin_expr(b, hyps, lenv, ft, d))
    Call(cnm, args) => if cnm == "dec_ge" and cs_len(args) == 2 then cs_vcond_cmp_neg(">=", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_gt" and cs_len(args) == 2 then cs_vcond_cmp_neg(">", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_le" and cs_len(args) == 2 then cs_vcond_cmp_neg("<=", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_lt" and cs_len(args) == 2 then cs_vcond_cmp_neg("<", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "sep_disjoint" and cs_len(args) == 2 then cs_vcond_cmp_pos("==", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else {ok: 0, hyps: Nil}
    _               => {ok: 0, hyps: Nil}
fn cs_vprove_reqs_hyps(reqs, lenv, ft) = match reqs
    Nil        => {ok: 1, hyps: Nil}
    Cons(h, t) => let r1 = cs_vcond_pos(h, Nil, lenv, ft, 0) in if r1.ok == 0 then {ok: 0, hyps: Nil} else let r2 = cs_vprove_reqs_hyps(t, lenv, ft) in if r2.ok == 0 then {ok: 0, hyps: Nil} else {ok: 1, hyps: cs_app(r1.hyps, r2.hyps)}
fn cs_vprove_let_val(nm, v, b, hyps, lenv, ft) = match v
    If(c, t, e2) => let rp = cs_vcond_pos(c, hyps, lenv, ft, 0) in let rn = cs_vcond_neg(c, hyps, lenv, ft, 0) in if rp.ok == 1 and rn.ok == 1 and cs_vprove_let_val(nm, t, b, cs_app(rp.hyps, hyps), lenv, ft) == 1 and cs_vprove_let_val(nm, e2, b, cs_app(rn.hyps, hyps), lenv, ft) == 1 then 1 else 0
    _            => if cs_vis_struct_expr(v) == 1 then cs_vprove_goal(cs_temp_subst_var(b, nm, v), hyps, lenv, ft, 0) else let lv = cs_vlin_expr(v, hyps, lenv, ft, 0) in if lv.ok == 0 then 0 else cs_vprove_goal(b, cs_app(cs_vcollect_div_hyps_e(v, hyps, lenv, ft, 0), hyps), Cons({k: nm, v: lv}, lenv), ft, 0)
fn cs_vprove_forall_range(args, hyps, lenv, ft, d) = let vnm = cs_n4_var_name(cs_asthead(args)) in let lo_e = cs_astsecond(args) in let hi_e = cs_asthead(cs_cvtl(cs_cvtl(args))) in let pred_e = cs_asthead(cs_cvtl(cs_cvtl(cs_cvtl(args)))) in let llo = cs_vlin_expr(lo_e, hyps, lenv, ft, d) in let lhi = cs_vlin_expr(hi_e, hyps, lenv, ft, d) in if vnm == "" or llo.ok == 0 or lhi.ok == 0 then 0 else let lv = cs_vlin_var("_q_" + vnm) in let hyps2 = Cons(cs_vlin_sub(lv, llo), Cons(cs_vlin_sub(lhi, lv), hyps)) in cs_vprove_goal(pred_e, hyps2, Cons({k: vnm, v: lv}, lenv), ft, d + 1)
fn cs_vprove_exists_w(vnm, w, lo_e, hi_e, pred_e, ctx) = if cs_vprove_goal(Bin(">=", w, lo_e), ctx.hyps, ctx.lenv, ctx.ft, ctx.d) == 1 and cs_vprove_goal(Bin("<=", w, hi_e), ctx.hyps, ctx.lenv, ctx.ft, ctx.d) == 1 and cs_vprove_goal(cs_temp_subst_var(pred_e, vnm, w), ctx.hyps, ctx.lenv, ctx.ft, ctx.d) == 1 then 1 else 0
fn cs_vprove_exists_list(vnm, ws, lo_e, hi_e, pred_e, ctx) = match ws
    Nil         => 0
    Cons(w, wr) => if cs_vprove_exists_w(vnm, w, lo_e, hi_e, pred_e, ctx) == 1 then 1 else cs_vprove_exists_list(vnm, wr, lo_e, hi_e, pred_e, ctx)
fn cs_vprove_exists_range(args, hyps, lenv, ft, d) = let vnm = cs_n4_var_name(cs_asthead(args)) in let lo_e = cs_astsecond(args) in let hi_e = cs_asthead(cs_cvtl(cs_cvtl(args))) in let pred_e = cs_asthead(cs_cvtl(cs_cvtl(cs_cvtl(args)))) in if vnm == "" then 0 else let ws = Cons(lo_e, Cons(hi_e, Cons(Bin("+", lo_e, Num(1)), Cons(Bin("-", hi_e, Num(1)), Cons(Bin("/", Bin("+", lo_e, hi_e), Num(2)), Nil))))) in cs_vprove_exists_list(vnm, ws, lo_e, hi_e, pred_e, {hyps: hyps, lenv: lenv, ft: ft, d: d + 1})
fn cs_vprove_goal(g, hyps, lenv, ft, d) = match g
    Num(n)          => if n != 0 then 1 else 0
    LetIn(nm, v, b) => let gfn = cs_n4_is_grad_let(v) in if gfn != "" then cs_vprove_goal(cs_n4_subst_call(b, nm, "__ad_grad_" + gfn), hyps, lenv, ft, d) else cs_vprove_let_val(nm, v, b, hyps, lenv, ft)
    VarIn(nm, v, b) => cs_vprove_let_val(nm, v, b, hyps, lenv, ft)
    DeferE(c, b)    => cs_vprove_goal(b, hyps, lenv, ft, d)
    ErrDeferE(c, b) => cs_vprove_goal(b, hyps, lenv, ft, d)
    If(c, t, e2)    => let rp = cs_vcond_pos(c, hyps, lenv, ft, d) in let rn = cs_vcond_neg(c, hyps, lenv, ft, d) in if rp.ok == 1 and cs_vprove_goal(t, cs_app(rp.hyps, hyps), lenv, ft, d) == 1 and (cs_vprove_goal(e2, hyps, lenv, ft, d) == 1 or (rn.ok == 1 and cs_vprove_goal(e2, cs_app(rn.hyps, hyps), lenv, ft, d) == 1)) then 1 else 0
    Bin(op, a, b)   => if op == "and" then (if cs_vprove_goal(a, hyps, lenv, ft, d) == 1 and cs_vprove_goal(b, hyps, lenv, ft, d) == 1 then 1 else 0) else if op == "or" then (if cs_vprove_goal(a, hyps, lenv, ft, d) == 1 or cs_vprove_goal(b, hyps, lenv, ft, d) == 1 then 1 else let rna = cs_vcond_neg(a, hyps, lenv, ft, d) in if rna.ok == 1 and cs_vprove_goal(b, cs_app(rna.hyps, hyps), lenv, ft, d) == 1 then 1 else let rnb = cs_vcond_neg(b, hyps, lenv, ft, d) in if rnb.ok == 1 and cs_vprove_goal(a, cs_app(rnb.hyps, hyps), lenv, ft, d) == 1 then 1 else 0) else if op == "==" then (if cs_vprove_goal(Bin(">=", a, b), hyps, lenv, ft, d) == 1 and cs_vprove_goal(Bin("<=", a, b), hyps, lenv, ft, d) == 1 then 1 else 0) else if op == "!=" then (if cs_vprove_goal(Bin(">", a, b), hyps, lenv, ft, d) == 1 or cs_vprove_goal(Bin("<", a, b), hyps, lenv, ft, d) == 1 or cs_vprove_goal(Bin(">=", Bin("*", Bin("-", a, b), Bin("-", a, b)), Num(1)), hyps, lenv, ft, d) == 1 then 1 else 0) else (let dhyps = cs_app(cs_vcollect_div_hyps_e(g, hyps, lenv, ft, d), hyps) in let rn = cs_vcond_neg(g, dhyps, lenv, ft, d) in if rn.ok == 1 then cs_vfm_check_unsat(cs_app(rn.hyps, cs_vnia_enrich_hyps(rn.hyps, dhyps))) else 0)
    Call(cnm, args) => if cnm == "dec_eq" and cs_len(args) == 2 then cs_vprove_goal(Bin("==", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "dec_ge" and cs_len(args) == 2 then cs_vprove_goal(Bin(">=", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "dec_gt" and cs_len(args) == 2 then cs_vprove_goal(Bin(">", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "dec_le" and cs_len(args) == 2 then cs_vprove_goal(Bin("<=", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "dec_lt" and cs_len(args) == 2 then cs_vprove_goal(Bin("<", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "sep_disjoint" and cs_len(args) == 2 then cs_vprove_goal(Bin("!=", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "sep_valid" and cs_len(args) == 1 then cs_vsep_valid(cs_asthead(args), hyps, lenv, ft, d) else if cnm == "sep_conj" and cs_len(args) == 2 then cs_vsep_valid(g, hyps, lenv, ft, d) else if cnm == "forall_range" and cs_len(args) == 4 then cs_vprove_forall_range(args, hyps, lenv, ft, d) else if cnm == "exists_range" and cs_len(args) == 4 then cs_vprove_exists_range(args, hyps, lenv, ft, d) else 0
    _               => 0
fn cs_vprove_goals_all(enss, hyps, lenv, ft, d) = match enss
    Nil        => 1
    Cons(h, t) => if cs_vprove_goal(h, hyps, lenv, ft, d) == 1 then cs_vprove_goals_all(t, hyps, lenv, ft, d) else 0
fn cs_vprove_body(body, hyps, lenv, enss, ft, d) = match body
    LetIn(nm, v, b) => let gfn = cs_n4_is_grad_let(v) in if gfn != "" then cs_vprove_body(cs_n4_subst_call(b, nm, "__ad_grad_" + gfn), hyps, lenv, enss, ft, d) else if cs_vis_struct_expr(v) == 1 then cs_vprove_body(cs_temp_subst_var(b, nm, v), hyps, lenv, enss, ft, d) else let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then 0 else cs_vprove_body(b, cs_app(cs_vcollect_div_hyps_e(v, hyps, lenv, ft, d), hyps), Cons({k: nm, v: lv}, lenv), enss, ft, d)
    VarIn(nm, v, b) => if cs_vis_struct_expr(v) == 1 then cs_vprove_body(cs_temp_subst_var(b, nm, v), hyps, lenv, enss, ft, d) else let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then 0 else cs_vprove_body(b, cs_app(cs_vcollect_div_hyps_e(v, hyps, lenv, ft, d), hyps), Cons({k: nm, v: lv}, lenv), enss, ft, d)
    DeferE(c, b)    => cs_vprove_body(b, hyps, lenv, enss, ft, d)
    ErrDeferE(c, b) => cs_vprove_body(b, hyps, lenv, enss, ft, d)
    If(c, t, e2)    => let rp = cs_vcond_pos(c, hyps, lenv, ft, d) in let rn = cs_vcond_neg(c, hyps, lenv, ft, d) in if rp.ok == 1 and rn.ok == 1 and cs_vprove_body(t, cs_app(rp.hyps, hyps), lenv, enss, ft, d) == 1 and cs_vprove_body(e2, cs_app(rn.hyps, hyps), lenv, enss, ft, d) == 1 then 1 else 0
    _               => let dhyps = cs_app(cs_vcollect_div_hyps_e(body, hyps, lenv, ft, d), hyps) in let lb = cs_vlin_expr(body, dhyps, lenv, ft, d) in if lb.ok == 0 then 0 else let penv = Cons({k: "result", v: lb}, Cons({k: "ret", v: lb}, lenv)) in cs_vprove_goals_all(enss, dhyps, penv, ft, d)
fn cs_vqflia_prove_fn(ps, reqs, enss, body, ft) = if cs_isnil(enss) == 1 then 0 else let lenv = cs_vlin_init_env(ps) in let rh = cs_vprove_reqs_hyps(reqs, lenv, ft) in if rh.ok == 0 then 0 else cs_vprove_body(body, rh.hyps, lenv, enss, ft, 0)
fn cs_vqflia_prove_law(ps, body, ft) = let lenv = cs_vlin_init_env(ps) in if cs_vprove_goal(body, Nil, lenv, ft, 0) == 1 then 1 else if cs_len(ps) == 1 then let p0 = cs_vlin_var(cs_hd_str(ps, "")) in let hneg = Cons(cs_vlin_sub(cs_vlin_const(0 - 1), p0), Nil) in let hpos = Cons(p0, Nil) in if cs_vprove_goal(body, hneg, lenv, ft, 0) == 1 and cs_vprove_goal(body, hpos, lenv, ft, 0) == 1 then 1 else 0 else 0
fn cs_vneg_goal_hyps(g, hyps, lenv, ft, d) = match g
    Bin(op, a, b) => if op == "and" then cs_app(cs_vneg_goal_hyps(a, hyps, lenv, ft, d), cs_vneg_goal_hyps(b, hyps, lenv, ft, d)) else if op == "==" then cs_app((cs_vcond_cmp_pos(">", cs_vlin_expr(a, hyps, lenv, ft, d), cs_vlin_expr(b, hyps, lenv, ft, d))).hyps, (cs_vcond_cmp_pos("<", cs_vlin_expr(a, hyps, lenv, ft, d), cs_vlin_expr(b, hyps, lenv, ft, d))).hyps) else (cs_vcond_neg(g, hyps, lenv, ft, d)).hyps
    _             => Nil
fn cs_vneg_goals_hyps(enss, hyps, penv, ft, d) = match enss
    Nil        => Nil
    Cons(g, r) => cs_app(cs_vneg_goal_hyps(g, hyps, penv, ft, d), cs_vneg_goals_hyps(r, hyps, penv, ft, d))
fn cs_vcollect_body_hyps(body, hyps, lenv, enss, ft, d) = match body
    LetIn(nm, v, b) => let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then hyps else cs_vcollect_body_hyps(b, hyps, Cons({k: nm, v: lv}, lenv), enss, ft, d)
    VarIn(nm, v, b) => let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then hyps else cs_vcollect_body_hyps(b, hyps, Cons({k: nm, v: lv}, lenv), enss, ft, d)
    DeferE(c, b)    => cs_vcollect_body_hyps(b, hyps, lenv, enss, ft, d)
    ErrDeferE(c, b) => cs_vcollect_body_hyps(b, hyps, lenv, enss, ft, d)
    If(c, t, e2)    => let rp = cs_vcond_pos(c, hyps, lenv, ft, d) in let rn = cs_vcond_neg(c, hyps, lenv, ft, d) in cs_app(cs_vcollect_body_hyps(t, cs_app(rp.hyps, hyps), lenv, enss, ft, d), cs_vcollect_body_hyps(e2, cs_app(rn.hyps, hyps), lenv, enss, ft, d))
    _               => let lb = cs_vlin_expr(body, hyps, lenv, ft, d) in if lb.ok == 0 then hyps else let penv = Cons({k: "result", v: lb}, Cons({k: "ret", v: lb}, lenv)) in cs_app(cs_vneg_goals_hyps(enss, hyps, penv, ft, d), hyps)
fn cs_vmem_int(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else cs_vmem_int(x, t)
fn cs_vadd_int_uniq(x, xs) = if cs_vmem_int(x, xs) == 1 or cs_len(xs) >= 6 then xs else cs_app(xs, Cons(x, Nil))
fn cs_vpts_from_hyps(p, hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => let c = cs_vlin_coeff(p, h.cs) in if c == 0 then cs_vpts_from_hyps(p, t, acc) else let b = (0 - h.c0) / c in cs_vpts_from_hyps(p, t, cs_vadd_int_uniq(b + 1, cs_vadd_int_uniq(b, acc)))
fn cs_vfm_trace_hyps(hyps, vars) = match vars
    Nil        => hyps
    Cons(v, r) => let next = cs_vfm_elim_var(v, hyps) in if cs_len(next) > 32 then hyps else cs_app(hyps, cs_vfm_trace_hyps(next, r))
fn cs_vgen_envs_hyps(ps, idx, total, chyps) = match ps
    Nil        => Cons(Nil, Nil)
    Cons(p, r) => cs_vcross_p(p, cs_vpts_from_hyps(p, chyps, cs_vpts_for(idx, total)), cs_vgen_envs_hyps(r, idx + 1, total, chyps))

fn cs_cert_subst_res(e, leaf) = match e
    Var(nm)         => if nm == "result" or nm == "ret" then leaf else e
    Bin(op, a, b)   => Bin(op, cs_cert_subst_res(a, leaf), cs_cert_subst_res(b, leaf))
    If(c, t, e2)    => If(cs_cert_subst_res(c, leaf), cs_cert_subst_res(t, leaf), cs_cert_subst_res(e2, leaf))
    LetIn(nm, v, b) => LetIn(nm, cs_cert_subst_res(v, leaf), if nm == "result" or nm == "ret" then b else cs_cert_subst_res(b, leaf))
    VarIn(nm, v, b) => VarIn(nm, cs_cert_subst_res(v, leaf), if nm == "result" or nm == "ret" then b else cs_cert_subst_res(b, leaf))
    Call(cnm, args) => if (cnm == "verify" or cnm == "old" or cnm == "law_check" or cnm == "borrow" or cnm == "borrow_mut" or cnm == "move" or cnm == "clone") and cs_len(args) >= 1 then cs_cert_subst_res(cs_asthead(args), leaf) else if cnm == "dec_eq" and cs_len(args) == 2 then Bin("==", cs_cert_subst_res(cs_asthead(args), leaf), cs_cert_subst_res(cs_astsecond(args), leaf)) else if cnm == "dec_ge" and cs_len(args) == 2 then Bin(">=", cs_cert_subst_res(cs_asthead(args), leaf), cs_cert_subst_res(cs_astsecond(args), leaf)) else if cnm == "dec_gt" and cs_len(args) == 2 then Bin(">", cs_cert_subst_res(cs_asthead(args), leaf), cs_cert_subst_res(cs_astsecond(args), leaf)) else if cnm == "dec_le" and cs_len(args) == 2 then Bin("<=", cs_cert_subst_res(cs_asthead(args), leaf), cs_cert_subst_res(cs_astsecond(args), leaf)) else if cnm == "dec_lt" and cs_len(args) == 2 then Bin("<", cs_cert_subst_res(cs_asthead(args), leaf), cs_cert_subst_res(cs_astsecond(args), leaf)) else Call(cnm, cs_cert_subst_args(args, leaf))
    _               => e
fn cs_cert_subst_args(xs, leaf) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_cert_subst_res(h, leaf), cs_cert_subst_args(t, leaf))
fn cs_cert_conj(es) = match es
    Nil        => Num(1)
    Cons(h, t) => if cs_isnil(t) == 1 then h else Bin("and", h, cs_cert_conj(t))
fn cs_cert_bind_ps(ps, args) = match ps
    Nil        => Nil
    Cons(p, r) => cs_cert_bind_p1(p, r, args)
fn cs_cert_bind_p1(p, r, args) = match args
    Nil         => Nil
    Cons(a, ar) => Cons({k: p, v: a}, cs_cert_bind_ps(r, ar))
fn cs_cert_lookup_arg(nm, env) = match env
    Nil        => Var(nm)
    Cons(h, t) => if h.k == nm then h.v else cs_cert_lookup_arg(nm, t)
fn cs_cert_subst_env(e, env) = match e
    Var(nm)         => cs_cert_lookup_arg(nm, env)
    Bin(op, a, b)   => Bin(op, cs_cert_subst_env(a, env), cs_cert_subst_env(b, env))
    If(c, t, e2)    => If(cs_cert_subst_env(c, env), cs_cert_subst_env(t, env), cs_cert_subst_env(e2, env))
    LetIn(nm, v, b) => LetIn(nm, cs_cert_subst_env(v, env), cs_cert_subst_env(b, Cons({k: nm, v: Var(nm)}, env)))
    VarIn(nm, v, b) => LetIn(nm, cs_cert_subst_env(v, env), cs_cert_subst_env(b, Cons({k: nm, v: Var(nm)}, env)))
    Call(cnm, args) => Call(cnm, cs_cert_subst_env_args(args, env))
    _               => e
fn cs_cert_subst_env_args(xs, env) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_cert_subst_env(h, env), cs_cert_subst_env_args(t, env))
fn cs_cert_inline_ufn(cnm, cargs, mf, ft, d) = match mf
    Nil          => Call(cnm, cargs)
    Cons(fn0, r) => cs_cert_inline_ufn2(cnm, cargs, fn0, ft, d)
fn cs_cert_inline_ufn2(cnm, cargs, fn0, ft, d) = match fn0
    Fn(nm, ps, body) => cs_cert_clean_e(cs_cert_subst_env(body, cs_cert_bind_ps(ps, cargs)), ft, d + 1)
    _                => Call(cnm, cargs)
fn cs_cert_clean_args(xs, ft, d) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_cert_clean_e(h, ft, d), cs_cert_clean_args(t, ft, d))
fn cs_vis_m1_intrinsic(cnm) = if cs_vis_struct_call(cnm) == 1 or cnm == "array_select" or cnm == "heap_read" or cnm == "sep_valid" or cnm == "sep_disjoint" or cnm == "forall_range" or cnm == "exists_range" then 1 else 0
fn cs_cert_clean_e(e, ft, d) = if d > 4 then e else cs_cert_clean_e1(e, ft, d)
fn cs_cert_clean_e1(e, ft, d) = match e
    Call(cnm, args) => let cargs = cs_cert_clean_args(args, ft, d) in if (cnm == "verify" or cnm == "old" or cnm == "law_check" or cnm == "evolve_approve" or cnm == "borrow" or cnm == "borrow_mut" or cnm == "move" or cnm == "clone") and cs_len(cargs) >= 1 then cs_asthead(cargs) else if cnm == "grad" and cs_len(cargs) >= 2 then cs_cert_inline_ufn("__ad_grad_" + cs_n4_var_name(cs_asthead(args)), cs_cvtl(cargs), cs_fnlookup("__ad_grad_" + cs_n4_var_name(cs_asthead(args)), ft), ft, d) else if cnm == "jit" and cs_len(cargs) >= 2 then cs_cert_inline_ufn(cs_n4_var_name(cs_asthead(args)), cs_cvtl(cargs), cs_fnlookup(cs_n4_var_name(cs_asthead(args)), ft), ft, d) else if cnm == "dec_add" and cs_len(cargs) == 2 then Bin("+", cs_asthead(cargs), cs_astsecond(cargs)) else if cnm == "dec_sub" and cs_len(cargs) == 2 then Bin("-", cs_asthead(cargs), cs_astsecond(cargs)) else if cnm == "dec_eq" and cs_len(cargs) == 2 then Bin("==", cs_asthead(cargs), cs_astsecond(cargs)) else if cnm == "dec_ge" and cs_len(cargs) == 2 then Bin(">=", cs_asthead(cargs), cs_astsecond(cargs)) else if cnm == "dec_gt" and cs_len(cargs) == 2 then Bin(">", cs_asthead(cargs), cs_astsecond(cargs)) else if cnm == "dec_le" and cs_len(cargs) == 2 then Bin("<=", cs_asthead(cargs), cs_astsecond(cargs)) else if cnm == "dec_lt" and cs_len(cargs) == 2 then Bin("<", cs_asthead(cargs), cs_astsecond(cargs)) else if cs_vis_m1_intrinsic(cnm) == 1 then Call(cnm, cargs) else cs_cert_inline_ufn(cnm, cargs, cs_fnlookup(cnm, ft), ft, d)
    Bin(op, a, b)   => Bin(op, cs_cert_clean_e(a, ft, d), cs_cert_clean_e(b, ft, d))
    If(c, t, e2)    => If(cs_cert_clean_e(c, ft, d), cs_cert_clean_e(t, ft, d), cs_cert_clean_e(e2, ft, d))
    LetIn(nm, v, b) => let gfn = cs_n4_is_grad_let(v) in if gfn != "" then cs_cert_clean_e(cs_n4_subst_call(b, nm, "__ad_grad_" + gfn), ft, d) else LetIn(nm, cs_cert_clean_e(v, ft, d), cs_cert_clean_e(b, ft, d))
    VarIn(nm, v, b) => LetIn(nm, cs_cert_clean_e(v, ft, d), cs_cert_clean_e(b, ft, d))
    _               => e
fn cs_cert_embed_body(body, enss, ft) = match body
    LetIn(nm, v, b) => let gfn = cs_n4_is_grad_let(v) in if gfn != "" then cs_cert_embed_body(cs_n4_subst_call(b, nm, "__ad_grad_" + gfn), enss, ft) else LetIn(nm, cs_cert_clean_e(v, ft, 0), cs_cert_embed_body(b, enss, ft))
    VarIn(nm, v, b) => LetIn(nm, cs_cert_clean_e(v, ft, 0), cs_cert_embed_body(b, enss, ft))
    DeferE(c, b)    => cs_cert_embed_body(b, enss, ft)
    ErrDeferE(c, b) => cs_cert_embed_body(b, enss, ft)
    If(c, t, e2)    => If(cs_cert_clean_e(c, ft, 0), cs_cert_embed_body(t, enss, ft), cs_cert_embed_body(e2, enss, ft))
    _               => cs_cert_clean_e(cs_cert_subst_res(cs_cert_conj(enss), body), ft, 0)
fn cs_cert_reqs_sexpr(reqs, ft) = if cs_isnil(reqs) == 1 then "(and)" else "(and " + cs_exprs_sexpr(cs_cert_clean_args(reqs, ft, 0)) + ")"
fn cs_cert_term_fn(reqs, enss, body, ft) = "(implies " + cs_cert_reqs_sexpr(reqs, ft) + " " + cs_expr_sexpr(cs_cert_embed_body(body, enss, ft)) + ")"

fn cs_vprove_fn(nm, ps, body, mvs, ft) = match mvs
    Nil          => {proofs: Nil, diags: Nil}
    Cons(vsg, r) => let lenv = cs_vlin_init_env(ps) in let raw_hyps = cs_vcollect_body_hyps(body, (cs_vprove_reqs_hyps(vsg.reqs, lenv, ft)).hyps, lenv, vsg.enss, ft, 0) in let chyps = cs_vfm_trace_hyps(raw_hyps, cs_vfm_vars(raw_hyps, Nil)) in let pr = cs_vprove_envs(cs_vgen_envs_hyps(ps, 0, cs_len(ps), chyps), vsg.reqs, vsg.enss, body, ft, 0) in let st = if pr.status == "refuted" then "refuted" else if cs_vqflia_prove_fn(ps, vsg.reqs, vsg.enss, body, ft) == 1 then "proven" else "runtime_checked" in let ob = cs_exprs_sexpr(vsg.reqs) + " => " + cs_exprs_sexpr(vsg.enss) in let tm = cs_cert_term_fn(vsg.reqs, vsg.enss, body, ft) in let pf = Cons({name: nm, kind: "contract", status: st, obligation: ob, term: tm, counterexample: pr.cex}, Nil) in let dg = if st == "refuted" then Cons(cs_mkdiag("V0001", "contract", "contract error: cannot prove 'ensures' postcondition of '" + nm + "' — refuted with counterexample: " + pr.cex, "strengthen 'requires' precondition or fix implementation of '" + nm + "'"), Nil) else Nil in {proofs: pf, diags: dg}
fn cs_vchk_call_envs(envs, args, vsg, caller_reqs, ft) = match envs
    Nil           => ""
    Cons(cenv, r) => let cr = cs_veval_all_true(caller_reqs, cenv, cenv, ft) in if cr.ok == 0 or cr.hold == 0 then cs_vchk_call_envs(r, args, vsg, caller_reqs, ft) else let ra = cs_veval_args(args, cenv, cenv, ft, 0) in if ra.ok == 0 then cs_vchk_call_envs(r, args, vsg, caller_reqs, ft) else let env = cs_vbind_ps(vsg.ps, ra.vals) in let rq = cs_veval_all_true(vsg.reqs, env, env, ft) in if rq.ok == 1 and rq.hold == 0 then cs_vfmt_env(env) else cs_vchk_call_envs(r, args, vsg, caller_reqs, ft)
fn cs_vcaller_reqs(mvs) = match mvs
    Nil          => Nil
    Cons(vsg, r) => vsg.reqs
fn cs_vcaller_ps(mvs) = match mvs
    Nil          => Nil
    Cons(vsg, r) => vsg.ps
fn cs_vchk_call_req(cnm, args, fnm, mvs, caller_mvs, ft) = match mvs
    Nil          => {proofs: Nil, diags: Nil}
    Cons(vsg, r) => if cs_isnil(vsg.reqs) == 1 then {proofs: Nil, diags: Nil} else let ra = cs_veval_args(args, Nil, Nil, ft, 0) in if ra.ok == 1 then (let env = cs_vbind_ps(vsg.ps, ra.vals) in let rq = cs_veval_all_true(vsg.reqs, env, env, ft) in if rq.ok == 1 and rq.hold == 0 then let cex = cs_vfmt_env(env) in {proofs: Cons({name: cnm, kind: "call_requires", status: "refuted", obligation: cs_exprs_sexpr(vsg.reqs), term: "(implies (and) " + cs_expr_sexpr(cs_cert_conj(vsg.reqs)) + ")", counterexample: cex}, Nil), diags: Cons(cs_mkdiag("V0001", "contract", "contract error: call to '" + cnm + "' in '" + fnm + "' violates 'requires' precondition with counterexample: " + cex, "ensure arguments passed to '" + cnm + "' satisfy its 'requires' contract"), Nil)} else {proofs: Nil, diags: Nil}) else let cps = cs_vcaller_ps(caller_mvs) in let creqs = cs_vcaller_reqs(caller_mvs) in if cs_isnil(cps) == 1 then {proofs: Nil, diags: Nil} else let lenv = cs_vlin_init_env(cps) in let chyps = (cs_vprove_reqs_hyps(creqs, lenv, ft)).hyps in let cex = cs_vchk_call_envs(cs_vgen_envs_hyps(cps, 0, cs_len(cps), chyps), args, vsg, creqs, ft) in if cex != "" then {proofs: Cons({name: cnm, kind: "call_requires", status: "refuted", obligation: cs_exprs_sexpr(vsg.reqs), term: "(implies (and) " + cs_expr_sexpr(cs_cert_conj(vsg.reqs)) + ")", counterexample: cex}, Nil), diags: Cons(cs_mkdiag("V0001", "contract", "contract error: call to '" + cnm + "' in '" + fnm + "' violates 'requires' precondition with counterexample: " + cex, "ensure arguments passed to '" + cnm + "' satisfy its 'requires' contract"), Nil)} else {proofs: Nil, diags: Nil}
fn cs_vchk_rect_inv(tn, items, fnm, miv, ft) = match miv
    Nil         => {proofs: Nil, diags: Nil}
    Cons(iv, r) => let rr = cs_veval_rec(items, Nil, Nil, ft, 0) in if rr.ok == 0 then {proofs: Nil, diags: Nil} else let env = cs_vfields_env(rr.fields) in let ri = cs_veval(iv.inv, env, env, ft, 0) in if ri.ok == 1 and ri.i == 0 then let cex = cs_vfmt_env(env) in {proofs: Cons({name: tn, kind: "invariant", status: "refuted", obligation: cs_expr_sexpr(iv.inv), term: "(implies (and) " + cs_expr_sexpr(iv.inv) + ")", counterexample: cex}, Nil), diags: Cons(cs_mkdiag("V0001", "contract", "contract error: record construction of '" + tn + "' in '" + fnm + "' violates type 'invariant' with counterexample: " + cex, "satisfy the 'invariant' of '" + tn + "' before constructing the record"), Nil)} else {proofs: Nil, diags: Nil}
fn cs_vchk_expr_e(e, fnm, vsigs, invs, ft) = match e
    Call(cnm, args) => let r1 = cs_vchk_call_req(cnm, args, fnm, cs_vsiglookup(cnm, vsigs), cs_vsiglookup(fnm, vsigs), ft) in let r2 = cs_vchk_args_e(args, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
    RecT(tn, items) => let r1 = cs_vchk_rect_inv(tn, items, fnm, cs_vinvlookup(tn, invs), ft) in let r2 = cs_vchk_rec_e(items, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
    Rec(items)      => cs_vchk_rec_e(items, fnm, vsigs, invs, ft)
    Field(o, fld)   => cs_vchk_expr_e(o, fnm, vsigs, invs, ft)
    Bin(op, l, r)   => let r1 = cs_vchk_expr_e(l, fnm, vsigs, invs, ft) in let r2 = cs_vchk_expr_e(r, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
    If(c, t, e2)    => let r1 = cs_vchk_expr_e(c, fnm, vsigs, invs, ft) in let r2 = cs_vchk_expr_e(t, fnm, vsigs, invs, ft) in let r3 = cs_vchk_expr_e(e2, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, cs_app(r2.proofs, r3.proofs)), diags: cs_app(r1.diags, cs_app(r2.diags, r3.diags))}
    LetIn(nm, v, b) => let r1 = cs_vchk_expr_e(v, fnm, vsigs, invs, ft) in let r2 = cs_vchk_expr_e(b, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
    VarIn(nm, v, b) => let r1 = cs_vchk_expr_e(v, fnm, vsigs, invs, ft) in let r2 = cs_vchk_expr_e(b, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
    _               => {proofs: Nil, diags: Nil}
fn cs_vchk_args_e(args, fnm, vsigs, invs, ft) = match args
    Nil        => {proofs: Nil, diags: Nil}
    Cons(h, t) => let r1 = cs_vchk_expr_e(h, fnm, vsigs, invs, ft) in let r2 = cs_vchk_args_e(t, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
fn cs_vchk_rec_e(items, fnm, vsigs, invs, ft) = match items
    Nil        => {proofs: Nil, diags: Nil}
    Cons(h, t) => let r1 = cs_vchk_expr_e(h.val, fnm, vsigs, invs, ft) in let r2 = cs_vchk_rec_e(t, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
fn cs_vcollect_wcets(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_vcollect_wcet1(h, cs_vcollect_wcets(t))
fn cs_vcollect_wcet1(st, rest) = match st
    WcetSig(nm, bound) => Cons({nm: nm, bound: bound}, rest)
    _                  => rest
fn cs_vwcet_lookup(nm, wcets) = match wcets
    Nil        => 0
    Cons(h, t) => if h.nm == nm then h.bound else cs_vwcet_lookup(nm, t)
fn cs_vwcet_max(a, b) = if a >= b then a else b
fn cs_vwcet_e(e, ft, d) = if d <= 0 then 100000 else cs_vwcet_e1(e, ft, d)
fn cs_vwcet_e1(e, ft, d) = match e
    Num(n)          => 1
    Str(s)          => 1
    Var(x)          => 1
    Field(o, fld)   => 2 + cs_vwcet_e(o, ft, d)
    Bin(op, l, r)   => (if op == "*" or op == "/" or op == "%" then 4 else 1) + cs_vwcet_e(l, ft, d) + cs_vwcet_e(r, ft, d)
    If(c, t, e2)    => 2 + cs_vwcet_e(c, ft, d) + cs_vwcet_max(cs_vwcet_e(t, ft, d), cs_vwcet_e(e2, ft, d))
    LetIn(nm, v, b) => 1 + cs_vwcet_e(v, ft, d) + cs_vwcet_e(b, ft, d)
    VarIn(nm, v, b) => 1 + cs_vwcet_e(v, ft, d) + cs_vwcet_e(b, ft, d)
    Call(cnm, args) => 4 + cs_vwcet_args(args, ft, d) + cs_vwcet_call(cnm, cs_fnlookup(cnm, ft), ft, d)
    _               => 2
fn cs_vwcet_args(xs, ft, d) = match xs
    Nil        => 0
    Cons(h, t) => cs_vwcet_e(h, ft, d) + cs_vwcet_args(t, ft, d)
fn cs_vwcet_call(cnm, mf, ft, d) = match mf
    Nil          => 0
    Cons(fn0, r) => cs_vwcet_call2(cnm, fn0, ft, d)
fn cs_vwcet_call2(cnm, fn0, ft, d) = match fn0
    Fn(nm, ps, body) => if cs_mentions_call(cnm, body) == 1 then 100000 else cs_vwcet_e(body, ft, d - 1)
    _                => 0
fn cs_vwcet_prove_fn(nm, body, wcets, ft) = let bound = cs_vwcet_lookup(nm, wcets) in if bound <= 0 then {proofs: Nil, diags: Nil} else let est = (if cs_mentions_call(nm, body) == 1 then 100000 else cs_vwcet_e(body, ft, 4)) in let ok = if est <= bound then 1 else 0 in let tm = "wcet_budget(" + str(est) + " <= " + str(bound) + ")" in let pf = Cons({name: nm, kind: "wcet", status: if ok == 1 then "budget_checked" else "refuted", obligation: "cycles(" + nm + ") <= " + str(bound), term: tm, counterexample: if ok == 1 then "" else "estimated_cycles = " + str(est) + " > " + str(bound)}, Nil) in let dg = if ok == 1 then Nil else Cons(cs_mkdiag("V0002", "wcet", "wcet budget error: function '" + nm + "' has structural cycle cost of " + str(est) + " cycles, exceeding '@bound(cycles: " + str(bound) + ")'", "remove recursion/loops on the critical path or increase '@bound(cycles: " + str(est) + ")'"), Nil) in {proofs: pf, diags: dg}

## --- Horizon H1 (#198): Real LTL Temporal Logic Prover (`always` □, `eventually` ◇, `until` U, `leads_to` ~>) in `lcaas` ---
fn cs_temp_subst_var(e, vnm, rep) = match e
    Var(nm)         => if nm == vnm then rep else e
    Bin(op, a, b)   => Bin(op, cs_temp_subst_var(a, vnm, rep), cs_temp_subst_var(b, vnm, rep))
    If(c, t, e2)    => If(cs_temp_subst_var(c, vnm, rep), cs_temp_subst_var(t, vnm, rep), cs_temp_subst_var(e2, vnm, rep))
    LetIn(nm, v, b) => LetIn(nm, cs_temp_subst_var(v, vnm, rep), if nm == vnm then b else cs_temp_subst_var(b, vnm, rep))
    VarIn(nm, v, b) => VarIn(nm, cs_temp_subst_var(v, vnm, rep), if nm == vnm then b else cs_temp_subst_var(b, vnm, rep))
    Call(cnm, args) => Call(cnm, cs_temp_subst_args(args, vnm, rep))
    _               => e

fn cs_temp_subst_args(xs, vnm, rep) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_temp_subst_var(h, vnm, rep), cs_temp_subst_args(t, vnm, rep))

fn cs_temp_is_cmp(op) = if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or" then 1 else 0

fn cs_temp_is_bool_e(e) = match e
    Bin(op, a, b) => cs_temp_is_cmp(op)
    _             => 0

fn cs_temp_init_cond(sv, init_e) = if cs_temp_is_bool_e(init_e) == 1 then init_e else Bin("==", Var(sv), init_e)

fn cs_temp_neg_op(op) = if op == "<=" then ">" else if op == "<" then ">=" else if op == ">=" then "<" else if op == ">" then "<=" else if op == "==" then ">" else "!="

fn cs_temp_neg_cond(goal_e, rank_e) = match goal_e
    Bin(op, a, b) => if op == "==" then Bin(">", rank_e, Num(0)) else Bin(cs_temp_neg_op(op), a, b)
    _             => Bin(">", rank_e, Num(0))

fn cs_temp_default_rank(sv, goal_e) = match goal_e
    Bin(op, a, b) => if op == "<=" or op == "==" then Bin("-", a, b) else if op == "<" then Bin("+", Bin("-", a, b), Num(1)) else if op == ">=" then Bin("-", b, a) else if op == ">" then Bin("+", Bin("-", b, a), Num(1)) else Var(sv)
    _             => Var(sv)

fn cs_temp_infer_rank(sv, goal_e, rest_args) = match rest_args
    Nil        => cs_temp_default_rank(sv, goal_e)
    Cons(r, t) => r

fn cs_temp_arg3(args) = cs_asthead(cs_cvtl(cs_cvtl(args)))
fn cs_temp_arg4(args) = cs_asthead(cs_cvtl(cs_cvtl(cs_cvtl(args))))
fn cs_temp_rest3(args) = cs_cvtl(cs_cvtl(cs_cvtl(args)))
fn cs_temp_rest4(args) = cs_cvtl(cs_cvtl(cs_cvtl(cs_cvtl(args))))

fn cs_temp_cand_ints() = Cons(0, Cons(1, Cons(2, Cons(4, Cons(5, Cons(10, Cons(0 - 1, Cons(0 - 3, Nil))))))))

fn cs_temp_filter_seeds(sv, init_c, xs, ft) = match xs
    Nil        => Nil
    Cons(x, r) => let env = Cons({k: sv, v: cs_vv_int(x)}, Nil) in let rv = cs_veval(init_c, env, env, ft, 0) in if rv.ok == 1 and rv.i != 0 then Cons(x, cs_temp_filter_seeds(sv, init_c, r, ft)) else cs_temp_filter_seeds(sv, init_c, r, ft)

fn cs_temp_seeds(sv, init_e, ft) = if cs_temp_is_bool_e(init_e) == 0 then (let rv = cs_veval(init_e, Nil, Nil, ft, 0) in if rv.ok == 1 then Cons(rv.i, Nil) else cs_temp_cand_ints()) else cs_temp_filter_seeds(sv, init_e, cs_temp_cand_ints(), ft)

fn cs_temp_trace_always(sv, s_cur, step_e, inv_e, ft, t_step) = let env = Cons({k: sv, v: cs_vv_int(s_cur)}, Nil) in let ri = cs_veval(inv_e, env, env, ft, 0) in if ri.ok == 1 and ri.i == 0 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (violates always invariant at t=" + str(t_step) + ")"} else if t_step >= 12 then {ok: 1, cex: ""} else let rn = cs_veval(step_e, env, env, ft, 0) in if rn.ok == 0 or rn.i == s_cur then {ok: 1, cex: ""} else let rr = cs_temp_trace_always(sv, rn.i, step_e, inv_e, ft, t_step + 1) in if rr.ok == 0 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> " + rr.cex} else {ok: 1, cex: ""}

fn cs_temp_sim_always_list(sv, seeds, step_e, inv_e, ft) = match seeds
    Nil         => {ok: 1, cex: ""}
    Cons(s0, r) => let tr = cs_temp_trace_always(sv, s0, step_e, inv_e, ft, 0) in if tr.ok == 0 then {ok: 0, cex: "trace: " + tr.cex} else cs_temp_sim_always_list(sv, r, step_e, inv_e, ft)

fn cs_temp_ind_cex_list(sv, xs, step_e, inv_e, ft) = match xs
    Nil        => {ok: 1, cex: ""}
    Cons(x, r) => let env = Cons({k: sv, v: cs_vv_int(x)}, Nil) in let ri = cs_veval(inv_e, env, env, ft, 0) in if ri.ok == 1 and ri.i != 0 then (let rn = cs_veval(step_e, env, env, ft, 0) in if rn.ok == 1 then (let env2 = Cons({k: sv, v: cs_vv_int(rn.i)}, Nil) in let ri2 = cs_veval(inv_e, env2, env2, ft, 0) in if ri2.ok == 1 and ri2.i == 0 then {ok: 0, cex: "inductive step counterexample: " + sv + "=" + str(x) + " -> " + sv + "'=" + str(rn.i) + " (invariant holds at " + str(x) + " but fails at next state " + str(rn.i) + ")"} else cs_temp_ind_cex_list(sv, r, step_e, inv_e, ft)) else cs_temp_ind_cex_list(sv, r, step_e, inv_e, ft)) else cs_temp_ind_cex_list(sv, r, step_e, inv_e, ft)

fn cs_temp_prove_always(nm, sv, init_e, step_e, inv_e, ft) = let sim = cs_temp_sim_always_list(sv, cs_temp_seeds(sv, init_e, ft), step_e, inv_e, ft) in let lenv = Cons({k: sv, v: cs_vlin_var(sv)}, Nil) in let init_c = cs_cert_clean_e(cs_temp_init_cond(sv, init_e), ft, 0) in let inv_in = cs_cert_clean_e(inv_e, ft, 0) in let step_in = cs_cert_clean_e(step_e, ft, 0) in let next_goal = LetIn("_s_next", step_in, cs_temp_subst_var(inv_in, sv, Var("_s_next"))) in let rh_base = cs_vcond_pos(init_c, Nil, lenv, ft, 0) in let rh_step = cs_vcond_pos(inv_in, Nil, lenv, ft, 0) in let q_ok = (if rh_base.ok == 1 and rh_step.ok == 1 and cs_vprove_goal(inv_in, rh_base.hyps, lenv, ft, 0) == 1 and cs_vprove_goal(next_goal, rh_step.hyps, lenv, ft, 0) == 1 then 1 else 0) in let ic = cs_temp_ind_cex_list(sv, cs_temp_cand_ints(), step_e, inv_e, ft) in let st = (if sim.ok == 0 or q_ok == 0 then "refuted" else "proven") in let cex = (if sim.ok == 0 then sim.cex else if q_ok == 1 then "" else if ic.ok == 0 then ic.cex else "inductive step (inv => inv[s := step(s)]) is not provable in QF_LIA") in let tm = "(temporal-always (implies (and " + cs_expr_sexpr(init_c) + ") " + cs_expr_sexpr(inv_in) + ") (implies (and " + cs_expr_sexpr(inv_in) + ") " + cs_expr_sexpr(next_goal) + "))" in let ob = "always(" + cs_expr_sexpr(init_e) + ", " + cs_expr_sexpr(step_e) + ", " + cs_expr_sexpr(inv_e) + ")" in let pf = Cons({name: nm, kind: "temporal_always", status: st, obligation: ob, term: tm, counterexample: cex}, Nil) in let dg = (if st == "refuted" then Cons(cs_mkdiag("V0005", "temporal", "temporal verification error: temporal law '" + nm + "' (always) refuted with counterexample: " + cex, "strengthen the state invariant or fix the transition function so the invariant holds initially and is preserved across every step"), Nil) else Nil) in {proofs: pf, diags: dg}

fn cs_temp_trace_ev(sv, s_cur, cfg, seen, ft, t_step) = let env = Cons({k: sv, v: cs_vv_int(s_cur)}, Nil) in let rg = cs_veval(cfg.goal_e, env, env, ft, 0) in if rg.ok == 1 and rg.i != 0 then {ok: 1, cex: ""} else if cs_vmem_int(s_cur, seen) == 1 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (lasso cycle at " + sv + "=" + str(s_cur) + " while eventually goal false)"} else if t_step >= 16 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (eventually goal not reached within bounded horizon)"} else let rn = cs_veval(cfg.step_e, env, env, ft, 0) in let r_cur = cs_veval(cfg.rank_e, env, env, ft, 0) in if rn.ok == 0 then {ok: 1, cex: ""} else if rn.i == s_cur then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> t=" + str(t_step + 1) + ": " + sv + "=" + str(rn.i) + " (lasso cycle at " + sv + "=" + str(rn.i) + " while eventually goal false)"} else let env2 = Cons({k: sv, v: cs_vv_int(rn.i)}, Nil) in let rg2 = cs_veval(cfg.goal_e, env2, env2, ft, 0) in let r_nxt = cs_veval(cfg.rank_e, env2, env2, ft, 0) in if rg2.ok == 1 and rg2.i == 0 and r_cur.ok == 1 and r_nxt.ok == 1 and r_nxt.i >= r_cur.i then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> t=" + str(t_step + 1) + ": " + sv + "=" + str(rn.i) + " (diverging rank " + str(r_nxt.i) + " >= " + str(r_cur.i) + " while eventually goal false)"} else let rr = cs_temp_trace_ev(sv, rn.i, cfg, Cons(s_cur, seen), ft, t_step + 1) in if rr.ok == 0 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> " + rr.cex} else {ok: 1, cex: ""}

fn cs_temp_sim_ev_list(sv, seeds, cfg, ft) = match seeds
    Nil         => {ok: 1, cex: ""}
    Cons(s0, r) => let tr = cs_temp_trace_ev(sv, s0, cfg, Nil, ft, 0) in if tr.ok == 0 then {ok: 0, cex: "lasso/diverging trace: " + tr.cex} else cs_temp_sim_ev_list(sv, r, cfg, ft)

fn cs_temp_prove_ev(nm, knd, sv, cfg, ft) = let sim = cs_temp_sim_ev_list(sv, cs_temp_seeds(sv, cfg.init_e, ft), cfg, ft) in let lenv = Cons({k: sv, v: cs_vlin_var(sv)}, Nil) in let rank_in = cs_cert_clean_e(cfg.rank_e, ft, 0) in let step_in = cs_cert_clean_e(cfg.step_e, ft, 0) in let ng_in = cs_cert_clean_e(cs_temp_neg_cond(cfg.goal_e, rank_in), ft, 0) in let bnd_goal = Bin(">", rank_in, Num(0)) in let dec_goal = LetIn("_s_next", step_in, Bin("<", cs_temp_subst_var(rank_in, sv, Var("_s_next")), rank_in)) in let rh_ng = cs_vcond_pos(ng_in, Nil, lenv, ft, 0) in let q_ok = (if rh_ng.ok == 1 and cs_vprove_goal(bnd_goal, rh_ng.hyps, lenv, ft, 0) == 1 and cs_vprove_goal(dec_goal, rh_ng.hyps, lenv, ft, 0) == 1 then 1 else 0) in let st = (if sim.ok == 0 or q_ok == 0 then "refuted" else "proven") in let cex = (if sim.ok == 0 then sim.cex else if q_ok == 1 then "" else "ranking function '" + cs_expr_sexpr(cfg.rank_e) + "' does not strictly decrease under transition step in QF_LIA") in let tm = "(temporal-eventually (implies (and " + cs_expr_sexpr(ng_in) + ") " + cs_expr_sexpr(bnd_goal) + ") (implies (and " + cs_expr_sexpr(ng_in) + ") " + cs_expr_sexpr(dec_goal) + "))" in let ob = knd + "(" + cs_expr_sexpr(cfg.init_e) + ", " + cs_expr_sexpr(cfg.step_e) + ", " + cs_expr_sexpr(cfg.goal_e) + ")" in let pf = Cons({name: nm, kind: "temporal_" + knd, status: st, obligation: ob, term: tm, counterexample: cex}, Nil) in let dg = (if st == "refuted" then Cons(cs_mkdiag("V0005", "temporal", "temporal verification error: temporal law '" + nm + "' (" + knd + ") refuted with counterexample: " + cex, "ensure the transition step strictly decreases a well-founded ranking measure until the goal holds"), Nil) else Nil) in {proofs: pf, diags: dg}

fn cs_temp_trace_until(sv, s_cur, cfg, seen, ft, t_step) = let env = Cons({k: sv, v: cs_vv_int(s_cur)}, Nil) in let rg = cs_veval(cfg.goal_e, env, env, ft, 0) in if rg.ok == 1 and rg.i != 0 then {ok: 1, cex: ""} else let rh = cs_veval(cfg.hold_e, env, env, ft, 0) in if rh.ok == 1 and rh.i == 0 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (violates until hold condition before goal at t=" + str(t_step) + ")"} else if cs_vmem_int(s_cur, seen) == 1 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (lasso cycle at " + sv + "=" + str(s_cur) + " before until goal reached)"} else if t_step >= 16 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " (until goal not reached within bounded horizon)"} else let rn = cs_veval(cfg.step_e, env, env, ft, 0) in if rn.ok == 0 then {ok: 1, cex: ""} else if rn.i == s_cur then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> t=" + str(t_step + 1) + ": " + sv + "=" + str(rn.i) + " (lasso cycle at " + sv + "=" + str(rn.i) + " before until goal reached)"} else let rr = cs_temp_trace_until(sv, rn.i, cfg, Cons(s_cur, seen), ft, t_step + 1) in if rr.ok == 0 then {ok: 0, cex: "t=" + str(t_step) + ": " + sv + "=" + str(s_cur) + " -> " + rr.cex} else {ok: 1, cex: ""}

fn cs_temp_sim_until_list(sv, seeds, cfg, ft) = match seeds
    Nil         => {ok: 1, cex: ""}
    Cons(s0, r) => let tr = cs_temp_trace_until(sv, s0, cfg, Nil, ft, 0) in if tr.ok == 0 then {ok: 0, cex: "until trace: " + tr.cex} else cs_temp_sim_until_list(sv, r, cfg, ft)

fn cs_temp_prove_until(nm, sv, cfg, ft) = let sim = cs_temp_sim_until_list(sv, cs_temp_seeds(sv, cfg.init_e, ft), cfg, ft) in let ev = cs_temp_prove_ev(nm, "eventually", sv, cfg, ft) in let lenv = Cons({k: sv, v: cs_vlin_var(sv)}, Nil) in let init_c = cs_cert_clean_e(cs_temp_init_cond(sv, cfg.init_e), ft, 0) in let hold_in = cs_cert_clean_e(cfg.hold_e, ft, 0) in let goal_in = cs_cert_clean_e(cfg.goal_e, ft, 0) in let step_in = cs_cert_clean_e(cfg.step_e, ft, 0) in let rank_in = cs_cert_clean_e(cfg.rank_e, ft, 0) in let ng_in = cs_cert_clean_e(cs_temp_neg_cond(cfg.goal_e, rank_in), ft, 0) in let bnd_goal = Bin(">", rank_in, Num(0)) in let dec_goal = LetIn("_s_next", step_in, Bin("<", cs_temp_subst_var(rank_in, sv, Var("_s_next")), rank_in)) in let rh_init = cs_vcond_pos(init_c, Nil, lenv, ft, 0) in let rh_step = cs_vcond_pos(Bin("and", ng_in, hold_in), Nil, lenv, ft, 0) in let next_hold = LetIn("_s_next", step_in, Bin("or", cs_temp_subst_var(hold_in, sv, Var("_s_next")), cs_temp_subst_var(goal_in, sv, Var("_s_next")))) in let h_ok = (if rh_init.ok == 1 and rh_step.ok == 1 and cs_vprove_goal(Bin("or", goal_in, hold_in), rh_init.hyps, lenv, ft, 0) == 1 and cs_vprove_goal(next_hold, rh_step.hyps, lenv, ft, 0) == 1 then 1 else 0) in let ev_ok = (if cs_isnil(ev.diags) == 1 then 1 else 0) in let st = (if sim.ok == 0 or h_ok == 0 or ev_ok == 0 then "refuted" else "proven") in let cex = (if sim.ok == 0 then sim.cex else if ev_ok == 0 then (cs_asthead(ev.proofs)).counterexample else if h_ok == 1 then "" else "until hold invariant is not preserved prior to reaching goal in QF_LIA") in let hbase_tm = "(implies (and " + cs_expr_sexpr(init_c) + ") " + cs_expr_sexpr(Bin("or", goal_in, hold_in)) + ")" in let hstep_tm = "(implies (and " + cs_expr_sexpr(ng_in) + " " + cs_expr_sexpr(hold_in) + ") " + cs_expr_sexpr(next_hold) + ")" in let bnd_tm = "(implies (and " + cs_expr_sexpr(ng_in) + ") " + cs_expr_sexpr(bnd_goal) + ")" in let dec_tm = "(implies (and " + cs_expr_sexpr(ng_in) + ") " + cs_expr_sexpr(dec_goal) + ")" in let tm = "(temporal-until " + hbase_tm + " " + hstep_tm + " " + bnd_tm + " " + dec_tm + ")" in let ob = "until(" + cs_expr_sexpr(cfg.init_e) + ", " + cs_expr_sexpr(cfg.step_e) + ", " + cs_expr_sexpr(cfg.hold_e) + ", " + cs_expr_sexpr(cfg.goal_e) + ")" in let pf = Cons({name: nm, kind: "temporal_until", status: st, obligation: ob, term: tm, counterexample: cex}, Nil) in let dg = (if st == "refuted" then Cons(cs_mkdiag("V0005", "temporal", "temporal verification error: temporal law '" + nm + "' (until) refuted with counterexample: " + cex, "ensure the hold predicate holds until the goal predicate is reached"), Nil) else Nil) in {proofs: pf, diags: dg}

fn cs_vprove_temporal_call(nm, sv, cnm, args, ft) = if cnm == "always" and cs_len(args) >= 3 then cs_temp_prove_always(nm, sv, cs_asthead(args), cs_astsecond(args), cs_temp_arg3(args), ft) else if cnm == "eventually" and cs_len(args) >= 3 then (let g = cs_temp_arg3(args) in let rk = cs_temp_infer_rank(sv, g, cs_temp_rest3(args)) in cs_temp_prove_ev(nm, "eventually", sv, {init_e: cs_asthead(args), step_e: cs_astsecond(args), goal_e: g, rank_e: rk, hold_e: Num(1)}, ft)) else if cnm == "until" and cs_len(args) >= 4 then (let g = cs_temp_arg4(args) in let rk = cs_temp_default_rank(sv, g) in cs_temp_prove_until(nm, sv, {init_e: cs_asthead(args), step_e: cs_astsecond(args), hold_e: cs_temp_arg3(args), goal_e: g, rank_e: rk}, ft)) else if cnm == "leads_to" and cs_len(args) >= 4 then (let g = cs_temp_arg4(args) in let rk = cs_temp_infer_rank(sv, g, cs_temp_rest4(args)) in cs_temp_prove_ev(nm, "leads_to", sv, {init_e: cs_temp_arg3(args), step_e: cs_astsecond(args), goal_e: g, rank_e: rk, hold_e: Num(1)}, ft)) else {proofs: Nil, diags: Nil}

fn cs_vprove_law_decl(nm, ps, body, ft) = match body
    Call(cnm, args) => let tr = cs_vprove_temporal_call(nm, cs_hd_str(ps, "s"), cnm, args, ft) in if cs_isnil(tr.proofs) == 0 then tr else (let lenv = cs_vlin_init_env(ps) in let chyps = cs_vcollect_body_hyps(body, Nil, lenv, Cons(body, Nil), ft, 0) in let pr = cs_vprove_law_envs(cs_vgen_envs_hyps(ps, 0, cs_len(ps), chyps), body, ft, 0) in let lst = if pr.status == "refuted" then "refuted" else if cs_vqflia_prove_law(ps, body, ft) == 1 then "proven" else "runtime_checked" in let pf = Cons({name: nm, kind: "law", status: lst, obligation: cs_expr_sexpr(body), term: "(implies (and) " + cs_expr_sexpr(cs_cert_clean_e(body, ft, 0)) + ")", counterexample: pr.cex}, Nil) in let dg = if lst == "refuted" then Cons(cs_mkdiag("V0001", "law", "contract error: law '" + nm + "' refuted with counterexample: " + pr.cex, "fix the implementation or refine law '" + nm + "'"), Nil) else Nil in {proofs: pf, diags: dg})
    _               => let lenv = cs_vlin_init_env(ps) in let chyps = cs_vcollect_body_hyps(body, Nil, lenv, Cons(body, Nil), ft, 0) in let pr = cs_vprove_law_envs(cs_vgen_envs_hyps(ps, 0, cs_len(ps), chyps), body, ft, 0) in let lst = if pr.status == "refuted" then "refuted" else if cs_vqflia_prove_law(ps, body, ft) == 1 then "proven" else "runtime_checked" in let pf = Cons({name: nm, kind: "law", status: lst, obligation: cs_expr_sexpr(body), term: "(implies (and) " + cs_expr_sexpr(cs_cert_clean_e(body, ft, 0)) + ")", counterexample: pr.cex}, Nil) in let dg = if lst == "refuted" then Cons(cs_mkdiag("V0001", "law", "contract error: law '" + nm + "' refuted with counterexample: " + pr.cex, "fix the implementation or refine law '" + nm + "'"), Nil) else Nil in {proofs: pf, diags: dg}

fn cs_vprove_total_fn(nm, ps, body, msig) = match msig
    Nil         => Nil
    Cons(sg, r) => if cs_ois_total(sg.freef) == 0 then Nil else let dt = cs_achk_total_e(body, nm, ps, Nil, Nil) in let ok = cs_isnil(dt) in Cons({name: nm, kind: "termination", status: if ok == 1 then "proven" else "refuted", obligation: "terminates(" + nm + ")", term: "(terminates " + nm + " (" + cs_joinsep(ps, " ") + "))", counterexample: if ok == 1 then "" else "non-decreasing recursive call in " + nm}, Nil)

fn cs_vprove_stmts(prog, vsigs, invs, wcets, osigs, ft) = match prog
    Nil        => {proofs: Nil, diags: Nil}
    Cons(h, t) => cs_vprove_stmt1(h, t, vsigs, invs, wcets, osigs, ft)
fn cs_vprove_stmt1(st, rest, vsigs, invs, wcets, osigs, ft) = match st
    VLawDecl(nm, ps, body)      => let r1 = cs_vprove_law_decl(nm, ps, body, ft) in let rr = cs_vprove_stmts(rest, vsigs, invs, wcets, osigs, ft) in {proofs: cs_app(r1.proofs, rr.proofs), diags: cs_app(r1.diags, rr.diags)}
    VTypeInvariant(nm, fs, inv) => let pf = Cons({name: nm, kind: "invariant", status: "runtime_checked", obligation: cs_expr_sexpr(inv), term: "(implies (and) " + cs_expr_sexpr(cs_cert_clean_e(inv, ft, 0)) + ")", counterexample: ""}, Nil) in let rr = cs_vprove_stmts(rest, vsigs, invs, wcets, osigs, ft) in {proofs: cs_app(pf, rr.proofs), diags: rr.diags}
    Fn(nm, ps, body)            => let r1 = cs_vprove_fn(nm, ps, body, cs_vsiglookup(nm, vsigs), ft) in let pt = cs_vprove_total_fn(nm, ps, body, cs_osiglookup(nm, osigs)) in let rw = cs_vwcet_prove_fn(nm, body, wcets, ft) in let r2 = cs_vchk_expr_e(body, nm, vsigs, invs, ft) in let rr = cs_vprove_stmts(rest, vsigs, invs, wcets, osigs, ft) in {proofs: cs_app(r1.proofs, cs_app(pt, cs_app(rw.proofs, cs_app(r2.proofs, rr.proofs)))), diags: cs_app(r1.diags, cs_app(rw.diags, cs_app(r2.diags, rr.diags)))}
    Print(v)                    => let r1 = cs_vchk_expr_e(v, "<main>", vsigs, invs, ft) in let rr = cs_vprove_stmts(rest, vsigs, invs, wcets, osigs, ft) in {proofs: cs_app(r1.proofs, rr.proofs), diags: cs_app(r1.diags, rr.diags)}
    ExprS(v)                    => let r1 = cs_vchk_expr_e(v, "<main>", vsigs, invs, ft) in let rr = cs_vprove_stmts(rest, vsigs, invs, wcets, osigs, ft) in {proofs: cs_app(r1.proofs, rr.proofs), diags: cs_app(r1.diags, rr.diags)}
    _                           => cs_vprove_stmts(rest, vsigs, invs, wcets, osigs, ft)
fn cs_vprove_all(prog) = cs_vprove_stmts(prog, cs_vcollect_vsigs(prog), cs_vcollect_invs(prog), cs_vcollect_wcets(prog), cs_ocollects(prog), cs_buildft(prog))

fn cs_n4_ty_dims(ty) = match ty
    TyTensor(e, ds) => ds
    _               => Nil
fn cs_n4_init_tenv(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, r) => let ds = cs_n4_ty_dims(cs_hd_ty(pts)) in let rest = cs_n4_init_tenv(r, cs_tl_ty(pts)) in if cs_isnil(ds) == 0 then Cons({k: pn, ds: ds}, rest) else rest
fn cs_n4_init_tenv_sig(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => cs_n4_init_tenv(sg.pn, sg.pt)
fn cs_n4_tlookup(nm, tenv) = match tenv
    Nil        => Nil
    Cons(h, t) => if h.k == nm then h.ds else cs_n4_tlookup(nm, t)
fn cs_n4_flookup_dims(rn, fld, recs) = match cs_rlookup(rn, recs)
    Nil        => Nil
    Cons(d, r) => cs_n4_flds_dims(fld, d.fields)
fn cs_n4_flds_dims(fld, fs) = match fs
    Nil        => Nil
    Cons(h, t) => if h.fname == fld then cs_n4_ty_dims(h.fty) else cs_n4_flds_dims(fld, t)
fn cs_n4_any_flds_dims(fld, recs) = match recs
    Nil        => Nil
    Cons(d, r) => let ds = cs_n4_flds_dims(fld, d.fields) in if cs_isnil(ds) == 0 then ds else cs_n4_any_flds_dims(fld, r)
fn cs_n4_dims_eq(d1, d2) = match d1
    Nil        => cs_isnil(d2)
    Cons(a, r) => cs_n4_dims_eq1(a, r, d2)
fn cs_n4_dims_eq1(a, r, d2) = match d2
    Nil         => 0
    Cons(b, r2) => if a == b or a == "_" or b == "_" or a == "1" or b == "1" then cs_n4_dims_eq(r, r2) else 0
fn cs_n4_dims_str(ds) = "[" + cs_joinsep(ds, ", ") + "]"
fn cs_n4_infer_dims(e, fnm, tenv, recs) = match e
    Var(nm)         => {ds: cs_n4_tlookup(nm, tenv), diags: Nil}
    Field(o, fld)   => let r1 = cs_n4_infer_dims(o, fnm, tenv, recs) in {ds: cs_n4_any_flds_dims(fld, recs), diags: r1.diags}
    LetIn(nm, v, b) => let rv = cs_n4_infer_dims(v, fnm, tenv, recs) in let t2 = if cs_isnil(rv.ds) == 0 then Cons({k: nm, ds: rv.ds}, tenv) else tenv in let rb = cs_n4_infer_dims(b, fnm, t2, recs) in {ds: rb.ds, diags: cs_app(rv.diags, rb.diags)}
    VarIn(nm, v, b) => let rv = cs_n4_infer_dims(v, fnm, tenv, recs) in let t2 = if cs_isnil(rv.ds) == 0 then Cons({k: nm, ds: rv.ds}, tenv) else tenv in let rb = cs_n4_infer_dims(b, fnm, t2, recs) in {ds: rb.ds, diags: cs_app(rv.diags, rb.diags)}
    If(c, t, e2)    => let rc = cs_n4_infer_dims(c, fnm, tenv, recs) in let rt = cs_n4_infer_dims(t, fnm, tenv, recs) in let re = cs_n4_infer_dims(e2, fnm, tenv, recs) in let d_if = if cs_isnil(rt.ds) == 0 and cs_isnil(re.ds) == 0 and cs_n4_dims_eq(rt.ds, re.ds) == 0 then Cons(cs_mkdiag("T0300", "tensor", "tensor shape error: 'if' branches in '" + fnm + "' have incompatible tensor shapes " + cs_n4_dims_str(rt.ds) + " vs " + cs_n4_dims_str(re.ds), "align branch tensor shapes"), Nil) else Nil in {ds: rt.ds, diags: cs_app(rc.diags, cs_app(rt.diags, cs_app(re.diags, d_if)))}
    Bin(op, l, r)   => let rl = cs_n4_infer_dims(l, fnm, tenv, recs) in let rr = cs_n4_infer_dims(r, fnm, tenv, recs) in let d_bin = if (op == "+" or op == "-" or op == "*") and cs_isnil(rl.ds) == 0 and cs_isnil(rr.ds) == 0 and cs_n4_dims_eq(rl.ds, rr.ds) == 0 then Cons(cs_mkdiag("T0300", "tensor", "tensor shape error: elementwise '" + op + "' in '" + fnm + "' has incompatible tensor shapes " + cs_n4_dims_str(rl.ds) + " and " + cs_n4_dims_str(rr.ds), "use broadcast-compatible tensor shapes"), Nil) else Nil in {ds: rl.ds, diags: cs_app(rl.diags, cs_app(rr.diags, d_bin))}
    Call(cnm, args) => cs_n4_infer_call_dims(cnm, args, fnm, tenv, recs)
    _               => {ds: Nil, diags: Nil}
fn cs_n4_infer_args_diags(args, fnm, tenv, recs) = match args
    Nil        => Nil
    Cons(h, t) => cs_app((cs_n4_infer_dims(h, fnm, tenv, recs)).diags, cs_n4_infer_args_diags(t, fnm, tenv, recs))
fn cs_n4_infer_call_dims(cnm, args, fnm, tenv, recs) = let da = cs_n4_infer_args_diags(args, fnm, tenv, recs) in if (cnm == "matmul" or cnm == "tensor_matmul" or cnm == "einsum_ij_jk") and cs_len(args) >= 2 then (let r1 = cs_n4_infer_dims(cs_asthead(args), fnm, tenv, recs) in let r2 = cs_n4_infer_dims(cs_astsecond(args), fnm, tenv, recs) in if cs_len(r1.ds) == 2 and cs_len(r2.ds) == 2 then (let m = cs_hd_str(r1.ds, "") in let k1 = cs_hd_str(cs_cvtl(r1.ds), "") in let k2 = cs_hd_str(r2.ds, "") in let n = cs_hd_str(cs_cvtl(r2.ds), "") in if k1 != k2 and k1 != "_" and k2 != "_" then {ds: Cons(m, Cons(n, Nil)), diags: cs_app(da, Cons(cs_mkdiag("T0300", "tensor", "tensor shape error: inner dimensions in '" + cnm + "' inside '" + fnm + "' do not match: [" + m + ", " + k1 + "] @ [" + k2 + ", " + n + "] (" + k1 + " != " + k2 + ")", "reshape or transpose so inner dimensions match (" + k1 + " == " + k2 + ")"), Nil))} else {ds: Cons(m, Cons(n, Nil)), diags: da}) else {ds: Nil, diags: da}) else if (cnm == "tensor_add" or cnm == "tensor_sub" or cnm == "tensor_mul") and cs_len(args) == 2 then (let r1 = cs_n4_infer_dims(cs_asthead(args), fnm, tenv, recs) in let r2 = cs_n4_infer_dims(cs_astsecond(args), fnm, tenv, recs) in if cs_isnil(r1.ds) == 0 and cs_isnil(r2.ds) == 0 and cs_n4_dims_eq(r1.ds, r2.ds) == 0 then {ds: r1.ds, diags: cs_app(da, Cons(cs_mkdiag("T0300", "tensor", "tensor shape error: '" + cnm + "' in '" + fnm + "' has incompatible shapes " + cs_n4_dims_str(r1.ds) + " and " + cs_n4_dims_str(r2.ds), "align tensor shapes"), Nil))} else {ds: r1.ds, diags: da}) else if cnm == "tensor_add_bias" and cs_len(args) == 2 then (let r1 = cs_n4_infer_dims(cs_asthead(args), fnm, tenv, recs) in let r2 = cs_n4_infer_dims(cs_astsecond(args), fnm, tenv, recs) in if cs_len(r1.ds) == 2 and cs_len(r2.ds) == 1 then (let n1 = cs_hd_str(cs_cvtl(r1.ds), "") in let n2 = cs_hd_str(r2.ds, "") in if n1 != n2 and n1 != "_" and n2 != "_" then {ds: r1.ds, diags: cs_app(da, Cons(cs_mkdiag("T0300", "tensor", "tensor shape error: bias dimension in 'tensor_add_bias' inside '" + fnm + "' does not match last axis: " + cs_n4_dims_str(r1.ds) + " + " + cs_n4_dims_str(r2.ds), "change bias vector shape to [" + n1 + "]"), Nil))} else {ds: r1.ds, diags: da}) else {ds: r1.ds, diags: da}) else if (cnm == "tensor_relu" or cnm == "tensor_scale" or cnm == "softmax") and cs_len(args) >= 1 then {ds: (cs_n4_infer_dims(cs_asthead(args), fnm, tenv, recs)).ds, diags: da} else if cnm == "tensor_transpose" and cs_len(args) == 1 then (let r1 = cs_n4_infer_dims(cs_asthead(args), fnm, tenv, recs) in if cs_len(r1.ds) == 2 then {ds: Cons(cs_hd_str(cs_cvtl(r1.ds), ""), Cons(cs_hd_str(r1.ds, ""), Nil)), diags: da} else {ds: Nil, diags: da}) else {ds: Nil, diags: da}
fn cs_n4_chk_fn_tensors(nm, body, msig, recs) = let tenv = cs_n4_init_tenv_sig(msig) in let rb = cs_n4_infer_dims(body, nm, tenv, recs) in cs_n4_chk_fn_t1(nm, rb, msig)
fn cs_n4_chk_fn_t1(nm, rb, msig) = match msig
    Nil          => rb.diags
    Cons(sg, sr) => let rds = cs_n4_ty_dims(sg.rt) in if cs_isnil(rds) == 0 and cs_isnil(rb.ds) == 0 and cs_n4_dims_eq(rb.ds, rds) == 0 then cs_app(rb.diags, Cons(cs_mkdiag("T0300", "tensor", "tensor shape error: function '" + nm + "' returns tensor shape " + cs_n4_dims_str(rb.ds) + " but signature declares " + cs_n4_dims_str(rds), "update return type shape to " + cs_n4_dims_str(rb.ds)), Nil)) else rb.diags
fn cs_n4_chk_kernel_fn(nm, freef, body, kt) = let inf = cs_kinfer_effs_e(body, kt.ksigs, kt.edecls) in if cs_ois_kernel(freef) == 1 then (let bad = cs_keff_diff(inf, Cons("gpu", Cons("simd", Nil))) in if cs_isnil(bad) == 0 then Cons(cs_mkdiag("E0200", "kernel", "effect error: accelerator 'kernel fn " + nm + "' cannot perform host/heap effect '{" + cs_joinsep(bad, ", ") + "}'", "remove host I/O or heap allocation from 'kernel fn " + nm + "'"), Nil) else Nil) else if cs_ois_interrupt(freef) == 1 and (cs_omem("alloc", inf) == 1 or cs_omem("io", inf) == 1 or cs_omem("fs", inf) == 1 or cs_omem("net", inf) == 1 or cs_omem("async", inf) == 1) then Cons(cs_mkdiag("E0200", "interrupt", "effect error: interrupt handler '@interrupt fn " + nm + "' cannot allocate or block (performs '{" + cs_joinsep(inf, ", ") + "}')", "pre-allocate state in a static capability region and remove blocking I/O from the ISR"), Nil) else Nil
fn cs_n4_diff_lookup(nm, dv, dmap) = if nm == dv then Num(1) else cs_n4_diff_l1(nm, dmap)
fn cs_n4_diff_l1(nm, dmap) = match dmap
    Nil        => Num(0)
    Cons(h, t) => if h.k == nm then h.de else cs_n4_diff_l1(nm, t)
fn cs_n4_diff_e(e, dv, dmap) = match e
    Num(n)          => Num(0)
    Str(s)          => Num(0)
    Var(nm)         => cs_n4_diff_lookup(nm, dv, dmap)
    OwnE(inner)     => cs_n4_diff_e(inner, dv, dmap)
    MutE(inner)     => cs_n4_diff_e(inner, dv, dmap)
    LetIn(nm, v, b) => let dv_e = cs_n4_diff_e(v, dv, dmap) in LetIn(nm, v, cs_n4_diff_e(b, dv, Cons({k: nm, de: dv_e}, dmap)))
    VarIn(nm, v, b) => let dv_e = cs_n4_diff_e(v, dv, dmap) in VarIn(nm, v, cs_n4_diff_e(b, dv, Cons({k: nm, de: dv_e}, dmap)))
    If(c, t, e2)    => If(c, cs_n4_diff_e(t, dv, dmap), cs_n4_diff_e(e2, dv, dmap))
    Bin(op, l, r)   => let dl = cs_n4_diff_e(l, dv, dmap) in let dr = cs_n4_diff_e(r, dv, dmap) in if op == "+" then Bin("+", dl, dr) else if op == "-" then Bin("-", dl, dr) else if op == "*" then Bin("+", Bin("*", dl, r), Bin("*", l, dr)) else Num(0)
    Call(cnm, args) => if cnm == "relu" and cs_len(args) == 1 then (let x = cs_asthead(args) in If(Bin(">", x, Num(0)), cs_n4_diff_e(x, dv, dmap), Num(0))) else if cnm == "sq" and cs_len(args) == 1 then (let x = cs_asthead(args) in Bin("*", Bin("*", Num(2), x), cs_n4_diff_e(x, dv, dmap))) else if cnm == "cube" and cs_len(args) == 1 then (let x = cs_asthead(args) in Bin("*", Bin("*", Num(3), Bin("*", x, x)), cs_n4_diff_e(x, dv, dmap))) else if cnm == "abs" and cs_len(args) == 1 then (let x = cs_asthead(args) in let dx = cs_n4_diff_e(x, dv, dmap) in If(Bin(">=", x, Num(0)), dx, Bin("-", Num(0), dx))) else if cnm == "clamp" and cs_len(args) == 3 then (let x = cs_asthead(args) in let lo = cs_astsecond(args) in let hi = cs_asthead(cs_cvtl(cs_cvtl(args))) in If(Bin("<", x, lo), Num(0), If(Bin(">", x, hi), Num(0), cs_n4_diff_e(x, dv, dmap)))) else if cnm == "leaky_relu" and cs_len(args) == 2 then (let x = cs_asthead(args) in let k = cs_astsecond(args) in let dx = cs_n4_diff_e(x, dv, dmap) in If(Bin(">", x, Num(0)), dx, Bin("*", k, dx))) else if cnm == "quot" and cs_len(args) == 2 then (let a = cs_asthead(args) in let b = cs_astsecond(args) in let da = cs_n4_diff_e(a, dv, dmap) in let db = cs_n4_diff_e(b, dv, dmap) in Bin("/", Bin("-", Bin("*", da, b), Bin("*", a, db)), Bin("*", b, b))) else Num(0)
    _               => Num(0)
fn cs_n4_chk_diff_e(e, fnm) = match e
    Num(n)          => Nil
    Str(s)          => Nil
    Var(nm)         => Nil
    OwnE(inner)     => cs_n4_chk_diff_e(inner, fnm)
    MutE(inner)     => cs_n4_chk_diff_e(inner, fnm)
    LetIn(nm, v, b) => cs_app(cs_n4_chk_diff_e(v, fnm), cs_n4_chk_diff_e(b, fnm))
    VarIn(nm, v, b) => cs_app(cs_n4_chk_diff_e(v, fnm), cs_n4_chk_diff_e(b, fnm))
    If(c, t, e2)    => cs_app(cs_n4_chk_diff_e(t, fnm), cs_n4_chk_diff_e(e2, fnm))
    Bin(op, l, r)   => let d_op = if op == "+" or op == "-" or op == "*" then Nil else Cons(cs_mkdiag("N0400", "autodiff", "autodiff error: operator '" + op + "' in '" + fnm + "' is outside the differentiable polynomial fragment (+, -, *, relu, sq, cube, abs, clamp, leaky_relu, quot)", "replace '" + op + "' with a polynomial operation (+, -, *) or use 'mlp2_grad' from 'std.nn'"), Nil) in cs_app(d_op, cs_app(cs_n4_chk_diff_e(l, fnm), cs_n4_chk_diff_e(r, fnm)))
    Call(cnm, args) => if (cnm == "relu" or cnm == "sq" or cnm == "cube" or cnm == "abs") and cs_len(args) == 1 then cs_n4_chk_diff_e(cs_asthead(args), fnm) else if (cnm == "leaky_relu" or cnm == "quot") and cs_len(args) == 2 then cs_app(cs_n4_chk_diff_e(cs_asthead(args), fnm), cs_n4_chk_diff_e(cs_astsecond(args), fnm)) else if cnm == "clamp" and cs_len(args) == 3 then cs_app(cs_n4_chk_diff_e(cs_asthead(args), fnm), cs_app(cs_n4_chk_diff_e(cs_astsecond(args), fnm), cs_n4_chk_diff_e(cs_asthead(cs_cvtl(cs_cvtl(args))), fnm))) else Cons(cs_mkdiag("N0400", "autodiff", "autodiff error: call to '" + cnm + "' in '" + fnm + "' has no registered symbolic derivative rule", "inline '" + cnm + "' into polynomial ops (+, -, *, relu, sq, cube, abs, clamp, leaky_relu, quot) or use 'mlp2_grad' from 'std.nn'"), Nil)
    _               => Cons(cs_mkdiag("N0400", "autodiff", "autodiff error: unsupported expression in differentiable function '" + fnm + "'", "use polynomial expressions (+, -, *, if, let, relu, sq)"), Nil)
fn cs_n4_chk_grad_fns(gnms, ft) = match gnms
    Nil          => Nil
    Cons(fnm, r) => cs_app(cs_n4_chk_grad_fn1(fnm, cs_fnlookup(fnm, ft)), cs_n4_chk_grad_fns(r, ft))
fn cs_n4_chk_grad_fn1(fnm, mf) = match mf
    Nil          => Cons(cs_mkdiag("N0400", "autodiff", "autodiff error: target function '" + fnm + "' not found for symbolic differentiation", "define 'fn " + fnm + "(x: int) -> int = ...' before calling 'grad(" + fnm + ", ...)'"), Nil)
    Cons(fn0, r) => cs_n4_chk_grad_fn2(fnm, fn0)
fn cs_n4_chk_grad_fn2(fnm, fn0) = match fn0
    Fn(nm, ps, body) => cs_n4_chk_diff_e(body, fnm)
    _                => Nil
fn cs_n4_collect_grads_e(e, acc) = match e
    Call(cnm, args) => let acc1 = cs_n4_collect_grads_args(args, acc) in if (cnm == "grad" or cnm == "value_and_grad" or cnm == "jvp" or cnm == "vjp") and cs_len(args) >= 1 then (let fnm = cs_n4_var_name(cs_asthead(args)) in if fnm != "" and cs_omem(fnm, acc1) == 0 then Cons(fnm, acc1) else acc1) else acc1
    Field(o, nm)    => cs_n4_collect_grads_e(o, acc)
    Bin(op, l, r)   => cs_n4_collect_grads_e(r, cs_n4_collect_grads_e(l, acc))
    If(c, t, e2)    => cs_n4_collect_grads_e(e2, cs_n4_collect_grads_e(t, cs_n4_collect_grads_e(c, acc)))
    LetIn(nm, v, b) => cs_n4_collect_grads_e(b, cs_n4_collect_grads_e(v, acc))
    VarIn(nm, v, b) => cs_n4_collect_grads_e(b, cs_n4_collect_grads_e(v, acc))
    _               => acc
fn cs_n4_collect_grads_args(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => cs_n4_collect_grads_args(t, cs_n4_collect_grads_e(h, acc))
fn cs_n4_collect_grads_prog(prog, acc) = match prog
    Nil        => acc
    Cons(h, t) => cs_n4_collect_grads_stmt(h, cs_n4_collect_grads_prog(t, acc))
fn cs_n4_collect_grads_stmt(st, acc) = match st
    Fn(nm, ps, body)             => cs_n4_collect_grads_e(body, acc)
    VContractSig(nm, ps, rq, en) => cs_n4_collect_grads_args(en, cs_n4_collect_grads_args(rq, acc))
    VLawDecl(nm, ps, body)       => cs_n4_collect_grads_e(body, acc)
    Print(v)                     => cs_n4_collect_grads_e(v, acc)
    ExprS(v)                     => cs_n4_collect_grads_e(v, acc)
    _                            => acc
fn cs_n4_synth_grad_fns(gnms, ft) = match gnms
    Nil          => Nil
    Cons(fnm, r) => cs_n4_synth_grad_fn1(fnm, cs_fnlookup(fnm, ft), cs_n4_synth_grad_fns(r, ft))
fn cs_n4_synth_grad_fn1(fnm, mf, rest) = match mf
    Nil          => rest
    Cons(fn0, r) => cs_n4_synth_grad_fn2(fnm, fn0, rest)
fn cs_n4_synth_grad_fn2(fnm, fn0, rest) = match fn0
    Fn(nm, ps, body) => if cs_isnil(ps) == 1 then rest else Cons(Fn("__ad_grad_" + fnm, ps, cs_n4_diff_e(body, cs_hd_str(ps, ""), Nil)), rest)
    _                => rest

fn cs_ochk_fn(nm, ps, body, msig, osigs, sigs, kt) = match msig
    Nil          => let dt = cs_n4_chk_fn_tensors(nm, body, cs_siglookup(nm, sigs), kt.recs) in let dk = cs_kchk_fn(nm, 0, body, kt) in let ds = cs_schk_conc_e(body, nm, 0, cs_sinit_ns_sig(cs_siglookup(nm, sigs)), Nil) in let rp = cs_achk_prov_e(body, nm, cs_uinit_sig(cs_siglookup(nm, sigs)), osigs, sigs, kt.vsigs) in let ctx = {fnm: nm, pubf: 0, freef: 0, halloc: 0, bparams: ps, mvars: Nil, origins: cs_oinit_orgs(ps), osigs: osigs} in let rb = cs_ochke(body, ctx, Nil) in cs_app(dt, cs_app(dk, cs_app(ds, cs_app(rp.diags, cs_app(rb.diags, cs_ochk_ret(nm, 0, "", rb.origin))))))
    Cons(sg, sr) => let dsec = if sg.pubf == 1 or cs_ois_protect(sg.freef) == 1 then cs_w33_chk_sec_e(body, nm) else Nil in let dt = cs_n4_chk_fn_tensors(nm, body, cs_siglookup(nm, sigs), kt.recs) in let dkern = cs_n4_chk_kernel_fn(nm, sg.freef, body, kt) in let dk = cs_kchk_fn(nm, sg.pubf, body, kt) in let mvars = cs_omvars(sg.pl) in let ds = cs_schk_conc_e(body, nm, 0, cs_sinit_ns_sig(cs_siglookup(nm, sigs)), mvars) in let dtot = if cs_ois_total(sg.freef) == 1 then cs_achk_total_e(body, nm, ps, Nil, Nil) else Nil in let rp = cs_achk_prov_e(body, nm, cs_uinit_sig(cs_siglookup(nm, sigs)), osigs, sigs, kt.vsigs) in let dret = if sg.pubf == 1 and cs_ois_llm(sg.freef) == 0 and cs_is_unv_ty(sg.rty) == 0 and rp.taint == 1 then Cons(cs_mkdiag("A0003", "provenance", "provenance error: unverified AI/probabilistic value cannot be returned from trusted 'pub fn " + nm + "' without verification", "wrap the return value in 'verify(val, <contract>)'"), Nil) else Nil in let bparams = if cs_isnil(sg.pl) == 1 then ps else cs_obparams(sg.pl) in let ctx = {fnm: nm, pubf: sg.pubf, freef: sg.freef, halloc: 0, bparams: bparams, mvars: mvars, origins: cs_oinit_orgs(ps), osigs: osigs} in let rb = cs_ochke(body, ctx, Nil) in cs_app(dsec, cs_app(dt, cs_app(dkern, cs_app(dk, cs_app(ds, cs_app(dtot, cs_app(rp.diags, cs_app(dret, cs_app(rb.diags, cs_ochk_ret(nm, sg.pubf, sg.fromp, rb.origin))))))))))
fn cs_odiagnose_stmts(prog, osigs, sigs, kt, moved) = match prog
    Nil        => Nil
    Cons(h, t) => cs_odiagnose_stmt1(h, t, osigs, sigs, kt, moved)
fn cs_odiagnose_stmt1(s0, rest, osigs, sigs, kt, moved) = match s0
    Fn(nm, ps, body) => cs_app(cs_ochk_fn(nm, ps, body, cs_osiglookup(nm, osigs), osigs, sigs, kt), cs_odiagnose_stmts(rest, osigs, sigs, kt, moved))
    Print(v)         => let ds = cs_schk_conc_e(v, "<main>", 0, Nil, Nil) in let r = cs_ochke(v, {fnm: "<main>", pubf: 0, freef: 0, halloc: 0, bparams: Nil, mvars: Nil, origins: Nil, osigs: osigs}, moved) in cs_app(ds, cs_app(r.diags, cs_odiagnose_stmts(rest, osigs, sigs, kt, r.moved)))
    ExprS(v)         => let ds = cs_schk_conc_e(v, "<main>", 0, Nil, Nil) in let r = cs_ochke(v, {fnm: "<main>", pubf: 0, freef: 0, halloc: 0, bparams: Nil, mvars: Nil, origins: Nil, osigs: osigs}, moved) in cs_app(ds, cs_app(r.diags, cs_odiagnose_stmts(rest, osigs, sigs, kt, r.moved)))
    _                => cs_odiagnose_stmts(rest, osigs, sigs, kt, moved)

fn cs_diagnose_stmts(prog, tt) = match prog
    Nil        => Nil
    Cons(h, t) => cs_app(cs_diagnose_stmt(h, tt), cs_diagnose_stmts(t, tt))
fn cs_diagnose_stmt(s0, tt) = match s0
    Fn(nm, ps, body) => let tt2 = {ctors: tt.ctors, recs: tt.recs, sigs: tt.sigs, gsigs: tt.gsigs, decl: tt.decl, ft: tt.ft, lenv: cs_fn_lenv(cs_siglookup(nm, tt.sigs))} in cs_app(cs_chk_ret(nm, body, tt2), cs_chk_expr(body, tt2))
    Print(v)         => cs_chk_expr(v, tt)
    ExprS(v)         => cs_chk_expr(v, tt)
    _                => Nil
fn cs_diagnose(prog0) = let ft0 = cs_buildft(prog0) in let gnms = cs_n4_collect_grads_prog(prog0, Nil) in let d_ad = cs_n4_chk_grad_fns(gnms, ft0) in let gfns = cs_n4_synth_grad_fns(gnms, ft0) in let prog = cs_app(gfns, prog0) in let tt = cs_tcollect(prog) in let osigs = cs_ocollects(prog) in let vsigs = cs_vcollect_vsigs(prog) in let laws = cs_vcollect_laws(prog) in let kt = {ksigs: cs_kcollect_effsigs(prog), edecls: cs_kcollect_effdecls(prog), caps: cs_kcollect_caps(prog), recs: tt.recs, vsigs: vsigs, osigs: osigs} in let hr = cs_collect_holes_stmts(prog, tt.sigs, osigs, vsigs, laws, tt.ft) in let prog2 = cs_fill_prog_holes(prog, tt.sigs, osigs, vsigs, laws, tt.ft) in let vr = cs_vprove_all(prog2) in cs_app(cs_p35_diags(osigs, prog0), cs_app(d_ad, cs_app(cs_diagnose_stmts(prog2, tt), cs_app(hr.diags, cs_app(vr.diags, cs_odiagnose_stmts(prog2, osigs, tt.sigs, kt, Nil))))))

## --- C3 generic erasure & C1/C2/M1/M2 comptime + hygienic macro expansion ---
fn cs_gcfs(pl) = match pl
    Nil        => Nil
    Cons(p, r) => Cons(p.cf, cs_gcfs(r))
fn cs_gcoll(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_gcoll2(h, t)
fn cs_gcoll2(h, t) = match h
    GSig(nm, pl, rt) => Cons({fname: nm, cfs: cs_gcfs(pl)}, cs_gcoll(t))
    _                => cs_gcoll(t)
fn cs_gtlookup(nm, gt) = match gt
    Nil        => Nil
    Cons(h, t) => if h.fname == nm then Cons(h, Nil) else cs_gtlookup(nm, t)
fn cs_gefilter(args, cfs) = match cfs
    Nil         => args
    Cons(c, cr) => cs_gefilter2(args, c, cr)
fn cs_gefilter2(args, c, cr) = match args
    Nil         => Nil
    Cons(a, ar) => if c == 1 then cs_gefilter(ar, cr) else Cons(a, cs_gefilter(ar, cr))
fn cs_gecall(nm, ea, m) = match m
    Nil        => if (nm == "borrow" or nm == "borrow_mut" or nm == "move" or nm == "clone" or nm == "verify" or nm == "law_check" or nm == "evolve_approve" or nm == "old") and cs_len(ea) >= 1 then cs_asthead(ea) else if nm == "grad" and cs_len(ea) >= 2 then Call("__ad_grad_" + cs_n4_var_name(cs_asthead(ea)), cs_cvtl(ea)) else if nm == "value_and_grad" and cs_len(ea) >= 2 then Rec(Cons({key: "val", val: Call(cs_n4_var_name(cs_asthead(ea)), cs_cvtl(ea))}, Cons({key: "grad", val: Call("__ad_grad_" + cs_n4_var_name(cs_asthead(ea)), cs_cvtl(ea))}, Nil))) else if nm == "jvp" and cs_len(ea) == 3 then Bin("*", Call("__ad_grad_" + cs_n4_var_name(cs_asthead(ea)), Cons(cs_astsecond(ea), Nil)), cs_asthead(cs_cvtl(cs_cvtl(ea)))) else if nm == "vjp" and cs_len(ea) == 3 then Bin("*", cs_asthead(cs_cvtl(cs_cvtl(ea))), Call("__ad_grad_" + cs_n4_var_name(cs_asthead(ea)), Cons(cs_astsecond(ea), Nil))) else if nm == "jit" and cs_len(ea) >= 2 then Call(cs_n4_var_name(cs_asthead(ea)), cs_cvtl(ea)) else Call(nm, ea)
    Cons(g, r) => Call(nm, cs_gefilter(ea, g.cfs))
fn cs_geexpr(e, gt) = match e
    Bin(op, a, b)    => Bin(op, cs_geexpr(a, gt), cs_geexpr(b, gt))
    If(c, t, e2)     => If(cs_geexpr(c, gt), cs_geexpr(t, gt), cs_geexpr(e2, gt))
    LetIn(nm, v, b)  => let gfn = cs_n4_is_grad_let(v) in if gfn != "" then cs_geexpr(cs_n4_subst_call(b, nm, "__ad_grad_" + gfn), gt) else LetIn(nm, cs_geexpr(v, gt), cs_geexpr(b, gt))
    VarIn(nm, v, b)  => LetIn(nm, cs_geexpr(v, gt), cs_geexpr(b, gt))
    OwnE(inner)      => cs_geexpr(inner, gt)
    MutE(inner)      => cs_geexpr(inner, gt)
    DeferE(c, b)     => LetIn("_d_val", cs_geexpr(b, gt), LetIn("_d_run", cs_geexpr(c, gt), Var("_d_val")))
    ErrDeferE(c, b)  => LetIn("_ed_val", cs_geexpr(b, gt), If(Bin("<", Var("_ed_val"), Num(0)), LetIn("_ed_run", cs_geexpr(c, gt), Var("_ed_val")), Var("_ed_val")))
    WithAllocE(a, b) => LetIn("_alloc_ctx", cs_geexpr(a, gt), cs_geexpr(b, gt))
    WithHandlerE(en, hs, b) => WithHandlerE(en, hs, cs_geexpr(b, gt))
    ScopeE(snm, b)   => LetIn(snm, Num(1), cs_geexpr(b, gt))
    SpawnE(inner)    => cs_geexpr(inner, gt)
    Call(nm, args)   => cs_gecall(nm, cs_geargs(args, gt), cs_gtlookup(nm, gt))
    Rec(items)       => Rec(cs_gerec(items, gt))
    RecT(tn, items)  => RecT(tn, cs_gerec(items, gt))
    Field(o, nm)     => Field(cs_geexpr(o, gt), nm)
    Match(sc, arms)  => Match(cs_geexpr(sc, gt), cs_gearms(arms, gt))
    CT(inner)        => CT(cs_geexpr(inner, gt))
    Quote(inner)     => Quote(cs_geexpr(inner, gt))
    Splice(inner)    => Splice(cs_geexpr(inner, gt))
    _                => e
fn cs_geargs(xs, gt) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_geexpr(h, gt), cs_geargs(t, gt))
fn cs_gerec(xs, gt) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: cs_geexpr(h.val, gt)}, cs_gerec(t, gt))
fn cs_gearms(xs, gt) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: cs_geexpr(h.body, gt)}, cs_gearms(t, gt))
fn cs_gerase_stmt(h, gt) = match h
    Fn(nm, ps, body) => Fn(nm, ps, cs_geexpr(body, gt))
    Print(v)         => Print(cs_geexpr(v, gt))
    ExprS(v)         => ExprS(cs_geexpr(v, gt))
    _                => h
fn cs_gerase_stmts(prog, gt) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(cs_gerase_stmt(h, gt), cs_gerase_stmts(t, gt))
fn cs_gerase(prog) = cs_gerase_stmts(prog, cs_gcoll(prog))

fn cs_ctnode(cv) = if cv.kind == "int" then Num(cv.i) else if cv.kind == "str" then Str(cv.s) else if cs_isnil(cv.items) == 1 then Var(cv.s) else Call(cv.s, cs_ctnodelist(cv.items))
fn cs_ctnodelist(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_ctnode(h), cs_ctnodelist(t))
fn cs_ishyg(nm) = cs_startswith(nm, "_hyg_")
fn cs_chyg(e, renv, n) = match e
    Var(nm)         => {node: Var(cs_qvar(nm, renv)), n: n}
    LetIn(nm, v, b) => let rv = cs_chyg(v, renv, n) in if cs_ishyg(nm) == 1 then let nnm = "_hyg_" + str(rv.n) in let rb = cs_chyg(b, Cons({k: nm, v: nnm}, renv), rv.n + 1) in {node: LetIn(nnm, rv.node, rb.node), n: rb.n} else let rb = cs_chyg(b, Cons({k: nm, v: nm}, renv), rv.n) in {node: LetIn(nm, rv.node, rb.node), n: rb.n}
    Bin(op, a, b)   => let ra = cs_chyg(a, renv, n) in let rb = cs_chyg(b, renv, ra.n) in {node: Bin(op, ra.node, rb.node), n: rb.n}
    If(c, t, e2)    => let rc = cs_chyg(c, renv, n) in let rt = cs_chyg(t, renv, rc.n) in let re = cs_chyg(e2, renv, rt.n) in {node: If(rc.node, rt.node, re.node), n: re.n}
    Call(nm, args)  => let rl = cs_chyglist(args, renv, n) in {node: Call(nm, rl.items), n: rl.n}
    _               => {node: e, n: n}
fn cs_chyglist(xs, renv, n) = match xs
    Nil        => {items: Nil, n: n}
    Cons(h, t) => let rh = cs_chyg(h, renv, n) in let rt = cs_chyglist(t, renv, rh.n) in {items: Cons(rh.node, rt.items), n: rt.n}

fn cs_folde(e, ft) = match e
    CT(inner)       => let r = cs_ceval(inner, Nil, ft, 0) in if r.ok == 1 then cs_ctnode(r.v) else e
    Splice(inner)   => let r = cs_ceval(inner, Nil, ft, 0) in if r.ok == 0 then e else let u = cs_unreify(r.v) in if u.ok == 1 then cs_folde(u.node, ft) else e
    Bin(op, a, b)   => Bin(op, cs_folde(a, ft), cs_folde(b, ft))
    If(c, t, e2)    => If(cs_folde(c, ft), cs_folde(t, ft), cs_folde(e2, ft))
    LetIn(nm, v, b) => LetIn(nm, cs_folde(v, ft), cs_folde(b, ft))
    WithHandlerE(en, hs, b) => WithHandlerE(en, hs, cs_folde(b, ft))
    Call(nm, args)  => Call(nm, cs_foldeargs(args, ft))
    _               => e
fn cs_foldeargs(xs, ft) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_folde(h, ft), cs_foldeargs(t, ft))
fn cs_foldstmt(h, ft) = match h
    Fn(nm, ps, body) => Fn(nm, ps, (cs_chyg(cs_folde(body, ft), Nil, 1)).node)
    Print(v)         => Print((cs_chyg(cs_folde(v, ft), Nil, 1)).node)
    ExprS(v)         => ExprS((cs_chyg(cs_folde(v, ft), Nil, 1)).node)
    _                => h
fn cs_foldstmts(prog, ft) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(cs_foldstmt(h, ft), cs_foldstmts(t, ft))
fn cs_expand(prog) = let er = cs_gerase(prog) in cs_foldstmts(er, cs_buildft(er))

## --- canonical AST S-expression formatter ---
fn cs_expr_sexpr(e) = match e
    Num(n)          => str(n)
    Str(v)          => "\"" + cs_jesc(v) + "\""
    Var(nm)         => nm
    Bin(op, a, b)   => "(" + op + " " + cs_expr_sexpr(a) + " " + cs_expr_sexpr(b) + ")"
    If(c, t, e2)    => "(if " + cs_expr_sexpr(c) + " " + cs_expr_sexpr(t) + " " + cs_expr_sexpr(e2) + ")"
    LetIn(nm, v, b)  => "(let " + nm + " " + cs_expr_sexpr(v) + " " + cs_expr_sexpr(b) + ")"
    VarIn(nm, v, b)  => "(var " + nm + " " + cs_expr_sexpr(v) + " " + cs_expr_sexpr(b) + ")"
    OwnE(inner)      => "(own " + cs_expr_sexpr(inner) + ")"
    MutE(inner)      => "(mut " + cs_expr_sexpr(inner) + ")"
    DeferE(c, b)     => "(defer " + cs_expr_sexpr(c) + " " + cs_expr_sexpr(b) + ")"
    ErrDeferE(c, b)  => "(errdefer " + cs_expr_sexpr(c) + " " + cs_expr_sexpr(b) + ")"
    WithAllocE(a, b) => "(with-alloc " + cs_expr_sexpr(a) + " " + cs_expr_sexpr(b) + ")"
    WithHandlerE(en, hs, b) => "(with-handler " + en + " " + cs_expr_sexpr(b) + ")"
    ScopeE(snm, b)   => "(scope " + snm + " " + cs_expr_sexpr(b) + ")"
    SpawnE(inner)    => "(spawn " + cs_expr_sexpr(inner) + ")"
    Call(nm, args)  => if cs_isnil(args) == 1 then "(" + nm + ")" else "(" + nm + " " + cs_exprs_sexpr(args) + ")"
    CT(inner)       => "(comptime " + cs_expr_sexpr(inner) + ")"
    Quote(inner)    => "(quote " + cs_expr_sexpr(inner) + ")"
    Splice(inner)   => "(splice " + cs_expr_sexpr(inner) + ")"
    Rec(items)      => "(record)"
    RecT(tn, items) => "(" + tn + "{...})"
    Field(o, nm)    => "(field " + cs_expr_sexpr(o) + " " + nm + ")"
    Match(sc, arms) => "(match " + cs_expr_sexpr(sc) + ")"
    _               => "?"
fn cs_exprs_sexpr(xs) = match xs
    Nil        => ""
    Cons(h, t) => if cs_isnil(t) == 1 then cs_expr_sexpr(h) else cs_expr_sexpr(h) + " " + cs_exprs_sexpr(t)
fn cs_stmt_sexpr(s0) = match s0
    Fn(nm, ps, body) => Cons("(fn " + nm + " (" + cs_joinsep(ps, " ") + ") " + cs_expr_sexpr(body) + ")", Nil)
    Print(v)         => Cons("(print " + cs_expr_sexpr(v) + ")", Nil)
    ExprS(v)         => Cons(cs_expr_sexpr(v), Nil)
    _                => Nil
fn cs_prog_sexprs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_app(cs_stmt_sexpr(h), cs_prog_sexprs(t))
fn cs_prog_sexpr(prog) = cs_joinsep(cs_prog_sexprs(prog), " ")

## --- native x86-64 assembly emitter (`asm` output) ---
fn cs_asm_expr(e) = match e
    Num(n)          => "    movq $" + str(n) + ", %rax\n"
    Var(nm)         => "    # var " + nm + "\n"
    Bin(op, a, b)   => cs_asm_expr(a) + "    pushq %rax\n" + cs_asm_expr(b) + "    movq %rax, %rcx\n    popq %rax\n" + (if op == "+" then "    movq %rax, %rdi\n    movq %rcx, %rsi\n    call addv\n" else if op == "-" then "    subq %rcx, %rax\n" else if op == "*" then "    imulq %rcx, %rax\n" else "    # op " + op + "\n")
    Call(nm, args)  => cs_asm_args(args) + "    call " + nm + "\n"
    LetIn(nm, v, b) => cs_asm_expr(v) + cs_asm_expr(b)
    If(c, t, e2)    => cs_asm_expr(c) + cs_asm_expr(t) + cs_asm_expr(e2)
    _               => ""
fn cs_asm_args(xs) = match xs
    Nil        => ""
    Cons(h, t) => cs_asm_expr(h) + "    movq %rax, %rdi\n" + cs_asm_args(t)
fn cs_asm_fn1(h) = match h
    Fn(nm, ps, body) => nm + ":\n    pushq %rbp\n    movq %rsp, %rbp\n" + cs_asm_expr(body) + "    movq %rbp, %rsp\n    popq %rbp\n    ret\n"
    _                => ""
fn cs_asm_fns(prog) = match prog
    Nil        => ""
    Cons(h, t) => cs_asm_fn1(h) + cs_asm_fns(t)
fn cs_asm_main1(h) = match h
    Print(v) => cs_asm_expr(v) + "    movq %rax, %rdi\n    call printval\n"
    ExprS(v) => cs_asm_expr(v)
    _        => ""
fn cs_asm_main(prog) = match prog
    Nil        => ""
    Cons(h, t) => cs_asm_main1(h) + cs_asm_main(t)
fn cs_asm_gen(prog) = ".text\n.globl _start\n" + cs_asm_fns(prog) + "_start:\n" + cs_asm_main(prog) + "    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n"

## --- in-memory program evaluation (`result` output) ---
fn cs_cv_show(cv) = if cv.kind == "int" then str(cv.i) else if cv.kind == "str" then cv.s else if cv.kind == "ctor" then (if cs_isnil(cv.items) == 1 then cv.s else cv.s + "(" + cs_cv_showlist(cv.items) + ")") else "{...}"
fn cs_cv_showlist(xs) = match xs
    Nil        => ""
    Cons(h, t) => if cs_isnil(t) == 1 then cs_cv_show(h) else cs_cv_show(h) + ", " + cs_cv_showlist(t)
fn cs_eval_stmt1(h, t, ft) = match h
    Print(v) => let r = cs_ceval(v, Nil, ft, 0) in if r.ok == 1 then Cons(cs_cv_show(r.v), cs_eval_stmts(t, ft)) else cs_eval_stmts(t, ft)
    _        => cs_eval_stmts(t, ft)
fn cs_eval_stmts(prog, ft) = match prog
    Nil        => Nil
    Cons(h, t) => cs_eval_stmt1(h, t, ft)
fn cs_eval_prog(prog) = cs_joinsep(cs_eval_stmts(prog, cs_buildft(prog)), "\n")

## --- PUBLIC CALLABLE LIBRARY API (`use lcaas`) ---
fn cs_collect_holes(prog) = let tt = cs_tcollect(prog) in let osigs = cs_ocollects(prog) in let vsigs = cs_vcollect_vsigs(prog) in let laws = cs_vcollect_laws(prog) in (cs_collect_holes_stmts(prog, tt.sigs, osigs, vsigs, laws, tt.ft)).holes
fn caas_compile(src) = let ast0 = cs_parse(src) in let syms = cs_symbols(ast0) in let ft0 = cs_buildft(ast0) in let gnms = cs_n4_collect_grads_prog(ast0, Nil) in let d_ad = cs_n4_chk_grad_fns(gnms, ft0) in let gfns = cs_n4_synth_grad_fns(gnms, ft0) in let ast = cs_app(gfns, ast0) in let tt = cs_tcollect(ast) in let osigs = cs_ocollects(ast) in let vsigs = cs_vcollect_vsigs(ast) in let invs = cs_vcollect_invs(ast) in let laws = cs_vcollect_laws(ast) in let wcets = cs_vcollect_wcets(ast) in let kt = {ksigs: cs_kcollect_effsigs(ast), edecls: cs_kcollect_effdecls(ast), caps: cs_kcollect_caps(ast), recs: tt.recs, vsigs: vsigs, osigs: osigs} in let hr = cs_collect_holes_stmts(ast0, tt.sigs, osigs, vsigs, laws, tt.ft) in let ast_filled = cs_fill_prog_holes(ast, tt.sigs, osigs, vsigs, laws, tt.ft) in let vr = cs_vprove_stmts(ast_filled, vsigs, invs, wcets, osigs, cs_buildft(ast_filled)) in let diags = cs_app(cs_p35_diags(osigs, ast0), cs_app(d_ad, cs_app(cs_diagnose_stmts(ast_filled, tt), cs_app(hr.diags, cs_app(vr.diags, cs_odiagnose_stmts(ast_filled, osigs, tt.sigs, kt, Nil)))))) in let raw_sexpr = cs_prog_sexpr(ast0) in if cs_has_error_diags(diags) == 1 then {ok: 0, diagnostics: diags, holes: hr.holes, proofs: vr.proofs, symbols: syms, ast: ast0, ast_sexpr: raw_sexpr, expanded: Nil, expanded_sexpr: "", asm: "", result: ""} else let exp = cs_expand(ast_filled) in {ok: 1, diagnostics: diags, holes: hr.holes, proofs: vr.proofs, symbols: syms, ast: ast0, ast_sexpr: raw_sexpr, expanded: exp, expanded_sexpr: cs_prog_sexpr(exp), asm: cs_asm_gen(exp), result: cs_eval_prog(exp)}

fn caas_check(src) = caas_compile(src)
fn caas_fill(src) = (caas_compile(src)).holes
fn caas_prove(src) = (caas_compile(src)).proofs
fn caas_ast(src) = (caas_compile(src)).ast_sexpr
fn caas_expand(src) = (caas_compile(src)).expanded_sexpr
fn caas_symbols(src) = (caas_compile(src)).symbols
fn caas_asm(src) = (caas_compile(src)).asm
fn caas_eval(src) = (caas_compile(src)).result

## --- JSON serialisation for `lume agent` ---
fn cs_strlist_json(xs) = match xs
    Nil        => ""
    Cons(h, t) => "\"" + cs_jesc(h) + "\"" + (if cs_isnil(t) == 1 then "" else "," + cs_strlist_json(t))
fn cs_ctx1_json(c) = "{\"name\":\"" + cs_jesc(c.k) + "\",\"type\":\"" + cs_jesc(c.v) + "\"}"
fn cs_ctx_json(cs) = match cs
    Nil        => ""
    Cons(h, t) => cs_ctx1_json(h) + (if cs_isnil(t) == 1 then "" else "," + cs_ctx_json(t))
fn cs_hole_json(h) = "{\"hole\":\"" + cs_jesc(h.hole) + "\",\"function\":\"" + cs_jesc(h.fnm) + "\",\"expected_type\":\"" + cs_jesc(h.expected_type) + "\",\"context\":[" + cs_ctx_json(h.context) + "],\"candidates\":[" + cs_strlist_json(h.candidates) + "],\"proven_candidates\":[" + cs_strlist_json(h.proven_candidates) + "]}"
fn cs_holes_json(hs) = match hs
    Nil        => ""
    Cons(h, t) => cs_hole_json(h) + (if cs_isnil(t) == 1 then "" else "," + cs_holes_json(t))
fn cs_proof_json(p) = "{\"name\":\"" + cs_jesc(p.name) + "\",\"kind\":\"" + cs_jesc(p.kind) + "\",\"status\":\"" + cs_jesc(p.status) + "\",\"obligation\":\"" + cs_jesc(p.obligation) + "\",\"counterexample\":\"" + cs_jesc(p.counterexample) + "\"}"
fn cs_proofs_json(ps) = match ps
    Nil        => ""
    Cons(h, t) => cs_proof_json(h) + (if cs_isnil(t) == 1 then "" else "," + cs_proofs_json(t))
fn cs_diag_json(d) = "{\"code\":\"" + cs_jesc(d.code) + "\",\"severity\":\"" + cs_jesc(d.severity) + "\",\"phase\":\"" + cs_jesc(d.phase) + "\",\"message\":\"" + cs_jesc(d.message) + "\",\"fixit\":\"" + cs_jesc(d.fixit) + "\"}"
fn cs_diags_json(ds) = match ds
    Nil        => ""
    Cons(h, t) => if cs_isnil(t) == 1 then cs_diag_json(h) else cs_diag_json(h) + "," + cs_diags_json(t)
fn cs_sym_json(s) = "{\"name\":\"" + cs_jesc(s.name) + "\",\"kind\":\"" + cs_jesc(s.kind) + "\",\"signature\":\"" + cs_jesc(s.sig) + "\"}"
fn cs_syms_json(ss) = match ss
    Nil        => ""
    Cons(h, t) => if cs_isnil(t) == 1 then cs_sym_json(h) else cs_sym_json(h) + "," + cs_syms_json(t)
fn caas_json(r) = "{\"ok\":" + (if r.ok == 1 then "true" else "false") + ",\"diagnostics\":[" + cs_diags_json(r.diagnostics) + "],\"holes\":[" + cs_holes_json(r.holes) + "],\"proofs\":[" + cs_proofs_json(r.proofs) + "],\"symbols\":[" + cs_syms_json(r.symbols) + "],\"ast\":\"" + cs_jesc(r.ast_sexpr) + "\",\"expanded\":\"" + cs_jesc(r.expanded_sexpr) + "\",\"has_asm\":" + (if count(r.asm) > 0 then "true" else "false") + ",\"result\":\"" + cs_jesc(r.result) + "\"}"

## --- Stage 5: Proof Certificates (G3/H3), C-Header Bindings (I3), and MCP Server (G1) ---
fn sha_ord_lo(c) = if c < "0" then (if c < "(" then (if c == " " then 32 else if c == "!" then 33 else if c == "\"" then 34 else if c == "#" then 35 else if c == "$" then 36 else if c == "%" then 37 else if c == "&" then 38 else 39) else (if c == "(" then 40 else if c == ")" then 41 else if c == "*" then 42 else if c == "+" then 43 else if c == "," then 44 else if c == "-" then 45 else if c == "." then 46 else 47)) else (if c < ":" then 48 + toint(c) else (if c == ":" then 58 else if c == ";" then 59 else if c == "<" then 60 else if c == "=" then 61 else if c == ">" then 62 else if c == "?" then 63 else 64))
fn sha_ord_up(c) = if c < "N" then (if c < "G" then (if c == "A" then 65 else if c == "B" then 66 else if c == "C" then 67 else if c == "D" then 68 else if c == "E" then 69 else 70) else (if c == "G" then 71 else if c == "H" then 72 else if c == "I" then 73 else if c == "J" then 74 else if c == "K" then 75 else if c == "L" then 76 else 77)) else (if c < "U" then (if c == "N" then 78 else if c == "O" then 79 else if c == "P" then 80 else if c == "Q" then 81 else if c == "R" then 82 else if c == "S" then 83 else 84) else (if c == "U" then 85 else if c == "V" then 86 else if c == "W" then 87 else if c == "X" then 88 else if c == "Y" then 89 else if c == "Z" then 90 else if c == "[" then 91 else if c == "\\" then 92 else if c == "]" then 93 else if c == "^" then 94 else if c == "_" then 95 else 96))
fn sha_ord_az(c) = if c < "n" then (if c < "g" then (if c == "a" then 97 else if c == "b" then 98 else if c == "c" then 99 else if c == "d" then 100 else if c == "e" then 101 else 102) else (if c == "g" then 103 else if c == "h" then 104 else if c == "i" then 105 else if c == "j" then 106 else if c == "k" then 107 else if c == "l" then 108 else 109)) else (if c < "u" then (if c == "n" then 110 else if c == "o" then 111 else if c == "p" then 112 else if c == "q" then 113 else if c == "r" then 114 else if c == "s" then 115 else 116) else (if c == "u" then 117 else if c == "v" then 118 else if c == "w" then 119 else if c == "x" then 120 else if c == "y" then 121 else if c == "z" then 122 else if c == "|" then 124 else if c == "~" then 126 else if c > "z" and c < "|" then 123 else 125))
fn sha_ord(c) = if c == "\n" then 10 else if c == "\r" then 13 else if c == "\t" then 9 else if c > "~" then ord(c) else if c < "A" then sha_ord_lo(c) else if c < "a" then sha_ord_up(c) else sha_ord_az(c)
fn sha_u32(x) = let r = x % 4294967296 in if r < 0 then r + 4294967296 else r
fn sha_pow2(n) = if n >= 32 then 4294967296 else if n >= 31 then 2147483648 else if n >= 30 then 1073741824 else if n >= 29 then 536870912 else if n >= 28 then 268435456 else if n >= 27 then 134217728 else if n >= 26 then 67108864 else if n >= 25 then 33554432 else if n >= 24 then 16777216 else if n >= 23 then 8388608 else if n >= 22 then 4194304 else if n >= 21 then 2097152 else if n >= 20 then 1048576 else if n >= 19 then 524288 else if n >= 18 then 262144 else if n >= 17 then 131072 else if n >= 16 then 65536 else if n >= 15 then 32768 else if n >= 14 then 16384 else if n >= 13 then 8192 else if n >= 12 then 4096 else if n >= 11 then 2048 else if n >= 10 then 1024 else if n >= 9 then 512 else if n >= 8 then 256 else if n >= 7 then 128 else if n >= 6 then 64 else if n >= 5 then 32 else if n >= 4 then 16 else if n >= 3 then 8 else if n >= 2 then 4 else if n >= 1 then 2 else 1
fn sha_shr(x, n) = x / sha_pow2(n)
fn sha_rotr(x, n) = let p = sha_pow2(n) in (x / p) + ((x % p) * sha_pow2(32 - n))
fn sha_bv_xor32(x, y) = (bv_xor(x / 65536, y / 65536) * 65536) + bv_xor(x % 65536, y % 65536)
fn sha_bv_and32(x, y) = (bv_and(x / 65536, y / 65536) * 65536) + bv_and(x % 65536, y % 65536)
fn sha_xor3_4(x, y, z) = let b0 = ((x % 2) + (y % 2) + (z % 2)) % 2 in let b1 = (((x / 2) % 2) + ((y / 2) % 2) + ((z / 2) % 2)) % 2 in let b2 = (((x / 4) % 2) + ((y / 4) % 2) + ((z / 4) % 2)) % 2 in let b3 = (((x / 8) % 2) + ((y / 8) % 2) + ((z / 8) % 2)) % 2 in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_xor3_n(x, y, z, nibs) = if nibs == 8 then sha_bv_xor32(sha_bv_xor32(x, y), z) else if nibs <= 0 then 0 else sha_xor3_4(x % 16, y % 16, z % 16) + 16 * sha_xor3_n(x / 16, y / 16, z / 16, nibs - 1)
fn sha_ch_4(e, f, g) = let b0 = (if (e % 2) == 1 then (f % 2) else (g % 2)) in let b1 = (if ((e / 2) % 2) == 1 then ((f / 2) % 2) else ((g / 2) % 2)) in let b2 = (if ((e / 4) % 2) == 1 then ((f / 4) % 2) else ((g / 4) % 2)) in let b3 = (if ((e / 8) % 2) == 1 then ((f / 8) % 2) else ((g / 8) % 2)) in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_ch_n(e, f, g, nibs) = if nibs == 8 then sha_bv_xor32(sha_bv_and32(e, f), sha_bv_and32(sha_bv_xor32(e, 4294967295), g)) else if nibs <= 0 then 0 else sha_ch_4(e % 16, f % 16, g % 16) + 16 * sha_ch_n(e / 16, f / 16, g / 16, nibs - 1)
fn sha_maj_4(a, b, c) = let b0 = (if (a % 2) + (b % 2) + (c % 2) >= 2 then 1 else 0) in let b1 = (if ((a / 2) % 2) + ((b / 2) % 2) + ((c / 2) % 2) >= 2 then 1 else 0) in let b2 = (if ((a / 4) % 2) + ((b / 4) % 2) + ((c / 4) % 2) >= 2 then 1 else 0) in let b3 = (if ((a / 8) % 2) + ((b / 8) % 2) + ((c / 8) % 2) >= 2 then 1 else 0) in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_maj_n(a, b, c, nibs) = if nibs == 8 then sha_bv_xor32(sha_bv_xor32(sha_bv_and32(a, b), sha_bv_and32(a, c)), sha_bv_and32(b, c)) else if nibs <= 0 then 0 else sha_maj_4(a % 16, b % 16, c % 16) + 16 * sha_maj_n(a / 16, b / 16, c / 16, nibs - 1)
fn sha_big_sig0(a) = sha_xor3_n(sha_rotr(a, 2), sha_rotr(a, 13), sha_rotr(a, 22), 8)
fn sha_big_sig1(e) = sha_xor3_n(sha_rotr(e, 6), sha_rotr(e, 11), sha_rotr(e, 25), 8)
fn sha_sml_sig0(x) = sha_xor3_n(sha_rotr(x, 7), sha_rotr(x, 18), sha_shr(x, 3), 8)
fn sha_sml_sig1(x) = sha_xor3_n(sha_rotr(x, 17), sha_rotr(x, 19), sha_shr(x, 10), 8)
fn sha_k(t) = if t < 16 then (if t == 0 then 1116352408 else if t == 1 then 1899447441 else if t == 2 then 3049323471 else if t == 3 then 3921009573 else if t == 4 then 961987163 else if t == 5 then 1508970993 else if t == 6 then 2453635748 else if t == 7 then 2870763221 else if t == 8 then 3624381080 else if t == 9 then 310598401 else if t == 10 then 607225278 else if t == 11 then 1426881987 else if t == 12 then 1925078388 else if t == 13 then 2162078206 else if t == 14 then 2614888103 else 3248222580) else if t < 32 then (if t == 16 then 3835390401 else if t == 17 then 4022224774 else if t == 18 then 264347078 else if t == 19 then 604807628 else if t == 20 then 770255983 else if t == 21 then 1249150122 else if t == 22 then 1555081692 else if t == 23 then 1996064986 else if t == 24 then 2554220882 else if t == 25 then 2821834349 else if t == 26 then 2952996808 else if t == 27 then 3210313671 else if t == 28 then 3336571891 else if t == 29 then 3584528711 else if t == 30 then 113926993 else 338241895) else if t < 48 then (if t == 32 then 666307205 else if t == 33 then 773529912 else if t == 34 then 1294757372 else if t == 35 then 1396182291 else if t == 36 then 1695183700 else if t == 37 then 1986661051 else if t == 38 then 2177026350 else if t == 39 then 2456956037 else if t == 40 then 2730485921 else if t == 41 then 2820302411 else if t == 42 then 3259730800 else if t == 43 then 3345764771 else if t == 44 then 3516065817 else if t == 45 then 3600352804 else if t == 46 then 4094571909 else 275423344) else (if t == 48 then 430227734 else if t == 49 then 506948616 else if t == 50 then 659060556 else if t == 51 then 883997877 else if t == 52 then 958139571 else if t == 53 then 1322822218 else if t == 54 then 1537002063 else if t == 55 then 1747873779 else if t == 56 then 1955562222 else if t == 57 then 2024104815 else if t == 58 then 2227730452 else if t == 59 then 2361852424 else if t == 60 then 2428436474 else if t == 61 then 2756734187 else if t == 62 then 3204031479 else 3329325298)
fn sha_nth(xs, i) = match xs
    Nil        => 0
    Cons(h, t) => if i <= 0 then h else sha_nth(t, i - 1)
fn sha_msg_byte(s, len, total, idx) = if idx < len then sha_ord(at(s, idx)) else if idx == len then 128 else if idx >= total - 8 then ((len * 8) / sha_pow2(8 * (total - 1 - idx))) % 256 else 0
fn sha_msg_word(s, len, total, base) = sha_msg_byte(s, len, total, base) * 16777216 + sha_msg_byte(s, len, total, base + 1) * 65536 + sha_msg_byte(s, len, total, base + 2) * 256 + sha_msg_byte(s, len, total, base + 3)
fn sha_w_build(s, len, total, blk_off, t, w_rev) = if t >= 64 then w_rev else let wt = (if t < 16 then sha_msg_word(s, len, total, blk_off + t * 4) else sha_u32(sha_nth(w_rev, 15) + sha_sml_sig0(sha_nth(w_rev, 14)) + sha_nth(w_rev, 6) + sha_sml_sig1(sha_nth(w_rev, 1)))) in sha_w_build(s, len, total, blk_off, t + 1, Cons(wt, w_rev))
fn sha_round(st, wt, kt) = let t1 = sha_u32(st.h + sha_big_sig1(st.e) + sha_ch_n(st.e, st.f, st.g, 8) + kt + wt) in let t2 = sha_u32(sha_big_sig0(st.a) + sha_maj_n(st.a, st.b, st.c, 8)) in {a: sha_u32(t1 + t2), b: st.a, c: st.b, d: st.c, e: sha_u32(st.d + t1), f: st.e, g: st.f, h: st.g}
fn sha_rounds(st, w_rev, t) = if t >= 64 then st else sha_rounds(sha_round(st, sha_nth(w_rev, 63 - t), sha_k(t)), w_rev, t + 1)
fn sha_blocks(s, len, total, blk_off, st) = if blk_off >= total then st else let w_rev = sha_w_build(s, len, total, blk_off, 0, Nil) in let r = sha_rounds(st, w_rev, 0) in sha_blocks(s, len, total, blk_off + 64, {a: sha_u32(st.a + r.a), b: sha_u32(st.b + r.b), c: sha_u32(st.c + r.c), d: sha_u32(st.d + r.d), e: sha_u32(st.e + r.e), f: sha_u32(st.f + r.f), g: sha_u32(st.g + r.g), h: sha_u32(st.h + r.h)})
fn sha_hex1(n) = at("0123456789abcdef", n % 16)
fn sha_hex32(w) = sha_hex1(w / 268435456) + sha_hex1(w / 16777216) + sha_hex1(w / 1048576) + sha_hex1(w / 65536) + sha_hex1(w / 4096) + sha_hex1(w / 256) + sha_hex1(w / 16) + sha_hex1(w)
fn sha256_hex(s) = let len = count(s) in let total = ((len + 9 + 63) / 64) * 64 in let init = {a: 1779033703, b: 3144134277, c: 1013904242, d: 2773480762, e: 1359893119, f: 2600822924, g: 528734635, h: 1541459225} in let fin = sha_blocks(s, len, total, 0, init) in sha_hex32(fin.a) + sha_hex32(fin.b) + sha_hex32(fin.c) + sha_hex32(fin.d) + sha_hex32(fin.e) + sha_hex32(fin.f) + sha_hex32(fin.g) + sha_hex32(fin.h)

fn lc_sha256(s) = "sha256:" + sha256_hex(s)

fn lc_count_proven(ps) = match ps
    Nil        => 0
    Cons(h, t) => (if h.status == "proven" then 1 else 0) + lc_count_proven(t)
fn lc_count_budget(ps) = match ps
    Nil        => 0
    Cons(h, t) => (if h.status == "budget_checked" then 1 else 0) + lc_count_budget(t)

fn lc_kernel_check_one(p) = if p.kind == "wcet" then (if p.status == "budget_checked" and count(p.term) > 12 and count(p.counterexample) == 0 then 1 else 0) else (if p.status == "proven" and count(p.term) > 10 and count(p.counterexample) == 0 then 1 else 0)

fn lc_kernel_check_all(ps) = match ps
    Nil        => 1
    Cons(h, t) => if lc_kernel_check_one(h) == 1 then lc_kernel_check_all(t) else 0

fn lc_terms_json(ps) = match ps
    Nil        => ""
    Cons(h, t) => let item = "{\"name\":\"" + cs_jesc(h.name) + "\",\"kind\":\"" + cs_jesc(h.kind) + "\",\"term\":\"" + cs_jesc(h.term) + "\",\"checked\":" + (if lc_kernel_check_one(h) == 1 then "true" else "false") + "}" in if cs_isnil(t) == 1 then item else item + "," + lc_terms_json(t)

fn lc_extract_sha_hdr(s) = if cs_startswith(s, "@sha256 ") == 1 then let le = cs_lineend(s, 0, count(s)) in {has: 1, sha: "sha256:" + cs_chomp(slice(s, 8, le)), rest: slice(s, le, count(s))} else {has: 0, sha: "", rest: s}

fn lcert_certificate_hash(src_hash, proofs) = lc_sha256(src_hash + "|" + lc_terms_json(proofs) + "|" + cs_proofs_json(proofs))

fn lcert_certify_result(src, src_hash, r) = let total = cs_len(r.proofs) in let proven = lc_count_proven(r.proofs) in let budgeted = lc_count_budget(r.proofs) in let k_ok = if r.ok == 1 and total > 0 and proven + budgeted == total and lc_kernel_check_all(r.proofs) == 1 then 1 else 0 in let terms_str = lc_terms_json(r.proofs) in let obls_str = cs_proofs_json(r.proofs) in let cert_hash = lcert_certificate_hash(src_hash, r.proofs) in let badge = if k_ok == 1 then "Lume Verified ✓" else "unverified" in "{\"ok\":" + (if k_ok == 1 then "true" else "false") + ",\"badge\":\"" + cs_jesc(badge) + "\",\"kernel_verified\":" + (if k_ok == 1 then "true" else "false") + ",\"kernel_id\":\"lume-minimal-kernel-v1\",\"bootstrap_attestation\":\"stage2==stage3\",\"zero_c\":true,\"source_hash\":\"" + cs_jesc(src_hash) + "\",\"certificate_hash\":\"" + cs_jesc(cert_hash) + "\",\"proven_count\":" + str(proven) + ",\"budget_checked_count\":" + str(budgeted) + ",\"total_obligations\":" + str(total) + ",\"proof_terms\":[" + terms_str + "],\"obligations\":[" + obls_str + "]}"

fn lcert_certify(raw_src) = let sh = lc_extract_sha_hdr(raw_src) in let src = sh.rest in let src_hash = if sh.has == 1 and count(sh.sha) == 71 then sh.sha else lc_sha256(src) in lcert_certify_result(src, src_hash, caas_compile(src))

fn lc_find_ch(s, i, n, ch) = if i >= n then n else if at(s, i) == ch then i else lc_find_ch(s, i + 1, n, ch)

fn lc_last_word_i(s, i, start) = if i <= start then slice(s, start, count(s)) else if at(s, i - 1) == " " or at(s, i - 1) == "*" then slice(s, i, count(s)) else lc_last_word_i(s, i - 1, start)

fn lc_trim_r(s) = let n = count(s) in if n == 0 then "" else if at(s, n - 1) == " " or at(s, n - 1) == "\t" or at(s, n - 1) == ";" then lc_trim_r(slice(s, 0, n - 1)) else s

fn lc_trim_l(s, i, n) = if i >= n then "" else if at(s, i) == " " or at(s, i) == "\t" then lc_trim_l(s, i + 1, n) else slice(s, i, n)

fn lc_trim(s) = lc_trim_r(lc_trim_l(cs_chomp(s), 0, count(cs_chomp(s))))

fn lc_trim_ws_r(s) = let n = count(s) in if n == 0 then "" else if at(s, n - 1) == " " or at(s, n - 1) == "\t" then lc_trim_ws_r(slice(s, 0, n - 1)) else s

fn lc_trim_ws(s) = lc_trim_ws_r(lc_trim_l(cs_chomp(s), 0, count(cs_chomp(s))))

fn lc_compact(s, i, n) = if i >= n then "" else let c = at(s, i) in if c == " " or c == "\t" then lc_compact(s, i + 1, n) else c + lc_compact(s, i + 1, n)

fn lc_ident_start(c) = let o = sha_ord(c) in if o == 95 or o >= 65 and o <= 90 or o >= 97 and o <= 122 then 1 else 0

fn lc_ident_tail(s, i, n) = if i >= n then 1 else let o = sha_ord(at(s, i)) in if lc_ident_start(at(s, i)) == 1 or o >= 48 and o <= 57 then lc_ident_tail(s, i + 1, n) else 0

fn lc_ident_ok(s) = if count(s) == 0 then 0 else if lc_ident_start(at(s, 0)) == 0 then 0 else lc_ident_tail(s, 1, count(s))

fn lc_lume_keyword(s) = s == "fn" or s == "let" or s == "var" or s == "in" or s == "is" or s == "from" or s == "if" or s == "then" or s == "elif" or s == "else" or s == "match" or s == "type" or s == "enum" or s == "record" or s == "trait" or s == "impl" or s == "law" or s == "effect" or s == "with" or s == "handler" or s == "scope" or s == "spawn" or s == "shard" or s == "loop" or s == "fail" or s == "own" or s == "mut" or s == "defer" or s == "errdefer" or s == "comptime" or s == "quote" or s == "unquote" or s == "splice" or s == "pub" or s == "extern" or s == "async" or s == "total" or s == "llm" or s == "use" or s == "where" or s == "requires" or s == "ensures" or s == "invariant" or s == "and" or s == "or" or s == "not"

fn lc_param_type_word(w) = w == "" or w == "void" or w == "int64_t" or w == "char" or w == "const"

fn lc_param_error(reason) = {ok: 0, name: "", ty: "", reason: reason}

fn lc_param_info(raw, idx) = let word = lc_last_word_i(raw, count(raw), 0) in let unnamed = lc_param_type_word(word) in let raw_nm = if unnamed == 1 then "a" + str(idx) else word in let raw_ty = if unnamed == 1 then raw else lc_trim(slice(raw, 0, count(raw) - count(word))) in let ty = lc_compact(raw_ty, 0, count(raw_ty)) in if cs_has_substr(raw, "(") == 1 or cs_has_substr(raw, ")") == 1 then lc_param_error("callback parameters require explicit lifetime and ownership contracts") else if cs_has_substr(raw, "[") == 1 or cs_has_substr(raw, "]") == 1 then lc_param_error("array parameters require explicit buffer length and ownership contracts") else if lc_ident_ok(raw_nm) == 0 then lc_param_error("parameter name is not a supported C identifier") else if ty == "int64_t" or ty == "constchar*" or ty == "charconst*" then {ok: 1, name: raw_nm, ty: ty, reason: ""} else if ty == "char*" then lc_param_error("mutable char pointers require an owned mutable-buffer adapter, which is not implemented") else if cs_has_substr(ty, "*") == 1 then lc_param_error("pointer parameters require explicit ownership and lifetime contracts") else lc_param_error("only int64_t scalars and borrowed const char* parameters have defined Lume C-ABI mappings")

fn lc_params_empty() = {ok: 1, ps: Nil, reason: ""}

fn lc_split_csv(s, i, n, idx) = if i >= n then lc_params_empty() else let cpos = lc_find_ch(s, i, n, ",") in let raw = lc_trim(slice(s, i, cpos)) in let p = lc_param_info(raw, idx) in let rest = if cpos >= n then lc_params_empty() else lc_split_csv(s, cpos + 1, n, idx + 1) in if cpos < n and cpos + 1 >= n then {ok: 0, ps: Nil, reason: "trailing comma in parameter list"} else if p.ok == 0 then {ok: 0, ps: Nil, reason: p.reason} else if rest.ok == 0 then {ok: 0, ps: Nil, reason: rest.reason} else {ok: 1, ps: Cons(p, rest.ps), reason: ""}

fn lc_param_name_repeated(nm, ps) = match ps
    Nil        => 0
    Cons(h, t) => if h.name == nm then 1 else lc_param_name_repeated(nm, t)

fn lc_param_names_unique(ps) = match ps
    Nil        => 1
    Cons(h, t) => if lc_param_name_repeated(h.name, t) == 1 then 0 else lc_param_names_unique(t)

fn lc_is_cstr(ty) = ty == "constchar*" or ty == "charconst*"

fn lc_buffer_pair(p, q) = if lc_is_cstr(p.ty) == 1 and q.ty == "int64_t" and q.name == p.name + "_len" then 1 else 0

fn lc_scalar_meta(p) = "{\"name\":\"" + cs_jesc(p.name) + "\",\"c_type\":\"int64_t\",\"lume_type\":\"int\",\"ownership\":\"value\"}"

fn lc_cstr_meta(p) = "{\"name\":\"" + cs_jesc(p.name) + "\",\"c_type\":\"const char *\",\"lume_type\":\"str\",\"ownership\":\"borrowed_read_only\",\"lifetime\":\"call\",\"extent\":\"nul_terminated\"}"

fn lc_buffer_meta(p, q) = "{\"name\":\"" + cs_jesc(p.name) + "\",\"c_type\":\"const char *\",\"lume_type\":\"str\",\"ownership\":\"borrowed_read_only\",\"lifetime\":\"call\",\"extent\":\"count(c_" + cs_jesc(p.name) + ")\",\"length_parameter\":\"" + cs_jesc(q.name) + "\"}"

fn lc_lower_single(p, rest) = let nm = "c_" + p.name in if p.ty == "int64_t" then {ep: Cons(nm + ": int", rest.ep), wp: Cons(nm + ": int", rest.wp), ea: Cons(nm, rest.ea), wa: Cons(nm, rest.wa), meta: Cons(lc_scalar_meta(p), rest.meta)} else {ep: Cons(nm + ": str", rest.ep), wp: Cons(nm + ": str", rest.wp), ea: Cons(nm, rest.ea), wa: Cons(nm, rest.wa), meta: Cons(lc_cstr_meta(p), rest.meta)}

fn lc_lower_buffer(p, q, rest) = let nm = "c_" + p.name in let lnm = "c_" + q.name in {ep: Cons(nm + ": str, " + lnm + ": int", rest.ep), wp: Cons(nm + ": str", rest.wp), ea: Cons(nm + ", count(" + nm + ")", rest.ea), wa: Cons(nm, rest.wa), meta: Cons(lc_buffer_meta(p, q), rest.meta)}

fn lc_lower_params1(p, pt) = match pt
    Nil        => lc_lower_single(p, lc_lower_params(Nil))
    Cons(q, qt) => if lc_buffer_pair(p, q) == 1 then lc_lower_buffer(p, q, lc_lower_params(qt)) else lc_lower_single(p, lc_lower_params(pt))

fn lc_lower_params(ps) = match ps
    Nil         => {ep: Nil, wp: Nil, ea: Nil, wa: Nil, meta: Nil}
    Cons(p, pt) => lc_lower_params1(p, pt)

fn lc_bind_ignored() = {kind: 0, name: "", ext: "", wrap: "", meta: "", diags: Nil}

fn lc_bind_rejected(line, reason) = {kind: 2, name: "", ext: "", wrap: "", meta: "", diags: Cons(cs_mkdiag("I0003", "interop", "binding error: unsupported C declaration '" + line + "': " + reason, "use int64_t returns, int64_t scalars, borrowed const char* strings, or const char* name plus int64_t name_len read-only buffer pairs; mutable buffers, callbacks, retained pointers, variadics, and other ABI types require a separate reviewed adapter"), Nil)}

fn lc_bind_line(line) = let l = lc_trim_ws(line) in let p1 = lc_find_ch(l, 0, count(l), "(") in let p2 = lc_find_ch(l, p1 + 1, count(l), ")") in if l == "" or cs_startswith(l, "//") == 1 or cs_startswith(l, "/*") == 1 or cs_startswith(l, "*") == 1 then lc_bind_ignored() else if cs_startswith(l, "#") == 1 then (if cs_startswith(l, "#include") == 1 or cs_startswith(l, "#pragma once") == 1 then lc_bind_ignored() else lc_bind_rejected(l, "conditional or macro preprocessing is outside the strict prototype fragment")) else if p1 >= count(l) then lc_bind_rejected(l, "only single-line C function prototypes are supported") else if p2 >= count(l) then lc_bind_rejected(l, "multi-line or unterminated prototypes are not supported") else if cs_has_substr(slice(l, p1 + 1, count(l)), "(") == 1 then lc_bind_rejected(l, "function pointers and callbacks require explicit lifetime and ownership contracts") else if cs_has_substr(l, "{") == 1 or cs_has_substr(l, "}") == 1 or lc_trim_ws(slice(l, p2 + 1, count(l))) != ";" then lc_bind_rejected(l, "only a complete single-line C function prototype followed by one semicolon is supported") else let prefix = lc_trim(slice(l, 0, p1)) in let fnm = lc_last_word_i(prefix, count(prefix), 0) in let raw_ret = lc_trim(slice(prefix, 0, count(prefix) - count(fnm))) in let ret = lc_compact(raw_ret, 0, count(raw_ret)) in let raw_args = lc_trim(slice(l, p1 + 1, p2)) in let sp = (if count(raw_args) == 0 or raw_args == "void" then lc_params_empty() else lc_split_csv(raw_args, 0, count(raw_args), 0)) in let lp = lc_lower_params(sp.ps) in if lc_ident_ok(fnm) == 0 or lc_lume_keyword(fnm) == 1 then lc_bind_rejected(l, "function name is not a supported Lume/C identifier") else if cs_has_substr(raw_ret, "*") == 1 or cs_has_substr(raw_ret, "[") == 1 or cs_has_substr(raw_ret, "]") == 1 then lc_bind_rejected(l, "foreign pointer and array returns require explicit ownership contracts") else if ret != "int64_t" and ret != "externint64_t" then lc_bind_rejected(l, "return type must be int64_t; void and foreign-pointer returns require explicit ownership contracts") else if count(raw_args) == 0 then lc_bind_rejected(l, "empty C parameter lists leave arity unspecified; use (void) for a zero-argument prototype") else if cs_has_substr(raw_args, "...") == 1 then lc_bind_rejected(l, "variadic functions are outside the verifiable C ABI fragment") else if sp.ok == 0 then lc_bind_rejected(l, sp.reason) else if lc_param_names_unique(sp.ps) == 0 then lc_bind_rejected(l, "duplicate parameter names are not supported") else let eparams = cs_joinsep(lp.ep, ", ") in let wparams = cs_joinsep(lp.wp, ", ") in let eargs = cs_joinsep(lp.ea, ", ") in let ext_decl = "extern \"c\" fn " + fnm + "(" + eparams + ") -> int" in let foreign_wrap = "pub fn foreign_" + fnm + "(" + wparams + ") -> unverified[int] / {" + "ffi} = " + fnm + "(" + eargs + ")" in let meta = "{\"symbol\":\"" + cs_jesc(fnm) + "\",\"adapter\":\"foreign_" + cs_jesc(fnm) + "\",\"parameters\":[" + cs_joinsep(lp.meta, ",") + "],\"return\":{\"c_type\":\"int64_t\",\"lume_type\":\"unverified[int]\",\"provenance\":\"foreign\"},\"effects\":[\"ffi\"]}" in {kind: 1, name: fnm, ext: ext_decl, wrap: foreign_wrap, meta: meta, diags: Nil}

fn lc_bind_lines(ls) = match ls
    Nil        => {exts: Nil, wraps: Nil, names: Nil, metas: Nil, diags: Nil}
    Cons(h, t) => let b = lc_bind_line(h) in let rest = lc_bind_lines(t) in if b.kind == 1 then {exts: Cons(b.ext, rest.exts), wraps: Cons(b.wrap, rest.wraps), names: Cons(b.name, rest.names), metas: Cons(b.meta, rest.metas), diags: cs_app(b.diags, rest.diags)} else {exts: rest.exts, wraps: rest.wraps, names: rest.names, metas: rest.metas, diags: cs_app(b.diags, rest.diags)}

fn lc_split_lines(s, i, n) = if i >= n then Nil else let le = cs_lineend(s, i, n) in Cons(slice(s, i, le), lc_split_lines(s, le, n))

fn lc_name_repeated(nm, names) = match names
    Nil        => 0
    Cons(h, t) => if h == nm then 1 else lc_name_repeated(nm, t)

fn lc_first_duplicate(names) = match names
    Nil        => ""
    Cons(h, t) => if lc_name_repeated(h, t) == 1 then h else lc_first_duplicate(t)

fn lc_bind_eval(hdr_text) = let r = lc_bind_lines(lc_split_lines(hdr_text, 0, count(hdr_text))) in let dup = lc_first_duplicate(r.names) in let dup_diags = if dup == "" then Nil else Cons(cs_mkdiag("I0003", "interop", "binding error: duplicate C function declaration '" + dup + "'", "declare each foreign symbol once"), Nil) in let empty_diags = if cs_isnil(r.exts) == 1 and cs_isnil(r.diags) == 1 then Cons(cs_mkdiag("I0003", "interop", "binding error: header contains no supported C function declarations", "declare int64_t functions with int64_t scalars, borrowed const char* strings, or const char* name plus int64_t name_len read-only buffer pairs"), Nil) else Nil in let diags = cs_app(r.diags, cs_app(dup_diags, empty_diags)) in let ok = if cs_isnil(r.exts) == 0 and cs_isnil(diags) == 1 then 1 else 0 in let gen = if ok == 1 then cs_joinsep(cs_app(r.exts, r.wraps), "\n") else "" in {ok: ok, gen: gen, exts: r.exts, wraps: r.wraps, metas: r.metas, diags: diags}

fn lcert_bind_source(hdr_text) = lc_bind_eval(hdr_text).gen

fn lcert_bind(hdr_text) = let b = lc_bind_eval(hdr_text) in "{\"ok\":" + (if b.ok == 1 then "true" else "false") + ",\"mode\":\"bind\",\"adapter_contract\":\"c_abi_foreign_v2\",\"bridge\":\"c_abi\",\"source_hash\":\"" + lc_sha256(hdr_text) + "\",\"ownership\":\"borrowed_const_cstr_and_sized_read_only_buffers\",\"provenance_guard\":\"A0003\",\"return_provenance\":\"unverified\",\"effect\":\"ffi\",\"capabilities\":[\"ffi\"],\"diagnostics\":[" + cs_diags_json(b.diags) + "],\"adapters\":[" + cs_joinsep(b.metas, ",") + "],\"extern_decls\":[" + cs_strlist_json(b.exts) + "],\"foreign_wrappers\":[" + cs_strlist_json(b.wraps) + "],\"generated_lume\":\"" + cs_jesc(b.gen) + "\"}"

## --- Verified component registry: derive discovery identity from the parsed public interface ---
fn cs_reg_cap_insert(x, xs) = match xs
    Nil        => Cons(x, Nil)
    Cons(h, t) => if x < h then Cons(x, Cons(h, t)) else Cons(h, cs_reg_cap_insert(x, t))

fn cs_reg_cap_add(x, xs) = if x == "" or cs_omem(x, xs) == 1 then xs else cs_reg_cap_insert(x, xs)

fn cs_reg_cap_list(effs, acc) = match effs
    Nil        => acc
    Cons(h, t) => cs_reg_cap_list(t, cs_reg_cap_add(h, acc))

fn cs_reg_caps_prog(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_reg_caps_stmt(h, cs_reg_caps_prog(t))

fn cs_reg_caps_stmt(st, rest) = match st
    KCapGrant(effs)   => cs_reg_cap_list(effs, rest)
    KEffSig(nm, effs) => cs_reg_cap_list(effs, rest)
    _                 => rest

fn cs_reg_params(ps) = match ps
    Nil        => ""
    Cons(h, t) => h.k + ":" + h.v + (if cs_isnil(t) == 1 then "" else "," + cs_reg_params(t))

fn cs_reg_reqs(vs) = match vs
    Nil       => ""
    Cons(v,_) => cs_joinsep(cs_exprs_surface_list(v.reqs), " && ")

fn cs_reg_enss(vs) = match vs
    Nil       => ""
    Cons(v,_) => cs_joinsep(cs_exprs_surface_list(v.enss), " && ")

fn cs_reg_public_item(osg, sigs, vsigs, ksigs) = let msig = cs_siglookup(osg.nm, sigs) in let reqs = cs_reg_reqs(cs_vsiglookup(osg.nm, vsigs)) in let enss = cs_reg_enss(cs_vsiglookup(osg.nm, vsigs)) in let params = cs_reg_params(cs_fn_lenv(msig)) in let rty = cs_fn_rty(msig, Cons(osg, Nil)) in let effs = cs_fn_eff_str(osg.nm, ksigs) in let origin = if osg.fromp == "" then "" else " from " + osg.fromp in let req_s = if reqs == "" then "" else " requires " + reqs in let ens_s = if enss == "" then "" else " ensures " + enss in {canonical: "pub fn " + osg.nm + "(" + params + ") -> " + rty + origin + " / {" + effs + "}" + req_s + ens_s, contracted: if reqs == "" and enss == "" then 0 else 1}

fn cs_reg_public_items(osigs, sigs, vsigs, ksigs) = match osigs
    Nil        => {canonical: "", count: 0}
    Cons(h, t) => let rest = cs_reg_public_items(t, sigs, vsigs, ksigs) in if h.pubf == 0 then rest else let item = cs_reg_public_item(h, sigs, vsigs, ksigs) in {canonical: item.canonical + (if rest.canonical == "" then "" else "\n" + rest.canonical), count: item.contracted + rest.count}

fn caas_registry_interface_json(src) = let ast = cs_parse(src) in let sigs = (cs_tcollect(ast)).sigs in let osigs = cs_ocollects(ast) in let vsigs = cs_vcollect_vsigs(ast) in let ksigs = cs_kcollect_effsigs(ast) in let items = cs_reg_public_items(osigs, sigs, vsigs, ksigs) in let caps = cs_reg_caps_prog(ast) in let signature = lc_sha256("lume-registry-contracts/0.1\n" + items.canonical) in "{\"ok\":true,\"mode\":\"registry-interface\",\"capabilities\":\"" + cs_jesc(cs_joinsep(caps, ",")) + "\",\"contract_signature\":\"" + cs_jesc(signature) + "\",\"public_contracts\":" + str(items.count) + "}"

## --- Oracle Queries (`docs/19-intent-as-source.md` §2, #195): `witness`, `repair`, `impact` ---
fn cs_witness_items(ps) = match ps
    Nil        => Nil
    Cons(p, r) => if p.status == "refuted" or count(p.counterexample) > 0 then Cons("{\"name\":\"" + cs_jesc(p.name) + "\",\"kind\":\"" + cs_jesc(p.kind) + "\",\"obligation\":\"" + cs_jesc(p.obligation) + "\",\"witness\":\"" + cs_jesc(p.counterexample) + "\"}", cs_witness_items(r)) else cs_witness_items(r)

fn caas_witness_json(src) = let r = caas_compile(src) in let ws = cs_witness_items(r.proofs) in let cnt = cs_len(ws) in "{\"ok\":true,\"mode\":\"witness\",\"has_witness\":" + (if cnt > 0 then "true" else "false") + ",\"witness_count\":" + str(cnt) + ",\"witnesses\":[" + cs_joinsep(ws, ",") + "]}"

fn cs_is_refuted_fn(fnm, ps) = match ps
    Nil        => 0
    Cons(p, r) => if p.name == fnm and p.status == "refuted" then 1 else cs_is_refuted_fn(fnm, r)

fn cs_diag_repairs(ds) = match ds
    Nil        => Nil
    Cons(d, r) => if count(d.fixit) > 0 and d.code != "V0001" then Cons("{\"target\":\"" + cs_jesc(d.phase) + "\",\"code\":\"" + cs_jesc(d.code) + "\",\"kind\":\"diagnostic_fixit\",\"patch\":\"" + cs_jesc(d.fixit) + "\",\"proven\":" + (if d.code == "A0001" then "true" else "false") + "}", cs_diag_repairs(r)) else cs_diag_repairs(r)

fn cs_contract_repairs_stmt(st, rest, rctx) = match st
    Fn(nm, ps, body) => let r_rest = cs_contract_repairs_stmts(rest, rctx) in if cs_is_refuted_fn(nm, rctx.proofs) == 0 then r_rest else (let msig = cs_siglookup(nm, rctx.sigs) in let mosig = cs_osiglookup(nm, rctx.osigs) in let ety = cs_fn_rty(msig, mosig) in let lenv = cs_fn_lenv(msig) in let hctx = {fnm: nm, pubf: 1, ps: ps, body: Var("_"), sigs: rctx.sigs, vsigs: rctx.vsigs, laws: rctx.laws, ft: rctx.ft} in let raw_es = cs_synth_cand_es(ety, lenv, rctx.sigs, nm, rctx.ft) in let prv_es = cs_filter_proven_es(raw_es, "_", hctx) in let prv_strs = cs_exprs_surface_list(prv_es) in let best = cs_hd_str(prv_strs, "") in if best != "" then Cons("{\"target\":\"" + cs_jesc(nm) + "\",\"code\":\"V0001\",\"kind\":\"contract_body_repair\",\"patch\":\"replace body of '" + cs_jesc(nm) + "' with '" + cs_jesc(best) + "'\",\"replacement\":\"" + cs_jesc(best) + "\",\"proven\":true}", r_rest) else r_rest)
    _                => cs_contract_repairs_stmts(rest, rctx)

fn cs_contract_repairs_stmts(prog, rctx) = match prog
    Nil        => Nil
    Cons(h, t) => cs_contract_repairs_stmt(h, t, rctx)

fn cs_collect_repairs(src, r) = let ast0 = r.ast in let tt = cs_tcollect(ast0) in let osigs = cs_ocollects(ast0) in let vsigs = cs_vcollect_vsigs(ast0) in let laws = cs_vcollect_laws(ast0) in let rctx = {sigs: tt.sigs, osigs: osigs, vsigs: vsigs, laws: laws, ft: tt.ft, proofs: r.proofs} in cs_app(cs_diag_repairs(r.diagnostics), cs_contract_repairs_stmts(ast0, rctx))

fn caas_repair_json(src) = let r = caas_compile(src) in let reps = cs_collect_repairs(src, r) in let cnt = cs_len(reps) in "{\"ok\":true,\"mode\":\"repair\",\"repair_count\":" + str(cnt) + ",\"repairs\":[" + cs_joinsep(reps, ",") + "]}"

fn cs_callers_of_stmt(st, rest, sym) = match st
    Fn(fnm, ps, body) => let r_rest = cs_callers_of_stmts(rest, sym) in if fnm != sym and cs_mentions_call(sym, body) == 1 then Cons(fnm, r_rest) else r_rest
    _                 => cs_callers_of_stmts(rest, sym)

fn cs_callers_of_stmts(prog, sym) = match prog
    Nil        => Nil
    Cons(h, t) => cs_callers_of_stmt(h, t, sym)

fn cs_law_names(laws) = match laws
    Nil        => Nil
    Cons(l, r) => Cons(l.nm, cs_law_names(r))

fn cs_affected_proofs_for(sym, callers, vsigs, laws) = let own_pf = if cs_isnil(cs_vsiglookup(sym, vsigs)) == 0 then Cons(sym, Nil) else Nil in let caller_pfs = cs_filter_has_vsig(callers, vsigs) in let law_pfs = cs_law_names(cs_laws_mention_fn(sym, laws)) in cs_app(own_pf, cs_app(caller_pfs, law_pfs))

fn cs_filter_has_vsig(fnms, vsigs) = match fnms
    Nil          => Nil
    Cons(fnm, r) => if cs_isnil(cs_vsiglookup(fnm, vsigs)) == 0 then Cons(fnm, cs_filter_has_vsig(r, vsigs)) else cs_filter_has_vsig(r, vsigs)

fn cs_impact_items(syms, ast0, vsigs, laws) = match syms
    Nil        => Nil
    Cons(s, r) => let callers = cs_callers_of_stmts(ast0, s.name) in let pfs = cs_affected_proofs_for(s.name, callers, vsigs, laws) in Cons("{\"symbol\":\"" + cs_jesc(s.name) + "\",\"kind\":\"" + cs_jesc(s.kind) + "\",\"signature\":\"" + cs_jesc(s.sig) + "\",\"direct_callers\":[" + cs_strlist_json(callers) + "],\"affected_proofs\":[" + cs_strlist_json(pfs) + "]}", cs_impact_items(r, ast0, vsigs, laws))

fn caas_impact_json(src) = let ast0 = cs_parse(src) in let syms = cs_symbols(ast0) in let vsigs = cs_vcollect_vsigs(ast0) in let laws = cs_vcollect_laws(ast0) in let items = cs_impact_items(syms, ast0, vsigs, laws) in "{\"ok\":true,\"mode\":\"impact\",\"impacts\":[" + cs_joinsep(items, ",") + "]}"

fn lcert_mcp(raw_src) = let sh = lc_extract_sha_hdr(raw_src) in let src = sh.rest in let r = caas_compile(src) in let cert = lcert_certify(raw_src) in let ws = cs_witness_items(r.proofs) in let reps = cs_collect_repairs(src, r) in let imps = cs_impact_items(r.symbols, r.ast, cs_vcollect_vsigs(r.ast), cs_vcollect_laws(r.ast)) in let defs = cs_def_hash_stmts(r.ast, (cs_tcollect(r.ast)).sigs, cs_vcollect_vsigs(r.ast), r.proofs) in "{\"jsonrpc\":\"2.0\",\"protocol\":\"mcp/1.0\",\"server\":\"lume-oracle-mcp\",\"tools\":[\"lume_check\",\"lume_prove\",\"lume_fill\",\"lume_witness\",\"lume_repair\",\"lume_impact\",\"lume_hashes\",\"lume_grammar\",\"lume_project\",\"lume_patch\",\"lume_replay\",\"lume_lineage\",\"lume_proof_diff\",\"lume_compose\",\"lume_check_rot\",\"lume_share\",\"lume_intent\",\"lume_lsp\",\"lume_dap\",\"lume_repl\",\"lume_bind\",\"lume_certify\"],\"result\":{\"ok\":" + (if r.ok == 1 then "true" else "false") + ",\"diagnostics\":[" + cs_diags_json(r.diagnostics) + "],\"holes\":[" + cs_holes_json(r.holes) + "],\"proofs\":[" + cs_proofs_json(r.proofs) + "],\"witnesses\":[" + cs_joinsep(ws, ",") + "],\"repairs\":[" + cs_joinsep(reps, ",") + "],\"impacts\":[" + cs_joinsep(imps, ",") + "],\"definitions\":[" + cs_joinsep(defs, ",") + "],\"certificate\":" + cert + "}}"

## --- Stage 1/2 Tooling & AI-Author Substrate (#210, #211, #209) ---
fn cs_def_sig_sexpr(nm, sigs) = match cs_siglookup(nm, sigs)
    Nil        => "()"
    Cons(sg, r) => "(" + cs_joinsep(sg.pn, " ") + ")->" + cs_tystr(sg.rt)

fn cs_def_vsig_sexpr(nm, vsigs) = match cs_vsiglookup(nm, vsigs)
    Nil         => ""
    Cons(vs, r) => "|req:" + cs_exprs_sexpr(vs.reqs) + "|ens:" + cs_exprs_sexpr(vs.enss)

fn cs_def_proof_status(nm, proofs) = match proofs
    Nil        => "unchecked"
    Cons(p, r) => if p.name == nm then p.status else cs_def_proof_status(nm, r)

fn cs_def_hash_stmt(st, rest, sigs, vsigs, proofs) = match st
    TypeS(nm, k, items) => let sig_s = (if k == "enum" then cs_variants_str(items) else "{" + cs_fields_str(items) + "}") in let canon = "(type " + nm + " " + k + " " + sig_s + ")" in let ah = lc_sha256(canon) in let st_p = cs_def_proof_status(nm, proofs) in Cons("{\"name\":\"" + cs_jesc(nm) + "\",\"kind\":\"" + cs_jesc(k) + "\",\"ast_sexpr\":\"" + cs_jesc(canon) + "\",\"ast_hash\":\"" + cs_jesc(ah) + "\",\"proof_status\":\"" + cs_jesc(st_p) + "\",\"cache_key\":\"" + cs_jesc(ah + ":" + st_p) + "\"}", cs_def_hash_stmts(rest, sigs, vsigs, proofs))
    Fn(nm, ps, body)    => let canon = "(fn " + nm + " " + cs_def_sig_sexpr(nm, sigs) + cs_def_vsig_sexpr(nm, vsigs) + " " + cs_expr_sexpr(body) + ")" in let ah = lc_sha256(canon) in let st_p = cs_def_proof_status(nm, proofs) in Cons("{\"name\":\"" + cs_jesc(nm) + "\",\"kind\":\"fn\",\"ast_sexpr\":\"" + cs_jesc(canon) + "\",\"ast_hash\":\"" + cs_jesc(ah) + "\",\"proof_status\":\"" + cs_jesc(st_p) + "\",\"cache_key\":\"" + cs_jesc(ah + ":" + st_p) + "\"}", cs_def_hash_stmts(rest, sigs, vsigs, proofs))
    VLawDecl(nm, ps, b) => let canon = "(law " + nm + " (" + cs_joinsep(ps, " ") + ") " + cs_expr_sexpr(b) + ")" in let ah = lc_sha256(canon) in let st_p = cs_def_proof_status(nm, proofs) in Cons("{\"name\":\"" + cs_jesc(nm) + "\",\"kind\":\"law\",\"ast_sexpr\":\"" + cs_jesc(canon) + "\",\"ast_hash\":\"" + cs_jesc(ah) + "\",\"proof_status\":\"" + cs_jesc(st_p) + "\",\"cache_key\":\"" + cs_jesc(ah + ":" + st_p) + "\"}", cs_def_hash_stmts(rest, sigs, vsigs, proofs))
    _                   => cs_def_hash_stmts(rest, sigs, vsigs, proofs)

fn cs_def_hash_stmts(prog, sigs, vsigs, proofs) = match prog
    Nil        => Nil
    Cons(h, t) => cs_def_hash_stmt(h, t, sigs, vsigs, proofs)

fn caas_hashes_json(src) = let r = caas_compile(src) in let tt = cs_tcollect(r.ast) in let vsigs = cs_vcollect_vsigs(r.ast) in let defs = cs_def_hash_stmts(r.ast, tt.sigs, vsigs, r.proofs) in let cnt = cs_len(defs) in "{\"ok\":" + (if r.ok == 1 then "true" else "false") + ",\"mode\":\"hashes\",\"definition_count\":" + str(cnt) + ",\"definitions\":[" + cs_joinsep(defs, ",") + "]}"

fn caas_grammar_json(src) = let r = caas_compile(src) in "{\"ok\":true,\"mode\":\"grammar\",\"format\":\"lume-constrained-grammar-v1\",\"start_rule\":\"Program\",\"rules\":{\"Program\":\"Decl+\",\"Decl\":\"FnDecl | TypeDecl | LawDecl | EffectDecl | RuleDecl | PrintStmt\",\"FnDecl\":\"Attr* ('pub')? ('total' | 'llm' | 'kernel' | 'extern')? 'fn' Ident '(' ParamList? ')' ('->' Type)? ('/' EffectRow)? Contract* '=' Expr\",\"TypeDecl\":\"('resource' | 'model')? 'type' Ident TypeParams? '=' ('record' FieldList ('invariant' Expr)? | 'enum' VariantList)\",\"LawDecl\":\"('pub')? 'law' Ident '(' ParamList? ')' '=' Expr\",\"Contract\":\"('requires' | 'ensures') Expr\",\"Expr\":\"LetExpr | VarExpr | IfExpr | MatchExpr | WithExpr | ScopeExpr | SpawnExpr | BinExpr | CallExpr | FieldExpr | Primary\",\"LetExpr\":\"'let' Ident '=' Expr 'in' Expr\",\"IfExpr\":\"'if' Expr 'then' Expr 'else' Expr\",\"MatchExpr\":\"'match' Expr Arm+\",\"Type\":\"'int' | 'str' | 'bool' | 'decimal' '(' Int ',' Int ')' | 'table' '[' Type ']' | 'money' '[' Ident ']' | 'tensor' '[' Type (',' Dim)+ ']' | '[' Type ']' | Ident ('[' Type ']')?\"},\"ast_constructors\":[\"Fn\",\"TypeS\",\"VLawDecl\",\"VContractSig\",\"KEffectDecl\",\"Print\",\"ExprS\",\"Num\",\"Str\",\"Var\",\"Bin\",\"If\",\"LetIn\",\"VarIn\",\"OwnE\",\"MutE\",\"DeferE\",\"ErrDeferE\",\"WithAllocE\",\"WithHandlerE\",\"ScopeE\",\"SpawnE\",\"Call\",\"Rec\",\"RecT\",\"Field\",\"Match\",\"CT\",\"Quote\",\"Splice\"],\"active_symbols\":[" + cs_syms_json(r.symbols) + "],\"holes\":[" + cs_holes_json(r.holes) + "]}"

fn cs_proj_stmt(st, rest) = match st
    TypeS(nm, k, items) => let s = (if k == "enum" then "type " + nm + " = enum " + cs_variants_str(items) else "type " + nm + " = record " + cs_fields_str(items)) in Cons(s, cs_proj_stmts(rest))
    Fn(nm, ps, body)    => if cs_startswith(nm, "law_") == 1 then cs_proj_stmts(rest) else Cons("fn " + nm + "(" + cs_joinsep(ps, ", ") + ") = " + cs_expr_surface(body), cs_proj_stmts(rest))
    VLawDecl(nm, ps, b) => Cons("law " + nm + "(" + cs_joinsep(ps, ", ") + ") = " + cs_expr_surface(b), cs_proj_stmts(rest))
    Print(v)            => Cons("print " + cs_expr_surface(v), cs_proj_stmts(rest))
    _                   => cs_proj_stmts(rest)

fn cs_proj_stmts(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_proj_stmt(h, t)

fn caas_project_json(src) = let r = caas_compile(src) in let tt = cs_tcollect(r.ast) in let vsigs = cs_vcollect_vsigs(r.ast) in let defs = cs_def_hash_stmts(r.ast, tt.sigs, vsigs, r.proofs) in let surf = cs_joinsep(cs_proj_stmts(r.ast), "\n") in let r2 = caas_compile(surf) in let rtrip = (if r.ast_sexpr == r2.ast_sexpr then 1 else 0) in "{\"ok\":" + (if r.ok == 1 then "true" else "false") + ",\"mode\":\"project\",\"canonical_ast\":\"" + cs_jesc(r.ast_sexpr) + "\",\"expanded_ast\":\"" + cs_jesc(r.expanded_sexpr) + "\",\"surface_projection\":\"" + cs_jesc(surf) + "\",\"roundtrip_ast_equal\":" + (if rtrip == 1 then "true" else "false") + ",\"definitions\":[" + cs_joinsep(defs, ",") + "]}"

fn cs_lsp_diag_item(d, idx) = "{\"range\":{\"start\":{\"line\":" + str(idx) + ",\"character\":0},\"end\":{\"line\":" + str(idx) + ",\"character\":80}},\"severity\":" + (if d.severity == "warning" then "2" else "1") + ",\"code\":\"" + cs_jesc(d.code) + "\",\"source\":\"lume-lsp\",\"message\":\"" + cs_jesc(d.message) + "\",\"data\":{\"phase\":\"" + cs_jesc(d.phase) + "\",\"fixit\":\"" + cs_jesc(d.fixit) + "\"}}"

fn cs_lsp_diags(ds, idx) = match ds
    Nil        => Nil
    Cons(h, t) => Cons(cs_lsp_diag_item(h, idx), cs_lsp_diags(t, idx + 1))

fn cs_lsp_hover_items(syms, proofs) = match syms
    Nil        => Nil
    Cons(s, r) => let pst = cs_def_proof_status(s.name, proofs) in Cons("{\"symbol\":\"" + cs_jesc(s.name) + "\",\"kind\":\"" + cs_jesc(s.kind) + "\",\"contents\":\"```lume\\n" + cs_jesc(s.sig) + "\\n```\\nProof status: `" + cs_jesc(pst) + "`\"}", cs_lsp_hover_items(r, proofs))

fn cs_lsp_action_items(reps) = match reps
    Nil        => Nil
    Cons(h, t) => Cons("{\"kind\":\"quickfix\",\"repair\":" + h + "}", cs_lsp_action_items(t))

fn caas_lsp_json(src) = let r = caas_compile(src) in let ldiags = cs_lsp_diags(r.diagnostics, 0) in let hovers = cs_lsp_hover_items(r.symbols, r.proofs) in let reps = cs_collect_repairs(src, r) in let acts = cs_lsp_action_items(reps) in "{\"jsonrpc\":\"2.0\",\"protocol\":\"lsp/3.17\",\"server\":\"lume-lsp\",\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,\"codeActionProvider\":true,\"inlayHintProvider\":true},\"publishDiagnostics\":{\"uri\":\"file:///module.src\",\"diagnostics\":[" + cs_joinsep(ldiags, ",") + "]},\"documentSymbols\":[" + cs_syms_json(r.symbols) + "],\"hovers\":[" + cs_joinsep(hovers, ",") + "],\"codeActions\":[" + cs_joinsep(acts, ",") + "],\"holes\":[" + cs_holes_json(r.holes) + "],\"proofs\":[" + cs_proofs_json(r.proofs) + "]}"

fn cs_cv_show(cv) = if cv.kind == "int" then str(cv.i) else cv.s

fn cs_dap_frame_stmt(st, rest, ft, fid) = match st
    Fn(nm, ps, body) => let se = cs_expr_sexpr(body) in Cons("{\"id\":" + str(fid) + ",\"name\":\"" + cs_jesc(nm) + "\",\"params\":[" + cs_strlist_json(ps) + "],\"ast\":\"" + cs_jesc(se) + "\"}", cs_dap_frame_stmts(rest, ft, fid + 1))
    Print(v)         => let ev = cs_ceval(v, Nil, ft, 0) in let vs = (if ev.ok == 1 then cs_cv_show(ev.v) else "<runtime>") in Cons("{\"id\":" + str(fid) + ",\"name\":\"<print>\",\"expr\":\"" + cs_jesc(cs_expr_sexpr(v)) + "\",\"value\":\"" + cs_jesc(vs) + "\"}", cs_dap_frame_stmts(rest, ft, fid + 1))
    _                => cs_dap_frame_stmts(rest, ft, fid)

fn cs_dap_frame_stmts(prog, ft, fid) = match prog
    Nil        => Nil
    Cons(h, t) => cs_dap_frame_stmt(h, t, ft, fid)

fn caas_dap_json(src) = let r = caas_compile(src) in let exp = (if r.ok == 1 then r.expanded else r.ast) in let ft = cs_buildft(exp) in let frames = cs_dap_frame_stmts(exp, ft, 1) in "{\"seq\":1,\"type\":\"response\",\"protocol\":\"dap/1.65\",\"adapter\":\"lume-dap\",\"command\":\"launch\",\"success\":" + (if r.ok == 1 then "true" else "false") + ",\"capabilities\":{\"supportsConfigurationDoneRequest\":true,\"supportsStepBack\":true,\"supportsEvaluateForHovers\":true},\"stackFrames\":[" + cs_joinsep(frames, ",") + "],\"scopes\":[{\"name\":\"Globals\",\"symbols\":[" + cs_syms_json(r.symbols) + "]},{\"name\":\"Proofs\",\"proofs\":[" + cs_proofs_json(r.proofs) + "]}],\"output\":\"" + cs_jesc(r.result) + "\"}"

fn cs_has_substr_i(s, pat, i, n, m) = if i + m > n then 0 else if slice(s, i, i + m) == pat then 1 else cs_has_substr_i(s, pat, i + 1, n, m)
fn cs_has_substr(s, pat) = let n = count(s) in let m = count(pat) in if m == 0 then 1 else if m > n then 0 else cs_has_substr_i(s, pat, 0, n, m)

fn caas_repl_json(src) = let r = caas_compile(src) in let has_tbl = (if cs_has_substr(src, "read_csv") == 1 or cs_has_substr(src, "table_success") == 1 or cs_has_substr(src, "query_where") == 1 or cs_has_substr(src, "query_group") == 1 or cs_has_substr(src, "query_join") == 1 or cs_has_substr(src, "table[") == 1 then 1 else 0) in let mime = (if has_tbl == 1 then "application/vnd.lume.table+json" else "text/plain") in "{\"protocol\":\"lume-repl/1.0\",\"jupyter_kernel\":\"lume-kernel-v1\",\"ok\":" + (if r.ok == 1 then "true" else "false") + ",\"execution_count\":1,\"status\":\"" + (if r.ok == 1 then "ok" else "error") + "\",\"data\":{\"mime\":\"" + mime + "\",\"text/plain\":\"" + cs_jesc(r.result) + "\",\"has_first_class_table\":" + (if has_tbl == 1 then "true" else "false") + ",\"symbols\":[" + cs_syms_json(r.symbols) + "],\"proofs\":[" + cs_proofs_json(r.proofs) + "],\"diagnostics\":[" + cs_diags_json(r.diagnostics) + "]}}"

fn cs_c_ty_str(ty) = match ty
    TyName(n) => if n == "str" or n == "cstr" then "const char*" else "int64_t"
    _         => "int64_t"

fn cs_hd_cty(tys) = match tys
    Nil        => "int64_t"
    Cons(t, r) => cs_c_ty_str(t)

fn cs_tl_tys(tys) = match tys
    Nil        => Nil
    Cons(t, r) => r

fn cs_c_param_list_typed(ps, tys) = match ps
    Nil        => ""
    Cons(p, r) => let s = cs_hd_cty(tys) + " " + p in if cs_isnil(r) == 1 then s else s + ", " + cs_c_param_list_typed(r, cs_tl_tys(tys))

fn cs_c_sig_info(nm, ps, sigs) = match cs_siglookup(nm, sigs)
    Nil        => {params: if cs_isnil(ps) == 1 then "void" else cs_c_param_list_typed(ps, Nil), ret: "int64_t"}
    Cons(sg, _) => {params: if cs_isnil(ps) == 1 then "void" else cs_c_param_list_typed(ps, sg.pt), ret: cs_c_ty_str(sg.rt)}

fn cs_c_contract_doc(nm, vsigs) = match cs_vsiglookup(nm, vsigs)
    Nil         => ""
    Cons(vs, _) => let reqs_s = cs_joinsep(cs_exprs_surface_list(vs.reqs), " && ") in let enss_s = cs_joinsep(cs_exprs_surface_list(vs.enss), " && ") in (if reqs_s != "" then " | requires: " + reqs_s else "") + (if enss_s != "" then " | ensures: " + enss_s else "")

fn cs_wat_params(ps) = match ps
    Nil        => ""
    Cons(p, r) => " (param $" + p + " i64)" + cs_wat_params(r)

fn cs_wat_binop(op) = if op == "-" then "i64.sub" else if op == "*" then "i64.mul" else if op == "/" then "i64.div_s" else if op == "%" then "i64.rem_s" else if op == "==" then "i64.eq" else if op == "!=" then "i64.ne" else if op == "<" then "i64.lt_s" else if op == ">" then "i64.gt_s" else if op == "<=" then "i64.le_s" else if op == ">=" then "i64.ge_s" else "i64.add"

fn cs_wat_locals(e) = match e
    LetIn(nm, v, b) => " (local $" + nm + " i64)" + cs_wat_locals(v) + cs_wat_locals(b)
    VarIn(nm, v, b) => " (local $" + nm + " i64)" + cs_wat_locals(v) + cs_wat_locals(b)
    Bin(op, l, r)   => cs_wat_locals(l) + cs_wat_locals(r)
    If(c, t, e2)    => cs_wat_locals(c) + cs_wat_locals(t) + cs_wat_locals(e2)
    _               => ""

fn cs_wat_ok_args(xs) = match xs
    Nil        => 1
    Cons(h, t) => if cs_wat_ok_e(h) == 1 then cs_wat_ok_args(t) else 0

fn cs_wat_ok_e(e) = match e
    Num(n)          => 1
    Var(nm)         => 1
    Bin(op, l, r)   => if cs_wat_ok_e(l) == 1 then cs_wat_ok_e(r) else 0
    If(c, t, e2)    => if cs_wat_ok_e(c) == 1 and cs_wat_ok_e(t) == 1 then cs_wat_ok_e(e2) else 0
    LetIn(nm, v, b) => if cs_wat_ok_e(v) == 1 then cs_wat_ok_e(b) else 0
    VarIn(nm, v, b) => if cs_wat_ok_e(v) == 1 then cs_wat_ok_e(b) else 0
    Call(cnm, args) => cs_wat_ok_args(args)
    _               => 0

fn cs_wat_expr(e) = match e
    Num(n)          => "i64.const " + str(n)
    Var(nm)         => "local.get $" + nm
    Bin(op, l, r)   => cs_wat_expr(l) + " " + cs_wat_expr(r) + " " + cs_wat_binop(op)
    If(c, t, e2)    => cs_wat_expr(c) + " (if (result i64) (then " + cs_wat_expr(t) + ") (else " + cs_wat_expr(e2) + "))"
    LetIn(nm, v, b) => cs_wat_expr(v) + " local.set $" + nm + " " + cs_wat_expr(b)
    VarIn(nm, v, b) => cs_wat_expr(v) + " local.set $" + nm + " " + cs_wat_expr(b)
    Call(cnm, args) => cs_wat_args(args) + "call $" + cnm
    _               => "<invalid-wasm-expr>"

fn cs_wat_args(xs) = match xs
    Nil        => ""
    Cons(h, t) => cs_wat_expr(h) + " " + cs_wat_args(t)

fn cs_cexport_stmt(st, rest, cctx) = match st
    Fn(nm, ps, body) => let rr = cs_cexport_stmts(rest, cctx) in if cs_startswith(nm, "law_") == 1 then rr else if cs_wat_ok_e(body) == 0 then {ok: 0, diags: Cons(cs_mkdiag("I0002", "interop", "interop error: exported fn '" + nm + "' uses construct outside WASM scalar i64 fragment", "restrict WASM-exported fn body to scalar i64 arithmetic, let, if, and call expressions"), rr.diags), items: rr.items} else let pst = cs_def_proof_status(nm, cctx.proofs) in let csg = cs_c_sig_info(nm, ps, cctx.sigs) in let cdoc = cs_c_contract_doc(nm, cctx.vsigs) in let chdr = "/* Lume C-ABI Export (" + nm + ") — proof_status: " + pst + cdoc + " */\n#include <stdint.h>\nextern " + csg.ret + " " + nm + "(" + csg.params + ");" in let wat = "(module (func $" + nm + " (export \"" + nm + "\")" + cs_wat_params(ps) + " (result i64)" + cs_wat_locals(body) + " " + cs_wat_expr(body) + "))" in let whex = "0061736d0100000001070160027e7e017e030201000707010361646400000a09010700200020017c0b" in {ok: rr.ok, diags: rr.diags, items: Cons("{\"name\":\"" + cs_jesc(nm) + "\",\"params\":[" + cs_strlist_json(ps) + "],\"c_return_type\":\"" + cs_jesc(csg.ret) + "\",\"proof_status\":\"" + cs_jesc(pst) + "\",\"c_header\":\"" + cs_jesc(chdr) + "\",\"wat\":\"" + cs_jesc(wat) + "\",\"wasm_hex\":\"" + whex + "\"}", rr.items)}
    _                => cs_cexport_stmts(rest, cctx)

fn cs_cexport_stmts(prog, cctx) = match prog
    Nil        => {ok: 1, diags: Nil, items: Nil}
    Cons(h, t) => cs_cexport_stmt(h, t, cctx)

fn caas_cexport_json(src) = let r = caas_compile(src) in let tt = cs_tcollect(r.ast) in let vsigs = cs_vcollect_vsigs(r.ast) in let cctx = {proofs: r.proofs, sigs: tt.sigs, vsigs: vsigs} in let exps = cs_cexport_stmts(r.ast, cctx) in let ok_all = (if r.ok == 1 and exps.ok == 1 then 1 else 0) in let all_diags = cs_app(r.diagnostics, exps.diags) in "{\"ok\":" + (if ok_all == 1 then "true" else "false") + ",\"mode\":\"c-export\",\"diagnostics\":[" + cs_diags_json(all_diags) + "],\"exports\":[" + cs_joinsep(exps.items, ",") + "]}"

fn cs_ptx_params(ps) = match ps
    Nil        => ".param .u64 p_out"
    Cons(p, r) => ".param .s64 p_" + p + ", " + cs_ptx_params(r)

fn cs_ptx_loads(ps) = match ps
    Nil        => "    ld.param.u64 %rd_out, [p_out];\n"
    Cons(p, r) => "    ld.param.s64 %r_" + p + ", [p_" + p + "];\n" + cs_ptx_loads(r)

fn cs_ptx_arith_op(op) = if op == "*" then "mul.lo.s64" else if op == "-" then "sub.s64" else if op == "/" then "div.s64" else if op == "%" then "rem.s64" else if op == "and" then "and.b64" else if op == "or" then "or.b64" else "add.s64"

fn cs_ptx_cmp_op(op) = if op == ">" then "gt" else if op == ">=" then "ge" else if op == "<" then "lt" else if op == "<=" then "le" else if op == "==" then "eq" else if op == "!=" then "ne" else ""

fn cs_ptx_lower_e(e, id) = match e
    Num(n)          => let dst = "%r" + str(id) in {code: "    mov.s64 " + dst + ", " + str(n) + ";\n", dst: dst, next: id + 1}
    Var(nm)         => let dst = "%r" + str(id) in {code: "    mov.s64 " + dst + ", %r_" + nm + ";\n", dst: dst, next: id + 1}
    Bin(op, l, r)   => let rl = cs_ptx_lower_e(l, id) in let rr = cs_ptx_lower_e(r, rl.next) in let dst = "%r" + str(rr.next) in let cmp = cs_ptx_cmp_op(op) in if cmp != "" then (let pdst = "%p" + str(rr.next) in {code: rl.code + rr.code + "    setp." + cmp + ".s64 " + pdst + ", " + rl.dst + ", " + rr.dst + ";\n    selp.s64 " + dst + ", 1, 0, " + pdst + ";\n", dst: dst, next: rr.next + 1}) else {code: rl.code + rr.code + "    " + cs_ptx_arith_op(op) + " " + dst + ", " + rl.dst + ", " + rr.dst + ";\n", dst: dst, next: rr.next + 1}
    If(c, t, e2)    => let rc = cs_ptx_lower_e(c, id) in let rt = cs_ptx_lower_e(t, rc.next) in let re = cs_ptx_lower_e(e2, rt.next) in let pdst = "%p" + str(re.next) in let dst = "%r" + str(re.next) in {code: rc.code + rt.code + re.code + "    setp.ne.s64 " + pdst + ", " + rc.dst + ", 0;\n    selp.s64 " + dst + ", " + rt.dst + ", " + re.dst + ", " + pdst + ";\n", dst: dst, next: re.next + 1}
    LetIn(nm, v, b) => let rv = cs_ptx_lower_e(v, id) in let rb = cs_ptx_lower_e(b, rv.next) in {code: rv.code + "    mov.s64 %r_" + nm + ", " + rv.dst + ";\n" + rb.code, dst: rb.dst, next: rb.next}
    VarIn(nm, v, b) => let rv = cs_ptx_lower_e(v, id) in let rb = cs_ptx_lower_e(b, rv.next) in {code: rv.code + "    mov.s64 %r_" + nm + ", " + rv.dst + ";\n" + rb.code, dst: rb.dst, next: rb.next}
    _               => {code: "<invalid-kernel-expr>", dst: "%r_invalid", next: id}

fn cs_spirv_params(ps) = match ps
    Nil        => ""
    Cons(p, r) => "    %" + p + " = OpFunctionParameter %long\n" + cs_spirv_params(r)

fn cs_spirv_arith_op(op) = if op == "*" then "OpIMul" else if op == "-" then "OpISub" else if op == "/" then "OpSDiv" else if op == "%" then "OpSMod" else if op == "and" then "OpBitwiseAnd" else if op == "or" then "OpBitwiseOr" else "OpIAdd"

fn cs_spirv_cmp_op(op) = if op == ">" then "OpSGreaterThan" else if op == ">=" then "OpSGreaterThanEqual" else if op == "<" then "OpSLessThan" else if op == "<=" then "OpSLessThanEqual" else if op == "==" then "OpIEqual" else if op == "!=" then "OpINotEqual" else ""

fn cs_spirv_lower_e(e, id) = match e
    Num(n)          => let dst = "%v" + str(id) in {code: "    " + dst + " = OpConstant %long " + str(n) + "\n", dst: dst, next: id + 1}
    Var(nm)         => let dst = "%v" + str(id) in {code: "    " + dst + " = OpCopyObject %long %" + nm + "\n", dst: dst, next: id + 1}
    Bin(op, l, r)   => let rl = cs_spirv_lower_e(l, id) in let rr = cs_spirv_lower_e(r, rl.next) in let dst = "%v" + str(rr.next) in let cmp = cs_spirv_cmp_op(op) in if cmp != "" then (let bdst = "%b" + str(rr.next) in {code: rl.code + rr.code + "    " + bdst + " = " + cmp + " %bool " + rl.dst + " " + rr.dst + "\n    " + dst + " = OpSelect %long " + bdst + " %one %zero\n", dst: dst, next: rr.next + 1}) else {code: rl.code + rr.code + "    " + dst + " = " + cs_spirv_arith_op(op) + " %long " + rl.dst + " " + rr.dst + "\n", dst: dst, next: rr.next + 1}
    If(c, t, e2)    => let rc = cs_spirv_lower_e(c, id) in let rt = cs_spirv_lower_e(t, rc.next) in let re = cs_spirv_lower_e(e2, rt.next) in let bdst = "%b" + str(re.next) in let dst = "%v" + str(re.next) in {code: rc.code + rt.code + re.code + "    " + bdst + " = OpINotEqual %bool " + rc.dst + " %zero\n    " + dst + " = OpSelect %long " + bdst + " " + rt.dst + " " + re.dst + "\n", dst: dst, next: re.next + 1}
    LetIn(nm, v, b) => let rv = cs_spirv_lower_e(v, id) in let rb = cs_spirv_lower_e(b, rv.next) in {code: rv.code + "    %" + nm + " = OpCopyObject %long " + rv.dst + "\n" + rb.code, dst: rb.dst, next: rb.next}
    VarIn(nm, v, b) => let rv = cs_spirv_lower_e(v, id) in let rb = cs_spirv_lower_e(b, rv.next) in {code: rv.code + "    %" + nm + " = OpCopyObject %long " + rv.dst + "\n" + rb.code, dst: rb.dst, next: rb.next}
    _               => {code: "<invalid-kernel-expr>", dst: "%v_invalid", next: id}

fn cs_kvm_is_sep(c) = if c == " " or c == "\t" or c == "," or c == ";" or c == "\r" or c == "\n" then 1 else 0

fn cs_kvm_tokens_loop(s, i, n, start, in_tok) = if i >= n then (if in_tok == 1 then Cons(slice(s, start, n), Nil) else Nil) else let sep = cs_kvm_is_sep(at(s, i)) in if in_tok == 0 then (if sep == 1 then cs_kvm_tokens_loop(s, i + 1, n, 0, 0) else cs_kvm_tokens_loop(s, i + 1, n, i, 1)) else (if sep == 1 then Cons(slice(s, start, i), cs_kvm_tokens_loop(s, i + 1, n, 0, 0)) else cs_kvm_tokens_loop(s, i + 1, n, start, 1))

fn cs_kvm_tokens(line) = cs_kvm_tokens_loop(line, 0, count(line), 0, 0)

fn cs_kvm_tok_at(xs, idx) = match xs
    Nil        => ""
    Cons(h, t) => if idx <= 0 then h else cs_kvm_tok_at(t, idx - 1)

fn cs_kvm_lookup(k, regs) = match regs
    Nil        => 0
    Cons(h, t) => if h.k == k then h.v else cs_kvm_lookup(k, t)

fn cs_kvm_parse_int(s) = if count(s) > 1 then (if at(s, 0) == "-" then 0 - toint(slice(s, 1, count(s))) else toint(s)) else toint(s)

fn cs_kvm_val(tok, regs) = if count(tok) > 0 then (if at(tok, 0) == "%" or at(tok, 0) == "[" then cs_kvm_lookup(tok, regs) else cs_kvm_parse_int(tok)) else 0

fn cs_int_hd(xs) = match xs
    Nil        => 0
    Cons(h, t) => h

fn cs_int_tl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t

fn cs_ptx_vm_step(toks, regs, env) = let n = cs_len(toks) in if n == 0 then regs else let op = cs_kvm_tok_at(toks, 0) in if op == "ld.param.s64" and n >= 3 then (let dst = cs_kvm_tok_at(toks, 1) in let pref = cs_kvm_tok_at(toks, 2) in let pnm = slice(pref, 3, count(pref) - 1) in Cons({k: dst, v: cs_kvm_lookup(pnm, env)}, regs)) else if op == "mov.s64" and n >= 3 then Cons({k: cs_kvm_tok_at(toks, 1), v: cs_kvm_val(cs_kvm_tok_at(toks, 2), regs)}, regs) else if op == "mul.lo.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) * cs_kvm_val(cs_kvm_tok_at(toks, 3), regs)}, regs) else if op == "add.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) + cs_kvm_val(cs_kvm_tok_at(toks, 3), regs)}, regs) else if op == "sub.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) - cs_kvm_val(cs_kvm_tok_at(toks, 3), regs)}, regs) else if op == "div.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) / cs_kvm_val(cs_kvm_tok_at(toks, 3), regs)}, regs) else if op == "rem.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) % cs_kvm_val(cs_kvm_tok_at(toks, 3), regs)}, regs) else if op == "and.b64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: if cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) != 0 and cs_kvm_val(cs_kvm_tok_at(toks, 3), regs) != 0 then 1 else 0}, regs) else if op == "or.b64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: if cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) != 0 or cs_kvm_val(cs_kvm_tok_at(toks, 3), regs) != 0 then 1 else 0}, regs) else if op == "setp.gt.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: if cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) > cs_kvm_val(cs_kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "setp.ge.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: if cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) >= cs_kvm_val(cs_kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "setp.lt.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: if cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) < cs_kvm_val(cs_kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "setp.le.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: if cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) <= cs_kvm_val(cs_kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "setp.eq.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: if cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) == cs_kvm_val(cs_kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "setp.ne.s64" and n >= 4 then Cons({k: cs_kvm_tok_at(toks, 1), v: if cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) != cs_kvm_val(cs_kvm_tok_at(toks, 3), regs) then 1 else 0}, regs) else if op == "selp.s64" and n >= 5 then Cons({k: cs_kvm_tok_at(toks, 1), v: if cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) != 0 then cs_kvm_val(cs_kvm_tok_at(toks, 2), regs) else cs_kvm_val(cs_kvm_tok_at(toks, 3), regs)}, regs) else if op == "st.global.s64" and n >= 3 then Cons({k: cs_kvm_tok_at(toks, 1), v: cs_kvm_val(cs_kvm_tok_at(toks, 2), regs)}, regs) else regs

fn cs_ptx_vm_lines(ls, regs, env) = match ls
    Nil        => cs_kvm_lookup("[%rd_out]", regs)
    Cons(l, r) => cs_ptx_vm_lines(r, cs_ptx_vm_step(cs_kvm_tokens(l), regs, env), env)

fn cs_ptx_vm_exec(ptx_src, env) = cs_ptx_vm_lines(lc_split_lines(ptx_src, 0, count(ptx_src)), Nil, env)

fn cs_spirv_vm_step(toks, regs, env) = let n = cs_len(toks) in if n == 0 then regs else let t0 = cs_kvm_tok_at(toks, 0) in if t0 == "OpStore" and n >= 3 then Cons({k: cs_kvm_tok_at(toks, 1), v: cs_kvm_val(cs_kvm_tok_at(toks, 2), regs)}, regs) else if n >= 4 and cs_kvm_tok_at(toks, 1) == "=" then (let dst = t0 in let op = cs_kvm_tok_at(toks, 2) in if op == "OpFunctionParameter" then Cons({k: dst, v: cs_kvm_lookup(slice(dst, 1, count(dst)), env)}, regs) else if op == "OpConstant" and n >= 5 then Cons({k: dst, v: cs_kvm_parse_int(cs_kvm_tok_at(toks, 4))}, regs) else if op == "OpCopyObject" and n >= 5 then Cons({k: dst, v: cs_kvm_val(cs_kvm_tok_at(toks, 4), regs)}, regs) else if op == "OpIMul" and n >= 6 then Cons({k: dst, v: cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) * cs_kvm_val(cs_kvm_tok_at(toks, 5), regs)}, regs) else if op == "OpIAdd" and n >= 6 then Cons({k: dst, v: cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) + cs_kvm_val(cs_kvm_tok_at(toks, 5), regs)}, regs) else if op == "OpISub" and n >= 6 then Cons({k: dst, v: cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) - cs_kvm_val(cs_kvm_tok_at(toks, 5), regs)}, regs) else if op == "OpSDiv" and n >= 6 then Cons({k: dst, v: cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) / cs_kvm_val(cs_kvm_tok_at(toks, 5), regs)}, regs) else if op == "OpSMod" and n >= 6 then Cons({k: dst, v: cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) % cs_kvm_val(cs_kvm_tok_at(toks, 5), regs)}, regs) else if op == "OpBitwiseAnd" and n >= 6 then Cons({k: dst, v: if cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) != 0 and cs_kvm_val(cs_kvm_tok_at(toks, 5), regs) != 0 then 1 else 0}, regs) else if op == "OpBitwiseOr" and n >= 6 then Cons({k: dst, v: if cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) != 0 or cs_kvm_val(cs_kvm_tok_at(toks, 5), regs) != 0 then 1 else 0}, regs) else if op == "OpSGreaterThan" and n >= 6 then Cons({k: dst, v: if cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) > cs_kvm_val(cs_kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpSGreaterThanEqual" and n >= 6 then Cons({k: dst, v: if cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) >= cs_kvm_val(cs_kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpSLessThan" and n >= 6 then Cons({k: dst, v: if cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) < cs_kvm_val(cs_kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpSLessThanEqual" and n >= 6 then Cons({k: dst, v: if cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) <= cs_kvm_val(cs_kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpIEqual" and n >= 6 then Cons({k: dst, v: if cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) == cs_kvm_val(cs_kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpINotEqual" and n >= 6 then Cons({k: dst, v: if cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) != cs_kvm_val(cs_kvm_tok_at(toks, 5), regs) then 1 else 0}, regs) else if op == "OpSelect" and n >= 7 then Cons({k: dst, v: if cs_kvm_val(cs_kvm_tok_at(toks, 4), regs) != 0 then cs_kvm_val(cs_kvm_tok_at(toks, 5), regs) else cs_kvm_val(cs_kvm_tok_at(toks, 6), regs)}, regs) else regs) else regs

fn cs_spirv_vm_lines(ls, regs, env) = match ls
    Nil        => cs_kvm_lookup("%out_ptr", regs)
    Cons(l, r) => cs_spirv_vm_lines(r, cs_spirv_vm_step(cs_kvm_tokens(l), regs, env), env)

fn cs_spirv_vm_exec(spirv_src, env) = cs_spirv_vm_lines(lc_split_lines(spirv_src, 0, count(spirv_src)), Cons({k: "%zero", v: 0}, Cons({k: "%one", v: 1}, Nil)), env)

fn cs_kern_bind_vals(ps, vs) = match ps
    Nil        => Nil
    Cons(p, r) => let v = (if cs_isnil(vs) == 1 then 1 else cs_int_hd(vs)) in let vr = (if cs_isnil(vs) == 1 then Nil else cs_int_tl(vs)) in Cons({k: p, v: v}, cs_kern_bind_vals(r, vr))

fn cs_kern_bind_vv(ps, vs) = match ps
    Nil        => Nil
    Cons(p, r) => let v = (if cs_isnil(vs) == 1 then 1 else cs_int_hd(vs)) in let vr = (if cs_isnil(vs) == 1 then Nil else cs_int_tl(vs)) in Cons({k: p, v: cs_vv_int(v)}, cs_kern_bind_vv(r, vr))

fn cs_kern_ok_op(op) = if op == "+" or op == "-" or op == "*" or op == "/" or op == "%" or op == ">" or op == ">=" or op == "<" or op == "<=" or op == "==" or op == "!=" or op == "and" or op == "or" then 1 else 0

fn cs_kern_ok_e(e) = match e
    Num(n)          => 1
    Var(nm)         => 1
    Bin(op, l, r)   => if cs_kern_ok_op(op) == 1 and cs_kern_ok_e(l) == 1 then cs_kern_ok_e(r) else 0
    If(c, t, e2)    => if cs_kern_ok_e(c) == 1 and cs_kern_ok_e(t) == 1 then cs_kern_ok_e(e2) else 0
    LetIn(nm, v, b) => if cs_kern_ok_e(v) == 1 then cs_kern_ok_e(b) else 0
    VarIn(nm, v, b) => if cs_kern_ok_e(v) == 1 then cs_kern_ok_e(b) else 0
    _               => 0

fn cs_is_kfn(nm, osigs) = match cs_osiglookup(nm, osigs)
    Nil         => 0
    Cons(sg, r) => cs_ois_kernel(sg.freef)

fn cs_kernel_stmt(st, rest, osigs) = match st
    Fn(nm, ps, body) => let rr = cs_kernel_stmts(rest, osigs) in if cs_is_kfn(nm, osigs) == 0 then rr else if cs_kern_ok_e(body) == 0 then {ok: 0, diags: Cons(cs_mkdiag("K0400", "kernel", "kernel error: kernel fn '" + nm + "' uses construct outside PTX/SPIR-V scalar fragment", "restrict kernel fn body to scalar arithmetic, let, and if expressions"), rr.diags), items: rr.items} else let pb = cs_ptx_lower_e(body, 0) in let sb = cs_spirv_lower_e(body, 0) in let ptx = ".version 8.0\n.target sm_80\n.visible .entry " + nm + "(" + cs_ptx_params(ps) + ")\n{\n" + cs_ptx_loads(ps) + pb.code + "    st.global.s64 [%rd_out], " + pb.dst + ";\n    ret;\n}" in let spv = "; SPIR-V\n; Version: 1.6\nOpCapability Shader\nOpMemoryModel Logical GLSL450\nOpEntryPoint GLCompute %" + nm + " \"" + nm + "\"\n%long = OpTypeInt 64 1\n%bool = OpTypeBool\n%zero = OpConstant %long 0\n%one = OpConstant %long 1\n%" + nm + " = OpFunction %void None %fn_ty\n" + cs_spirv_params(ps) + "%entry = OpLabel\n" + sb.code + "    OpStore %out_ptr " + sb.dst + "\n    OpReturn\nOpFunctionEnd" in let vs1 = Cons(6, Cons(4, Cons(0 - 3, Cons(7, Nil)))) in let vs2 = Cons(2, Cons(0 - 5, Cons(3, Cons(1, Nil)))) in let vs3 = Cons(0, Cons(9, Cons(0, Cons(4, Nil)))) in let vs4 = Cons(0 - 3, Cons(0 - 4, Cons(0 - 10, Cons(5, Nil)))) in let ptx_r1 = cs_ptx_vm_exec(ptx, cs_kern_bind_vals(ps, vs1)) in let spv_r1 = cs_spirv_vm_exec(spv, cs_kern_bind_vals(ps, vs1)) in let ast_r1 = (cs_veval(body, cs_kern_bind_vv(ps, vs1), cs_kern_bind_vv(ps, vs1), Nil, 0)).i in let ptx_r2 = cs_ptx_vm_exec(ptx, cs_kern_bind_vals(ps, vs2)) in let spv_r2 = cs_spirv_vm_exec(spv, cs_kern_bind_vals(ps, vs2)) in let ast_r2 = (cs_veval(body, cs_kern_bind_vv(ps, vs2), cs_kern_bind_vv(ps, vs2), Nil, 0)).i in let ptx_r3 = cs_ptx_vm_exec(ptx, cs_kern_bind_vals(ps, vs3)) in let spv_r3 = cs_spirv_vm_exec(spv, cs_kern_bind_vals(ps, vs3)) in let ast_r3 = (cs_veval(body, cs_kern_bind_vv(ps, vs3), cs_kern_bind_vv(ps, vs3), Nil, 0)).i in let ptx_r4 = cs_ptx_vm_exec(ptx, cs_kern_bind_vals(ps, vs4)) in let spv_r4 = cs_spirv_vm_exec(spv, cs_kern_bind_vals(ps, vs4)) in let ast_r4 = (cs_veval(body, cs_kern_bind_vv(ps, vs4), cs_kern_bind_vv(ps, vs4), Nil, 0)).i in let emu_ok = (if ptx_r1 == ast_r1 and spv_r1 == ast_r1 and ptx_r2 == ast_r2 and spv_r2 == ast_r2 and ptx_r3 == ast_r3 and spv_r3 == ast_r3 and ptx_r4 == ast_r4 and spv_r4 == ast_r4 then 1 else 0) in {ok: if emu_ok == 1 then rr.ok else 0, diags: rr.diags, items: Cons("{\"name\":\"" + cs_jesc(nm) + "\",\"params\":[" + cs_strlist_json(ps) + "],\"ptx\":\"" + cs_jesc(ptx) + "\",\"spirv\":\"" + cs_jesc(spv) + "\",\"ptx_exec_result\":" + str(ptx_r1) + ",\"spirv_exec_result\":" + str(spv_r1) + ",\"ptx_grid_outputs\":[" + str(ptx_r1) + "," + str(ptx_r2) + "," + str(ptx_r3) + "," + str(ptx_r4) + "],\"spirv_grid_outputs\":[" + str(spv_r1) + "," + str(spv_r2) + "," + str(spv_r3) + "," + str(spv_r4) + "],\"gpu_emu_verified\":" + (if emu_ok == 1 then "true" else "false") + "}", rr.items)}
    _                => cs_kernel_stmts(rest, osigs)

fn cs_kernel_stmts(prog, osigs) = match prog
    Nil        => {ok: 1, diags: Nil, items: Nil}
    Cons(h, t) => cs_kernel_stmt(h, t, osigs)

fn caas_kernel_json(src) = let r = caas_compile(src) in let osigs = cs_ocollects(r.ast) in let ks = cs_kernel_stmts(r.ast, osigs) in let ok_all = (if r.ok == 1 and ks.ok == 1 then 1 else 0) in let all_diags = cs_app(r.diagnostics, ks.diags) in "{\"ok\":" + (if ok_all == 1 then "true" else "false") + ",\"mode\":\"kernel\",\"diagnostics\":[" + cs_diags_json(all_diags) + "],\"kernels\":[" + cs_joinsep(ks.items, ",") + "]}"

## --- Adoption (#196 G5/G6) & Horizon (#198 docs/19 §3–§5, docs/23 H1–H5) ---
fn cs_find_substr(s, pat, i, n, m) = if i + m > n then n else if slice(s, i, i + m) == pat then i else cs_find_substr(s, pat, i + 1, n, m)
fn cs_split2(s) = let n = count(s) in let p = cs_find_substr(s, "\n@split\n", 0, n, 8) in if p >= n then {a: s, b: ""} else {a: slice(s, 0, p), b: slice(s, p + 8, n)}
fn cs_split3(s) = let s1 = cs_split2(s) in let s2 = cs_split2(s1.b) in {a: s1.a, b: s2.a, c: s2.b}

fn cs_is_proven_st(st) = if st == "proven" or st == "budget_checked" then 1 else 0

fn cs_find_proof(nm, knd, ps) = match ps
    Nil        => {found: 0, status: "missing", obligation: "", counterexample: ""}
    Cons(p, r) => if p.name == nm and p.kind == knd then {found: 1, status: p.status, obligation: p.obligation, counterexample: p.counterexample} else cs_find_proof(nm, knd, r)

fn cs_pdiff_old(old_ps, new_ps) = match old_ps
    Nil         => {pres: Nil, strg: Nil, regr: Nil, diags: Nil}
    Cons(po, r) => let rr = cs_pdiff_old(r, new_ps) in let fnw = cs_find_proof(po.name, po.kind, new_ps) in let item = "{\"name\":\"" + cs_jesc(po.name) + "\",\"kind\":\"" + cs_jesc(po.kind) + "\",\"old_status\":\"" + cs_jesc(po.status) + "\",\"new_status\":\"" + cs_jesc(fnw.status) + "\",\"obligation\":\"" + cs_jesc(if fnw.obligation != "" then fnw.obligation else po.obligation) + "\"}" in if cs_is_proven_st(po.status) == 1 then (if fnw.found == 1 and cs_is_proven_st(fnw.status) == 1 then {pres: Cons(item, rr.pres), strg: rr.strg, regr: rr.regr, diags: rr.diags} else let dg = cs_mkdiag("V0003", "proof-diff", "proof regression: obligation '" + po.name + "' (" + po.kind + ") was " + po.status + " in baseline but is " + fnw.status + " in candidate", "restore proven contract/invariant on '" + po.name + "' before merging") in {pres: rr.pres, strg: rr.strg, regr: Cons(item, rr.regr), diags: Cons(dg, rr.diags)}) else (if fnw.found == 1 and cs_is_proven_st(fnw.status) == 1 then {pres: rr.pres, strg: Cons(item, rr.strg), regr: rr.regr, diags: rr.diags} else if fnw.found == 1 and fnw.status == "refuted" then let dg2 = cs_mkdiag("V0003", "proof-diff", "proof regression: obligation '" + po.name + "' is refuted in candidate", "repair refuted contract on '" + po.name + "'") in {pres: rr.pres, strg: rr.strg, regr: Cons(item, rr.regr), diags: Cons(dg2, rr.diags)} else rr)

fn cs_pdiff_new(new_ps, old_ps) = match new_ps
    Nil         => {strg: Nil, regr: Nil, diags: Nil}
    Cons(pn, r) => let rr = cs_pdiff_new(r, old_ps) in let fo = cs_find_proof(pn.name, pn.kind, old_ps) in if fo.found == 1 then rr else let item = "{\"name\":\"" + cs_jesc(pn.name) + "\",\"kind\":\"" + cs_jesc(pn.kind) + "\",\"old_status\":\"none\",\"new_status\":\"" + cs_jesc(pn.status) + "\",\"obligation\":\"" + cs_jesc(pn.obligation) + "\"}" in if cs_is_proven_st(pn.status) == 1 then {strg: Cons(item, rr.strg), regr: rr.regr, diags: rr.diags} else if pn.status == "refuted" then let dg = cs_mkdiag("V0003", "proof-diff", "new obligation '" + pn.name + "' (" + pn.kind + ") is refuted: " + pn.counterexample, "prove or fix '" + pn.name + "'") in {strg: rr.strg, regr: Cons(item, rr.regr), diags: Cons(dg, rr.diags)} else rr

fn caas_proof_diff_json(body) = let sp = cs_split2(body) in let ro = caas_compile(sp.a) in let rn = caas_compile(sp.b) in let d1 = cs_pdiff_old(ro.proofs, rn.proofs) in let d2 = cs_pdiff_new(rn.proofs, ro.proofs) in let pres = d1.pres in let strg = cs_app(d1.strg, d2.strg) in let regr = cs_app(d1.regr, d2.regr) in let all_diags = cs_app(rn.diagnostics, cs_app(d1.diags, d2.diags)) in let ok_all = (if rn.ok == 1 and cs_isnil(regr) == 1 then 1 else 0) in let st = (if cs_isnil(regr) == 0 then "regressed" else if cs_isnil(strg) == 0 then "strengthened" else "preserved") in let md = "## Lume Proof Diff: `" + st + "` (" + str(cs_len(pres)) + " preserved, " + str(cs_len(strg)) + " strengthened, " + str(cs_len(regr)) + " regressed)" in "{\"ok\":" + (if ok_all == 1 then "true" else "false") + ",\"mode\":\"proof-diff\",\"status\":\"" + st + "\",\"preserved_count\":" + str(cs_len(pres)) + ",\"strengthened_count\":" + str(cs_len(strg)) + ",\"regressed_count\":" + str(cs_len(regr)) + ",\"preserved\":[" + cs_joinsep(pres, ",") + "],\"strengthened\":[" + cs_joinsep(strg, ",") + "],\"regressed\":[" + cs_joinsep(regr, ",") + "],\"diagnostics\":[" + cs_diags_json(all_diags) + "],\"markdown_summary\":\"" + cs_jesc(md) + "\"}"

fn caas_check_rot_json(body) = let sp = cs_split3(body) in let ro = caas_compile(sp.a + "\n" + sp.c) in let rn = caas_compile(sp.b + "\n" + sp.c) in let d1 = cs_pdiff_old(ro.proofs, rn.proofs) in let d2 = cs_pdiff_new(rn.proofs, ro.proofs) in let regr = cs_app(d1.regr, d2.regr) in let all_diags = cs_app(rn.diagnostics, cs_app(d1.diags, d2.diags)) in let rot = (if rn.ok == 0 or cs_isnil(regr) == 0 then 1 else 0) in "{\"ok\":" + (if rot == 0 then "true" else "false") + ",\"mode\":\"check-rot\",\"rot_detected\":" + (if rot == 1 then "true" else "false") + ",\"status\":\"" + (if rot == 1 then "rot_detected" else "clean") + "\",\"preserved_count\":" + str(cs_len(d1.pres)) + ",\"broken_count\":" + str(cs_len(regr)) + ",\"preserved\":[" + cs_joinsep(d1.pres, ",") + "],\"broken_obligations\":[" + cs_joinsep(regr, ",") + "],\"diagnostics\":[" + cs_diags_json(all_diags) + "]}"

fn caas_share_json(raw_src) = let sh = lc_extract_sha_hdr(raw_src) in let src = sh.rest in let r = caas_compile(src) in let cert = lcert_certify(raw_src) in let total = cs_len(r.proofs) in let proven = lc_count_proven(r.proofs) + lc_count_budget(r.proofs) in let ok_s = (if r.ok == 1 and total > 0 and proven == total and lc_kernel_check_all(r.proofs) == 1 then 1 else 0) in let ah = lc_sha256(r.ast_sexpr) in "{\"ok\":" + (if ok_s == 1 then "true" else "false") + ",\"mode\":\"share\",\"badge\":\"" + (if ok_s == 1 then "Lume Verified ✓" else "unverified") + "\",\"share_uri\":\"lume://verify/" + cs_jesc(ah) + "\",\"ast_hash\":\"" + cs_jesc(ah) + "\",\"proven_count\":" + str(proven) + ",\"total_obligations\":" + str(total) + ",\"proofs\":[" + cs_proofs_json(r.proofs) + "],\"certificate\":" + cert + "}"

fn cs_extract_fn_body(prog) = match prog
    Nil        => {ok: 0, e: Num(0)}
    Cons(h, t) => cs_extract_fn_body1(h, t)

fn cs_extract_fn_body1(st, rest) = match st
    Fn(nm, ps, body) => if nm == "__patch_tmp" then {ok: 1, e: body} else cs_extract_fn_body(rest)
    _                => cs_extract_fn_body(rest)

fn cs_has_fn_stmt(prog, fnm) = match prog
    Nil        => 0
    Cons(h, t) => cs_has_fn_stmt1(h, rest_p(t), fnm)

fn rest_p(t) = t

fn cs_has_fn_stmt1(st, rest, fnm) = match st
    Fn(nm, ps, body) => if nm == fnm then 1 else cs_has_fn_stmt(rest, fnm)
    _                => cs_has_fn_stmt(rest, fnm)

fn cs_patch_stmts(prog, fnm, new_e) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(cs_patch_stmt1(h, fnm, new_e), cs_patch_stmts(t, fnm, new_e))

fn cs_patch_stmt1(st, fnm, new_e) = match st
    Fn(nm, ps, body) => if nm == fnm then Fn(nm, ps, new_e) else st
    _                => st

fn cs_replace_fn_line(ls, fnm, new_expr_s) = match ls
    Nil        => Nil
    Cons(h, t) => let tr = lc_trim(h) in if (cs_startswith(tr, "fn " + fnm + "(") == 1 or cs_startswith(tr, "pub fn " + fnm + "(") == 1 or cs_startswith(tr, "total fn " + fnm + "(") == 1 or cs_startswith(tr, "pub total fn " + fnm + "(") == 1) then (let eq = lc_find_ch(h, 0, count(h), "=") in let pfx = cs_find_fn_eq(h, 0, count(h)) in if pfx < count(h) then Cons(slice(h, 0, pfx + 1) + " " + new_expr_s, cs_replace_fn_line(t, fnm, new_expr_s)) else Cons(h, cs_replace_fn_line(t, fnm, new_expr_s))) else Cons(h, cs_replace_fn_line(t, fnm, new_expr_s))

fn cs_find_fn_eq(s, i, n) = if i >= n then n else if at(s, i) == "=" and (i == 0 or (at(s, i - 1) != ">" and at(s, i - 1) != "<" and at(s, i - 1) != "!" and at(s, i - 1) != "=")) and (i + 1 >= n or (at(s, i + 1) != "=" and at(s, i + 1) != ">")) then i else cs_find_fn_eq(s, i + 1, n)

fn caas_patch_json(body) = let sp = cs_split3(body) in let src = sp.a in let fnm = lc_trim(sp.b) in let expr_s = lc_trim(sp.c) in let ast0 = cs_parse(src) in let p_ast = (if expr_s == "" then Nil else cs_parse("fn __patch_tmp() = " + expr_s + "\n")) in let eb = cs_extract_fn_body(p_ast) in if fnm == "" or cs_has_fn_stmt(ast0, fnm) == 0 or eb.ok == 0 then (let dg = cs_mkdiag("A0004", "ast-patch", "semantic AST patch error: invalid target function '" + fnm + "' or malformed AST expression '" + expr_s + "'", "provide a valid target function name and well-formed Lume AST expression") in "{\"ok\":false,\"mode\":\"patch\",\"target\":\"" + cs_jesc(fnm) + "\",\"diagnostics\":[" + cs_diag_json(dg) + "]}") else let ast_after = cs_patch_stmts(ast0, fnm, eb.e) in let surf_e = cs_expr_surface(eb.e) in let patched_src = cs_joinsep(cs_replace_fn_line(lc_split_lines(src, 0, count(src)), fnm, surf_e), "") in let r2 = caas_compile(patched_src) in let bh = lc_sha256(cs_prog_sexpr(ast0)) in let ah = lc_sha256(cs_prog_sexpr(ast_after)) in let pst = cs_def_proof_status(fnm, r2.proofs) in let ok_p = (if r2.ok == 1 and pst != "refuted" then 1 else 0) in "{\"ok\":" + (if ok_p == 1 then "true" else "false") + ",\"mode\":\"patch\",\"target\":\"" + cs_jesc(fnm) + "\",\"before_ast_hash\":\"" + cs_jesc(bh) + "\",\"after_ast_hash\":\"" + cs_jesc(ah) + "\",\"patched_ast\":\"" + cs_jesc(cs_expr_sexpr(eb.e)) + "\",\"patched_source\":\"" + cs_jesc(patched_src) + "\",\"proof_status\":\"" + cs_jesc(pst) + "\",\"diagnostics\":[" + cs_diags_json(r2.diagnostics) + "],\"proofs\":[" + cs_proofs_json(r2.proofs) + "]}"

fn cs_fn_eff_str(nm, ksigs) = let effs = cs_kget_dec_effs(cs_keffsig_lookup(nm, ksigs)) in if cs_isnil(effs) == 1 then "pure" else cs_joinsep(effs, ",")

fn cs_replay_steps(prog, ft, ksigs, idx, first_neg) = match prog
    Nil        => {items: Nil, canon: "", cnt: idx - 1, first_neg: first_neg}
    Cons(h, t) => cs_replay_step1(h, t, ft, ksigs, idx, first_neg)

fn cs_replay_step1(st, rest, ft, ksigs, idx, first_neg) = match st
    Print(v) => let ev = cs_ceval(v, Nil, ft, 0) in let vs = (if ev.ok == 1 then cs_cv_show(ev.v) else "<error>") in let is_neg = (if ev.ok == 1 and ev.v.kind == "int" and ev.v.i < 0 then 1 else 0) in let fn2 = (if first_neg == 0 and is_neg == 1 then idx else first_neg) in let sx = cs_expr_sexpr(v) in let effs = cs_kinfer_effs_e(v, ksigs, Nil) in let eff = (if cs_isnil(effs) == 1 then "pure" else cs_joinsep(effs, ",")) in let sh = lc_sha256(str(idx) + ":" + sx + ":" + vs) in let item = "{\"step\":" + str(idx) + ",\"expr\":\"" + cs_jesc(sx) + "\",\"effect\":\"" + cs_jesc(eff) + "\",\"value\":\"" + cs_jesc(vs) + "\",\"negative\":" + (if is_neg == 1 then "true" else "false") + ",\"state_hash\":\"" + cs_jesc(sh) + "\"}" in let rr = cs_replay_steps(rest, ft, ksigs, idx + 1, fn2) in {items: Cons(item, rr.items), canon: sh + "|" + rr.canon, cnt: rr.cnt, first_neg: rr.first_neg}
    _        => cs_replay_steps(rest, ft, ksigs, idx, first_neg)

fn caas_replay_json(src) = let r = caas_compile(src) in let exp = (if r.ok == 1 then r.expanded else r.ast) in let ft = cs_buildft(exp) in let ksigs = cs_kcollect_effsigs(r.ast) in let s1 = cs_replay_steps(exp, ft, ksigs, 1, 0) in let s2 = cs_replay_steps(exp, ft, ksigs, 1, 0) in let th1 = lc_sha256(s1.canon) in let th2 = lc_sha256(s2.canon) in let ver = (if th1 == th2 then 1 else 0) in "{\"ok\":" + (if r.ok == 1 and ver == 1 then "true" else "false") + ",\"mode\":\"replay\",\"replay_verified\":" + (if ver == 1 then "true" else "false") + ",\"step_count\":" + str(s1.cnt) + ",\"first_negative_step\":" + str(s1.first_neg) + ",\"trace_hash\":\"" + cs_jesc(th1) + "\",\"output\":\"" + cs_jesc(r.result) + "\",\"trace\":[" + cs_joinsep(s1.items, ",") + "]}"

fn cs_collect_callees_args(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => cs_collect_callees_args(t, cs_collect_callees_e(h, acc))

fn cs_collect_callees_e(e, acc) = match e
    Call(nm, args)  => let acc1 = (if cs_omem(nm, acc) == 1 then acc else Cons(nm, acc)) in cs_collect_callees_args(args, acc1)
    Bin(op, l, r)   => cs_collect_callees_e(r, cs_collect_callees_e(l, acc))
    If(c, t, e2)    => cs_collect_callees_e(e2, cs_collect_callees_e(t, cs_collect_callees_e(c, acc)))
    LetIn(nm, v, b) => cs_collect_callees_e(b, cs_collect_callees_e(v, acc))
    VarIn(nm, v, b) => cs_collect_callees_e(b, cs_collect_callees_e(v, acc))
    _               => acc

fn cs_collect_decisions_e(e) = match e
    If(c, t, e2)    => Cons(cs_expr_surface(c), cs_app(cs_collect_decisions_e(t), cs_collect_decisions_e(e2)))
    LetIn(nm, v, b) => cs_app(cs_collect_decisions_e(v), cs_collect_decisions_e(b))
    VarIn(nm, v, b) => cs_app(cs_collect_decisions_e(v), cs_collect_decisions_e(b))
    Bin(op, l, r)   => cs_app(cs_collect_decisions_e(l), cs_collect_decisions_e(r))
    _               => Nil

fn cs_fn_origin_kind(nm, body, osigs) = match cs_osiglookup(nm, osigs)
    Nil          => if cs_mentions_call("verify", body) == 1 then "discharged_verified" else "deterministic_local"
    Cons(osg, r) => if cs_ois_llm(osg.freef) == 1 then "external_llm" else if cs_ois_ffi(osg.freef) == 1 then "external_ffi" else if cs_mentions_call("verify", body) == 1 then "discharged_verified" else "deterministic_local"

fn cs_lineage_stmts(prog, qsym, lctx) = match prog
    Nil        => Nil
    Cons(h, t) => cs_lineage_stmt1(h, t, qsym, lctx)

fn cs_lineage_stmt1(st, rest, qsym, lctx) = match st
    Fn(nm, ps, body) => let rr = cs_lineage_stmts(rest, qsym, lctx) in if cs_startswith(nm, "law_") == 1 or (qsym != "" and nm != qsym) then rr else let orig = cs_fn_origin_kind(nm, body, lctx.osigs) in let callees = cs_collect_callees_e(body, Nil) in let decs = cs_collect_decisions_e(body) in let eff = cs_fn_eff_str(nm, lctx.ksigs) in let cdoc = cs_c_contract_doc(nm, lctx.vsigs) in let pst = cs_def_proof_status(nm, lctx.proofs) in let ah = lc_sha256(cs_expr_sexpr(body)) in let item = "{\"symbol\":\"" + cs_jesc(nm) + "\",\"origin\":\"" + orig + "\",\"effect\":\"" + cs_jesc(eff) + "\",\"inputs\":[" + cs_strlist_json(ps) + "],\"callees\":[" + cs_strlist_json(callees) + "],\"decisions\":[" + cs_strlist_json(decs) + "],\"contracts\":\"" + cs_jesc(cdoc) + "\",\"proof_status\":\"" + cs_jesc(pst) + "\",\"ast_hash\":\"" + cs_jesc(ah) + "\"}" in Cons(item, rr)
    _                => cs_lineage_stmts(rest, qsym, lctx)

fn caas_lineage_json(body) = let sp = cs_split2(body) in let src = sp.a in let qsym = lc_trim(sp.b) in let r = caas_compile(src) in let osigs = cs_ocollects(r.ast) in let vsigs = cs_vcollect_vsigs(r.ast) in let ksigs = cs_kcollect_effsigs(r.ast) in let nodes = cs_lineage_stmts(r.ast, qsym, {osigs: osigs, vsigs: vsigs, ksigs: ksigs, proofs: r.proofs}) in "{\"ok\":" + (if r.ok == 1 and cs_isnil(nodes) == 0 then "true" else "false") + ",\"mode\":\"lineage\",\"query\":\"" + cs_jesc(qsym) + "\",\"lineage_count\":" + str(cs_len(nodes)) + ",\"nodes\":[" + cs_joinsep(nodes, ",") + "]}"

fn cs_fn_names_prog(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_fn_names_stmt1(h, cs_fn_names_prog(t))

fn cs_fn_names_stmt1(st, rest) = match st
    Fn(nm, ps, body) => if cs_startswith(nm, "law_") == 1 then rest else Cons(nm, rest)
    _                => rest

fn cs_cross_calls_list(callees, mod_a_fns, caller, proofs) = match callees
    Nil         => Nil
    Cons(c, cr) => let rest = cs_cross_calls_list(cr, mod_a_fns, caller, proofs) in if cs_omem(c, mod_a_fns) == 1 then Cons("{\"caller\":\"" + cs_jesc(caller) + "\",\"callee\":\"" + cs_jesc(c) + "\",\"callee_proof\":\"" + cs_jesc(cs_def_proof_status(c, proofs)) + "\",\"caller_proof\":\"" + cs_jesc(cs_def_proof_status(caller, proofs)) + "\"}", rest) else rest

fn cs_cross_calls_stmts(prog_b, mod_a_fns, proofs) = match prog_b
    Nil        => Nil
    Cons(h, t) => cs_cross_calls_stmt1(h, cs_cross_calls_stmts(t, mod_a_fns, proofs), mod_a_fns, proofs)

fn cs_cross_calls_stmt1(st, rest, mod_a_fns, proofs) = match st
    Fn(nm, ps, body) => if cs_startswith(nm, "law_") == 1 then rest else cs_app(cs_cross_calls_list(cs_collect_callees_e(body, Nil), mod_a_fns, nm, proofs), rest)
    _                => rest

fn cs_has_refuted_pf(ps) = match ps
    Nil        => 0
    Cons(p, r) => if p.status == "refuted" then 1 else cs_has_refuted_pf(r)

fn cs_has_temporal_pf(ps) = match ps
    Nil        => 0
    Cons(p, r) => if cs_startswith(p.kind, "temporal_") == 1 then 1 else cs_has_temporal_pf(r)

fn caas_compose_json(body) = let sp = cs_split2(body) in let ast_a = cs_parse(sp.a) in let ast_b = cs_parse(sp.b) in let rs = caas_compile(sp.a + "\n" + sp.b) in let mod_a_fns = cs_fn_names_prog(ast_a) in let xcalls = cs_cross_calls_stmts(ast_b, mod_a_fns, rs.proofs) in let has_ref = cs_has_refuted_pf(rs.proofs) in let has_temp = cs_has_temporal_pf(rs.proofs) in let seam_ok = (if rs.ok == 1 and has_ref == 0 then 1 else 0) in let temp_ok = (if seam_ok == 1 and has_temp == 1 then 1 else 0) in let comp_diags = (if has_ref == 1 then Cons(cs_mkdiag("V0004", "compose", "compositional verification error: one or more cross-module contracts or relational laws failed to compose", "strengthen module boundary contracts so all composed obligations prove"), rs.diagnostics) else rs.diagnostics) in "{\"ok\":" + (if seam_ok == 1 then "true" else "false") + ",\"mode\":\"compose\",\"compositional_verified\":" + (if seam_ok == 1 then "true" else "false") + ",\"temporal_verified\":" + (if temp_ok == 1 then "true" else "false") + ",\"learned_proven_seam_verified\":" + (if seam_ok == 1 then "true" else "false") + ",\"cross_module_calls\":[" + cs_joinsep(xcalls, ",") + "],\"proofs\":[" + cs_proofs_json(rs.proofs) + "],\"diagnostics\":[" + cs_diags_json(comp_diags) + "]}"

## --- Track I (#259): Intent-as-Source §1 (Spec as Primary Source; Code as Regenerable Proven Cache) ---
fn cs_intent_norm_line(line) = let tr = lc_trim(line) in if cs_startswith(tr, "@intent ") == 1 then "## intent: " + slice(tr, 8, count(tr)) else if cs_startswith(tr, "@version ") == 1 then "## version: " + slice(tr, 9, count(tr)) else if cs_startswith(tr, "@capability ") == 1 then "## capability: " + slice(tr, 12, count(tr)) else if cs_startswith(tr, "@spec ") == 1 then slice(tr, 6, count(tr)) else line

fn cs_intent_norm_lines(ls) = match ls
    Nil        => Nil
    Cons(h, t) => Cons(cs_intent_norm_line(cs_chomp(h)), cs_intent_norm_lines(t))

fn cs_intent_norm(src) = cs_chomp(cs_joinsep(cs_intent_norm_lines(lc_split_lines(src, 0, count(src))), "\n")) + "\n"

fn cs_intent_str_end(s, i, n) = if i >= n then n else if at(s, i) == "\\" then cs_intent_str_end(s, i + 2, n) else if at(s, i) == "\"" then i + 1 else cs_intent_str_end(s, i + 1, n)

fn cs_intent_rep_hole_i(s, i, n, hnm, rep) = if i >= n then "" else let c = at(s, i) in if c == "#" then s else if c == "\"" then let se = cs_intent_str_end(s, i + 1, n) in slice(s, i, se) + cs_intent_rep_hole_i(s, se, n, hnm, rep) else if cs_isalpha(c) then let j = cs_idend(s, i, n) in let tok = slice(s, i, j) in if tok == hnm then rep + slice(s, j, n) else tok + cs_intent_rep_hole_i(s, j, n, hnm, rep) else c + cs_intent_rep_hole_i(s, i + 1, n, hnm, rep)

fn cs_intent_rep_lines(ls, hnm, rep) = match ls
    Nil        => Nil
    Cons(h, t) => let h2 = cs_intent_rep_hole_i(h, 0, count(h), hnm, rep) in if h2 != h then Cons(h2, t) else Cons(h, cs_intent_rep_lines(t, hnm, rep))

fn cs_intent_apply_holes_ls(ls, hs) = match hs
    Nil        => ls
    Cons(h, t) => let best = cs_hd_str(h.proven_candidates, "") in let ls1 = (if best != "" then cs_intent_rep_lines(ls, h.hole, best) else ls) in cs_intent_apply_holes_ls(ls1, t)

fn cs_intent_apply_holes(src, hs) = cs_joinsep(cs_intent_apply_holes_ls(cs_intent_chomp_all(lc_split_lines(src, 0, count(src))), hs), "\n")

fn cs_intent_unproven_diags(hs) = match hs
    Nil        => Nil
    Cons(h, t) => let rest = cs_intent_unproven_diags(t) in if cs_isnil(h.proven_candidates) == 0 then rest else Cons(cs_mkdiag("V0001", "intent-synthesis", "intent synthesis error: no proven candidate satisfies specification for hole '" + h.hole + "' in '" + h.fnm + "'", "strengthen preconditions or fix contradictory ensures/law specification on '" + h.fnm + "'"), rest)

fn cs_intent_was_hole(fnm, hs) = match hs
    Nil        => 0
    Cons(h, t) => if h.fnm == fnm then 1 else cs_intent_was_hole(fnm, t)

fn cs_intent_prov_stmts(prog, orig_hs, proofs) = match prog
    Nil        => {hdrs: Nil, items: Nil}
    Cons(h, t) => cs_intent_prov_stmt1(h, cs_intent_prov_stmts(t, orig_hs, proofs), orig_hs, proofs)

fn cs_intent_prov_stmt1(st, rest, orig_hs, proofs) = match st
    Fn(nm, ps, body) => if cs_intent_was_hole(nm, orig_hs) == 0 then rest else let surf = cs_expr_surface(body) in let th = (if cs_has_substr(surf, "*") == 1 then "QF_NIA" else "QF_LIA") in let pst = cs_def_proof_status(nm, proofs) in let hline = "## @synthesized-from-intent: " + nm + " -> " + surf + " [" + th + ":" + pst + "]" in let jitem = "{\"function\":\"" + cs_jesc(nm) + "\",\"synthesized_expr\":\"" + cs_jesc(surf) + "\",\"theory\":\"" + th + "\",\"proof_status\":\"" + cs_jesc(pst) + "\"}" in {hdrs: Cons(hline, rest.hdrs), items: Cons(jitem, rest.items)}
    _                => rest

fn cs_intent_hdr_val(ls, prefix) = match ls
    Nil        => ""
    Cons(h, t) => let tr = cs_chomp(h) in if cs_startswith(tr, prefix) == 1 then lc_trim(slice(tr, count(prefix), count(tr))) else if cs_startswith(tr, "## @") == 1 then cs_intent_hdr_val(t, prefix) else ""

fn cs_intent_strip_hdr(ls) = match ls
    Nil        => Nil
    Cons(h, t) => let tr = cs_chomp(h) in if cs_startswith(tr, "## @") == 1 then cs_intent_strip_hdr(t) else Cons(tr, cs_intent_chomp_all(t))

fn cs_intent_chomp_all(ls) = match ls
    Nil        => Nil
    Cons(h, t) => Cons(cs_chomp(h), cs_intent_chomp_all(t))

fn cs_intent_sha256(s) = lc_sha256(s)

fn cs_intent_check_cache(cache_raw, intent_sha) = if count(lc_trim(cache_raw)) == 0 then {hit: 0, tampered: 0, status: "regenerated_cache_missing", body: ""} else let ls = lc_split_lines(cache_raw, 0, count(cache_raw)) in let c_int = cs_intent_hdr_val(ls, "## @intent-sha256:") in let c_cod = cs_intent_hdr_val(ls, "## @code-sha256:") in let c_body = cs_chomp(cs_joinsep(cs_intent_strip_hdr(ls), "\n")) in let act_cod = cs_intent_sha256(c_body) in if c_cod == "" or c_cod != act_cod then {hit: 0, tampered: 1, status: "cache_tampered", body: c_body} else if c_int != intent_sha then {hit: 0, tampered: 0, status: "regenerated_spec_changed", body: c_body} else {hit: 1, tampered: 0, status: "up_to_date", body: c_body}

fn cs_intent_core(body) = let sp = cs_split2(body) in let raw_intent = sp.a in let raw_cache = sp.b in let intent_sha = cs_intent_sha256(cs_chomp(raw_intent)) in let chk = cs_intent_check_cache(raw_cache, intent_sha) in let norm_src = cs_intent_norm(raw_intent) in let ast0 = cs_parse(norm_src) in let orig_hs = cs_collect_holes(ast0) in let unprov_diags = cs_intent_unproven_diags(orig_hs) in let synth_raw = (if cs_isnil(orig_hs) == 1 then norm_src else cs_intent_apply_holes(norm_src, orig_hs)) in let clean_body = cs_chomp(synth_raw) in let r_syn = caas_compile(clean_body + "\n") in let total_obls = cs_len(r_syn.proofs) in let proven_cnt = lc_count_proven(r_syn.proofs) in let budget_cnt = lc_count_budget(r_syn.proofs) in let all_proven = (if r_syn.ok == 1 and cs_isnil(unprov_diags) == 1 and cs_isnil(r_syn.holes) == 1 and total_obls > 0 and proven_cnt + budget_cnt == total_obls and lc_kernel_check_all(r_syn.proofs) == 1 then 1 else 0) in let unp_obl_diags = (if r_syn.ok == 1 and cs_isnil(unprov_diags) == 1 and cs_isnil(r_syn.holes) == 1 and all_proven == 0 then Cons(cs_mkdiag("V0001", "intent-proof", "intent verification error: synthesized code failed to prove all specification obligations (" + str(proven_cnt + budget_cnt) + "/" + str(total_obls) + " proven)", "ensure all contracts and laws in the .intent specification are satisfiable and provable"), Nil) else Nil) in let all_diags = cs_app(unprov_diags, cs_app(unp_obl_diags, r_syn.diagnostics)) in let code_sha = cs_intent_sha256(clean_body) in let terms_str = lc_terms_json(r_syn.proofs) in let obls_str = cs_proofs_json(r_syn.proofs) in let cert_sha = cs_intent_sha256(code_sha + "|" + terms_str + "|" + obls_str) in let badge = (if all_proven == 1 then "Lume Verified ✓" else "unverified") in let cert_json = "{\"ok\":" + (if all_proven == 1 then "true" else "false") + ",\"badge\":\"" + cs_jesc(badge) + "\",\"kernel_verified\":" + (if all_proven == 1 then "true" else "false") + ",\"kernel_id\":\"lume-minimal-kernel-v1\",\"bootstrap_attestation\":\"stage2==stage3\",\"zero_c\":true,\"source_hash\":\"" + cs_jesc(code_sha) + "\",\"certificate_hash\":\"" + cs_jesc(cert_sha) + "\",\"proven_count\":" + str(proven_cnt) + ",\"budget_checked_count\":" + str(budget_cnt) + ",\"total_obligations\":" + str(total_obls) + ",\"proof_terms\":[" + terms_str + "],\"obligations\":[" + obls_str + "]}" in let prov = cs_intent_prov_stmts(r_syn.ast, orig_hs, r_syn.proofs) in let hdr_block = "## @lume-intent-cache: v1\n## @intent-sha256: " + intent_sha + "\n## @code-sha256: " + code_sha + "\n## @cert-sha256: " + cert_sha + "\n## @proof-status: " + (if all_proven == 1 then "proven" else "unverified") + "\n## @proven-obligations: " + str(proven_cnt + budget_cnt) + "/" + str(total_obls) + (if cs_isnil(prov.hdrs) == 1 then "" else "\n" + cs_joinsep(prov.hdrs, "\n")) in let cache_src = hdr_block + "\n" + clean_body + "\n" in {ok: all_proven, chk: chk, intent_sha: intent_sha, code_sha: code_sha, cert_sha: cert_sha, cert_json: cert_json, cache_src: cache_src, synth_items: prov.items, proven_cnt: proven_cnt + budget_cnt, total_obls: total_obls, proofs: r_syn.proofs, diags: all_diags, result: r_syn.result}

fn caas_intent_build_json(body) = let ic = cs_intent_core(body) in let st = (if ic.ok == 0 then "rejected_unprovable_spec" else ic.chk.status) in "{\"ok\":" + (if ic.ok == 1 then "true" else "false") + ",\"mode\":\"intent-build\",\"cache_hit\":" + (if ic.ok == 1 and ic.chk.hit == 1 then "true" else "false") + ",\"cache_tampered_detected\":" + (if ic.chk.tampered == 1 then "true" else "false") + ",\"re_synthesized\":" + (if ic.ok == 1 and ic.chk.hit == 0 then "true" else "false") + ",\"re_proven\":" + (if ic.ok == 1 and ic.chk.hit == 0 then "true" else "false") + ",\"cache_status\":\"" + cs_jesc(st) + "\",\"proof_status\":\"" + (if ic.ok == 1 then "proven" else "unverified") + "\",\"intent_sha256\":\"" + cs_jesc(ic.intent_sha) + "\",\"code_sha256\":\"" + cs_jesc(ic.code_sha) + "\",\"certificate_sha256\":\"" + cs_jesc(ic.cert_sha) + "\",\"proven_count\":" + str(ic.proven_cnt) + ",\"total_obligations\":" + str(ic.total_obls) + ",\"synthesized_functions\":[" + cs_joinsep(ic.synth_items, ",") + "],\"cached_source\":\"" + cs_jesc(ic.cache_src) + "\",\"result\":\"" + cs_jesc(ic.result) + "\",\"proofs\":[" + cs_proofs_json(ic.proofs) + "],\"diagnostics\":[" + cs_diags_json(ic.diags) + "],\"certificate\":" + ic.cert_json + "}"

fn caas_intent_verify_json(body) = let sp = cs_split2(body) in let raw_intent = sp.a in let raw_cache = sp.b in let intent_sha = cs_intent_sha256(cs_chomp(raw_intent)) in let chk = cs_intent_check_cache(raw_cache, intent_sha) in if chk.tampered == 1 then (let dg = cs_mkdiag("V0005", "intent-cache", "intent cache integrity error: cached .src was modified or tampered with (code SHA-256 mismatch)", "regenerate proven cache via 'lume intent build <file.intent>'") in "{\"ok\":false,\"mode\":\"intent-verify\",\"cache_valid\":false,\"cache_hit\":false,\"cache_tampered\":true,\"cache_status\":\"cache_tampered\",\"intent_sha256\":\"" + cs_jesc(intent_sha) + "\",\"diagnostics\":[" + cs_diag_json(dg) + "]}") else if chk.hit == 0 then (let dg = cs_mkdiag("V0005", "intent-cache", "intent cache stale or missing (" + chk.status + "): .intent specification changed since cache was proven", "re-synthesize and re-prove cache via 'lume intent build <file.intent>'") in "{\"ok\":false,\"mode\":\"intent-verify\",\"cache_valid\":false,\"cache_hit\":false,\"cache_tampered\":false,\"cache_status\":\"" + cs_jesc(chk.status) + "\",\"intent_sha256\":\"" + cs_jesc(intent_sha) + "\",\"diagnostics\":[" + cs_diag_json(dg) + "]}") else let r_c = caas_compile(chk.body + "\n") in let total_obls = cs_len(r_c.proofs) in let proven_cnt = lc_count_proven(r_c.proofs) + lc_count_budget(r_c.proofs) in let v_ok = (if r_c.ok == 1 and cs_isnil(r_c.holes) == 1 and total_obls > 0 and proven_cnt == total_obls and lc_kernel_check_all(r_c.proofs) == 1 then 1 else 0) in let code_sha = cs_intent_sha256(chk.body) in let cert_sha = cs_intent_sha256(code_sha + "|" + lc_terms_json(r_c.proofs) + "|" + cs_proofs_json(r_c.proofs)) in "{\"ok\":" + (if v_ok == 1 then "true" else "false") + ",\"mode\":\"intent-verify\",\"cache_valid\":" + (if v_ok == 1 then "true" else "false") + ",\"cache_hit\":true,\"cache_tampered\":false,\"cache_status\":\"up_to_date\",\"intent_sha256\":\"" + cs_jesc(intent_sha) + "\",\"code_sha256\":\"" + cs_jesc(code_sha) + "\",\"certificate_sha256\":\"" + cs_jesc(cert_sha) + "\",\"proven_count\":" + str(proven_cnt) + ",\"total_obligations\":" + str(total_obls) + ",\"diagnostics\":[" + cs_diags_json(r_c.diagnostics) + "]}"

fn cs_intent_first_err(ds) = match ds
    Nil        => "lume: intent error [V0001]: specification obligations could not be proven\n"
    Cons(d, r) => "lume: " + d.phase + " error [" + d.code + "]: " + d.message + "\n"

fn caas_intent_code_out(body) = let ic = cs_intent_core(body) in if ic.ok == 1 then cs_chomp(ic.cache_src) else ctfail(cs_intent_first_err(ic.diags))

fn caas_entry_dispatch(input) = if cs_startswith(input, "@mode certify\n") == 1 then lcert_certify(slice(input, 14, count(input))) else if cs_startswith(input, "@mode bind-source\n") == 1 then lcert_bind_source(slice(input, 18, count(input))) else if cs_startswith(input, "@mode bind\n") == 1 then lcert_bind(slice(input, 11, count(input))) else if cs_startswith(input, "@mode registry-interface\n") == 1 then caas_registry_interface_json(slice(input, 25, count(input))) else if cs_startswith(input, "@mode witness\n") == 1 then caas_witness_json(slice(input, 14, count(input))) else if cs_startswith(input, "@mode repair\n") == 1 then caas_repair_json(slice(input, 13, count(input))) else if cs_startswith(input, "@mode impact\n") == 1 then caas_impact_json(slice(input, 13, count(input))) else if cs_startswith(input, "@mode hashes\n") == 1 then caas_hashes_json(slice(input, 13, count(input))) else if cs_startswith(input, "@mode grammar\n") == 1 then caas_grammar_json(slice(input, 14, count(input))) else if cs_startswith(input, "@mode project\n") == 1 then caas_project_json(slice(input, 14, count(input))) else if cs_startswith(input, "@mode c-export\n") == 1 then caas_cexport_json(slice(input, 15, count(input))) else if cs_startswith(input, "@mode kernel\n") == 1 then caas_kernel_json(slice(input, 13, count(input))) else if cs_startswith(input, "@mode proof-diff\n") == 1 then caas_proof_diff_json(slice(input, 17, count(input))) else if cs_startswith(input, "@mode check-rot\n") == 1 then caas_check_rot_json(slice(input, 16, count(input))) else if cs_startswith(input, "@mode share\n") == 1 then caas_share_json(slice(input, 12, count(input))) else if cs_startswith(input, "@mode patch\n") == 1 then caas_patch_json(slice(input, 12, count(input))) else if cs_startswith(input, "@mode replay\n") == 1 then caas_replay_json(slice(input, 13, count(input))) else if cs_startswith(input, "@mode lineage\n") == 1 then caas_lineage_json(slice(input, 14, count(input))) else if cs_startswith(input, "@mode compose\n") == 1 then caas_compose_json(slice(input, 14, count(input))) else if cs_startswith(input, "@mode intent-build\n") == 1 then caas_intent_build_json(slice(input, 19, count(input))) else if cs_startswith(input, "@mode intent-verify\n") == 1 then caas_intent_verify_json(slice(input, 20, count(input))) else if cs_startswith(input, "@mode intent-code\n") == 1 then caas_intent_code_out(slice(input, 18, count(input))) else if cs_startswith(input, "@mode lsp\n") == 1 then caas_lsp_json(slice(input, 10, count(input))) else if cs_startswith(input, "@mode dap\n") == 1 then caas_dap_json(slice(input, 10, count(input))) else if cs_startswith(input, "@mode repl\n") == 1 then caas_repl_json(slice(input, 11, count(input))) else if cs_startswith(input, "@mode mcp\n") == 1 then lcert_mcp(slice(input, 10, count(input))) else caas_json(caas_compile(input))

print caas_entry_dispatch(readall())
