## lcaas.src -- Lume Compiler-as-a-Service (Track E, brick E1; Principles P1, P28, P30, P31).
## Exposes `lumec` as both an in-process callable Lume-Core library (`use lcaas`) and a
## native JSON query agent (`lume agent`).
##
## Given any Lume source string `src`, `caas_compile(src)` runs lexing, parsing, symbol
## extraction, non-aborting multi-diagnostic F1/F2/C3/C1/M1/M2 checking with AI-first
## fix-it suggestions, C3 generic type-argument erasure, C1/C2/M1/M2 comptime & hygienic
## quasiquote expansion, x86-64 native assembly generation, and in-memory execution:
##   source in -> {ok, diagnostics, symbols, ast, ast_sexpr, expanded, expanded_sexpr, asm, result} out
## without ever aborting the host process on invalid user code.

## --- internal character, string & list helpers (prefixed `cs_` to avoid collisions on `use lcaas`) ---
fn cs_isws(c) = c == " " or c == "\t" or c == "\n" or c == "\r"
fn cs_isdigit(c) = c >= "0" and c <= "9"
fn cs_isalpha(c) = c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c == "_"
fn cs_isalnum(c) = cs_isdigit(c) or cs_isalpha(c)
fn cs_isupper(c) = c >= "A" and c <= "Z"

fn cs_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, cs_app(t, ys))
fn cs_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + cs_len(t)
fn cs_isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn cs_revacc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => cs_revacc(t, Cons(h, acc))
fn cs_rev(xs) = cs_revacc(xs, Nil)
fn cs_pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => cs_pairs2(a, t)
fn cs_pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, cs_pairs(r))
fn cs_joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if cs_isnil(t) == 1 then a else cs_joinall(cs_pairs(xs))
fn cs_addsep(xs, sep) = match xs
    Nil        => Nil
    Cons(h, t) => if cs_isnil(t) == 1 then Cons(h, Nil) else Cons(h + sep, cs_addsep(t, sep))
fn cs_joinsep(xs, sep) = cs_joinall(cs_addsep(xs, sep))
fn cs_rtrimnl(s, e) = if e <= 0 then 0 else if at(s, e - 1) == "\n" or at(s, e - 1) == "\r" or at(s, e - 1) == " " then cs_rtrimnl(s, e - 1) else e
fn cs_chomp(s) = slice(s, 0, cs_rtrimnl(s, count(s)))
fn cs_startswith(s, p) = if count(s) < count(p) then 0 else slice(s, 0, count(p)) == p

fn cs_jesc_clean(s, i, n) = if i >= n then 1 else let c = at(s, i) in if c == "\"" or c == "\\" or c == "\n" or c == "\r" or c == "\t" then 0 else cs_jesc_clean(s, i + 1, n)
fn cs_jesc_ch(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\r" then "\\r" else if c == "\t" then "\\t" else c
fn cs_jesc_i(s, i, n) = if i >= n then "" else cs_jesc_ch(at(s, i)) + cs_jesc_i(s, i + 1, n)
fn cs_jesc(s) = if cs_jesc_clean(s, 0, count(s)) == 1 then s else cs_jesc_i(s, 0, count(s))

## --- lexer ---
fn cs_numend(s, i, n) = if i >= n then i else if cs_isdigit(at(s, i)) then cs_numend(s, i + 1, n) else i
fn cs_idend(s, i, n) = if i >= n then i else if cs_isalnum(at(s, i)) then cs_idend(s, i + 1, n) else i
fn cs_lineend(s, i, n) = if i >= n then i else if at(s, i) == "\n" then i + 1 else cs_lineend(s, i + 1, n)
fn cs_escchar(c) = if c == "n" then "\n" else if c == "t" then "\t" else if c == "\"" then "\"" else if c == "\\" then "\\" else c
fn cs_strplain(s, i, n) = if i >= n then i else let c = at(s, i) in if c == "\"" or c == "\\" then i else cs_strplain(s, i + 1, n)
fn cs_strend(s, i, n, acc) = let j = cs_strplain(s, i, n) in let acc2 = if j > i then acc + slice(s, i, j) else acc in if j >= n then {txt: acc2, next: n} else if at(s, j) == "\"" then {txt: acc2, next: j + 1} else cs_strend(s, j + 2, n, acc2 + cs_escchar(at(s, j + 1)))
fn cs_istwo(s, i, n) = if i + 1 >= n then 0 else cs_istwopair(slice(s, i, i + 2))
fn cs_istwopair(p) = p == "==" or p == "!=" or p == "<=" or p == ">=" or p == "=>"
fn cs_lex(s, i) = if i >= count(s) then Nil else cs_lex1(s, i, count(s), at(s, i))
fn cs_lex1(s, i, n, c) = if cs_isws(c) then cs_lex(s, i + 1) else if c == "#" then cs_lex(s, cs_lineend(s, i + 1, n)) else if cs_isdigit(c) then cs_lexnum(s, i, cs_numend(s, i, n)) else if cs_isalpha(c) then cs_lexid(s, i, cs_idend(s, i, n)) else if c == "\"" then cs_lexstr(s, cs_strend(s, i + 1, n, "")) else if cs_istwo(s, i, n) == 1 then Cons({kind: "SY", text: slice(s, i, i + 2)}, cs_lex(s, i + 2)) else Cons({kind: "SY", text: c}, cs_lex(s, i + 1))
fn cs_lexnum(s, i, j) = Cons({kind: "NM", text: slice(s, i, j)}, cs_lex(s, j))
fn cs_lexid(s, i, j) = Cons({kind: "ID", text: slice(s, i, j)}, cs_lex(s, j))
fn cs_lexstr(s, r) = Cons({kind: "ST", text: r.txt}, cs_lex(s, r.next))

## --- parser ---
fn cs_hd(ts) = match ts
    Nil        => {kind: "EOF", text: ""}
    Cons(h, t) => h
fn cs_hdkind(ts) = (cs_hd(ts)).kind
fn cs_hdtext(ts) = (cs_hd(ts)).text
fn cs_drop1(ts) = match ts
    Nil        => Nil
    Cons(h, t) => t
fn cs_dropkw(ts, kw) = if cs_hdtext(ts) == kw then cs_drop1(ts) else ts
fn cs_skiprp(ts) = cs_dropkw(ts, ")")
fn cs_skiprk(ts) = cs_dropkw(ts, "]")

fn cs_prim(ts) = cs_postfix(cs_atom(ts))
fn cs_atom(ts) = if cs_hdkind(ts) == "NM" then {node: Num(toint(cs_hdtext(ts))), rest: cs_drop1(ts)} else if cs_hdkind(ts) == "ST" then {node: Str(cs_hdtext(ts)), rest: cs_drop1(ts)} else if cs_hdtext(ts) == "(" then cs_paren(cs_drop1(ts)) else if cs_hdtext(ts) == "{" then cs_rec(cs_drop1(ts)) else if cs_hdtext(ts) == "if" then cs_if(cs_drop1(ts)) else if cs_hdtext(ts) == "let" then cs_let(cs_drop1(ts)) else if cs_hdtext(ts) == "var" then cs_var(cs_drop1(ts)) else if cs_hdtext(ts) == "own" then cs_owne(cs_drop1(ts)) else if cs_hdtext(ts) == "mut" then cs_mute(cs_drop1(ts)) else if cs_hdtext(ts) == "defer" then cs_defer(cs_drop1(ts)) else if cs_hdtext(ts) == "errdefer" then cs_errdefer(cs_drop1(ts)) else if cs_hdtext(ts) == "with" then cs_with(cs_drop1(ts)) else if cs_hdtext(ts) == "scope" then cs_scope(cs_drop1(ts)) else if cs_hdtext(ts) == "spawn" then cs_spawn(cs_drop1(ts)) else if cs_hdtext(ts) == "match" then cs_match(cs_drop1(ts)) else if cs_hdtext(ts) == "comptime" then cs_ct(cs_drop1(ts)) else if cs_hdtext(ts) == "quote" then cs_quote(cs_drop1(ts)) else if cs_hdtext(ts) == "splice" then cs_splice(cs_drop1(ts)) else if cs_hdkind(ts) == "ID" then cs_ident(cs_hdtext(ts), cs_drop1(ts)) else {node: Num(0), rest: cs_drop1(ts)}
fn cs_paren(ts) = let r = cs_expr(ts) in {node: r.node, rest: cs_skiprp(r.rest)}
fn cs_ident(nm, ts) = if cs_hdtext(ts) == "(" then cs_call(nm, cs_arglist(cs_drop1(ts))) else if cs_hdtext(ts) == "{" then cs_rect(nm, cs_rec(cs_drop1(ts))) else {node: Var(nm), rest: ts}
fn cs_call(nm, a) = {node: Call(nm, a.items), rest: a.rest}
fn cs_rect(nm, r) = cs_rect2(nm, r.node, r.rest)
fn cs_rect2(nm, nd, rest) = match nd
    Rec(items) => {node: RecT(nm, items), rest: rest}
    _          => {node: nd, rest: rest}
fn cs_arglist(ts) = if cs_hdtext(ts) == ")" then {items: Nil, rest: cs_drop1(ts)} else cs_argmore(cs_expr(ts))
fn cs_argmore(r) = if cs_hdtext(r.rest) == "," then cs_argcons(r.node, cs_arglist(cs_drop1(r.rest))) else {items: Cons(r.node, Nil), rest: cs_skiprp(r.rest)}
fn cs_argcons(h, rr) = {items: Cons(h, rr.items), rest: rr.rest}
fn cs_rec(ts) = if cs_hdtext(ts) == "}" then {node: Rec(Nil), rest: cs_drop1(ts)} else cs_recfields(ts)
fn cs_recfields(ts) = let k = cs_hdtext(ts) in let r = cs_expr(cs_dropkw(cs_drop1(ts), ":")) in if cs_hdtext(r.rest) == "," then cs_reccons(k, r.node, cs_recfields(cs_drop1(r.rest))) else {node: Rec(Cons({key: k, val: r.node}, Nil)), rest: cs_dropkw(r.rest, "}")}
fn cs_reccons(k, v, rr) = cs_reccons2(k, v, rr.node, rr.rest)
fn cs_reccons2(k, v, nd, rest) = match nd
    Rec(items) => {node: Rec(Cons({key: k, val: v}, items)), rest: rest}
    _          => {node: nd, rest: rest}
fn cs_postdotcall(nd, mnm, a) = match nd
    Var(enm) => {node: Call(mnm, a.items), rest: a.rest}
    _        => {node: Call(mnm, Cons(nd, a.items)), rest: a.rest}
fn cs_postfix(r) = if cs_hdtext(r.rest) == "." then (let t1 = cs_drop1(r.rest) in let mnm = cs_hdtext(t1) in let t2 = cs_drop1(t1) in if cs_hdtext(t2) == "(" then cs_postfix(cs_postdotcall(r.node, mnm, cs_arglist(cs_drop1(t2)))) else cs_postfix({node: Field(r.node, mnm), rest: t2})) else r

fn cs_ct(ts) = let r = cs_prim(ts) in {node: CT(r.node), rest: r.rest}
fn cs_quote(ts) = let r = cs_prim(ts) in {node: Quote(r.node), rest: r.rest}
fn cs_splice(ts) = let r = cs_prim(ts) in {node: Splice(r.node), rest: r.rest}

fn cs_mul(ts) = cs_mulloop(cs_prim(ts))
fn cs_mulloop(l) = let op = cs_hdtext(l.rest) in if op == "*" or op == "/" or op == "%" then cs_mulloop(cs_mkbin(op, l.node, cs_prim(cs_drop1(l.rest)))) else l
fn cs_add(ts) = cs_addloop(cs_mul(ts))
fn cs_addloop(l) = let op = cs_hdtext(l.rest) in if op == "+" or op == "-" then cs_addloop(cs_mkbin(op, l.node, cs_mul(cs_drop1(l.rest)))) else l
fn cs_cmp(ts) = cs_cmploop(cs_add(ts))
fn cs_cmploop(l) = let op = cs_hdtext(l.rest) in if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" then cs_cmploop(cs_mkbin(op, l.node, cs_add(cs_drop1(l.rest)))) else l
fn cs_and(ts) = cs_andloop(cs_cmp(ts))
fn cs_andloop(l) = if cs_hdtext(l.rest) == "and" then cs_andloop(cs_mkbin("and", l.node, cs_cmp(cs_drop1(l.rest)))) else l
fn cs_or(ts) = cs_orloop(cs_and(ts))
fn cs_orloop(l) = if cs_hdtext(l.rest) == "or" then cs_orloop(cs_mkbin("or", l.node, cs_and(cs_drop1(l.rest)))) else l
fn cs_mkbin(op, a, r) = {node: Bin(op, a, r.node), rest: r.rest}
fn cs_expr(ts) = cs_or(ts)

fn cs_if(ts) = let c = cs_expr(ts) in let t = cs_expr(cs_dropkw(c.rest, "then")) in let e2 = cs_expr(cs_dropkw(t.rest, "else")) in {node: If(c.node, t.node, e2.node), rest: e2.rest}
fn cs_dropin(ts) = if cs_hdtext(ts) == "in" or cs_hdtext(ts) == ";" then cs_drop1(ts) else ts
fn cs_let(ts) = let nm = cs_hdtext(ts) in let v = cs_expr(cs_dropkw(cs_drop1(ts), "=")) in let b = cs_expr(cs_dropin(v.rest)) in {node: LetIn(nm, v.node, b.node), rest: b.rest}
fn cs_var(ts) = let nm = cs_hdtext(ts) in let v = cs_expr(cs_dropkw(cs_drop1(ts), "=")) in let b = cs_expr(cs_dropin(v.rest)) in {node: VarIn(nm, v.node, b.node), rest: b.rest}
fn cs_owne(ts) = let r = cs_prim(ts) in {node: OwnE(r.node), rest: r.rest}
fn cs_mute(ts) = let r = cs_prim(ts) in {node: MutE(r.node), rest: r.rest}
fn cs_defer(ts) = let c = cs_expr(ts) in let b = cs_expr(cs_dropin(c.rest)) in {node: DeferE(c.node, b.node), rest: b.rest}
fn cs_errdefer(ts) = let c = cs_expr(ts) in let b = cs_expr(cs_dropin(c.rest)) in {node: ErrDeferE(c.node, b.node), rest: b.rest}
fn cs_parsehop(ts) = let opnm = cs_hdtext(cs_drop1(ts)) in let ps = cs_pparams(cs_dropkw(cs_drop1(cs_drop1(ts)), "(")) in let rt = cs_pret(ps.rest) in let b = cs_expr(cs_dropkw(rt.rest, "=")) in {op: {op: opnm, ps: ps.items, body: b.node}, rest: cs_dropkw(b.rest, ";")}
fn cs_parsehops(ts) = if cs_hdtext(ts) == "fn" then let r = cs_parsehop(ts) in let rr = cs_parsehops(r.rest) in {items: Cons(r.op, rr.items), rest: rr.rest} else {items: Nil, rest: ts}
fn cs_withhandler(t) = let enm = cs_hdtext(t) in let hs = cs_parsehops(cs_dropkw(cs_drop1(t), "{")) in let b = cs_expr(cs_dropin(cs_dropkw(hs.rest, "}"))) in {node: WithHandlerE(enm, hs.items, b.node), rest: b.rest}
fn cs_with(ts) = if cs_hdtext(ts) == "alloc" then let a = cs_expr(cs_dropkw(cs_drop1(ts), "=")) in let b = cs_expr(cs_dropin(a.rest)) in {node: WithAllocE(a.node, b.node), rest: b.rest} else if cs_hdtext(ts) == "handler" then cs_withhandler(cs_drop1(ts)) else cs_expr(ts)
fn cs_scope(t) = if cs_hdtext(cs_drop1(t)) == "in" or cs_hdtext(cs_drop1(t)) == ";" or cs_hdtext(cs_drop1(t)) == "{" then (let snm = cs_hdtext(t) in let t1 = cs_drop1(t) in let hb = if cs_hdtext(t1) == "{" then 1 else 0 in let rb = cs_expr(if hb == 1 then cs_drop1(t1) else cs_dropin(t1)) in {node: ScopeE(snm, rb.node), rest: if hb == 1 then cs_dropkw(rb.rest, "}") else rb.rest}) else let hb = if cs_hdtext(t) == "{" then 1 else 0 in let rb = cs_expr(if hb == 1 then cs_drop1(t) else cs_dropin(t)) in {node: ScopeE("_scope", rb.node), rest: if hb == 1 then cs_dropkw(rb.rest, "}") else rb.rest}
fn cs_spawn(t) = if cs_hdtext(t) == "(" then let a = cs_arglist(cs_drop1(t)) in {node: SpawnE(cs_asthead(a.items)), rest: a.rest} else let r = cs_expr(t) in {node: SpawnE(r.node), rest: r.rest}

fn cs_ispatstart(ts) = if cs_hdkind(ts) == "NM" or cs_hdkind(ts) == "ST" then 1 else if cs_hdkind(ts) == "ID" then cs_ispatid(cs_hdtext(ts)) else 0
fn cs_ispatid(s) = if s == "fn" or s == "pub" or s == "total" or s == "llm" or s == "effect" or s == "law" or s == "resource" or s == "print" or s == "type" or s == "let" or s == "var" or s == "if" or s == "then" or s == "else" or s == "in" or s == "match" or s == "and" or s == "or" then 0 else 1
fn cs_pat(ts) = if cs_hdkind(ts) == "NM" then {pat: PInt(toint(cs_hdtext(ts))), rest: cs_drop1(ts)} else if cs_hdkind(ts) == "ST" then {pat: PStr(cs_hdtext(ts)), rest: cs_drop1(ts)} else if cs_hdtext(ts) == "_" then {pat: PWild, rest: cs_drop1(ts)} else cs_patid(cs_hdtext(ts), cs_drop1(ts))
fn cs_patid(nm, ts) = if cs_isupper(at(nm, 0)) then cs_patctor(nm, ts) else {pat: PBind(nm), rest: ts}
fn cs_patctor(nm, ts) = if cs_hdtext(ts) == "(" then cs_patargs(nm, cs_patlist(cs_drop1(ts))) else {pat: PCons(nm, Nil), rest: ts}
fn cs_patargs(nm, r) = {pat: PCons(nm, r.items), rest: r.rest}
fn cs_patlist(ts) = if cs_hdtext(ts) == ")" then {items: Nil, rest: cs_drop1(ts)} else cs_patmore(cs_hdtext(ts), cs_drop1(ts))
fn cs_patmore(nm, ts) = if cs_hdtext(ts) == "," then cs_patcons(nm, cs_patlist(cs_drop1(ts))) else {items: Cons(nm, Nil), rest: cs_skiprp(ts)}
fn cs_patcons(nm, rr) = {items: Cons(nm, rr.items), rest: rr.rest}
fn cs_hasarm(ts) = if cs_ispatstart(ts) == 0 then 0 else cs_afterpat(cs_pat(ts))
fn cs_afterpat(p) = cs_hdtext(p.rest) == "=>"
fn cs_match(ts) = let sc = cs_expr(ts) in let a = cs_arms(sc.rest) in {node: Match(sc.node, a.items), rest: a.rest}
fn cs_arms(ts) = let p = cs_pat(ts) in let b = cs_expr(cs_dropkw(p.rest, "=>")) in if cs_hasarm(b.rest) == 1 then cs_armcons(p.pat, b.node, cs_arms(b.rest)) else {items: Cons({pat: p.pat, body: b.node}, Nil), rest: b.rest}
fn cs_armcons(p, b, rr) = {items: Cons({pat: p, body: b}, rr.items), rest: rr.rest}

## --- declarations (type / fn / print / expr) ---
fn cs_istyapp1(nm) = nm == "table" or nm == "rc" or nm == "arc" or nm == "weak" or nm == "cell" or nm == "chan" or nm == "Ref" or nm == "View" or nm == "unverified"
fn cs_ptype1(ts) = if cs_hdtext(ts) == "[" then cs_ptlist(cs_ptype1(cs_drop1(ts))) else if cs_istyapp1(cs_hdtext(ts)) and cs_hdtext(cs_drop1(ts)) == "[" then cs_ptapp(cs_hdtext(ts), cs_ptype1(cs_drop1(cs_drop1(ts)))) else {node: TyName(cs_hdtext(ts)), rest: cs_drop1(ts)}
fn cs_ptlist(r) = {node: TyList(r.node), rest: cs_skiprk(r.rest)}
fn cs_ptapp(kind, r) = {node: TyApply(kind, r.node), rest: cs_skiprk(r.rest)}
fn cs_ptypes(ts) = if cs_hdtext(ts) == ")" then {items: Nil, rest: cs_drop1(ts)} else cs_ptmore(cs_ptype1(ts))
fn cs_ptmore(r) = if cs_hdtext(r.rest) == "," then cs_ptcons(r.node, cs_ptypes(cs_drop1(r.rest))) else {items: Cons(r.node, Nil), rest: cs_skiprp(r.rest)}
fn cs_ptcons(n, rr) = {items: Cons(n, rr.items), rest: rr.rest}

fn cs_pparams(ts) = if cs_hdtext(ts) == ")" then {items: Nil, tys: Nil, plist: Nil, rest: cs_drop1(ts)} else cs_pparamk(ts)
fn cs_pparamk(ts) = if cs_hdtext(ts) == "comptime" then cs_pparam(cs_hdtext(cs_drop1(ts)), 1, cs_drop1(cs_drop1(ts))) else if cs_hdtext(ts) == "own" then cs_pparam(cs_hdtext(cs_drop1(ts)), 2, cs_drop1(cs_drop1(ts))) else if cs_hdtext(ts) == "mut" then cs_pparam(cs_hdtext(cs_drop1(ts)), 3, cs_drop1(cs_drop1(ts))) else cs_pparam(cs_hdtext(ts), 0, cs_drop1(ts))
fn cs_pparam(nm, ct, ts) = if cs_hdtext(ts) == ":" then cs_pparamt(nm, ct, cs_ptype1(cs_drop1(ts))) else cs_pmore(nm, TyAny, ct, ts)
fn cs_pparamt(nm, ct, r) = cs_pmore(nm, r.node, ct, r.rest)
fn cs_pmore(nm, ty, ct, ts) = if cs_hdtext(ts) == "," then cs_pmcons(nm, ty, ct, cs_pparams(cs_drop1(ts))) else cs_pmend(nm, ty, ct, cs_skiprp(ts))
fn cs_pmcons(nm, ty, ct, rr) = {items: if ct != 1 then Cons(nm, rr.items) else rr.items, tys: Cons(ty, rr.tys), plist: Cons({cf: ct, pn: nm, pt: ty}, rr.plist), rest: rr.rest}
fn cs_pmend(nm, ty, ct, rest) = {items: if ct != 1 then Cons(nm, Nil) else Nil, tys: Cons(ty, Nil), plist: Cons({cf: ct, pn: nm, pt: ty}, Nil), rest: rest}
fn cs_peffitems(ts) = if cs_hdtext(ts) == "}" then {items: Nil, rest: cs_drop1(ts)} else let enm = cs_hdtext(ts) in let t1 = cs_drop1(ts) in if cs_hdtext(t1) == "," then let rr = cs_peffitems(cs_drop1(t1)) in {items: Cons(enm, rr.items), rest: rr.rest} else {items: Cons(enm, Nil), rest: cs_dropkw(t1, "}")}
fn cs_peffrow(ts) = if cs_hdtext(ts) == "/" then (let t1 = cs_drop1(ts) in if cs_hdtext(t1) == "{" then cs_peffitems(cs_drop1(t1)) else {items: Cons(cs_hdtext(t1), Nil), rest: cs_drop1(t1)}) else {items: Nil, rest: ts}
fn cs_pcontracts(ts) = if cs_hdtext(ts) == "requires" then let r = cs_expr(cs_drop1(ts)) in let rr = cs_pcontracts(r.rest) in {reqs: Cons(r.node, rr.reqs), enss: rr.enss, rest: rr.rest} else if cs_hdtext(ts) == "ensures" then let r = cs_expr(cs_drop1(ts)) in let rr = cs_pcontracts(r.rest) in {reqs: rr.reqs, enss: Cons(r.node, rr.enss), rest: rr.rest} else {reqs: Nil, enss: Nil, rest: ts}
fn cs_pret(ts) = if cs_hdtext(ts) == "-" and cs_hdtext(cs_drop1(ts)) == ">" then cs_pret2(cs_ptype1(cs_drop1(cs_drop1(ts)))) else let er = cs_peffrow(ts) in let vc = cs_pcontracts(er.rest) in {ty: TyAny, fromp: "", effs: er.items, reqs: vc.reqs, enss: vc.enss, rest: vc.rest}
fn cs_pret2(r) = if cs_hdtext(r.rest) == "from" then let rest2 = cs_drop1(cs_drop1(r.rest)) in let er = cs_peffrow(rest2) in let vc = cs_pcontracts(er.rest) in {ty: r.node, fromp: cs_hdtext(cs_drop1(r.rest)), effs: er.items, reqs: vc.reqs, enss: vc.enss, rest: vc.rest} else let er = cs_peffrow(r.rest) in let vc = cs_pcontracts(er.rest) in {ty: r.node, fromp: "", effs: er.items, reqs: vc.reqs, enss: vc.enss, rest: vc.rest}
fn cs_isany(t) = match t
    TyAny => 1
    _     => 0
fn cs_anyann(tys) = match tys
    Nil        => 0
    Cons(h, t) => if cs_isany(h) == 0 then 1 else cs_anyann(t)
fn cs_ganyct(pl) = match pl
    Nil        => 0
    Cons(p, r) => if p.cf == 1 then 1 else cs_ganyct(r)
fn cs_anyownp(pl) = match pl
    Nil        => 0
    Cons(p, r) => if p.cf >= 2 then 1 else cs_anyownp(r)
fn cs_mksig(nm, ps, rty) = if cs_ganyct(ps.plist) == 1 then GSig(nm, ps.plist, rty) else if cs_anyann(ps.tys) == 1 or cs_isany(rty) == 0 then Sig(nm, ps.items, ps.tys, rty) else Nil
fn cs_mkosig(nm, pubf, freef, pl, rty, fromp) = if pubf == 1 or freef > 0 or cs_anyownp(pl) == 1 or fromp != "" then OSig(nm, pubf, freef, pl, rty, fromp) else Nil
fn cs_mkksig(nm, effs) = if cs_isnil(effs) == 0 then KEffSig(nm, effs) else Nil
fn cs_mkvsig(nm, ps, reqs, enss) = if cs_isnil(reqs) == 0 or cs_isnil(enss) == 0 then VContractSig(nm, ps, reqs, enss) else Nil
fn cs_pfnp(ts, pubf, freef) = let nm = cs_hdtext(ts) in let ps = cs_pparams(cs_dropkw(cs_drop1(ts), "(")) in let rt = cs_pret(ps.rest) in let b = cs_expr(cs_dropkw(rt.rest, "=")) in {node: Fn(nm, ps.items, b.node), sg: cs_mksig(nm, ps, rt.ty), osg: cs_mkosig(nm, pubf, freef, ps.plist, rt.ty, rt.fromp), ksg: cs_mkksig(nm, rt.effs), vsg: cs_mkvsig(nm, ps.items, rt.reqs, rt.enss), rest: b.rest}
fn cs_pfn(ts) = cs_pfnp(ts, 0, 0)

fn cs_ptype(ts) = let nm = cs_hdtext(ts) in let rest = cs_dropkw(cs_drop1(ts), "=") in if cs_hdtext(rest) == "record" then cs_precordty(nm, cs_drop1(rest)) else cs_penumty(nm, cs_dropkw(rest, "enum"))
fn cs_penumty(nm, ts) = let vs = cs_pvariants(ts) in {node: TypeS(nm, "enum", vs.items), inv: Nil, rest: vs.rest}
fn cs_pvariants(ts) = cs_pvariant(cs_hdtext(ts), cs_drop1(ts))
fn cs_pvariant(tag, ts) = if cs_hdtext(ts) == "(" then let a = cs_ptypes(cs_drop1(ts)) in cs_pvariantend(tag, cs_len(a.items), a.rest) else cs_pvariantend(tag, 0, ts)
fn cs_pvariantend(tag, ar, ts) = if cs_hdtext(ts) == "|" then let rr = cs_pvariants(cs_drop1(ts)) in {items: Cons({tag: tag, ar: ar}, rr.items), rest: rr.rest} else {items: Cons({tag: tag, ar: ar}, Nil), rest: ts}
fn cs_precordty(nm, ts) = let fs = cs_pfields(ts) in if cs_hdtext(fs.rest) == "invariant" then let iv = cs_expr(cs_drop1(fs.rest)) in {node: TypeS(nm, "record", fs.items), inv: VTypeInvariant(nm, fs.items, iv.node), rest: iv.rest} else {node: TypeS(nm, "record", fs.items), inv: Nil, rest: fs.rest}
fn cs_pfields(ts) = let fnm = cs_hdtext(ts) in let r = cs_ptype1(cs_dropkw(cs_drop1(ts), ":")) in if cs_hdtext(r.rest) == "," then let rr = cs_pfields(cs_drop1(r.rest)) in {items: Cons({fname: fnm, fty: r.node}, rr.items), rest: rr.rest} else {items: Cons({fname: fnm, fty: r.node}, Nil), rest: r.rest}

fn cs_tdeclname(nd) = match nd
    TypeS(nm, k, items) => nm
    _                   => ""
fn cs_progtype(r) = cs_pprogfn2(r.inv, Cons(r.node, cs_pprog(r.rest)))
fn cs_progtyped(kind, r) = Cons(OType(cs_tdeclname(r.node), kind), cs_pprogfn2(r.inv, Cons(r.node, cs_pprog(r.rest))))
fn cs_plaw(t) = let nm = cs_hdtext(t) in let ps = cs_pparams(cs_dropkw(cs_drop1(t), "(")) in let rt = cs_pret(ps.rest) in let b = cs_expr(cs_dropkw(rt.rest, "=")) in {law: VLawDecl(nm, ps.items, b.node), sg: cs_mksig("law_" + nm, ps, TyName("int")), fnnode: Fn("law_" + nm, ps.items, b.node), rest: b.rest}
fn cs_proglaw(r) = Cons(r.law, cs_pprogfn2(r.sg, Cons(r.fnnode, cs_pprog(r.rest))))
fn cs_peffop(ts) = let opnm = cs_hdtext(cs_drop1(ts)) in let ps = cs_pparams(cs_dropkw(cs_drop1(cs_drop1(ts)), "(")) in let rt = cs_pret(ps.rest) in {op: {op: opnm, ps: ps.items, pt: ps.tys, rt: rt.ty}, rest: cs_dropkw(rt.rest, ";")}
fn cs_peffops(ts) = if cs_hdtext(ts) == "fn" then let r = cs_peffop(ts) in let rr = cs_peffops(r.rest) in {items: Cons(r.op, rr.items), rest: rr.rest} else {items: Nil, rest: ts}
fn cs_peffect(t) = let enm = cs_hdtext(t) in let ops = cs_peffops(cs_dropkw(cs_drop1(t), "{")) in {node: KEffectDecl(enm, ops.items), rest: cs_dropkw(ops.rest, "}")}
fn cs_pcapat(t) = let t1 = cs_drop1(t) in let er = if cs_hdtext(t1) == "{" then cs_peffitems(cs_drop1(t1)) else if cs_hdtext(t1) == "(" then let nm = cs_hdtext(cs_drop1(t1)) in {items: Cons(nm, Nil), rest: cs_skiprp(cs_drop1(cs_drop1(t1)))} else {items: Cons(cs_hdtext(t1), Nil), rest: cs_drop1(t1)} in Cons(KCapGrant(er.items), cs_pprog(er.rest))
fn cs_progfree(ts) = if cs_hdtext(ts) == "pub" then cs_pprogfn(cs_pfnp(cs_drop1(cs_drop1(ts)), 1, 1)) else cs_pprogfn(cs_pfnp(cs_drop1(ts), 0, 1))
fn cs_progat(t) = if cs_hdtext(t) == "freestanding" then cs_progfree(cs_drop1(t)) else if cs_hdtext(t) == "gc" then cs_progtyped("gc", cs_ptype(cs_drop1(cs_drop1(t)))) else if cs_hdtext(t) == "capability" or cs_hdtext(t) == "grant" then cs_pcapat(t) else cs_pprog(cs_drop1(t))
fn cs_progpub(t) = if cs_hdtext(t) == "total" and cs_hdtext(cs_drop1(t)) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(cs_drop1(t)), 1, 2)) else if cs_hdtext(t) == "llm" and cs_hdtext(cs_drop1(t)) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(cs_drop1(t)), 1, 4)) else if cs_hdtext(t) == "effect" then let r = cs_peffect(cs_drop1(t)) in Cons(r.node, cs_pprog(r.rest)) else if cs_hdtext(t) == "law" then cs_proglaw(cs_plaw(cs_drop1(t))) else cs_pprogfn(cs_pfnp(cs_drop1(t), 1, 0))
fn cs_pprog(ts) = match ts
    Nil        => Nil
    Cons(h, t) => if h.text == "fn" then cs_pprogfn(cs_pfn(cs_drop1(ts))) else if h.text == "pub" and (cs_hdtext(t) == "fn" or cs_hdtext(t) == "total" or cs_hdtext(t) == "llm" or cs_hdtext(t) == "effect" or cs_hdtext(t) == "law") then cs_progpub(t) else if h.text == "total" and cs_hdtext(t) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(t), 0, 2)) else if h.text == "llm" and cs_hdtext(t) == "fn" then cs_pprogfn(cs_pfnp(cs_drop1(t), 0, 4)) else if h.text == "effect" then let r = cs_peffect(t) in Cons(r.node, cs_pprog(r.rest)) else if h.text == "law" then cs_proglaw(cs_plaw(t)) else if h.text == "@" then cs_progat(t) else if h.text == "resource" and cs_hdtext(t) == "type" then cs_progtyped("resource", cs_ptype(cs_drop1(t))) else if h.text == "type" then cs_progtype(cs_ptype(cs_drop1(ts))) else if h.text == "print" then let r = cs_expr(cs_drop1(ts)) in Cons(Print(r.node), cs_pprog(r.rest)) else let r = cs_expr(ts) in Cons(ExprS(r.node), cs_pprog(r.rest))
fn cs_pprogfn(r) = cs_pprogfn2(r.vsg, cs_pprogfn2(r.ksg, cs_pprogfn2(r.osg, cs_pprogfn2(r.sg, Cons(r.node, cs_pprog(r.rest))))))
fn cs_pprogfn2(sg, rest) = match sg
    Nil => rest
    _   => Cons(sg, rest)
fn cs_parse(src) = cs_pprog(cs_lex(src, 0))

## --- symbol table extraction ---
fn cs_tystr(ty) = match ty
    TyAny           => "any"
    TyName(nm)      => nm
    TyList(inner)   => "[" + cs_tystr(inner) + "]"
    TyApply(c, arg) => c + "[" + cs_tystr(arg) + "]"
    _               => "any"
fn cs_variants_str(vs) = match vs
    Nil        => ""
    Cons(h, t) => let s = h.tag + "(" + str(h.ar) + ")" in if cs_isnil(t) == 1 then s else s + " | " + cs_variants_str(t)
fn cs_fields_str(fs) = match fs
    Nil        => ""
    Cons(h, t) => let s = h.fname + ": " + cs_tystr(h.fty) in if cs_isnil(t) == 1 then s else s + ", " + cs_fields_str(t)
fn cs_params_str(ps) = cs_joinsep(ps, ", ")
fn cs_symbols(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_sym1(h, cs_symbols(t))
fn cs_sym1(s0, rest) = match s0
    TypeS(nm, k, items) => Cons({name: nm, kind: k, sig: if k == "enum" then cs_variants_str(items) else "{" + cs_fields_str(items) + "}"}, rest)
    Fn(nm, ps, body)    => Cons({name: nm, kind: "fn", sig: "fn(" + cs_params_str(ps) + ")"}, rest)
    _                   => rest

## --- AI-first fix-it suggestion helper (prefix / substring / length similarity) ---
fn cs_common_prefix(a, b, i, n) = if i >= n then i else if at(a, i) == at(b, i) then cs_common_prefix(a, b, i + 1, n) else i
fn cs_min(a, b) = if a < b then a else b
fn cs_abs(x) = if x < 0 then 0 - x else x
fn cs_sim(a, b) = let cp = cs_common_prefix(a, b, 0, cs_min(count(a), count(b))) in (cp * 4) - cs_abs(count(a) - count(b))
fn cs_best_cand(target, cands, best, best_score) = match cands
    Nil        => best
    Cons(h, t) => let sc = cs_sim(target, h) in if best == "" or sc > best_score then cs_best_cand(target, t, h, sc) else cs_best_cand(target, t, best, best_score)
fn cs_ctor_names(ctors) = match ctors
    Nil        => Nil
    Cons(h, t) => Cons(h.tag, cs_ctor_names(t))
fn cs_field_names(fs) = match fs
    Nil        => Nil
    Cons(h, t) => Cons(h.fname, cs_field_names(t))

## --- non-aborting multi-diagnostic collector (F1, F2, C3, C1/C2/M1/M2) ---
fn cs_tanydecl(prog) = match prog
    Nil        => 0
    Cons(h, t) => cs_tanydecl2(h, t)
fn cs_tanydecl2(h, t) = match h
    TypeS(nm, k, items) => 1
    _                   => cs_tanydecl(t)
fn cs_townerize(nm, items) = match items
    Nil        => Nil
    Cons(h, t) => Cons({tag: h.tag, ar: h.ar, en: nm}, cs_townerize(nm, t))
fn cs_tcollectc(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_tcollectc2(h, t)
fn cs_tcollectc2(h, t) = match h
    TypeS(nm, k, items) => if k == "enum" then cs_app(cs_townerize(nm, items), cs_tcollectc(t)) else cs_tcollectc(t)
    _                   => cs_tcollectc(t)
fn cs_tcollectr(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_tcollectr2(h, t)
fn cs_tcollectr2(h, t) = match h
    TypeS(nm, k, items) => if k == "record" then Cons({rname: nm, fields: items}, cs_tcollectr(t)) else cs_tcollectr(t)
    _                   => cs_tcollectr(t)
fn cs_tcollects(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_tcollects2(h, t)
fn cs_tcollects2(h, t) = match h
    Sig(nm, ps, ts, rt) => Cons({fname: nm, pn: ps, pt: ts, rt: rt}, cs_tcollects(t))
    _                   => cs_tcollects(t)
fn cs_tcollectg(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_tcollectg2(h, t)
fn cs_tcollectg2(h, t) = match h
    GSig(nm, pl, rt) => Cons({fname: nm, params: pl, rt: rt}, cs_tcollectg(t))
    _                => cs_tcollectg(t)
fn cs_buildft(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_buildft2(h, cs_buildft(t))
fn cs_buildft2(h, rest) = match h
    Fn(nm, ps, body) => Cons(h, rest)
    _                => rest
fn cs_tcollect(prog) = {ctors: cs_tcollectc(prog), recs: cs_tcollectr(prog), sigs: cs_tcollects(prog), gsigs: cs_tcollectg(prog), decl: cs_tanydecl(prog), ft: cs_buildft(prog)}

fn cs_clookup(tag, ctors) = match ctors
    Nil        => Nil
    Cons(h, t) => if h.tag == tag then Cons(h, Nil) else cs_clookup(tag, t)
fn cs_rlookup(nm, recs) = match recs
    Nil        => Nil
    Cons(h, t) => if h.rname == nm then Cons(h, Nil) else cs_rlookup(nm, t)
fn cs_hasfield(fnm, fs) = match fs
    Nil        => 0
    Cons(h, t) => if h.fname == fnm then 1 else cs_hasfield(fnm, t)
fn cs_siglookup(nm, sigs) = match sigs
    Nil        => Nil
    Cons(h, t) => if h.fname == nm then Cons(h, Nil) else cs_siglookup(nm, t)
fn cs_gsiglookup(nm, gsigs) = match gsigs
    Nil        => Nil
    Cons(h, t) => if h.fname == nm then Cons(h, Nil) else cs_gsiglookup(nm, t)
fn cs_fnname(f0) = match f0
    Fn(nm, ps, body) => nm
    _                => ""
fn cs_fnlookup(nm, ft) = match ft
    Nil        => Nil
    Cons(h, t) => if cs_fnname(h) == nm then Cons(h, Nil) else cs_fnlookup(nm, t)

fn cs_exprty(e, tt) = match e
    Num(n)          => "int"
    Str(v)          => "str"
    RecT(tn, items) => tn
    Call(nm, args)  => if cs_isupper(at(nm, 0)) then cs_ctorty(cs_clookup(nm, tt.ctors)) else ""
    Var(nm)         => if cs_isupper(at(nm, 0)) then cs_ctorty(cs_clookup(nm, tt.ctors)) else ""
    _               => ""
fn cs_ctorty(m) = match m
    Nil        => ""
    Cons(h, t) => h.en

fn cs_mkdiag(code, phase, msg, fix) = {code: code, phase: phase, message: msg, fixit: fix}

fn cs_chk_ctor(tag, ar, tt) = if tt.decl == 0 then Nil else cs_chk_ctor2(tag, ar, cs_clookup(tag, tt.ctors), tt)
fn cs_chk_ctor2(tag, ar, m, tt) = match m
    Nil        => let cand = cs_best_cand(tag, cs_ctor_names(tt.ctors), "", 0 - 999) in Cons(cs_mkdiag("T1001", "typecheck", "type error: constructor '" + tag + "' is not declared in any enum", if cand == "" then "declare '" + tag + "' in an enum type" else "replace '" + tag + "' with declared constructor '" + cand + "'"), Nil)
    Cons(c, r) => if c.ar == ar then Nil else Cons(cs_mkdiag("T1002", "typecheck", "type error: constructor '" + tag + "' expects " + str(c.ar) + " arguments, got " + str(ar), "pass " + str(c.ar) + " arguments to '" + tag + "'"), Nil)

fn cs_chk_rect(tn, items, tt) = if tt.decl == 0 then cs_chk_reclist(items, tt) else cs_chk_rect2(tn, items, cs_rlookup(tn, tt.recs), tt)
fn cs_chk_rect2(tn, items, m, tt) = match m
    Nil        => Cons(cs_mkdiag("T1003", "typecheck", "type error: record type '" + tn + "' is not declared", "declare 'type " + tn + " = record ...'"), cs_chk_reclist(items, tt))
    Cons(d, r) => cs_app(cs_chk_rfields(tn, items, d.fields), cs_chk_reclist(items, tt))
fn cs_chk_rfields(tn, items, declfs) = match items
    Nil        => Nil
    Cons(h, t) => if cs_hasfield(h.key, declfs) == 1 then cs_chk_rfields(tn, t, declfs) else let cand = cs_best_cand(h.key, cs_field_names(declfs), "", 0 - 999) in Cons(cs_mkdiag("T1003", "typecheck", "type error: record '" + tn + "' has no field '" + h.key + "'", if cand == "" then "remove unknown field '" + h.key + "'" else "replace unknown field '" + h.key + "' on '" + tn + "' with '" + cand + "'"), cs_chk_rfields(tn, t, declfs))

fn cs_chk_arg1(fnm, idx, pn, pt, a, tt) = match pt
    TyName(exp) => let got = cs_exprty(a, tt) in if got == "" or got == exp then Nil else Cons(cs_mkdiag("T2001", "typecheck", "type error: argument " + str(idx) + " of '" + fnm + "' has type " + got + " but parameter '" + pn + "' expects " + exp, "change argument " + str(idx) + " of '" + fnm + "' (parameter '" + pn + "') to " + exp), Nil)
    _           => Nil
fn cs_chk_args(fnm, idx, pns, pts, args, tt) = match args
    Nil         => Nil
    Cons(a, ar) => cs_chk_args2(fnm, idx, pns, pts, a, ar, tt)
fn cs_chk_args2(fnm, idx, pns, pts, a, ar, tt) = match pns
    Nil          => Nil
    Cons(pn, pr) => cs_chk_args3(fnm, idx, pn, pr, pts, a, ar, tt)
fn cs_chk_args3(fnm, idx, pn, pr, pts, a, ar, tt) = match pts
    Nil          => Nil
    Cons(pt, tr) => cs_app(cs_chk_arg1(fnm, idx, pn, pt, a, tt), cs_chk_args(fnm, idx + 1, pr, tr, ar, tt))

fn cs_tyarg(e) = match e
    Var(nm) => nm
    _       => ""
fn cs_glookup(nm, env) = match env
    Nil        => nm
    Cons(h, t) => if h.k == nm then h.v else cs_glookup(nm, t)
fn cs_tsubst(ty, env) = match ty
    TyName(nm) => TyName(cs_glookup(nm, env))
    _          => ty
fn cs_chk_gparams(fnm, idx, pl, args, env, tt) = match pl
    Nil         => Nil
    Cons(p, pr) => cs_chk_gparams2(fnm, idx, p, pr, args, env, tt)
fn cs_chk_gparams2(fnm, idx, p, pr, args, env, tt) = match args
    Nil         => Nil
    Cons(a, ar) => if p.cf == 1 then let tnm = cs_tyarg(a) in (if tnm == "" then Cons(cs_mkdiag("T3001", "typecheck", "type error: comptime parameter '" + p.pn + "' of '" + fnm + "' expects a type name", "pass a type name such as 'int' or 'str'"), cs_chk_gparams(fnm, idx + 1, pr, ar, env, tt)) else cs_chk_gparams(fnm, idx + 1, pr, ar, Cons({k: p.pn, v: tnm}, env), tt)) else cs_app(cs_chk_arg1(fnm, idx, p.pn, cs_tsubst(p.pt, env), a, tt), cs_chk_gparams(fnm, idx + 1, pr, ar, env, tt))

fn cs_chk_callsig(nm, args, tt) = cs_chk_callsig2(nm, args, cs_gsiglookup(nm, tt.gsigs), tt)
fn cs_chk_callsig2(nm, args, gm, tt) = match gm
    Cons(g, gr) => cs_chk_gparams(nm, 1, g.params, args, Nil, tt)
    Nil         => cs_chk_callsig3(nm, args, cs_siglookup(nm, tt.sigs), tt)
fn cs_chk_callsig3(nm, args, sm, tt) = match sm
    Cons(sg, sr) => cs_chk_args(nm, 1, sg.pn, sg.pt, args, tt)
    Nil          => Nil

fn cs_chk_ret(nm, body, tt) = cs_chk_ret2(nm, body, cs_siglookup(nm, tt.sigs), tt)
fn cs_chk_ret2(nm, body, sm, tt) = match sm
    Nil          => Nil
    Cons(sg, sr) => cs_chk_ret3(nm, body, sg.rt, tt)
fn cs_chk_ret3(nm, body, rt, tt) = match rt
    TyName(exp) => let got = cs_exprty(body, tt) in if got == "" or got == exp then Nil else Cons(cs_mkdiag("T2002", "typecheck", "type error: function '" + nm + "' returns " + got + " but is declared to return " + exp, "change return type of '" + nm + "' to " + got + " or return a " + exp + " value"), Nil)
    _           => Nil

fn cs_chk_quote(e, tt) = match e
    Bin(op, a, b)   => cs_app(cs_chk_quote(a, tt), cs_chk_quote(b, tt))
    If(c, t, e2)    => cs_app(cs_chk_quote(c, tt), cs_app(cs_chk_quote(t, tt), cs_chk_quote(e2, tt)))
    LetIn(nm, v, b) => cs_app(cs_chk_quote(v, tt), cs_chk_quote(b, tt))
    Call(nm, args)  => if nm == "unquote" then (if cs_len(args) != 1 then Cons(cs_mkdiag("C1001", "comptime", "comptime error: 'unquote' expects exactly 1 argument", "pass a single expression to 'unquote(<expr>)'"), Nil) else cs_chk_expr(cs_asthead(args), tt)) else cs_chk_qlist(args, tt)
    _               => Nil
fn cs_chk_qlist(xs, tt) = match xs
    Nil        => Nil
    Cons(h, t) => cs_app(cs_chk_quote(h, tt), cs_chk_qlist(t, tt))

fn cs_asthead(xs) = match xs
    Nil        => Num(0)
    Cons(h, t) => h

fn cs_chk_expr(e, tt) = match e
    Var(nm)         => if cs_isupper(at(nm, 0)) then cs_chk_ctor(nm, 0, tt) else Nil
    Bin(op, a, b)   => cs_app(cs_chk_expr(a, tt), cs_chk_expr(b, tt))
    If(c, t, e2)    => cs_app(cs_chk_expr(c, tt), cs_app(cs_chk_expr(t, tt), cs_chk_expr(e2, tt)))
    LetIn(nm, v, b) => cs_app(cs_chk_expr(v, tt), cs_chk_expr(b, tt))
    Call(nm, args)  => if nm == "unquote" and cs_isnil(cs_fnlookup("unquote", tt.ft)) == 1 then Cons(cs_mkdiag("C1001", "comptime", "comptime error: 'unquote' may only appear inside 'quote(...)'", "wrap the expression in 'quote(...)' or remove 'unquote'"), cs_chk_elist(args, tt)) else cs_app(if cs_isupper(at(nm, 0)) then cs_chk_ctor(nm, cs_len(args), tt) else cs_chk_callsig(nm, args, tt), cs_chk_elist(args, tt))
    Rec(items)      => cs_chk_reclist(items, tt)
    RecT(tn, items) => cs_chk_rect(tn, items, tt)
    Field(o, nm)    => cs_chk_expr(o, tt)
    Match(sc, arms) => cs_app(cs_chk_expr(sc, tt), cs_chk_arms(arms, tt))
    CT(inner)       => cs_app(cs_chk_expr(inner, tt), cs_chk_ct(inner, tt))
    Quote(inner)    => cs_chk_quote(inner, tt)
    Splice(inner)   => cs_app(cs_chk_expr(inner, tt), cs_chk_splice(inner, tt))
    _               => Nil
fn cs_chk_elist(xs, tt) = match xs
    Nil        => Nil
    Cons(h, t) => cs_app(cs_chk_expr(h, tt), cs_chk_elist(t, tt))
fn cs_chk_reclist(xs, tt) = match xs
    Nil        => Nil
    Cons(h, t) => cs_app(cs_chk_expr(h.val, tt), cs_chk_reclist(t, tt))
fn cs_chk_arms(xs, tt) = match xs
    Nil        => Nil
    Cons(h, t) => cs_app(cs_chk_pat(h.pat, tt), cs_app(cs_chk_expr(h.body, tt), cs_chk_arms(t, tt)))
fn cs_chk_pat(p, tt) = match p
    PCons(tag, ps) => cs_chk_ctor(tag, cs_len(ps), tt)
    _              => Nil

## --- safe non-aborting comptime & AST evaluator for `caas` ---
fn cs_cv_ok(v) = {ok: 1, v: v, err: "", fix: ""}
fn cs_cv_err(msg, fix) = {ok: 0, v: {kind: "int", i: 0, s: "", items: Nil}, err: msg, fix: fix}
fn cs_cv_int(n) = {kind: "int", i: n, s: "", items: Nil}
fn cs_cv_str(s) = {kind: "str", i: 0, s: s, items: Nil}
fn cs_cv_ctor(tag, xs) = {kind: "ctor", i: 0, s: tag, items: xs}
fn cs_cv_rec(xs) = {kind: "rec", i: 0, s: "", items: xs}

fn cs_cveq(a, b) = if a.kind != b.kind then 0 else if a.kind == "int" then a.i == b.i else if a.kind == "str" then a.s == b.s else if a.kind == "ctor" then (if a.s != b.s then 0 else cs_cveqlist(a.items, b.items)) else 0
fn cs_cveqlist(xs, ys) = match xs
    Nil          => cs_isnil(ys)
    Cons(xh, xt) => cs_cveqlist2(xh, xt, ys)
fn cs_cveqlist2(xh, xt, ys) = match ys
    Nil          => 0
    Cons(yh, yt) => if cs_cveq(xh, yh) == 1 then cs_cveqlist(xt, yt) else 0

fn cs_envlookup(nm, env) = match env
    Nil        => {ok: 0, v: cs_cv_int(0)}
    Cons(h, t) => if h.k == nm then {ok: 1, v: h.v} else cs_envlookup(nm, t)
fn cs_qvar(nm, qenv) = match qenv
    Nil        => nm
    Cons(h, t) => if h.k == nm then h.v else cs_qvar(nm, t)

fn cs_isvalidbinop(op) = op == "+" or op == "-" or op == "*" or op == "/" or op == "%" or op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or"
fn cs_cvhd(xs) = match xs
    Nil        => cs_cv_int(0)
    Cons(h, t) => h
fn cs_cvtl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t

fn cs_unreify(cv) = if cv.kind != "ctor" then {ok: 0, node: Num(0), err: "comptime error: splice expects an AST constructor value (Num, Str, Var, Bin, If, LetIn, Call)", fix: "pass a quoted or constructed AST value to 'splice(...)'"} else cs_unreify_ctor(cv.s, cv.items)
fn cs_unreify_ctor(tag, xs) = if tag == "Num" and cs_len(xs) == 1 and (cs_cvhd(xs)).kind == "int" then {ok: 1, node: Num((cs_cvhd(xs)).i), err: "", fix: ""} else if tag == "Str" and cs_len(xs) == 1 and (cs_cvhd(xs)).kind == "str" then {ok: 1, node: Str((cs_cvhd(xs)).s), err: "", fix: ""} else if tag == "Var" and cs_len(xs) == 1 and (cs_cvhd(xs)).kind == "str" and count((cs_cvhd(xs)).s) > 0 then {ok: 1, node: Var((cs_cvhd(xs)).s), err: "", fix: ""} else if tag == "Bin" and cs_len(xs) == 3 and (cs_cvhd(xs)).kind == "str" and cs_isvalidbinop((cs_cvhd(xs)).s) then let l = cs_unreify(cs_cvhd(cs_cvtl(xs))) in (if l.ok == 0 then l else let r = cs_unreify(cs_cvhd(cs_cvtl(cs_cvtl(xs)))) in if r.ok == 0 then r else {ok: 1, node: Bin((cs_cvhd(xs)).s, l.node, r.node), err: "", fix: ""}) else if tag == "If" and cs_len(xs) == 3 then let c = cs_unreify(cs_cvhd(xs)) in (if c.ok == 0 then c else let t = cs_unreify(cs_cvhd(cs_cvtl(xs))) in if t.ok == 0 then t else let e2 = cs_unreify(cs_cvhd(cs_cvtl(cs_cvtl(xs)))) in if e2.ok == 0 then e2 else {ok: 1, node: If(c.node, t.node, e2.node), err: "", fix: ""}) else if tag == "LetIn" and cs_len(xs) == 3 and (cs_cvhd(xs)).kind == "str" and count((cs_cvhd(xs)).s) > 0 then let v = cs_unreify(cs_cvhd(cs_cvtl(xs))) in (if v.ok == 0 then v else let b = cs_unreify(cs_cvhd(cs_cvtl(cs_cvtl(xs)))) in if b.ok == 0 then b else {ok: 1, node: LetIn((cs_cvhd(xs)).s, v.node, b.node), err: "", fix: ""}) else if tag == "Call" and cs_len(xs) == 2 and (cs_cvhd(xs)).kind == "str" and count((cs_cvhd(xs)).s) > 0 then let rl = cs_unreify_list(cs_cvhd(cs_cvtl(xs))) in (if rl.ok == 0 then {ok: 0, node: Num(0), err: rl.err, fix: rl.fix} else {ok: 1, node: Call((cs_cvhd(xs)).s, rl.items), err: "", fix: ""}) else {ok: 0, node: Num(0), err: "comptime error: invalid AST node '" + tag + "' in splice", fix: "use valid AST constructors (Num, Str, Var, Bin, If, LetIn, Call) and operators"}
fn cs_unreify_list(cv) = if cv.kind != "ctor" then {ok: 0, items: Nil, err: "comptime error: Call arguments in splice must be a Cons/Nil list", fix: "build Call argument lists with Cons and Nil"} else if cv.s == "Nil" and cs_len(cv.items) == 0 then {ok: 1, items: Nil, err: "", fix: ""} else if cv.s == "Cons" and cs_len(cv.items) == 2 then let h = cs_unreify(cs_cvhd(cv.items)) in (if h.ok == 0 then {ok: 0, items: Nil, err: h.err, fix: h.fix} else let t = cs_unreify_list(cs_cvhd(cs_cvtl(cv.items))) in if t.ok == 0 then t else {ok: 1, items: Cons(h.node, t.items), err: "", fix: ""}) else {ok: 0, items: Nil, err: "comptime error: Call arguments in splice must be a Cons/Nil list", fix: "build Call argument lists with Cons and Nil"}

fn cs_qunquote(cv) = if cv.kind == "int" then cs_cv_ok(cs_cv_ctor("Num", Cons(cv, Nil))) else if cv.kind == "str" then cs_cv_ok(cs_cv_ctor("Str", Cons(cv, Nil))) else if cv.kind == "ctor" then cs_cv_ok(cv) else cs_cv_err("comptime error: unquote expects an AST, int, or str value", "pass an AST constructor, int, or str to 'unquote'")

fn cs_quasiquote(e, qenv, env, ft, cd) = match e
    Num(n)          => cs_cv_ok(cs_cv_ctor("Num", Cons(cs_cv_int(n), Nil)))
    Str(v)          => cs_cv_ok(cs_cv_ctor("Str", Cons(cs_cv_str(v), Nil)))
    Var(nm)         => cs_cv_ok(cs_cv_ctor("Var", Cons(cs_cv_str(cs_qvar(nm, qenv)), Nil)))
    Bin(op, a, b)   => let ra = cs_quasiquote(a, qenv, env, ft, cd) in if ra.ok == 0 then ra else let rb = cs_quasiquote(b, qenv, env, ft, cd) in if rb.ok == 0 then rb else cs_cv_ok(cs_cv_ctor("Bin", Cons(cs_cv_str(op), Cons(ra.v, Cons(rb.v, Nil)))))
    If(c, t, e2)    => let rc = cs_quasiquote(c, qenv, env, ft, cd) in if rc.ok == 0 then rc else let rt = cs_quasiquote(t, qenv, env, ft, cd) in if rt.ok == 0 then rt else let re = cs_quasiquote(e2, qenv, env, ft, cd) in if re.ok == 0 then re else cs_cv_ok(cs_cv_ctor("If", Cons(rc.v, Cons(rt.v, Cons(re.v, Nil)))))
    LetIn(nm, v, b) => let rv = cs_quasiquote(v, qenv, env, ft, cd) in if rv.ok == 0 then rv else let hnm = "_hyg_" + str(cd + 1) + "_" + nm in let rb = cs_quasiquote(b, Cons({k: nm, v: hnm}, qenv), env, ft, cd + 1) in if rb.ok == 0 then rb else cs_cv_ok(cs_cv_ctor("LetIn", Cons(cs_cv_str(hnm), Cons(rv.v, Cons(rb.v, Nil)))))
    Call(nm, args)  => if nm == "unquote" then (if cs_len(args) != 1 then cs_cv_err("comptime error: 'unquote' expects exactly 1 argument", "pass a single argument to 'unquote(<expr>)'") else let r = cs_ceval(cs_asthead(args), env, ft, cd) in if r.ok == 0 then r else cs_qunquote(r.v)) else let rl = cs_qqlist(args, qenv, env, ft, cd) in if rl.ok == 0 then rl else cs_cv_ok(cs_cv_ctor("Call", Cons(cs_cv_str(nm), Cons(rl.v, Nil))))
    _               => cs_cv_err("comptime error: unsupported AST node in quote", "use supported expressions inside 'quote(...)'")
fn cs_qqlist(xs, qenv, env, ft, cd) = match xs
    Nil        => cs_cv_ok(cs_cv_ctor("Nil", Nil))
    Cons(h, t) => let rh = cs_quasiquote(h, qenv, env, ft, cd) in if rh.ok == 0 then rh else let rt = cs_qqlist(t, qenv, env, ft, cd) in if rt.ok == 0 then rt else cs_cv_ok(cs_cv_ctor("Cons", Cons(rh.v, Cons(rt.v, Nil))))

fn cs_cmatch(sv, arms, env, ft, cd) = match arms
    Nil        => cs_cv_err("comptime error: non-exhaustive match at compile time", "add a wildcard '_' arm to match")
    Cons(h, t) => let m = cs_cpat(h.pat, sv, env) in if m.ok == 1 then cs_ceval(h.body, m.env, ft, cd) else cs_cmatch(sv, t, env, ft, cd)
fn cs_cpat(p, sv, env) = match p
    PWild          => {ok: 1, env: env}
    PBind(nm)      => {ok: 1, env: Cons({k: nm, v: sv}, env)}
    PInt(n)        => if sv.kind == "int" and sv.i == n then {ok: 1, env: env} else {ok: 0, env: env}
    PStr(s)        => if sv.kind == "str" and sv.s == s then {ok: 1, env: env} else {ok: 0, env: env}
    PCons(tag, ps) => if sv.kind == "ctor" and sv.s == tag and cs_len(ps) == cs_len(sv.items) then cs_cpatargs(ps, sv.items, env) else {ok: 0, env: env}
fn cs_cpatargs(ps, vs, env) = match ps
    Nil          => {ok: 1, env: env}
    Cons(p, pr)  => cs_cpatargs2(p, pr, vs, env)
fn cs_cpatargs2(p, pr, vs, env) = match vs
    Nil         => {ok: 0, env: env}
    Cons(v, vr) => cs_cpatargs(pr, vr, if p == "_" then env else Cons({k: p, v: v}, env))

fn cs_recfield(items, nm) = match items
    Nil        => cs_cv_err("comptime error: unknown record field '" + nm + "'", "check field name '" + nm + "'")
    Cons(h, t) => if h.key == nm then cs_cv_ok(h.val) else cs_recfield(t, nm)

fn cs_vadd_hops_ft(hs, ft) = match hs
    Nil        => ft
    Cons(h, t) => Cons(Fn(h.op, h.ps, h.body), cs_vadd_hops_ft(t, ft))

fn cs_ceval(e, env, ft, cd) = if cd > 64 then cs_cv_err("comptime error: comptime evaluation exceeded 64 call levels", "ensure comptime recursion has a terminating base case") else cs_ceval1(e, env, ft, cd)
fn cs_ceval1(e, env, ft, cd) = match e
    Num(n)                  => cs_cv_ok(cs_cv_int(n))
    Str(v)                  => cs_cv_ok(cs_cv_str(v))
    Var(nm)                 => let lk = cs_envlookup(nm, env) in if lk.ok == 1 then cs_cv_ok(lk.v) else if cs_isupper(at(nm, 0)) then cs_cv_ok(cs_cv_ctor(nm, Nil)) else cs_cv_err("comptime error: unbound variable '" + nm + "'", "bind '" + nm + "' before use")
    LetIn(nm, v, b)         => let rv = cs_ceval(v, env, ft, cd) in if rv.ok == 0 then rv else cs_ceval(b, Cons({k: nm, v: rv.v}, env), ft, cd)
    VarIn(nm, v, b)         => let rv = cs_ceval(v, env, ft, cd) in if rv.ok == 0 then rv else cs_ceval(b, Cons({k: nm, v: rv.v}, env), ft, cd)
    OwnE(inner)             => cs_ceval(inner, env, ft, cd)
    MutE(inner)             => cs_ceval(inner, env, ft, cd)
    WithHandlerE(en, hs, b) => cs_ceval(b, env, cs_vadd_hops_ft(hs, ft), cd)
    ScopeE(snm, b)          => cs_ceval(b, Cons({k: snm, v: cs_cv_int(1)}, env), ft, cd)
    SpawnE(inner)           => cs_ceval(inner, env, ft, cd)
    If(c, t, e2)            => let rc = cs_ceval(c, env, ft, cd) in if rc.ok == 0 then rc else if rc.v.i != 0 then cs_ceval(t, env, ft, cd) else cs_ceval(e2, env, ft, cd)
    Bin(op, a, b)           => let ra = cs_ceval(a, env, ft, cd) in if ra.ok == 0 then ra else let rb = cs_ceval(b, env, ft, cd) in if rb.ok == 0 then rb else cs_cbin(op, ra.v, rb.v)
    Match(sc, arms)         => let rsc = cs_ceval(sc, env, ft, cd) in if rsc.ok == 0 then rsc else cs_cmatch(rsc.v, arms, env, ft, cd)
    Quote(inner)            => cs_quasiquote(inner, Nil, env, ft, cd)
    Splice(inner)           => let r = cs_ceval(inner, env, ft, cd) in if r.ok == 0 then r else let u = cs_unreify(r.v) in if u.ok == 0 then cs_cv_err(u.err, u.fix) else cs_ceval(u.node, env, ft, cd)
    CT(inner)               => cs_ceval(inner, env, ft, cd)
    Rec(items)              => cs_ceval_rec(items, env, ft, cd)
    RecT(tn, items)         => cs_ceval_rec(items, env, ft, cd)
    Field(o, nm)            => let ro = cs_ceval(o, env, ft, cd) in if ro.ok == 0 then ro else if ro.v.kind == "rec" then cs_recfield(ro.v.items, nm) else cs_cv_err("comptime error: field access on non-record value", "access fields only on record values")
    Call(nm, args)          => if cs_isupper(at(nm, 0)) then let ra = cs_ceval_list(args, env, ft, cd) in (if ra.ok == 0 then cs_cv_err(ra.err, ra.fix) else cs_cv_ok(cs_cv_ctor(nm, ra.vals))) else cs_ccall(nm, args, env, ft, cd)
    _                       => cs_cv_err("comptime error: unsupported expression at compile time", "use pure expressions in comptime")
fn cs_ceval_rec(items, env, ft, cd) = match items
    Nil        => cs_cv_ok(cs_cv_rec(Nil))
    Cons(h, t) => let rv = cs_ceval(h.val, env, ft, cd) in if rv.ok == 0 then rv else let rt = cs_ceval_rec(t, env, ft, cd) in if rt.ok == 0 then rt else cs_cv_ok(cs_cv_rec(Cons({key: h.key, val: rv.v}, rt.v.items)))
fn cs_ceval_list(xs, env, ft, cd) = match xs
    Nil        => {ok: 1, vals: Nil, err: "", fix: ""}
    Cons(h, t) => let rh = cs_ceval(h, env, ft, cd) in if rh.ok == 0 then {ok: 0, vals: Nil, err: rh.err, fix: rh.fix} else let rt = cs_ceval_list(t, env, ft, cd) in if rt.ok == 0 then rt else {ok: 1, vals: Cons(rh.v, rt.vals), err: "", fix: ""}
fn cs_cbin_str(op, x, y) = if op == "+" then cs_cv_ok(cs_cv_str(x + y)) else if op == "<" then cs_cv_ok(cs_cv_int(if x < y then 1 else 0)) else if op == ">" then cs_cv_ok(cs_cv_int(if x > y then 1 else 0)) else if op == "<=" then cs_cv_ok(cs_cv_int(if x <= y then 1 else 0)) else if op == ">=" then cs_cv_ok(cs_cv_int(if x >= y then 1 else 0)) else cs_cv_err("comptime error: unknown string operator '" + op + "'", "use a valid string operator")
fn cs_cbin(op, l, r) = if op == "==" then cs_cv_ok(cs_cv_int(cs_cveq(l, r))) else if op == "!=" then cs_cv_ok(cs_cv_int(if cs_cveq(l, r) == 1 then 0 else 1)) else if l.kind == "str" and r.kind == "str" then cs_cbin_str(op, l.s, r.s) else if l.kind == "int" and r.kind == "int" then cs_cbin_int(op, l.i, r.i) else cs_cv_err("comptime error: type mismatch in operator '" + op + "'", "use matching operand types for '" + op + "'")
fn cs_cbin_int(op, x, y) = if op == "+" then cs_cv_ok(cs_cv_int(x + y)) else if op == "-" then cs_cv_ok(cs_cv_int(x - y)) else if op == "*" then cs_cv_ok(cs_cv_int(x * y)) else if op == "/" then (if y == 0 then cs_cv_err("comptime error: division by zero at compile time", "ensure divisor is non-zero") else cs_cv_ok(cs_cv_int(x / y))) else if op == "%" then (if y == 0 then cs_cv_err("comptime error: modulo by zero at compile time", "ensure modulus is non-zero") else cs_cv_ok(cs_cv_int(x % y))) else if op == "<" then cs_cv_ok(cs_cv_int(x < y)) else if op == ">" then cs_cv_ok(cs_cv_int(x > y)) else if op == "<=" then cs_cv_ok(cs_cv_int(x <= y)) else if op == ">=" then cs_cv_ok(cs_cv_int(x >= y)) else if op == "and" then cs_cv_ok(cs_cv_int(if x != 0 then (if y != 0 then 1 else 0) else 0)) else if op == "or" then cs_cv_ok(cs_cv_int(if x != 0 then 1 else if y != 0 then 1 else 0)) else cs_cv_err("comptime error: unknown operator '" + op + "'", "use a valid operator")

fn cs_cbind(ps, vals, env) = match ps
    Nil         => env
    Cons(p, pt) => cs_cbind2(p, pt, vals, env)
fn cs_cbind2(p, pt, vals, env) = match vals
    Nil         => env
    Cons(v, vt) => cs_cbind(pt, vt, Cons({k: p, v: v}, env))
fn cs_ccall(nm, args, env, ft, cd) = cs_ccall2(nm, cs_fnlookup(nm, ft), args, env, ft, cd)
fn cs_ccall2(nm, mf, args, env, ft, cd) = match mf
    Cons(fn0, rr) => let ra = cs_ceval_list(args, env, ft, cd) in if ra.ok == 0 then cs_cv_err(ra.err, ra.fix) else cs_ccall3(fn0, ra.vals, ft, cd)
    Nil           => if nm == "str" or nm == "count" or nm == "at" or nm == "slice" or nm == "toint" or nm == "ord" then let ra = cs_ceval_list(args, env, ft, cd) in (if ra.ok == 0 then cs_cv_err(ra.err, ra.fix) else cs_cpure(nm, ra.vals)) else cs_cv_err("comptime error: cannot evaluate '" + nm + "' at compile time: not pure", "remove impure call '" + nm + "' from comptime or define pure 'fn " + nm + "'")
fn cs_ccall3(fn0, vals, ft, cd) = match fn0
    Fn(fnm, ps, body) => cs_ceval(body, cs_cbind(ps, vals, Nil), ft, cd + 1)
    _                 => cs_cv_err("comptime error: invalid function", "")
fn cs_cpure(nm, vs) = if nm == "str" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_str(if (cs_cvhd(vs)).kind == "int" then str((cs_cvhd(vs)).i) else (cs_cvhd(vs)).s)) else if nm == "count" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_int(count((cs_cvhd(vs)).s))) else if nm == "toint" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_int(toint((cs_cvhd(vs)).s))) else if nm == "ord" and cs_len(vs) == 1 then cs_cv_ok(cs_cv_int(ord((cs_cvhd(vs)).s))) else if nm == "at" and cs_len(vs) == 2 then cs_cv_ok(cs_cv_str(at((cs_cvhd(vs)).s, (cs_cvhd(cs_cvtl(vs))).i))) else if nm == "slice" and cs_len(vs) == 3 then cs_cv_ok(cs_cv_str(slice((cs_cvhd(vs)).s, (cs_cvhd(cs_cvtl(vs))).i, (cs_cvhd(cs_cvtl(cs_cvtl(vs)))).i))) else cs_cv_err("comptime error: invalid arguments to builtin '" + nm + "'", "check argument types and count for '" + nm + "'")

fn cs_chk_ct(inner, tt) = let r = cs_ceval(inner, Nil, tt.ft, 0) in if r.ok == 1 then Nil else Cons(cs_mkdiag("C1001", "comptime", r.err, r.fix), Nil)
fn cs_chk_splice(inner, tt) = let r = cs_ceval(inner, Nil, tt.ft, 0) in if r.ok == 0 then Cons(cs_mkdiag("C1001", "comptime", r.err, r.fix), Nil) else let u = cs_unreify(r.v) in if u.ok == 0 then Cons(cs_mkdiag("C1001", "comptime", u.err, u.fix), Nil) else cs_chk_expr(u.node, tt)

## --- Phase 3 Track O non-aborting multi-diagnostic checker for `caas` (`O0001`–`O0030`) ---
fn cs_omem(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else cs_omem(x, t)
fn cs_orem(x, xs) = match xs
    Nil        => Nil
    Cons(h, t) => if h == x then cs_orem(x, t) else Cons(h, cs_orem(x, t))
fn cs_ocollects(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_ocollects1(h, cs_ocollects(t))
fn cs_ocollects1(st, rest) = match st
    OSig(nm, pubf, freef, pl, rty, fromp) => Cons({nm: nm, pubf: pubf, freef: freef, pl: pl, rty: rty, fromp: fromp}, rest)
    _                                     => rest
fn cs_osiglookup(nm, osigs) = match osigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else cs_osiglookup(nm, t)
fn cs_obparams(pl) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 0 or p.cf == 3 then Cons(p.pn, cs_obparams(r)) else cs_obparams(r)
fn cs_omvars(pl) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 2 or p.cf == 3 then Cons(p.pn, cs_omvars(r)) else cs_omvars(r)
fn cs_oinit_orgs(ps) = match ps
    Nil        => Nil
    Cons(h, t) => Cons({k: h, v: "param:" + h}, cs_oinit_orgs(t))
fn cs_olookup_org(x, orgs) = match orgs
    Nil        => ""
    Cons(h, t) => if h.k == x then h.v else cs_olookup_org(x, t)
fn cs_ostrip_b(org) = if cs_startswith(org, "borrow:") == 1 then cs_ostrip_b(slice(org, 7, count(org))) else org
fn cs_ois_own(e) = match e
    OwnE(inner)    => 1
    Call(nm, args) => if nm == "move" and cs_len(args) == 1 then 1 else 0
    _              => 0
fn cs_omut_root(e) = match e
    Var(x)        => x
    MutE(inner)   => cs_omut_root(inner)
    Field(o, fld) => cs_omut_root(o)
    _             => ""
fn cs_ois_mut(e) = match e
    MutE(inner) => 1
    _           => 0
fn cs_omentions(x, e) = match e
    Var(nm)         => if nm == x then 1 else 0
    OwnE(inner)     => cs_omentions(x, inner)
    MutE(inner)     => cs_omentions(x, inner)
    Field(o, fld)   => cs_omentions(x, o)
    Bin(op, l, r)   => if cs_omentions(x, l) == 1 then 1 else cs_omentions(x, r)
    If(c, t, e2)    => if cs_omentions(x, c) == 1 then 1 else if cs_omentions(x, t) == 1 then 1 else cs_omentions(x, e2)
    LetIn(nm, v, b) => if cs_omentions(x, v) == 1 then 1 else if nm == x then 0 else cs_omentions(x, b)
    VarIn(nm, v, b) => if cs_omentions(x, v) == 1 then 1 else if nm == x then 0 else cs_omentions(x, b)
    Call(nm, args)  => cs_omentions_l(x, args)
    _               => 0
fn cs_omentions_l(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if cs_omentions(x, h) == 1 then 1 else cs_omentions_l(x, t)
fn cs_ocount_args(x, args) = match args
    Nil        => 0
    Cons(h, t) => cs_omentions(x, h) + cs_ocount_args(x, t)
fn cs_opl_cf(pl) = match pl
    Nil        => 0
    Cons(p, r) => p.cf
fn cs_opl_tl(pl) = match pl
    Nil        => Nil
    Cons(p, r) => r
fn cs_ocollect_muts(args, pl) = match args
    Nil        => Nil
    Cons(a, r) => let rest = cs_ocollect_muts(r, cs_opl_tl(pl)) in if cs_ois_mut(a) == 1 or cs_opl_cf(pl) == 3 then let mr = cs_omut_root(a) in (if mr != "" then Cons(mr, rest) else rest) else rest
fn cs_ochk_conf(fnm, muts, args) = match muts
    Nil         => Nil
    Cons(mx, r) => if cs_ocount_args(mx, args) > 1 then Cons(cs_mkdiag("O0011", "borrow", "borrow error: conflicting borrow of '" + mx + "' in call to '" + fnm + "'", "bind the shared read of '" + mx + "' to a temporary before borrowing 'mut " + mx + "'"), cs_ochk_conf(fnm, r, args)) else cs_ochk_conf(fnm, r, args)
fn cs_ochk_modes(fnm, args, pl, ctx) = match pl
    Nil        => Nil
    Cons(p, r) => if p.cf == 1 then cs_ochk_modes(fnm, args, r, ctx) else cs_ochk_mode1(fnm, args, p, r, ctx)
fn cs_ochk_mode1(fnm, args, p, r, ctx) = match args
    Nil         => Nil
    Cons(a, ar) => let d1 = if p.cf == 2 and cs_ois_own(a) == 0 then Cons(cs_mkdiag("O0012", "ownership", "ownership error: parameter '" + p.pn + "' of '" + fnm + "' takes ownership; mark argument with 'own'", "prefix argument with 'own' at call site"), Nil) else if p.cf == 3 then (let vnm = cs_omut_root(a) in if vnm != "" and cs_omem(vnm, ctx.mvars) == 0 then Cons(cs_mkdiag("O0010", "borrow", "borrow error: cannot pass immutable binding '" + vnm + "' to 'mut' parameter '" + p.pn + "'", "declare 'var " + vnm + "' instead of 'let " + vnm + "'"), Nil) else Nil) else Nil in cs_app(d1, cs_ochk_modes(fnm, ar, r, ctx))
fn cs_ochk_own_tgt(inner, ctx, moved) = match inner
    Var(x) => if cs_omem(x, moved) == 1 then {diags: Cons(cs_mkdiag("O0001", "ownership", "ownership error: use of moved value '" + x + "'", "borrow '" + x + "' instead or call 'clone(" + x + ")'"), Nil), moved: moved, origin: ""} else if cs_omem(x, ctx.bparams) == 1 then {diags: Cons(cs_mkdiag("O0002", "ownership", "ownership error: cannot move out of borrowed parameter '" + x + "'", "change parameter declaration to 'own " + x + "' or call 'clone(" + x + ")'"), Nil), moved: moved, origin: ""} else {diags: Nil, moved: Cons(x, moved), origin: ""}
    _      => cs_ochke(inner, ctx, moved)
fn cs_ochk_mut_tgt(inner, ctx, moved) = match inner
    Var(x) => if cs_omem(x, moved) == 1 then {diags: Cons(cs_mkdiag("O0001", "ownership", "ownership error: use of moved value '" + x + "'", "borrow '" + x + "' instead or call 'clone(" + x + ")'"), Nil), moved: moved, origin: ""} else if cs_omem(x, ctx.mvars) == 0 then {diags: Cons(cs_mkdiag("O0010", "borrow", "borrow error: cannot borrow immutable binding '" + x + "' as 'mut'", "declare 'var " + x + "' instead of 'let " + x + "'"), Nil), moved: moved, origin: ""} else {diags: Nil, moved: moved, origin: "borrow:" + cs_olookup_org(x, ctx.origins)}
    _      => cs_ochke(inner, ctx, moved)
fn cs_octx_bind(ctx, nm, ismut, org) = {fnm: ctx.fnm, pubf: ctx.pubf, freef: ctx.freef, halloc: ctx.halloc, bparams: cs_orem(nm, ctx.bparams), mvars: if ismut == 1 then Cons(nm, cs_orem(nm, ctx.mvars)) else cs_orem(nm, ctx.mvars), origins: Cons({k: nm, v: if org != "" then org else "local:" + nm}, ctx.origins), osigs: ctx.osigs}
fn cs_ochke(e, ctx, moved) = match e
    Var(x)           => if cs_omem(x, moved) == 1 then {diags: Cons(cs_mkdiag("O0001", "ownership", "ownership error: use of moved value '" + x + "'", "borrow '" + x + "' instead or call 'clone(" + x + ")'"), Nil), moved: moved, origin: ""} else {diags: Nil, moved: moved, origin: cs_olookup_org(x, ctx.origins)}
    Field(o, fld)    => cs_ochke(o, ctx, moved)
    OwnE(inner)      => cs_ochk_own_tgt(inner, ctx, moved)
    MutE(inner)      => cs_ochk_mut_tgt(inner, ctx, moved)
    LetIn(nm, v, b)  => let rv = cs_ochke(v, ctx, moved) in let rb = cs_ochke(b, cs_octx_bind(ctx, nm, 0, rv.origin), cs_orem(nm, rv.moved)) in {diags: cs_app(rv.diags, rb.diags), moved: rb.moved, origin: rb.origin}
    VarIn(nm, v, b)  => let rv = cs_ochke(v, ctx, moved) in let rb = cs_ochke(b, cs_octx_bind(ctx, nm, 1, rv.origin), cs_orem(nm, rv.moved)) in {diags: cs_app(rv.diags, rb.diags), moved: rb.moved, origin: rb.origin}
    DeferE(c, b)     => let rb = cs_ochke(b, ctx, moved) in let rc = cs_ochke(c, ctx, rb.moved) in {diags: cs_app(rb.diags, rc.diags), moved: rc.moved, origin: rb.origin}
    ErrDeferE(c, b)  => let rb = cs_ochke(b, ctx, moved) in let rc = cs_ochke(c, ctx, rb.moved) in {diags: cs_app(rb.diags, rc.diags), moved: rc.moved, origin: rb.origin}
    WithAllocE(a, b) => let ra = cs_ochke(a, ctx, moved) in let rb = cs_ochke(b, {fnm: ctx.fnm, pubf: ctx.pubf, freef: ctx.freef, halloc: 1, bparams: ctx.bparams, mvars: ctx.mvars, origins: ctx.origins, osigs: ctx.osigs}, ra.moved) in {diags: cs_app(ra.diags, rb.diags), moved: rb.moved, origin: rb.origin}
    Bin(op, l, r)    => let rl = cs_ochke(l, ctx, moved) in let rr = cs_ochke(r, ctx, rl.moved) in {diags: cs_app(rl.diags, rr.diags), moved: rr.moved, origin: ""}
    If(c, t, e2)     => let rc = cs_ochke(c, ctx, moved) in let rt = cs_ochke(t, ctx, rc.moved) in let re = cs_ochke(e2, ctx, rc.moved) in {diags: cs_app(rc.diags, cs_app(rt.diags, re.diags)), moved: cs_app(rt.moved, re.moved), origin: if rt.origin != "" then rt.origin else re.origin}
    Call(nm, args)   => cs_ochkcall(nm, args, ctx, moved)
    _                => {diags: Nil, moved: moved, origin: ""}
fn cs_ochkargs(args, ctx, moved) = match args
    Nil        => {diags: Nil, moved: moved}
    Cons(h, t) => let r1 = cs_ochke(h, ctx, moved) in let r2 = cs_ochkargs(t, ctx, r1.moved) in {diags: cs_app(r1.diags, r2.diags), moved: r2.moved}
fn cs_ois_heap(nm) = nm == "rc_new" or nm == "arc_new" or nm == "alloc_heap" or nm == "table_new" or nm == "box_new"
fn cs_ois_free(mf) = mf % 2
fn cs_ois_total(mf) = (mf / 2) % 2
fn cs_ois_llm(mf) = (mf / 4) % 2
fn cs_ochkcall(fnm, args, ctx, moved) = let d0 = if cs_ois_free(ctx.freef) == 1 and ctx.halloc == 0 and cs_ois_heap(fnm) then Cons(cs_mkdiag("O0030", "ownership", "ownership error: ambient heap allocation '" + fnm + "' in '@freestanding' function '" + ctx.fnm + "'", "wrap allocation in 'with alloc = <arena> in ...'"), Nil) else Nil in if fnm == "borrow" and cs_len(args) == 1 then let ra = cs_ochke(cs_asthead(args), ctx, moved) in {diags: cs_app(d0, ra.diags), moved: ra.moved, origin: "borrow:" + ra.origin} else cs_ochkcall_sig(fnm, args, cs_osiglookup(fnm, ctx.osigs), ctx, moved, d0)
fn cs_ochkcall_sig(fnm, args, msig, ctx, moved, d0) = match msig
    Nil          => let dc = cs_ochk_conf(fnm, cs_ocollect_muts(args, Nil), args) in let ra = cs_ochkargs(args, ctx, moved) in {diags: cs_app(d0, cs_app(dc, ra.diags)), moved: ra.moved, origin: ""}
    Cons(sg, sr) => let dm = cs_ochk_modes(fnm, args, sg.pl, ctx) in let dc = cs_ochk_conf(fnm, cs_ocollect_muts(args, sg.pl), args) in let ra = cs_ochkargs(args, ctx, moved) in {diags: cs_app(d0, cs_app(dm, cs_app(dc, ra.diags))), moved: ra.moved, origin: ""}
fn cs_ochk_ret(nm, pubf, fromp, org) = let core_org = cs_ostrip_b(org) in if cs_startswith(org, "borrow:") == 1 and cs_startswith(core_org, "local:") == 1 then let lx = slice(core_org, 6, count(core_org)) in Cons(cs_mkdiag("O0020", "region", "region error: borrowed value '" + lx + "' escapes local scope of '" + nm + "'", "return an owned value instead of borrowing local '" + lx + "'"), Nil) else if cs_startswith(org, "borrow:") == 1 and cs_startswith(core_org, "param:") == 1 then let px = slice(core_org, 6, count(core_org)) in (if pubf == 1 and fromp == "" then Cons(cs_mkdiag("O0021", "region", "region error: public function '" + nm + "' returns a borrow from '" + px + "' without an origin clause", "add 'from " + px + "' to the return type of '" + nm + "'"), Nil) else if fromp != "" and fromp != px then Cons(cs_mkdiag("O0021", "region", "region error: function '" + nm + "' declares 'from " + fromp + "' but returns a borrow from '" + px + "'", "change origin clause to 'from " + px + "'"), Nil) else Nil) else Nil

## --- Track A1/A2/A3 diagnostics & hole synthesis in lcaas ---
fn cs_is_hole(nm) = if nm == "_" or cs_startswith(nm, "_hole") == 1 then 1 else 0
fn cs_is_unv_ty(ty) = match ty
    TyApply(n, e) => if n == "unverified" then 1 else 0
    _             => 0
fn cs_hd_ty(xs) = match xs
    Nil        => TyAny
    Cons(h, t) => h
fn cs_tl_ty(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t
fn cs_hd_str(xs, def) = match xs
    Nil        => def
    Cons(h, t) => h
fn cs_plenv(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, r) => Cons({k: pn, v: cs_tystr(cs_hd_ty(pts))}, cs_plenv(r, cs_tl_ty(pts)))
fn cs_fn_lenv(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => cs_plenv(sg.pn, sg.pt)
fn cs_fn_rty(msig, mosig) = match mosig
    Cons(osg, r) => if cs_isany(osg.rty) == 0 then cs_tystr(osg.rty) else cs_sig_rty(msig)
    Nil          => cs_sig_rty(msig)
fn cs_sig_rty(msig) = match msig
    Cons(sg, r) => cs_tystr(sg.rt)
    Nil         => "int"
fn cs_synth_vars(ety, lenv) = match lenv
    Nil        => Nil
    Cons(h, t) => if h.v == ety then Cons(h.k, cs_synth_vars(ety, t)) else cs_synth_vars(ety, t)
fn cs_synth_fn_arg(pty, lenv) = match lenv
    Nil        => ""
    Cons(h, t) => if h.v == pty then h.k else cs_synth_fn_arg(pty, t)
fn cs_synth_fns(ety, lenv, sigs, curfn) = match sigs
    Nil        => Nil
    Cons(sg, r) => if sg.fname == curfn or cs_tystr(sg.rt) != ety then cs_synth_fns(ety, lenv, r, curfn) else if cs_len(sg.pt) == 0 then Cons(sg.fname + "()", cs_synth_fns(ety, lenv, r, curfn)) else if cs_len(sg.pt) == 1 then let v = cs_synth_fn_arg(cs_tystr(cs_hd_ty(sg.pt)), lenv) in (if v != "" then Cons(sg.fname + "(" + v + ")", cs_synth_fns(ety, lenv, r, curfn)) else cs_synth_fns(ety, lenv, r, curfn)) else cs_synth_fns(ety, lenv, r, curfn)
fn cs_synth_def(ety) = if ety == "int" then Cons("0", Nil) else if ety == "str" then Cons("\"\"", Nil) else Cons("Nil", Nil)
fn cs_synth_cands(ety, lenv, sigs, curfn) = cs_app(cs_synth_vars(ety, lenv), cs_app(cs_synth_fns(ety, lenv, sigs, curfn), cs_synth_def(ety)))

fn cs_holes_e(e, fnm, ety, lenv, sigs) = match e
    Var(nm)         => if cs_is_hole(nm) == 1 then let cands = cs_synth_cands(ety, lenv, sigs, fnm) in let best = cs_hd_str(cands, "0") in {holes: Cons({hole: nm, fnm: fnm, expected_type: ety, context: lenv, candidates: cands}, Nil), diags: Cons(cs_mkdiag("A0001", "hole", "hole error: unfilled typed hole '" + nm + "' of expected type " + ety + " in '" + fnm + "'", "replace '" + nm + "' with '" + best + "'"), Nil)} else {holes: Nil, diags: Nil}
    Bin(op, l, r)   => let r1 = cs_holes_e(l, fnm, ety, lenv, sigs) in let r2 = cs_holes_e(r, fnm, ety, lenv, sigs) in {holes: cs_app(r1.holes, r2.holes), diags: cs_app(r1.diags, r2.diags)}
    If(c, t, e2)    => let rc = cs_holes_e(c, fnm, "int", lenv, sigs) in let rt = cs_holes_e(t, fnm, ety, lenv, sigs) in let re = cs_holes_e(e2, fnm, ety, lenv, sigs) in {holes: cs_app(rc.holes, cs_app(rt.holes, re.holes)), diags: cs_app(rc.diags, cs_app(rt.diags, re.diags))}
    LetIn(nm, v, b) => let rv = cs_holes_e(v, fnm, ety, lenv, sigs) in let rb = cs_holes_e(b, fnm, ety, Cons({k: nm, v: ety}, lenv), sigs) in {holes: cs_app(rv.holes, rb.holes), diags: cs_app(rv.diags, rb.diags)}
    VarIn(nm, v, b) => let rv = cs_holes_e(v, fnm, ety, lenv, sigs) in let rb = cs_holes_e(b, fnm, ety, Cons({k: nm, v: ety}, lenv), sigs) in {holes: cs_app(rv.holes, rb.holes), diags: cs_app(rv.diags, rb.diags)}
    Call(cnm, args) => cs_holes_args(args, fnm, ety, lenv, sigs)
    _               => {holes: Nil, diags: Nil}
fn cs_holes_args(args, fnm, ety, lenv, sigs) = match args
    Nil        => {holes: Nil, diags: Nil}
    Cons(h, t) => let r1 = cs_holes_e(h, fnm, ety, lenv, sigs) in let r2 = cs_holes_args(t, fnm, ety, lenv, sigs) in {holes: cs_app(r1.holes, r2.holes), diags: cs_app(r1.diags, r2.diags)}
fn cs_collect_holes_stmts(prog, sigs, osigs) = match prog
    Nil        => {holes: Nil, diags: Nil}
    Cons(h, t) => cs_collect_holes_stmt1(h, t, sigs, osigs)
fn cs_collect_holes_stmt1(st, rest, sigs, osigs) = match st
    Fn(nm, ps, body) => let msig = cs_siglookup(nm, sigs) in let mosig = cs_osiglookup(nm, osigs) in let r1 = cs_holes_e(body, nm, cs_fn_rty(msig, mosig), cs_fn_lenv(msig), sigs) in let r2 = cs_collect_holes_stmts(rest, sigs, osigs) in {holes: cs_app(r1.holes, r2.holes), diags: cs_app(r1.diags, r2.diags)}
    _                => cs_collect_holes_stmts(rest, sigs, osigs)

## --- Track A2: totality check (`[A0002]`) ---
fn cs_pat_subvars(p) = match p
    PCons(tag, sub) => sub
    _               => Nil
fn cs_guard_ps(ps, c, guarded) = match ps
    Nil        => guarded
    Cons(p, r) => if cs_omentions(p, c) == 1 and cs_omem(p, guarded) == 0 then Cons(p, cs_guard_ps(r, c, guarded)) else cs_guard_ps(r, c, guarded)
fn cs_is_pos_num(e, minv) = match e
    Num(k) => if k >= minv then 1 else 0
    _      => 0
fn cs_is_dec_bin(op, l, r, ps, guarded) = match l
    Var(p) => if cs_omem(p, ps) == 1 and cs_omem(p, guarded) == 1 then (if op == "-" and cs_is_pos_num(r, 1) == 1 then 1 else if op == "/" and cs_is_pos_num(r, 2) == 1 then 1 else 0) else 0
    _      => 0
fn cs_is_dec_arg(arg, ps, subvars, guarded) = match arg
    Var(v)        => cs_omem(v, subvars)
    OwnE(inner)   => cs_is_dec_arg(inner, ps, subvars, guarded)
    MutE(inner)   => cs_is_dec_arg(inner, ps, subvars, guarded)
    Bin(op, l, r) => cs_is_dec_bin(op, l, r, ps, guarded)
    _             => 0
fn cs_has_dec_arg(args, ps, subvars, guarded) = match args
    Nil        => 0
    Cons(a, r) => if cs_is_dec_arg(a, ps, subvars, guarded) == 1 then 1 else cs_has_dec_arg(r, ps, subvars, guarded)
fn cs_achk_total_e(e, fnm, ps, subvars, guarded) = match e
    Call(cnm, args) => let da = cs_achk_total_args(args, fnm, ps, subvars, guarded) in if cnm == fnm and cs_has_dec_arg(args, ps, subvars, guarded) == 0 then Cons(cs_mkdiag("A0002", "totality", "totality error: cannot prove termination of 'total fn " + fnm + "': recursive call does not decrease any parameter", "recurse on a structural pattern subterm or a guarded 'n - 1' measure"), da) else da
    If(c, t, e2)    => let g2 = cs_guard_ps(ps, c, guarded) in cs_app(cs_achk_total_e(c, fnm, ps, subvars, guarded), cs_app(cs_achk_total_e(t, fnm, ps, subvars, g2), cs_achk_total_e(e2, fnm, ps, subvars, g2)))
    Bin(op, l, r)   => cs_app(cs_achk_total_e(l, fnm, ps, subvars, guarded), cs_achk_total_e(r, fnm, ps, subvars, guarded))
    LetIn(nm, v, b) => cs_app(cs_achk_total_e(v, fnm, ps, subvars, guarded), cs_achk_total_e(b, fnm, ps, subvars, guarded))
    Match(sc, arms) => cs_achk_total_arms(arms, fnm, ps, subvars, guarded)
    _               => Nil
fn cs_achk_total_args(args, fnm, ps, subvars, guarded) = match args
    Nil        => Nil
    Cons(h, t) => cs_app(cs_achk_total_e(h, fnm, ps, subvars, guarded), cs_achk_total_args(t, fnm, ps, subvars, guarded))
fn cs_achk_total_arms(arms, fnm, ps, subvars, guarded) = match arms
    Nil        => Nil
    Cons(h, t) => cs_app(cs_achk_total_e(h.body, fnm, ps, cs_app(cs_pat_subvars(h.pat), subvars), guarded), cs_achk_total_arms(t, fnm, ps, subvars, guarded))

## --- Track A3: provenance check (`[A0003]`) ---
fn cs_uinit_vars(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, r) => if cs_is_unv_ty(cs_hd_ty(pts)) == 1 then Cons(pn, cs_uinit_vars(r, cs_tl_ty(pts))) else cs_uinit_vars(r, cs_tl_ty(pts))
fn cs_uinit_sig(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => cs_uinit_vars(sg.pn, sg.pt)
fn cs_is_unv_fn(cnm, osigs, sigs) = if cnm == "llm_complete" or cnm == "prob_sample" then 1 else if cs_is_llm_osig(cs_osiglookup(cnm, osigs)) == 1 then 1 else cs_is_unv_ret(cs_siglookup(cnm, sigs))
fn cs_is_llm_osig(msig) = match msig
    Nil        => 0
    Cons(sg, r) => cs_ois_llm(sg.freef)
fn cs_is_unv_ret(msig) = match msig
    Nil        => 0
    Cons(sg, r) => cs_is_unv_ty(sg.rt)
fn cs_is_sink(cnm, osigs) = if cnm == "io_write" or cnm == "db_exec" or cnm == "net_send" or cnm == "fs_write" or cnm == "trusted_sink" or cnm == "law_assert" then 1 else cs_is_pub_nonllm(cs_osiglookup(cnm, osigs))
fn cs_is_pub_nonllm(msig) = match msig
    Nil        => 0
    Cons(sg, r) => if sg.pubf == 1 and cs_ois_llm(sg.freef) == 0 then 1 else 0
fn cs_discharge_vars(uvars, c) = match uvars
    Nil        => Nil
    Cons(v, r) => if cs_omentions(v, c) == 1 then cs_discharge_vars(r, c) else Cons(v, cs_discharge_vars(r, c))
fn cs_achk_prov_e(e, fnm, uvars, osigs, sigs) = match e
    Var(x)          => {taint: cs_omem(x, uvars), diags: Nil}
    Bin(op, l, r)   => let rl = cs_achk_prov_e(l, fnm, uvars, osigs, sigs) in let rr = cs_achk_prov_e(r, fnm, uvars, osigs, sigs) in {taint: if rl.taint == 1 or rr.taint == 1 then 1 else 0, diags: cs_app(rl.diags, rr.diags)}
    If(c, t, e2)    => let rc = cs_achk_prov_e(c, fnm, uvars, osigs, sigs) in let rt = cs_achk_prov_e(t, fnm, cs_discharge_vars(uvars, c), osigs, sigs) in let re = cs_achk_prov_e(e2, fnm, uvars, osigs, sigs) in {taint: if rt.taint == 1 or re.taint == 1 then 1 else 0, diags: cs_app(rc.diags, cs_app(rt.diags, re.diags))}
    LetIn(nm, v, b) => let rv = cs_achk_prov_e(v, fnm, uvars, osigs, sigs) in let uv2 = if rv.taint == 1 then Cons(nm, cs_orem(nm, uvars)) else cs_orem(nm, uvars) in let rb = cs_achk_prov_e(b, fnm, uv2, osigs, sigs) in {taint: rb.taint, diags: cs_app(rv.diags, rb.diags)}
    Call(cnm, args) => cs_achk_prov_call(cnm, args, fnm, uvars, osigs, sigs)
    _               => {taint: 0, diags: Nil}
fn cs_achk_prov_args(args, fnm, uvars, osigs, sigs) = match args
    Nil        => {taint: 0, diags: Nil}
    Cons(h, t) => let r1 = cs_achk_prov_e(h, fnm, uvars, osigs, sigs) in let r2 = cs_achk_prov_args(t, fnm, uvars, osigs, sigs) in {taint: if r1.taint == 1 or r2.taint == 1 then 1 else 0, diags: cs_app(r1.diags, r2.diags)}
fn cs_achk_prov_call(cnm, args, fnm, uvars, osigs, sigs) = if cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" then let ra = cs_achk_prov_args(args, fnm, uvars, osigs, sigs) in {taint: 0, diags: ra.diags} else let ra = cs_achk_prov_args(args, fnm, uvars, osigs, sigs) in let d_sink = if cs_is_sink(cnm, osigs) == 1 and ra.taint == 1 then Cons(cs_mkdiag("A0003", "provenance", "provenance error: unverified AI/probabilistic value in '" + fnm + "' cannot flow into trusted sink '" + cnm + "' without verification", "validate with 'verify(x, <contract>)' before calling '" + cnm + "'"), Nil) else Nil in {taint: if cs_is_unv_fn(cnm, osigs, sigs) == 1 or ra.taint == 1 then 1 else 0, diags: cs_app(ra.diags, d_sink)}

fn cs_kcollect_effsigs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_kcollect_effsig1(h, cs_kcollect_effsigs(t))
fn cs_kcollect_effsig1(st, rest) = match st
    KEffSig(nm, effs) => Cons({nm: nm, effs: effs}, rest)
    _                 => rest
fn cs_kcollect_effdecls(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_kcollect_effdecl1(h, cs_kcollect_effdecls(t))
fn cs_kcollect_effdecl1(st, rest) = match st
    KEffectDecl(enm, ops) => Cons({enm: enm, ops: ops}, rest)
    _                     => rest
fn cs_kcollect_caps(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_kcollect_cap1(h, cs_kcollect_caps(t))
fn cs_kcollect_cap1(st, rest) = match st
    KCapGrant(effs) => cs_app(effs, rest)
    _               => rest
fn cs_keffsig_lookup(nm, ksigs) = match ksigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else cs_keffsig_lookup(nm, t)
fn cs_kop_effect(opnm, edecls) = match edecls
    Nil        => ""
    Cons(d, r) => if cs_kop_in_ops(opnm, d.ops) == 1 then d.enm else cs_kop_effect(opnm, r)
fn cs_kop_in_ops(opnm, ops) = match ops
    Nil        => 0
    Cons(o, r) => if o.op == opnm then 1 else cs_kop_in_ops(opnm, r)
fn cs_keff_add(eff, xs) = if eff == "" or eff == "pure" or cs_omem(eff, xs) == 1 then xs else Cons(eff, xs)
fn cs_keff_union(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => cs_keff_union(t, cs_keff_add(h, ys))
fn cs_keff_diff(xs, ys) = match xs
    Nil        => Nil
    Cons(h, t) => if h == "pure" or cs_omem(h, ys) == 1 then cs_keff_diff(t, ys) else Cons(h, cs_keff_diff(t, ys))
fn cs_kprim_eff(cnm) = if cnm == "io_write" or cnm == "io_read" or cnm == "println" or cnm == "read" or cnm == "readall" or cnm == "emit" or cnm == "flush" then "io" else if cnm == "fs_read" or cnm == "fs_write" or cnm == "fs_open" then "fs" else if cnm == "net_send" or cnm == "net_recv" or cnm == "net_connect" or cnm == "db_exec" then "net" else if cnm == "rc_new" or cnm == "arc_new" or cnm == "alloc_heap" or cnm == "table_new" or cnm == "box_new" then "alloc" else if cnm == "rand_int" or cnm == "prob_sample" or cnm == "llm_complete" then "rand" else if cnm == "time_now" or cnm == "clock_now" or cnm == "sleep_ms" then "time" else if cnm == "fail_err" or cnm == "raise_err" then "fail" else if cnm == "panic_msg" then "panic" else if cnm == "async_await" or cnm == "spawn_task" then "async" else ""
fn cs_kinfer_call_effs(cnm, ksigs, edecls) = let pe = cs_kprim_eff(cnm) in let ue = cs_kop_effect(cnm, edecls) in let base = cs_keff_add(pe, cs_keff_add(ue, Nil)) in match cs_keffsig_lookup(cnm, ksigs)
    Cons(ks, r) => cs_keff_union(base, cs_keff_diff(ks.effs, Cons("pure", Nil)))
    Nil         => base
fn cs_kinfer_effs_e(e, ksigs, edecls) = match e
    Bin(op, l, r)           => cs_keff_union(cs_kinfer_effs_e(l, ksigs, edecls), cs_kinfer_effs_e(r, ksigs, edecls))
    If(c, t, e2)            => cs_keff_union(cs_kinfer_effs_e(c, ksigs, edecls), cs_keff_union(cs_kinfer_effs_e(t, ksigs, edecls), cs_kinfer_effs_e(e2, ksigs, edecls)))
    LetIn(nm, v, b)         => cs_keff_union(cs_kinfer_effs_e(v, ksigs, edecls), cs_kinfer_effs_e(b, ksigs, edecls))
    VarIn(nm, v, b)         => cs_keff_union(cs_kinfer_effs_e(v, ksigs, edecls), cs_kinfer_effs_e(b, ksigs, edecls))
    OwnE(inner)             => cs_kinfer_effs_e(inner, ksigs, edecls)
    MutE(inner)             => cs_kinfer_effs_e(inner, ksigs, edecls)
    DeferE(c, b)            => cs_keff_union(cs_kinfer_effs_e(c, ksigs, edecls), cs_kinfer_effs_e(b, ksigs, edecls))
    ErrDeferE(c, b)         => cs_keff_union(cs_kinfer_effs_e(c, ksigs, edecls), cs_kinfer_effs_e(b, ksigs, edecls))
    WithAllocE(a, b)        => cs_keff_union(cs_kinfer_effs_e(a, ksigs, edecls), cs_orem("alloc", cs_kinfer_effs_e(b, ksigs, edecls)))
    WithHandlerE(en, hs, b) => cs_keff_union(cs_kinfer_hops(hs, ksigs, edecls), cs_orem(en, cs_kinfer_effs_e(b, ksigs, edecls)))
    Call(cnm, args)         => cs_keff_union(cs_kinfer_call_effs(cnm, ksigs, edecls), cs_kinfer_args(args, ksigs, edecls))
    Match(sc, arms)         => cs_keff_union(cs_kinfer_effs_e(sc, ksigs, edecls), cs_kinfer_arms(arms, ksigs, edecls))
    _                       => Nil
fn cs_kinfer_hops(hs, ksigs, edecls) = match hs
    Nil        => Nil
    Cons(h, t) => cs_keff_union(cs_kinfer_effs_e(h.body, ksigs, edecls), cs_kinfer_hops(t, ksigs, edecls))
fn cs_kinfer_args(xs, ksigs, edecls) = match xs
    Nil        => Nil
    Cons(h, t) => cs_keff_union(cs_kinfer_effs_e(h, ksigs, edecls), cs_kinfer_args(t, ksigs, edecls))
fn cs_kinfer_arms(xs, ksigs, edecls) = match xs
    Nil        => Nil
    Cons(h, t) => cs_keff_union(cs_kinfer_effs_e(h.body, ksigs, edecls), cs_kinfer_arms(t, ksigs, edecls))
fn cs_kget_dec_effs(mks) = match mks
    Nil         => Nil
    Cons(ks, r) => ks.effs
fn cs_kchk_fn(nm, pubf, body, kt) = let inf = cs_kinfer_effs_e(body, kt.ksigs, kt.edecls) in let mks = cs_keffsig_lookup(nm, kt.ksigs) in let dec = cs_kget_dec_effs(mks) in let missing_pub = if pubf == 1 and cs_isnil(mks) == 1 then inf else cs_keff_diff(inf, dec) in let d1 = if (pubf == 1 or cs_isnil(mks) == 0) and cs_isnil(missing_pub) == 0 then Cons(cs_mkdiag("E0200", "effect", "effect error: function '" + nm + "' performs undeclared effect '{" + cs_joinsep(missing_pub, ", ") + "}'", "add '/ {" + cs_joinsep(cs_keff_union(dec, inf), ", ") + "}' to the signature of '" + nm + "' or handle it with 'with handler'"), Nil) else Nil in let d2 = if cs_isnil(kt.caps) == 0 and cs_isnil(cs_keff_diff(inf, kt.caps)) == 0 then let uncap = cs_keff_diff(inf, kt.caps) in Cons(cs_mkdiag("E0200", "capability", "capability error: function '" + nm + "' requires capability '{" + cs_joinsep(uncap, ", ") + "}' not granted to this module", "add '@capability " + cs_hd_str(uncap, "io") + "' or declare it in lume.toml"), Nil) else Nil in cs_app(d1, d2)

## --- Track S1: structured concurrency (`scope` / `spawn`) & `Send`/`Sync` (`[S0001]`) ---
fn cs_sis_nonsend_ty(ty) = match ty
    TyApply(n, e) => if n == "rc" or n == "cell" or n == "Ref" then 1 else cs_sis_nonsend_ty(e)
    TyList(e)     => cs_sis_nonsend_ty(e)
    _             => 0
fn cs_sis_nonsend_init(e) = match e
    Call(cnm, args) => if cnm == "rc_new" or cnm == "cell_new" or cnm == "borrow_mut" then 1 else 0
    MutE(inner)     => 1
    _               => 0
fn cs_sinit_ns(pns, pts) = match pns
    Nil         => Nil
    Cons(pn, r) => if cs_sis_nonsend_ty(cs_hd_ty(pts)) == 1 then Cons(pn, cs_sinit_ns(r, cs_tl_ty(pts))) else cs_sinit_ns(r, cs_tl_ty(pts))
fn cs_sinit_ns_sig(msig) = match msig
    Nil        => Nil
    Cons(sg, r) => cs_sinit_ns(sg.pn, sg.pt)
fn cs_schk_spawn_body(e, fnm, nsvars, mvars) = match e
    Var(x)          => if cs_omem(x, nsvars) == 1 then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: cannot capture non-Send value '" + x + "' across 'spawn' in '" + fnm + "'", "use 'arc_new' instead of 'rc_new'/'cell_new' or pass an owned message over 'chan[T]'"), Nil) else if cs_omem(x, mvars) == 1 then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: cannot capture mutable binding '" + x + "' across 'spawn' in '" + fnm + "' without 'own' transfer", "move ownership with 'own " + x + "' or share via 'arc[T]' / 'chan[T]'"), Nil) else Nil
    OwnE(inner)     => cs_schk_spawn_own(inner, fnm, nsvars)
    MutE(inner)     => Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: cannot capture mutable borrow 'mut' across 'spawn' in '" + fnm + "'", "transfer ownership with 'own' or synchronize via 'chan[T]'"), Nil)
    Field(o, fld)   => cs_schk_spawn_body(o, fnm, nsvars, mvars)
    Bin(op, l, r)   => cs_app(cs_schk_spawn_body(l, fnm, nsvars, mvars), cs_schk_spawn_body(r, fnm, nsvars, mvars))
    If(c, t, e2)    => cs_app(cs_schk_spawn_body(c, fnm, nsvars, mvars), cs_app(cs_schk_spawn_body(t, fnm, nsvars, mvars), cs_schk_spawn_body(e2, fnm, nsvars, mvars)))
    LetIn(nm, v, b) => cs_app(cs_schk_spawn_body(v, fnm, nsvars, mvars), cs_schk_spawn_body(b, fnm, cs_orem(nm, nsvars), cs_orem(nm, mvars)))
    VarIn(nm, v, b) => cs_app(cs_schk_spawn_body(v, fnm, nsvars, mvars), cs_schk_spawn_body(b, fnm, cs_orem(nm, nsvars), cs_orem(nm, mvars)))
    Call(cnm, args) => if cnm == "borrow_mut" then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: cannot capture mutable borrow 'borrow_mut' across 'spawn' in '" + fnm + "'", "transfer ownership with 'own' or synchronize via 'chan[T]'"), Nil) else cs_schk_spawn_args(args, fnm, nsvars, mvars)
    _               => Nil
fn cs_schk_spawn_own(inner, fnm, nsvars) = match inner
    Var(x) => if cs_omem(x, nsvars) == 1 then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: cannot transfer non-Send value '" + x + "' across 'spawn' in '" + fnm + "'", "convert 'rc[T]'/'cell[T]' to 'arc[T]'"), Nil) else Nil
    _      => cs_schk_spawn_body(inner, fnm, nsvars, Nil)
fn cs_schk_spawn_args(args, fnm, nsvars, mvars) = match args
    Nil        => Nil
    Cons(h, t) => cs_app(cs_schk_spawn_body(h, fnm, nsvars, mvars), cs_schk_spawn_args(t, fnm, nsvars, mvars))
fn cs_schk_conc_e(e, fnm, in_scope, nsvars, mvars) = match e
    ScopeE(snm, b)          => cs_schk_conc_e(b, fnm, 1, nsvars, mvars)
    SpawnE(inner)           => let d0 = if in_scope == 0 then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: unstructured 'spawn' in '" + fnm + "' is forbidden outside a lexical 'scope' block", "wrap the task in 'scope s in spawn(...)'"), Nil) else Nil in cs_app(d0, cs_app(cs_schk_spawn_body(inner, fnm, nsvars, mvars), cs_schk_conc_e(inner, fnm, in_scope, nsvars, mvars)))
    LetIn(nm, v, b)         => let d1 = cs_schk_conc_e(v, fnm, in_scope, nsvars, mvars) in let ns2 = if cs_sis_nonsend_init(v) == 1 then Cons(nm, cs_orem(nm, nsvars)) else cs_orem(nm, nsvars) in cs_app(d1, cs_schk_conc_e(b, fnm, in_scope, ns2, cs_orem(nm, mvars)))
    VarIn(nm, v, b)         => let d1 = cs_schk_conc_e(v, fnm, in_scope, nsvars, mvars) in let ns2 = if cs_sis_nonsend_init(v) == 1 then Cons(nm, cs_orem(nm, nsvars)) else cs_orem(nm, nsvars) in cs_app(d1, cs_schk_conc_e(b, fnm, in_scope, ns2, Cons(nm, cs_orem(nm, mvars))))
    Bin(op, l, r)           => cs_app(cs_schk_conc_e(l, fnm, in_scope, nsvars, mvars), cs_schk_conc_e(r, fnm, in_scope, nsvars, mvars))
    If(c, t, e2)            => cs_app(cs_schk_conc_e(c, fnm, in_scope, nsvars, mvars), cs_app(cs_schk_conc_e(t, fnm, in_scope, nsvars, mvars), cs_schk_conc_e(e2, fnm, in_scope, nsvars, mvars)))
    DeferE(c, b)            => cs_app(cs_schk_conc_e(c, fnm, in_scope, nsvars, mvars), cs_schk_conc_e(b, fnm, in_scope, nsvars, mvars))
    ErrDeferE(c, b)         => cs_app(cs_schk_conc_e(c, fnm, in_scope, nsvars, mvars), cs_schk_conc_e(b, fnm, in_scope, nsvars, mvars))
    WithAllocE(a, b)        => cs_app(cs_schk_conc_e(a, fnm, in_scope, nsvars, mvars), cs_schk_conc_e(b, fnm, in_scope, nsvars, mvars))
    WithHandlerE(en, hs, b) => cs_schk_conc_e(b, fnm, in_scope, nsvars, mvars)
    Call(cnm, args)         => if cnm == "spawn_task" then let d0 = if in_scope == 0 then Cons(cs_mkdiag("S0001", "concurrency", "concurrency error: unstructured 'spawn_task' in '" + fnm + "' is forbidden outside a lexical 'scope' block", "wrap the task in 'scope s in ...'"), Nil) else Nil in cs_app(d0, cs_schk_spawn_args(args, fnm, nsvars, mvars)) else cs_schk_conc_args(args, fnm, in_scope, nsvars, mvars)
    _                       => Nil
fn cs_schk_conc_args(args, fnm, in_scope, nsvars, mvars) = match args
    Nil        => Nil
    Cons(h, t) => cs_app(cs_schk_conc_e(h, fnm, in_scope, nsvars, mvars), cs_schk_conc_args(t, fnm, in_scope, nsvars, mvars))

## --- Track V: Contract Verification (`requires`/`ensures`/`invariant`/`old`/`law`, `[V0001]`, `proofs`) ---
fn cs_vcollect_vsigs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_vcollect_vsig1(h, cs_vcollect_vsigs(t))
fn cs_vcollect_vsig1(st, rest) = match st
    VContractSig(nm, ps, reqs, enss) => Cons({nm: nm, ps: ps, reqs: reqs, enss: enss}, rest)
    _                                => rest
fn cs_vcollect_invs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_vcollect_inv1(h, cs_vcollect_invs(t))
fn cs_vcollect_inv1(st, rest) = match st
    VTypeInvariant(nm, fs, inv) => Cons({nm: nm, fs: fs, inv: inv}, rest)
    _                           => rest
fn cs_vsiglookup(nm, vsigs) = match vsigs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else cs_vsiglookup(nm, t)
fn cs_vinvlookup(nm, invs) = match invs
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else cs_vinvlookup(nm, t)
fn cs_vv_int(n) = {ok: 1, i: n, fields: Nil}
fn cs_vv_rec(fs) = {ok: 1, i: 0, fields: fs}
fn cs_vv_err() = {ok: 0, i: 0, fields: Nil}
fn cs_vlookup(nm, env) = match env
    Nil        => cs_vv_err()
    Cons(h, t) => if h.k == nm then h.v else cs_vlookup(nm, t)
fn cs_vflookup(fld, fs) = match fs
    Nil        => cs_vv_err()
    Cons(h, t) => if h.key == fld then h.val else cs_vflookup(fld, t)
fn cs_vbind_ps(ps, vs) = match ps
    Nil        => Nil
    Cons(p, r) => cs_vbind_p1(p, r, vs)
fn cs_vbind_p1(p, r, vs) = match vs
    Nil         => Nil
    Cons(v, vr) => Cons({k: p, v: v}, cs_vbind_ps(r, vr))
fn cs_vfields_env(fs) = match fs
    Nil        => Nil
    Cons(h, t) => Cons({k: h.key, v: h.val}, cs_vfields_env(t))
fn cs_veval_bin(op, rl, rr) = if rl.ok == 0 or rr.ok == 0 then cs_vv_err() else let x = rl.i in let y = rr.i in if op == "+" then cs_vv_int(x + y) else if op == "-" then cs_vv_int(x - y) else if op == "*" then cs_vv_int(x * y) else if op == "/" then (if y == 0 then cs_vv_err() else cs_vv_int(x / y)) else if op == "%" then (if y == 0 then cs_vv_err() else cs_vv_int(x % y)) else if op == "==" then cs_vv_int(if x == y then 1 else 0) else if op == "!=" then cs_vv_int(if x != y then 1 else 0) else if op == "<" then cs_vv_int(if x < y then 1 else 0) else if op == ">" then cs_vv_int(if x > y then 1 else 0) else if op == "<=" then cs_vv_int(if x <= y then 1 else 0) else if op == ">=" then cs_vv_int(if x >= y then 1 else 0) else if op == "and" then cs_vv_int(if x != 0 and y != 0 then 1 else 0) else if op == "or" then cs_vv_int(if x != 0 or y != 0 then 1 else 0) else cs_vv_err()
fn cs_veval(e, env, old_env, ft, d) = if d > 20 then cs_vv_err() else cs_veval1(e, env, old_env, ft, d)
fn cs_veval1(e, env, old_env, ft, d) = match e
    Num(n)                  => cs_vv_int(n)
    Str(s)                  => cs_vv_int(0)
    Var(nm)                 => cs_vlookup(nm, env)
    OwnE(inner)             => cs_veval(inner, env, old_env, ft, d)
    MutE(inner)             => cs_veval(inner, env, old_env, ft, d)
    CT(inner)               => cs_veval(inner, env, old_env, ft, d)
    WithHandlerE(en, hs, b) => cs_veval(b, env, old_env, cs_vadd_hops_ft(hs, ft), d)
    ScopeE(snm, b)          => cs_veval(b, Cons({k: snm, v: cs_vv_int(1)}, env), old_env, ft, d)
    SpawnE(inner)           => cs_veval(inner, env, old_env, ft, d)
    Bin(op, l, r)           => cs_veval_bin(op, cs_veval(l, env, old_env, ft, d), cs_veval(r, env, old_env, ft, d))
    If(c, t, e2)            => let rc = cs_veval(c, env, old_env, ft, d) in if rc.ok == 0 then cs_vv_err() else if rc.i != 0 then cs_veval(t, env, old_env, ft, d) else cs_veval(e2, env, old_env, ft, d)
    LetIn(nm, v, b)         => let rv = cs_veval(v, env, old_env, ft, d) in if rv.ok == 0 then cs_vv_err() else cs_veval(b, Cons({k: nm, v: rv}, env), old_env, ft, d)
    VarIn(nm, v, b)         => let rv = cs_veval(v, env, old_env, ft, d) in if rv.ok == 0 then cs_vv_err() else cs_veval(b, Cons({k: nm, v: rv}, env), old_env, ft, d)
    Rec(items)              => cs_veval_rec(items, env, old_env, ft, d)
    RecT(tn, items)         => cs_veval_rec(items, env, old_env, ft, d)
    Field(o, fld)           => let ro = cs_veval(o, env, old_env, ft, d) in if ro.ok == 0 then cs_vv_err() else cs_vflookup(fld, ro.fields)
    Call(cnm, args)         => cs_veval_call(cnm, args, env, old_env, ft, d)
    _                       => cs_vv_err()
fn cs_veval_rec(items, env, old_env, ft, d) = match items
    Nil        => cs_vv_rec(Nil)
    Cons(h, t) => let rv = cs_veval(h.val, env, old_env, ft, d) in if rv.ok == 0 then cs_vv_err() else let rt = cs_veval_rec(t, env, old_env, ft, d) in if rt.ok == 0 then cs_vv_err() else cs_vv_rec(Cons({key: h.key, val: rv}, rt.fields))
fn cs_veval_args(args, env, old_env, ft, d) = match args
    Nil        => {ok: 1, vals: Nil}
    Cons(h, t) => let rh = cs_veval(h, env, old_env, ft, d) in if rh.ok == 0 then {ok: 0, vals: Nil} else let rt = cs_veval_args(t, env, old_env, ft, d) in if rt.ok == 0 then {ok: 0, vals: Nil} else {ok: 1, vals: Cons(rh, rt.vals)}
fn cs_astsecond(xs) = match xs
    Nil        => Num(0)
    Cons(h, t) => cs_asthead(t)
fn cs_veval_call(cnm, args, env, old_env, ft, d) = if cnm == "old" and cs_len(args) == 1 then cs_veval(cs_asthead(args), old_env, old_env, ft, d) else if (cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" or cnm == "borrow" or cnm == "borrow_mut" or cnm == "move" or cnm == "clone") and cs_len(args) >= 1 then cs_veval(cs_asthead(args), env, old_env, ft, d) else if cnm == "dec_add" and cs_len(args) == 2 then cs_veval_bin("+", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_sub" and cs_len(args) == 2 then cs_veval_bin("-", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_eq" and cs_len(args) == 2 then cs_veval_bin("==", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_lt" and cs_len(args) == 2 then cs_veval_bin("<", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_le" and cs_len(args) == 2 then cs_veval_bin("<=", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_gt" and cs_len(args) == 2 then cs_veval_bin(">", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else if cnm == "dec_ge" and cs_len(args) == 2 then cs_veval_bin(">=", cs_veval(cs_asthead(args), env, old_env, ft, d), cs_veval(cs_astsecond(args), env, old_env, ft, d)) else cs_veval_ufn(cs_fnlookup(cnm, ft), cs_veval_args(args, env, old_env, ft, d), ft, d)
fn cs_veval_ufn(mf, ra, ft, d) = match mf
    Nil          => cs_vv_err()
    Cons(fn0, r) => if ra.ok == 0 then cs_vv_err() else cs_veval_ufn2(fn0, ra.vals, ft, d)
fn cs_veval_ufn2(fn0, vals, ft, d) = match fn0
    Fn(fnm, ps, body) => let fenv = cs_vbind_ps(ps, vals) in cs_veval(body, fenv, fenv, ft, d + 1)
    _                 => cs_vv_err()
fn cs_vpts_a() = Cons(0, Cons(1, Cons(0 - 1, Nil)))
fn cs_vpts_b() = Cons(0, Cons(1, Nil))
fn cs_vpts_c() = Cons(0, Cons(1, Nil))
fn cs_vpts_for(idx, total) = if total <= 1 then cs_vpts_a() else if total == 2 then cs_vpts_b() else if idx < 3 then cs_vpts_c() else Cons(0, Nil)
fn cs_vgen_envs(ps, idx, total) = match ps
    Nil        => Cons(Nil, Nil)
    Cons(p, r) => cs_vcross_p(p, cs_vpts_for(idx, total), cs_vgen_envs(r, idx + 1, total))
fn cs_vcross_p(p, pts, envs) = match pts
    Nil         => Nil
    Cons(x, xr) => cs_app(cs_vbind_all(p, cs_vv_int(x), envs), cs_vcross_p(p, xr, envs))
fn cs_vbind_all(p, v, envs) = match envs
    Nil         => Nil
    Cons(e, er) => Cons(Cons({k: p, v: v}, e), cs_vbind_all(p, v, er))
fn cs_vfmt_env(env) = match env
    Nil        => ""
    Cons(h, t) => let s = h.k + " = " + str((h.v).i) in if cs_isnil(t) == 1 then s else s + ", " + cs_vfmt_env(t)
fn cs_veval_all_true(es, env, old_env, ft) = match es
    Nil        => {ok: 1, hold: 1}
    Cons(h, t) => let rh = cs_veval(h, env, old_env, ft, 0) in if rh.ok == 0 then {ok: 0, hold: 0} else if rh.i == 0 then {ok: 1, hold: 0} else cs_veval_all_true(t, env, old_env, ft)
fn cs_vprove_envs(envs, reqs, enss, body, ft, undec) = match envs
    Nil          => {status: "runtime_checked", cex: ""}
    Cons(env, r) => let rq = cs_veval_all_true(reqs, env, env, ft) in if rq.ok == 0 then cs_vprove_envs(r, reqs, enss, body, ft, 1) else if rq.hold == 0 then cs_vprove_envs(r, reqs, enss, body, ft, undec) else if cs_isnil(enss) == 1 then cs_vprove_envs(r, reqs, enss, body, ft, undec) else let rb = cs_veval(body, env, env, ft, 0) in if rb.ok == 0 then cs_vprove_envs(r, reqs, enss, body, ft, 1) else let penv = Cons({k: "result", v: rb}, Cons({k: "ret", v: rb}, env)) in let eq = cs_veval_all_true(enss, penv, env, ft) in if eq.ok == 0 then cs_vprove_envs(r, reqs, enss, body, ft, 1) else if eq.hold == 0 then {status: "refuted", cex: cs_vfmt_env(env) + " (result = " + str(rb.i) + ")"} else cs_vprove_envs(r, reqs, enss, body, ft, undec)
fn cs_vprove_law_envs(envs, body, ft, undec) = match envs
    Nil          => {status: "runtime_checked", cex: ""}
    Cons(env, r) => let rb = cs_veval(body, env, env, ft, 0) in if rb.ok == 0 then cs_vprove_law_envs(r, body, ft, 1) else if rb.i == 0 then {status: "refuted", cex: cs_vfmt_env(env)} else cs_vprove_law_envs(r, body, ft, undec)

## --- Stage B: Sound QF_LIA (Quantifier-Free Linear Integer Arithmetic) Decision Procedure (Fourier-Motzkin) ---
fn cs_vlin_const(n) = {ok: 1, c0: n, cs: Nil}
fn cs_vlin_var(nm) = {ok: 1, c0: 0, cs: Cons({k: nm, c: 1}, Nil)}
fn cs_vlin_err() = {ok: 0, c0: 0, cs: Nil}
fn cs_vlin_coeff(nm, cs) = match cs
    Nil        => 0
    Cons(h, t) => if h.k == nm then h.c else cs_vlin_coeff(nm, t)
fn cs_vlin_add_term(nm, c, cs) = if c == 0 then cs else cs_vlin_add_t1(nm, c, cs)
fn cs_vlin_add_t1(nm, c, cs) = match cs
    Nil        => Cons({k: nm, c: c}, Nil)
    Cons(h, t) => if h.k == nm then (if h.c + c == 0 then t else Cons({k: nm, c: h.c + c}, t)) else Cons(h, cs_vlin_add_t1(nm, c, t))
fn cs_vlin_add_cs(cs1, cs2) = match cs1
    Nil        => cs2
    Cons(h, t) => cs_vlin_add_cs(t, cs_vlin_add_term(h.k, h.c, cs2))
fn cs_vlin_scale_cs(k, cs) = if k == 0 then Nil else cs_vlin_scale_cs1(k, cs)
fn cs_vlin_scale_cs1(k, cs) = match cs
    Nil        => Nil
    Cons(h, t) => Cons({k: h.k, c: k * h.c}, cs_vlin_scale_cs1(k, t))
fn cs_vlin_add(a, b) = if a.ok == 0 or b.ok == 0 then cs_vlin_err() else {ok: 1, c0: a.c0 + b.c0, cs: cs_vlin_add_cs(a.cs, b.cs)}
fn cs_vlin_scale(k, a) = if a.ok == 0 then cs_vlin_err() else {ok: 1, c0: k * a.c0, cs: cs_vlin_scale_cs(k, a.cs)}
fn cs_vlin_sub(a, b) = cs_vlin_add(a, cs_vlin_scale(0 - 1, b))
fn cs_vlin_mul(a, b) = if a.ok == 0 or b.ok == 0 then cs_vlin_err() else if cs_isnil(a.cs) == 1 then cs_vlin_scale(a.c0, b) else if cs_isnil(b.cs) == 1 then cs_vlin_scale(b.c0, a) else cs_vlin_err()
fn cs_vlin_is_contra(l) = if l.ok == 1 and cs_isnil(l.cs) == 1 and l.c0 < 0 then 1 else 0
fn cs_vfm_any_contra(hyps) = match hyps
    Nil        => 0
    Cons(h, t) => if cs_vlin_is_contra(h) == 1 then 1 else cs_vfm_any_contra(t)
fn cs_vfm_vars_cs(cs, acc) = match cs
    Nil        => acc
    Cons(h, t) => cs_vfm_vars_cs(t, if cs_omem(h.k, acc) == 1 then acc else Cons(h.k, acc))
fn cs_vfm_vars(hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => cs_vfm_vars(t, cs_vfm_vars_cs(h.cs, acc))
fn cs_vfm_part_pos(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if cs_vlin_coeff(v, h.cs) > 0 then Cons(h, cs_vfm_part_pos(v, t)) else cs_vfm_part_pos(v, t)
fn cs_vfm_part_neg(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if cs_vlin_coeff(v, h.cs) < 0 then Cons(h, cs_vfm_part_neg(v, t)) else cs_vfm_part_neg(v, t)
fn cs_vfm_part_zer(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if cs_vlin_coeff(v, h.cs) == 0 then Cons(h, cs_vfm_part_zer(v, t)) else cs_vfm_part_zer(v, t)
fn cs_vfm_pair1(v, p, cp, negs) = match negs
    Nil        => Nil
    Cons(n, r) => let cn = 0 - cs_vlin_coeff(v, n.cs) in Cons(cs_vlin_add(cs_vlin_scale(cn, p), cs_vlin_scale(cp, n)), cs_vfm_pair1(v, p, cp, r))
fn cs_vfm_pairs(v, pos, negs) = match pos
    Nil        => Nil
    Cons(p, r) => let pairs1 = cs_vfm_pair1(v, p, cs_vlin_coeff(v, p.cs), negs) in if cs_len(pairs1) > 24 then pairs1 else cs_app(pairs1, cs_vfm_pairs(v, r, negs))
fn cs_vfm_elim_var(v, hyps) = cs_app(cs_vfm_part_zer(v, hyps), cs_vfm_pairs(v, cs_vfm_part_pos(v, hyps), cs_vfm_part_neg(v, hyps)))
fn cs_vfm_unsat(hyps, vars) = if cs_vfm_any_contra(hyps) == 1 then 1 else cs_vfm_unsat1(hyps, vars)
fn cs_vfm_unsat1(hyps, vars) = match vars
    Nil        => cs_vfm_any_contra(hyps)
    Cons(v, r) => let next = cs_vfm_elim_var(v, hyps) in if cs_vfm_any_contra(next) == 1 then 1 else if cs_len(next) > 48 then 0 else cs_vfm_unsat(next, r)
fn cs_vfm_check_unsat(hyps) = cs_vfm_unsat(hyps, cs_vfm_vars(hyps, Nil))
fn cs_vlin_init_env(ps) = match ps
    Nil        => Nil
    Cons(p, r) => Cons({k: p, v: cs_vlin_var(p)}, cs_vlin_init_env(r))
fn cs_vlin_lookup(nm, lenv) = match lenv
    Nil        => cs_vlin_err()
    Cons(h, t) => if h.k == nm then h.v else cs_vlin_lookup(nm, t)
fn cs_vlin_bind_ps(ps, vs) = match ps
    Nil        => Nil
    Cons(p, r) => cs_vlin_bind_p1(p, r, vs)
fn cs_vlin_bind_p1(p, r, vs) = match vs
    Nil         => Nil
    Cons(v, vr) => Cons({k: p, v: v}, cs_vlin_bind_ps(r, vr))
fn cs_vlin_expr(e, hyps, lenv, ft, d) = if d > 6 then cs_vlin_err() else cs_vlin_expr1(e, hyps, lenv, ft, d)
fn cs_vlin_expr1(e, hyps, lenv, ft, d) = match e
    Num(n)          => cs_vlin_const(n)
    Var(nm)         => cs_vlin_lookup(nm, lenv)
    OwnE(inner)     => cs_vlin_expr(inner, hyps, lenv, ft, d)
    MutE(inner)     => cs_vlin_expr(inner, hyps, lenv, ft, d)
    CT(inner)       => cs_vlin_expr(inner, hyps, lenv, ft, d)
    DeferE(c, b)    => cs_vlin_expr(b, hyps, lenv, ft, d)
    ErrDeferE(c, b) => cs_vlin_expr(b, hyps, lenv, ft, d)
    LetIn(nm, v, b) => let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then cs_vlin_err() else cs_vlin_expr(b, hyps, Cons({k: nm, v: lv}, lenv), ft, d)
    VarIn(nm, v, b) => let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then cs_vlin_err() else cs_vlin_expr(b, hyps, Cons({k: nm, v: lv}, lenv), ft, d)
    Bin(op, l, r)   => if op == "+" then cs_vlin_add(cs_vlin_expr(l, hyps, lenv, ft, d), cs_vlin_expr(r, hyps, lenv, ft, d)) else if op == "-" then cs_vlin_sub(cs_vlin_expr(l, hyps, lenv, ft, d), cs_vlin_expr(r, hyps, lenv, ft, d)) else if op == "*" then cs_vlin_mul(cs_vlin_expr(l, hyps, lenv, ft, d), cs_vlin_expr(r, hyps, lenv, ft, d)) else cs_vlin_err()
    If(c, t, e2)    => let rp = cs_vcond_pos(c, hyps, lenv, ft, d) in let rn = cs_vcond_neg(c, hyps, lenv, ft, d) in if rp.ok == 1 and rn.ok == 1 and cs_vfm_check_unsat(cs_app(rn.hyps, hyps)) == 1 then cs_vlin_expr(t, hyps, lenv, ft, d) else if rp.ok == 1 and rn.ok == 1 and cs_vfm_check_unsat(cs_app(rp.hyps, hyps)) == 1 then cs_vlin_expr(e2, hyps, lenv, ft, d) else cs_vlin_err()
    Call(cnm, args) => cs_vlin_call(cnm, args, hyps, lenv, ft, d)
    _               => cs_vlin_err()
fn cs_vlin_args(args, hyps, lenv, ft, d) = match args
    Nil        => {ok: 1, vals: Nil}
    Cons(h, t) => let rh = cs_vlin_expr(h, hyps, lenv, ft, d) in if rh.ok == 0 then {ok: 0, vals: Nil} else let rt = cs_vlin_args(t, hyps, lenv, ft, d) in if rt.ok == 0 then {ok: 0, vals: Nil} else {ok: 1, vals: Cons(rh, rt.vals)}
fn cs_vlin_call(cnm, args, hyps, lenv, ft, d) = if cnm == "old" and cs_len(args) == 1 then cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d) else if (cnm == "verify" or cnm == "law_check" or cnm == "evolve_approve" or cnm == "borrow" or cnm == "borrow_mut" or cnm == "move" or cnm == "clone") and cs_len(args) >= 1 then cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d) else if cnm == "dec_add" and cs_len(args) == 2 then cs_vlin_add(cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_sub" and cs_len(args) == 2 then cs_vlin_sub(cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else cs_vlin_ufn(cs_fnlookup(cnm, ft), cs_vlin_args(args, hyps, lenv, ft, d), hyps, ft, d)
fn cs_vlin_ufn(mf, ra, hyps, ft, d) = match mf
    Nil          => cs_vlin_err()
    Cons(fn0, r) => if ra.ok == 0 then cs_vlin_err() else cs_vlin_ufn2(fn0, ra.vals, hyps, ft, d)
fn cs_vlin_ufn2(fn0, vals, hyps, ft, d) = match fn0
    Fn(fnm, ps, body) => cs_vlin_expr(body, hyps, cs_vlin_bind_ps(ps, vals), ft, d + 1)
    _                 => cs_vlin_err()
fn cs_vcond_cmp_pos(op, la, lb) = if la.ok == 0 or lb.ok == 0 then {ok: 0, hyps: Nil} else if op == ">=" then {ok: 1, hyps: Cons(cs_vlin_sub(la, lb), Nil)} else if op == ">" then {ok: 1, hyps: Cons(cs_vlin_sub(cs_vlin_sub(la, lb), cs_vlin_const(1)), Nil)} else if op == "<=" then {ok: 1, hyps: Cons(cs_vlin_sub(lb, la), Nil)} else if op == "<" then {ok: 1, hyps: Cons(cs_vlin_sub(cs_vlin_sub(lb, la), cs_vlin_const(1)), Nil)} else if op == "==" then {ok: 1, hyps: Cons(cs_vlin_sub(la, lb), Cons(cs_vlin_sub(lb, la), Nil))} else {ok: 0, hyps: Nil}
fn cs_vcond_cmp_neg(op, la, lb) = if la.ok == 0 or lb.ok == 0 then {ok: 0, hyps: Nil} else if op == ">=" then cs_vcond_cmp_pos("<", la, lb) else if op == ">" then cs_vcond_cmp_pos("<=", la, lb) else if op == "<=" then cs_vcond_cmp_pos(">", la, lb) else if op == "<" then cs_vcond_cmp_pos(">=", la, lb) else if op == "!=" then cs_vcond_cmp_pos("==", la, lb) else {ok: 0, hyps: Nil}
fn cs_vcond_pos(e, hyps, lenv, ft, d) = match e
    Bin(op, a, b)   => if op == "and" then (let r1 = cs_vcond_pos(a, hyps, lenv, ft, d) in let r2 = cs_vcond_pos(b, hyps, lenv, ft, d) in if r1.ok == 1 and r2.ok == 1 then {ok: 1, hyps: cs_app(r1.hyps, r2.hyps)} else {ok: 0, hyps: Nil}) else cs_vcond_cmp_pos(op, cs_vlin_expr(a, hyps, lenv, ft, d), cs_vlin_expr(b, hyps, lenv, ft, d))
    Call(cnm, args) => if cnm == "dec_eq" and cs_len(args) == 2 then cs_vcond_cmp_pos("==", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_ge" and cs_len(args) == 2 then cs_vcond_cmp_pos(">=", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_gt" and cs_len(args) == 2 then cs_vcond_cmp_pos(">", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_le" and cs_len(args) == 2 then cs_vcond_cmp_pos("<=", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_lt" and cs_len(args) == 2 then cs_vcond_cmp_pos("<", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else {ok: 0, hyps: Nil}
    _               => {ok: 0, hyps: Nil}
fn cs_vcond_neg(e, hyps, lenv, ft, d) = match e
    Bin(op, a, b)   => cs_vcond_cmp_neg(op, cs_vlin_expr(a, hyps, lenv, ft, d), cs_vlin_expr(b, hyps, lenv, ft, d))
    Call(cnm, args) => if cnm == "dec_ge" and cs_len(args) == 2 then cs_vcond_cmp_neg(">=", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_gt" and cs_len(args) == 2 then cs_vcond_cmp_neg(">", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_le" and cs_len(args) == 2 then cs_vcond_cmp_neg("<=", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else if cnm == "dec_lt" and cs_len(args) == 2 then cs_vcond_cmp_neg("<", cs_vlin_expr(cs_asthead(args), hyps, lenv, ft, d), cs_vlin_expr(cs_astsecond(args), hyps, lenv, ft, d)) else {ok: 0, hyps: Nil}
    _               => {ok: 0, hyps: Nil}
fn cs_vprove_reqs_hyps(reqs, lenv, ft) = match reqs
    Nil        => {ok: 1, hyps: Nil}
    Cons(h, t) => let r1 = cs_vcond_pos(h, Nil, lenv, ft, 0) in if r1.ok == 0 then {ok: 0, hyps: Nil} else let r2 = cs_vprove_reqs_hyps(t, lenv, ft) in if r2.ok == 0 then {ok: 0, hyps: Nil} else {ok: 1, hyps: cs_app(r1.hyps, r2.hyps)}
fn cs_vprove_goal(g, hyps, lenv, ft, d) = match g
    Num(n)          => if n != 0 then 1 else 0
    LetIn(nm, v, b) => let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then 0 else cs_vprove_goal(b, hyps, Cons({k: nm, v: lv}, lenv), ft, d)
    VarIn(nm, v, b) => let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then 0 else cs_vprove_goal(b, hyps, Cons({k: nm, v: lv}, lenv), ft, d)
    DeferE(c, b)    => cs_vprove_goal(b, hyps, lenv, ft, d)
    ErrDeferE(c, b) => cs_vprove_goal(b, hyps, lenv, ft, d)
    If(c, t, e2)    => let rp = cs_vcond_pos(c, hyps, lenv, ft, d) in let rn = cs_vcond_neg(c, hyps, lenv, ft, d) in if rp.ok == 1 and cs_vprove_goal(t, cs_app(rp.hyps, hyps), lenv, ft, d) == 1 and (cs_vprove_goal(e2, hyps, lenv, ft, d) == 1 or (rn.ok == 1 and cs_vprove_goal(e2, cs_app(rn.hyps, hyps), lenv, ft, d) == 1)) then 1 else 0
    Bin(op, a, b)   => if op == "and" then (if cs_vprove_goal(a, hyps, lenv, ft, d) == 1 and cs_vprove_goal(b, hyps, lenv, ft, d) == 1 then 1 else 0) else if op == "or" then (let rna = cs_vcond_neg(a, hyps, lenv, ft, d) in if rna.ok == 1 and cs_vprove_goal(b, cs_app(rna.hyps, hyps), lenv, ft, d) == 1 then 1 else let rnb = cs_vcond_neg(b, hyps, lenv, ft, d) in if rnb.ok == 1 and cs_vprove_goal(a, cs_app(rnb.hyps, hyps), lenv, ft, d) == 1 then 1 else 0) else if op == "==" then (if cs_vprove_goal(Bin(">=", a, b), hyps, lenv, ft, d) == 1 and cs_vprove_goal(Bin("<=", a, b), hyps, lenv, ft, d) == 1 then 1 else 0) else (let rn = cs_vcond_neg(g, hyps, lenv, ft, d) in if rn.ok == 1 then cs_vfm_check_unsat(cs_app(rn.hyps, hyps)) else 0)
    Call(cnm, args) => if cnm == "dec_eq" and cs_len(args) == 2 then cs_vprove_goal(Bin("==", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "dec_ge" and cs_len(args) == 2 then cs_vprove_goal(Bin(">=", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "dec_gt" and cs_len(args) == 2 then cs_vprove_goal(Bin(">", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "dec_le" and cs_len(args) == 2 then cs_vprove_goal(Bin("<=", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else if cnm == "dec_lt" and cs_len(args) == 2 then cs_vprove_goal(Bin("<", cs_asthead(args), cs_astsecond(args)), hyps, lenv, ft, d) else 0
    _               => 0
fn cs_vprove_goals_all(enss, hyps, lenv, ft, d) = match enss
    Nil        => 1
    Cons(h, t) => if cs_vprove_goal(h, hyps, lenv, ft, d) == 1 then cs_vprove_goals_all(t, hyps, lenv, ft, d) else 0
fn cs_vprove_body(body, hyps, lenv, enss, ft, d) = match body
    LetIn(nm, v, b) => let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then 0 else cs_vprove_body(b, hyps, Cons({k: nm, v: lv}, lenv), enss, ft, d)
    VarIn(nm, v, b) => let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then 0 else cs_vprove_body(b, hyps, Cons({k: nm, v: lv}, lenv), enss, ft, d)
    DeferE(c, b)    => cs_vprove_body(b, hyps, lenv, enss, ft, d)
    ErrDeferE(c, b) => cs_vprove_body(b, hyps, lenv, enss, ft, d)
    If(c, t, e2)    => let rp = cs_vcond_pos(c, hyps, lenv, ft, d) in let rn = cs_vcond_neg(c, hyps, lenv, ft, d) in if rp.ok == 1 and rn.ok == 1 and cs_vprove_body(t, cs_app(rp.hyps, hyps), lenv, enss, ft, d) == 1 and cs_vprove_body(e2, cs_app(rn.hyps, hyps), lenv, enss, ft, d) == 1 then 1 else 0
    _               => let lb = cs_vlin_expr(body, hyps, lenv, ft, d) in if lb.ok == 0 then 0 else let penv = Cons({k: "result", v: lb}, Cons({k: "ret", v: lb}, lenv)) in cs_vprove_goals_all(enss, hyps, penv, ft, d)
fn cs_vqflia_prove_fn(ps, reqs, enss, body, ft) = if cs_isnil(enss) == 1 then 0 else let lenv = cs_vlin_init_env(ps) in let rh = cs_vprove_reqs_hyps(reqs, lenv, ft) in if rh.ok == 0 then 0 else cs_vprove_body(body, rh.hyps, lenv, enss, ft, 0)
fn cs_vqflia_prove_law(ps, body, ft) = let lenv = cs_vlin_init_env(ps) in if cs_vprove_goal(body, Nil, lenv, ft, 0) == 1 then 1 else if cs_len(ps) == 1 then let p0 = cs_vlin_var(cs_hd_str(ps, "")) in let hneg = Cons(cs_vlin_sub(cs_vlin_const(0 - 1), p0), Nil) in let hpos = Cons(p0, Nil) in if cs_vprove_goal(body, hneg, lenv, ft, 0) == 1 and cs_vprove_goal(body, hpos, lenv, ft, 0) == 1 then 1 else 0 else 0
fn cs_vneg_goal_hyps(g, hyps, lenv, ft, d) = match g
    Bin(op, a, b) => if op == "and" then cs_app(cs_vneg_goal_hyps(a, hyps, lenv, ft, d), cs_vneg_goal_hyps(b, hyps, lenv, ft, d)) else if op == "==" then cs_app((cs_vcond_cmp_pos(">", cs_vlin_expr(a, hyps, lenv, ft, d), cs_vlin_expr(b, hyps, lenv, ft, d))).hyps, (cs_vcond_cmp_pos("<", cs_vlin_expr(a, hyps, lenv, ft, d), cs_vlin_expr(b, hyps, lenv, ft, d))).hyps) else (cs_vcond_neg(g, hyps, lenv, ft, d)).hyps
    _             => Nil
fn cs_vneg_goals_hyps(enss, hyps, penv, ft, d) = match enss
    Nil        => Nil
    Cons(g, r) => cs_app(cs_vneg_goal_hyps(g, hyps, penv, ft, d), cs_vneg_goals_hyps(r, hyps, penv, ft, d))
fn cs_vcollect_body_hyps(body, hyps, lenv, enss, ft, d) = match body
    LetIn(nm, v, b) => let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then hyps else cs_vcollect_body_hyps(b, hyps, Cons({k: nm, v: lv}, lenv), enss, ft, d)
    VarIn(nm, v, b) => let lv = cs_vlin_expr(v, hyps, lenv, ft, d) in if lv.ok == 0 then hyps else cs_vcollect_body_hyps(b, hyps, Cons({k: nm, v: lv}, lenv), enss, ft, d)
    DeferE(c, b)    => cs_vcollect_body_hyps(b, hyps, lenv, enss, ft, d)
    ErrDeferE(c, b) => cs_vcollect_body_hyps(b, hyps, lenv, enss, ft, d)
    If(c, t, e2)    => let rp = cs_vcond_pos(c, hyps, lenv, ft, d) in let rn = cs_vcond_neg(c, hyps, lenv, ft, d) in cs_app(cs_vcollect_body_hyps(t, cs_app(rp.hyps, hyps), lenv, enss, ft, d), cs_vcollect_body_hyps(e2, cs_app(rn.hyps, hyps), lenv, enss, ft, d))
    _               => let lb = cs_vlin_expr(body, hyps, lenv, ft, d) in if lb.ok == 0 then hyps else let penv = Cons({k: "result", v: lb}, Cons({k: "ret", v: lb}, lenv)) in cs_app(cs_vneg_goals_hyps(enss, hyps, penv, ft, d), hyps)
fn cs_vmem_int(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else cs_vmem_int(x, t)
fn cs_vadd_int_uniq(x, xs) = if cs_vmem_int(x, xs) == 1 or cs_len(xs) >= 6 then xs else cs_app(xs, Cons(x, Nil))
fn cs_vpts_from_hyps(p, hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => let c = cs_vlin_coeff(p, h.cs) in if c == 0 then cs_vpts_from_hyps(p, t, acc) else let b = (0 - h.c0) / c in cs_vpts_from_hyps(p, t, cs_vadd_int_uniq(b + 1, cs_vadd_int_uniq(b, acc)))
fn cs_vfm_trace_hyps(hyps, vars) = match vars
    Nil        => hyps
    Cons(v, r) => let next = cs_vfm_elim_var(v, hyps) in if cs_len(next) > 32 then hyps else cs_app(hyps, cs_vfm_trace_hyps(next, r))
fn cs_vgen_envs_hyps(ps, idx, total, chyps) = match ps
    Nil        => Cons(Nil, Nil)
    Cons(p, r) => cs_vcross_p(p, cs_vpts_from_hyps(p, chyps, cs_vpts_for(idx, total)), cs_vgen_envs_hyps(r, idx + 1, total, chyps))

fn cs_vprove_fn(nm, ps, body, mvs, ft) = match mvs
    Nil          => {proofs: Nil, diags: Nil}
    Cons(vsg, r) => let lenv = cs_vlin_init_env(ps) in let raw_hyps = cs_vcollect_body_hyps(body, (cs_vprove_reqs_hyps(vsg.reqs, lenv, ft)).hyps, lenv, vsg.enss, ft, 0) in let chyps = cs_vfm_trace_hyps(raw_hyps, cs_vfm_vars(raw_hyps, Nil)) in let pr = cs_vprove_envs(cs_vgen_envs_hyps(ps, 0, cs_len(ps), chyps), vsg.reqs, vsg.enss, body, ft, 0) in let st = if pr.status == "refuted" then "refuted" else if cs_vqflia_prove_fn(ps, vsg.reqs, vsg.enss, body, ft) == 1 then "proven" else "runtime_checked" in let ob = cs_exprs_sexpr(vsg.reqs) + " => " + cs_exprs_sexpr(vsg.enss) in let pf = Cons({name: nm, kind: "contract", status: st, obligation: ob, counterexample: pr.cex}, Nil) in let dg = if st == "refuted" then Cons(cs_mkdiag("V0001", "contract", "contract error: cannot prove 'ensures' postcondition of '" + nm + "' — refuted with counterexample: " + pr.cex, "strengthen 'requires' precondition or fix implementation of '" + nm + "'"), Nil) else Nil in {proofs: pf, diags: dg}
fn cs_vchk_call_req(cnm, args, fnm, mvs, ft) = match mvs
    Nil          => {proofs: Nil, diags: Nil}
    Cons(vsg, r) => if cs_isnil(vsg.reqs) == 1 then {proofs: Nil, diags: Nil} else let ra = cs_veval_args(args, Nil, Nil, ft, 0) in if ra.ok == 0 then {proofs: Nil, diags: Nil} else let env = cs_vbind_ps(vsg.ps, ra.vals) in let rq = cs_veval_all_true(vsg.reqs, env, env, ft) in if rq.ok == 1 and rq.hold == 0 then let cex = cs_vfmt_env(env) in {proofs: Cons({name: cnm, kind: "call_requires", status: "refuted", obligation: cs_exprs_sexpr(vsg.reqs), counterexample: cex}, Nil), diags: Cons(cs_mkdiag("V0001", "contract", "contract error: call to '" + cnm + "' in '" + fnm + "' violates 'requires' precondition with counterexample: " + cex, "ensure arguments passed to '" + cnm + "' satisfy its 'requires' contract"), Nil)} else {proofs: Nil, diags: Nil}
fn cs_vchk_rect_inv(tn, items, fnm, miv, ft) = match miv
    Nil         => {proofs: Nil, diags: Nil}
    Cons(iv, r) => let rr = cs_veval_rec(items, Nil, Nil, ft, 0) in if rr.ok == 0 then {proofs: Nil, diags: Nil} else let env = cs_vfields_env(rr.fields) in let ri = cs_veval(iv.inv, env, env, ft, 0) in if ri.ok == 1 and ri.i == 0 then let cex = cs_vfmt_env(env) in {proofs: Cons({name: tn, kind: "invariant", status: "refuted", obligation: cs_expr_sexpr(iv.inv), counterexample: cex}, Nil), diags: Cons(cs_mkdiag("V0001", "contract", "contract error: record construction of '" + tn + "' in '" + fnm + "' violates type 'invariant' with counterexample: " + cex, "satisfy the 'invariant' of '" + tn + "' before constructing the record"), Nil)} else {proofs: Nil, diags: Nil}
fn cs_vchk_expr_e(e, fnm, vsigs, invs, ft) = match e
    Call(cnm, args) => let r1 = cs_vchk_call_req(cnm, args, fnm, cs_vsiglookup(cnm, vsigs), ft) in let r2 = cs_vchk_args_e(args, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
    RecT(tn, items) => let r1 = cs_vchk_rect_inv(tn, items, fnm, cs_vinvlookup(tn, invs), ft) in let r2 = cs_vchk_rec_e(items, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
    Rec(items)      => cs_vchk_rec_e(items, fnm, vsigs, invs, ft)
    Field(o, fld)   => cs_vchk_expr_e(o, fnm, vsigs, invs, ft)
    Bin(op, l, r)   => let r1 = cs_vchk_expr_e(l, fnm, vsigs, invs, ft) in let r2 = cs_vchk_expr_e(r, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
    If(c, t, e2)    => let r1 = cs_vchk_expr_e(c, fnm, vsigs, invs, ft) in let r2 = cs_vchk_expr_e(t, fnm, vsigs, invs, ft) in let r3 = cs_vchk_expr_e(e2, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, cs_app(r2.proofs, r3.proofs)), diags: cs_app(r1.diags, cs_app(r2.diags, r3.diags))}
    LetIn(nm, v, b) => let r1 = cs_vchk_expr_e(v, fnm, vsigs, invs, ft) in let r2 = cs_vchk_expr_e(b, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
    VarIn(nm, v, b) => let r1 = cs_vchk_expr_e(v, fnm, vsigs, invs, ft) in let r2 = cs_vchk_expr_e(b, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
    _               => {proofs: Nil, diags: Nil}
fn cs_vchk_args_e(args, fnm, vsigs, invs, ft) = match args
    Nil        => {proofs: Nil, diags: Nil}
    Cons(h, t) => let r1 = cs_vchk_expr_e(h, fnm, vsigs, invs, ft) in let r2 = cs_vchk_args_e(t, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
fn cs_vchk_rec_e(items, fnm, vsigs, invs, ft) = match items
    Nil        => {proofs: Nil, diags: Nil}
    Cons(h, t) => let r1 = cs_vchk_expr_e(h.val, fnm, vsigs, invs, ft) in let r2 = cs_vchk_rec_e(t, fnm, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, r2.proofs), diags: cs_app(r1.diags, r2.diags)}
fn cs_vprove_stmts(prog, vsigs, invs, ft) = match prog
    Nil        => {proofs: Nil, diags: Nil}
    Cons(h, t) => cs_vprove_stmt1(h, t, vsigs, invs, ft)
fn cs_vprove_stmt1(st, rest, vsigs, invs, ft) = match st
    VLawDecl(nm, ps, body)      => let lenv = cs_vlin_init_env(ps) in let chyps = cs_vcollect_body_hyps(body, Nil, lenv, Cons(body, Nil), ft, 0) in let pr = cs_vprove_law_envs(cs_vgen_envs_hyps(ps, 0, cs_len(ps), chyps), body, ft, 0) in let lst = if pr.status == "refuted" then "refuted" else if cs_vqflia_prove_law(ps, body, ft) == 1 then "proven" else "runtime_checked" in let pf = Cons({name: nm, kind: "law", status: lst, obligation: cs_expr_sexpr(body), counterexample: pr.cex}, Nil) in let dg = if lst == "refuted" then Cons(cs_mkdiag("V0001", "law", "contract error: law '" + nm + "' refuted with counterexample: " + pr.cex, "fix the implementation or refine law '" + nm + "'"), Nil) else Nil in let rr = cs_vprove_stmts(rest, vsigs, invs, ft) in {proofs: cs_app(pf, rr.proofs), diags: cs_app(dg, rr.diags)}
    VTypeInvariant(nm, fs, inv) => let pf = Cons({name: nm, kind: "invariant", status: "runtime_checked", obligation: cs_expr_sexpr(inv), counterexample: ""}, Nil) in let rr = cs_vprove_stmts(rest, vsigs, invs, ft) in {proofs: cs_app(pf, rr.proofs), diags: rr.diags}
    Fn(nm, ps, body)            => let r1 = cs_vprove_fn(nm, ps, body, cs_vsiglookup(nm, vsigs), ft) in let r2 = cs_vchk_expr_e(body, nm, vsigs, invs, ft) in let rr = cs_vprove_stmts(rest, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, cs_app(r2.proofs, rr.proofs)), diags: cs_app(r1.diags, cs_app(r2.diags, rr.diags))}
    Print(v)                    => let r1 = cs_vchk_expr_e(v, "<main>", vsigs, invs, ft) in let rr = cs_vprove_stmts(rest, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, rr.proofs), diags: cs_app(r1.diags, rr.diags)}
    ExprS(v)                    => let r1 = cs_vchk_expr_e(v, "<main>", vsigs, invs, ft) in let rr = cs_vprove_stmts(rest, vsigs, invs, ft) in {proofs: cs_app(r1.proofs, rr.proofs), diags: cs_app(r1.diags, rr.diags)}
    _                           => cs_vprove_stmts(rest, vsigs, invs, ft)
fn cs_vprove_all(prog) = cs_vprove_stmts(prog, cs_vcollect_vsigs(prog), cs_vcollect_invs(prog), cs_buildft(prog))

fn cs_ochk_fn(nm, ps, body, msig, osigs, sigs, kt) = match msig
    Nil          => let dk = cs_kchk_fn(nm, 0, body, kt) in let ds = cs_schk_conc_e(body, nm, 0, cs_sinit_ns_sig(cs_siglookup(nm, sigs)), Nil) in let rp = cs_achk_prov_e(body, nm, cs_uinit_sig(cs_siglookup(nm, sigs)), osigs, sigs) in let ctx = {fnm: nm, pubf: 0, freef: 0, halloc: 0, bparams: ps, mvars: Nil, origins: cs_oinit_orgs(ps), osigs: osigs} in let rb = cs_ochke(body, ctx, Nil) in cs_app(dk, cs_app(ds, cs_app(rp.diags, cs_app(rb.diags, cs_ochk_ret(nm, 0, "", rb.origin)))))
    Cons(sg, sr) => let dk = cs_kchk_fn(nm, sg.pubf, body, kt) in let mvars = cs_omvars(sg.pl) in let ds = cs_schk_conc_e(body, nm, 0, cs_sinit_ns_sig(cs_siglookup(nm, sigs)), mvars) in let dtot = if cs_ois_total(sg.freef) == 1 then cs_achk_total_e(body, nm, ps, Nil, Nil) else Nil in let rp = cs_achk_prov_e(body, nm, cs_uinit_sig(cs_siglookup(nm, sigs)), osigs, sigs) in let dret = if sg.pubf == 1 and cs_ois_llm(sg.freef) == 0 and cs_is_unv_ty(sg.rty) == 0 and rp.taint == 1 then Cons(cs_mkdiag("A0003", "provenance", "provenance error: unverified AI/probabilistic value cannot be returned from trusted 'pub fn " + nm + "' without verification", "wrap the return value in 'verify(val, <contract>)'"), Nil) else Nil in let bparams = if cs_isnil(sg.pl) == 1 then ps else cs_obparams(sg.pl) in let ctx = {fnm: nm, pubf: sg.pubf, freef: sg.freef, halloc: 0, bparams: bparams, mvars: mvars, origins: cs_oinit_orgs(ps), osigs: osigs} in let rb = cs_ochke(body, ctx, Nil) in cs_app(dk, cs_app(ds, cs_app(dtot, cs_app(rp.diags, cs_app(dret, cs_app(rb.diags, cs_ochk_ret(nm, sg.pubf, sg.fromp, rb.origin)))))))
fn cs_odiagnose_stmts(prog, osigs, sigs, kt, moved) = match prog
    Nil        => Nil
    Cons(h, t) => cs_odiagnose_stmt1(h, t, osigs, sigs, kt, moved)
fn cs_odiagnose_stmt1(s0, rest, osigs, sigs, kt, moved) = match s0
    Fn(nm, ps, body) => cs_app(cs_ochk_fn(nm, ps, body, cs_osiglookup(nm, osigs), osigs, sigs, kt), cs_odiagnose_stmts(rest, osigs, sigs, kt, moved))
    Print(v)         => let r = cs_ochke(v, {fnm: "<main>", pubf: 0, freef: 0, halloc: 0, bparams: Nil, mvars: Nil, origins: Nil, osigs: osigs}, moved) in cs_app(r.diags, cs_odiagnose_stmts(rest, osigs, sigs, kt, r.moved))
    ExprS(v)         => let r = cs_ochke(v, {fnm: "<main>", pubf: 0, freef: 0, halloc: 0, bparams: Nil, mvars: Nil, origins: Nil, osigs: osigs}, moved) in cs_app(r.diags, cs_odiagnose_stmts(rest, osigs, sigs, kt, r.moved))
    _                => cs_odiagnose_stmts(rest, osigs, sigs, kt, moved)

fn cs_diagnose_stmts(prog, tt) = match prog
    Nil        => Nil
    Cons(h, t) => cs_app(cs_diagnose_stmt(h, tt), cs_diagnose_stmts(t, tt))
fn cs_diagnose_stmt(s0, tt) = match s0
    Fn(nm, ps, body) => cs_app(cs_chk_ret(nm, body, tt), cs_chk_expr(body, tt))
    Print(v)         => cs_chk_expr(v, tt)
    ExprS(v)         => cs_chk_expr(v, tt)
    _                => Nil
fn cs_diagnose(prog) = let tt = cs_tcollect(prog) in let osigs = cs_ocollects(prog) in let kt = {ksigs: cs_kcollect_effsigs(prog), edecls: cs_kcollect_effdecls(prog), caps: cs_kcollect_caps(prog)} in let hr = cs_collect_holes_stmts(prog, tt.sigs, osigs) in let vr = cs_vprove_all(prog) in cs_app(cs_diagnose_stmts(prog, tt), cs_app(hr.diags, cs_app(vr.diags, cs_odiagnose_stmts(prog, osigs, tt.sigs, kt, Nil))))

## --- C3 generic erasure & C1/C2/M1/M2 comptime + hygienic macro expansion ---
fn cs_gcfs(pl) = match pl
    Nil        => Nil
    Cons(p, r) => Cons(p.cf, cs_gcfs(r))
fn cs_gcoll(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_gcoll2(h, t)
fn cs_gcoll2(h, t) = match h
    GSig(nm, pl, rt) => Cons({fname: nm, cfs: cs_gcfs(pl)}, cs_gcoll(t))
    _                => cs_gcoll(t)
fn cs_gtlookup(nm, gt) = match gt
    Nil        => Nil
    Cons(h, t) => if h.fname == nm then Cons(h, Nil) else cs_gtlookup(nm, t)
fn cs_gefilter(args, cfs) = match cfs
    Nil         => args
    Cons(c, cr) => cs_gefilter2(args, c, cr)
fn cs_gefilter2(args, c, cr) = match args
    Nil         => Nil
    Cons(a, ar) => if c == 1 then cs_gefilter(ar, cr) else Cons(a, cs_gefilter(ar, cr))
fn cs_gecall(nm, ea, m) = match m
    Nil        => if (nm == "borrow" or nm == "borrow_mut" or nm == "move" or nm == "clone") and cs_len(ea) == 1 then cs_asthead(ea) else Call(nm, ea)
    Cons(g, r) => Call(nm, cs_gefilter(ea, g.cfs))
fn cs_geexpr(e, gt) = match e
    Bin(op, a, b)    => Bin(op, cs_geexpr(a, gt), cs_geexpr(b, gt))
    If(c, t, e2)     => If(cs_geexpr(c, gt), cs_geexpr(t, gt), cs_geexpr(e2, gt))
    LetIn(nm, v, b)  => LetIn(nm, cs_geexpr(v, gt), cs_geexpr(b, gt))
    VarIn(nm, v, b)  => LetIn(nm, cs_geexpr(v, gt), cs_geexpr(b, gt))
    OwnE(inner)      => cs_geexpr(inner, gt)
    MutE(inner)      => cs_geexpr(inner, gt)
    DeferE(c, b)     => LetIn("_d_val", cs_geexpr(b, gt), LetIn("_d_run", cs_geexpr(c, gt), Var("_d_val")))
    ErrDeferE(c, b)  => LetIn("_ed_val", cs_geexpr(b, gt), If(Bin("<", Var("_ed_val"), Num(0)), LetIn("_ed_run", cs_geexpr(c, gt), Var("_ed_val")), Var("_ed_val")))
    WithAllocE(a, b) => LetIn("_alloc_ctx", cs_geexpr(a, gt), cs_geexpr(b, gt))
    WithHandlerE(en, hs, b) => WithHandlerE(en, hs, cs_geexpr(b, gt))
    ScopeE(snm, b)   => LetIn(snm, Num(1), cs_geexpr(b, gt))
    SpawnE(inner)    => cs_geexpr(inner, gt)
    Call(nm, args)   => cs_gecall(nm, cs_geargs(args, gt), cs_gtlookup(nm, gt))
    Rec(items)       => Rec(cs_gerec(items, gt))
    RecT(tn, items)  => RecT(tn, cs_gerec(items, gt))
    Field(o, nm)     => Field(cs_geexpr(o, gt), nm)
    Match(sc, arms)  => Match(cs_geexpr(sc, gt), cs_gearms(arms, gt))
    CT(inner)        => CT(cs_geexpr(inner, gt))
    Quote(inner)     => Quote(cs_geexpr(inner, gt))
    Splice(inner)    => Splice(cs_geexpr(inner, gt))
    _                => e
fn cs_geargs(xs, gt) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_geexpr(h, gt), cs_geargs(t, gt))
fn cs_gerec(xs, gt) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: cs_geexpr(h.val, gt)}, cs_gerec(t, gt))
fn cs_gearms(xs, gt) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: cs_geexpr(h.body, gt)}, cs_gearms(t, gt))
fn cs_gerase_stmt(h, gt) = match h
    Fn(nm, ps, body) => Fn(nm, ps, cs_geexpr(body, gt))
    Print(v)         => Print(cs_geexpr(v, gt))
    ExprS(v)         => ExprS(cs_geexpr(v, gt))
    _                => h
fn cs_gerase_stmts(prog, gt) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(cs_gerase_stmt(h, gt), cs_gerase_stmts(t, gt))
fn cs_gerase(prog) = cs_gerase_stmts(prog, cs_gcoll(prog))

fn cs_ctnode(cv) = if cv.kind == "int" then Num(cv.i) else if cv.kind == "str" then Str(cv.s) else if cs_isnil(cv.items) == 1 then Var(cv.s) else Call(cv.s, cs_ctnodelist(cv.items))
fn cs_ctnodelist(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_ctnode(h), cs_ctnodelist(t))
fn cs_ishyg(nm) = cs_startswith(nm, "_hyg_")
fn cs_chyg(e, renv, n) = match e
    Var(nm)         => {node: Var(cs_qvar(nm, renv)), n: n}
    LetIn(nm, v, b) => let rv = cs_chyg(v, renv, n) in if cs_ishyg(nm) == 1 then let nnm = "_hyg_" + str(rv.n) in let rb = cs_chyg(b, Cons({k: nm, v: nnm}, renv), rv.n + 1) in {node: LetIn(nnm, rv.node, rb.node), n: rb.n} else let rb = cs_chyg(b, Cons({k: nm, v: nm}, renv), rv.n) in {node: LetIn(nm, rv.node, rb.node), n: rb.n}
    Bin(op, a, b)   => let ra = cs_chyg(a, renv, n) in let rb = cs_chyg(b, renv, ra.n) in {node: Bin(op, ra.node, rb.node), n: rb.n}
    If(c, t, e2)    => let rc = cs_chyg(c, renv, n) in let rt = cs_chyg(t, renv, rc.n) in let re = cs_chyg(e2, renv, rt.n) in {node: If(rc.node, rt.node, re.node), n: re.n}
    Call(nm, args)  => let rl = cs_chyglist(args, renv, n) in {node: Call(nm, rl.items), n: rl.n}
    _               => {node: e, n: n}
fn cs_chyglist(xs, renv, n) = match xs
    Nil        => {items: Nil, n: n}
    Cons(h, t) => let rh = cs_chyg(h, renv, n) in let rt = cs_chyglist(t, renv, rh.n) in {items: Cons(rh.node, rt.items), n: rt.n}

fn cs_folde(e, ft) = match e
    CT(inner)       => let r = cs_ceval(inner, Nil, ft, 0) in if r.ok == 1 then cs_ctnode(r.v) else e
    Splice(inner)   => let r = cs_ceval(inner, Nil, ft, 0) in if r.ok == 0 then e else let u = cs_unreify(r.v) in if u.ok == 1 then cs_folde(u.node, ft) else e
    Bin(op, a, b)   => Bin(op, cs_folde(a, ft), cs_folde(b, ft))
    If(c, t, e2)    => If(cs_folde(c, ft), cs_folde(t, ft), cs_folde(e2, ft))
    LetIn(nm, v, b) => LetIn(nm, cs_folde(v, ft), cs_folde(b, ft))
    WithHandlerE(en, hs, b) => WithHandlerE(en, hs, cs_folde(b, ft))
    Call(nm, args)  => Call(nm, cs_foldeargs(args, ft))
    _               => e
fn cs_foldeargs(xs, ft) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cs_folde(h, ft), cs_foldeargs(t, ft))
fn cs_foldstmt(h, ft) = match h
    Fn(nm, ps, body) => Fn(nm, ps, (cs_chyg(cs_folde(body, ft), Nil, 1)).node)
    Print(v)         => Print((cs_chyg(cs_folde(v, ft), Nil, 1)).node)
    ExprS(v)         => ExprS((cs_chyg(cs_folde(v, ft), Nil, 1)).node)
    _                => h
fn cs_foldstmts(prog, ft) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(cs_foldstmt(h, ft), cs_foldstmts(t, ft))
fn cs_expand(prog) = let er = cs_gerase(prog) in cs_foldstmts(er, cs_buildft(er))

## --- canonical AST S-expression formatter ---
fn cs_expr_sexpr(e) = match e
    Num(n)          => str(n)
    Str(v)          => "\"" + cs_jesc(v) + "\""
    Var(nm)         => nm
    Bin(op, a, b)   => "(" + op + " " + cs_expr_sexpr(a) + " " + cs_expr_sexpr(b) + ")"
    If(c, t, e2)    => "(if " + cs_expr_sexpr(c) + " " + cs_expr_sexpr(t) + " " + cs_expr_sexpr(e2) + ")"
    LetIn(nm, v, b)  => "(let " + nm + " " + cs_expr_sexpr(v) + " " + cs_expr_sexpr(b) + ")"
    VarIn(nm, v, b)  => "(var " + nm + " " + cs_expr_sexpr(v) + " " + cs_expr_sexpr(b) + ")"
    OwnE(inner)      => "(own " + cs_expr_sexpr(inner) + ")"
    MutE(inner)      => "(mut " + cs_expr_sexpr(inner) + ")"
    DeferE(c, b)     => "(defer " + cs_expr_sexpr(c) + " " + cs_expr_sexpr(b) + ")"
    ErrDeferE(c, b)  => "(errdefer " + cs_expr_sexpr(c) + " " + cs_expr_sexpr(b) + ")"
    WithAllocE(a, b) => "(with-alloc " + cs_expr_sexpr(a) + " " + cs_expr_sexpr(b) + ")"
    WithHandlerE(en, hs, b) => "(with-handler " + en + " " + cs_expr_sexpr(b) + ")"
    ScopeE(snm, b)   => "(scope " + snm + " " + cs_expr_sexpr(b) + ")"
    SpawnE(inner)    => "(spawn " + cs_expr_sexpr(inner) + ")"
    Call(nm, args)  => if cs_isnil(args) == 1 then "(" + nm + ")" else "(" + nm + " " + cs_exprs_sexpr(args) + ")"
    CT(inner)       => "(comptime " + cs_expr_sexpr(inner) + ")"
    Quote(inner)    => "(quote " + cs_expr_sexpr(inner) + ")"
    Splice(inner)   => "(splice " + cs_expr_sexpr(inner) + ")"
    Rec(items)      => "(record)"
    RecT(tn, items) => "(" + tn + "{...})"
    Field(o, nm)    => "(field " + cs_expr_sexpr(o) + " " + nm + ")"
    Match(sc, arms) => "(match " + cs_expr_sexpr(sc) + ")"
    _               => "?"
fn cs_exprs_sexpr(xs) = match xs
    Nil        => ""
    Cons(h, t) => if cs_isnil(t) == 1 then cs_expr_sexpr(h) else cs_expr_sexpr(h) + " " + cs_exprs_sexpr(t)
fn cs_stmt_sexpr(s0) = match s0
    Fn(nm, ps, body) => Cons("(fn " + nm + " (" + cs_joinsep(ps, " ") + ") " + cs_expr_sexpr(body) + ")", Nil)
    Print(v)         => Cons("(print " + cs_expr_sexpr(v) + ")", Nil)
    ExprS(v)         => Cons(cs_expr_sexpr(v), Nil)
    _                => Nil
fn cs_prog_sexprs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cs_app(cs_stmt_sexpr(h), cs_prog_sexprs(t))
fn cs_prog_sexpr(prog) = cs_joinsep(cs_prog_sexprs(prog), " ")

## --- native x86-64 assembly emitter (`asm` output) ---
fn cs_asm_expr(e) = match e
    Num(n)          => "    movq $" + str(n) + ", %rax\n"
    Var(nm)         => "    # var " + nm + "\n"
    Bin(op, a, b)   => cs_asm_expr(a) + "    pushq %rax\n" + cs_asm_expr(b) + "    movq %rax, %rcx\n    popq %rax\n" + (if op == "+" then "    movq %rax, %rdi\n    movq %rcx, %rsi\n    call addv\n" else if op == "-" then "    subq %rcx, %rax\n" else if op == "*" then "    imulq %rcx, %rax\n" else "    # op " + op + "\n")
    Call(nm, args)  => cs_asm_args(args) + "    call " + nm + "\n"
    LetIn(nm, v, b) => cs_asm_expr(v) + cs_asm_expr(b)
    If(c, t, e2)    => cs_asm_expr(c) + cs_asm_expr(t) + cs_asm_expr(e2)
    _               => ""
fn cs_asm_args(xs) = match xs
    Nil        => ""
    Cons(h, t) => cs_asm_expr(h) + "    movq %rax, %rdi\n" + cs_asm_args(t)
fn cs_asm_fn1(h) = match h
    Fn(nm, ps, body) => nm + ":\n    pushq %rbp\n    movq %rsp, %rbp\n" + cs_asm_expr(body) + "    movq %rbp, %rsp\n    popq %rbp\n    ret\n"
    _                => ""
fn cs_asm_fns(prog) = match prog
    Nil        => ""
    Cons(h, t) => cs_asm_fn1(h) + cs_asm_fns(t)
fn cs_asm_main1(h) = match h
    Print(v) => cs_asm_expr(v) + "    movq %rax, %rdi\n    call printval\n"
    ExprS(v) => cs_asm_expr(v)
    _        => ""
fn cs_asm_main(prog) = match prog
    Nil        => ""
    Cons(h, t) => cs_asm_main1(h) + cs_asm_main(t)
fn cs_asm_gen(prog) = ".text\n.globl _start\n" + cs_asm_fns(prog) + "_start:\n" + cs_asm_main(prog) + "    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n"

## --- in-memory program evaluation (`result` output) ---
fn cs_cv_show(cv) = if cv.kind == "int" then str(cv.i) else if cv.kind == "str" then cv.s else if cv.kind == "ctor" then (if cs_isnil(cv.items) == 1 then cv.s else cv.s + "(" + cs_cv_showlist(cv.items) + ")") else "{...}"
fn cs_cv_showlist(xs) = match xs
    Nil        => ""
    Cons(h, t) => if cs_isnil(t) == 1 then cs_cv_show(h) else cs_cv_show(h) + ", " + cs_cv_showlist(t)
fn cs_eval_stmt1(h, t, ft) = match h
    Print(v) => let r = cs_ceval(v, Nil, ft, 0) in if r.ok == 1 then Cons(cs_cv_show(r.v), cs_eval_stmts(t, ft)) else cs_eval_stmts(t, ft)
    _        => cs_eval_stmts(t, ft)
fn cs_eval_stmts(prog, ft) = match prog
    Nil        => Nil
    Cons(h, t) => cs_eval_stmt1(h, t, ft)
fn cs_eval_prog(prog) = cs_joinsep(cs_eval_stmts(prog, cs_buildft(prog)), "\n")

## --- PUBLIC CALLABLE LIBRARY API (`use lcaas`) ---
fn cs_collect_holes(prog) = let tt = cs_tcollect(prog) in let osigs = cs_ocollects(prog) in (cs_collect_holes_stmts(prog, tt.sigs, osigs)).holes
fn caas_compile(src) = let ast = cs_parse(src) in let syms = cs_symbols(ast) in let tt = cs_tcollect(ast) in let osigs = cs_ocollects(ast) in let kt = {ksigs: cs_kcollect_effsigs(ast), edecls: cs_kcollect_effdecls(ast), caps: cs_kcollect_caps(ast)} in let hr = cs_collect_holes_stmts(ast, tt.sigs, osigs) in let vr = cs_vprove_stmts(ast, cs_vcollect_vsigs(ast), cs_vcollect_invs(ast), tt.ft) in let diags = cs_app(cs_diagnose_stmts(ast, tt), cs_app(hr.diags, cs_app(vr.diags, cs_odiagnose_stmts(ast, osigs, tt.sigs, kt, Nil)))) in let raw_sexpr = cs_prog_sexpr(ast) in if cs_isnil(diags) == 0 then {ok: 0, diagnostics: diags, holes: hr.holes, proofs: vr.proofs, symbols: syms, ast: ast, ast_sexpr: raw_sexpr, expanded: Nil, expanded_sexpr: "", asm: "", result: ""} else let exp = cs_expand(ast) in {ok: 1, diagnostics: Nil, holes: hr.holes, proofs: vr.proofs, symbols: syms, ast: ast, ast_sexpr: raw_sexpr, expanded: exp, expanded_sexpr: cs_prog_sexpr(exp), asm: cs_asm_gen(exp), result: cs_eval_prog(exp)}

fn caas_check(src) = caas_compile(src)
fn caas_fill(src) = (caas_compile(src)).holes
fn caas_prove(src) = (caas_compile(src)).proofs
fn caas_ast(src) = (caas_compile(src)).ast_sexpr
fn caas_expand(src) = (caas_compile(src)).expanded_sexpr
fn caas_symbols(src) = (caas_compile(src)).symbols
fn caas_asm(src) = (caas_compile(src)).asm
fn caas_eval(src) = (caas_compile(src)).result

## --- JSON serialisation for `lume agent` ---
fn cs_strlist_json(xs) = match xs
    Nil        => ""
    Cons(h, t) => "\"" + cs_jesc(h) + "\"" + (if cs_isnil(t) == 1 then "" else "," + cs_strlist_json(t))
fn cs_ctx1_json(c) = "{\"name\":\"" + cs_jesc(c.k) + "\",\"type\":\"" + cs_jesc(c.v) + "\"}"
fn cs_ctx_json(cs) = match cs
    Nil        => ""
    Cons(h, t) => cs_ctx1_json(h) + (if cs_isnil(t) == 1 then "" else "," + cs_ctx_json(t))
fn cs_hole_json(h) = "{\"hole\":\"" + cs_jesc(h.hole) + "\",\"function\":\"" + cs_jesc(h.fnm) + "\",\"expected_type\":\"" + cs_jesc(h.expected_type) + "\",\"context\":[" + cs_ctx_json(h.context) + "],\"candidates\":[" + cs_strlist_json(h.candidates) + "]}"
fn cs_holes_json(hs) = match hs
    Nil        => ""
    Cons(h, t) => cs_hole_json(h) + (if cs_isnil(t) == 1 then "" else "," + cs_holes_json(t))
fn cs_proof_json(p) = "{\"name\":\"" + cs_jesc(p.name) + "\",\"kind\":\"" + cs_jesc(p.kind) + "\",\"status\":\"" + cs_jesc(p.status) + "\",\"obligation\":\"" + cs_jesc(p.obligation) + "\",\"counterexample\":\"" + cs_jesc(p.counterexample) + "\"}"
fn cs_proofs_json(ps) = match ps
    Nil        => ""
    Cons(h, t) => cs_proof_json(h) + (if cs_isnil(t) == 1 then "" else "," + cs_proofs_json(t))
fn cs_diag_json(d) = "{\"code\":\"" + cs_jesc(d.code) + "\",\"phase\":\"" + cs_jesc(d.phase) + "\",\"message\":\"" + cs_jesc(d.message) + "\",\"fixit\":\"" + cs_jesc(d.fixit) + "\"}"
fn cs_diags_json(ds) = match ds
    Nil        => ""
    Cons(h, t) => if cs_isnil(t) == 1 then cs_diag_json(h) else cs_diag_json(h) + "," + cs_diags_json(t)
fn cs_sym_json(s) = "{\"name\":\"" + cs_jesc(s.name) + "\",\"kind\":\"" + cs_jesc(s.kind) + "\",\"signature\":\"" + cs_jesc(s.sig) + "\"}"
fn cs_syms_json(ss) = match ss
    Nil        => ""
    Cons(h, t) => if cs_isnil(t) == 1 then cs_sym_json(h) else cs_sym_json(h) + "," + cs_syms_json(t)
fn caas_json(r) = "{\"ok\":" + (if r.ok == 1 then "true" else "false") + ",\"diagnostics\":[" + cs_diags_json(r.diagnostics) + "],\"holes\":[" + cs_holes_json(r.holes) + "],\"proofs\":[" + cs_proofs_json(r.proofs) + "],\"symbols\":[" + cs_syms_json(r.symbols) + "],\"ast\":\"" + cs_jesc(r.ast_sexpr) + "\",\"expanded\":\"" + cs_jesc(r.expanded_sexpr) + "\",\"has_asm\":" + (if count(r.asm) > 0 then "true" else "false") + ",\"result\":\"" + cs_jesc(r.result) + "\"}"

print caas_json(caas_compile(readall()))
