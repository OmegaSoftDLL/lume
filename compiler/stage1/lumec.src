## lumec.src -- the self-hosted Lume compiler in ONE Lume-Core file (self-hosting R6): lex -> parse ->
## x86-64 codegen, written in the functional core (recursion, immutable records, match, let-in, if;
## no var/mut/while/for). Compiled to native by data_asm_cc and assembled by lume0 asm, no C anywhere.
## The lexer/parser are copied verbatim from lcparse.src (R5); the code generator is the functional port
## of lcgen.lume (R6a, R6b, R6-match). Scope: fn / print / top-level expression statements over Num/Var/Bin/Call/If/LetIn plus Str/Rec/Field, match and
## constructors (R6b). `match` is only a whole function/let/print/expression-statement body (see "parser: match"). The driver reads the whole program from stdin, compiles it, and prints the resulting asm.

## --- lexer ---
fn isdigit(c) = c >= "0" and c <= "9"
fn isalpha(c) = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
fn isalnum(c) = isdigit(c) or isalpha(c)
fn idend(s, i) = if i < count(s) and isalnum(at(s, i)) then idend(s, i + 1) else i
## End of a `##` comment: the index of the newline (or EOF) that terminates the line starting at i.
fn lineend(s, i) = if i >= count(s) or at(s, i) == "\n" then i else lineend(s, i + 1)
fn numend(s, i) = if i < count(s) and isdigit(at(s, i)) then numend(s, i + 1) else i
fn decimalend(s, i) = let j = numend(s, i) in if j + 1 < count(s) and at(s, j) == "." and isdigit(at(s, j + 1)) then numend(s, j + 1) else j
fn decscan(s, i, coefficient, scale, past, digits) = if i >= count(s) then {coefficient: coefficient, scale: scale} else if at(s, i) == "." then decscan(s, i + 1, coefficient, scale, 1, digits) else let digit = toint(at(s, i)) in if past == 1 and scale >= 18 then ctfail("lume: decimal scale exceeds the 18 digit limit\n") else if coefficient == 0 and digit == 0 then decscan(s, i + 1, 0, scale + past, past, digits) else if digits >= 18 then ctfail("lume: decimal coefficient exceeds the 18 digit limit\n") else decscan(s, i + 1, coefficient * 10 + digit, scale + past, past, digits + 1)
fn decnode(s, negative) = let d = decscan(s, 0, 0, 0, 0, 0) in Rec(Cons({key: "coefficient", val: Num(if negative then 0 - d.coefficient else d.coefficient)}, Cons({key: "scale", val: Num(d.scale)}, Cons({key: "precision", val: Num(0)}, Nil))))
fn strend(s, i) = if i >= count(s) then i else if at(s, i) == "\"" then i + 1 else if at(s, i) == "\\" then strend(s, i + 2) else strend(s, i + 1)
## String literal value: drop the delimiting quotes and decode \n \t \r (any other \x -> x, so \\ and \" decode to themselves), like the seed lexer.
fn unesc1(c) = if c == "n" then "\n" else if c == "t" then "\t" else if c == "r" then "\r" else c
fn unescl(s, i, n) = if i >= n then Nil else if at(s, i) == "\\" and i + 1 < n then Cons(unesc1(at(s, i + 1)), unescl(s, i + 2, n)) else Cons(at(s, i), unescl(s, i + 1, n))
fn strval(t) = let b = slice(t, 1, count(t) - 1) in joinall(unescl(b, 0, count(b)))
fn two(s, i) = slice(s, i, if i + 2 > count(s) then count(s) else i + 2)
fn istwo(t) = t == "==" or t == "!=" or t == "<=" or t == ">="
fn lex(s, i) = if i >= count(s) then Nil else let c = at(s, i) in if c == " " or c == "\t" or c == "\n" or c == "\r" then lex(s, i + 1) else if c == "#" then lex(s, lineend(s, i)) else if isdigit(c) then let j = decimalend(s, i) in Cons({kind: if j > numend(s, i) then "decimal" else "int", text: slice(s, i, j)}, lex(s, j)) else if isalpha(c) then Cons({kind: "id", text: slice(s, i, idend(s, i))}, lex(s, idend(s, i))) else if c == "\"" then Cons({kind: "str", text: slice(s, i, strend(s, i + 1))}, lex(s, strend(s, i + 1))) else if istwo(two(s, i)) then Cons({kind: "op", text: two(s, i)}, lex(s, i + 2)) else Cons({kind: "op", text: at(s, i)}, lex(s, i + 1))

## --- token-list helpers (avoid nested match in expressions) ---
fn headtext(ts) = match ts
    Nil        => ""
    Cons(h, t) => h.text
fn decimalhead(ts) = match ts
    Nil        => false
    Cons(h, t) => h.kind == "decimal"
fn droponce(ts) = match ts
    Nil        => Nil
    Cons(h, t) => t
fn skiprp(ts) = if headtext(ts) == ")" then droponce(ts) else ts
fn skiprb(ts) = if headtext(ts) == "}" then droponce(ts) else ts
fn recentries(ts) = if headtext(ts) == "}" then {items: Nil, rest: droponce(ts)} else recmore(headtext(ts), expr(dropkw(droponce(ts), ":")))
fn recmore(k, rv) = if headtext(rv.rest) == "," then let rr = recentries(droponce(rv.rest)) in {items: Cons({key: k, val: rv.node}, rr.items), rest: rr.rest} else {items: Cons({key: k, val: rv.node}, Nil), rest: skiprb(rv.rest)}
fn dropkw(ts, kw) = if headtext(ts) == kw then droponce(ts) else ts
fn parseif(t) = let rc = expr(t) in let tb = expr(dropkw(rc.rest, "then")) in let eb = expr(dropkw(tb.rest, "else")) in {node: If(rc.node, tb.node, eb.node), rest: eb.rest}
fn parselet(t) = let nm = headtext(t) in let rv = expr(dropkw(droponce(t), "=")) in let rb = expr(dropkw(rv.rest, "in")) in {node: LetIn(nm, rv.node, rb.node), rest: rb.rest}
fn postloop(r) = if headtext(r.rest) == "." then postloop({node: Field(r.node, headtext(droponce(r.rest))), rest: droponce(droponce(r.rest))}) else r
fn post(ts) = postloop(prim(ts))

## --- parser: {node, rest}; AST constructors Num/Var/Bin/Call ---
fn primid(name, t) = if headtext(t) == "(" then let a = arglist(droponce(t)) in {node: Call(name, a.items), rest: a.rest} else if headtext(t) == "{" then let a = recentries(droponce(t)) in {node: RecT(name, a.items), rest: a.rest} else {node: Var(name), rest: t}
fn prim(ts) = match ts
    Nil        => {node: Num(0), rest: Nil}
    Cons(h, t) => if h.kind == "int" then {node: Num(toint(h.text)), rest: t} else if h.text == "-" and decimalhead(t) then {node: decnode(headtext(t), 1), rest: droponce(t)} else if h.kind == "decimal" then {node: decnode(h.text, 0), rest: t} else if h.kind == "str" then {node: Str(strval(h.text)), rest: t} else if h.kind == "id" then (if h.text == "if" then parseif(t) else if h.text == "let" then parselet(t) else if h.text == "match" then parsematch(t) else if h.text == "comptime" then parsect(t) else primid(h.text, t)) else if h.text == "{" then let a = recentries(t) in {node: Rec(a.items), rest: a.rest} else if h.text == "(" then let r = expr(t) in {node: r.node, rest: skiprp(r.rest)} else {node: Num(0), rest: t}
fn arglist(ts) = if headtext(ts) == ")" then {items: Nil, rest: droponce(ts)} else argmore(expr(ts))
fn argmore(r) = if headtext(r.rest) == "," then let rr = arglist(droponce(r.rest)) in {items: Cons(r.node, rr.items), rest: rr.rest} else {items: Cons(r.node, Nil), rest: skiprp(r.rest)}
fn mulloop(r) = match r.rest
    Nil        => r
    Cons(h, t) => if h.text == "*" or h.text == "/" or h.text == "%" then let r2 = post(t) in mulloop({node: Bin(h.text, r.node, r2.node), rest: r2.rest}) else r
fn mul(ts) = mulloop(post(ts))
fn addloop(r) = match r.rest
    Nil        => r
    Cons(h, t) => if h.text == "+" or h.text == "-" then let r2 = mul(t) in addloop({node: Bin(h.text, r.node, r2.node), rest: r2.rest}) else r
fn add(ts) = addloop(mul(ts))
fn cmploop(r) = match r.rest
    Nil        => r
    Cons(h, t) => if h.text == "==" or h.text == "!=" or h.text == "<" or h.text == ">" or h.text == "<=" or h.text == ">=" then let r2 = add(t) in cmploop({node: Bin(h.text, r.node, r2.node), rest: r2.rest}) else r
fn cmp(ts) = cmploop(add(ts))
fn andloop(r) = match r.rest
    Nil        => r
    Cons(h, t) => if h.text == "and" then let r2 = cmp(t) in andloop({node: Bin(h.text, r.node, r2.node), rest: r2.rest}) else r
fn booland(ts) = andloop(cmp(ts))
fn orloop(r) = match r.rest
    Nil        => r
    Cons(h, t) => if h.text == "or" then let r2 = booland(t) in orloop({node: Bin(h.text, r.node, r2.node), rest: r2.rest}) else r
fn expr(ts) = orloop(booland(ts))
fn parse(s) = (expr(lex(s, 0))).node

## --- parser: match ---
## INVARIANT (relied on by the parser, the frame-slot computation and the codegen): `match` appears ONLY as the
## ENTIRE body of a function (or of a let-in / print / expression-statement body), never nested inside a larger
## expression. The lexer is layout-blind (no INDENT/DEDENT), so the arms of a match are delimited by LOOKAHEAD:
## an arm continues if and only if the next tokens form `<pattern> =>`; otherwise the arms have ended and the
## token stream is left exactly as it was (nothing consumed) for the following statement. This is what lets a
## top-level expression statement follow a function whose body is a `match`; the old rule ("arms end at `fn`,
## `print` or end of input") would have swallowed such an expression as a bogus extra arm. A match nested in an
## arm body would still swallow the outer arms, so such code must be factored into a helper function.
## The lexer has no `=>` token: it lexes as the two ops "=" then ">", so an arrow is two dropkw calls, and the
## lookahead `isarrow` likewise checks for "=" then ">".
fn isarrow(ts) = headtext(ts) == "=" and headtext(droponce(ts)) == ">"
fn parsematch(t) = let sc = expr(t) in let ar = parsearms(sc.rest) in {node: Match(sc.node, ar.items), rest: ar.rest}
fn parsearms(ts) = armstart(ts, parsepat(ts))
fn armstart(ts, p) = if isarrow(p.rest) then armmore(p) else {items: Nil, rest: ts}
fn armmore(p) = let b = expr(dropkw(dropkw(p.rest, "="), ">")) in let rr = parsearms(b.rest) in {items: Cons({pat: p.node, body: b.node}, rr.items), rest: rr.rest}
fn parsepat(ts) = match ts
    Nil        => {node: PWild, rest: Nil}
    Cons(h, t) => if h.kind == "int" then {node: PInt(toint(h.text)), rest: t} else if h.text == "_" then {node: PWild, rest: t} else if isctor(h.text) then patcons(h.text, t) else {node: PBind(h.text), rest: t}
fn patcons(tag, t) = if headtext(t) == "(" then let a = patlist(droponce(t)) in {node: PCons(tag, a.items), rest: a.rest} else {node: PCons(tag, Nil), rest: t}
fn patlist(ts) = if headtext(ts) == ")" then {items: Nil, rest: droponce(ts)} else patmore(parsepat(ts))
fn patmore(r) = if headtext(r.rest) == "," then let rr = patlist(droponce(r.rest)) in {items: Cons(r.node, rr.items), rest: rr.rest} else {items: Cons(r.node, Nil), rest: skiprp(r.rest)}

## --- comptime: evaluate `comptime <expr>` to a constant at COMPILE TIME (programmable-compiler pillar) ---
## `comptime E` consumes ONE primary E (so `comptime(...)` folds the whole parenthesised expression). C1 folded
## in the parser; C2 DEFERS the fold to a post-parse pass (`cfold`, below) so that, by the time we evaluate, ALL
## `fn`s are known and a `comptime` may CALL pure user functions (recursion included). The parser only wraps the
## expression in a `CT` node; `cfold` replaces each `CT` with the literal Num/Str it evaluates to, so the whole
## computation vanishes from the emitted asm -- `comptime(fib(10))` emits exactly `movq $55`, never a `call fib`.
## `ceval` is a pure Lume-Core interpreter over the foldable core: Num, Str, Bin (+ - * / % == != < > <= >= and or),
## If, LetIn, Var (comptime let / fn params), nested `comptime`, and Call to a pure user `fn`. PURITY is enforced
## lazily, like Lisp `eval` / Zig comptime: anything `ceval` cannot reduce -- a call to a non-user fn (read(), a
## builtin, an undefined name), `match`, a record/field access -- is a hard `ctfail` (clear message, exit 3), never
## a wrong program. TERMINATION is guaranteed by two explicit, deterministic guards (SUPERIOR to C++ constexpr,
## which relies on an implementation-defined limit whose overflow is a compiler crash): a total STEP budget
## (`cbudget`) and a call-DEPTH budget (`cdmax`). `cdmax` also keeps this interpreter's own native recursion well
## inside the process stack, so runaway comptime recursion yields a legible error rather than a segfault.
## `ceval(e, env, ft, f, cd)` returns {v: <comptime value>, f: <steps left>}: `env` binds comptime vars, `ft` is
## the program's function table, `f` the remaining step budget (threaded left-to-right), `cd` the current call
## depth (passed down only). A comptime value is {kind: "int"|"str", i: <int>, s: <str>}; integer arithmetic uses
## Lume's own 64-bit operators, so a compile-time fold is bit-identical to evaluating the same expression at runtime.
fn cbudget() = 1000000
fn cdmax() = 2000
fn cv_int(n) = {kind: "int", i: n, s: ""}
fn cv_str(v) = {kind: "str", i: 0, s: v}
fn cr(v, f) = {v: v, f: f}
fn ceval(e, env, ft, f, cd) = if f <= 0 then ctfail("lume: comptime error: comptime evaluation exceeded " + str(cbudget()) + " steps (possible runaway comptime evaluation)\n") else cstep(e, env, ft, f - 1, cd)
fn cstep(e, env, ft, f, cd) = match e
    Num(n)          => cr(cv_int(n), f)
    Str(v)          => cr(cv_str(v), f)
    Bin(op, a, b)   => cbin(op, ceval(a, env, ft, f, cd), b, env, ft, cd)
    If(c, t, e2)    => cif(ceval(c, env, ft, f, cd), t, e2, env, ft, cd)
    LetIn(nm, v, b) => clet(nm, ceval(v, env, ft, f, cd), b, env, ft, cd)
    Var(nm)         => cr(cevalvar(nm, env), f)
    Call(nm, args)  => ccall(nm, args, env, ft, f, cd)
    CT(inner)       => ceval(inner, env, ft, f, cd)
    Match(sc, arms) => ctfail("lume: comptime error: 'match' is not foldable at compile time\n")
    Rec(items)      => ctfail("lume: comptime error: record literal is not foldable at compile time\n")
    Field(o, nm)    => ctfail("lume: comptime error: field access is not foldable at compile time\n")
    _               => ctfail("lume: comptime error: expression is not foldable at compile time\n")
fn cbin(op, ra, b, env, ft, cd) = cbin2(op, ra.v, ceval(b, env, ft, ra.f, cd))
fn cbin2(op, av, rb) = cr(cevalbin(op, av, rb.v), rb.f)
fn cif(rc, t, e2, env, ft, cd) = cif2(rc.v, rc.f, t, e2, env, ft, cd)
fn cif2(cv, f, t, e2, env, ft, cd) = if cv.kind == "int" then (if cv.i != 0 then ceval(t, env, ft, f, cd) else ceval(e2, env, ft, f, cd)) else ctfail("lume: comptime error: `if` condition is not an integer at compile time\n")
fn clet(nm, rv, b, env, ft, cd) = ceval(b, Cons({k: nm, v: rv.v}, env), ft, rv.f, cd)
fn cevalvar(nm, env) = match env
    Nil        => ctfail("lume: comptime error: free variable '" + nm + "' is not bound by a comptime let-in or function parameter\n")
    Cons(h, t) => if h.k == nm then h.v else cevalvar(nm, t)
fn cevalbin(op, a, b) = if a.kind == "int" and b.kind == "int" then cevalii(op, a.i, b.i) else if op == "+" and a.kind == "str" and b.kind == "str" then cv_str(a.s + b.s) else if op == "==" and a.kind == "str" and b.kind == "str" then cv_int(if a.s == b.s then 1 else 0) else if op == "!=" and a.kind == "str" and b.kind == "str" then cv_int(if a.s == b.s then 0 else 1) else ctfail("lume: comptime error: operator '" + op + "' is not defined for these comptime value types\n")
fn cevalii(op, x, y) = if op == "+" then cv_int(x + y) else if op == "-" then cv_int(x - y) else if op == "*" then cv_int(x * y) else if op == "/" then cevaldiv(x, y) else if op == "%" then cevalmod(x, y) else if op == "==" then cv_int(x == y) else if op == "!=" then cv_int(x != y) else if op == "<" then cv_int(x < y) else if op == ">" then cv_int(x > y) else if op == "<=" then cv_int(x <= y) else if op == ">=" then cv_int(x >= y) else if op == "and" then cv_int(x != 0 and y != 0) else if op == "or" then cv_int(x != 0 or y != 0) else ctfail("lume: comptime error: unknown operator '" + op + "' at compile time\n")
fn cevaldiv(x, y) = if y == 0 then ctfail("lume: comptime error: division by zero at compile time\n") else cv_int(x / y)
fn cevalmod(x, y) = if y == 0 then ctfail("lume: comptime error: modulo by zero at compile time\n") else cv_int(x % y)
fn ctnode(cv) = if cv.kind == "int" then Num(cv.i) else Str(cv.s)
## --- comptime calls to pure user functions: look up `nm` in the function table, evaluate the args (comptime),
## bind them to the params in a FRESH scope, and evaluate the body. A name that is not a user `fn` is not pure. ---
fn ccall(nm, args, env, ft, f, cd) = ccall2(nm, lookupfn(nm, ft), args, env, ft, f, cd)
fn ccall2(nm, mf, args, env, ft, f, cd) = match mf
    Nil           => ctfail("lume: comptime error: cannot evaluate '" + nm + "' at compile time: not pure\n")
    Cons(fn0, rr) => ccall3(nm, fn0, args, env, ft, f, cd)
fn ccall3(nm, fn0, args, env, ft, f, cd) = if cd >= cdmax() then ctfail("lume: comptime error: comptime evaluation exceeded " + str(cdmax()) + " call levels (possible infinite recursion in '" + nm + "')\n") else ccall4(fn0, cargs(args, env, ft, f, cd), ft, cd)
fn ccall4(fn0, ra, ft, cd) = match fn0
    Fn(fnm, ps, body) => ceval(body, cbind(ps, ra.vals, Nil), ft, ra.f, cd + 1)
    _                 => ctfail("lume: comptime error: not a function in comptime call\n")
fn lookupfn(nm, ft) = match ft
    Nil        => Nil
    Cons(h, t) => if fnname(h) == nm then Cons(h, Nil) else lookupfn(nm, t)
fn fnname(f0) = match f0
    Fn(nm, ps, body) => nm
    _                => ""
fn cargs(args, env, ft, f, cd) = match args
    Nil        => {vals: Nil, f: f}
    Cons(h, t) => cargs2(ceval(h, env, ft, f, cd), t, env, ft, cd)
fn cargs2(rh, t, env, ft, cd) = cargs3(rh, cargs(t, env, ft, rh.f, cd))
fn cargs3(rh, rt) = {vals: Cons(rh.v, rt.vals), f: rt.f}
fn cbind(ps, vals, env) = match ps
    Nil         => env
    Cons(p, pt) => cbind2(p, pt, vals, env)
fn cbind2(p, pt, vals, env) = match vals
    Nil         => ctfail("lume: comptime error: too few arguments in a comptime function call\n")
    Cons(v, vt) => cbind(pt, vt, Cons({k: p, v: v}, env))
fn parsect(t) = let r = prim(t) in {node: CT(r.node), rest: r.rest}
## --- comptime fold pass (post-parse): with every `fn` known, replace each `CT` node anywhere in the program
## with the literal it evaluates to. On a CT-free program (e.g. lumec.src itself) this is a faithful identity
## rebuild of the AST, so the self-host fixpoint is untouched. ---
fn cfold(prog) = cfoldstmts(prog, cbuildft(prog))
fn cbuildft(prog) = match prog
    Nil        => Nil
    Cons(h, t) => cbuildft2(h, cbuildft(t))
fn cbuildft2(s0, rest) = match s0
    Fn(nm, ps, body) => Cons(s0, rest)
    _                => rest
fn cfoldstmts(prog, ft) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(cfoldstmt(h, ft), cfoldstmts(t, ft))
fn cfoldstmt(s0, ft) = match s0
    Fn(nm, ps, body) => Fn(nm, ps, cfolde(body, ft))
    Print(v)         => Print(cfolde(v, ft))
    ExprS(v)         => ExprS(cfolde(v, ft))
    _                => s0
fn cfoldct(r) = ctnode(r.v)
fn cfolde(e, ft) = match e
    CT(inner)       => cfoldct(ceval(inner, Nil, ft, cbudget(), 0))
    Bin(op, a, b)   => Bin(op, cfolde(a, ft), cfolde(b, ft))
    If(c, t, e2)    => If(cfolde(c, ft), cfolde(t, ft), cfolde(e2, ft))
    LetIn(nm, v, b) => LetIn(nm, cfolde(v, ft), cfolde(b, ft))
    Call(nm, args)  => Call(nm, cfoldeargs(args, ft))
    Rec(items)      => Rec(cfolderec(items, ft))
    RecT(tn, items) => RecT(tn, cfolderec(items, ft))
    Field(o, nm)    => Field(cfolde(o, ft), nm)
    Match(sc, arms) => Match(cfolde(sc, ft), cfoldearms(arms, ft))
    _               => e
fn cfoldeargs(xs, ft) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(cfolde(h, ft), cfoldeargs(t, ft))
fn cfolderec(xs, ft) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: cfolde(h.val, ft)}, cfolderec(t, ft))
fn cfoldearms(xs, ft) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: cfolde(h.body, ft)}, cfoldearms(t, ft))

## --- parser: programs (fn definitions, print statements, and bare expression statements) ---
## A statement is `fn ...`, `print <expr>`, or a bare `<expr>` evaluated for its effect (value discarded).
## `fn`/`print` are dispatched by keyword; anything else begins an expression statement. The program is a
## sequence of statements up to end of input (the `Nil` arm stops the recursion). Each top-level `<expr>` must
## consume at least one token (prim always advances on a non-empty stream), so progmore cannot loop forever.
## F2: a parameter may carry an optional annotation `name: T` and the signature an optional `-> R` (T as in F1:
## `int`, `str`, a declared name, `[T]`, or D1's `decimal(p, s)`). `items` are the bare names (so `Fn(nm, ps, body)` is UNCHANGED and the
## codegen never sees a type); `tys` is the parallel list of annotations, `TyAny` where a parameter has none.
fn parseparams(ts) = if headtext(ts) == ")" then {items: Nil, tys: Nil, rest: droponce(ts)} else parseparam(headtext(ts), droponce(ts))
fn parseparam(nm, ts) = if headtext(ts) == ":" then parseparamt(nm, parsetype1(droponce(ts))) else parammore(nm, TyAny, ts)
fn parseparamt(nm, r) = parammore(nm, r.node, r.rest)
fn parammore(nm, ty, ts) = if headtext(ts) == "," then let rr = parseparams(droponce(ts)) in {items: Cons(nm, rr.items), tys: Cons(ty, rr.tys), rest: rr.rest} else {items: Cons(nm, Nil), tys: Cons(ty, Nil), rest: skiprp(ts)}
fn parseret(ts) = if headtext(ts) == "-" and headtext(droponce(ts)) == ">" then parseret2(parsetype1(droponce(droponce(ts)))) else {ty: TyAny, rest: ts}
fn parseret2(r) = {ty: r.node, rest: r.rest}
## `sg` is the annotation record of the function: `Nil` when nothing is annotated (the AST is then exactly the
## pre-F2 one), else a `Sig(name, paramnames, paramtypes, rettype)` that parseprog places just before the `Fn`.
fn parsefn(t) = parsefn2(headtext(t), parseparams(dropkw(droponce(t), "(")))
fn parsefn2(nm, ps) = parsefn3(nm, ps, parseret(ps.rest))
fn parsefn3(nm, ps, rt) = parsefn4(nm, ps, rt, expr(dropkw(rt.rest, "=")))
fn parsefn4(nm, ps, rt, b) = {node: Fn(nm, ps.items, b.node), sg: mksig(nm, ps, rt.ty), rest: b.rest}
fn isany(t) = match t
    TyAny => 1
    _     => 0
fn anyann(tys) = match tys
    Nil        => 0
    Cons(h, t) => if isany(h) == 0 then 1 else anyann(t)
fn mksig(nm, ps, rty) = if anyann(ps.tys) == 1 or isany(rty) == 0 then Sig(nm, ps.items, ps.tys, rty) else Nil
fn parseprint(t) = let e = expr(t) in {node: Print(e.node), rest: e.rest}
fn parsestmt(ts) = if headtext(ts) == "fn" then parsefn(droponce(ts)) else if headtext(ts) == "type" then parsetype(droponce(ts)) else parseprint(droponce(ts))
fn progmore(r) = Cons(r.node, parseprog(r.rest))
fn progfn(r) = progsig(r.sg, Cons(r.node, parseprog(r.rest)))
fn progsig(sg, rest) = match sg
    Nil              => rest
    Sig(nm, ps, ts, rt) => Cons(sg, rest)
fn lexprstmt(e) = {node: ExprS(e.node), rest: e.rest}
fn parseprog(ts) = match ts
    Nil        => Nil
    Cons(h, t) => if h.text == "fn" then progfn(parsefn(droponce(ts))) else if h.text == "print" or h.text == "type" then progmore(parsestmt(ts)) else progmore(lexprstmt(expr(ts)))
fn parseprogram(s) = parseprog(lex(s, 0))

## --- parser: named type declarations (F1) -----------------------------------------------------------------
## Inline, layout-free syntax (the lexer is indentation-blind, so the README's indented form is not used here):
##   type Dept = enum Sales | IT | Finance            -- a sum type (ADT), nullary variants
##   type Node = enum Nil | Cons(int, Node)            -- a variant with a typed, positional payload
##   type Point = record x: int, y: int                -- a product type with named, typed fields
## A field/payload type `T` is `int`, `str`, a declared type name, or `[T]` (a list of T). Like `match`, the
## parts are delimited by LOOKAHEAD: enum variants continue while the next token is `|`, record fields while it
## is `,`; the declaration ends as soon as the separator is absent, leaving the stream on the next statement
## (`fn` / `print` / `type` / an expression). A declaration lowers to a `TypeS(name, kind, items)` statement that
## emits NO code (compile-time information only); `kind` is "enum" (items are `{tag, ar}`) or "record" (items are
## `{fname, fty}`). The `enum` keyword is optional (so `type T = A | B` is accepted); anything that is not
## `record` is parsed as an enum. Type expressions are kept (`TyName`/`TyList`); F2 checks them against call arguments.
fn parsetype(t) = parsetypebody(headtext(t), dropkw(droponce(t), "="))
fn parsetypebody(nm, t) = if headtext(t) == "record" then parserecordty(nm, droponce(t)) else parseenumty(nm, dropkw(t, "enum"))
fn parseenumty(nm, t) = parseenumty2(nm, parsevariants(t))
fn parseenumty2(nm, vs) = {node: TypeS(nm, "enum", vs.items), rest: vs.rest}
fn parsevariants(ts) = parsevariant(headtext(ts), droponce(ts))
fn parsevariant(tag, ts) = if headtext(ts) == "(" then parsevariantp(tag, parsetypelist(droponce(ts))) else parsevariantend(tag, 0, ts)
fn parsevariantp(tag, a) = parsevariantend(tag, len(a.items), a.rest)
fn parsevariantend(tag, ar, ts) = if headtext(ts) == "|" then parsevariantcons(tag, ar, parsevariants(droponce(ts))) else {items: Cons({tag: tag, ar: ar}, Nil), rest: ts}
fn parsevariantcons(tag, ar, rr) = {items: Cons({tag: tag, ar: ar}, rr.items), rest: rr.rest}
fn parserecordty(nm, t) = parserecordty2(nm, parsefields(t))
fn parserecordty2(nm, fs) = {node: TypeS(nm, "record", fs.items), rest: fs.rest}
fn parsefields(ts) = parsefield(headtext(ts), dropkw(droponce(ts), ":"))
fn parsefield(fname, ts) = parsefieldt(fname, parsetype1(ts))
fn parsefieldt(fname, r) = if headtext(r.rest) == "," then parsefieldcons(fname, r.node, parsefields(droponce(r.rest))) else {items: Cons({fname: fname, fty: r.node}, Nil), rest: r.rest}
fn parsefieldcons(fname, fty, rr) = {items: Cons({fname: fname, fty: fty}, rr.items), rest: rr.rest}
fn parsetypelist(ts) = if headtext(ts) == ")" then {items: Nil, rest: droponce(ts)} else parsetypemore(parsetype1(ts))
fn parsetypemore(r) = if headtext(r.rest) == "," then parsetypecons(r.node, parsetypelist(droponce(r.rest))) else {items: Cons(r.node, Nil), rest: skiprp(r.rest)}
fn parsetypecons(n, rr) = {items: Cons(n, rr.items), rest: rr.rest}
fn parsetype1(ts) = if headtext(ts) == "[" then parsetypelistof(parsetype1(droponce(ts))) else if headtext(ts) == "decimal" and headtext(droponce(ts)) == "(" then parsetypedecimal(droponce(droponce(ts))) else {node: TyName(headtext(ts)), rest: droponce(ts)}
fn parsetypelistof(r) = {node: TyList(r.node), rest: skiprk(r.rest)}
fn parsetypedecimal(ts) = let p = toint(headtext(ts)) in let s = toint(headtext(droponce(droponce(ts)))) in let rest = skiprp(droponce(droponce(droponce(ts)))) in parsetypedecimal2(p, s, rest)
fn parsetypedecimal2(p, s, rest) = if p < 1 or p > 18 or s < 0 or s > p then ctfail("lume: type error: decimal annotation requires 1 <= precision <= 18 and 0 <= scale <= precision\n") else {node: TyDecimal(p, s), rest: rest}
fn skiprk(ts) = if headtext(ts) == "]" then droponce(ts) else ts

## --- code generator: x86-64 asm for the core (port of lcgen.lume, R6a; strings/records/ctors R6b) ---
## Same output shape as `agen` in data_asmgen.lume for fn/print statements over Num/Var/Bin/Call/If/LetIn/Str/Rec/Field.
## No mutation: the state {nl, ns, dt} (label counter, string-label counter, rodata chunks) is threaded through
## every call and returned in {code, nl, ns, dt}; the per-function context is the immutable record {locals, bound}.
## List/index nodes are out of scope and emit the same placeholder as agen. Output is joined pairwise
## (O(n log k)), never grown with a long right-nested `+` chain.

## --- list helpers ---
fn app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, app(t, ys))
fn len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + len(t)
fn isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn drop(xs, k) = if k <= 0 then xs else drop2(xs, k)
fn drop2(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => drop(t, k - 1)
fn revacc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => revacc(t, Cons(h, acc))
fn rev(xs) = revacc(xs, Nil)
fn pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => pairs2(a, t)
fn pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, pairs(r))
fn joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if isnil(t) == 1 then a else joinall(pairs(xs))

## --- registers, operators, frame slots ---
fn areg(i) = if i == 0 then "%rdi" else if i == 1 then "%rsi" else if i == 2 then "%rdx" else if i == 3 then "%rcx" else if i == 4 then "%r8" else "%r9"
fn abin(op) = if op == "+" then "    addq %rcx, %rax\n" else if op == "-" then "    subq %rcx, %rax\n" else if op == "*" then "    imulq %rcx, %rax\n" else if op == "/" then "    cqto\n    idivq %rcx\n" else if op == "%" then "    cqto\n    idivq %rcx\n    movq %rdx, %rax\n" else if op == "<" then "    cmpq %rcx, %rax\n    setl %al\n    movzbq %al, %rax\n" else if op == ">" then "    cmpq %rcx, %rax\n    setg %al\n    movzbq %al, %rax\n" else if op == "<=" then "    cmpq %rcx, %rax\n    setle %al\n    movzbq %al, %rax\n" else if op == ">=" then "    cmpq %rcx, %rax\n    setge %al\n    movzbq %al, %rax\n" else if op == "==" then "    cmpq %rcx, %rax\n    sete %al\n    movzbq %al, %rax\n" else if op == "!=" then "    cmpq %rcx, %rax\n    setne %al\n    movzbq %al, %rax\n" else if op == "and" then "    cmpq $0, %rax\n    setne %al\n    cmpq $0, %rcx\n    setne %cl\n    andb %cl, %al\n    movzbq %al, %rax\n" else if op == "or" then "    cmpq $0, %rax\n    setne %al\n    cmpq $0, %rcx\n    setne %cl\n    orb %cl, %al\n    movzbq %al, %rax\n" else ""
fn lidxfrom(xs, name, i) = match xs
    Nil        => 0 - 1
    Cons(h, t) => if h == name then i else lidxfrom(t, name, i + 1)
fn lidxof(xs, name) = lidxfrom(xs, name, 0)
fn lslot(k) = str(0 - 8 * (k + 1))
fn lframe(n) = if (n * 8) % 16 != 0 then n * 8 + 8 else n * 8

## --- let-bound names reachable in an expression, in agen's collect_lets order ---
fn lcollect(e) = match e
    LetIn(nm, v, b) => Cons(nm, app(lcollect(v), lcollect(b)))
    Bin(op, l, r)   => app(lcollect(l), lcollect(r))
    If(c, t, e2)    => app(lcollect(c), app(lcollect(t), lcollect(e2)))
    Call(nm, args)  => lcollectargs(args)
    Field(o, nm)    => lcollect(o)
    Rec(items)      => lcollectrec(items)
    RecT(tn, items) => lcollectrec(items)
    Match(sc, arms) => app(lcollect(sc), lcollectarms(arms))
    _               => Nil
fn lcollectargs(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lcollect(h), lcollectargs(t))
fn lcollectrec(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lcollect(h.val), lcollectrec(t))
fn lcollectarms(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lpatbinds(h.pat), app(lcollect(h.body), lcollectarms(t)))

## --- patterns: the names a pattern binds (frame slots), and match nesting depth (scrutinee slots _sd<k>) ---
fn lpatbinds(p) = match p
    PBind(nm)       => Cons(nm, Nil)
    PCons(tag, subs) => lpatbindsl(subs)
    _               => Nil
fn lpatbindsl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lpatbinds(h), lpatbindsl(t))
fn imax(a, b) = if a > b then a else b
fn lmdepth(e) = match e
    Match(sc, arms) => imax(lmdepth(sc), lmdarms(arms)) + 1
    If(c, t, e2)    => imax(lmdepth(c), imax(lmdepth(t), lmdepth(e2)))
    Bin(op, l, r)   => imax(lmdepth(l), lmdepth(r))
    LetIn(nm, v, b) => imax(lmdepth(v), lmdepth(b))
    Call(nm, args)  => lmdargs(args)
    Field(o, nm)    => lmdepth(o)
    Rec(items)      => lmdrec(items)
    RecT(tn, items) => lmdrec(items)
    _               => 0
fn lmdarms(xs) = match xs
    Nil        => 0
    Cons(h, t) => imax(lmdepth(h.body), lmdarms(t))
fn lmdargs(xs) = match xs
    Nil        => 0
    Cons(h, t) => imax(lmdepth(h), lmdargs(t))
fn lmdrec(xs) = match xs
    Nil        => 0
    Cons(h, t) => imax(lmdepth(h.val), lmdrec(t))
fn lsds(i, n) = if i >= n then Nil else Cons("_sd" + str(i), lsds(i + 1, n))

## --- binary operators ---
fn lsetc(op) = if op == ">" then "    setg %al\n" else if op == "<=" then "    setle %al\n" else if op == ">=" then "    setge %al\n" else "    setl %al\n"
fn lbintail(op) = if op == "==" then "    popq %rsi\n    popq %rdi\n    call eqv\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n" else if op == "!=" then "    popq %rsi\n    popq %rdi\n    call eqv\n    xorq $1, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n" else if op == "+" then "    popq %rsi\n    popq %rdi\n    call addv\n    pushq %rax\n" else if op == "<" or op == ">" or op == "<=" or op == ">=" then "    popq %rsi\n    popq %rdi\n    call cmpv\n    cmpq $0, %rax\n" + lsetc(op) + "    movzbq %al, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n" else "    popq %rcx\n    popq %rax\n    movq 8(%rax), %rax\n    movq 8(%rcx), %rcx\n" + abin(op) + "    movq %rax, %rdi\n    call mkint\n    pushq %rax\n"

fn ldec_key(items, key) = match items
    Nil        => 0
    Cons(h, t) => if h.key == key then 1 else ldec_key(t, key)
fn ldec_name(names, name) = match names
    Nil        => 0
    Cons(h, t) => if h == name then 1 else ldec_name(t, name)
fn ldec_remove(names, name) = match names
    Nil        => Nil
    Cons(h, t) => if h == name then ldec_remove(t, name) else Cons(h, ldec_remove(t, name))
fn ldec_expr(e, names) = match e
    Rec(items)    => len(items) == 3 and ldec_key(items, "coefficient") == 1 and ldec_key(items, "scale") == 1 and ldec_key(items, "precision") == 1
    Call(nm, args) => nm == "decimal" or nm == "decimal_make" or nm == "decimal_parse" or nm == "decimal_cast" or nm == "decimal_div_exact" or nm == "decimal_add" or nm == "decimal_sub" or nm == "decimal_mul" or nm == "decimal_div"
    Var(nm)       => ldec_name(names, nm)
    If(c, t, e2) => ldec_expr(t, names) and ldec_expr(e2, names)
    LetIn(nm, v, body) => ldec_expr(body, if ldec_expr(v, names) then Cons(nm, ldec_remove(names, nm)) else ldec_remove(names, nm))
    _             => 0
fn ldec_tail(op) = if op == "+" then "    popq %rsi\n    popq %rdi\n    call decimal_add\n    pushq %rax\n" else if op == "-" then "    popq %rsi\n    popq %rdi\n    call decimal_sub\n    pushq %rax\n" else if op == "*" then "    popq %rsi\n    popq %rdi\n    call decimal_mul\n    pushq %rax\n" else if op == "/" then "    popq %rsi\n    popq %rdi\n    call decimal_div\n    pushq %rax\n" else "    popq %rsi\n    popq %rdi\n    call decimal_compare\n    movq 8(%rax), %rax\n    cmpq $0, %rax\n" + (if op == "==" then "    sete %al\n" else if op == "!=" then "    setne %al\n" else lsetc(op)) + "    movzbq %al, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n"

## --- state and results ---
## The threaded state is the record {nl, ns, dt}: nl = next free code label, ns = next free string label,
## dt = rodata chunks emitted so far (newest first). Every result is {code, nl, ns, dt}, so a result IS the
## next state and is passed straight to the following sibling; lres copies the state fields into a result.
fn lres(code, s) = {code: code, nl: s.nl, ns: s.ns, dt: s.dt}
fn lnext(s) = {nl: s.nl + 1, ns: s.ns, dt: s.dt}

## --- constructors (ML-core convention: a capitalised identifier is a constructor) ---
fn isctor(name) = let c = at(name, 0) in c >= "A" and c <= "Z"

## --- string literals: escape for .asciz and emit a .rodata label (port of sesc / strlabel) ---
fn lsesc1(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\t" then "\\t" else if c == "\r" then "\\r" else c
fn lsescl(s, i, n) = if i >= n then Nil else Cons(lsesc1(at(s, i)), lsescl(s, i + 1, n))
fn lsesc(s) = joinall(lsescl(s, 0, count(s)))
fn lstrlabel(v, s) = let lab = ".Ls" + str(s.ns) in {lab: lab, nl: s.nl, ns: s.ns + 1, dt: Cons(lab + ":\n    .asciz \"" + lsesc(v) + "\"\n", s.dt)}
fn lstr(sl) = lres("    leaq " + sl.lab + "(%rip), %rdi\n    call mkstr\n    pushq %rax\n", sl)

## --- calls: stack args (7th and later, last first), register args, pops ---
fn lstackargs(xs, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => lstackmore(laexpr(h, ctx, s), t, ctx)
fn lstackmore(a, t, ctx) = let rest = lstackargs(t, ctx, a) in lres(a.code + rest.code, rest)
fn lregargs(xs, q, m, ctx, s) = if q >= m then lres("", s) else lregargs2(xs, q, m, ctx, s)
fn lregargs2(xs, q, m, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => lregmore(laexpr(h, ctx, s), t, q, m, ctx)
fn lregmore(a, t, q, m, ctx) = let rest = lregargs(t, q + 1, m, ctx, a) in lres(a.code + rest.code, rest)
fn lpops(i) = if i < 0 then "" else "    popq " + areg(i) + "\n" + lpops(i - 1)
fn lcall(nm, args, ctx, s) = let n = len(args) in let m = if n > 6 then 6 else n in let st = lstackargs(rev(drop(args, 6)), ctx, s) in let rg = lregargs(args, 0, m, ctx, st) in let adj = if n > 6 then "    addq $" + str((n - 6) * 8) + ", %rsp\n" else "" in lres(st.code + rg.code + lpops(m - 1) + "    call " + nm + "\n" + adj + "    pushq %rax\n", rg)

## --- constructors and records: args evaluated in order, then popped into a fresh k*8-byte block ---
fn lpopstore(k) = if k < 0 then "" else "    popq %rax\n    movq %rax, " + str(k * 8) + "(%rcx)\n" + lpopstore(k - 1)
fn lctor(nm, args, ctx, s) = lctor2(lstrlabel(nm, s), len(args), args, ctx)
fn lctor2(sl, n, args, ctx) = if n == 0 then lres("    leaq " + sl.lab + "(%rip), %rdi\n    movq $0, %rsi\n    movq $0, %rdx\n    call mkctor\n    pushq %rax\n", sl) else lctor3(sl, n, lstackargs(args, ctx, sl))
fn lctor3(sl, n, ar) = lres(ar.code + "    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rcx\n" + lpopstore(n - 1) + "    leaq " + sl.lab + "(%rip), %rdi\n    movq $" + str(n) + ", %rsi\n    movq %rcx, %rdx\n    call mkctor\n    pushq %rax\n", ar)
fn lrecvals(items, ctx, s) = match items
    Nil        => lres("", s)
    Cons(h, t) => lrecvmore(laexpr(h.val, ctx, s), t, ctx)
fn lrecvmore(a, t, ctx) = let rest = lrecvals(t, ctx, a) in lres(a.code + rest.code, rest)
fn lreckeys(items, j, s) = match items
    Nil        => lres("", s)
    Cons(h, t) => lreckmore(lstrlabel(h.key, s), t, j)
fn lreckmore(sl, t, j) = let rest = lreckeys(t, j + 1, sl) in lres("    leaq " + sl.lab + "(%rip), %rax\n    movq %rax, " + str(j * 8) + "(%rdx)\n" + rest.code, rest)
fn lrec(items, ctx, s) = if isnil(items) == 1 then lres("    movq $0, %rdi\n    movq $0, %rsi\n    movq $0, %rdx\n    call mkrec\n    pushq %rax\n", s) else lrec2(items, len(items), lrecvals(items, ctx, s))
fn lrec2(items, n, vs) = let ks = lreckeys(items, 0, vs) in lres(vs.code + "    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rcx\n" + lpopstore(n - 1) + "    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rdx\n" + ks.code + "    movq %rdx, %rdi\n    movq %rcx, %rsi\n    movq $" + str(n) + ", %rdx\n    call mkrec\n    pushq %rax\n", ks)
fn lfield(sl, o, ctx) = let ob = laexpr(o, ctx, sl) in lres(ob.code + "    popq %rdi\n    leaq " + sl.lab + "(%rip), %rsi\n    call recget\n    pushq %rax\n", ob)

## --- match (port of DMatch / atest / abind in data_asmgen.lume; same label + strlabel allocation order) ---
## `acc` is asm that loads the value pointer into %rax; sub-pattern k of a constructor loads field k from it.
fn lacck(acc, k) = acc + "    movq 24(%rax), %rax\n    movq " + str(k * 8) + "(%rax), %rax\n"
fn latest(p, acc, flbl, s) = match p
    PInt(n)          => lres(acc + "    cmpq $0, (%rax)\n    jne " + flbl + "\n    cmpq $" + str(n) + ", 8(%rax)\n    jne " + flbl + "\n", s)
    PCons(tag, subs) => latestcons(lstrlabel(tag, s), acc, subs, flbl)
    _                => lres("", s)
fn latestcons(sl, acc, subs, flbl) = let sb = latestsubs(subs, 0, acc, flbl, sl) in lres(acc + "    cmpq $2, (%rax)\n    jne " + flbl + "\n    movq 16(%rax), %rdi\n    leaq " + sl.lab + "(%rip), %rsi\n    call streq\n    testq %rax, %rax\n    jz " + flbl + "\n" + sb.code, sb)
fn latestsubs(subs, k, acc, flbl, s) = match subs
    Nil        => lres("", s)
    Cons(h, t) => latestsub(latest(h, lacck(acc, k), flbl, s), t, k, acc, flbl)
fn latestsub(r, t, k, acc, flbl) = let rest = latestsubs(t, k + 1, acc, flbl, r) in lres(r.code + rest.code, rest)
fn labind(p, acc, locals) = match p
    PBind(nm)        => acc + "    movq %rax, " + lslot(lidxof(locals, nm)) + "(%rbp)\n"
    PCons(tag, subs) => labinds(subs, 0, acc, locals)
    _                => ""
fn labinds(subs, k, acc, locals) = match subs
    Nil        => ""
    Cons(h, t) => labind(h, lacck(acc, k), locals) + labinds(t, k + 1, acc, locals)
fn lmatch(lab, ctx, sc, arms, s1) = let c2 = {locals: ctx.locals, bound: ctx.bound, dvars: ctx.dvars, depth: ctx.depth + 1} in lmatch1(lab, lslot(lidxof(ctx.locals, "_sd" + str(ctx.depth))), arms, c2, laexpr(sc, c2, s1))
fn lmatch1(lab, soff, arms, c2, scr) = let ar = lmarms(lab, 0, "    movq " + soff + "(%rbp), %rax\n", arms, c2, scr) in lres(scr.code + "    popq %rax\n    movq %rax, " + soff + "(%rbp)\n" + ar.code + ".Lm" + lab + "_" + str(len(arms)) + ":\n    movq $0, %rdi\n    call mkint\n    pushq %rax\n.Lm" + lab + "_end:\n", ar)
fn lmarms(lab, i, acc, arms, c2, s) = match arms
    Nil        => lres("", s)
    Cons(h, t) => lmarm(lab, i, acc, h, t, c2, laexpr(h.body, {locals: c2.locals, bound: app(c2.bound, lpatbinds(h.pat)), dvars: c2.dvars, depth: c2.depth}, s))
fn lmarm(lab, i, acc, h, t, c2, bd) = lmarm2(lab, i, acc, h, t, c2, bd, latest(h.pat, acc, ".Lm" + lab + "_" + str(i + 1), bd))
fn lmarm2(lab, i, acc, h, t, c2, bd, ts) = let rest = lmarms(lab, i + 1, acc, t, c2, ts) in lres(".Lm" + lab + "_" + str(i) + ":\n" + ts.code + labind(h.pat, acc, c2.locals) + bd.code + "    jmp .Lm" + lab + "_end\n" + rest.code, rest)

## --- expressions: asm that leaves the value of `e` pushed; `s` is the threaded state ---
fn lbin(op, l, lr, r, ctx) = let rr = laexpr(r, ctx, lr) in lres(lr.code + rr.code + (if ldec_expr(l, ctx.dvars) and ldec_expr(r, ctx.dvars) then ldec_tail(op) else lbintail(op)), rr)
fn lif(lab, cr, t, e2, ctx) = let tr = laexpr(t, ctx, cr) in let er = laexpr(e2, ctx, tr) in lres(cr.code + "    popq %rax\n    movq 8(%rax), %rax\n    testq %rax, %rax\n    jz .Le" + lab + "\n" + tr.code + "    jmp .Lx" + lab + "\n.Le" + lab + ":\n" + er.code + ".Lx" + lab + ":\n", er)
fn llet(nm, v, vr, b, ctx) = let inner = {locals: ctx.locals, bound: app(ctx.bound, Cons(nm, Nil)), dvars: if ldec_expr(v, ctx.dvars) then Cons(nm, ldec_remove(ctx.dvars, nm)) else ldec_remove(ctx.dvars, nm), depth: ctx.depth} in let br = laexpr(b, inner, vr) in lres(vr.code + "    popq %rax\n    movq %rax, " + lslot(lidxof(ctx.locals, nm)) + "(%rbp)\n" + br.code, br)
fn lvar(nm, ctx, s) = if isctor(nm) then lctor(nm, Nil, ctx, s) else lres("    movq " + lslot(lidxof(ctx.locals, nm)) + "(%rbp), %rax\n    pushq %rax\n", s)
fn lcallx(nm, args, ctx, s) = if isctor(nm) then lctor(nm, args, ctx, s) else lcall(nm, args, ctx, s)
fn laexpr(e, ctx, s) = match e
    Num(n)         => lres("    movq $" + str(n) + ", %rdi\n    call mkint\n    pushq %rax\n", s)
    Str(v)         => lstr(lstrlabel(v, s))
    Var(nm)        => lvar(nm, ctx, s)
    Bin(op, l, r)  => lbin(op, l, laexpr(l, ctx, s), r, ctx)
    If(c, t, e2)   => lif(str(s.nl), laexpr(c, ctx, lnext(s)), t, e2, ctx)
    LetIn(nm, v, b) => llet(nm, v, laexpr(v, ctx, s), b, ctx)
    Call(nm, args) => lcallx(nm, args, ctx, s)
    Rec(items)     => lrec(items, ctx, s)
    RecT(tn, items) => lrec(items, ctx, s)
    Field(o, nm)   => lfield(lstrlabel(nm, s), o, ctx)
    Match(sc, arms) => lmatch(str(s.nl), ctx, sc, arms, lnext(s))
    _              => lres("    movq $0, %rax\n    pushq %rax\n    # unsupported expr\n", s)

## --- functions ---
fn lparams(ps, i) = match ps
    Nil        => ""
    Cons(h, t) => if i < 6 then "    movq " + areg(i) + ", " + lslot(i) + "(%rbp)\n" + lparams(t, i + 1) else "    movq " + str(16 + 8 * (i - 6)) + "(%rbp), %rax\n    movq %rax, " + lslot(i) + "(%rbp)\n" + lparams(t, i + 1)
fn lafn(nm, params, body, s) = lafn_typed(nm, params, body, Nil, s)
fn lafn_typed(nm, params, body, dvars, s) = let locals = app(params, app(lcollect(body), lsds(0, lmdepth(body)))) in let frame = lframe(len(locals)) in let br = laexpr(body, {locals: locals, bound: params, dvars: dvars, depth: 0}, s) in let sub = if frame > 0 then "    subq $" + str(frame) + ", %rsp\n" else "" in lres(nm + ":\n    pushq %rbp\n    movq %rsp, %rbp\n" + sub + lparams(params, 0) + br.code + "    popq %rax\n    movq %rbp, %rsp\n    popq %rbp\n    ret\n", br)

## --- statements: one pass in source order threading the state ---
fn lmlocals(prog) = match prog
    Nil        => Nil
    Cons(h, t) => app(lmlocalsone(h), lmlocals(t))
fn lmlocalsone(s) = match s
    Print(v) => lcollect(v)
    ExprS(v) => lcollect(v)
    _        => Nil
fn lmdprog(prog) = match prog
    Nil        => 0
    Cons(h, t) => imax(lmdone(h), lmdprog(t))
fn lmdone(s) = match s
    Print(v) => lmdepth(v)
    ExprS(v) => lmdepth(v)
    _        => 0
fn lstmts(prog, mlocals, s) = match prog
    Nil        => {funcs: Nil, mains: Nil, nl: s.nl, ns: s.ns, dt: s.dt}
    Cons(h, t) => lstmt(h, t, mlocals, s)
fn lstmt(s0, t, mlocals, s) = match s0
    Fn(nm, ps, body) => lstmtfn(lafn(nm, ps, body, s), t, mlocals)
    Sig(nm, ps, tys, rt) => lstmt_sig(nm, ps, tys, t, mlocals, s)
    Print(v)         => lstmtprint(laexpr(v, {locals: mlocals, bound: Nil, dvars: Nil, depth: 0}, s), t, mlocals)
    ExprS(v)         => lstmtexpr(laexpr(v, {locals: mlocals, bound: Nil, dvars: Nil, depth: 0}, s), t, mlocals)
    _                => lstmts(t, mlocals, s)
fn lstmt_sig(nm, pnames, ptypes, rest, mlocals, s) = match rest
    Nil => lstmts(rest, mlocals, s)
    Cons(Fn(nm2, ps, body), tail) => lstmtfn(lafn_typed(nm2, ps, body, ldecimal_params(pnames, ptypes), s), tail, mlocals)
    _ => lstmts(rest, mlocals, s)
fn ldecimal_params(pnames, ptypes) = match pnames
    Nil => Nil
    Cons(pn, pr) => ldecimal_param(pn, pr, ptypes)
fn ldecimal_param(pn, rest, ptypes) = match ptypes
    Nil => ldecimal_params(rest, Nil)
    Cons(ty, tr) => app(if ldecimal_type(ty) then Cons(pn, Nil) else Nil, ldecimal_params(rest, tr))
fn ldecimal_type(ty) = match ty
    TyDecimal(p, s) => 1
    _ => 0
fn lstmtfn(f, t, mlocals) = let rest = lstmts(t, mlocals, f) in {funcs: Cons(f.code, rest.funcs), mains: rest.mains, nl: rest.nl, ns: rest.ns, dt: rest.dt}
fn lstmtprint(pr, t, mlocals) = let rest = lstmts(t, mlocals, pr) in {funcs: rest.funcs, mains: Cons(pr.code + "    popq %rdi\n    call printval\n", rest.mains), nl: rest.nl, ns: rest.ns, dt: rest.dt}
## an expression statement: evaluate `v` for its effect and DISCARD the pushed value (popq %rax, no printval)
fn lstmtexpr(er, t, mlocals) = let rest = lstmts(t, mlocals, er) in {funcs: rest.funcs, mains: Cons(er.code + "    popq %rax\n", rest.mains), nl: rest.nl, ns: rest.ns, dt: rest.dt}

## --- the program: bss + rodata (oom_msg + string chunks) + text(funcs, runtime, _start, main) ---
fn lgen(prog) = let mlocals = app(lmlocals(prog), lsds(0, lmdprog(prog))) in let gs = lstmts(prog, mlocals, {nl: 0, ns: 0, dt: Nil}) in let mframe = lframe(len(mlocals)) in let mprol = "    movq %rsp, %rbp\n" + (if mframe > 0 then "    subq $" + str(mframe) + ", %rsp\n" else "") in let bss = "    .section .bss\n    .lcomm pbuf, 32\n    .lcomm heap_cur, 8\n    .lcomm heap_end, 8\n    .lcomm emit_buf, 8\n    .lcomm emit_len, 8\n    .lcomm emit_cap, 8\n" in let rodata = "    .section .rodata\noom_msg:\n    .asciz \"lume: out of memory (heap exhausted, brk failed)\\n\"\n" in let heapinit = "    movq $12, %rax\n    xorq %rdi, %rdi\n    syscall\n    movq %rax, heap_cur(%rip)\n    leaq 67108864(%rax), %rdi\n    movq %rdi, %rsi\n    movq $12, %rax\n    syscall\n    cmpq %rsi, %rax\n    jne alloc_oom\n    movq %rsi, heap_end(%rip)\n" in joinall(Cons(bss, Cons(rodata, Cons(joinall(rev(gs.dt)), Cons("    .section .text\n", Cons(joinall(gs.funcs), Cons(runtime_tail(), Cons("    .globl _start\n_start:\n", Cons(heapinit, Cons(mprol, Cons(joinall(gs.mains), Cons("    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n", Nil))))))))))))


## --- runtime (copied verbatim from data_asmgen.lume) ---
fn runtime_tail() = "alloc:\n    movq heap_cur(%rip), %rax\n    movq %rax, %r10\n    addq %rdi, %r10\n    cmpq %rax, %r10\n    jl alloc_oom\n    cmpq heap_end(%rip), %r10\n    jg alloc_grow\n    movq %r10, heap_cur(%rip)\n    ret\nalloc_grow:\n    pushq %rdi\n    pushq %rsi\n    pushq %rdx\n    pushq %rcx\n    pushq %r8\n    pushq %r9\n    pushq %r11\n    movq heap_end(%rip), %rdi\n    addq $67108864, %rdi\n    cmpq %rdi, %r10\n    jle agok\n    movq %r10, %rdi\nagok:\n    movq %rdi, %rsi\n    movq $12, %rax\n    syscall\n    cmpq %rsi, %rax\n    jne alloc_oom\n    movq %rsi, heap_end(%rip)\n    popq %r11\n    popq %r9\n    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rdi\n    movq heap_cur(%rip), %rax\n    movq %r10, heap_cur(%rip)\n    ret\nalloc_oom:\n    movq $2, %rdi\n    leaq oom_msg(%rip), %rsi\n    movq $49, %rdx\n    movq $1, %rax\n    syscall\n    movq $60, %rax\n    movq $12, %rdi\n    syscall\nmkint:\n    movq %rdi, %r11\n    movq $24, %rdi\n    call alloc\n    movq $0, (%rax)\n    movq %r11, 8(%rax)\n    ret\nmkstr:\n    movq %rdi, %r11\n    movq $24, %rdi\n    call alloc\n    movq $1, (%rax)\n    movq %r11, 16(%rax)\n    ret\nmkctor:\n    movq %rdi, %r11\n    movq %rsi, %r13\n    movq %rdx, %r14\n    movq $40, %rdi\n    call alloc\n    movq $2, (%rax)\n    movq %r13, 8(%rax)\n    movq %r11, 16(%rax)\n    movq %r14, 24(%rax)\n    ret\nmkrec:\n    movq %rdi, %r11\n    movq %rsi, %r13\n    movq %rdx, %r14\n    movq $40, %rdi\n    call alloc\n    movq $3, (%rax)\n    movq %r14, 8(%rax)\n    movq %r11, 16(%rax)\n    movq %r13, 24(%rax)\n    ret\nmklist:\n    movq %rdi, %r11\n    movq %rsi, %r13\n    movq $40, %rdi\n    call alloc\n    movq $4, (%rax)\n    movq %r11, 8(%rax)\n    movq %r13, 24(%rax)\n    ret\nrecget:\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    movq %rdi, %r12\n    movq %rsi, %r13\n    xorq %r14, %r14\nrg0:\n    cmpq 8(%r12), %r14\n    jge rgmiss\n    movq 16(%r12), %rax\n    movq (%rax,%r14,8), %rdi\n    movq %r13, %rsi\n    call streq\n    testq %rax, %rax\n    jnz rghit\n    incq %r14\n    jmp rg0\nrghit:\n    movq 24(%r12), %rax\n    movq (%rax,%r14,8), %rax\n    jmp rgdone\nrgmiss:\n    movq $0, %rdi\n    call mkint\nrgdone:\n    popq %r14\n    popq %r13\n    popq %r12\n    ret\nlidx:\n    movq 8(%rsi), %rsi\n    cmpq $4, (%rdi)\n    jne lix0\n    testq %rsi, %rsi\n    js lix0\n    cmpq 8(%rdi), %rsi\n    jge lix0\n    movq 24(%rdi), %rax\n    movq (%rax,%rsi,8), %rax\n    ret\nlix0:\n    movq $0, %rdi\n    call mkint\n    ret\nstrcmpv:\nscp0:\n    movb (%rdi), %al\n    movb (%rsi), %cl\n    cmpb %cl, %al\n    jne scpne\n    testb %al, %al\n    je scpeq\n    incq %rdi\n    incq %rsi\n    jmp scp0\nscpne:\n    movzbl %al, %eax\n    movzbl %cl, %ecx\n    cmpl %ecx, %eax\n    jl scplt\n    movq $1, %rax\n    ret\nscplt:\n    movq $-1, %rax\n    ret\nscpeq:\n    xorq %rax, %rax\n    ret\ncmpv:\n    cmpq $1, (%rdi)\n    jne cmpvi\n    cmpq $1, (%rsi)\n    jne cmpvi\n    movq 16(%rdi), %rdi\n    movq 16(%rsi), %rsi\n    call strcmpv\n    ret\ncmpvi:\n    movq 8(%rdi), %rax\n    movq 8(%rsi), %rcx\n    cmpq %rcx, %rax\n    jl cmpvlt\n    jg cmpvgt\n    xorq %rax, %rax\n    ret\ncmpvlt:\n    movq $-1, %rax\n    ret\ncmpvgt:\n    movq $1, %rax\n    ret\naddv:\n    cmpq $1, (%rdi)\n    je addvs\n    cmpq $1, (%rsi)\n    je addvs\n    movq 8(%rdi), %rax\n    addq 8(%rsi), %rax\n    movq %rax, %rdi\n    call mkint\n    ret\naddvs:\n    movq 16(%rdi), %r8\n    movq 16(%rsi), %r9\n    movq %r8, %rdi\n    call strlen\n    movq %rax, %r12\n    movq %r9, %rdi\n    call strlen\n    movq %rax, %r13\n    leaq 1(%r12,%r13), %rdi\n    call alloc\n    movq %rax, %r14\n    xorq %rcx, %rcx\navca:\n    cmpq %r12, %rcx\n    jge avcb\n    movb (%r8,%rcx), %dl\n    movb %dl, (%r14,%rcx)\n    incq %rcx\n    jmp avca\navcb:\n    xorq %rcx, %rcx\navcc:\n    cmpq %r13, %rcx\n    jge avcd\n    movb (%r9,%rcx), %dl\n    movq %r12, %rax\n    addq %rcx, %rax\n    movb %dl, (%r14,%rax)\n    incq %rcx\n    j