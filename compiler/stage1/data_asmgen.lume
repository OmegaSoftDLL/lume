fn agen(prog: [DStmt]) -> str
    var c = AC(locals: [], nlabel: 0, data: "", nstr: 0, depth: 0)
    var funcs = ""
    var main = ""
    for s in prog
        match s
            DFnS(nm, ps, body) => do
                funcs = funcs + afn(nm, ps, body, c)
            DPrint(v) => do
                c.locals = []
                main = main + aexpr(v, c) + "    popq %rdi\n    call printval\n"
            DLet(nm, v) => do
                let _ = 0
    let bss = "    .section .bss\n    .lcomm pbuf, 32\n    .lcomm heap_cur, 8\n"
    let rodata = "    .section .rodata\n" + c.data
    let heap_init = "    movq $12, %rax\n    xorq %rdi, %rdi\n    syscall\n    movq %rax, heap_cur(%rip)\n    leaq 67108864(%rax), %rdi\n    movq $12, %rax\n    syscall\n"
    bss + rodata + "    .section .text\n" + funcs + runtime_tail() + "    .globl _start\n_start:\n" + heap_init + main + "    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n"
