## data_asmgen.lume — a code generator WRITTEN IN LUME that emits x86-64 machine code
## for the ML-core language, with NO C in the pipeline. The output is assembled by
## `as` and linked by `ld` (assembly is the next dependency to drop, via a direct ELF
## writer). This is "Lume generating machine code": the real target of the project.
##
## Scope (this brick): the functional INTEGER core -- fn, let-in, if/then/else, integer
## arithmetic (+ - * / %), comparisons, and/or/not, calls, recursion, and top-level
## print. Strings / constructors / match / records / lists lower in later bricks.
use data_ast

fn idx_of(xs: [str], name: str) -> int
    var i = 0
    var found = 0 - 1
    for x in xs
        if x == name and found < 0
            found = i
        i = i + 1
    found

## collect let-bound names reachable in an expression (for frame slots)
fn collect_lets(e: DExpr, acc: mut [str])
    match e
        DLetIn(nm, v, body) => do
            acc.push(nm)
            collect_lets(v, acc)
            collect_lets(body, acc)
        DBin(op, l, r) => do
            collect_lets(l, acc)
            collect_lets(r, acc)
        DIf(c, t, e2) => do
            collect_lets(c, acc)
            collect_lets(t, acc)
            collect_lets(e2, acc)
        DCall(nm, args) => do
            for a in args
                collect_lets(a, acc)
        DCons(tag, args) => do
            for a in args
                collect_lets(a, acc)
        DMatch(scrut, arms) => do
            collect_lets(scrut, acc)
            for arm in arms
                collect_pat_binds(arm.pat, acc)
                collect_lets(arm.body, acc)
        _ => do
            let _ = 0

## emit the asm for a binary operator, operands already popped: rax=left, rcx=right
fn abin(op: str) -> str
    if op == "+"
        "    addq %rcx, %rax\n"
    elif op == "-"
        "    subq %rcx, %rax\n"
    elif op == "*"
        "    imulq %rcx, %rax\n"
    elif op == "/"
        "    cqto\n    idivq %rcx\n"
    elif op == "%"
        "    cqto\n    idivq %rcx\n    movq %rdx, %rax\n"
    elif op == "<"
        "    cmpq %rcx, %rax\n    setl %al\n    movzbq %al, %rax\n"
    elif op == ">"
        "    cmpq %rcx, %rax\n    setg %al\n    movzbq %al, %rax\n"
    elif op == "<="
        "    cmpq %rcx, %rax\n    setle %al\n    movzbq %al, %rax\n"
    elif op == ">="
        "    cmpq %rcx, %rax\n    setge %al\n    movzbq %al, %rax\n"
    elif op == "=="
        "    cmpq %rcx, %rax\n    sete %al\n    movzbq %al, %rax\n"
    elif op == "!="
        "    cmpq %rcx, %rax\n    setne %al\n    movzbq %al, %rax\n"
    elif op == "and"
        "    cmpq $0, %rax\n    setne %al\n    cmpq $0, %rcx\n    setne %cl\n    andb %cl, %al\n    movzbq %al, %rax\n"
    elif op == "or"
        "    cmpq $0, %rax\n    setne %al\n    cmpq $0, %rcx\n    setne %cl\n    orb %cl, %al\n    movzbq %al, %rax\n"
    else
        "    # unsupported op\n"

type AC = record
    locals: [str]
    nlabel: int
    data:   str
    nstr:   int
    depth:  int

## escape a string for a .asciz directive (quote + backslash)
fn sesc(s: str) -> str
    var out = ""
    for ch in s.chars()
        if ch == '"' or ch == '\\'
            out = out + "\\" + str(ch)
        else
            out = out + str(ch)
    out

## maximum match-nesting depth in an expression (for scrutinee frame slots)
fn imax(a: int, b: int) -> int = if a > b then a else b

fn match_depth(e: DExpr) -> int
    match e
        DMatch(scrut, arms) => do
            var m = match_depth(scrut)
            for arm in arms
                m = imax(m, match_depth(arm.body))
            m + 1
        DIf(cc, t, e2) => imax(match_depth(cc), imax(match_depth(t), match_depth(e2)))
        DBin(op, l, r) => imax(match_depth(l), match_depth(r))
        DLetIn(nm, v, b) => imax(match_depth(v), match_depth(b))
        DCall(nm, args) => do
            var m = 0
            for a in args
                m = imax(m, match_depth(a))
            m
        DCons(tag, args) => do
            var m = 0
            for a in args
                m = imax(m, match_depth(a))
            m
        _ => 0

## collect the PBind names in a pattern (they become frame slots)
fn collect_pat_binds(p: Pat, acc: mut [str])
    match p
        PBind(nm) => acc.push(nm)
        PCons(tag, subs) => do
            for s in subs
                collect_pat_binds(s, acc)
        _ => do
            let _ = 0

## emit a .rodata string literal, returning its label
fn strlabel(s: str, c: mut AC) -> str
    let lab = ".Ls" + str(c.nstr)
    c.nstr = c.nstr + 1
    c.data = c.data + lab + ":\n    .asciz \"" + sesc(s) + "\"\n"
    lab

## `acc` is asm that loads a value pointer into %rax. Emit a test that jumps to
## `fail` when pattern `p` does not match that value; otherwise falls through.
fn atest(p: Pat, acc: str, flbl: str, c: mut AC) -> str
    match p
        PWild    => ""
        PBind(nm) => ""
        PInt(n)  => acc + "    cmpq $0, (%rax)\n    jne " + flbl + "\n    cmpq $" + str(n) + ", 8(%rax)\n    jne " + flbl + "\n"
        PCons(tag, subs) => do
            let nlab = strlabel(tag, c)
            var out = acc + "    cmpq $2, (%rax)\n    jne " + flbl + "\n    movq 16(%rax), %rdi\n    leaq " + nlab + "(%rip), %rsi\n    call streq\n    testq %rax, %rax\n    jz " + flbl + "\n"
            var k = 0
            for s in subs
                let acck = acc + "    movq 24(%rax), %rax\n    movq " + str(k * 8) + "(%rax), %rax\n"
                out = out + atest(s, acck, flbl, c)
                k = k + 1
            out

## emit the variable bindings a pattern introduces (store value ptrs to slots)
fn abind(p: Pat, acc: str, c: mut AC) -> str
    match p
        PBind(nm) => do
            let k = idx_of(c.locals, nm)
            acc + "    movq %rax, " + str(0 - 8 * (k + 1)) + "(%rbp)\n"
        PCons(tag, subs) => do
            var out = ""
            var k = 0
            for s in subs
                let acck = acc + "    movq 24(%rax), %rax\n    movq " + str(k * 8) + "(%rax), %rax\n"
                out = out + abind(s, acck, c)
                k = k + 1
            out
        _ => ""

fn areg(i: int) -> str
    let regs = ["%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"]
    regs[i]

## emit asm that computes `e` and leaves its value pushed on the stack
fn aexpr(e: DExpr, c: mut AC) -> str
    match e
        DInt(n) => "    movq $" + str(n) + ", %rdi\n    call mkint\n    pushq %rax\n"
        DStr(v) => do
            let lab = strlabel(v, c)
            "    leaq " + lab + "(%rip), %rdi\n    call mkstr\n    pushq %rax\n"
        DVar(nm) => do
            let k = idx_of(c.locals, nm)
            "    movq " + str(0 - 8 * (k + 1)) + "(%rbp), %rax\n    pushq %rax\n"
        DBin(op, l, r) => do
            let a = aexpr(l, c)
            let b = aexpr(r, c)
            if op == "=="
                a + b + "    popq %rsi\n    popq %rdi\n    call eqv\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n"
            elif op == "!="
                a + b + "    popq %rsi\n    popq %rdi\n    call eqv\n    xorq $1, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n"
            elif op == "+"
                a + b + "    popq %rsi\n    popq %rdi\n    call addv\n    pushq %rax\n"
            elif op == "<" or op == ">" or op == "<=" or op == ">="
                var setc = "    setl %al\n"
                if op == ">"
                    setc = "    setg %al\n"
                elif op == "<="
                    setc = "    setle %al\n"
                elif op == ">="
                    setc = "    setge %al\n"
                a + b + "    popq %rsi\n    popq %rdi\n    call cmpv\n    cmpq $0, %rax\n" + setc + "    movzbq %al, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n"
            else
                a + b + "    popq %rcx\n    popq %rax\n    movq 8(%rax), %rax\n    movq 8(%rcx), %rcx\n" + abin(op) + "    movq %rax, %rdi\n    call mkint\n    pushq %rax\n"
        DIf(cond, t, e2) => do
            let lab = c.nlabel
            c.nlabel = c.nlabel + 1
            let cc = aexpr(cond, c)
            let tt = aexpr(t, c)
            let ee = aexpr(e2, c)
            cc + "    popq %rax\n    movq 8(%rax), %rax\n    testq %rax, %rax\n    jz .Le" + str(lab) + "\n" + tt + "    jmp .Lx" + str(lab) + "\n.Le" + str(lab) + ":\n" + ee + ".Lx" + str(lab) + ":\n"
        DLetIn(nm, v, body) => do
            let vv = aexpr(v, c)
            let k = idx_of(c.locals, nm)
            let st = "    popq %rax\n    movq %rax, " + str(0 - 8 * (k + 1)) + "(%rbp)\n"
            vv + st + aexpr(body, c)
        DCall(nm, args) => do
            var out = ""
            for a in args
                out = out + aexpr(a, c)
            var i = args.len() - 1
            while i >= 0
                out = out + "    popq " + areg(i) + "\n"
                i = i - 1
            out + "    call " + nm + "\n    pushq %rax\n"
        DCons(tag, args) => do
            let nlab = strlabel(tag, c)
            let n = args.len()
            if n == 0
                "    leaq " + nlab + "(%rip), %rdi\n    movq $0, %rsi\n    movq $0, %rdx\n    call mkctor\n    pushq %rax\n"
            else
                var out = ""
                for a in args
                    out = out + aexpr(a, c)
                out = out + "    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rcx\n"
                var k = n - 1
                while k >= 0
                    out = out + "    popq %rax\n    movq %rax, " + str(k * 8) + "(%rcx)\n"
                    k = k - 1
                out + "    leaq " + nlab + "(%rip), %rdi\n    movq $" + str(n) + ", %rsi\n    movq %rcx, %rdx\n    call mkctor\n    pushq %rax\n"
        DMatch(scrut, arms) => do
            let lab = c.nlabel
            c.nlabel = c.nlabel + 1
            let dep = c.depth
            c.depth = c.depth + 1
            let slotk = idx_of(c.locals, "_sd" + str(dep))
            let soff = str(0 - 8 * (slotk + 1))
            let acc = "    movq " + soff + "(%rbp), %rax\n"
            let endl = ".Lm" + str(lab) + "_end"
            var out = aexpr(scrut, c) + "    popq %rax\n    movq %rax, " + soff + "(%rbp)\n"
            var i = 0
            for arm in arms
                let faill = ".Lm" + str(lab) + "_" + str(i + 1)
                out = out + ".Lm" + str(lab) + "_" + str(i) + ":\n" + atest(arm.pat, acc, faill, c) + abind(arm.pat, acc, c) + aexpr(arm.body, c) + "    jmp " + endl + "\n"
                i = i + 1
            out = out + ".Lm" + str(lab) + "_" + str(i) + ":\n    movq $0, %rdi\n    call mkint\n    pushq %rax\n" + endl + ":\n"
            c.depth = dep
            out
        DRec(fields) => do
            let n = fields.len()
            if n == 0
                "    movq $0, %rdi\n    movq $0, %rsi\n    movq $0, %rdx\n    call mkrec\n    pushq %rax\n"
            else
                var out = ""
                for f in fields
                    out = out + aexpr(f.value, c)
                out = out + "    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rcx\n"
                var k = n - 1
                while k >= 0
                    out = out + "    popq %rax\n    movq %rax, " + str(k * 8) + "(%rcx)\n"
                    k = k - 1
                out = out + "    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rdx\n"
                var j = 0
                for f in fields
                    let nl = strlabel(f.name, c)
                    out = out + "    leaq " + nl + "(%rip), %rax\n    movq %rax, " + str(j * 8) + "(%rdx)\n"
                    j = j + 1
                out + "    movq %rdx, %rdi\n    movq %rcx, %rsi\n    movq $" + str(n) + ", %rdx\n    call mkrec\n    pushq %rax\n"
        DField(o, nm) => do
            let nl = strlabel(nm, c)
            aexpr(o, c) + "    popq %rdi\n    leaq " + nl + "(%rip), %rsi\n    call recget\n    pushq %rax\n"
        DList(xs) => do
            let n = xs.len()
            if n == 0
                "    movq $0, %rdi\n    movq $0, %rsi\n    call mklist\n    pushq %rax\n"
            else
                var out = ""
                for x in xs
                    out = out + aexpr(x, c)
                out = out + "    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rcx\n"
                var k = n - 1
                while k >= 0
                    out = out + "    popq %rax\n    movq %rax, " + str(k * 8) + "(%rcx)\n"
                    k = k - 1
                out + "    movq $" + str(n) + ", %rdi\n    movq %rcx, %rsi\n    call mklist\n    pushq %rax\n"
        DIndex(coll, ix) => aexpr(coll, c) + aexpr(ix, c) + "    popq %rsi\n    popq %rdi\n    call lidx\n    pushq %rax\n"
        _ => "    movq $0, %rax\n    pushq %rax\n    # unsupported expr\n"

fn afn(nm: str, params: [str], body: DExpr, c: mut AC) -> str
    var locals = []
    for p in params
        locals.push(p)
    collect_lets(body, locals)
    let md = match_depth(body)
    var di = 0
    while di < md
        locals.push("_sd" + str(di))
        di = di + 1
    c.locals = locals
    c.depth = 0
    var frame = locals.len() * 8
    if frame % 16 != 0
        frame = frame + 8
    var out = nm + ":\n    pushq %rbp\n    movq %rsp, %rbp\n"
    if frame > 0
        out = out + "    subq $" + str(frame) + ", %rsp\n"
    var i = 0
    for p in params
        out = out + "    movq " + areg(i) + ", " + str(0 - 8 * (i + 1)) + "(%rbp)\n"
        i = i + 1
    out = out + aexpr(body, c)
    out + "    popq %rax\n    movq %rbp, %rsp\n    popq %rbp\n    ret\n"

fn runtime_tail() -> str
    "alloc:\n    movq heap_cur(%rip), %rax\n    movq %rax, %r10\n    addq %rdi, %r10\n    movq %r10, heap_cur(%rip)\n    ret\nmkint:\n    movq %rdi, %r11\n    movq $24, %rdi\n    call alloc\n    movq $0, (%rax)\n    movq %r11, 8(%rax)\n    ret\nmkstr:\n    movq %rdi, %r11\n    movq $24, %rdi\n    call alloc\n    movq $1, (%rax)\n    movq %r11, 16(%rax)\n    ret\nmkctor:\n    movq %rdi, %r11\n    movq %rsi, %r13\n    movq %rdx, %r14\n    movq $40, %rdi\n    call alloc\n    movq $2, (%rax)\n    movq %r13, 8(%rax)\n    movq %r11, 16(%rax)\n    movq %r14, 24(%rax)\n    ret\nmkrec:\n    movq %rdi, %r11\n    movq %rsi, %r13\n    movq %rdx, %r14\n    movq $40, %rdi\n    call alloc\n    movq $3, (%rax)\n    movq %r14, 8(%rax)\n    movq %r11, 16(%rax)\n    movq %r13, 24(%rax)\n    ret\nmklist:\n    movq %rdi, %r11\n    movq %rsi, %r13\n    movq $40, %rdi\n    call alloc\n    movq $4, (%rax)\n    movq %r11, 8(%rax)\n    movq %r13, 24(%rax)\n    ret\nrecget:\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    movq %rdi, %r12\n    movq %rsi, %r13\n    xorq %r14, %r14\nrg0:\n    cmpq 8(%r12), %r14\n    jge rgmiss\n    movq 16(%r12), %rax\n    movq (%rax,%r14,8), %rdi\n    movq %r13, %rsi\n    call streq\n    testq %rax, %rax\n    jnz rghit\n    incq %r14\n    jmp rg0\nrghit:\n    movq 24(%r12), %rax\n    movq (%rax,%r14,8), %rax\n    jmp rgdone\nrgmiss:\n    movq $0, %rdi\n    call mkint\nrgdone:\n    popq %r14\n    popq %r13\n    popq %r12\n    ret\nlidx:\n    movq 8(%rsi), %rsi\n    cmpq $4, (%rdi)\n    jne lix0\n    testq %rsi, %rsi\n    js lix0\n    cmpq 8(%rdi), %rsi\n    jge lix0\n    movq 24(%rdi), %rax\n    movq (%rax,%rsi,8), %rax\n    ret\nlix0:\n    movq $0, %rdi\n    call mkint\n    ret\nstrcmpv:\nscp0:\n    movb (%rdi), %al\n    movb (%rsi), %cl\n    cmpb %cl, %al\n    jne scpne\n    testb %al, %al\n    je scpeq\n    incq %rdi\n    incq %rsi\n    jmp scp0\nscpne:\n    movzbl %al, %eax\n    movzbl %cl, %ecx\n    cmpl %ecx, %eax\n    jl scplt\n    movq $1, %rax\n    ret\nscplt:\n    movq $-1, %rax\n    ret\nscpeq:\n    xorq %rax, %rax\n    ret\ncmpv:\n    cmpq $1, (%rdi)\n    jne cmpvi\n    cmpq $1, (%rsi)\n    jne cmpvi\n    movq 16(%rdi), %rdi\n    movq 16(%rsi), %rsi\n    call strcmpv\n    ret\ncmpvi:\n    movq 8(%rdi), %rax\n    movq 8(%rsi), %rcx\n    cmpq %rcx, %rax\n    jl cmpvlt\n    jg cmpvgt\n    xorq %rax, %rax\n    ret\ncmpvlt:\n    movq $-1, %rax\n    ret\ncmpvgt:\n    movq $1, %rax\n    ret\naddv:\n    cmpq $1, (%rdi)\n    je addvs\n    cmpq $1, (%rsi)\n    je addvs\n    movq 8(%rdi), %rax\n    addq 8(%rsi), %rax\n    movq %rax, %rdi\n    call mkint\n    ret\naddvs:\n    movq 16(%rdi), %r8\n    movq 16(%rsi), %r9\n    movq %r8, %rdi\n    call strlen\n    movq %rax, %r12\n    movq %r9, %rdi\n    call strlen\n    movq %rax, %r13\n    leaq 1(%r12,%r13), %rdi\n    call alloc\n    movq %rax, %r14\n    xorq %rcx, %rcx\navca:\n    cmpq %r12, %rcx\n    jge avcb\n    movb (%r8,%rcx), %dl\n    movb %dl, (%r14,%rcx)\n    incq %rcx\n    jmp avca\navcb:\n    xorq %rcx, %rcx\navcc:\n    cmpq %r13, %rcx\n    jge avcd\n    movb (%r9,%rcx), %dl\n    movq %r12, %rax\n    addq %rcx, %rax\n    movb %dl, (%r14,%rax)\n    incq %rcx\n    jmp avcc\navcd:\n    movq %r12, %rax\n    addq %r13, %rax\n    movb $0, (%r14,%rax)\n    movq %r14, %rdi\n    call mkstr\n    ret\ncount:\n    cmpq $4, (%rdi)\n    jne cnts\n    movq 8(%rdi), %rdi\n    call mkint\n    ret\ncnts:\n    movq 16(%rdi), %rdi\n    call strlen\n    movq %rax, %rdi\n    call mkint\n    ret\nat:\n    movq 16(%rdi), %r8\n    movq 8(%rsi), %r9\n    movq $2, %rdi\n    call alloc\n    movb (%r8,%r9), %dl\n    movb %dl, (%rax)\n    movb $0, 1(%rax)\n    movq %rax, %rdi\n    call mkstr\n    ret\nslice:\n    movq 16(%rdi), %r8\n    movq 8(%rsi), %r12\n    movq 8(%rdx), %r13\n    testq %r12, %r12\n    jns slao\n    xorq %r12, %r12\nslao:\n    movq %r8, %rdi\n    call strlen\n    cmpq %rax, %r13\n    jle slbo\n    movq %rax, %r13\nslbo:\n    movq %r13, %r14\n    subq %r12, %r14\n    test