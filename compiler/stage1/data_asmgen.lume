fn agen(prog: [DStmt]) -> str
    var c = AC(locals: [], nlabel: 0, data: [], nstr: 0, depth: 0, globals: [], bound: [], out: [])
    ## funcs / main accumulate the whole program: build them as chunk lists and
    ## join once (O(n)), never `s = s + piece` in a loop (O(n^2), and the seed
    ## interpreter never frees the intermediates -> out of memory on large input).
    var funcs = []
    var main = []
    ## top-level `let`s are globals; the main body (lets + prints, in source order) gets a frame
    var gl = []
    var mlocals = []
    var mdepth = 0
    for s in prog
        match s
            DLet(nm, v) => do
                if idx_of(gl, nm) < 0
                    gl.push(nm)
                collect_lets(v, mlocals)
                mdepth = imax(mdepth, match_depth(v))
            DPrint(v) => do
                collect_lets(v, mlocals)
                mdepth = imax(mdepth, match_depth(v))
            DExprS(v) => do
                collect_lets(v, mlocals)
                mdepth = imax(mdepth, match_depth(v))
            DFnS(nm, ps, body) => do
                let _ = 0
    c.globals = gl
    var di = 0
    while di < mdepth
        mlocals.push("_sd" + str(di))
        di = di + 1
    for s in prog
        match s
            DFnS(nm, ps, body) => do
                funcs.push(afn(nm, ps, body, c))
            DPrint(v) => do
                c.locals = mlocals
                c.depth = 0
                c.bound = []
                c.out = []
                aexpr(v, c)
                c.out.push("    popq %rdi\n    call printval\n")
                main.push(c.out.join(""))
            DExprS(v) => do
                c.locals = mlocals
                c.depth = 0
                c.bound = []
                c.out = []
                aexpr(v, c)
                c.out.push("    popq %rax\n")
                main.push(c.out.join(""))
            DLet(nm, v) => do
                c.locals = mlocals
                c.depth = 0
                c.bound = []
                c.out = []
                aexpr(v, c)
                c.out.push("    popq %rax\n    movq %rax, " + gsym(nm) + "(%rip)\n")
                main.push(c.out.join(""))
    var bss = "    .section .bss\n    .lcomm pbuf, 32\n    .lcomm heap_cur, 8\n    .lcomm heap_end, 8\n    .lcomm emit_buf, 8\n    .lcomm emit_len, 8\n    .lcomm emit_cap, 8\n"
    var ginit = ""
    for g in gl
        bss = bss + "    .lcomm " + gsym(g) + ", 8\n"
        ## a global read before its `let` runs is int 0 (what the interpreter yields)
        ginit = ginit + "    movq $0, %rdi\n    call mkint\n    movq %rax, " + gsym(g) + "(%rip)\n"
    var mframe = mlocals.len() * 8
    if mframe % 16 != 0
        mframe = mframe + 8
    var mprol = "    movq %rsp, %rbp\n"
    if mframe > 0
        mprol = mprol + "    subq $" + str(mframe) + ", %rsp\n"
    let rodata = "    .section .rodata\noom_msg:\n    .asciz \"lume: out of memory (heap exhausted, brk failed)\\n\"\n" + c.data.join("")
    let heap_init = "    movq $12, %rax\n    xorq %rdi, %rdi\n    syscall\n    movq %rax, heap_cur(%rip)\n    leaq 67108864(%rax), %rdi\n    movq %rdi, %rsi\n    movq $12, %rax\n    syscall\n    cmpq %rsi, %rax\n    jne alloc_oom\n    movq %rsi, heap_end(%rip)\n"
    var rtail = runtime_tail()
    if uses_fs_prog(prog)
        rtail = rtail + runtime_fs_tail()
    bss + rodata + "    .section .text\n" + funcs.join("") + rtail + "    .globl _start\n_start:\n" + heap_init + mprol + ginit + main.join("") + "    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n"
