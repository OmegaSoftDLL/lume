## data_asm_cc.lume — compile an ML-core (.src) program straight to x86-64 asm (NO C).
## Usage: lume0 run data_asm_cc.lume in.src out.s  (then as -o x.o out.s ; ld -o x x.o ; ./x)
use data_ast
use data_parser
use data_asmgen
use std.io

fn main()
    let args = env.args()
    if args.len() < 2
        io.println("usage: data_asm_cc.lume <in.src> <out.s>")
    else
        let s = agen(parse_data_program(io.read_file(args[0])))
        let w = io.write_file(args[1], s)
        io.println("emitted asm {args[0]} -> {args[1]}")
