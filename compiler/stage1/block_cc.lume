## block_cc.lume — the block-language compiler as a command-line tool, written in Lume.
## Reads a source file, compiles it to C. Usage: lume0 run block_cc.lume in.blk out.c
use block_ast
use block_parser
use block_codegen
use std.io

fn main()
    let args = env.args()
    if args.len() < 2
        io.println("usage: block_cc.lume <in.blk> <out.c>")
        return
    let c = cgen_block(parse_block_program(io.read_file(args[0])))
    let wrote = io.write_file(args[1], c)
    io.println("compiled {args[0]} -> {args[1]}")
