## data_demo.lume — enums with payloads + match over a user-defined type, interpreted in Lume.
use data_ast
use data_parser
use data_eval
use std.io

fn main()
    let program = "let s = Circle(5)\nlet area = match s\n    Circle(r) => r * r * 3\n    Rect(w, h) => w * h\n    Empty => 0\nprint area\nlet t = Rect(4, 6)\nprint match t\n    Circle(r) => r * r * 3\n    Rect(w, h) => w * h\n    Empty => 0\nlet shapes = Pair(Circle(2), Rect(3, 3))\nprint shapes\nprint match shapes\n    Pair(Circle(r), Rect(w, h)) => r + w + h\n    _ => -1\n"
    run_data(parse_data_program(program))
