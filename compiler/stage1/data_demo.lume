## data_demo.lume — ADTs + match + recursive functions, a small ML core interpreted in Lume.
use data_ast
use data_parser
use data_eval
use std.io

fn main()
    let program = "fn area(s) = match s\n    Circle(r) => r * r * 3\n    Rect(w, h) => w * h\n    Empty => 0\nfn sumlist(xs) = match xs\n    Nil => 0\n    Cons(h, t) => h + sumlist(t)\nfn len(xs) = match xs\n    Nil => 0\n    Cons(h, t) => 1 + len(t)\nlet c = Circle(5)\nprint area(c)\nprint area(Rect(4, 6))\nlet xs = Cons(10, Cons(20, Cons(30, Nil)))\nprint sumlist(xs)\nprint len(xs)\n"
    run_data(parse_data_program(program))
