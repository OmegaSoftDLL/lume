## nat_ackermann.lume — small Ackermann values: deep non-tail recursion, nested if/else values (no C).
## lume0 emit-asm nat_ackermann.lume a.s ; as -o a.o a.s ; ld -o a a.o ; ./a
fn ack(m: int, n: int) -> int
    if m == 0
        n + 1
    else
        if n == 0
            ack(m - 1, 1)
        else
            ack(m - 1, ack(m, n - 1))

ack(0, 0)
ack(1, 2)
ack(2, 3)
ack(3, 3)
ack(3, 5)
