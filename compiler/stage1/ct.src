fn main_val() = comptime(2 + 3 * 4)
print comptime(2 + 3 * 4)
print comptime(if 1 < 2 then 10 else 20)
print comptime(let x = 5 in x * x)
print comptime("a" + "b")
print comptime(100 - 2 * (3 + 4))
print comptime(17 % 5)
print comptime(let a = 6 in let b = 7 in a * b)
print comptime(if 2 > 3 or 1 == 1 then 111 else 222)
