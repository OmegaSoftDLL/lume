fn ld_rfind_slash(path, i) = if i < 0 then 0 - 1 else if at(path, i) == "/" then i else ld_rfind_slash(path, i - 1)

fn ld_dir(path) = let slash = ld_rfind_slash(path, count(path) - 1) in if slash < 0 then "" else if slash == 0 then "/" else slice(path, 0, slash)

fn ld_base(path) = let slash = ld_rfind_slash(path, count(path) - 1) in slice(path, slash + 1, count(path))

fn ld_root() = let bin = ld_dir(os_arg_at(0)) in let parent = ld_dir(bin) in if ld_base(parent) == "build" then let root = ld_dir(parent) in if root == "" then "." else root else parent

fn ld_tool(root, name) = root + "/build/bin/" + name

fn ld_chomp(text) = if count(text) > 0 and at(text, count(text) - 1) == "\n" then slice(text, 0, count(text) - 1) else text

fn ld_request(root, tool, request) = let input = root + "/build/lume-driver.in" in let output = root + "/build/lume-driver.out" in let errors = root + "/build/lume-driver.err" in let written = fs_write_sync(input, request) in if written != 1 then ctfail("native driver cannot write tool request\n") else let status = os_run_input_capture_timeout(ld_tool(root, tool), Nil, input, output, errors, 120000) in if status != 0 then ctfail("native driver tool failed: " + tool + " status " + str(status) + "\nstdout:\n" + fs_read_file(output) + "\nstderr:\n" + fs_read_file(errors)) else ld_chomp(fs_read_file(output))

fn ld_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else ld_contains_at(text, part, i + 1)

fn ld_has_import(source) = let text = fs_read_file(source) in if slice(text, 0, 4) == "use " then 1 else ld_contains_at(text, "\nuse ", 0)

fn ld_ltrim(s, i) = if i >= count(s) then "" else if at(s, i) == " " or at(s, i) == "\t" or at(s, i) == "\r" then ld_ltrim(s, i + 1) else slice(s, i, count(s))

fn ld_rtrim(s) = if count(s) == 0 then "" else if at(s, count(s) - 1) == " " or at(s, count(s) - 1) == "\t" or at(s, count(s) - 1) == "\r" or at(s, count(s) - 1) == "\n" then ld_rtrim(slice(s, 0, count(s) - 1)) else s

fn ld_trim(s) = ld_rtrim(ld_ltrim(s, 0))

fn ld_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else ld_line_end(s, i + 1)

fn ld_lines(s, i) = if i >= count(s) then Nil else let e = ld_line_end(s, i) in Cons(slice(s, i, e), ld_lines(s, e + 1))

fn ld_starts(s, prefix) = if count(s) < count(prefix) then 0 else slice(s, 0, count(prefix)) == prefix

fn ld_delim(s, i) = if i >= count(s) then i else if at(s, i) == " " or at(s, i) == "\t" or at(s, i) == "(" then i else ld_delim(s, i + 1)

fn ld_import_line(line) = let tr = ld_trim(line) in if ld_starts(tr, "use ") == 0 then "" else let raw = ld_trim(slice(tr, 4, count(tr))) in let no_std = if ld_starts(raw, "std.") == 1 then slice(raw, 4, count(raw)) else raw in slice(no_std, 0, ld_delim(no_std, 0))

fn ld_imports(path) = ld_import_lines(ld_lines(fs_read_file(path), 0))

fn ld_import_lines(lines) = match lines
    Nil => Nil
    Cons(h, t) => let name = ld_import_line(h) in if name == "" then ld_import_lines(t) else Cons(name, ld_import_lines(t))

fn ld_member(names, name) = match names
    Nil => 0
    Cons(h, t) => if h == name then 1 else ld_member(t, name)

fn ld_find_module(root, dir, name) = let local = dir + "/" + name + ".src" in let nested = dir + "/src/" + name + ".src" in let dependency = dir + "/deps/" + name + ".src" in let shared = root + "/compiler/stage1/" + name + ".src" in if fs_path_exists(local) == 1 then local else if fs_path_exists(nested) == 1 then nested else if fs_path_exists(dependency) == 1 then dependency else if fs_path_exists(shared) == 1 then shared else ctfail("native bundling cannot resolve module: " + name + "\n")

fn ld_append(out, text) = if fs_append_sync(out, text) == 1 then 1 else ctfail("native bundling cannot append request: " + out + "\n")

fn ld_collect(root, dir, out, names, seen) = match names
    Nil => seen
    Cons(h, t) => if ld_member(seen, h) == 1 then ld_collect(root, dir, out, t, seen) else let path = ld_find_module(root, dir, h) in let written = ld_append(out, "@module " + h + "\n" + fs_read_file(path) + "\n@end\n") in let next_seen = ld_collect(root, dir, out, ld_imports(path), Cons(h, seen)) in ld_collect(root, dir, out, t, next_seen)

fn ld_entry_name(source) = let base = ld_base(source) in if count(base) > 4 and slice(base, count(base) - 4, count(base)) == ".src" then slice(base, 0, count(base) - 4) else base

fn ld_bundle(root, source, out) = let bundled = out + ".bundled.src" in if ld_has_import(source) == 0 then let written = fs_write_sync(bundled, fs_read_file(source)) in if written != 1 then ctfail("native bundling cannot copy source\n") else bundled else let request = out + ".bundle.in" in let started = fs_write_sync(request, "@grant io\n") in if started != 1 then ctfail("native bundling cannot initialize request\n") else let dir = ld_dir(source) in let collected = ld_collect(root, dir, request, ld_imports(source), Cons(ld_entry_name(source), Nil)) in let entry = ld_append(request, "@entry " + ld_entry_name(source) + "\n" + fs_read_file(source) + "\n@end\n") in let errors = out + ".bundle.err" in let status = os_run_input_capture_timeout(ld_tool(root, "lmod"), Nil, request, bundled, errors, 120000) in if status != 0 then ctfail("native bundling failed:\n" + fs_read_file(errors)) else bundled

fn ld_build(root, source, out) = if fs_path_exists(source) == 0 then ctfail("native build cannot read " + source + "\n") else let bundled = ld_bundle(root, source, out) in let assembly = out + ".s" in let compile_errors = out + ".compile.err" in let compiled = os_run_input_capture_timeout(ld_tool(root, "lumec"), Nil, bundled, assembly, compile_errors, 120000) in if compiled != 0 then ctfail("native build compiler failed:\n" + fs_read_file(compile_errors)) else let assemble_errors = out + ".assemble.err" in let assembled = os_run_input_capture_timeout(ld_tool(root, "lasm"), Nil, assembly, out, assemble_errors, 120000) in if assembled != 0 then ctfail("native build assembler failed:\n" + fs_read_file(assemble_errors)) else os_run("/bin/chmod", Cons("+x", Cons(out, Nil)))

fn ld_args_from(i) = if i >= os_arg_count() then Nil else Cons(os_arg_at(i), ld_args_from(i + 1))

fn ld_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128

fn ld_run(root, source) = let binary = root + "/build/lume-driver-run" in let built = ld_build(root, source, binary) in if built != 0 then built else ld_wait_exit(os_run(binary, ld_args_from(3)))

fn ld_agent_direct(mode) = if mode == "check" or mode == "compile" or mode == "prove" or mode == "ast" or mode == "expand" or mode == "symbols" or mode == "eval" then 1 else 0

fn ld_agent_query(mode) = if mode == "witness" or mode == "repair" or mode == "impact" or mode == "hashes" or mode == "grammar" or mode == "project" then 1 else 0

fn ld_agent(root, mode, source) = if ld_agent_direct(mode) == 0 and ld_agent_query(mode) == 0 then ctfail("usage: lume_driver agent check|compile|prove|ast|expand|symbols|eval|witness|repair|impact|hashes|grammar|project <source.src>\n") else if fs_path_exists(source) == 0 then ctfail("native agent cannot read " + source + "\n") else let prefix = if ld_agent_query(mode) == 1 then "@mode " + mode + "\n" else "" in let result = ld_request(root, "lcaas", prefix + fs_read_file(source)) in if ld_contains_at(result, "\"ok\":false", 0) == 1 then ctfail(result + "\n") else result

fn ld_agent_entry(root) = if os_arg_count() == 4 then ld_agent(root, os_arg_at(2), os_arg_at(3)) else ctfail("usage: lume_driver agent <mode> <source.src>\n")

fn ld_info(root) = if os_arg_count() != 2 then ctfail("usage: lume_driver --version|--help|describe|targets|build <source> -o <out>|run <source> [args]|agent <mode> <source.src>\n") else let command = os_arg_at(1) in if command == "--version" or command == "version" then ld_request(root, "lcli", "@cmd version\n") else if command == "--help" or command == "-h" or command == "help" then ld_request(root, "lcli", "@cmd help\n") else if command == "describe" or command == "--describe" then ld_request(root, "lcli", "@cmd describe\n") else if command == "targets" or command == "--targets" then ld_request(root, "ltarget", "@targets-json\n") else ctfail("unknown native driver command: " + command + "\n")

fn ld_entry(root) = if os_arg_count() >= 2 and os_arg_at(1) == "build" then (if os_arg_count() != 5 or os_arg_at(3) != "-o" then ctfail("usage: lume_driver build <source> -o <out>\n") else os_exit(ld_build(root, os_arg_at(2), os_arg_at(4)))) else if os_arg_count() >= 3 and os_arg_at(1) == "run" then os_exit(ld_run(root, os_arg_at(2))) else if os_arg_at(1) == "agent" then ld_agent_entry(root) else ld_info(root)

print ld_entry(ld_root())
