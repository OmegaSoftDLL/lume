fn ld_rfind_slash(path, i) = if i < 0 then 0 - 1 else if at(path, i) == "/" then i else ld_rfind_slash(path, i - 1)

fn ld_dir(path) = let slash = ld_rfind_slash(path, count(path) - 1) in if slash < 0 then "" else if slash == 0 then "/" else slice(path, 0, slash)

fn ld_base(path) = let slash = ld_rfind_slash(path, count(path) - 1) in slice(path, slash + 1, count(path))

fn ld_root() = let bin = ld_dir(os_arg_at(0)) in let parent = ld_dir(bin) in if ld_base(parent) == "build" then let root = ld_dir(parent) in if root == "" then "." else root else parent

fn ld_tool(root, name) = root + "/build/bin/" + name

fn ld_request(root, tool, request) = let input = root + "/build/lume-driver.in" in let output = root + "/build/lume-driver.out" in let errors = root + "/build/lume-driver.err" in let written = fs_write_sync(input, request) in if written != 1 then ctfail("native driver cannot write tool request\n") else let status = os_run_input_capture_timeout(ld_tool(root, tool), Nil, input, output, errors, 120000) in if status != 0 then ctfail("native driver tool failed: " + tool + "\n" + fs_read_file(errors)) else fs_read_file(output)

fn ld_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else ld_contains_at(text, part, i + 1)

fn ld_has_import(source) = let text = fs_read_file(source) in if slice(text, 0, 4) == "use " then 1 else ld_contains_at(text, "\nuse ", 0)

fn ld_build(root, source, out) = if fs_path_exists(source) == 0 then ctfail("native build cannot read " + source + "\n") else if ld_has_import(source) == 1 then ctfail("native build module bundling is not migrated yet: " + source + "\n") else let assembly = out + ".s" in let compile_errors = out + ".compile.err" in let compiled = os_run_input_capture_timeout(ld_tool(root, "lumec"), Nil, source, assembly, compile_errors, 120000) in if compiled != 0 then ctfail("native build compiler failed:\n" + fs_read_file(compile_errors)) else let assemble_errors = out + ".assemble.err" in let assembled = os_run_input_capture_timeout(ld_tool(root, "lasm"), Nil, assembly, out, assemble_errors, 120000) in if assembled != 0 then ctfail("native build assembler failed:\n" + fs_read_file(assemble_errors)) else os_run("/bin/chmod", Cons("+x", Cons(out, Nil)))

fn ld_args_from(i) = if i >= os_arg_count() then Nil else Cons(os_arg_at(i), ld_args_from(i + 1))

fn ld_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128

fn ld_run(root, source) = let binary = root + "/build/lume-driver-run" in let built = ld_build(root, source, binary) in if built != 0 then built else ld_wait_exit(os_run(binary, ld_args_from(3)))

fn ld_info(root) = if os_arg_count() != 2 then ctfail("usage: lume_driver --version|--help|describe|targets|build <source> -o <out>|run <source> [args]\n") else let command = os_arg_at(1) in if command == "--version" or command == "version" then ld_request(root, "lcli", "@cmd version\n") else if command == "--help" or command == "-h" or command == "help" then ld_request(root, "lcli", "@cmd help\n") else if command == "describe" or command == "--describe" then ld_request(root, "lcli", "@cmd describe\n") else if command == "targets" or command == "--targets" then ld_request(root, "ltarget", "@targets-json\n") else ctfail("unknown native driver command: " + command + "\n")

fn ld_entry(root) = if os_arg_count() >= 2 and os_arg_at(1) == "build" then (if os_arg_count() != 5 or os_arg_at(3) != "-o" then ctfail("usage: lume_driver build <source> -o <out>\n") else os_exit(ld_build(root, os_arg_at(2), os_arg_at(4)))) else if os_arg_count() >= 3 and os_arg_at(1) == "run" then os_exit(ld_run(root, os_arg_at(2))) else print ld_info(root)

ld_entry(ld_root())
