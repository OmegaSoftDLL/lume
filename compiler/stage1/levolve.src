## levolve.src -- Lume Self-Evolution & Governance Engine (Track E, brick E3; Principles P1, P24, P26, P30, P31).
## Closes Track E ("Lume evolves Lume on its own", #194 & #203):
##   1. An AI or human proposes a change via Compiler-as-a-Service (`use lcaas`, E1b).
##   2. If the candidate has fixable diagnostics (`A0001`/`T1001`/`T1003`/`T2002`), the P1/P30/P31 repair loop
##      (`write -> compile -> read fixit -> repair -> re-verify`) applies deterministic fix-its.
##   3. The 6 automated evolution gates (`compile`, `conformance` + `QF_LIA` proofs, `api_compat`, `capability`,
##      `budget` + WCET, `stage2 == stage3` `fixpoint`) run in-memory and must ALL pass.
##   4. Governance rule (`docs/04-roadmap.md`, #194): "The AI proposes; the gates verify; the human decides.
##      Nothing merges without a maintainer's cryptographic Ed25519 signature." Public keys live in
##      `evolve/maintainers.pub`; private keys live strictly off-repo. Unsigned `approved:<name>` or forged
##      signatures are rejected (`rejected_invalid_signature`, `can_merge == 0`).

use lcaas

## --- RFC 8032 Ed25519 & RFC 6234 SHA-512 Asymmetric Signature Verification (#194) ---
fn ed_hex_val(c) = if c >= "0" and c <= "9" then toint(c) else if c == "a" or c == "A" then 10 else if c == "b" or c == "B" then 11 else if c == "c" or c == "C" then 12 else if c == "d" or c == "D" then 13 else if c == "e" or c == "E" then 14 else if c == "f" or c == "F" then 15 else 0 - 1
fn ed_hex_byte(h, i) = ed_hex_val(at(h, 2 * i)) * 16 + ed_hex_val(at(h, 2 * i + 1))
fn ed_valid_hex(h, i, n) = if i >= n then 1 else if ed_hex_val(at(h, i)) < 0 then 0 else ed_valid_hex(h, i + 1, n)

fn fe_zero() = {l0: 0, l1: 0, l2: 0, l3: 0, l4: 0, l5: 0, l6: 0, l7: 0, l8: 0, l9: 0}
fn fe_one() = {l0: 1, l1: 0, l2: 0, l3: 0, l4: 0, l5: 0, l6: 0, l7: 0, l8: 0, l9: 0}
fn fe_d() = {l0: 56195235, l1: 13857412, l2: 51736253, l3: 6949390, l4: 114729, l5: 24766616, l6: 60832955, l7: 30306712, l8: 48412415, l9: 21499315}
fn fe_d2() = {l0: 45281625, l1: 27714825, l2: 36363642, l3: 13898781, l4: 229458, l5: 15978800, l6: 54557047, l7: 27058993, l8: 29715967, l9: 9444199}
fn fe_sqrtm1() = {l0: 34513072, l1: 25610706, l2: 9377949, l3: 3500415, l4: 12389472, l5: 33281959, l6: 41962654, l7: 31548777, l8: 326685, l9: 11406482}
fn ed_base_pt() = {ok: 1, x: {l0: 52811034, l1: 25909283, l2: 16144682, l3: 17082669, l4: 27570973, l5: 30858332, l6: 40966398, l7: 8378388, l8: 20764389, l9: 8758491}, y: {l0: 40265304, l1: 26843545, l2: 13421772, l3: 20132659, l4: 26843545, l5: 6710886, l6: 53687091, l7: 13421772, l8: 40265318, l9: 26843545}, z: fe_one(), t: {l0: 28827043, l1: 27438313, l2: 39759291, l3: 244362, l4: 8635006, l5: 11264893, l6: 19351346, l7: 13413597, l8: 16611511, l9: 27139452}}

fn fe_carry_hi(h, lo, c4) = let t5 = h.l5 + c4 in let c5 = t5 / 33554432 in let t6 = h.l6 + c5 in let c6 = t6 / 67108864 in let t7 = h.l7 + c6 in let c7 = t7 / 33554432 in let t8 = h.l8 + c7 in let c8 = t8 / 67108864 in let t9 = h.l9 + c8 in let c9 = t9 / 33554432 in let t0 = lo.l0 + 19 * c9 in {l0: t0 % 67108864, l1: lo.l1 + (t0 / 67108864), l2: lo.l2, l3: lo.l3, l4: lo.l4, l5: t5 - c5 * 33554432, l6: t6 - c6 * 67108864, l7: t7 - c7 * 33554432, l8: t8 - c8 * 67108864, l9: t9 - c9 * 33554432}
fn fe_carry(h) = let c0 = h.l0 / 67108864 in let t1 = h.l1 + c0 in let c1 = t1 / 33554432 in let t2 = h.l2 + c1 in let c2 = t2 / 67108864 in let t3 = h.l3 + c2 in let c3 = t3 / 33554432 in let t4 = h.l4 + c3 in fe_carry_hi(h, {l0: h.l0 - c0 * 67108864, l1: t1 - c1 * 33554432, l2: t2 - c2 * 67108864, l3: t3 - c3 * 33554432, l4: t4 % 67108864}, t4 / 67108864)
fn fe_add(a, b) = fe_carry({l0: a.l0 + b.l0, l1: a.l1 + b.l1, l2: a.l2 + b.l2, l3: a.l3 + b.l3, l4: a.l4 + b.l4, l5: a.l5 + b.l5, l6: a.l6 + b.l6, l7: a.l7 + b.l7, l8: a.l8 + b.l8, l9: a.l9 + b.l9})
fn fe_sub(a, b) = fe_carry({l0: a.l0 + 268435380 - b.l0, l1: a.l1 + 134217724 - b.l1, l2: a.l2 + 268435452 - b.l2, l3: a.l3 + 134217724 - b.l3, l4: a.l4 + 268435452 - b.l4, l5: a.l5 + 134217724 - b.l5, l6: a.l6 + 268435452 - b.l6, l7: a.l7 + 134217724 - b.l7, l8: a.l8 + 268435452 - b.l8, l9: a.l9 + 134217724 - b.l9})
fn fe_neg(a) = fe_carry(fe_sub(fe_zero(), a))
fn fe_mul(f, g) = fe_carry({l0: f.l0 * g.l0 + 38 * (f.l1 * g.l9 + f.l3 * g.l7 + f.l5 * g.l5 + f.l7 * g.l3 + f.l9 * g.l1) + 19 * (f.l2 * g.l8 + f.l4 * g.l6 + f.l6 * g.l4 + f.l8 * g.l2), l1: f.l0 * g.l1 + f.l1 * g.l0 + 19 * (f.l2 * g.l9 + f.l3 * g.l8 + f.l4 * g.l7 + f.l5 * g.l6 + f.l6 * g.l5 + f.l7 * g.l4 + f.l8 * g.l3 + f.l9 * g.l2), l2: f.l0 * g.l2 + 2 * f.l1 * g.l1 + f.l2 * g.l0 + 38 * (f.l3 * g.l9 + f.l5 * g.l7 + f.l7 * g.l5 + f.l9 * g.l3) + 19 * (f.l4 * g.l8 + f.l6 * g.l6 + f.l8 * g.l4), l3: f.l0 * g.l3 + f.l1 * g.l2 + f.l2 * g.l1 + f.l3 * g.l0 + 19 * (f.l4 * g.l9 + f.l5 * g.l8 + f.l6 * g.l7 + f.l7 * g.l6 + f.l8 * g.l5 + f.l9 * g.l4), l4: f.l0 * g.l4 + 2 * (f.l1 * g.l3 + f.l3 * g.l1) + f.l2 * g.l2 + f.l4 * g.l0 + 38 * (f.l5 * g.l9 + f.l7 * g.l7 + f.l9 * g.l5) + 19 * (f.l6 * g.l8 + f.l8 * g.l6), l5: f.l0 * g.l5 + f.l1 * g.l4 + f.l2 * g.l3 + f.l3 * g.l2 + f.l4 * g.l1 + f.l5 * g.l0 + 19 * (f.l6 * g.l9 + f.l7 * g.l8 + f.l8 * g.l7 + f.l9 * g.l6), l6: f.l0 * g.l6 + 2 * (f.l1 * g.l5 + f.l3 * g.l3 + f.l5 * g.l1) + f.l2 * g.l4 + f.l4 * g.l2 + f.l6 * g.l0 + 38 * (f.l7 * g.l9 + f.l9 * g.l7) + 19 * (f.l8 * g.l8), l7: f.l0 * g.l7 + f.l1 * g.l6 + f.l2 * g.l5 + f.l3 * g.l4 + f.l4 * g.l3 + f.l5 * g.l2 + f.l6 * g.l1 + f.l7 * g.l0 + 19 * (f.l8 * g.l9 + f.l9 * g.l8), l8: f.l0 * g.l8 + 2 * (f.l1 * g.l7 + f.l3 * g.l5 + f.l5 * g.l3 + f.l7 * g.l1) + f.l2 * g.l6 + f.l4 * g.l4 + f.l6 * g.l2 + f.l8 * g.l0 + 38 * (f.l9 * g.l9), l9: f.l0 * g.l9 + f.l1 * g.l8 + f.l2 * g.l7 + f.l3 * g.l6 + f.l4 * g.l5 + f.l5 * g.l4 + f.l6 * g.l3 + f.l7 * g.l2 + f.l8 * g.l1 + f.l9 * g.l0})
fn fe_sq(f) = fe_mul(f, f)
fn fe_sqn(x, n) = if n <= 0 then x else fe_sqn(fe_sq(x), n - 1)
fn fe_pow_p58(w) = let t2 = fe_mul(fe_sqn(w, 1), w) in let t4 = fe_mul(fe_sqn(t2, 2), t2) in let t5 = fe_mul(fe_sqn(t4, 1), w) in let t10 = fe_mul(fe_sqn(t5, 5), t5) in let t20 = fe_mul(fe_sqn(t10, 10), t10) in let t40 = fe_mul(fe_sqn(t20, 20), t20) in let t80 = fe_mul(fe_sqn(t40, 40), t40) in let t160 = fe_mul(fe_sqn(t80, 80), t80) in let t240 = fe_mul(fe_sqn(t160, 80), t80) in let t250 = fe_mul(fe_sqn(t240, 10), t10) in fe_mul(fe_sqn(t250, 2), w)

fn fe_canon_sub(f) = let c0 = (f.l0 + 19) / 67108864 in let c1 = (f.l1 + c0) / 33554432 in let c2 = (f.l2 + c1) / 67108864 in let c3 = (f.l3 + c2) / 33554432 in let c4 = (f.l4 + c3) / 67108864 in let c5 = (f.l5 + c4) / 33554432 in let c6 = (f.l6 + c5) / 67108864 in let c7 = (f.l7 + c6) / 33554432 in let c8 = (f.l8 + c7) / 67108864 in {l0: (f.l0 + 19) % 67108864, l1: (f.l1 + c0) % 33554432, l2: (f.l2 + c1) % 67108864, l3: (f.l3 + c2) % 33554432, l4: (f.l4 + c3) % 67108864, l5: (f.l5 + c4) % 33554432, l6: (f.l6 + c5) % 67108864, l7: (f.l7 + c6) % 33554432, l8: (f.l8 + c7) % 67108864, l9: (f.l9 + c8) % 33554432}
fn fe_canon(f0) = let f = fe_carry(f0) in let q0 = (f.l0 + 19) / 67108864 in let q1 = (f.l1 + q0) / 33554432 in let q2 = (f.l2 + q1) / 67108864 in let q3 = (f.l3 + q2) / 33554432 in let q4 = (f.l4 + q3) / 67108864 in let q5 = (f.l5 + q4) / 33554432 in let q6 = (f.l6 + q5) / 67108864 in let q7 = (f.l7 + q6) / 33554432 in let q8 = (f.l8 + q7) / 67108864 in if (f.l9 + q8) / 33554432 == 0 then f else fe_canon_sub(f)
fn fe_eq(a, b) = let ca = fe_canon(a) in let cb = fe_canon(b) in if ca.l0 == cb.l0 and ca.l1 == cb.l1 and ca.l2 == cb.l2 and ca.l3 == cb.l3 and ca.l4 == cb.l4 and ca.l5 == cb.l5 and ca.l6 == cb.l6 and ca.l7 == cb.l7 and ca.l8 == cb.l8 and ca.l9 == cb.l9 then 1 else 0
fn fe_is_zero(a) = fe_eq(a, fe_zero())
fn fe_parity(a) = (fe_canon(a)).l0 % 2

fn ed_bits(h, b, sh, mask) = let w4 = ed_hex_byte(h, b) + 256 * ed_hex_byte(h, b + 1) + 65536 * ed_hex_byte(h, b + 2) + 16777216 * (if b + 3 < 32 then (if b + 3 == 31 then ed_hex_byte(h, 31) % 128 else ed_hex_byte(h, b + 3)) else 0) in (w4 / sha_pow2(sh)) % mask
fn ed_decode_y(h) = {l0: ed_bits(h, 0, 0, 67108864), l1: ed_bits(h, 3, 2, 33554432), l2: ed_bits(h, 6, 3, 67108864), l3: ed_bits(h, 9, 5, 33554432), l4: ed_bits(h, 12, 6, 67108864), l5: ed_bits(h, 16, 0, 33554432), l6: ed_bits(h, 19, 1, 67108864), l7: ed_bits(h, 22, 3, 33554432), l8: ed_bits(h, 25, 4, 67108864), l9: ed_bits(h, 28, 6, 33554432)}
fn ed_decompress(h) = let x0 = ed_hex_byte(h, 31) / 128 in let y = ed_decode_y(h) in if fe_eq(y, y) == 0 then {ok: 0, x: fe_zero(), y: fe_zero(), z: fe_one(), t: fe_zero()} else let y2 = fe_sq(y) in let u = fe_sub(y2, fe_one()) in let v = fe_add(fe_mul(fe_d(), y2), fe_one()) in let v3 = fe_mul(fe_sq(v), v) in let x_raw = fe_mul(fe_mul(u, v3), fe_pow_p58(fe_mul(u, fe_mul(fe_sq(v3), v)))) in let vx2 = fe_mul(v, fe_sq(x_raw)) in let ok_root = if fe_eq(vx2, u) == 1 then 1 else if fe_eq(vx2, fe_neg(u)) == 1 then 2 else 0 in if ok_root == 0 then {ok: 0, x: fe_zero(), y: fe_zero(), z: fe_one(), t: fe_zero()} else let x1 = if ok_root == 1 then x_raw else fe_mul(x_raw, fe_sqrtm1()) in if fe_is_zero(x1) == 1 and x0 == 1 then {ok: 0, x: fe_zero(), y: fe_zero(), z: fe_one(), t: fe_zero()} else let x = if fe_parity(x1) == x0 then x1 else fe_neg(x1) in {ok: 1, x: x, y: y, z: fe_one(), t: fe_mul(x, y)}

fn ed_add2(e, f, g, h) = {ok: 1, x: fe_mul(e, f), y: fe_mul(g, h), z: fe_mul(f, g), t: fe_mul(e, h)}
fn ed_add(p, q) = let a = fe_mul(fe_sub(p.y, p.x), fe_sub(q.y, q.x)) in let b = fe_mul(fe_add(p.y, p.x), fe_add(q.y, q.x)) in let c = fe_mul(fe_mul(p.t, fe_d2()), q.t) in let z1z2 = fe_mul(p.z, q.z) in let d = fe_add(z1z2, z1z2) in ed_add2(fe_sub(b, a), fe_sub(d, c), fe_add(d, c), fe_add(b, a))
fn ed_id_pt() = {ok: 1, x: fe_zero(), y: fe_one(), z: fe_one(), t: fe_zero()}
fn ed_neg_pt(p) = {ok: p.ok, x: fe_neg(p.x), y: p.y, z: p.z, t: fe_neg(p.t)}
fn ed_dbl(p) = let a = fe_sq(p.x) in let b = fe_sq(p.y) in let z2 = fe_sq(p.z) in let h = fe_add(a, b) in let g = fe_sub(a, b) in ed_add2(fe_sub(h, fe_sq(fe_add(p.x, p.y))), fe_add(fe_add(z2, z2), g), g, h)

fn s5_add64(a, b) = let lo = a.lo + b.lo in {hi: (a.hi + b.hi + (lo / 4294967296)) % 4294967296, lo: lo % 4294967296}
fn s5_add64_4(a, b, c, d) = s5_add64(s5_add64(a, b), s5_add64(c, d))
fn s5_add64_5(a, b, c, d, e) = s5_add64(s5_add64_4(a, b, c, d), e)
fn s5_rotr64_lt32(x, n) = let p = sha_pow2(n) in let q = sha_pow2(32 - n) in {hi: (x.hi / p) + ((x.lo % p) * q), lo: (x.lo / p) + ((x.hi % p) * q)}
fn s5_rotr64(x, n) = if n < 32 then s5_rotr64_lt32(x, n) else if n == 32 then {hi: x.lo, lo: x.hi} else s5_rotr64_lt32({hi: x.lo, lo: x.hi}, n - 32)
fn s5_shr64(x, n) = let p = sha_pow2(n) in let q = sha_pow2(32 - n) in {hi: x.hi / p, lo: (x.lo / p) + ((x.hi % p) * q)}

fn s5_xor3_4(x, y, z) = ((x + y + z) % 2) + 2 * (((x / 2) + (y / 2) + (z / 2)) % 2) + 4 * (((x / 4) + (y / 4) + (z / 4)) % 2) + 8 * (((x / 8) + (y / 8) + (z / 8)) % 2)
fn s5_xor3_16(x, y, z) = s5_xor3_4(x % 16, y % 16, z % 16) + 16 * s5_xor3_4((x / 16) % 16, (y / 16) % 16, (z / 16) % 16) + 256 * s5_xor3_4((x / 256) % 16, (y / 256) % 16, (z / 256) % 16) + 4096 * s5_xor3_4((x / 4096) % 16, (y / 4096) % 16, (z / 4096) % 16)
fn s5_xor3_32(x, y, z) = s5_xor3_16(x % 65536, y % 65536, z % 65536) + 65536 * s5_xor3_16(x / 65536, y / 65536, z / 65536)
fn s5_xor3_64(x, y, z) = {hi: s5_xor3_32(x.hi, y.hi, z.hi), lo: s5_xor3_32(x.lo, y.lo, z.lo)}

fn s5_ch_4(e, f, g) = (if (e % 2) == 1 then (f % 2) else (g % 2)) + 2 * (if ((e / 2) % 2) == 1 then ((f / 2) % 2) else ((g / 2) % 2)) + 4 * (if ((e / 4) % 2) == 1 then ((f / 4) % 2) else ((g / 4) % 2)) + 8 * (if ((e / 8) % 2) == 1 then ((f / 8) % 2) else ((g / 8) % 2))
fn s5_ch_16(e, f, g) = s5_ch_4(e % 16, f % 16, g % 16) + 16 * s5_ch_4((e / 16) % 16, (f / 16) % 16, (g / 16) % 16) + 256 * s5_ch_4((e / 256) % 16, (f / 256) % 16, (g / 256) % 16) + 4096 * s5_ch_4((e / 4096) % 16, (f / 4096) % 16, (g / 4096) % 16)
fn s5_ch_32(e, f, g) = s5_ch_16(e % 65536, f % 65536, g % 65536) + 65536 * s5_ch_16(e / 65536, f / 65536, g / 65536)
fn s5_ch64(e, f, g) = {hi: s5_ch_32(e.hi, f.hi, g.hi), lo: s5_ch_32(e.lo, f.lo, g.lo)}

fn s5_maj_4(a, b, c) = (if (a % 2) + (b % 2) + (c % 2) >= 2 then 1 else 0) + 2 * (if ((a / 2) % 2) + ((b / 2) % 2) + ((c / 2) % 2) >= 2 then 1 else 0) + 4 * (if ((a / 4) % 2) + ((b / 4) % 2) + ((c / 4) % 2) >= 2 then 1 else 0) + 8 * (if ((a / 8) % 2) + ((b / 8) % 2) + ((c / 8) % 2) >= 2 then 1 else 0)
fn s5_maj_16(a, b, c) = s5_maj_4(a % 16, b % 16, c % 16) + 16 * s5_maj_4((a / 16) % 16, (b / 16) % 16, (c / 16) % 16) + 256 * s5_maj_4((a / 256) % 16, (b / 256) % 16, (c / 256) % 16) + 4096 * s5_maj_4((a / 4096) % 16, (b / 4096) % 16, (c / 4096) % 16)
fn s5_maj_32(a, b, c) = s5_maj_16(a % 65536, b % 65536, c % 65536) + 65536 * s5_maj_16(a / 65536, b / 65536, c / 65536)
fn s5_maj64(a, b, c) = {hi: s5_maj_32(a.hi, b.hi, c.hi), lo: s5_maj_32(a.lo, b.lo, c.lo)}

fn s5_big_sig0(a) = s5_xor3_64(s5_rotr64(a, 28), s5_rotr64(a, 34), s5_rotr64(a, 39))
fn s5_big_sig1(e) = s5_xor3_64(s5_rotr64(e, 14), s5_rotr64(e, 18), s5_rotr64(e, 41))
fn s5_sml_sig0(x) = s5_xor3_64(s5_rotr64(x, 1), s5_rotr64(x, 8), s5_shr64(x, 7))
fn s5_sml_sig1(x) = s5_xor3_64(s5_rotr64(x, 19), s5_rotr64(x, 61), s5_shr64(x, 6))
fn s5_k0(t) = if t <= 9 then (if t <= 4 then (if t <= 2 then (if t <= 1 then (if t <= 0 then ({hi: 1116352408, lo: 3609767458}) else ({hi: 1899447441, lo: 602891725})) else ({hi: 3049323471, lo: 3964484399})) else (if t <= 3 then ({hi: 3921009573, lo: 2173295548}) else ({hi: 961987163, lo: 4081628472}))) else (if t <= 7 then (if t <= 6 then (if t <= 5 then ({hi: 1508970993, lo: 3053834265}) else ({hi: 2453635748, lo: 2937671579})) else ({hi: 2870763221, lo: 3664609560})) else (if t <= 8 then ({hi: 3624381080, lo: 2734883394}) else ({hi: 310598401, lo: 1164996542})))) else (if t <= 14 then (if t <= 12 then (if t <= 11 then (if t <= 10 then ({hi: 607225278, lo: 1323610764}) else ({hi: 1426881987, lo: 3590304994})) else ({hi: 1925078388, lo: 4068182383})) else (if t <= 13 then ({hi: 2162078206, lo: 991336113}) else ({hi: 2614888103, lo: 633803317}))) else (if t <= 17 then (if t <= 16 then (if t <= 15 then ({hi: 3248222580, lo: 3479774868}) else ({hi: 3835390401, lo: 2666613458})) else ({hi: 4022224774, lo: 944711139})) else (if t <= 18 then ({hi: 264347078, lo: 2341262773}) else ({hi: 604807628, lo: 2007800933}))))
fn s5_k1(t) = if t <= 29 then (if t <= 24 then (if t <= 22 then (if t <= 21 then (if t <= 20 then ({hi: 770255983, lo: 1495990901}) else ({hi: 1249150122, lo: 1856431235})) else ({hi: 1555081692, lo: 3175218132})) else (if t <= 23 then ({hi: 1996064986, lo: 2198950837}) else ({hi: 2554220882, lo: 3999719339}))) else (if t <= 27 then (if t <= 26 then (if t <= 25 then ({hi: 2821834349, lo: 766784016}) else ({hi: 2952996808, lo: 2566594879})) else ({hi: 3210313671, lo: 3203337956})) else (if t <= 28 then ({hi: 3336571891, lo: 1034457026}) else ({hi: 3584528711, lo: 2466948901})))) else (if t <= 34 then (if t <= 32 then (if t <= 31 then (if t <= 30 then ({hi: 113926993, lo: 3758326383}) else ({hi: 338241895, lo: 168717936})) else ({hi: 666307205, lo: 1188179964})) else (if t <= 33 then ({hi: 773529912, lo: 1546045734}) else ({hi: 1294757372, lo: 1522805485}))) else (if t <= 37 then (if t <= 36 then (if t <= 35 then ({hi: 1396182291, lo: 2643833823}) else ({hi: 1695183700, lo: 2343527390})) else ({hi: 1986661051, lo: 1014477480})) else (if t <= 38 then ({hi: 2177026350, lo: 1206759142}) else ({hi: 2456956037, lo: 344077627}))))
