fn s5_msg_byte(mctx, idx) = if idx < 32 then ed_hex_byte(mctx.r_hex, idx) else if idx < 64 then ed_hex_byte(mctx.pub_hex, idx - 32) else if idx < mctx.len then sha_ord(at(mctx.msg, idx - 64)) else if idx == mctx.len then 128 else if idx >= mctx.total - 8 then ((mctx.len * 8) / sha_pow2(8 * (mctx.total - 1 - idx))) % 256 else 0
fn s5_msg_u32(mctx, b) = s5_msg_byte(mctx, b) * 16777216 + s5_msg_byte(mctx, b + 1) * 65536 + s5_msg_byte(mctx, b + 2) * 256 + s5_msg_byte(mctx, b + 3)
fn s5_msg_u64(mctx, b) = {hi: s5_msg_u32(mctx, b), lo: s5_msg_u32(mctx, b + 4)}
fn s5_init_w(mctx, bo) = {w0: s5_msg_u64(mctx, bo), w1: s5_msg_u64(mctx, bo + 8), w2: s5_msg_u64(mctx, bo + 16), w3: s5_msg_u64(mctx, bo + 24), w4: s5_msg_u64(mctx, bo + 32), w5: s5_msg_u64(mctx, bo + 40), w6: s5_msg_u64(mctx, bo + 48), w7: s5_msg_u64(mctx, bo + 56), w8: s5_msg_u64(mctx, bo + 64), w9: s5_msg_u64(mctx, bo + 72), w10: s5_msg_u64(mctx, bo + 80), w11: s5_msg_u64(mctx, bo + 88), w12: s5_msg_u64(mctx, bo + 96), w13: s5_msg_u64(mctx, bo + 104), w14: s5_msg_u64(mctx, bo + 112), w15: s5_msg_u64(mctx, bo + 120)}
fn s5_step_w(w) = {w0: w.w1, w1: w.w2, w2: w.w3, w3: w.w4, w4: w.w5, w5: w.w6, w6: w.w7, w7: w.w8, w8: w.w9, w9: w.w10, w10: w.w11, w11: w.w12, w12: w.w13, w13: w.w14, w14: w.w15, w15: s5_add64_4(w.w0, s5_sml_sig0(w.w1), w.w9, s5_sml_sig1(w.w14))}
fn s5_round(st, wt, kt) = let t1 = s5_add64_5(st.h, s5_big_sig1(st.e), s5_ch64(st.e, st.f, st.g), kt, wt) in let t2 = s5_add64(s5_big_sig0(st.a), s5_maj64(st.a, st.b, st.c)) in {a: s5_add64(t1, t2), b: st.a, c: st.b, d: st.c, e: s5_add64(st.d, t1), f: st.e, g: st.f, h: st.g}
fn s5_rounds(st, w, t) = if t >= 80 then st else s5_rounds(s5_round(st, w.w0, s5_k(t)), s5_step_w(w), t + 1)
fn s5_blocks(mctx, bo, st) = if bo >= mctx.total then st else let r = s5_rounds(st, s5_init_w(mctx, bo), 0) in s5_blocks(mctx, bo + 128, {a: s5_add64(st.a, r.a), b: s5_add64(st.b, r.b), c: s5_add64(st.c, r.c), d: s5_add64(st.d, r.d), e: s5_add64(st.e, r.e), f: s5_add64(st.f, r.f), g: s5_add64(st.g, r.g), h: s5_add64(st.h, r.h)})
fn s5_hash_ram(r_hex, pub_hex, msg) = let len = 64 + count(msg) in let total = ((len + 17 + 127) / 128) * 128 in let mctx = {r_hex: r_hex, pub_hex: pub_hex, msg: msg, len: len, total: total} in let init = {a: {hi: 1779033703, lo: 4089235720}, b: {hi: 3144134277, lo: 2227873595}, c: {hi: 1013904242, lo: 4271175723}, d: {hi: 2773480762, lo: 1595750129}, e: {hi: 1359893119, lo: 2917565137}, f: {hi: 2600822924, lo: 725511199}, g: {hi: 528734635, lo: 4215389547}, h: {hi: 1541459225, lo: 327033209}} in s5_blocks(mctx, 0, init)

fn s5_digest_word(st, idx) = if idx == 0 then st.a.hi else if idx == 1 then st.a.lo else if idx == 2 then st.b.hi else if idx == 3 then st.b.lo else if idx == 4 then st.c.hi else if idx == 5 then st.c.lo else if idx == 6 then st.d.hi else if idx == 7 then st.d.lo else if idx == 8 then st.e.hi else if idx == 9 then st.e.lo else if idx == 10 then st.f.hi else if idx == 11 then st.f.lo else if idx == 12 then st.g.hi else if idx == 13 then st.g.lo else if idx == 14 then st.h.hi else st.h.lo
fn s5_digest_byte(st, i) = let w = s5_digest_word(st, i / 4) in (w / sha_pow2(8 * (3 - (i % 4)))) % 256

fn ed_fdiv24(x) = (x + 4503599627370496) / 16777216 - 268435456
fn ed_carry_l_hi(a, lo, c4) = let t5 = a.s5 - lo.q * 20 + c4 in let c5 = ed_fdiv24(t5) in let t6 = a.s6 + c5 in let c6 = ed_fdiv24(t6) in let t7 = a.s7 + c6 in let c7 = ed_fdiv24(t7) in let t8 = a.s8 + c7 in let c8 = ed_fdiv24(t8) in let t9 = a.s9 + c8 in let c9 = ed_fdiv24(t9) in {s0: lo.r0, s1: lo.r1, s2: lo.r2, s3: lo.r3, s4: lo.r4, s5: t5 - c5 * 16777216, s6: t6 - c6 * 16777216, s7: t7 - c7 * 16777216, s8: t8 - c8 * 16777216, s9: t9 - c9 * 16777216, s10: (a.s10 - lo.q * 4096) + c9}
fn ed_carry_l_once(a) = let q = (a.s10 + 4294967296) / 4096 - 1048576 in let s0 = a.s0 - q * 16110573 in let c0 = ed_fdiv24(s0) in let t1 = a.s1 - q * 6494812 + c0 in let c1 = ed_fdiv24(t1) in let t2 = a.s2 - q * 14047250 + c1 in let c2 = ed_fdiv24(t2) in let t3 = a.s3 - q * 10680220 + c2 in let c3 = ed_fdiv24(t3) in let t4 = a.s4 - q * 14612958 + c3 in let c4 = ed_fdiv24(t4) in ed_carry_l_hi(a, {q: q, r0: s0 - c0 * 16777216, r1: t1 - c1 * 16777216, r2: t2 - c2 * 16777216, r3: t3 - c3 * 16777216, r4: t4 - c4 * 16777216}, c4)
fn ed_carry_l(a) = ed_carry_l_once(ed_carry_l_once(a))
fn ed_ge_l(a) = if a.s10 != 4096 then (if a.s10 > 4096 then 1 else 0) else if a.s9 > 0 or a.s8 > 0 or a.s7 > 0 or a.s6 > 0 then 1 else if a.s5 != 20 then (if a.s5 > 20 then 1 else 0) else if a.s4 != 14612958 then (if a.s4 > 14612958 then 1 else 0) else if a.s3 != 10680220 then (if a.s3 > 10680220 then 1 else 0) else if a.s2 != 14047250 then (if a.s2 > 14047250 then 1 else 0) else if a.s1 != 6494812 then (if a.s1 > 6494812 then 1 else 0) else if a.s0 >= 16110573 then 1 else 0
fn ed_sub_l(a) = if ed_ge_l(a) == 0 then a else ed_carry_l({s0: a.s0 - 16110573, s1: a.s1 - 6494812, s2: a.s2 - 14047250, s3: a.s3 - 10680220, s4: a.s4 - 14612958, s5: a.s5 - 20, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10 - 4096})
fn s5_digest_u24(st, k) = if k == 21 then s5_digest_byte(st, 63) else s5_digest_byte(st, 3 * k) + 256 * s5_digest_byte(st, 3 * k + 1) + 65536 * s5_digest_byte(st, 3 * k + 2)
fn ed_mod_l_limb_loop(st, k, a) = if k < 0 then ed_sub_l(ed_carry_l(a)) else let w24 = s5_digest_u24(st, k) in let q = a.s10 * 4096 in let next = ed_carry_l({s0: w24 - q * 16110573, s1: a.s0 - q * 6494812, s2: a.s1 - q * 14047250, s3: a.s2 - q * 10680220, s4: a.s3 - q * 14612958, s5: a.s4 - q * 20, s6: a.s5, s7: a.s6, s8: a.s7, s9: a.s8, s10: a.s9}) in ed_mod_l_limb_loop(st, k - 1, next)
fn ed_hash_mod_l(r_hex, pub_hex, msg) = let st = s5_hash_ram(r_hex, pub_hex, msg) in ed_mod_l_limb_loop(st, 21, {s0: 0, s1: 0, s2: 0, s3: 0, s4: 0, s5: 0, s6: 0, s7: 0, s8: 0, s9: 0, s10: 0})

fn ed_s_from_hex(sh) = {s0: ed_hex_byte(sh, 0) + 256 * ed_hex_byte(sh, 1) + 65536 * ed_hex_byte(sh, 2), s1: ed_hex_byte(sh, 3) + 256 * ed_hex_byte(sh, 4) + 65536 * ed_hex_byte(sh, 5), s2: ed_hex_byte(sh, 6) + 256 * ed_hex_byte(sh, 7) + 65536 * ed_hex_byte(sh, 8), s3: ed_hex_byte(sh, 9) + 256 * ed_hex_byte(sh, 10) + 65536 * ed_hex_byte(sh, 11), s4: ed_hex_byte(sh, 12) + 256 * ed_hex_byte(sh, 13) + 65536 * ed_hex_byte(sh, 14), s5: ed_hex_byte(sh, 15) + 256 * ed_hex_byte(sh, 16) + 65536 * ed_hex_byte(sh, 17), s6: ed_hex_byte(sh, 18) + 256 * ed_hex_byte(sh, 19) + 65536 * ed_hex_byte(sh, 20), s7: ed_hex_byte(sh, 21) + 256 * ed_hex_byte(sh, 22) + 65536 * ed_hex_byte(sh, 23), s8: ed_hex_byte(sh, 24) + 256 * ed_hex_byte(sh, 25) + 65536 * ed_hex_byte(sh, 26), s9: ed_hex_byte(sh, 27) + 256 * ed_hex_byte(sh, 28) + 65536 * ed_hex_byte(sh, 29), s10: ed_hex_byte(sh, 30) + 256 * ed_hex_byte(sh, 31)}
fn ed_s_limb(a, idx) = if idx <= 4 then (if idx == 0 then a.s0 else if idx == 1 then a.s1 else if idx == 2 then a.s2 else if idx == 3 then a.s3 else a.s4) else (if idx == 5 then a.s5 else if idx == 6 then a.s6 else if idx == 7 then a.s7 else if idx == 8 then a.s8 else if idx == 9 then a.s9 else a.s10)
fn ed_s_bit(a, b) = (ed_s_limb(a, b / 24) / sha_pow2(b % 24)) % 2
fn ed_s_4bit(a, b) = ed_s_bit(a, b) + 2 * ed_s_bit(a, b + 1) + 4 * ed_s_bit(a, b + 2) + 8 * ed_s_bit(a, b + 3)

fn ed_mk_tab4(p1) = let p2 = ed_dbl(p1) in let p3 = ed_add(p2, p1) in let p4 = ed_dbl(p2) in let p5 = ed_add(p4, p1) in let p6 = ed_add(p4, p2) in let p7 = ed_add(p4, p3) in let p8 = ed_dbl(p4) in {p1: p1, p2: p2, p3: p3, p4: p4, p5: p5, p6: p6, p7: p7, p8: p8, p9: ed_add(p8, p1), p10: ed_add(p8, p2), p11: ed_add(p8, p3), p12: ed_add(p8, p4), p13: ed_add(p8, p5), p14: ed_add(p8, p6), p15: ed_add(p8, p7)}
fn ed_sel_tab4(tb, k) = if k <= 8 then (if k <= 4 then (if k <= 2 then (if k == 1 then tb.p1 else tb.p2) else (if k == 3 then tb.p3 else tb.p4)) else (if k <= 6 then (if k == 5 then tb.p5 else tb.p6) else (if k == 7 then tb.p7 else tb.p8))) else (if k <= 12 then (if k <= 10 then (if k == 9 then tb.p9 else tb.p10) else (if k == 11 then tb.p11 else tb.p12)) else (if k <= 14 then (if k == 13 then tb.p13 else tb.p14) else tb.p15))
fn ed_shamir_4bit(i, acc, sctx) = if i < 0 then acc else let d0 = ed_dbl(ed_dbl(ed_dbl(ed_dbl(acc)))) in let sb = ed_s_4bit(sctx.s_sc, i) in let kb = ed_s_4bit(sctx.k_sc, i) in let d1 = if sb == 0 then d0 else ed_add(d0, ed_sel_tab4(sctx.bt, sb)) in let d2 = if kb == 0 then d1 else ed_add(d1, ed_sel_tab4(sctx.at, kb)) in ed_shamir_4bit(i - 4, d2, sctx)
fn ed_pt_eq(p, q) = if fe_eq(fe_mul(p.x, q.z), fe_mul(q.x, p.z)) == 1 and fe_eq(fe_mul(p.y, q.z), fe_mul(q.y, p.z)) == 1 then 1 else 0

fn ed25519_verify(pub_hex, msg, sig_hex) = if count(pub_hex) != 64 or count(sig_hex) != 128 then 0 else if ed_valid_hex(pub_hex, 0, 64) == 0 or ed_valid_hex(sig_hex, 0, 128) == 0 then 0 else let r_hex = slice(sig_hex, 0, 64) in let s_hex = slice(sig_hex, 64, 128) in let s_sc = ed_s_from_hex(s_hex) in if ed_ge_l(s_sc) == 1 then 0 else let a_pt = ed_decompress(pub_hex) in if a_pt.ok == 0 then 0 else let k_sc = ed_hash_mod_l(r_hex, pub_hex, msg) in let sctx = {s_sc: s_sc, k_sc: k_sc, bt: ed_mk_tab4(ed_base_pt()), at: ed_mk_tab4(ed_neg_pt(a_pt))} in let lhs = ed_shamir_4bit(252, ed_id_pt(), sctx) in let y_r = ed_decode_y(r_hex) in if fe_eq(lhs.y, fe_mul(y_r, lhs.z)) == 0 then 0 else let r_pt = ed_decompress(r_hex) in if r_pt.ok == 0 then 0 else ed_pt_eq(lhs, r_pt)

## --- internal string & token helpers (`ev_` prefix) ---
fn ev_findq(s, i, n) = if i >= n then n else if at(s, i) == "'" then i else ev_findq(s, i + 1, n)
fn ev_qstr_i(s, i, n, k) = let q1 = ev_findq(s, i, n) in if q1 >= n then "" else let q2 = ev_findq(s, q1 + 1, n) in if q2 >= n then "" else if k <= 1 then slice(s, q1 + 1, q2) else ev_qstr_i(s, q2 + 1, n, k - 1)
fn ev_qstr(s, k) = ev_qstr_i(s, 0, count(s), k)

fn ev_count_nl(s, i, n) = if i >= n then 0 else (if at(s, i) == "\n" then 1 else 0) + ev_count_nl(s, i + 1, n)
fn ev_count_lines(s) = if count(s) == 0 then 0 else ev_count_nl(s, 0, count(s))

fn ev_ltrim(s, i, n) = if i >= n then "" else if at(s, i) == " " or at(s, i) == "\t" then ev_ltrim(s, i + 1, n) else slice(s, i, n)
fn ev_trim(s) = cs_chomp(ev_ltrim(s, 0, count(s)))

## --- token-aware source repair for `T1001` (constructor) and `T2002` (record field) fix-its ---
fn ev_str_end(s, i, n) = if i >= n then n else if at(s, i) == "\\" then ev_str_end(s, i + 2, n) else if at(s, i) == "\"" then i + 1 else ev_str_end(s, i + 1, n)
fn ev_nonid_end(s, i, n) = if i >= n then n else let c = at(s, i) in if c == "#" or c == "\"" or cs_isalpha(c) then i else ev_nonid_end(s, i + 1, n)

fn ev_rep_id_i(s, i, n, old_id, new_id, mode) = if i >= n then "" else let c = at(s, i) in if c == "#" then let le = cs_lineend(s, i + 1, n) in slice(s, i, le) + ev_rep_id_i(s, le, n, old_id, new_id, mode) else if c == "\"" then let se = ev_str_end(s, i + 1, n) in slice(s, i, se) + ev_rep_id_i(s, se, n, old_id, new_id, mode) else if cs_isalpha(c) then let j = cs_idend(s, i, n) in let tok = slice(s, i, j) in let prev_dot = if i > 0 then at(s, i - 1) == "." else 0 in let next_col = if j < n then at(s, j) == ":" else 0 in let hit = if tok == old_id then (if mode == 1 then (if prev_dot == 1 or next_col == 1 then 1 else 0) else 1) else 0 in (if hit == 1 then new_id else tok) + ev_rep_id_i(s, j, n, old_id, new_id, mode) else let j = ev_nonid_end(s, i + 1, n) in slice(s, i, j) + ev_rep_id_i(s, j, n, old_id, new_id, mode)

fn ev_rep_hole_i(s, i, n, hnm, rep) = if i >= n then "" else let c = at(s, i) in if c == "#" then let le = cs_lineend(s, i + 1, n) in slice(s, i, le) + ev_rep_hole_i(s, le, n, hnm, rep) else if c == "\"" then let se = ev_str_end(s, i + 1, n) in slice(s, i, se) + ev_rep_hole_i(s, se, n, hnm, rep) else if cs_isalpha(c) then let j = cs_idend(s, i, n) in let tok = slice(s, i, j) in if tok == hnm then rep + slice(s, j, n) else tok + ev_rep_hole_i(s, j, n, hnm, rep) else at(s, i) + ev_rep_hole_i(s, i + 1, n, hnm, rep)

fn ev_apply_one_diag(src, d) = if count(d.fixit) == 0 then {src: src, applied: 0} else if d.code == "A0001" then let hnm = ev_qstr(d.fixit, 1) in let rep = ev_qstr(d.fixit, 2) in if count(hnm) > 0 and count(rep) > 0 then {src: ev_rep_hole_i(src, 0, count(src), hnm, rep), applied: 1} else {src: src, applied: 0} else if d.code == "T1001" then let old_c = ev_qstr(d.fixit, 1) in let new_c = ev_qstr(d.fixit, 2) in if count(old_c) > 0 and count(new_c) > 0 then {src: ev_rep_id_i(src, 0, count(src), old_c, new_c, 0), applied: 1} else {src: src, applied: 0} else if d.code == "T1003" or d.code == "T2002" then let old_f = ev_qstr(d.fixit, 1) in let new_f = ev_qstr(d.fixit, 3) in if count(old_f) > 0 and count(new_f) > 0 then {src: ev_rep_id_i(src, 0, count(src), old_f, new_f, 1), applied: 1} else {src: src, applied: 0} else {src: src, applied: 0}

fn ev_apply_diags(src, ds) = match ds
    Nil        => {src: src, count: 0}
    Cons(h, t) => let r1 = ev_apply_one_diag(src, h) in let r2 = ev_apply_diags(r1.src, t) in {src: r2.src, count: r1.applied + r2.count}

## E1 + E3 self-repair loop: compile -> inspect structured fix-its -> repair -> re-compile
fn evolve_repair_and_compile(src, tests) = let full0 = if count(tests) > 0 then src + "\n" + tests else src in let r0 = caas_compile(full0) in if r0.ok == 1 then {src: src, repairs: 0, comp: r0} else let step1 = ev_apply_diags(src, r0.diagnostics) in if step1.count == 0 then {src: src, repairs: 0, comp: r0} else let full1 = if count(tests) > 0 then step1.src + "\n" + tests else step1.src in let r1 = caas_compile(full1) in {src: step1.src, repairs: step1.count, comp: r1}

fn evolve_repair(src) = let r = evolve_repair_and_compile(src, "") in {src: r.src, repairs: r.repairs}

## --- Gate 3 (`api_compat`): public symbol & signature preservation ---
fn ev_sig_params2(pn, pr, pts) = match pts
    Nil          => pn
    Cons(pt, tr) => let s = pn + ": " + cs_tystr(pt) in if cs_isnil(pr) == 1 then s else s + ", " + ev_sig_params(pr, tr)
fn ev_sig_params(pns, pts) = match pns
    Nil          => ""
    Cons(pn, pr) => ev_sig_params2(pn, pr, pts)

fn ev_find_sym(nm, syms) = match syms
    Nil        => {found: 0, name: nm, kind: "", sig: ""}
    Cons(h, t) => if h.name == nm then {found: 1, name: h.name, kind: h.kind, sig: h.sig} else ev_find_sym(nm, t)

fn ev_has_str(nm, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == nm then 1 else ev_has_str(nm, t)

fn ev_typed_sym1(s0, t, seen) = match s0
    TypeS(nm, k, items) => Cons({name: nm, kind: k, sig: if k == "enum" then cs_variants_str(items) else "{" + cs_fields_str(items) + "}"}, ev_typed_syms_i(t, Cons(nm, seen)))
    Sig(nm, ps, ts, rt) => Cons({name: nm, kind: "fn", sig: "fn(" + ev_sig_params(ps, ts) + ") -> " + cs_tystr(rt)}, ev_typed_syms_i(t, Cons(nm, seen)))
    Fn(nm, ps, body)    => if ev_has_str(nm, seen) == 1 then ev_typed_syms_i(t, seen) else Cons({name: nm, kind: "fn", sig: "fn(" + cs_params_str(ps) + ")"}, ev_typed_syms_i(t, seen))
    _                   => ev_typed_syms_i(t, seen)
fn ev_typed_syms_i(prog, seen) = match prog
    Nil        => Nil
    Cons(h, t) => ev_typed_sym1(h, t, seen)
fn ev_typed_syms(prog) = ev_typed_syms_i(prog, Nil)

fn ev_check_syms(base_syms, cand_syms) = match base_syms
    Nil        => {ok: 1, broken: ""}
    Cons(h, t) => let c = ev_find_sym(h.name, cand_syms) in if c.found == 0 then {ok: 0, broken: "missing baseline symbol '" + h.name + "'"} else if c.kind != h.kind or c.sig != h.sig then {ok: 0, broken: "signature drift on '" + h.name + "': baseline '" + h.sig + "' vs candidate '" + c.sig + "'"} else ev_check_syms(t, cand_syms)

## --- Gate 4 (`capability`): P26 capability audit on candidate source ---
fn ev_is_io_tok(tok) = tok == "read" or tok == "readall" or tok == "emit" or tok == "flush"

fn ev_scan_io(s, i, n) = if i >= n then "" else let c = at(s, i) in if c == "#" then ev_scan_io(s, cs_lineend(s, i + 1, n), n) else if c == "\"" then ev_scan_io(s, ev_str_end(s, i + 1, n), n) else if cs_isalpha(c) then let j = cs_idend(s, i, n) in let tok = slice(s, i, j) in if ev_is_io_tok(tok) and j < n and at(s, j) == "(" then tok else ev_scan_io(s, j, n) else ev_scan_io(s, i + 1, n)

## --- First diagnostic summary helper ---
fn ev_first_diag(ds) = match ds
    Nil        => "unknown compile error"
    Cons(h, t) => h.code + ": " + h.message

## --- Count passing gates ---
fn ev_count_ok_gates(gs) = match gs
    Nil        => 0
    Cons(h, t) => (if h.ok == 1 then 1 else 0) + ev_count_ok_gates(t)

## --- Governance approval & asymmetric Ed25519 signature verification (#194, #203) ---
## Public keys live in `evolve/maintainers.pub`; private keys live strictly off-repo.
## Unsigned `approved:<name>` is NEVER accepted; only `signed:<who>:ed25519:<128-hex-sig>` passes.
fn ev_default_pubkey(who) = if who == "ricardo" then "81aef71822bb3a4527e38a37b218fac8858467eaec5535dbcb8763f60c12dd0c" else ""

fn ev_find_pubkey(who, pks) = match pks
    Nil        => ""
    Cons(h, t) => if h.who == who then h.key else ev_find_pubkey(who, t)

fn ev_maint_pubkey(who, pks) = if cs_isnil(pks) == 1 then ev_default_pubkey(who) else ev_find_pubkey(who, pks)

fn ev_verify_ed25519_pair(pub_hex, id, raw_cand, rep_cand, sig_hex) = let h1 = sha256_hex(cs_chomp(rep_cand)) in if ed25519_verify(pub_hex, id + ":" + h1, sig_hex) == 1 then 1 else if rep_cand != raw_cand then ed25519_verify(pub_hex, id + ":" + sha256_hex(cs_chomp(raw_cand)), sig_hex) else 0

fn ev_norm_gsig(gsig) = let sp = lc_find_ch(gsig, 0, count(gsig), " ") in if sp < count(gsig) then ev_trim(slice(gsig, sp + 1, count(gsig))) else ev_trim(gsig)

fn ev_verify_signed(rest, id, raw_cand, rep_cand, pks) = let cpos = lc_find_ch(rest, 0, count(rest), ":") in if cpos >= count(rest) then {ok: 0, who: rest, sig: "", sig_ok: 0} else let who = slice(rest, 0, cpos) in let gsig = ev_norm_gsig(slice(rest, cpos + 1, count(rest))) in let pub_hex = ev_maint_pubkey(who, pks) in if count(pub_hex) != 64 or cs_startswith(gsig, "ed25519:") == 0 then {ok: 0, who: who, sig: gsig, sig_ok: 0} else let sig_hex = slice(gsig, 8, count(gsig)) in if ev_verify_ed25519_pair(pub_hex, id, raw_cand, rep_cand, sig_hex) == 1 then {ok: 1, who: who, sig: gsig, sig_ok: 1} else {ok: 0, who: who, sig: gsig, sig_ok: 0}

fn ev_verify_approval(app, id, raw_cand, rep_cand, pks) = if cs_startswith(app, "signed:") == 1 then ev_verify_signed(slice(app, 7, count(app)), id, raw_cand, rep_cand, pks) else if cs_startswith(app, "approved:") == 1 and count(app) > 9 then {ok: 0, who: slice(app, 9, count(app)), sig: "", sig_ok: 0} else {ok: 0, who: "", sig: "", sig_ok: 0}

fn ev_proofs_ok(ps) = match ps
    Nil        => 1
    Cons(p, r) => if p.status == "refuted" then 0 else ev_proofs_ok(r)

fn ev_wcet_ok(ps) = match ps
    Nil        => 1
    Cons(p, r) => if p.kind == "wcet" and p.status == "refuted" then 0 else ev_wcet_ok(r)

fn ev_opt_target(prop) = if count(prop.goal) >= 0 then "" else ""

## --- PUBLIC LIBRARY API (`use levolve`) ---
fn evolve_evaluate_pks(prop, target, pks) = let rep = evolve_repair_and_compile(prop.candidate, prop.tests) in let cand = rep.src in let cand_r = rep.comp in let base_syms = ev_typed_syms(cs_parse(prop.baseline)) in let cand_syms = ev_typed_syms(cand_r.ast) in let asm_lines = ev_count_lines(cand_r.asm) in let g1_ok = if cand_r.ok == 1 and count(cand_r.asm) > 0 then 1 else 0 in let g1_msg = if g1_ok == 1 then "candidate and tests compiled cleanly to native x86-64" else ev_first_diag(cand_r.diagnostics) in let g1 = {name: "compile", ok: g1_ok, detail: g1_msg} in let exp_out = cs_chomp(prop.expected) in let got_out = cs_chomp(cand_r.result) in let pfs_ok = ev_proofs_ok(cand_r.proofs) in let g2_ok = if cand_r.ok == 1 and pfs_ok == 1 and (count(exp_out) == 0 or got_out == exp_out) then 1 else 0 in let g2_msg = if g2_ok == 1 then "all conformance & property tests passed (" + got_out + ")" else if pfs_ok == 0 then "contract/law proof obligation refuted" else "expected '" + exp_out + "' but got '" + got_out + "'" in let g2 = {name: "conformance", ok: g2_ok, detail: g2_msg} in let api = ev_check_syms(base_syms, cand_syms) in let g3_ok = if api.ok == 1 then 1 else 0 in let g3_msg = if g3_ok == 1 then "all " + str(cs_len(base_syms)) + " baseline symbols preserved (" + str(cs_len(cand_syms)) + " total)" else api.broken in let g3 = {name: "api_compat", ok: g3_ok, detail: g3_msg} in let io_used = ev_scan_io(cand, 0, count(cand)) in let g4_ok = if prop.capability == "pure" and count(io_used) > 0 then 0 else 1 in let g4_msg = if g4_ok == 1 then "capability audit passed (grant: " + prop.capability + ")" else "capability violation: pure module invokes I/O builtin '" + io_used + "'" in let g4 = {name: "capability", ok: g4_ok, detail: g4_msg} in let b_ok = ev_wcet_ok(cand_r.proofs) in let g5_ok = if cand_r.ok == 1 and b_ok == 1 and (prop.max_asm_lines <= 0 or asm_lines <= prop.max_asm_lines) then 1 else 0 in let g5_msg = if g5_ok == 1 then "asm_lines=" + str(asm_lines) + " within budget=" + str(prop.max_asm_lines) else "asm_lines=" + str(asm_lines) + " exceeds budget=" + str(prop.max_asm_lines) in let g5 = {name: "budget", ok: g5_ok, detail: g5_msg} in let s2_asm = cand_r.asm in let s3_exp = cs_expand(cand_r.expanded) in let s3_asm = cs_asm_gen(s3_exp) in let g6_ok = if cand_r.ok == 1 and s2_asm == s3_asm and cs_prog_sexpr(cand_r.expanded) == cand_r.expanded_sexpr then 1 else 0 in let g6_msg = if g6_ok == 1 then "stage2==stage3 codegen fixpoint & deterministic expansion verified" else "non-deterministic stage2/stage3 compilation output" in let g6 = {name: "fixpoint", ok: g6_ok, detail: g6_msg} in let gates = Cons(g1, Cons(g2, Cons(g3, Cons(g4, Cons(g5, Cons(g6, Nil)))))) in let passed = ev_count_ok_gates(gates) in let all_ok = if passed == 6 then 1 else 0 in let auth = ev_verify_approval(prop.approval, prop.id, prop.candidate, cand, pks) in let happ = auth.ok in let status = if all_ok == 0 then "rejected_by_gates" else if happ == 0 then (if count(auth.who) > 0 then "rejected_invalid_signature" else "verified_awaiting_human_approval") else "approved_ready_to_apply" in let can_merge = if all_ok == 1 and happ == 1 then 1 else 0 in {id: prop.id, target: target, goal: prop.goal, principles: prop.principles, status: status, gates_ok: all_ok, gates_passed: passed, gates_total: 6, proofs_ok: pfs_ok, benchmark_ok: g5_ok, fixpoint_ok: g6_ok, human_approved: happ, approver: auth.who, signature: auth.sig, signature_verified: auth.sig_ok, can_merge: can_merge, repairs_applied: rep.repairs, repaired_src: cand, gates: gates, test_output: got_out, asm_lines: asm_lines}

fn evolve_evaluate(prop) = evolve_evaluate_pks(prop, "", Nil)

## --- JSON serialisation for `lume evolve` ---
fn ev_gate_json(g) = "{\"name\":\"" + cs_jesc(g.name) + "\",\"ok\":" + (if g.ok == 1 then "true" else "false") + ",\"detail\":\"" + cs_jesc(g.detail) + "\"}"
fn ev_gates_json(gs) = match gs
    Nil        => ""
    Cons(h, t) => if cs_isnil(t) == 1 then ev_gate_json(h) else ev_gate_json(h) + "," + ev_gates_json(t)

fn evolve_json(r) = "{\"id\":\"" + cs_jesc(r.id) + "\",\"target\":\"" + cs_jesc(r.target) + "\",\"goal\":\"" + cs_jesc(r.goal) + "\",\"principles\":\"" + cs_jesc(r.principles) + "\",\"status\":\"" + cs_jesc(r.status) + "\",\"gates_ok\":" + (if r.gates_ok == 1 then "true" else "false") + ",\"gates_passed\":" + str(r.gates_passed) + ",\"gates_total\":" + str(r.gates_total) + ",\"proofs_ok\":" + (if r.proofs_ok == 1 then "true" else "false") + ",\"benchmark_ok\":" + (if r.benchmark_ok == 1 then "true" else "false") + ",\"fixpoint_stage2_eq_stage3\":" + (if r.fixpoint_ok == 1 then "true" else "false") + ",\"candidate_sha256\":\"" + sha256_hex(cs_chomp(r.repaired_src)) + "\",\"human_approved\":" + (if r.human_approved == 1 then "true" else "false") + ",\"approver\":\"" + cs_jesc(r.approver) + "\",\"signature\":\"" + cs_jesc(r.signature) + "\",\"signature_verified\":" + (if r.signature_verified == 1 then "true" else "false") + ",\"can_merge\":" + (if r.can_merge == 1 then "true" else "false") + ",\"repairs_applied\":" + str(r.repairs_applied) + ",\"asm_lines\":" + str(r.asm_lines) + ",\"test_output\":\"" + cs_jesc(r.test_output) + "\",\"gates\":[" + ev_gates_json(r.gates) + "]}"

## --- Directive bundle parser (`@proposal`, `@target`, `@pubkey`, `@mode`, `@baseline ... @end`, etc.) ---
fn ev_lines(s, i, n) = if i >= n then Nil else let le = cs_lineend(s, i, n) in Cons(cs_chomp(slice(s, i, le)), ev_lines(s, le, n))

fn ev_collect_lines(ls) = match ls
    Nil        => {lines: Nil, rest: Nil}
    Cons(h, t) => if h == "@end" then {lines: Nil, rest: t} else let r = ev_collect_lines(t) in {lines: Cons(h, r.lines), rest: r.rest}

fn ev_collect_block(ls) = let r = ev_collect_lines(ls) in {body: cs_joinsep(r.lines, "\n"), rest: r.rest}

fn ev_parse_pubkey_line(s, pks) = let sp = lc_find_ch(s, 0, count(s), " ") in if sp >= count(s) then pks else let who = ev_trim(slice(s, 0, sp)) in let raw_k = ev_trim(slice(s, sp + 1, count(s))) in let k = if cs_startswith(raw_k, "ed25519:") == 1 then slice(raw_k, 8, count(raw_k)) else raw_k in if count(who) > 0 and count(k) == 64 then Cons({who: who, key: k}, pks) else pks

fn ev_parse_lines(ls, prop) = match ls
    Nil        => prop
    Cons(h, t) => if count(h) == 0 then ev_parse_lines(t, prop) else if cs_startswith(h, "@mode ") == 1 then ev_parse_lines(t, {mode: ev_trim(slice(h, 6, count(h))), target: prop.target, pubkeys: prop.pubkeys, id: prop.id, goal: prop.goal, principles: prop.principles, capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: prop.candidate, tests: prop.tests, expected: prop.expected, approval: prop.approval}) else if cs_startswith(h, "@target ") == 1 then ev_parse_lines(t, {mode: prop.mode, target: ev_trim(slice(h, 8, count(h))), pubkeys: prop.pubkeys, id: prop.id, goal: prop.goal, principles: prop.principles, capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: prop.candidate, tests: prop.tests, expected: prop.expected, approval: prop.approval}) else if cs_startswith(h, "@pubkey ") == 1 then ev_parse_lines(t, {mode: prop.mode, target: prop.target, pubkeys: ev_parse_pubkey_line(ev_trim(slice(h, 8, count(h))), prop.pubkeys), id: prop.id, goal: prop.goal, principles: prop.principles, capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: prop.candidate, tests: prop.tests, expected: prop.expected, approval: prop.approval}) else if cs_startswith(h, "@proposal ") == 1 then ev_parse_lines(t, {mode: prop.mode, target: prop.target, pubkeys: prop.pubkeys, id: ev_trim(slice(h, 10, count(h))), goal: prop.goal, principles: prop.principles, capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: prop.candidate, tests: prop.tests, expected: prop.expected, approval: prop.approval}) else if cs_startswith(h, "@goal ") == 1 then ev_parse_lines(t, {mode: prop.mode, target: prop.target, pubkeys: prop.pubkeys, id: prop.id, goal: ev_trim(slice(h, 6, count(h))), principles: prop.principles, capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: prop.candidate, tests: prop.tests, expected: prop.expected, approval: prop.approval}) else if cs_startswith(h, "@principles ") == 1 then ev_parse_lines(t, {mode: prop.mode, target: prop.target, pubkeys: prop.pubkeys, id: prop.id, goal: prop.goal, principles: ev_trim(slice(h, 12, count(h))), capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: prop.candidate, tests: prop.tests, expected: prop.expected, approval: prop.approval}) else if cs_startswith(h, "@capability ") == 1 then ev_parse_lines(t, {mode: prop.mode, target: prop.target, pubkeys: prop.pubkeys, id: prop.id, goal: prop.goal, principles: prop.principles, capability: ev_trim(slice(h, 12, count(h))), max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: prop.candidate, tests: prop.tests, expected: prop.expected, approval: prop.approval}) else if cs_startswith(h, "@max_asm_lines ") == 1 then ev_parse_lines(t, {mode: prop.mode, target: prop.target, pubkeys: prop.pubkeys, id: prop.id, goal: prop.goal, principles: prop.principles, capability: prop.capability, max_asm_lines: toint(ev_trim(slice(h, 15, count(h)))), baseline: prop.baseline, candidate: prop.candidate, tests: prop.tests, expected: prop.expected, approval: prop.approval}) else if cs_startswith(h, "@approval ") == 1 then ev_parse_lines(t, {mode: prop.mode, target: prop.target, pubkeys: prop.pubkeys, id: prop.id, goal: prop.goal, principles: prop.principles, capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: prop.candidate, tests: prop.tests, expected: prop.expected, approval: ev_trim(slice(h, 10, count(h)))}) else if h == "@baseline" then let b = ev_collect_block(t) in ev_parse_lines(b.rest, {mode: prop.mode, target: prop.target, pubkeys: prop.pubkeys, id: prop.id, goal: prop.goal, principles: prop.principles, capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: b.body, candidate: prop.candidate, tests: prop.tests, expected: prop.expected, approval: prop.approval}) else if h == "@candidate" then let b = ev_collect_block(t) in ev_parse_lines(b.rest, {mode: prop.mode, target: prop.target, pubkeys: prop.pubkeys, id: prop.id, goal: prop.goal, principles: prop.principles, capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: b.body, tests: prop.tests, expected: prop.expected, approval: prop.approval}) else if h == "@tests" then let b = ev_collect_block(t) in ev_parse_lines(b.rest, {mode: prop.mode, target: prop.target, pubkeys: prop.pubkeys, id: prop.id, goal: prop.goal, principles: prop.principles, capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: prop.candidate, tests: b.body, expected: prop.expected, approval: prop.approval}) else if h == "@expected" then let b = ev_collect_block(t) in ev_parse_lines(b.rest, {mode: prop.mode, target: prop.target, pubkeys: prop.pubkeys, id: prop.id, goal: prop.goal, principles: prop.principles, capability: prop.capability, max_asm_lines: prop.max_asm_lines, baseline: prop.baseline, candidate: prop.candidate, tests: prop.tests, expected: b.body, approval: prop.approval}) else ev_parse_lines(t, prop)

fn evolve_parse_bundle(text) = ev_parse_lines(ev_lines(text, 0, count(text)), {mode: "json", target: "", pubkeys: Nil, id: "0000", goal: "", principles: "P1", capability: "pure", max_asm_lines: 200, baseline: "", candidate: "", tests: "", expected: "", approval: "none"})

fn evolve_run_cli(text) = let prop = evolve_parse_bundle(text) in let r = evolve_evaluate_pks(prop, prop.target, prop.pubkeys) in if prop.mode == "apply" then (if r.can_merge == 1 then cs_chomp(r.repaired_src) else ctfail("lume evolve apply: proposal '" + r.id + "' rejected (" + r.status + ")\n")) else evolve_json(r)

print evolve_run_cli(readall())
