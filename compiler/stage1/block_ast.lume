## block_ast.lume — AST for a small block-structured language (library module).
type Expr = enum
    Num(value: int)
    Name(id: str)
    Call(name: str, args: [Expr])
    Bin(op: str, left: Expr, right: Expr)

type Stmt = enum
    Assign(name: str, value: Expr)
    Print(value: Expr)
    While(cond: Expr, body: [Stmt])
    If(cond: Expr, then_body: [Stmt], else_body: [Stmt])
    Fn(name: str, params: [str], body: [Stmt])
    Return(value: Expr)
