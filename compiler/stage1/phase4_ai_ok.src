## Phase 4 (Stage 4): AI, Tensors, Autodiff, Kernels, Prob, Rules, LLM & Spiking Neuro
## Conformance suite exercising Tracks N1 (P11), N2 (P12, P13, P29), and N3 (P14, P15, P16, P21).

fn t_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + t_len(t)

fn t_nth(xs, idx) = match xs
    Nil        => 0
    Cons(h, t) => if idx <= 0 then h else t_nth(t, idx - 1)

fn t_repeat(n, v) = if n <= 0 then Nil else Cons(v, t_repeat(n - 1, v))

fn t_map_relu(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(if h > 0 then h else 0, t_map_relu(t))

fn t_add_bias_row(xs, bs, cols, c) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(h + t_nth(bs, c), t_add_bias_row(t, bs, cols, if c + 1 >= cols then 0 else c + 1))

fn tensor_mat(rows, cols, data) = {rank: 2, d0: rows, d1: cols, data: data}
fn tensor_vec(n, data) = {rank: 1, d0: n, d1: 1, data: data}
fn tensor_get(t, r, c) = t_nth(t.data, (r * t.d1) + c)
fn tensor_relu(t) = {rank: t.rank, d0: t.d0, d1: t.d1, data: t_map_relu(t.data)}
fn tensor_add_bias(t, b) = {rank: t.rank, d0: t.d0, d1: t.d1, data: t_add_bias_row(t.data, b.data, t.d1, 0)}

fn mm_dot(a, b, r, c, k, cols_a) = if k >= cols_a then 0 else (tensor_get(a, r, k) * tensor_get(b, k, c)) + mm_dot(a, b, r, c, k + 1, cols_a)
fn mm_row(a, b, r, c, cols_b) = if c >= cols_b then Nil else Cons(mm_dot(a, b, r, c, 0, a.d1), mm_row(a, b, r, c + 1, cols_b))
fn t_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, t_app(t, ys))
fn mm_rows(a, b, r) = if r >= a.d0 then Nil else t_app(mm_row(a, b, r, 0, b.d1), mm_rows(a, b, r + 1))
fn matmul(a, b) = {rank: 2, d0: a.d0, d1: b.d1, data: mm_rows(a, b, 0)}

fn t_sum(xs) = match xs
    Nil        => 0
    Cons(h, t) => h + t_sum(t)
fn tensor_sum(t) = t_sum(t.data)

## Track N1: Shape-typed tensor function checked at compile time (`[T0300]`)
type Linear2x2 = model { w: tensor[f32, K, N], b: tensor[f32, N] }

fn forward_layer(m: Linear2x2, x: tensor[f32, B, K]) -> tensor[f32, B, N] =
    tensor_relu(tensor_add_bias(matmul(x, m.w), m.b))

## Track N2: Differentiable function + symbolic autodiff (`grad`, `jvp`, `vjp`, `jit`)
## f(x) = x*x - 6*x + 13  =>  f'(x) = 2*x - 6 (minimum at x = 3)
fn quad_loss(x: int) -> int = (x * x) - (6 * x) + 13

## Contract over `grad(quad_loss, x)` proven at compile time by QF_LIA (`call ctfail == 0`)!
fn verified_grad_step(x: int) -> int requires x >= 3 ensures result >= 0 =
    grad(quad_loss, x)

fn verified_jvp_vjp(x: int) -> int requires x == 5 ensures result == 16 =
    jvp(quad_loss, x, 2) + vjp(quad_loss, x, 2)

## Track N2: Accelerator kernel (`kernel fn`) with schedule annotation
@schedule(tile: 16, vectorize: 4)
@autotune
kernel fn fused_affine_relu(x: int, w: int, b: int) -> int / gpu =
    let z = (x * w) + b in if z > 0 then z else 0

## Track N3: Datalog `rule` declarations (`P15`)
rule edge_fact(u: int, v: int) -> int =
    if u == 1 and v == 2 then 1 else if u == 2 and v == 3 then 1 else if u == 3 and v == 4 then 1 else 0

rule path_2hop(u: int, w: int) -> int =
    if edge_fact(u, 2) == 1 and edge_fact(2, w) == 1 then 1 else if edge_fact(u, 3) == 1 and edge_fact(3, w) == 1 then 1 else 0

## Track N3: Typed `extern llm fn` with `ensures` contract discharging `[A0003]` (`P16`)
pub extern llm fn extract_invoice_total(doc_id: int) -> int ensures result > 0 =
    if doc_id == 1 then 420 else 150

pub fn audit_invoice(doc_id: int) -> int =
    extract_invoice_total(doc_id)

## Track N3: Spiking LIF neuron step on deterministic logical ticks (`P21`)
fn lif_step_v(v: int, i_in: int) -> int =
    let v_next = ((v * 80) / 100) + i_in in
    if v_next >= 100 then 1 else 0

fn run_phase4_all() =
    let w = tensor_mat(2, 2, Cons(2, Cons(1, Cons(1, Cons(3, Nil))))) in
    let b = tensor_vec(2, Cons(1, Cons(0 - 2, Nil))) in
    let x = tensor_mat(2, 2, Cons(3, Cons(4, Cons(1, Cons(2, Nil))))) in
    let m = {w: w, b: b} in
    let y = forward_layer(m, x) in
    let s1 = tensor_sum(y) in
    let g5 = verified_grad_step(5) in
    let jv = verified_jvp_vjp(5) in
    let kf = jit(fused_affine_relu, 6, 4, 0 - 3) in
    let rl = path_2hop(1, 3) + path_2hop(2, 4) in
    let inv = audit_invoice(1) in
    let spk = lif_step_v(60, 55) in
    s1 + g5 + jv + kf + rl + inv + spk

print run_phase4_all()
