## codegen.lume — a code generator written in Lume: AST -> C source (library module).
## The lowering step of lumec: structure becomes the actual machine bits, via the C backend.
use ast

fn cop(op: str) -> str
    match op
        "==" => "=="
        "!=" => "!="
        _    => op

fn cexpr(e: Expr) -> str
    match e
        Num(v)        => "{v}"
        Str(_)        => "0"
        Name(id)      => id
        Bin(op, l, r) => "(" + cexpr(l) + " " + cop(op) + " " + cexpr(r) + ")"
        Call(c, args) => do
            if c == "max" and args.len() == 2
                let a = cexpr(args[0])
                let b = cexpr(args[1])
                "((" + a + ") > (" + b + ") ? (" + a + ") : (" + b + "))"
            elif c == "min" and args.len() == 2
                let a = cexpr(args[0])
                let b = cexpr(args[1])
                "((" + a + ") < (" + b + ") ? (" + a + ") : (" + b + "))"
            elif c == "sum"
                "(" + args.map(cexpr).join(" + ") + ")"
            else
                c + "(" + args.map(cexpr).join(", ") + ")"
        If(c, t, e)   => "((" + cexpr(c) + ") ? (" + cexpr(t) + ") : (" + cexpr(e) + "))"

fn cparams(params: [str]) -> str = params.map(|p| "long long " + p).join(", ")

fn cgen(prog: [Stmt]) -> str
    var funcs = ""
    var body = "int main(void) {{\n"
    for s in prog
        match s
            Fn(name, params, b) => do
                funcs = funcs + "long long " + name + "(" + cparams(params) + ") {{ return " + cexpr(b) + "; }}\n"
            Let(name, v) => do
                body = body + "    long long " + name + " = " + cexpr(v) + ";\n"
                body = body + "    printf(\"" + name + " = %lld\\n\", " + name + ");\n"
            Eval(v) => do
                body = body + "    printf(\"%lld\\n\", (long long)(" + cexpr(v) + "));\n"
    "#include <stdio.h>\n" + funcs + body + "    return 0;\n}}\n"
