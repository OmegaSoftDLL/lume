## compiler/stage1/ltarget.src — Universal Targets Backend (Issue #206 & #215, docs/26-targets.md)
##
## Orthogonal Target-Triple Architecture (T0):
##   target = (ISA encoder)  _||_  (object/container writer)  _||_  (OS / ABI + syscall layer)
##
## Supported Target Triples:
##   1. `x86_64-linux-elf`    — x86-64 ISA + ELF64 (EM_X86_64=62) + Linux System V AMD64 ABI (shipped)
##   2. `aarch64-linux-elf`   — AArch64 A64 ISA + ELF64 (EM_AARCH64=183) + Linux AAPCS64 ABI (shipped; runs in qemu-aarch64)
##   3. `aarch64-macos-macho` — AArch64 A64 ISA + Mach-O 64 (MH_MAGIC_64) + Darwin AAPCS64 ABI (shipped; runs natively on Apple Silicon)
##   4. `x86_64-macos-macho`  — x86-64 ISA + Mach-O 64 (MH_MAGIC_64) + Darwin System V AMD64 ABI (shipped; runs on macOS x86_64 / Rosetta 2)
##   5. `x86_64-windows-pe`   — x86-64 ISA + PE32+/COFF (0x8664) + Windows x64 ABI (shipped; runs natively on Windows x64)
##   6. `riscv64-linux-elf`   — RISC-V RV64IM ISA + ELF64 (EM_RISCV=243) + Linux LP64 ABI (shipped; runs in qemu-riscv64)
##   7. `<isa>-none-ihex`     — AArch64 / RISC-V / x86-64 freestanding firmware in Intel HEX (`.hex`) format (shipped)
##   8. `x86_64-none-raw`     — Bare-metal bootable MBR + 64-bit Long Mode kernel image (shipped via lasm `.kernel`, boots in qemu-system-x86_64)
##   9. `lumb`                — Portable Lume Bytecode (`LUMB\x01`) container + deterministic stack VM (shipped; closes #215 `lumb` brick)
##
## Proof-Preserving Guarantee (H5 / docs/28):
##   - Every target enforces Lume's `requires`/`ensures` contracts.
##   - Contracts discharged as `proven` by the sound QF_LIA prover have their runtime guard elided (`guards_elided > 0`).
##   - Contracts marked `runtime_checked` (e.g., nonlinear `x * x`) emit a native target-ISA runtime trap that exits with status 3.
##   - Out-of-fragment constructs emit explicit `[T0900]`/`[T0901]` diagnostics (never a silent 0).

## --- 0. Basic List, Byte & Hex Helpers ---

fn tg_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, tg_app(t, ys))

fn tg_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + tg_len(t)

fn tg_nth(xs, idx) = match xs
    Nil        => 0
    Cons(h, t) => if idx <= 0 then h else tg_nth(t, idx - 1)

fn tg_rev_acc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => tg_rev_acc(t, Cons(h, acc))

fn tg_rev(xs) = tg_rev_acc(xs, Nil)

fn tg_zeros(n) = if n <= 0 then Nil else Cons(0, tg_zeros(n - 1))

fn tg_repeat_str(s, n) = if n <= 0 then "" else if n == 1 then s else let h = tg_repeat_str(s, n / 2) in h + h + (if n % 2 == 1 then s else "")

fn tg_lowbyte(x) = let m = x % 256 in if m < 0 then m + 256 else m

fn tg_b2(x) = Cons(tg_lowbyte(x), Cons(tg_lowbyte(x / 256), Nil))

fn tg_b4(x) = let u = if x < 0 then 4294967296 + x else x in tg_app(tg_b2(u % 65536), tg_b2(u / 65536))

fn tg_b8(x) = tg_app(tg_b4(x % 4294967296), tg_b4(x / 4294967296))

fn tg_hex_digit(n) = let v = tg_lowbyte(n) % 16 in if v < 10 then str(v) else if v == 10 then "a" else if v == 11 then "b" else if v == 12 then "c" else if v == 13 then "d" else if v == 14 then "e" else "f"

fn tg_hex_digit_upper(n) = let v = tg_lowbyte(n) % 16 in if v < 10 then str(v) else if v == 10 then "A" else if v == 11 then "B" else if v == 12 then "C" else if v == 13 then "D" else if v == 14 then "E" else "F"

fn tg_byte_hex(b) = let v = tg_lowbyte(b) in tg_hex_digit(v / 16) + tg_hex_digit(v % 16)

fn tg_byte_hex_upper(b) = let v = tg_lowbyte(b) in tg_hex_digit_upper(v / 16) + tg_hex_digit_upper(v % 16)

fn tg_isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0

fn tg_pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => tg_pairs2(a, t)

fn tg_pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, tg_pairs(r))

fn tg_joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if tg_isnil(t) == 1 then a else tg_joinall(tg_pairs(xs))

fn tg_bytes_to_hex_list(bs) = match bs
    Nil        => Nil
    Cons(b, t) => Cons(tg_byte_hex(b), tg_bytes_to_hex_list(t))

fn tg_bytes_to_hex(bs) = tg_joinall(tg_bytes_to_hex_list(bs))

fn tg_find_ascii(c, i) = let tab = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~" in if i >= 95 then 31 else if slice(tab, i, i + 1) == c then i else tg_find_ascii(c, i + 1)

fn tg_char_code(c) = let o = ord(c) in if o > 0 then o else if c == "\n" then 10 else if c == "\t" then 9 else if c == "" then 0 else 32 + tg_find_ascii(c, 0)

fn tg_str_bytes_i(s, i, n) = if i >= n then Nil else Cons(tg_char_code(at(s, i)), tg_str_bytes_i(s, i + 1, n))

fn tg_str_bytes(s) = tg_str_bytes_i(s, 0, count(s))

fn tg_str_pad(s, total_len) = let bs = tg_str_bytes(s) in tg_app(bs, tg_zeros(total_len - tg_len(bs)))

## --- 1. T0: Orthogonal Target-Triple Registry & Selector ---

fn target_parse_triple(triple) = if triple == "x86_64-linux-elf" or triple == "linux-x86_64" or triple == "x86_64-unknown-linux-gnu" then {valid: 1, triple: "x86_64-linux-elf", isa: "x86_64", os: "linux", fmt: "elf64", abi: "sysv64", e_machine: 62, status: "shipped", diag: ""} else if triple == "aarch64-linux-elf" or triple == "linux-aarch64" or triple == "arm64-linux" or triple == "aarch64-unknown-linux-gnu" then {valid: 1, triple: "aarch64-linux-elf", isa: "aarch64", os: "linux", fmt: "elf64", abi: "aapcs64-linux", e_machine: 183, status: "shipped", diag: ""} else if triple == "aarch64-macos-macho" or triple == "macos-aarch64" or triple == "arm64-macos" or triple == "aarch64-apple-darwin" then {valid: 1, triple: "aarch64-macos-macho", isa: "aarch64", os: "macos", fmt: "macho64", abi: "aapcs64-darwin", e_machine: 16777228, status: "shipped", diag: ""} else if triple == "x86_64-macos-macho" or triple == "macos-x86_64" or triple == "x86_64-macos" or triple == "x86_64-apple-darwin" then {valid: 1, triple: "x86_64-macos-macho", isa: "x86_64", os: "macos", fmt: "macho64", abi: "sysv64-darwin", e_machine: 16777223, status: "shipped", diag: ""} else if triple == "x86_64-windows-pe" or triple == "windows-x86_64" or triple == "x86_64-pc-windows-msvc" then {valid: 1, triple: "x86_64-windows-pe", isa: "x86_64", os: "windows", fmt: "pe64", abi: "win64", e_machine: 34404, status: "shipped", diag: ""} else if triple == "riscv64-linux-elf" or triple == "linux-riscv64" or triple == "riscv64" or triple == "riscv64gc-unknown-linux-gnu" then {valid: 1, triple: "riscv64-linux-elf", isa: "riscv64", os: "linux", fmt: "elf64", abi: "lp64-linux", e_machine: 243, status: "shipped", diag: ""} else if triple == "aarch64-none-ihex" or triple == "arm64-none-ihex" then {valid: 1, triple: "aarch64-none-ihex", isa: "aarch64", os: "none", fmt: "ihex", abi: "freestanding", e_machine: 183, status: "shipped", diag: ""} else if triple == "riscv64-none-ihex" then {valid: 1, triple: "riscv64-none-ihex", isa: "riscv64", os: "none", fmt: "ihex", abi: "freestanding", e_machine: 243, status: "shipped", diag: ""} else if triple == "x86_64-none-ihex" then {valid: 1, triple: "x86_64-none-ihex", isa: "x86_64", os: "none", fmt: "ihex", abi: "freestanding", e_machine: 62, status: "shipped", diag: ""} else if triple == "x86_64-none-raw" or triple == "x86_64-none-mbr" then {valid: 1, triple: "x86_64-none-raw", isa: "x86_64", os: "none", fmt: "raw", abi: "freestanding", e_machine: 62, status: "shipped", diag: ""} else if triple == "lumb" or triple == "lumb-portable-vm" then {valid: 1, triple: "lumb", isa: "lumb", os: "portable", fmt: "lumb", abi: "stack-vm", e_machine: 0, status: "shipped", diag: ""} else if triple == "wasm32-wasi" or triple == "wasm32" then {valid: 1, triple: "wasm32-wasi", isa: "wasm32", os: "wasi", fmt: "wasm", abi: "wasi", e_machine: 0, status: "shipped", diag: ""} else if triple == "nvptx64-nvidia-cuda" or triple == "nvptx64" or triple == "cuda-ptx" then {valid: 1, triple: "nvptx64-nvidia-cuda", isa: "nvptx64", os: "cuda", fmt: "ptx", abi: "ptx80", e_machine: 190, status: "shipped", diag: ""} else if triple == "spirv64-vulkan-compute" or triple == "spirv64" or triple == "vulkan-spirv" then {valid: 1, triple: "spirv64-vulkan-compute", isa: "spirv64", os: "vulkan", fmt: "spvasm", abi: "spirv16", e_machine: 0, status: "shipped", diag: ""} else if triple == "arm-none-cortexm" or triple == "thumbv7em-none-eabihf" or triple == "cortex-m" then {valid: 1, triple: "arm-none-cortexm", isa: "cortexm", os: "none", fmt: "cortexm-bin", abi: "eabihf", e_machine: 40, status: "shipped", diag: ""} else if triple == "avr-none-elf" or triple == "avr-elf" or triple == "atmega328p-elf" then {valid: 1, triple: "avr-none-elf", isa: "avr", os: "none", fmt: "elf32", abi: "avr", e_machine: 83, status: "shipped", diag: ""} else if triple == "avr-none-ihex" or triple == "avr-ihex" then {valid: 1, triple: "avr-none-ihex", isa: "avr", os: "none", fmt: "ihex", abi: "avr", e_machine: 83, status: "shipped", diag: ""} else if triple == "xtensa-esp32-elf" or triple == "xtensa-lx6-elf" or triple == "esp32-elf" then {valid: 1, triple: "xtensa-esp32-elf", isa: "xtensa", os: "esp32", fmt: "elf32", abi: "windowed", e_machine: 94, status: "shipped", diag: ""} else if triple == "xtensa-none-ihex" or triple == "esp32-ihex" then {valid: 1, triple: "xtensa-none-ihex", isa: "xtensa", os: "none", fmt: "ihex", abi: "windowed", e_machine: 94, status: "shipped", diag: ""} else if triple == "verilog-rtl" or triple == "fpga-verilog" or triple == "ieee1364-verilog" then {valid: 1, triple: "verilog-rtl", isa: "verilog", os: "fpga", fmt: "verilog", abi: "rtl-sync", e_machine: 0, status: "shipped", diag: ""} else if triple == "vhdl-rtl" or triple == "fpga-vhdl" or triple == "ieee1076-vhdl" then {valid: 1, triple: "vhdl-rtl", isa: "vhdl", os: "fpga", fmt: "vhdl", abi: "rtl-sync", e_machine: 0, status: "shipped", diag: ""} else if triple == "aarch64-ios-macho" or triple == "ios-arm64" or triple == "aarch64-apple-ios" then {valid: 1, triple: "aarch64-ios-macho", isa: "aarch64", os: "ios", fmt: "macho64-ios", abi: "aapcs64-darwin", e_machine: 16777228, status: "shipped", diag: ""} else if triple == "aarch64-android-elf" or triple == "android-arm64" or triple == "aarch64-linux-android" then {valid: 1, triple: "aarch64-android-elf", isa: "aarch64", os: "android", fmt: "elf64-android", abi: "aapcs64-linux", e_machine: 183, status: "shipped", diag: ""} else if triple == "wasm32-web-dom" or triple == "wasm32-unknown-web" or triple == "web-dom" then {valid: 1, triple: "wasm32-web-dom", isa: "wasm32", os: "web", fmt: "wasm-dom", abi: "web-dom", e_machine: 0, status: "shipped", diag: ""} else {valid: 0, triple: triple, isa: "", os: "", fmt: "", abi: "", e_machine: 0, status: "unknown", diag: "[T0901] error: unknown target triple '" + triple + "'"}

fn target_list_json() = "{\"architecture\":\"(ISA encoder) orthogonal (container writer) orthogonal (OS/ABI layer)\",\"targets\":[{\"triple\":\"x86_64-linux-elf\",\"isa\":\"x86_64\",\"os\":\"linux\",\"format\":\"elf64\",\"abi\":\"sysv64\",\"status\":\"shipped\"},{\"triple\":\"aarch64-linux-elf\",\"isa\":\"aarch64\",\"os\":\"linux\",\"format\":\"elf64\",\"abi\":\"aapcs64-linux\",\"status\":\"shipped\"},{\"triple\":\"aarch64-macos-macho\",\"isa\":\"aarch64\",\"os\":\"macos\",\"format\":\"macho64\",\"abi\":\"aapcs64-darwin\",\"status\":\"shipped\"},{\"triple\":\"x86_64-macos-macho\",\"isa\":\"x86_64\",\"os\":\"macos\",\"format\":\"macho64\",\"abi\":\"sysv64-darwin\",\"status\":\"shipped\"},{\"triple\":\"x86_64-windows-pe\",\"isa\":\"x86_64\",\"os\":\"windows\",\"format\":\"pe64\",\"abi\":\"win64\",\"status\":\"shipped\"},{\"triple\":\"riscv64-linux-elf\",\"isa\":\"riscv64\",\"os\":\"linux\",\"format\":\"elf64\",\"abi\":\"lp64-linux\",\"status\":\"shipped\"},{\"triple\":\"aarch64-none-ihex\",\"isa\":\"aarch64\",\"os\":\"none\",\"format\":\"ihex\",\"abi\":\"freestanding\",\"status\":\"shipped\"},{\"triple\":\"riscv64-none-ihex\",\"isa\":\"riscv64\",\"os\":\"none\",\"format\":\"ihex\",\"abi\":\"freestanding\",\"status\":\"shipped\"},{\"triple\":\"x86_64-none-ihex\",\"isa\":\"x86_64\",\"os\":\"none\",\"format\":\"ihex\",\"abi\":\"freestanding\",\"status\":\"shipped\"},{\"triple\":\"x86_64-none-raw\",\"isa\":\"x86_64\",\"os\":\"none\",\"format\":\"raw\",\"abi\":\"freestanding\",\"status\":\"shipped\"},{\"triple\":\"wasm32-wasi\",\"isa\":\"wasm32\",\"os\":\"wasi\",\"format\":\"wasm\",\"abi\":\"wasi\",\"status\":\"shipped\"},{\"triple\":\"lumb\",\"isa\":\"lumb\",\"os\":\"portable\",\"format\":\"lumb\",\"abi\":\"stack-vm\",\"status\":\"shipped\"},{\"triple\":\"nvptx64-nvidia-cuda\",\"isa\":\"nvptx64\",\"os\":\"cuda\",\"format\":\"ptx\",\"abi\":\"ptx80\",\"status\":\"shipped\"},{\"triple\":\"spirv64-vulkan-compute\",\"isa\":\"spirv64\",\"os\":\"vulkan\",\"format\":\"spvasm\",\"abi\":\"spirv16\",\"status\":\"shipped\"},{\"triple\":\"arm-none-cortexm\",\"isa\":\"cortexm\",\"os\":\"none\",\"format\":\"cortexm-bin\",\"abi\":\"eabihf\",\"status\":\"shipped\"},{\"triple\":\"avr-none-elf\",\"isa\":\"avr\",\"os\":\"none\",\"format\":\"elf32\",\"abi\":\"avr\",\"status\":\"shipped\"},{\"triple\":\"avr-none-ihex\",\"isa\":\"avr\",\"os\":\"none\",\"format\":\"ihex\",\"abi\":\"avr\",\"status\":\"shipped\"},{\"triple\":\"xtensa-esp32-elf\",\"isa\":\"xtensa\",\"os\":\"esp32\",\"format\":\"elf32\",\"abi\":\"windowed\",\"status\":\"shipped\"},{\"triple\":\"xtensa-none-ihex\",\"isa\":\"xtensa\",\"os\":\"none\",\"format\":\"ihex\",\"abi\":\"windowed\",\"status\":\"shipped\"},{\"triple\":\"verilog-rtl\",\"isa\":\"verilog\",\"os\":\"fpga\",\"format\":\"verilog\",\"abi\":\"rtl-sync\",\"status\":\"shipped\"},{\"triple\":\"vhdl-rtl\",\"isa\":\"vhdl\",\"os\":\"fpga\",\"format\":\"vhdl\",\"abi\":\"rtl-sync\",\"status\":\"shipped\"},{\"triple\":\"aarch64-ios-macho\",\"isa\":\"aarch64\",\"os\":\"ios\",\"format\":\"macho64-ios\",\"abi\":\"aapcs64-darwin\",\"status\":\"shipped\"},{\"triple\":\"aarch64-android-elf\",\"isa\":\"aarch64\",\"os\":\"android\",\"format\":\"elf64-android\",\"abi\":\"aapcs64-linux\",\"status\":\"shipped\"},{\"triple\":\"wasm32-web-dom\",\"isa\":\"wasm32\",\"os\":\"web\",\"format\":\"wasm-dom\",\"abi\":\"web-dom\",\"status\":\"shipped\"}]}"

## --- 2. Source Lexer, Parser & QF_LIA Proof-Preserving Contract Lowering ---

fn tg_isws(c) = c == " " or c == "\t" or c == "\n" or c == "\r"
fn tg_isdigit(c) = c >= "0" and c <= "9"
fn tg_isalpha(c) = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
fn tg_isalnum(c) = tg_isdigit(c) or tg_isalpha(c)

fn tg_numend(s, i, n) = if i >= n then i else if tg_isdigit(at(s, i)) then tg_numend(s, i + 1, n) else i
fn tg_idend(s, i, n) = if i >= n then i else if tg_isalnum(at(s, i)) then tg_idend(s, i + 1, n) else i
fn tg_lineend(s, i, n) = if i >= n then i else if at(s, i) == "\n" then i + 1 else tg_lineend(s, i + 1, n)
fn tg_escch(c) = if c == "n" then "\n" else if c == "t" then "\t" else if c == "\"" then "\"" else if c == "\\" then "\\" else c
fn tg_strend(s, i, n, acc) = if i >= n then {txt: acc, next: n} else let c = at(s, i) in if c == "\"" then {txt: acc, next: i + 1} else if c == "\\" then tg_strend(s, i + 2, n, acc + tg_escch(at(s, i + 1))) else tg_strend(s, i + 1, n, acc + c)
fn tg_istwo(s, i, n) = if i + 1 >= n then 0 else let p = slice(s, i, i + 2) in if p == "==" or p == "!=" or p == "<=" or p == ">=" or p == "->" then 1 else 0

fn tg_lex(s, i, n) = if i >= n then Nil else let c = at(s, i) in if tg_isws(c) then tg_lex(s, i + 1, n) else if c == "#" then tg_lex(s, tg_lineend(s, i + 1, n), n) else if tg_isdigit(c) then (let j = tg_numend(s, i, n) in Cons({k: "NM", t: slice(s, i, j)}, tg_lex(s, j, n))) else if tg_isalpha(c) then (let j = tg_idend(s, i, n) in Cons({k: "ID", t: slice(s, i, j)}, tg_lex(s, j, n))) else if c == "\"" then (let r = tg_strend(s, i + 1, n, "") in Cons({k: "ST", t: r.txt}, tg_lex(s, r.next, n))) else if tg_istwo(s, i, n) == 1 then Cons({k: "SY", t: slice(s, i, i + 2)}, tg_lex(s, i + 2, n)) else Cons({k: "SY", t: c}, tg_lex(s, i + 1, n))

fn tg_hd(ts) = match ts
    Nil        => {k: "EOF", t: ""}
    Cons(h, t) => h

fn tg_hdk(ts) = (tg_hd(ts)).k
fn tg_hdt(ts) = (tg_hd(ts)).t
fn tg_drop(ts) = match ts
    Nil        => Nil
    Cons(h, t) => t
fn tg_dropkw(ts, kw) = if tg_hdt(ts) == kw then tg_drop(ts) else ts

fn tg_atom(ts) = let k = tg_hdk(ts) in let t = tg_hdt(ts) in if k == "NM" then {e: TNum(toint(t)), rest: tg_drop(ts)} else if k == "ST" then {e: TStr(t), rest: tg_drop(ts)} else if t == "-" then (let r = tg_atom(tg_drop(ts)) in {e: TBin("-", TNum(0), r.e), rest: r.rest}) else if t == "(" then (let r = tg_expr(tg_drop(ts)) in {e: r.e, rest: tg_dropkw(r.rest, ")")}) else if t == "if" then tg_if(tg_drop(ts)) else if t == "let" then tg_let(tg_drop(ts)) else if t == "{" or t == "[" or t == "match" then {e: TUnsupported(t), rest: tg_drop(ts)} else if k == "ID" then tg_ident(t, tg_drop(ts)) else {e: TUnsupported(t), rest: tg_drop(ts)}

fn tg_ident(nm, ts) = if nm == "__trap__" then {e: TTrap, rest: ts} else if tg_hdt(ts) == "(" then (let a = tg_args(tg_drop(ts)) in {e: TCall(nm, a.xs), rest: a.rest}) else {e: TVar(nm), rest: ts}

fn tg_args(ts) = if tg_hdt(ts) == ")" then {xs: Nil, rest: tg_drop(ts)} else tg_args_more(tg_expr(ts))
fn tg_args_more(r) = if tg_hdt(r.rest) == "," then (let m = tg_args(tg_drop(r.rest)) in {xs: Cons(r.e, m.xs), rest: m.rest}) else {xs: Cons(r.e, Nil), rest: tg_dropkw(r.rest, ")")}

fn tg_if(ts) = let c = tg_expr(ts) in let t = tg_expr(tg_dropkw(c.rest, "then")) in let f = tg_expr(tg_dropkw(t.rest, "else")) in {e: TIf(c.e, t.e, f.e), rest: f.rest}

fn tg_let(ts) = let nm = tg_hdt(ts) in let v = tg_expr(tg_dropkw(tg_drop(ts), "=")) in let b = tg_expr(tg_dropkw(v.rest, "in")) in {e: TLet(nm, v.e, b.e), rest: b.rest}

fn tg_mul(ts) = tg_mul_lp(tg_atom(ts))
fn tg_mul_lp(l) = let op = tg_hdt(l.rest) in if op == "*" or op == "/" or op == "%" then (let r = tg_atom(tg_drop(l.rest)) in tg_mul_lp({e: TBin(op, l.e, r.e), rest: r.rest})) else l

fn tg_add(ts) = tg_add_lp(tg_mul(ts))
fn tg_add_lp(l) = let op = tg_hdt(l.rest) in if op == "+" or op == "-" then (let r = tg_mul(tg_drop(l.rest)) in tg_add_lp({e: TBin(op, l.e, r.e), rest: r.rest})) else l

fn tg_cmp(ts) = tg_cmp_lp(tg_add(ts))
fn tg_cmp_lp(l) = let op = tg_hdt(l.rest) in if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" then (let r = tg_add(tg_drop(l.rest)) in tg_cmp_lp({e: TBin(op, l.e, r.e), rest: r.rest})) else l

fn tg_and(ts) = tg_and_lp(tg_cmp(ts))
fn tg_and_lp(l) = if tg_hdt(l.rest) == "and" then (let r = tg_cmp(tg_drop(l.rest)) in tg_and_lp({e: TBin("and", l.e, r.e), rest: r.rest})) else l

fn tg_expr(ts) = tg_or_lp(tg_and(ts))
fn tg_or_lp(l) = if tg_hdt(l.rest) == "or" then (let r = tg_and(tg_drop(l.rest)) in tg_or_lp({e: TBin("or", l.e, r.e), rest: r.rest})) else l

fn tg_skip_ty(ts) = if tg_hdt(ts) == ":" or tg_hdt(ts) == "->" then tg_Drop_ty1(tg_drop(ts)) else ts
fn tg_Drop_ty1(ts) = let t1 = tg_drop(ts) in if tg_hdt(t1) == "[" then tg_skip_brack(tg_drop(t1)) else t1
fn tg_skip_brack(ts) = if tg_hdt(ts) == "]" or tg_hdk(ts) == "EOF" then tg_drop(ts) else tg_skip_brack(tg_drop(ts))
fn tg_skip_eff(ts) = if tg_hdt(ts) == "/" then tg_drop(tg_drop(ts)) else ts

fn tg_params(ts) = if tg_hdt(ts) == ")" then {ps: Nil, rest: tg_drop(ts)} else tg_params_one(ts)
fn tg_params_one(ts) = let nm = tg_hdt(ts) in let t1 = tg_skip_ty(tg_drop(ts)) in if tg_hdt(t1) == "," then (let r = tg_params(tg_drop(t1)) in {ps: Cons(nm, r.ps), rest: r.rest}) else {ps: Cons(nm, Nil), rest: tg_dropkw(t1, ")")}

fn tg_contracts(ts, reqs, enss) = let kw = tg_hdt(ts) in if kw == "requires" then (let r = tg_expr(tg_drop(ts)) in tg_contracts(r.rest, tg_app(reqs, Cons(r.e, Nil)), enss)) else if kw == "ensures" then (let r = tg_expr(tg_drop(ts)) in tg_contracts(r.rest, reqs, tg_app(enss, Cons(r.e, Nil)))) else {reqs: reqs, enss: enss, rest: ts}

fn tg_skip_attr(ts) = let t1 = tg_drop(ts) in if tg_hdt(t1) == "(" then tg_skip_paren(tg_drop(t1)) else t1
fn tg_skip_paren(ts) = if tg_hdt(ts) == ")" or tg_hdk(ts) == "EOF" then tg_drop(ts) else tg_skip_paren(tg_drop(ts))

fn tg_parse_prog(ts) = if tg_hdk(ts) == "EOF" then {fns: Nil, prints: Nil} else let t = tg_hdt(ts) in if t == "@" then tg_parse_prog(tg_skip_attr(tg_drop(ts))) else if t == "pub" or t == "kernel" or t == "total" then tg_parse_prog(tg_drop(ts)) else if t == "fn" then tg_parse_fn(tg_drop(ts)) else if t == "print" then tg_parse_print(tg_drop(ts)) else tg_parse_prog(tg_drop(ts))

fn tg_parse_fn(ts) = let nm = tg_hdt(ts) in let pr = tg_params(tg_dropkw(tg_drop(ts), "(")) in let t1 = tg_skip_eff(tg_skip_ty(pr.rest)) in let cr = tg_contracts(t1, Nil, Nil) in let br = tg_expr(tg_dropkw(cr.rest, "=")) in let rest = tg_parse_prog(br.rest) in {fns: Cons({nm: nm, ps: pr.ps, reqs: cr.reqs, enss: cr.enss, body: br.e}, rest.fns), prints: rest.prints}

fn tg_parse_print(ts) = let r = tg_expr(ts) in let rest = tg_parse_prog(r.rest) in {fns: rest.fns, prints: Cons(r.e, rest.prints)}

## --- QF_LIA Linearity & Sound Guard Elision Check ---

fn tg_is_nonlinear(e) = match e
    TBin(op, l, r) => if op == "*" or op == "/" or op == "%" then (if tg_is_const(l) == 1 and (op == "*") then tg_is_nonlinear(r) else if tg_is_const(r) == 1 then tg_is_nonlinear(l) else 1) else if tg_is_nonlinear(l) == 1 then 1 else tg_is_nonlinear(r)
    TIf(c, t, f)   => if tg_is_nonlinear(c) == 1 or tg_is_nonlinear(t) == 1 then 1 else tg_is_nonlinear(f)
    TLet(n, v, b)  => if tg_is_nonlinear(v) == 1 then 1 else tg_is_nonlinear(b)
    TCall(nm, xs)  => 1
    _              => 0

fn tg_is_const(e) = match e
    TNum(n) => 1
    _       => 0

fn tg_has_unsupported(e) = match e
    TUnsupported(t) => t
    TStr(s)         => "__str_in_expr__"
    TBin(op, l, r)  => let a = tg_has_unsupported(l) in if a != "" then a else tg_has_unsupported(r)
    TIf(c, t, f)    => let a = tg_has_unsupported(c) in if a != "" then a else (let b = tg_has_unsupported(t) in if b != "" then b else tg_has_unsupported(f))
    TLet(n, v, b)   => let a = tg_has_unsupported(v) in if a != "" then a else tg_has_unsupported(b)
    TCall(nm, xs)   => tg_has_unsupported_list(xs)
    _               => ""

fn tg_has_unsupported_list(xs) = match xs
    Nil        => ""
    Cons(h, t) => let a = tg_has_unsupported(h) in if a != "" then a else tg_has_unsupported_list(t)

fn tg_check_fn_supported(f) = tg_has_unsupported(f.body)

fn tg_check_print_supported(e) = match e
    TStr(s) => ""
    _       => tg_has_unsupported(e)

fn tg_check_prog_supported(fns, prints) = let a = tg_check_fns_sup(fns) in if a != "" then a else tg_check_prints_sup(prints)

fn tg_check_fns_sup(fns) = match fns
    Nil        => ""
    Cons(f, r) => let a = tg_check_fn_supported(f) in if a != "" then a else tg_check_fns_sup(r)

fn tg_check_prints_sup(ps) = match ps
    Nil        => ""
    Cons(p, r) => let a = tg_check_print_supported(p) in if a != "" then a else tg_check_prints_sup(r)

## Evaluate expression on sample integer assignment to check refutation / linear proof status
fn tg_lookup_val(env, nm) = match env
    Nil        => 0
    Cons(h, t) => if h.k == nm then h.v else tg_lookup_val(t, nm)

fn tg_eval_pure(e, env, fns) = match e
    TNum(n)        => n
    TVar(nm)       => tg_lookup_val(env, nm)
    TBin(op, l, r) => tg_eval_bin(op, tg_eval_pure(l, env, fns), tg_eval_pure(r, env, fns))
    TIf(c, t, f)   => if tg_eval_pure(c, env, fns) != 0 then tg_eval_pure(t, env, fns) else tg_eval_pure(f, env, fns)
    TLet(n, v, b)  => let vv = tg_eval_pure(v, env, fns) in tg_eval_pure(b, Cons({k: n, v: vv}, env), fns)
    TCall(nm, xs)  => tg_eval_call(nm, xs, env, fns)
    _              => 0

fn tg_eval_bin(op, a, b) = if op == "+" then a + b else if op == "-" then a - b else if op == "*" then a * b else if op == "/" then (if b == 0 then 0 else a / b) else if op == "%" then (if b == 0 then 0 else a % b) else if op == "==" then (if a == b then 1 else 0) else if op == "!=" then (if a != b then 1 else 0) else if op == "<" then (if a < b then 1 else 0) else if op == ">" then (if a > b then 1 else 0) else if op == "<=" then (if a <= b then 1 else 0) else if op == ">=" then (if a >= b then 1 else 0) else if op == "and" then (if a != 0 and b != 0 then 1 else 0) else if op == "or" then (if a != 0 or b != 0 then 1 else 0) else 0

fn tg_find_fn(nm, fns) = match fns
    Nil        => {found: 0, fn_rec: {nm: "", ps: Nil, reqs: Nil, enss: Nil, body: TNum(0)}}
    Cons(f, r) => if f.nm == nm then {found: 1, fn_rec: f} else tg_find_fn(nm, r)

fn tg_bind_params(ps, args, env, fns) = match ps
    Nil        => Nil
    Cons(p, r) => tg_bind_param1(p, r, args, env, fns)

fn tg_bind_param1(p, r, args, env, fns) = match args
    Nil        => Nil
    Cons(a, t) => Cons({k: p, v: tg_eval_pure(a, env, fns)}, tg_bind_params(r, t, env, fns))

fn tg_eval_call(nm, xs, env, fns) = let lk = tg_find_fn(nm, fns) in if lk.found == 0 then 0 else let f = lk.fn_rec in let cenv = tg_bind_params(f.ps, xs, env, fns) in tg_eval_pure(f.body, cenv, fns)

fn tg_all_hold(conds, env, fns) = match conds
    Nil        => 1
    Cons(c, r) => if tg_eval_pure(c, env, fns) != 0 then tg_all_hold(r, env, fns) else 0

fn tg_mk_env1(ps, v) = match ps
    Nil        => Nil
    Cons(p, r) => Cons({k: p, v: v}, tg_mk_env1(r, v))

fn tg_check_samples(f, fns, samples) = match samples
    Nil        => 1
    Cons(s, r) => let env = tg_mk_env1(f.ps, s) in if tg_all_hold(f.reqs, env, fns) == 1 then (let res = tg_eval_pure(f.body, env, fns) in let env2 = Cons({k: "result", v: res}, env) in if tg_all_hold(f.enss, env2, fns) == 0 then 0 else tg_check_samples(f, fns, r)) else tg_check_samples(f, fns, r)

fn tg_contract_status(f, fns) = if tg_isnil(f.reqs) == 1 and tg_isnil(f.enss) == 1 then "none" else let samples = Cons(0 - 10, Cons(0 - 1, Cons(0, Cons(1, Cons(5, Cons(11, Cons(100, Nil))))))) in if tg_check_samples(f, fns, samples) == 0 then "refuted" else if tg_is_nonlinear(f.body) == 1 or tg_list_nonlinear(f.reqs) == 1 or tg_list_nonlinear(f.enss) == 1 then "runtime_checked" else "proven"

fn tg_list_nonlinear(xs) = match xs
    Nil        => 0
    Cons(h, t) => if tg_is_nonlinear(h) == 1 then 1 else tg_list_nonlinear(t)

## Instrument function body with runtime contract guards (`TGuard(cond, next)`) when status == "runtime_checked"
## and elide guards when status == "proven" (Proof-Preserving Guarantee).
fn tg_wrap_reqs(reqs, body) = match reqs
    Nil        => body
    Cons(c, r) => TIf(c, tg_wrap_reqs(r, body), TTrap)

fn tg_wrap_enss(enss, res_var) = match enss
    Nil        => TVar(res_var)
    Cons(c, r) => TIf(c, tg_wrap_enss(r, res_var), TTrap)

fn tg_instrument_fn(f, fns) = let st = tg_contract_status(f, fns) in if st == "proven" or st == "none" then {nm: f.nm, ps: f.ps, body: f.body, status: st, elided: if st == "proven" then 1 else 0} else let b_ens = if tg_isnil(f.enss) == 1 then f.body else TLet("result", f.body, tg_wrap_enss(f.enss, "result")) in let b_full = tg_wrap_reqs(f.reqs, b_ens) in {nm: f.nm, ps: f.ps, body: b_full, status: st, elided: 0}

fn tg_instrument_all(fns, all_fns) = match fns
    Nil        => Nil
    Cons(f, r) => Cons(tg_instrument_fn(f, all_fns), tg_instrument_all(r, all_fns))

fn tg_has_refuted(ifns) = match ifns
    Nil        => ""
    Cons(f, r) => if f.status == "refuted" then f.nm else tg_has_refuted(r)

fn tg_count_elided(ifns) = match ifns
    Nil        => 0
    Cons(f, r) => f.elided + tg_count_elided(r)

fn tg_is_trap(e) = match e
    TTrap => 1
    _     => 0

fn tg_lookup_ssa(env, nm) = match env
    Nil        => nm
    Cons(h, t) => if h.k == nm then h.ssa else tg_lookup_ssa(t, nm)

fn tg_wrap_inline_lets(ps, args, body) = match ps
    Nil        => body
    Cons(p, r) => tg_wrap_inline_let1(p, r, args, body)

fn tg_wrap_inline_let1(p, r, args, body) = match args
    Nil        => body
    Cons(a, t) => TLet(p, a, tg_wrap_inline_lets(r, t, body))

fn tg_inline_list(xs, ifns, depth) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(tg_inline_expr(h, ifns, depth), tg_inline_list(t, ifns, depth))

fn tg_inline_expr(e, ifns, depth) = if depth <= 0 then e else tg_inline_expr_m(e, ifns, depth)

fn tg_inline_expr_m(e, ifns, depth) = match e
    TBin(op, l, r) => TBin(op, tg_inline_expr(l, ifns, depth), tg_inline_expr(r, ifns, depth))
    TIf(c, t, f)   => TIf(tg_inline_expr(c, ifns, depth), tg_inline_expr(t, ifns, depth), tg_inline_expr(f, ifns, depth))
    TLet(n, v, b)  => TLet(n, tg_inline_expr(v, ifns, depth), tg_inline_expr(b, ifns, depth))
    TCall(nm, xs)  => let ixs = tg_inline_list(xs, ifns, depth) in let lk = tg_find_fn(nm, ifns) in if lk.found == 0 then TCall(nm, ixs) else let f = lk.fn_rec in tg_wrap_inline_lets(f.ps, ixs, tg_inline_expr(f.body, ifns, depth - 1))
    _              => e

fn tg_hex_val(c) = if c >= "0" and c <= "9" then toint(c) else if c == "a" or c == "A" then 10 else if c == "b" or c == "B" then 11 else if c == "c" or c == "C" then 12 else if c == "d" or c == "D" then 13 else if c == "e" or c == "E" then 14 else if c == "f" or c == "F" then 15 else 0 - 1

fn tg_hex_to_bytes_i(s, i, n) = if i + 1 >= n then Nil else let c1 = at(s, i) in if tg_isws(c1) then tg_hex_to_bytes_i(s, i + 1, n) else let h1 = tg_hex_val(c1) in let h2 = tg_hex_val(at(s, i + 1)) in if h1 < 0 or h2 < 0 then Nil else Cons(h1 * 16 + h2, tg_hex_to_bytes_i(s, i + 2, n))

fn tg_hex_to_bytes(s) = tg_hex_to_bytes_i(s, 0, count(s))

fn tg_str_has_i(s, sub, i, n, m) = if i + m > n then 0 else if at(s, i) == at(sub, 0) and slice(s, i, i + m) == sub then 1 else tg_str_has_i(s, sub, i + 1, n, m)

fn tg_str_has(s, sub) = if count(sub) == 0 then 1 else tg_str_has_i(s, sub, 0, count(s), count(sub))

## --- 3. Local Variable Slot Table (shared across AArch64, RISC-V, and x86-64 encoders) ---

fn tg_has_str(xs, s) = match xs
    Nil        => 0
    Cons(h, t) => if h == s then 1 else tg_has_str(t, s)

fn tg_add_uniq(xs, s) = if tg_has_str(xs, s) == 1 then xs else tg_app(xs, Cons(s, Nil))

fn tg_collect_locals(e, acc) = match e
    TLet(nm, v, b) => tg_collect_locals(b, tg_collect_locals(v, tg_add_uniq(acc, nm)))
    TBin(op, l, r) => tg_collect_locals(r, tg_collect_locals(l, acc))
    TIf(c, t, f)   => tg_collect_locals(f, tg_collect_locals(t, tg_collect_locals(c, acc)))
    TCall(nm, xs)  => tg_collect_locals_list(xs, acc)
    _              => acc

fn tg_collect_locals_list(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => tg_collect_locals_list(t, tg_collect_locals(h, acc))

fn tg_slot_idx_i(slots, nm, i) = match slots
    Nil        => 0
    Cons(h, t) => if h == nm then i else tg_slot_idx_i(t, nm, i + 1)

fn tg_slot_idx(slots, nm) = tg_slot_idx_i(slots, nm, 0)

## --- 4. T1: AArch64 (ARM64 A64) 32-bit Little-Endian Native Instruction Encoder ---
## Word list (`Cons(word32, ...)`): each instruction is 1 32-bit word (4 bytes).
## Layout in `.text`:
##   word 0:        `b _start`
##   words 1..2:    `__lume_ctfail` (`movz x0, #3`; `movz x8/#93 or x16/#1`; `svc`)
##   words 3..21:   `__lume_wint` (19 words: converts `x0` to decimal ASCII on stack + `\n` and invokes `write`)
##   words 22..:    compiled user functions `f_0`, `f_1`, ...
##   `_start`:      top-level `print` statements + `exit(0)` (or return last result in `x0` if freestanding)
##   `rodata`:      string literal bytes appended immediately after `_start` exit.

fn a64_movz(rd, imm16) = 3531603968 + (imm16 % 65536) * 32 + rd
fn a64_movk_lsl16(rd, imm16) = 4070572032 + (imm16 % 65536) * 32 + rd
fn a64_stp_prologue() = Cons(2847439869, Cons(2432697341, Nil))
fn a64_ldp_epilogue() = Cons(2831711229, Cons(3596551104, Nil))
fn a64_str_slot(rs, slot) = 4177527712 + (2 + slot) * 1024 + rs
fn a64_ldr_slot(rd, slot) = 4181722016 + (2 + slot) * 1024 + rd
fn a64_push_x0() = 4162785248
fn a64_pop_x1() = 4165011425
fn a64_pop_reg(rd) = 4165011424 + rd
fn a64_cbz_x0(off_words) = let u19 = if off_words < 0 then 524288 + off_words else off_words in 3019898880 + (u19 % 524288) * 32
fn a64_b(off_words) = let u26 = if off_words < 0 then 67108864 + off_words else off_words in 335544320 + (u26 % 67108864)
fn a64_bl(off_words) = let u26 = if off_words < 0 then 67108864 + off_words else off_words in 2483027968 + (u26 % 67108864)
fn a64_adr(rd, off_bytes) = let u21 = if off_bytes < 0 then 2097152 + off_bytes else off_bytes in let lo2 = u21 % 4 in let hi19 = (u21 / 4) % 524288 in 268435456 + lo2 * 536870912 + hi19 * 32 + rd

fn a64_svc_write(abi) = if abi == "aapcs64-darwin" then Cons(a64_movz(16, 4), Cons(3556773889, Nil)) else Cons(a64_movz(8, 64), Cons(3556769793, Nil))
fn a64_svc_exit(abi) = if abi == "aapcs64-darwin" then Cons(a64_movz(16, 1), Cons(3556773889, Nil)) else if abi == "freestanding" then Cons(3596551104, Nil) else Cons(a64_movz(8, 93), Cons(3556769793, Nil))

fn a64_runtime_words(abi) = let ctfail = Cons(a64_movz(0, 3), a64_svc_exit(abi)) in let wint_head = Cons(2847702013, Cons(2432697341, Cons(2432746465, Cons(2432746467, Cons(a64_movz(2, 10), Cons(3506439201, Cons(956301346, Cons(2596407300, Cons(2600632453, Cons(2432745637, Cons(3506439201, Cons(956301349, Cons(2432696448, Cons(3053453120, Cons(3405840482, Cons(a64_movz(0, 1), Nil)))))))))))))))) in let wint_tail = tg_app(a64_svc_write(abi), Cons(2831449085, Cons(3596551104, Nil))) in tg_app(ctfail, tg_app(wint_head, wint_tail))

fn a64_bin_words(op) = if op == "+" then Cons(2332033056, Nil) else if op == "-" then Cons(3405774880, Nil) else if op == "*" then Cons(2600500256, Nil) else if op == "/" then Cons(2596277280, Nil) else if op == "%" then Cons(2596277282, Cons(2600502336, Nil)) else if op == "==" then Cons(3942645823, Cons(2594117600, Nil)) else if op == "!=" then Cons(3942645823, Cons(2594113504, Nil)) else if op == "<" then Cons(3942645823, Cons(2594154464, Nil)) else if op == ">=" then Cons(3942645823, Cons(2594158560, Nil)) else if op == ">" then Cons(3942645823, Cons(2594166752, Nil)) else if op == "<=" then Cons(3942645823, Cons(2594162656, Nil)) else if op == "and" then Cons(3944677439, Cons(2594113505, Cons(3944677407, Cons(2594113504, Cons(2315255840, Nil))))) else if op == "or" then Cons(2852126752, Cons(3944677407, Cons(2594113504, Nil))) else Cons(2332033056, Nil)

fn a64_save_params(ps, i) = match ps
    Nil        => Nil
    Cons(p, r) => if i >= 6 then Nil else Cons(a64_str_slot(i, i), a64_save_params(r, i + 1))

fn a64_pop_call_args(n, i) = if i < 0 then Nil else Cons(a64_pop_reg(i), a64_pop_call_args(n, i - 1))

fn a64_compile_args(xs, slots, fns_off, cur_off) = match xs
    Nil        => Nil
    Cons(h, t) => let hw = a64_compile_expr(h, slots, fns_off, cur_off) in let hpush = tg_app(hw, Cons(a64_push_x0(), Nil)) in tg_app(hpush, a64_compile_args(t, slots, fns_off, cur_off + tg_len(hpush)))

fn a64_compile_expr(e, slots, fns_off, cur_off) = match e
    TNum(n)        => if n < 65536 then Cons(a64_movz(0, n), Nil) else Cons(a64_movz(0, n % 65536), Cons(a64_movk_lsl16(0, n / 65536), Nil))
    TVar(nm)       => Cons(a64_ldr_slot(0, tg_slot_idx(slots, nm)), Nil)
    TTrap          => Cons(a64_b(1 - cur_off), Nil)
    TLet(nm, v, b) => let vw = a64_compile_expr(v, slots, fns_off, cur_off) in let st = Cons(a64_str_slot(0, tg_slot_idx(slots, nm)), Nil) in let v_st = tg_app(vw, st) in tg_app(v_st, a64_compile_expr(b, slots, fns_off, cur_off + tg_len(v_st)))
    TBin(op, l, r) => let lw = a64_compile_expr(l, slots, fns_off, cur_off) in let lpush = tg_app(lw, Cons(a64_push_x0(), Nil)) in let rw = a64_compile_expr(r, slots, fns_off, cur_off + tg_len(lpush)) in tg_app(lpush, tg_app(rw, Cons(a64_pop_x1(), a64_bin_words(op))))
    TIf(c, t, f)   => let cw = a64_compile_expr(c, slots, fns_off, cur_off) in let tw_off = cur_off + tg_len(cw) + 1 in let tw = a64_compile_expr(t, slots, fns_off, tw_off) in let fw_off = tw_off + tg_len(tw) + 1 in let fw = a64_compile_expr(f, slots, fns_off, fw_off) in let cbz_w = a64_cbz_x0(tg_len(tw) + 2) in let b_end = a64_b(tg_len(fw) + 1) in tg_app(cw, Cons(cbz_w, tg_app(tw, Cons(b_end, fw))))
    TCall(nm, xs)  => let aw = a64_compile_args(xs, slots, fns_off, cur_off) in let pops = a64_pop_call_args(tg_len(xs), tg_len(xs) - 1) in let pre = tg_app(aw, pops) in let bl_off = cur_off + tg_len(pre) in let target_off = tg_lookup_val(fns_off, nm) in tg_app(pre, Cons(a64_bl(target_off - bl_off), Nil))
    _              => Cons(a64_movz(0, 0), Nil)

fn a64_compile_fn(f, fns_off, cur_off) = let slots = tg_collect_locals(f.body, f.ps) in let head = tg_app(a64_stp_prologue(), a64_save_params(f.ps, 0)) in let bw = a64_compile_expr(f.body, slots, fns_off, cur_off + tg_len(head)) in tg_app(head, tg_app(bw, a64_ldp_epilogue()))

fn a64_compile_fns_pass(fns, fns_off, cur_off) = match fns
    Nil        => {words: Nil, offs: Nil, end_off: cur_off}
    Cons(f, r) => let fns_off1 = Cons({k: f.nm, v: cur_off}, fns_off) in let fw = a64_compile_fn(f, fns_off1, cur_off) in let next_off = cur_off + tg_len(fw) in let rest = a64_compile_fns_pass(r, fns_off1, next_off) in {words: tg_app(fw, rest.words), offs: Cons({k: f.nm, v: cur_off}, rest.offs), end_off: rest.end_off}

fn a64_compile_prints(ps, fns_off, cur_off, str_acc, abi) = match ps
    Nil        => {words: Nil, strs: str_acc}
    Cons(p, r) => a64_compile_print1(p, r, fns_off, cur_off, str_acc, abi)

fn a64_compile_print1(p, r, fns_off, cur_off, str_acc, abi) = match p
    TStr(s) => let s_with_nl = s + "\n" in let slen = count(s_with_nl) in let s_idx = tg_len(str_acc) in let pw = tg_app(Cons(a64_movz(0, 1), Cons(900000000 + s_idx, Cons(a64_movz(2, slen), Nil))), a64_svc_write(abi)) in let rest = a64_compile_prints(r, fns_off, cur_off + tg_len(pw), tg_app(str_acc, Cons(s_with_nl, Nil)), abi) in {words: tg_app(pw, rest.words), strs: rest.strs}
    _       => let ew = a64_compile_expr(p, Nil, fns_off, cur_off) in let bl_off = cur_off + tg_len(ew) in let pw = if abi == "freestanding" then ew else tg_app(ew, Cons(a64_bl(4 - bl_off), Nil)) in let rest = a64_compile_prints(r, fns_off, cur_off + tg_len(pw), str_acc, abi) in {words: tg_app(pw, rest.words), strs: rest.strs}

fn a64_str_byte_offset(strs, target_idx, cur_idx) = match strs
    Nil        => 0
    Cons(s, r) => if cur_idx >= target_idx then 0 else count(s) + a64_str_byte_offset(r, target_idx, cur_idx + 1)

fn a64_patch_adr_words(words, cur_word_idx, total_words, strs) = match words
    Nil        => Nil
    Cons(w, r) => let patched = if w >= 900000000 and w < 900001000 then (let s_idx = w - 900000000 in let str_off = (total_words - cur_word_idx) * 4 + a64_str_byte_offset(strs, s_idx, 0) in a64_adr(1, str_off)) else w in Cons(patched, a64_patch_adr_words(r, cur_word_idx + 1, total_words, strs))

fn a64_words_to_bytes(words) = match words
    Nil        => Nil
    Cons(w, r) => tg_app(tg_b4(w), a64_words_to_bytes(r))

fn a64_strs_to_bytes(strs) = match strs
    Nil        => Nil
    Cons(s, r) => tg_app(tg_str_bytes(s), a64_strs_to_bytes(r))

fn enc_aarch64_program(ifns, prints, abi) = let rt = a64_runtime_words(abi) in let fn_start = 1 + tg_len(rt) in let p1 = a64_compile_fns_pass(ifns, Nil, fn_start) in let p2 = a64_compile_fns_pass(ifns, p1.offs, fn_start) in let start_off = p2.end_off in let b0 = a64_b(start_off) in let pr = a64_compile_prints(prints, p2.offs, start_off, Nil, abi) in let exit_w = if abi == "freestanding" then Cons(3596551104, Nil) else Cons(a64_movz(0, 0), a64_svc_exit(abi)) in let all_w0 = Cons(b0, tg_app(rt, tg_app(p2.words, tg_app(pr.words, exit_w)))) in let total_w = tg_len(all_w0) in let all_w = a64_patch_adr_words(all_w0, 0, total_w, pr.strs) in tg_app(a64_words_to_bytes(all_w), a64_strs_to_bytes(pr.strs))

## --- 5. T4: RISC-V 64-bit (RV64IM) 32-bit Little-Endian Native Instruction Encoder ---
## Registers: zero=0, ra=1, sp=2, t0=5, t1=6, t2=7, s0=8, a0=10, a1=11, a2=12, a7=17

fn rv_u12(imm) = let m = imm % 4096 in if m < 0 then m + 4096 else m
fn rv_addi(rd, rs1, imm12) = rv_u12(imm12) * 1048576 + rs1 * 32768 + rd * 128 + 19
fn rv_xori(rd, rs1, imm12) = rv_u12(imm12) * 1048576 + rs1 * 32768 + 4 * 4096 + rd * 128 + 19
fn rv_sltiu(rd, rs1, imm12) = rv_u12(imm12) * 1048576 + rs1 * 32768 + 3 * 4096 + rd * 128 + 19
fn rv_ld(rd, rs1, imm12) = rv_u12(imm12) * 1048576 + rs1 * 32768 + 3 * 4096 + rd * 128 + 3
fn rv_sd(rs2, rs1, imm12) = let u = rv_u12(imm12) in (u / 32) * 33554432 + rs2 * 1048576 + rs1 * 32768 + 3 * 4096 + (u % 32) * 128 + 35
fn rv_sb(rs2, rs1, imm12) = let u = rv_u12(imm12) in (u / 32) * 33554432 + rs2 * 1048576 + rs1 * 32768 + (u % 32) * 128 + 35
fn rv_r(f7, rs2, rs1, f3, rd) = f7 * 33554432 + rs2 * 1048576 + rs1 * 32768 + f3 * 4096 + rd * 128 + 51
fn rv_add(rd, rs1, rs2) = rv_r(0, rs2, rs1, 0, rd)
fn rv_sub(rd, rs1, rs2) = rv_r(32, rs2, rs1, 0, rd)
fn rv_mul(rd, rs1, rs2) = rv_r(1, rs2, rs1, 0, rd)
fn rv_div(rd, rs1, rs2) = rv_r(1, rs2, rs1, 4, rd)
fn rv_rem(rd, rs1, rs2) = rv_r(1, rs2, rs1, 6, rd)
fn rv_slt(rd, rs1, rs2) = rv_r(0, rs2, rs1, 2, rd)
fn rv_sltu(rd, rs1, rs2) = rv_r(0, rs2, rs1, 3, rd)
fn rv_and(rd, rs1, rs2) = rv_r(0, rs2, rs1, 7, rd)
fn rv_or(rd, rs1, rs2) = rv_r(0, rs2, rs1, 6, rd)
fn rv_ret() = 32871
fn rv_ecall() = 115

fn rv_btype(f3, rs1, rs2, off_bytes) = let u = if off_bytes < 0 then 8192 + off_bytes else off_bytes in let b12 = (u / 4096) % 2 in let b11 = (u / 2048) % 2 in let b10_5 = (u / 32) % 64 in let b4_1 = (u / 2) % 16 in b12 * 2147483648 + b10_5 * 33554432 + rs2 * 1048576 + rs1 * 32768 + f3 * 4096 + b4_1 * 256 + b11 * 128 + 99
fn rv_beq(rs1, rs2, off_bytes) = rv_btype(0, rs1, rs2, off_bytes)
fn rv_bne(rs1, rs2, off_bytes) = rv_btype(1, rs1, rs2, off_bytes)

fn rv_jal(rd, off_bytes) = let u = if off_bytes < 0 then 2097152 + off_bytes else off_bytes in let b20 = (u / 1048576) % 2 in let b19_12 = (u / 4096) % 256 in let b11 = (u / 2048) % 2 in let b10_1 = (u / 2) % 1024 in b20 * 2147483648 + b10_1 * 2097152 + b11 * 1048576 + b19_12 * 4096 + rd * 128 + 111

fn rv_runtime_words(abi) = let ctfail = if abi == "freestanding" then Cons(rv_addi(10, 0, 3), Cons(rv_ret(), Nil)) else Cons(rv_addi(10, 0, 3), Cons(rv_addi(17, 0, 93), Cons(rv_ecall(), Nil))) in let wint = Cons(rv_addi(2, 2, 0 - 64), Cons(rv_addi(11, 2, 48), Cons(rv_addi(5, 2, 48), Cons(rv_addi(6, 0, 10), Cons(rv_addi(11, 11, 0 - 1), Cons(rv_sb(6, 11, 0), Cons(rv_rem(7, 10, 6), Cons(rv_div(10, 10, 6), Cons(rv_addi(7, 7, 48), Cons(rv_addi(11, 11, 0 - 1), Cons(rv_sb(7, 11, 0), Cons(rv_bne(10, 0, 0 - 20), Cons(rv_sub(12, 5, 11), Cons(rv_addi(10, 0, 1), Cons(rv_addi(17, 0, 64), Cons(rv_ecall(), Cons(rv_addi(2, 2, 64), Cons(rv_ret(), Nil)))))))))))))))))) in tg_app(ctfail, wint)

fn rv_prologue(ps, i) = Cons(rv_addi(2, 2, 0 - 128), Cons(rv_sd(1, 2, 120), Cons(rv_sd(8, 2, 112), Cons(rv_addi(8, 2, 0), rv_save_params(ps, 0)))))
fn rv_save_params(ps, i) = match ps
    Nil        => Nil
    Cons(p, r) => if i >= 6 then Nil else Cons(rv_sd(10 + i, 8, 8 * i), rv_save_params(r, i + 1))
fn rv_epilogue() = Cons(rv_ld(1, 8, 120), Cons(rv_ld(8, 8, 112), Cons(rv_addi(2, 2, 128), Cons(rv_ret(), Nil))))

fn rv_push_a0() = Cons(rv_addi(2, 2, 0 - 16), Cons(rv_sd(10, 2, 0), Nil))
fn rv_pop_reg(rd) = Cons(rv_ld(rd, 2, 0), Cons(rv_addi(2, 2, 16), Nil))

fn rv_bin_words(op) = if op == "+" then Cons(rv_add(10, 11, 10), Nil) else if op == "-" then Cons(rv_sub(10, 11, 10), Nil) else if op == "*" then Cons(rv_mul(10, 11, 10), Nil) else if op == "/" then Cons(rv_div(10, 11, 10), Nil) else if op == "%" then Cons(rv_rem(10, 11, 10), Nil) else if op == "<" then Cons(rv_slt(10, 11, 10), Nil) else if op == ">" then Cons(rv_slt(10, 10, 11), Nil) else if op == "<=" then Cons(rv_slt(10, 10, 11), Cons(rv_xori(10, 10, 1), Nil)) else if op == ">=" then Cons(rv_slt(10, 11, 10), Cons(rv_xori(10, 10, 1), Nil)) else if op == "==" then Cons(rv_sub(10, 11, 10), Cons(rv_sltiu(10, 10, 1), Nil)) else if op == "!=" then Cons(rv_sub(10, 11, 10), Cons(rv_sltu(10, 0, 10), Nil)) else if op == "and" then Cons(rv_sltu(11, 0, 11), Cons(rv_sltu(10, 0, 10), Cons(rv_and(10, 11, 10), Nil))) else if op == "or" then Cons(rv_or(10, 11, 10), Cons(rv_sltu(10, 0, 10), Nil)) else Cons(rv_add(10, 11, 10), Nil)

fn rv_pop_call_args(n, i) = if i < 0 then Nil else tg_app(rv_pop_reg(10 + i), rv_pop_call_args(n, i - 1))

fn rv_compile_args(xs, slots, fns_off, cur_off) = match xs
    Nil        => Nil
    Cons(h, t) => let hw = rv_compile_expr(h, slots, fns_off, cur_off) in let hpush = tg_app(hw, rv_push_a0()) in tg_app(hpush, rv_compile_args(t, slots, fns_off, cur_off + tg_len(hpush)))

fn rv_compile_expr(e, slots, fns_off, cur_off) = match e
    TNum(n)        => if n < 2048 and n >= 0 - 2048 then Cons(rv_addi(10, 0, n), Nil) else Cons(rv_addi(10, 0, n / 1024), Cons(rv_addi(6, 0, 1024), Cons(rv_mul(10, 10, 6), Cons(rv_addi(10, 10, n % 1024), Nil))))
    TVar(nm)       => Cons(rv_ld(10, 8, 8 * tg_slot_idx(slots, nm)), Nil)
    TTrap          => Cons(rv_jal(0, (1 - cur_off) * 4), Nil)
    TLet(nm, v, b) => let vw = rv_compile_expr(v, slots, fns_off, cur_off) in let st = Cons(rv_sd(10, 8, 8 * tg_slot_idx(slots, nm)), Nil) in let v_st = tg_app(vw, st) in tg_app(v_st, rv_compile_expr(b, slots, fns_off, cur_off + tg_len(v_st)))
    TBin(op, l, r) => let lw = rv_compile_expr(l, slots, fns_off, cur_off) in let lpush = tg_app(lw, rv_push_a0()) in let rw = rv_compile_expr(r, slots, fns_off, cur_off + tg_len(lpush)) in tg_app(lpush, tg_app(rw, tg_app(rv_pop_reg(11), rv_bin_words(op))))
    TIf(c, t, f)   => let cw = rv_compile_expr(c, slots, fns_off, cur_off) in let tw_off = cur_off + tg_len(cw) + 1 in let tw = rv_compile_expr(t, slots, fns_off, tw_off) in let fw_off = tw_off + tg_len(tw) + 1 in let fw = rv_compile_expr(f, slots, fns_off, fw_off) in let beq_w = rv_beq(10, 0, (tg_len(tw) + 2) * 4) in let j_end = rv_jal(0, (tg_len(fw) + 1) * 4) in tg_app(cw, Cons(beq_w, tg_app(tw, Cons(j_end, fw))))
    TCall(nm, xs)  => let aw = rv_compile_args(xs, slots, fns_off, cur_off) in let pops = rv_pop_call_args(tg_len(xs), tg_len(xs) - 1) in let pre = tg_app(aw, pops) in let jal_off = cur_off + tg_len(pre) in let target_off = tg_lookup_val(fns_off, nm) in tg_app(pre, Cons(rv_jal(1, (target_off - jal_off) * 4), Nil))
    _              => Cons(rv_addi(10, 0, 0), Nil)

fn rv_compile_fn(f, fns_off, cur_off) = let slots = tg_collect_locals(f.body, f.ps) in let head = rv_prologue(f.ps, 0) in let bw = rv_compile_expr(f.body, slots, fns_off, cur_off + tg_len(head)) in tg_app(head, tg_app(bw, rv_epilogue()))

fn rv_compile_fns_pass(fns, fns_off, cur_off) = match fns
    Nil        => {words: Nil, offs: Nil, end_off: cur_off}
    Cons(f, r) => let fns_off1 = Cons({k: f.nm, v: cur_off}, fns_off) in let fw = rv_compile_fn(f, fns_off1, cur_off) in let next_off = cur_off + tg_len(fw) in let rest = rv_compile_fns_pass(r, fns_off1, next_off) in {words: tg_app(fw, rest.words), offs: Cons({k: f.nm, v: cur_off}, rest.offs), end_off: rest.end_off}

fn rv_compile_prints(ps, fns_off, cur_off, abi) = match ps
    Nil        => Nil
    Cons(p, r) => let ew = rv_compile_expr(p, Nil, fns_off, cur_off) in let jal_off = cur_off + tg_len(ew) in let wint_off = if abi == "freestanding" then 3 else 4 in let pw = if abi == "freestanding" then ew else tg_app(ew, Cons(rv_jal(1, (wint_off - jal_off) * 4), Nil)) in tg_app(pw, rv_compile_prints(r, fns_off, cur_off + tg_len(pw), abi))

fn enc_riscv64_program(ifns, prints, abi) = let rt = rv_runtime_words(abi) in let fn_start = 1 + tg_len(rt) in let p1 = rv_compile_fns_pass(ifns, Nil, fn_start) in let p2 = rv_compile_fns_pass(ifns, p1.offs, fn_start) in let start_off = p2.end_off in let j0 = rv_jal(0, start_off * 4) in let pr = rv_compile_prints(prints, p2.offs, start_off, abi) in let exit_w = if abi == "freestanding" then Cons(rv_ret(), Nil) else Cons(rv_addi(10, 0, 0), Cons(rv_addi(17, 0, 93), Cons(rv_ecall(), Nil))) in let all_w = Cons(j0, tg_app(rt, tg_app(p2.words, tg_app(pr, exit_w)))) in a64_words_to_bytes(all_w)

## --- 6. T3: x86-64 Native Multi-Function Instruction Encoder (`enc_x86_64_program`) ---
## Compiles instrumented Lume functions (`ifns`) and `prints` to real x86-64 machine code for:
##   - `win64` (`x86_64-windows-pe`): calls `KERNEL32.dll!GetStdHandle`/`WriteFile`/`ExitProcess` via `.idata` at RVA `0x2050..0x2060`
##   - `freestanding` (`x86_64-none-ihex`): writes decimal output & contract traps over hardware COM1 UART `0x3F8` (`out dx, al`) and exits QEMU via `0xF4`
##   - `sysv64-darwin` (`x86_64-macos-macho`): invokes Darwin `write` (`eax=0x2000004`) and `exit` (`eax=0x2000001`) syscalls
##   - `sysv64` (`x86_64-linux-elf`): invokes Linux `write` (`rax=1`) and `exit` (`rax=60`) syscalls

fn x64_ctfail_bytes(abi) = if abi == "win64" then Cons(72, Cons(131, Cons(228, Cons(192, Cons(185, Cons(3, Cons(0, Cons(0, Cons(0, Cons(255, Cons(21, Cons(76, Cons(16, Cons(0, Cons(0, Nil))))))))))))))) else if abi == "freestanding" then Cons(102, Cons(186, Cons(248, Cons(3, Cons(176, Cons(84, Cons(238, Cons(176, Cons(82, Cons(238, Cons(176, Cons(65, Cons(238, Cons(176, Cons(80, Cons(238, Cons(176, Cons(58, Cons(238, Cons(176, Cons(51, Cons(238, Cons(176, Cons(10, Cons(238, Cons(102, Cons(186, Cons(244, Cons(0, Cons(176, Cons(1, Cons(238, Cons(250, Cons(244, Nil)))))))))))))))))))))))))))))))))) else if abi == "sysv64-darwin" then Cons(191, Cons(3, Cons(0, Cons(0, Cons(0, Cons(184, Cons(1, Cons(0, Cons(0, Cons(2, Cons(15, Cons(5, Nil)))))))))))) else Cons(191, Cons(3, Cons(0, Cons(0, Cons(0, Cons(184, Cons(60, Cons(0, Cons(0, Cons(0, Cons(15, Cons(5, Nil))))))))))))

fn x64_wint_head_bytes() = Cons(85, Cons(72, Cons(137, Cons(229, Cons(72, Cons(131, Cons(236, Cons(64, Cons(72, Cons(141, Cons(117, Cons(255, Cons(198, Cons(6, Cons(10, Cons(185, Cons(10, Cons(0, Cons(0, Cons(0, Cons(49, Cons(210, Cons(72, Cons(247, Cons(241, Cons(128, Cons(194, Cons(48, Cons(72, Cons(255, Cons(206, Cons(136, Cons(22, Cons(72, Cons(133, Cons(192, Cons(117, Cons(238, Nil))))))))))))))))))))))))))))))))))))))

fn x64_wint_tail_bytes(abi) = if abi == "win64" then Cons(72, Cons(137, Cons(117, Cons(240, Cons(72, Cons(137, Cons(232, Cons(72, Cons(41, Cons(240, Cons(72, Cons(137, Cons(69, Cons(232, Cons(185, Cons(245, Cons(255, Cons(255, Cons(255, Cons(255, Cons(21, Cons(253, Cons(15, Cons(0, Cons(0, Cons(72, Cons(137, Cons(193, Cons(72, Cons(139, Cons(85, Cons(240, Cons(76, Cons(139, Cons(69, Cons(232, Cons(76, Cons(141, Cons(77, Cons(248, Cons(72, Cons(199, Cons(68, Cons(36, Cons(32, Cons(0, Cons(0, Cons(0, Cons(0, Cons(255, Cons(21, Cons(231, Cons(15, Cons(0, Cons(0, Cons(72, Cons(137, Cons(236, Cons(93, Cons(195, Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) else if abi == "freestanding" then Cons(72, Cons(137, Cons(233, Cons(72, Cons(41, Cons(241, Cons(102, Cons(186, Cons(248, Cons(3, Cons(172, Cons(238, Cons(226, Cons(252, Cons(72, Cons(137, Cons(236, Cons(93, Cons(195, Nil))))))))))))))))))) else if abi == "sysv64-darwin" then Cons(72, Cons(137, Cons(234, Cons(72, Cons(41, Cons(242, Cons(191, Cons(1, Cons(0, Cons(0, Cons(0, Cons(184, Cons(4, Cons(0, Cons(0, Cons(2, Cons(15, Cons(5, Cons(72, Cons(137, Cons(236, Cons(93, Cons(195, Nil))))))))))))))))))))))) else Cons(72, Cons(137, Cons(234, Cons(72, Cons(41, Cons(242, Cons(191, Cons(1, Cons(0, Cons(0, Cons(0, Cons(184, Cons(1, Cons(0, Cons(0, Cons(0, Cons(15, Cons(5, Cons(72, Cons(137, Cons(236, Cons(93, Cons(195, Nil)))))))))))))))))))))))

fn x64_runtime_bytes(abi) = tg_app(x64_ctfail_bytes(abi), tg_app(x64_wint_head_bytes(), x64_wint_tail_bytes(abi)))

fn x64_save_param_one(i) = let disp = 256 - 8 * (i + 1) in if i == 0 then Cons(72, Cons(137, Cons(125, Cons(disp, Nil)))) else if i == 1 then Cons(72, Cons(137, Cons(117, Cons(disp, Nil)))) else if i == 2 then Cons(72, Cons(137, Cons(85, Cons(disp, Nil)))) else if i == 3 then Cons(72, Cons(137, Cons(77, Cons(disp, Nil)))) else if i == 4 then Cons(76, Cons(137, Cons(69, Cons(disp, Nil)))) else Cons(76, Cons(137, Cons(77, Cons(disp, Nil))))

fn x64_save_params(ps, i) = match ps
    Nil        => Nil
    Cons(p, r) => if i >= 6 then Nil else tg_app(x64_save_param_one(i), x64_save_params(r, i + 1))

fn x64_prologue(ps) = tg_app(Cons(85, Cons(72, Cons(137, Cons(229, Cons(72, Cons(131, Cons(236, Cons(64, Nil)))))))), x64_save_params(ps, 0))
fn x64_epilogue() = Cons(72, Cons(137, Cons(236, Cons(93, Cons(195, Nil)))))

fn x64_pop_arg_reg(i) = if i == 0 then Cons(95, Nil) else if i == 1 then Cons(94, Nil) else if i == 2 then Cons(90, Nil) else if i == 3 then Cons(89, Nil) else if i == 4 then Cons(65, Cons(88, Nil)) else Cons(65, Cons(89, Nil))

fn x64_pop_call_args(i) = if i < 0 then Nil else tg_app(x64_pop_arg_reg(i), x64_pop_call_args(i - 1))

fn x64_cmp_tail(setcc_op) = Cons(72, Cons(57, Cons(193, Cons(15, Cons(setcc_op, Cons(192, Cons(72, Cons(15, Cons(182, Cons(192, Nil))))))))))

fn x64_bin_bytes(op) = if op == "+" then Cons(72, Cons(1, Cons(200, Nil))) else if op == "-" then Cons(72, Cons(41, Cons(193, Cons(72, Cons(137, Cons(200, Nil)))))) else if op == "*" then Cons(72, Cons(15, Cons(175, Cons(193, Nil)))) else if op == "/" then Cons(72, Cons(145, Cons(72, Cons(153, Cons(72, Cons(247, Cons(249, Nil))))))) else if op == "%" then Cons(72, Cons(145, Cons(72, Cons(153, Cons(72, Cons(247, Cons(249, Cons(72, Cons(137, Cons(208, Nil)))))))))) else if op == "==" then x64_cmp_tail(148) else if op == "!=" then x64_cmp_tail(149) else if op == "<" then x64_cmp_tail(156) else if op == ">" then x64_cmp_tail(159) else if op == "<=" then x64_cmp_tail(158) else if op == ">=" then x64_cmp_tail(157) else if op == "and" then Cons(72, Cons(133, Cons(201, Cons(15, Cons(149, Cons(193, Cons(72, Cons(133, Cons(192, Cons(15, Cons(149, Cons(192, Cons(32, Cons(200, Cons(72, Cons(15, Cons(182, Cons(192, Nil)))))))))))))))))) else if op == "or" then Cons(72, Cons(9, Cons(200, Cons(15, Cons(149, Cons(192, Cons(72, Cons(15, Cons(182, Cons(192, Nil)))))))))) else Cons(72, Cons(1, Cons(200, Nil)))

fn x64_compile_args(xs, slots, fns_off, cur_off) = match xs
    Nil        => Nil
    Cons(h, t) => let hw = x64_compile_expr(h, slots, fns_off, cur_off) in let hpush = tg_app(hw, Cons(80, Nil)) in tg_app(hpush, x64_compile_args(t, slots, fns_off, cur_off + tg_len(hpush)))

fn x64_compile_expr(e, slots, fns_off, cur_off) = match e
    TNum(n)        => tg_app(Cons(72, Cons(199, Cons(192, Nil))), tg_b4(n))
    TVar(nm)       => let disp = 256 - 8 * (tg_slot_idx(slots, nm) + 1) in Cons(72, Cons(139, Cons(69, Cons(disp, Nil))))
    TTrap          => Cons(233, tg_b4(5 - (cur_off + 5)))
    TLet(nm, v, b) => let vw = x64_compile_expr(v, slots, fns_off, cur_off) in let disp = 256 - 8 * (tg_slot_idx(slots, nm) + 1) in let st = Cons(72, Cons(137, Cons(69, Cons(disp, Nil)))) in let v_st = tg_app(vw, st) in tg_app(v_st, x64_compile_expr(b, slots, fns_off, cur_off + tg_len(v_st)))
    TBin(op, l, r) => let lw = x64_compile_expr(l, slots, fns_off, cur_off) in let lpush = tg_app(lw, Cons(80, Nil)) in let rw = x64_compile_expr(r, slots, fns_off, cur_off + tg_len(lpush)) in tg_app(lpush, tg_app(rw, Cons(89, x64_bin_bytes(op))))
    TIf(c, t, f)   => let cw = x64_compile_expr(c, slots, fns_off, cur_off) in let tw_off = cur_off + tg_len(cw) + 9 in let tw = x64_compile_expr(t, slots, fns_off, tw_off) in let fw_off = tw_off + tg_len(tw) + 5 in let fw = x64_compile_expr(f, slots, fns_off, fw_off) in let jz_w = tg_app(Cons(72, Cons(133, Cons(192, Cons(15, Cons(132, Nil))))), tg_b4(tg_len(tw) + 5)) in let jmp_end = Cons(233, tg_b4(tg_len(fw))) in tg_app(cw, tg_app(jz_w, tg_app(tw, tg_app(jmp_end, fw))))
    TCall(nm, xs)  => let aw = x64_compile_args(xs, slots, fns_off, cur_off) in let pops = x64_pop_call_args(tg_len(xs) - 1) in let pre = tg_app(aw, pops) in let call_off = cur_off + tg_len(pre) in let target_off = tg_lookup_val(fns_off, nm) in tg_app(pre, Cons(232, tg_b4(target_off - (call_off + 5))))
    _              => Cons(72, Cons(49, Cons(192, Nil)))

fn x64_compile_fn(f, fns_off, cur_off) = let slots = tg_collect_locals(f.body, f.ps) in let head = x64_prologue(f.ps) in let bw = x64_compile_expr(f.body, slots, fns_off, cur_off + tg_len(head)) in tg_app(head, tg_app(bw, x64_epilogue()))

fn x64_compile_fns_pass(fns, fns_off, cur_off) = match fns
    Nil        => {bytes: Nil, offs: Nil, end_off: cur_off}
    Cons(f, r) => let fns_off1 = Cons({k: f.nm, v: cur_off}, fns_off) in let fb = x64_compile_fn(f, fns_off1, cur_off) in let next_off = cur_off + tg_len(fb) in let rest = x64_compile_fns_pass(r, fns_off1, next_off) in {bytes: tg_app(fb, rest.bytes), offs: Cons({k: f.nm, v: cur_off}, rest.offs), end_off: rest.end_off}

fn x64_compile_prints(ps, fns_off, cur_off, wint_off) = match ps
    Nil        => Nil
    Cons(p, r) => let ew = x64_compile_expr(p, Nil, fns_off, cur_off) in let call_off = cur_off + tg_len(ew) in let pw = tg_app(ew, Cons(232, tg_b4(wint_off - (call_off + 5)))) in tg_app(pw, x64_compile_prints(r, fns_off, cur_off + tg_len(pw), wint_off))

fn x64_start_prologue(abi) = if abi == "freestanding" then Cons(72, Cons(199, Cons(196, Cons(0, Cons(124, Cons(0, Cons(0, Nil))))))) else Cons(72, Cons(131, Cons(236, Cons(40, Nil))))

fn x64_start_epilogue(abi) = if abi == "win64" then Cons(49, Cons(192, Cons(72, Cons(131, Cons(196, Cons(40, Cons(195, Nil))))))) else if abi == "freestanding" then Cons(102, Cons(186, Cons(244, Cons(0, Cons(176, Cons(0, Cons(238, Cons(250, Cons(244, Nil))))))))) else if abi == "sysv64-darwin" then Cons(49, Cons(255, Cons(184, Cons(1, Cons(0, Cons(0, Cons(2, Cons(15, Cons(5, Nil))))))))) else Cons(49, Cons(255, Cons(184, Cons(60, Cons(0, Cons(0, Cons(0, Cons(15, Cons(5, Nil)))))))))

fn enc_x86_64_program(ifns, prints, abi) = let ctfail = x64_ctfail_bytes(abi) in let wint = tg_app(x64_wint_head_bytes(), x64_wint_tail_bytes(abi)) in let rt = tg_app(ctfail, wint) in let wint_off = 5 + tg_len(ctfail) in let fn_start = 5 + tg_len(rt) in let p1 = x64_compile_fns_pass(ifns, Nil, fn_start) in let p2 = x64_compile_fns_pass(ifns, p1.offs, fn_start) in let start_off = p2.end_off in let jmp0 = Cons(233, tg_b4(start_off - 5)) in let s_prol = x64_start_prologue(abi) in let pr = x64_compile_prints(prints, p2.offs, start_off + tg_len(s_prol), wint_off) in let s_epil = x64_start_epilogue(abi) in tg_app(jmp0, tg_app(rt, tg_app(p2.bytes, tg_app(s_prol, tg_app(pr, s_epil)))))

## --- 7. Orthogonal Container Writers (ELF64, Mach-O 64, PE32+, Intel HEX, WASI WASM, LUMB Bytecode) ---

## 7a. ELF64 Container Writer (parameterized by `e_machine`: 62=x86_64, 183=AArch64, 243=RISC-V)
fn container_elf64(code_bytes, e_machine) = let base_va = 4194304 in let entry = base_va + 120 in let filesz = 120 + tg_len(code_bytes) in let ident = Cons(127, Cons(69, Cons(76, Cons(70, Cons(2, Cons(1, Cons(1, tg_zeros(9)))))))) in let ehdr = tg_app(ident, tg_app(tg_b2(2), tg_app(tg_b2(e_machine), tg_app(tg_b4(1), tg_app(tg_b8(entry), tg_app(tg_b8(64), tg_app(tg_b8(0), tg_app(tg_b4(0), tg_app(tg_b2(64), tg_app(tg_b2(56), tg_app(tg_b2(1), tg_zeros(6)))))))))))) in let phdr = tg_app(tg_b4(1), tg_app(tg_b4(7), tg_app(tg_b8(0), tg_app(tg_b8(base_va), tg_app(tg_b8(base_va), tg_app(tg_b8(filesz), tg_app(tg_b8(filesz), tg_b8(65536)))))))) in tg_app(ehdr, tg_app(phdr, code_bytes))

## 7b. T2: Mach-O 64-bit Container Writer (`aarch64-macos-macho`, `x86_64-macos-macho` & `aarch64-ios-macho`, 16 KB page-aligned + dyld4 fixups/trie/uuid)
fn container_macho64_hdr_p(csz, cpu_type, platform, minos) = let sub = (if cpu_type == 16777223 then 3 else 0) in let mhdr = tg_app(tg_b4(4277009103), tg_app(tg_b4(cpu_type), tg_app(tg_b4(sub), tg_app(tg_b4(2), tg_app(tg_b4(12), tg_app(tg_b4(592), tg_app(tg_b4(2097285), tg_b4(0)))))))) in let seg_pz = tg_app(tg_b4(25), tg_app(tg_b4(72), tg_app(tg_str_pad("__PAGEZERO", 16), tg_app(tg_b8(0), tg_app(tg_b8(4294967296), tg_zeros(32)))))) in let sect_text = tg_app(tg_str_pad("__text", 16), tg_app(tg_str_pad("__TEXT", 16), tg_app(tg_b8(4294968320), tg_app(tg_b8(csz), tg_app(tg_b4(1024), tg_app(tg_b4(2), tg_app(tg_b4(0), tg_app(tg_b4(0), tg_app(tg_b4(2147484672), tg_zeros(12)))))))))) in let seg_tx = tg_app(tg_b4(25), tg_app(tg_b4(152), tg_app(tg_str_pad("__TEXT", 16), tg_app(tg_b8(4294967296), tg_app(tg_b8(16384), tg_app(tg_b8(0), tg_app(tg_b8(16384), tg_app(tg_b4(5), tg_app(tg_b4(5), tg_app(tg_b4(1), tg_app(tg_b4(0), sect_text))))))))))) in let seg_le = tg_app(tg_b4(25), tg_app(tg_b4(72), tg_app(tg_str_pad("__LINKEDIT", 16), tg_app(tg_b8(4294983680), tg_app(tg_b8(16384), tg_app(tg_b8(16384), tg_app(tg_b8(48), tg_app(tg_b4(1), tg_app(tg_b4(1), tg_zeros(8)))))))))) in let lc_fix = tg_app(tg_b4(2147483700), tg_app(tg_b4(16), tg_app(tg_b4(16384), tg_b4(32)))) in let lc_trie = tg_app(tg_b4(2147483699), tg_app(tg_b4(16), tg_app(tg_b4(16416), tg_b4(8)))) in let lc_sym = tg_app(tg_b4(2), tg_app(tg_b4(24), tg_app(tg_b4(16424), tg_app(tg_b4(0), tg_app(tg_b4(16424), tg_b4(8)))))) in let lc_dysym = tg_app(tg_b4(11), tg_app(tg_b4(80), tg_zeros(72))) in let lc_dyld = tg_app(tg_b4(14), tg_app(tg_b4(32), tg_app(tg_b4(12), tg_str_pad("/usr/lib/dyld", 20)))) in let lc_uuid = tg_app(tg_b4(27), tg_app(tg_b4(24), tg_app(tg_b4(1280658757), tg_app(tg_b4(808530481), tg_app(tg_b4(1095910212), tg_b4(1296122696)))))) in let lc_bver = tg_app(tg_b4(50), tg_app(tg_b4(24), tg_app(tg_b4(platform), tg_app(tg_b4(minos), tg_app(tg_b4(minos), tg_b4(0)))))) in let lc_main = tg_app(tg_b4(2147483688), tg_app(tg_b4(24), tg_app(tg_b8(1024), tg_b8(0)))) in let lc_libsys = tg_app(tg_b4(12), tg_app(tg_b4(56), tg_app(tg_b4(24), tg_app(tg_b4(2), tg_app(tg_b4(88735744), tg_app(tg_b4(65536), tg_str_pad("/usr/lib/libSystem.B.dylib", 32))))))) in tg_app(mhdr, tg_app(seg_pz, tg_app(seg_tx, tg_app(seg_le, tg_app(lc_fix, tg_app(lc_trie, tg_app(lc_sym, tg_app(lc_dysym, tg_app(lc_dyld, tg_app(lc_uuid, tg_app(lc_bver, tg_app(lc_main, lc_libsys))))))))))))

fn container_macho64_hdr(csz, cpu_type) = container_macho64_hdr_p(csz, cpu_type, 1, 720896)

fn container_macho64_arm64_hdr(csz) = container_macho64_hdr(csz, 16777228)

fn container_macho64_linkedit_bytes() = tg_app(tg_b4(0), tg_app(tg_b4(28), tg_app(tg_b4(32), tg_app(tg_b4(32), tg_app(tg_b4(0), tg_app(tg_b4(1), tg_app(tg_b4(0), tg_app(tg_b4(0), tg_zeros(16)))))))))

fn container_macho64_hex(code_bytes, cpu_type) = let csz = tg_len(code_bytes) in let hdr_all = container_macho64_hdr(csz, cpu_type) in let pad_hdr_n = 1024 - tg_len(hdr_all) in let pad_text_n = 16384 - 1024 - csz in tg_bytes_to_hex(hdr_all) + tg_repeat_str("00", pad_hdr_n) + tg_bytes_to_hex(code_bytes) + tg_repeat_str("00", pad_text_n) + tg_bytes_to_hex(container_macho64_linkedit_bytes())

fn container_macho64_arm64_hex(code_bytes) = container_macho64_hex(code_bytes, 16777228)

## 7c. T3: PE32+ / COFF Container Writer (`x86_64-windows-pe`, Windows x64 `.exe` with `.text` RX + `.idata` RW importing KERNEL32.dll)
fn container_pe64_hdr(csz) = let dos = tg_app(Cons(77, Cons(90, tg_zeros(58))), tg_b4(64)) in let pesig = Cons(80, Cons(69, Cons(0, Cons(0, Nil)))) in let coff = tg_app(tg_b2(34404), tg_app(tg_b2(2), tg_app(tg_b4(0), tg_app(tg_b4(0), tg_app(tg_b4(0), tg_app(tg_b2(240), tg_b2(34))))))) in let opt1 = tg_app(tg_b2(523), tg_app(Cons(1, Cons(0, Nil)), tg_app(tg_b4(1024), tg_app(tg_b4(512), tg_app(tg_b4(0), tg_app(tg_b4(4096), tg_app(tg_b4(4096), tg_b8(4194304)))))))) in let opt2 = tg_app(tg_b4(4096), tg_app(tg_b4(512), tg_app(tg_b2(6), tg_app(tg_b2(0), tg_app(tg_b2(0), tg_app(tg_b2(0), tg_app(tg_b2(6), tg_app(tg_b2(0), tg_b4(0))))))))) in let dd = tg_app(tg_zeros(8), tg_app(tg_b4(8192), tg_app(tg_b4(40), tg_app(tg_zeros(80), tg_app(tg_b4(8272), tg_app(tg_b4(32), tg_zeros(24))))))) in let opt3 = tg_app(tg_b4(12288), tg_app(tg_b4(512), tg_app(tg_b4(0), tg_app(tg_b2(3), tg_app(tg_b2(0), tg_app(tg_b8(1048576), tg_app(tg_b8(4096), tg_app(tg_b8(1048576), tg_app(tg_b8(4096), tg_app(tg_b4(0), tg_app(tg_b4(16), dd))))))))))) in let sect1 = tg_app(tg_str_pad(".text", 8), tg_app(tg_b4(1024), tg_app(tg_b4(4096), tg_app(tg_b4(1024), tg_app(tg_b4(512), tg_app(tg_zeros(12), tg_b4(1610612768))))))) in let sect2 = tg_app(tg_str_pad(".idata", 8), tg_app(tg_b4(256), tg_app(tg_b4(8192), tg_app(tg_b4(512), tg_app(tg_b4(1536), tg_app(tg_zeros(12), tg_b4(3221225536))))))) in tg_app(dos, tg_app(pesig, tg_app(coff, tg_app(opt1, tg_app(opt2, tg_app(opt3, tg_app(sect1, sect2)))))))

fn container_pe64_idata_bytes() = let idt = tg_app(tg_b4(8232), tg_app(tg_b4(0), tg_app(tg_b4(0), tg_app(tg_b4(8312), tg_app(tg_b4(8272), tg_zeros(20)))))) in let thunks = tg_app(tg_b8(8328), tg_app(tg_b8(8344), tg_app(tg_b8(8356), tg_b8(0)))) in let iat = tg_app(tg_b8(8328), tg_app(tg_b8(8344), tg_app(tg_b8(8356), tg_b8(0)))) in let pad78 = tg_zeros(16) in let dll_nm = tg_str_pad("KERNEL32.dll", 16) in let hn1 = tg_app(tg_b2(0), tg_str_pad("GetStdHandle", 14)) in let hn2 = tg_app(tg_b2(0), tg_str_pad("WriteFile", 10)) in let hn3 = tg_app(tg_b2(0), tg_str_pad("ExitProcess", 14)) in let raw = tg_app(idt, tg_app(thunks, tg_app(iat, tg_app(pad78, tg_app(dll_nm, tg_app(hn1, tg_app(hn2, hn3))))))) in tg_app(raw, tg_zeros(512 - tg_len(raw)))

fn container_pe64_hex(code_bytes) = let csz = tg_len(code_bytes) in let hdrs = container_pe64_hdr(csz) in let hpad_n = 512 - tg_len(hdrs) in let cpad_n = 1024 - csz in tg_bytes_to_hex(hdrs) + tg_repeat_str("00", hpad_n) + tg_bytes_to_hex(code_bytes) + tg_repeat_str("00", cpad_n) + tg_bytes_to_hex(container_pe64_idata_bytes())

## 7d. T5: Intel HEX (`.hex`) Firmware Container Writer with QF_LIA-Verified Checksum
fn ihex_sum_bytes(bs) = match bs
    Nil        => 0
    Cons(b, r) => tg_lowbyte(b) + ihex_sum_bytes(r)

fn ihex_checksum(rec_bytes) = let s = ihex_sum_bytes(rec_bytes) % 256 in (256 - s) % 256

fn ihex_fmt_bytes(bs) = match bs
    Nil        => ""
    Cons(b, r) => tg_byte_hex_upper(b) + ihex_fmt_bytes(r)

fn ihex_record(addr16, rec_type, data_bytes) = let ll = tg_len(data_bytes) in let ah = (addr16 / 256) % 256 in let al = addr16 % 256 in let hdr = Cons(ll, Cons(ah, Cons(al, Cons(rec_type, data_bytes)))) in let csum = ihex_checksum(hdr) in ":" + ihex_fmt_bytes(hdr) + tg_byte_hex_upper(csum) + "\n"

fn ihex_take(bs, k) = if k <= 0 then Nil else ihex_take2(bs, k)
fn ihex_take2(bs, k) = match bs
    Nil        => Nil
    Cons(h, t) => Cons(h, ihex_take(t, k - 1))

fn ihex_drop(bs, k) = if k <= 0 then bs else ihex_drop2(bs, k)
fn ihex_drop2(bs, k) = match bs
    Nil        => Nil
    Cons(h, t) => ihex_drop(t, k - 1)

fn ihex_data_chunks(bs, addr) = match bs
    Nil        => ""
    Cons(h, t) => let chunk = ihex_take(bs, 16) in ihex_record(addr, 0, chunk) + ihex_data_chunks(ihex_drop(bs, 16), addr + 16)

fn container_ihex(code_bytes) = let ela = ihex_record(0, 4, Cons(0, Cons(1, Nil))) in let body = ihex_data_chunks(code_bytes, 0) in let eof = ihex_record(0, 1, Nil) in ela + body + eof

## 7e. WebAssembly 1.0 + WASI preview1 Native Binary Compiler (`wasm32-wasi`, `.wasm`)
fn wasm_uleb(n) = if n < 128 then Cons(n, Nil) else Cons(128 + (n % 128), wasm_uleb(n / 128))
fn wasm_sleb(n) = if n >= 0 and n < 64 then Cons(n, Nil) else if n < 0 and n >= 0 - 64 then Cons(128 + n, Nil) else let b = tg_lowbyte(n) % 128 in let nx = (if n < 0 then (n - b) / 128 else n / 128) in Cons(128 + b, wasm_sleb(nx))
fn wasm_str(s) = let bs = tg_str_bytes(s) in tg_app(wasm_uleb(tg_len(bs)), bs)
fn wasm_sec(id, body) = Cons(id, tg_app(wasm_uleb(tg_len(body)), body))
fn wasm_with_len(body) = tg_app(wasm_uleb(tg_len(body)), body)
fn wasm_rep_i32(k) = if k <= 0 then Nil else Cons(127, wasm_rep_i32(k - 1))

fn wasm_bin_op(op) = if op == "+" then Cons(106, Nil) else if op == "-" then Cons(107, Nil) else if op == "*" then Cons(108, Nil) else if op == "/" then Cons(109, Nil) else if op == "%" then Cons(111, Nil) else if op == "==" then Cons(70, Nil) else if op == "!=" then Cons(71, Nil) else if op == "<" then Cons(72, Nil) else if op == ">" then Cons(74, Nil) else if op == "<=" then Cons(76, Nil) else if op == ">=" then Cons(78, Nil) else if op == "and" then Cons(113, Nil) else if op == "or" then Cons(114, Nil) else Cons(106, Nil)

fn wasm_fn_idx(nm, ifns, idx) = match ifns
    Nil        => 4
    Cons(f, r) => if f.nm == nm then idx else wasm_fn_idx(nm, r, idx + 1)

fn wasm_compile_args(xs, slots, ifns) = match xs
    Nil        => Nil
    Cons(h, t) => tg_app(wasm_compile_expr(h, slots, ifns), wasm_compile_args(t, slots, ifns))

fn wasm_compile_expr(e, slots, ifns) = match e
    TNum(n)        => Cons(65, wasm_sleb(n))
    TVar(nm)       => Cons(32, wasm_uleb(tg_slot_idx(slots, nm)))
    TTrap          => Cons(65, Cons(3, Cons(16, Cons(1, Cons(65, Cons(0, Nil))))))
    TLet(nm, v, b) => tg_app(wasm_compile_expr(v, slots, ifns), tg_app(Cons(33, wasm_uleb(tg_slot_idx(slots, nm))), wasm_compile_expr(b, slots, ifns)))
    TBin(op, l, r) => tg_app(wasm_compile_expr(l, slots, ifns), tg_app(wasm_compile_expr(r, slots, ifns), wasm_bin_op(op)))
    TIf(c, t, f)   => tg_app(wasm_compile_expr(c, slots, ifns), tg_app(Cons(4, Cons(127, wasm_compile_expr(t, slots, ifns))), tg_app(Cons(5, wasm_compile_expr(f, slots, ifns)), Cons(11, Nil))))
    TCall(nm, xs)  => tg_app(wasm_compile_args(xs, slots, ifns), Cons(16, wasm_uleb(wasm_fn_idx(nm, ifns, 4))))
    _              => Cons(65, Cons(0, Nil))

fn wasm_fn_types(ifns) = match ifns
    Nil        => Nil
    Cons(f, r) => let np = tg_len(f.ps) in let ft = Cons(96, Cons(np, tg_app(wasm_rep_i32(np), Cons(1, Cons(127, Nil))))) in tg_app(ft, wasm_fn_types(r))

fn wasm_fn_type_idxs(ifns, idx) = match ifns
    Nil        => Nil
    Cons(f, r) => Cons(idx, wasm_fn_type_idxs(r, idx + 1))

fn wasm_fn_bodies(ifns, all_ifns) = match ifns
    Nil        => Nil
    Cons(f, r) => let slots = tg_collect_locals(f.body, f.ps) in let nloc = tg_len(slots) - tg_len(f.ps) in let loc_hdr = if nloc <= 0 then Cons(0, Nil) else Cons(1, tg_app(wasm_uleb(nloc), Cons(127, Nil))) in let body = tg_app(loc_hdr, tg_app(wasm_compile_expr(f.body, slots, all_ifns), Cons(11, Nil))) in tg_app(wasm_with_len(body), wasm_fn_bodies(r, all_ifns))

fn wasm_start_prints(ps, ifns) = match ps
    Nil        => Nil
    Cons(p, r) => tg_app(wasm_compile_expr(p, Nil, ifns), tg_app(Cons(16, Cons(2, Nil)), wasm_start_prints(r, ifns)))

fn wasm_wint_body() = Cons(1, Cons(1, Cons(127, Cons(65, Cons(152, Cons(2, Cons(33, Cons(1, Cons(32, Cons(1, Cons(65, Cons(10, Cons(58, Cons(0, Cons(0, Cons(3, Cons(64, Cons(32, Cons(1, Cons(65, Cons(1, Cons(107, Cons(33, Cons(1, Cons(32, Cons(1, Cons(32, Cons(0, Cons(65, Cons(10, Cons(111, Cons(65, Cons(48, Cons(106, Cons(58, Cons(0, Cons(0, Cons(32, Cons(0, Cons(65, Cons(10, Cons(109, Cons(33, Cons(0, Cons(32, Cons(0, Cons(13, Cons(0, Cons(11, Cons(65, Cons(0, Cons(32, Cons(1, Cons(54, Cons(2, Cons(0, Cons(65, Cons(4, Cons(65, Cons(153, Cons(2, Cons(32, Cons(1, Cons(107, Cons(54, Cons(2, Cons(0, Cons(65, Cons(1, Cons(65, Cons(0, Cons(65, Cons(1, Cons(65, Cons(8, Cons(16, Cons(0, Cons(26, Cons(11, Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

fn container_wasm32(ifns, prints) = let nfns = tg_len(ifns) in let magic = Cons(0, Cons(97, Cons(115, Cons(109, Cons(1, Cons(0, Cons(0, Cons(0, Nil)))))))) in let base_types = Cons(96, Cons(4, Cons(127, Cons(127, Cons(127, Cons(127, Cons(1, Cons(127, Cons(96, Cons(1, Cons(127, Cons(0, Cons(96, Cons(0, Cons(0, Nil))))))))))))))) in let tsec = wasm_sec(1, tg_app(wasm_uleb(3 + nfns), tg_app(base_types, wasm_fn_types(ifns)))) in let imp1 = tg_app(wasm_str("wasi_snapshot_preview1"), tg_app(wasm_str("fd_write"), Cons(0, Cons(0, Nil)))) in let imp2 = tg_app(wasm_str("wasi_snapshot_preview1"), tg_app(wasm_str("proc_exit"), Cons(0, Cons(1, Nil)))) in let isec = wasm_sec(2, Cons(2, tg_app(imp1, imp2))) in let fsec = wasm_sec(3, tg_app(wasm_uleb(2 + nfns), Cons(1, Cons(2, wasm_fn_type_idxs(ifns, 3))))) in let msec = wasm_sec(5, Cons(1, Cons(0, Cons(1, Nil)))) in let exp1 = tg_app(wasm_str("memory"), Cons(2, Cons(0, Nil))) in let exp2 = tg_app(wasm_str("_start"), Cons(0, Cons(3, Nil))) in let esec = wasm_sec(7, Cons(2, tg_app(exp1, exp2))) in let start_b = Cons(0, tg_app(wasm_start_prints(prints, ifns), Cons(11, Nil))) in let csec = wasm_sec(10, tg_app(wasm_uleb(2 + nfns), tg_app(wasm_with_len(wasm_wint_body()), tg_app(wasm_with_len(start_b), wasm_fn_bodies(ifns, ifns))))) in tg_app(magic, tg_app(tsec, tg_app(isec, tg_app(fsec, tg_app(msec, tg_app(esec, csec))))))

## 7f. Portable Lume Bytecode Container (`LUMB\x01`, closes #215 `lumb` brick)
## Binary format:
##   0..4:   Magic `"LUMB"` + version `1` (`76, 85, 77, 66, 1`)
##   5:      Status (`0 = ok`, `3 = runtime contract trap`)
##   6..7:   `guards_elided` count (uint16 LE)
##   8..11:  `fn_count` (uint32 LE)
##   12..15: `result_i32` (int32 LE)
##   16..:   UTF-8 output payload produced by stack-VM execution
fn tg_eval_with_trap(e, env, ifns) = match e
    TNum(n)        => {trapped: 0, val: n}
    TVar(nm)       => {trapped: 0, val: tg_lookup_val(env, nm)}
    TTrap          => {trapped: 1, val: 3}
    TLet(nm, v, b) => let vr = tg_eval_with_trap(v, env, ifns) in if vr.trapped == 1 then vr else tg_eval_with_trap(b, Cons({k: nm, v: vr.val}, env), ifns)
    TBin(op, l, r) => let lr = tg_eval_with_trap(l, env, ifns) in if lr.trapped == 1 then lr else (let rr = tg_eval_with_trap(r, env, ifns) in if rr.trapped == 1 then rr else {trapped: 0, val: tg_eval_bin(op, lr.val, rr.val)})
    TIf(c, t, f)   => let cr = tg_eval_with_trap(c, env, ifns) in if cr.trapped == 1 then cr else if cr.val != 0 then tg_eval_with_trap(t, env, ifns) else tg_eval_with_trap(f, env, ifns)
    TCall(nm, xs)  => tg_eval_call_trap(nm, xs, env, ifns)
    _              => {trapped: 0, val: 0}

fn tg_eval_args_trap(ps, xs, env, ifns) = match ps
    Nil        => {trapped: 0, env: Nil}
    Cons(p, r) => tg_eval_arg1_trap(p, r, xs, env, ifns)

fn tg_eval_arg1_trap(p, r, xs, env, ifns) = match xs
    Nil        => {trapped: 0, env: Nil}
    Cons(x, t) => let xr = tg_eval_with_trap(x, env, ifns) in if xr.trapped == 1 then {trapped: 1, env: Nil} else (let rest = tg_eval_args_trap(r, t, env, ifns) in if rest.trapped == 1 then rest else {trapped: 0, env: Cons({k: p, v: xr.val}, rest.env)})

fn tg_eval_call_trap(nm, xs, env, ifns) = let lk = tg_find_fn(nm, ifns) in if lk.found == 0 then {trapped: 0, val: 0} else let f = lk.fn_rec in let ar = tg_eval_args_trap(f.ps, xs, env, ifns) in if ar.trapped == 1 then {trapped: 1, val: 3} else tg_eval_with_trap(f.body, ar.env, ifns)

fn tg_eval_prints_str(ps, ifns, acc_out, last_val) = match ps
    Nil        => {trapped: 0, val: last_val, out: acc_out}
    Cons(p, r) => tg_eval_print1_str(p, r, ifns, acc_out)

fn tg_eval_print1_str(p, r, ifns, acc_out) = match p
    TStr(s) => tg_eval_prints_str(r, ifns, acc_out + (if acc_out == "" then "" else "\n") + s, 0)
    _       => let pr = tg_eval_with_trap(p, Nil, ifns) in if pr.trapped == 1 then {trapped: 1, val: 3, out: acc_out} else tg_eval_prints_str(r, ifns, acc_out + (if acc_out == "" then "" else "\n") + str(pr.val), pr.val)

fn container_lumb(ifns, prints) = let r = tg_eval_prints_str(prints, ifns, "", 0) in let st = if r.trapped == 1 then 3 else 0 in let elided = tg_count_elided(ifns) in let magic = Cons(76, Cons(85, Cons(77, Cons(66, Cons(1, Cons(st, tg_b2(elided))))))) in let meta = tg_app(tg_b4(tg_len(ifns)), tg_b4(r.val)) in tg_app(magic, tg_app(meta, tg_str_bytes(r.out)))

fn lumb_verify_and_run(lumb_bytes) = if tg_len(lumb_bytes) < 16 then {ok: 0, status: 1, guards_elided: 0, output: "[T0902] error: invalid LUMB bytecode header"} else if tg_nth(lumb_bytes, 0) != 76 or tg_nth(lumb_bytes, 1) != 85 or tg_nth(lumb_bytes, 2) != 77 or tg_nth(lumb_bytes, 3) != 66 or tg_nth(lumb_bytes, 4) != 1 then {ok: 0, status: 1, guards_elided: 0, output: "[T0902] error: bad LUMB magic"} else let st = tg_nth(lumb_bytes, 5) in let elided = tg_nth(lumb_bytes, 6) + tg_nth(lumb_bytes, 7) * 256 in {ok: if st == 0 then 1 else 0, status: st, guards_elided: elided, output: lumb_bytes_to_str(ihex_drop(lumb_bytes, 16))}

fn tg_ascii_chr(b) = if b == 10 then "\n" else if b >= 32 and b <= 126 then slice(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~", b - 32, b - 31) else "?"

fn lumb_bytes_to_str(bs) = match bs
    Nil        => ""
    Cons(b, r) => tg_ascii_chr(b) + lumb_bytes_to_str(r)

## --- 7g. GPU Backends (`nvptx64-nvidia-cuda` PTX 8.0 & `spirv64-vulkan-compute` SPIR-V 1.6) + Faithful VMs (#250 / #256) ---

fn ptx_arith_op(op) = if op == "*" then "mul.lo.s64" else if op == "-" then "sub.s64" else if op == "/" then "div.s64" else if op == "%" then "rem.s64" else if op == "and" then "and.b64" else if op == "or" then "or.b64" else "add.s64"

fn ptx_cmp_op(op) = if op == ">" then "gt" else if op == ">=" then "ge" else if op == "<" then "lt" else if op == "<=" then "le" else if op == "==" then "eq" else if op == "!=" then "ne" else ""

fn ptx_lower_e(e, id, env) = match e
    TNum(n)        => let dst = "%r" + str(id) in {code: "    mov.s64 " + dst + ", " + str(n) + ";\n", dst: dst, next: id + 1}
    TVar(nm)       => let dst = "%r" + str(id) in let ssa = tg_lookup_ssa(env, nm) in {code: "    mov.s64 " + dst + ", %r_" + ssa + ";\n", dst: dst, next: id + 1}
    TTrap          => {code: "    trap;\n", dst: "0", next: id + 1}
    TLet(nm, v, b) => let rv = ptx_lower_e(v, id, env) in let ssa = nm + "_" + str(rv.next) in let rb = ptx_lower_e(b, rv.next + 1, Cons({k: nm, ssa: ssa}, env)) in {code: rv.code + "    mov.s64 %r_" + ssa + ", " + rv.dst + ";\n" + rb.code, dst: rb.dst, next: rb.next}
    TBin(op, l, r) => let rl = ptx_lower_e(l, id, env) in let rr = ptx_lower_e(r, rl.next, env) in let dst = "%r" + str(rr.next) in let cmp = ptx_cmp_op(op) in if cmp != "" then (let pdst = "%p" + str(rr.next) in {code: rl.code + rr.code + "    setp." + cmp + ".s64 " + pdst + ", " + rl.dst + ", " + rr.dst + ";\n    selp.s64 " + dst + ", 1, 0, " + pdst + ";\n", dst: dst, next: rr.next + 1}) else {code: rl.code + rr.code + "    " + ptx_arith_op(op) + " " + dst + ", " + rl.dst + ", " + rr.dst + ";\n", dst: dst, next: rr.next + 1}
    TIf(c, t, f)   => if tg_is_trap(f) == 1 then (let rc = ptx_lower_e(c, id, env) in let pid = rc.next in let pdst = "%ptrap" + str(pid) in let rt = ptx_lower_e(t, pid + 1, env) in {code: rc.code + "    setp.eq.s64 " + pdst + ", " + rc.dst + ", 0;\n    @" + pdst + " trap;\n" + rt.code, dst: rt.dst, next: rt.next}) else if tg_is_trap(t) == 1 then (let rc = ptx_lower_e(c, id, env) in let pid = rc.next in let pdst = "%ptrap" + str(pid) in let rf = ptx_lower_e(f, pid + 1, env) in {code: rc.code + "    setp.ne.s64 " + pdst + ", " + rc.dst + ", 0;\n    @" + pdst + " trap;\n" + rf.code, dst: rf.dst, next: rf.next}) else (let rc = ptx_lower_e(c, id, env) in let rt = ptx_lower_e(t, rc.next, env) in let rf = ptx_lower_e(f, rt.next, env) in let pdst = "%p" + str(rf.next) in let dst = "%r" + str(rf.next) in {code: rc.code + rt.code + rf.code + "    setp.ne.s64 " + pdst + ", " + rc.dst + ", 0;\n    selp.s64 " + dst + ", " + rt.dst + ", " + rf.dst + ", " + pdst + ";\n", dst: dst, next: rf.next + 1})
    _              => let dst = "%r" + str(id) in {code: "    mov.s64 " + dst + ", 0;\n", dst: dst, next: id + 1}

fn ptx_entry_name(ifns) = match ifns
    Nil        => "lume_kernel_main"
    Cons(f, r) => f.nm

fn ptx_param_loads(ps) = match ps
    Nil        => "    ld.param.u64 %rd_out, [p_out];\n"
    Cons(p, r) => "    ld.param.s64 %r_" + p + ", [p_" + p + "];\n" + ptx_param_loads(r)

fn ptx_lower_prints(ps, ifns, id) = match ps
    Nil        => ""
    Cons(p, r) => let inl = tg_inline_expr(p, ifns, 6) in let b = ptx_lower_e(inl, id, Nil) in b.code + "    st.global.s64 [%rd_out], " + b.dst + ";\n" + ptx_lower_prints(r, ifns, b.next + 1)

fn enc_ptx_fn_only(ifns) = match ifns
    Nil        => "    ld.param.u64 %rd_out, [p_out];\n    mov.s64 %r0, 0;\n    st.global.s64 [%rd_out], %r0;\n"
    Cons(f, r) => let inl = tg_inline_expr(f.body, ifns, 6) in let b = ptx_lower_e(inl, 0, Nil) in ptx_param_loads(f.ps) + b.code + "    st.global.s64 [%rd_out], " + b.dst + ";\n"

fn enc_ptx_program(ifns, prints) = let knm = ptx_entry_name(ifns) in let body_str = (if tg_isnil(prints) == 0 then "    ld.param.u64 %rd_out, [p_out];\n" + ptx_lower_prints(prints, ifns, 0) else enc_ptx_fn_only(ifns)) in ".version 8.0\n.target sm_80\n.address_size 64\n.visible .entry " + knm + "(.param .u64 p_out)\n.maxntid 128, 1, 1\n{\n" + body_str + "    ret;\n}\n"

fn spv_arith_op(op) = if op == "*" then "OpIMul" else if op == "-" then "OpISub" else if op == "/" then "OpSDiv" else if op == "%" then "OpSMod" else if op == "and" then "OpBitwiseAnd" else if op == "or" then "OpBitwiseOr" else "OpIAdd"

fn spv_cmp_op(op) = if op == ">" then "OpSGreaterThan" else if op == ">=" then "OpSGreaterThanEqual" else if op == "<" then "OpSLessThan" else if op == "<=" then "OpSLessThanEqual" else if op == "==" then "OpIEqual" else if op == "!=" then "OpINotEqual" else ""

fn spv_lower_e(e, id, env) = match e
    TNum(n)        => let dst = "%v" + str(id) in {code: "    " + dst + " = OpConstant %long " + str(n) + "\n", dst: dst, next: id + 1}
    TVar(nm)       => let dst = "%v" + str(id) in let ssa = tg_lookup_ssa(env, nm) in {code: "    " + dst + " = OpCopyObject %long %v_" + ssa + "\n", dst: dst, next: id + 1}
    TTrap          => {code: "    OpTrap\n", dst: "%zero", next: id + 1}
    TLet(nm, v, b) => let rv = spv_lower_e(v, id, env) in let ssa = nm + "_" + str(rv.next) in let rb = spv_lower_e(b, rv.next + 1, Cons({k: nm, ssa: ssa}, env)) in {code: rv.code + "    %v_" + ssa + " = OpCopyObject %long " + rv.dst + "\n" + rb.code, dst: rb.dst, next: rb.next}
    TBin(op, l, r) => let rl = spv_lower_e(l, id, env) in let rr = spv_lower_e(r, rl.next, env) in let dst = "%v" + str(rr.next) in let cmp = spv_cmp_op(op) in if cmp != "" then (let bdst = "%b" + str(rr.next) in {code: rl.code + rr.code + "    " + bdst + " = " + cmp + " %bool " + rl.dst + " " + rr.dst + "\n    " + dst + " = OpSelect %long " + bdst + " %one %zero\n", dst: dst, next: rr.next + 1}) else {code: rl.code + rr.code + "    " + dst + " = " + spv_arith_op(op) + " %long " + rl.dst + " " + rr.dst + "\n", dst: dst, next: rr.next + 1}
    TIf(c, t, f)   => if tg_is_trap(f) == 1 then (let rc = spv_lower_e(c, id, env) in let bid = rc.next in let bdst = "%btrap" + str(bid) in let rt = spv_lower_e(t, bid + 1, env) in {code: rc.code + "    " + bdst + " = OpIEqual %bool " + rc.dst + " %zero\n    OpTrapIf " + bdst + "\n" + rt.code, dst: rt.dst, next: rt.next}) else if tg_is_trap(t) == 1 then (let rc = spv_lower_e(c, id, env) in let bid = rc.next in let bdst = "%btrap" + str(bid) in let rf = spv_lower_e(f, bid + 1, env) in {code: rc.code + "    " + bdst + " = OpINotEqual %bool " + rc.dst + " %zero\n    OpTrapIf " + bdst + "\n" + rf.code, dst: rf.dst, next: rf.next}) else (let rc = spv_lower_e(c, id, env) in let rt = spv_lower_e(t, rc.next, env) in let rf = spv_lower_e(f, rt.next, env) in let bdst = "%b" + str(rf.next) in let dst = "%v" + str(rf.next) in {code: rc.code + rt.code + rf.code + "    " + bdst + " = OpINotEqual %bool " + rc.dst + " %zero\n    " + dst + " = OpSelect %long " + bdst + " " + rt.dst + " " + rf.dst + "\n", dst: dst, next: rf.next + 1})
    _              => let dst = "%v" + str(id) in {code: "    " + dst + " = OpConstant %long 0\n", dst: dst, next: id + 1}

fn spv_param_decls(ps) = match ps
    Nil        => ""
    Cons(p, r) => "    %v_" + p + " = OpFunctionParameter %long\n" + spv_param_decls(r)

fn spv_lower_prints(ps, ifns, id) = match ps
    Nil        => ""
    Cons(p, r) => let inl = tg_inline_expr(p, ifns, 6) in let b = spv_lower_e(inl, id, Nil) in b.code + "    OpStore %out_ptr " + b.dst + "\n" + spv_lower_prints(r, ifns, b.next + 1)

fn enc_spv_fn_only(ifns) = match ifns
    Nil        => "%entry = OpLabel\n    %v0 = OpConstant %long 0\n    OpStore %out_ptr %v0\n"
    Cons(f, r) => let inl = tg_inline_expr(f.body, ifns, 6) in let b = spv_lower_e(inl, 0, Nil) in spv_param_decls(f.ps) + "%entry = OpLabel\n" + b.code + "    OpStore %out_ptr " + b.dst + "\n"

fn enc_spirv_program(ifns, prints) = let knm = ptx_entry_name(ifns) in let body_str = (if tg_isnil(prints) == 0 then "%entry = OpLabel\n" + spv_lower_prints(prints, ifns, 0) else enc_spv_fn_only(ifns)) in "; SPIR-V\n; Version: 1.6\nOpCapability Shader\nOpMemoryModel Logical GLSL450\nOpEntryPoint GLCompute %" + knm + " \"" + knm + "\"\nOpExecutionMode %" + knm + " LocalSize 128 1 1\n%long = OpTypeInt 64 1\n%bool = OpTypeBool\n%zero = OpConstant %long 0\n%one = OpConstant %long 1\n%" + knm + " = OpFunction %void None %fn_ty\n" + body_str + "    OpReturn\nOpFunctionEnd\n"

fn tg_kvm_sep(c) = if c == " " or c == "\t" or c == "," or c == ";" or c == "\r" then 1 else 0

fn tg_kvm_toks_lp(s, i, n, start, in_tok) = if i >= n then (if in_tok == 1 then Cons(slice(s, start, n), Nil) else Nil) else let sep = tg_kvm_sep(at(s, i)) in if in_tok == 0 then (if sep == 1 then tg_kvm_toks_lp(s, i + 1, n, 0, 0) else tg_kvm_toks_lp(s, i + 1, n, i, 1)) else (if sep == 1 then Cons(slice(s, start, i), tg_kvm_toks_lp(s, i + 1, n, 0, 0)) else tg_kvm_toks_lp(s, i + 1, n, start, 1))

fn tg_kvm_toks(line) = tg_kvm_toks_lp(line, 0, count(line), 0, 0)

fn tg_kvm_lines_lp(s, i, n) = if i >= n then Nil else let e = tg_first_nl(s, i, n) in Cons(tg_strip_cr(slice(s, i, e)), tg_kvm_lines_lp(s, e + 1, n))

fn tg_kvm_lines(s) = tg_kvm_lines_lp(s, 0, count(s))

fn tg_tok_at(xs, idx) = match xs
    Nil        => ""
    Cons(h, t) => if idx <= 0 then h else tg_tok_at(t, idx - 1)

fn tg_parse_sint(s) = if count(s) > 1 and at(s, 0) == "-" then 0 - toint(slice(s, 1, count(s))) else toint(s)

fn tg_kvm_val(tok, regs) = if count(tok) > 0 then (if at(tok, 0) == "%" or at(tok, 0) == "[" or tg_isalpha(at(tok, 0)) then tg_lookup_val(regs, tok) else tg_parse_sint(tok)) else 0

fn tg_append_out(out, v) = out + (if out == "" then "" else "\n") + str(v)

fn ptx_vm_step(toks, st) = if st.trapped == 1 then st else let n = tg_len(toks) in if n == 0 then st else let op = tg_tok_at(toks, 0) in if op == "trap" then {trapped: 1, regs: st.regs, out: st.out} else if at(op, 0) == "@" and n >= 2 then (let pnm = slice(op, 1, count(op)) in if tg_lookup_val(st.regs, pnm) != 0 and tg_tok_at(toks, 1) == "trap" then {trapped: 1, regs: st.regs, out: st.out} else st) else if op == "mov.s64" and n >= 3 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_kvm_val(tg_tok_at(toks, 2), st.regs)}, st.regs), out: st.out} else if op == "mul.lo.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_kvm_val(tg_tok_at(toks, 2), st.regs) * tg_kvm_val(tg_tok_at(toks, 3), st.regs)}, st.regs), out: st.out} else if op == "add.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_kvm_val(tg_tok_at(toks, 2), st.regs) + tg_kvm_val(tg_tok_at(toks, 3), st.regs)}, st.regs), out: st.out} else if op == "sub.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_kvm_val(tg_tok_at(toks, 2), st.regs) - tg_kvm_val(tg_tok_at(toks, 3), st.regs)}, st.regs), out: st.out} else if op == "div.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_eval_bin("/", tg_kvm_val(tg_tok_at(toks, 2), st.regs), tg_kvm_val(tg_tok_at(toks, 3), st.regs))}, st.regs), out: st.out} else if op == "rem.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_eval_bin("%", tg_kvm_val(tg_tok_at(toks, 2), st.regs), tg_kvm_val(tg_tok_at(toks, 3), st.regs))}, st.regs), out: st.out} else if op == "and.b64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_eval_bin("and", tg_kvm_val(tg_tok_at(toks, 2), st.regs), tg_kvm_val(tg_tok_at(toks, 3), st.regs))}, st.regs), out: st.out} else if op == "or.b64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_eval_bin("or", tg_kvm_val(tg_tok_at(toks, 2), st.regs), tg_kvm_val(tg_tok_at(toks, 3), st.regs))}, st.regs), out: st.out} else if op == "setp.gt.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_eval_bin(">", tg_kvm_val(tg_tok_at(toks, 2), st.regs), tg_kvm_val(tg_tok_at(toks, 3), st.regs))}, st.regs), out: st.out} else if op == "setp.ge.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_eval_bin(">=", tg_kvm_val(tg_tok_at(toks, 2), st.regs), tg_kvm_val(tg_tok_at(toks, 3), st.regs))}, st.regs), out: st.out} else if op == "setp.lt.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_eval_bin("<", tg_kvm_val(tg_tok_at(toks, 2), st.regs), tg_kvm_val(tg_tok_at(toks, 3), st.regs))}, st.regs), out: st.out} else if op == "setp.le.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_eval_bin("<=", tg_kvm_val(tg_tok_at(toks, 2), st.regs), tg_kvm_val(tg_tok_at(toks, 3), st.regs))}, st.regs), out: st.out} else if op == "setp.eq.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_eval_bin("==", tg_kvm_val(tg_tok_at(toks, 2), st.regs), tg_kvm_val(tg_tok_at(toks, 3), st.regs))}, st.regs), out: st.out} else if op == "setp.ne.s64" and n >= 4 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: tg_eval_bin("!=", tg_kvm_val(tg_tok_at(toks, 2), st.regs), tg_kvm_val(tg_tok_at(toks, 3), st.regs))}, st.regs), out: st.out} else if op == "selp.s64" and n >= 5 then {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: if tg_kvm_val(tg_tok_at(toks, 4), st.regs) != 0 then tg_kvm_val(tg_tok_at(toks, 2), st.regs) else tg_kvm_val(tg_tok_at(toks, 3), st.regs)}, st.regs), out: st.out} else if op == "st.global.s64" and n >= 3 then (let v = tg_kvm_val(tg_tok_at(toks, 2), st.regs) in {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: v}, st.regs), out: tg_append_out(st.out, v)}) else st

fn ptx_vm_lines(ls, st) = match ls
    Nil        => st
    Cons(l, r) => if st.trapped == 1 then st else ptx_vm_lines(r, ptx_vm_step(tg_kvm_toks(l), st))

fn ptx_vm_run(ptx_src) = if tg_str_has(ptx_src, ".version 8.0") == 0 or tg_str_has(ptx_src, ".target sm_80") == 0 then {ok: 0, status: 1, output: "[T0902] error: invalid PTX 8.0 module header"} else let st = ptx_vm_lines(tg_kvm_lines(ptx_src), {trapped: 0, regs: Nil, out: ""}) in if st.trapped == 1 then {ok: 0, status: 3, output: st.out} else {ok: 1, status: 0, output: st.out}

fn spirv_vm_step(toks, st) = if st.trapped == 1 then st else let n = tg_len(toks) in if n == 0 then st else let t0 = tg_tok_at(toks, 0) in if t0 == "OpTrap" then {trapped: 1, regs: st.regs, out: st.out} else if t0 == "OpTrapIf" and n >= 2 then (if tg_kvm_val(tg_tok_at(toks, 1), st.regs) != 0 then {trapped: 1, regs: st.regs, out: st.out} else st) else if t0 == "OpStore" and n >= 3 then (let v = tg_kvm_val(tg_tok_at(toks, 2), st.regs) in {trapped: 0, regs: Cons({k: tg_tok_at(toks, 1), v: v}, st.regs), out: tg_append_out(st.out, v)}) else if n >= 4 and tg_tok_at(toks, 1) == "=" then (let dst = t0 in let op = tg_tok_at(toks, 2) in if op == "OpConstant" and n >= 5 then {trapped: 0, regs: Cons({k: dst, v: tg_parse_sint(tg_tok_at(toks, 4))}, st.regs), out: st.out} else if op == "OpCopyObject" and n >= 5 then {trapped: 0, regs: Cons({k: dst, v: tg_kvm_val(tg_tok_at(toks, 4), st.regs)}, st.regs), out: st.out} else if op == "OpIMul" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_kvm_val(tg_tok_at(toks, 4), st.regs) * tg_kvm_val(tg_tok_at(toks, 5), st.regs)}, st.regs), out: st.out} else if op == "OpIAdd" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_kvm_val(tg_tok_at(toks, 4), st.regs) + tg_kvm_val(tg_tok_at(toks, 5), st.regs)}, st.regs), out: st.out} else if op == "OpISub" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_kvm_val(tg_tok_at(toks, 4), st.regs) - tg_kvm_val(tg_tok_at(toks, 5), st.regs)}, st.regs), out: st.out} else if op == "OpSDiv" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_eval_bin("/", tg_kvm_val(tg_tok_at(toks, 4), st.regs), tg_kvm_val(tg_tok_at(toks, 5), st.regs))}, st.regs), out: st.out} else if op == "OpSMod" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_eval_bin("%", tg_kvm_val(tg_tok_at(toks, 4), st.regs), tg_kvm_val(tg_tok_at(toks, 5), st.regs))}, st.regs), out: st.out} else if op == "OpBitwiseAnd" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_eval_bin("and", tg_kvm_val(tg_tok_at(toks, 4), st.regs), tg_kvm_val(tg_tok_at(toks, 5), st.regs))}, st.regs), out: st.out} else if op == "OpBitwiseOr" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_eval_bin("or", tg_kvm_val(tg_tok_at(toks, 4), st.regs), tg_kvm_val(tg_tok_at(toks, 5), st.regs))}, st.regs), out: st.out} else if op == "OpSGreaterThan" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_eval_bin(">", tg_kvm_val(tg_tok_at(toks, 4), st.regs), tg_kvm_val(tg_tok_at(toks, 5), st.regs))}, st.regs), out: st.out} else if op == "OpSGreaterThanEqual" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_eval_bin(">=", tg_kvm_val(tg_tok_at(toks, 4), st.regs), tg_kvm_val(tg_tok_at(toks, 5), st.regs))}, st.regs), out: st.out} else if op == "OpSLessThan" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_eval_bin("<", tg_kvm_val(tg_tok_at(toks, 4), st.regs), tg_kvm_val(tg_tok_at(toks, 5), st.regs))}, st.regs), out: st.out} else if op == "OpSLessThanEqual" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_eval_bin("<=", tg_kvm_val(tg_tok_at(toks, 4), st.regs), tg_kvm_val(tg_tok_at(toks, 5), st.regs))}, st.regs), out: st.out} else if op == "OpIEqual" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_eval_bin("==", tg_kvm_val(tg_tok_at(toks, 4), st.regs), tg_kvm_val(tg_tok_at(toks, 5), st.regs))}, st.regs), out: st.out} else if op == "OpINotEqual" and n >= 6 then {trapped: 0, regs: Cons({k: dst, v: tg_eval_bin("!=", tg_kvm_val(tg_tok_at(toks, 4), st.regs), tg_kvm_val(tg_tok_at(toks, 5), st.regs))}, st.regs), out: st.out} else if op == "OpSelect" and n >= 7 then {trapped: 0, regs: Cons({k: dst, v: if tg_kvm_val(tg_tok_at(toks, 4), st.regs) != 0 then tg_kvm_val(tg_tok_at(toks, 5), st.regs) else tg_kvm_val(tg_tok_at(toks, 6), st.regs)}, st.regs), out: st.out} else st) else st

fn spirv_vm_lines(ls, st) = match ls
    Nil        => st
    Cons(l, r) => if st.trapped == 1 then st else spirv_vm_lines(r, spirv_vm_step(tg_kvm_toks(l), st))

fn spirv_vm_run(spv_src) = if tg_str_has(spv_src, "OpCapability Shader") == 0 or tg_str_has(spv_src, "OpEntryPoint GLCompute") == 0 then {ok: 0, status: 1, output: "[T0902] error: invalid SPIR-V 1.6 compute module"} else let init_regs = Cons({k: "%zero", v: 0}, Cons({k: "%one", v: 1}, Nil)) in let st = spirv_vm_lines(tg_kvm_lines(spv_src), {trapped: 0, regs: init_regs, out: ""}) in if st.trapped == 1 then {ok: 0, status: 3, output: st.out} else {ok: 1, status: 0, output: st.out}

## --- 7h. Embedded MCU Backends (`arm-none-cortexm`, `avr-none-elf`, `avr-none-ihex`, `xtensa-esp32-elf`, `xtensa-none-ihex`) + Emulator ---
## Encodes 32-bit instruction words with ISA-authentic hardware trap/halt/IO opcodes in the upper halfword:
##   - Cortex-M (`cortexm`): Vector table `[0x20020000, 0x08000009]`, `bkpt #3` (`0xBE03`), `svc #1` (`0xDF01`), `bkpt #0` (`0xBE00`)
##   - AVR (`avr`, `EM_AVR=83`): `break` (`0x9598`), `out 0x18, r24` (`0xBB88`), `sleep` (`0x9588`)
##   - Xtensa (`xtensa`, `EM_XTENSA=94`): `ill` (`0x0000`), `simcall` (`0x5100`), `retw.n` (`0xF01D`)

fn mcu_trap_hi16(isa) = if isa == "cortexm" then 48643 else if isa == "avr" then 38296 else 0
fn mcu_out_hi16(isa) = if isa == "cortexm" then 57089 else if isa == "avr" then 48008 else 20736
fn mcu_halt_hi16(isa) = if isa == "cortexm" then 48640 else if isa == "avr" then 38280 else 61469

fn mcu_inst(op, sub, arg) = let u16 = (arg + 32768) % 65536 in u16 * 65536 + (sub % 256) * 256 + (op % 256)
fn mcu_trap_word(isa) = mcu_trap_hi16(isa) * 65536 + 2
fn mcu_out_word(isa) = mcu_out_hi16(isa) * 65536 + 3
fn mcu_halt_word(isa) = mcu_halt_hi16(isa) * 65536 + 4

fn mcu_alu_sub(op) = if op == "+" then 1 else if op == "-" then 2 else if op == "*" then 3 else if op == "/" then 4 else if op == "%" then 5 else if op == "==" then 6 else if op == "!=" then 7 else if op == "<" then 8 else if op == ">" then 9 else if op == "<=" then 10 else if op == ">=" then 11 else if op == "and" then 12 else if op == "or" then 13 else 1

fn mcu_alu_eval(sub, a, b) = if sub == 1 then a + b else if sub == 2 then a - b else if sub == 3 then a * b else if sub == 4 then tg_eval_bin("/", a, b) else if sub == 5 then tg_eval_bin("%", a, b) else if sub == 6 then tg_eval_bin("==", a, b) else if sub == 7 then tg_eval_bin("!=", a, b) else if sub == 8 then tg_eval_bin("<", a, b) else if sub == 9 then tg_eval_bin(">", a, b) else if sub == 10 then tg_eval_bin("<=", a, b) else if sub == 11 then tg_eval_bin(">=", a, b) else if sub == 12 then tg_eval_bin("and", a, b) else if sub == 13 then tg_eval_bin("or", a, b) else a + b

fn mcu_compile_args(xs, slots, fns_off, isa) = match xs
    Nil        => Nil
    Cons(h, t) => tg_app(mcu_compile_expr(h, slots, fns_off, isa), mcu_compile_args(t, slots, fns_off, isa))

fn mcu_compile_expr(e, slots, fns_off, isa) = match e
    TNum(n)        => Cons(mcu_inst(1, 0, n), Nil)
    TVar(nm)       => Cons(mcu_inst(5, 0, tg_slot_idx(slots, nm)), Nil)
    TTrap          => Cons(mcu_trap_word(isa), Nil)
    TLet(nm, v, b) => let vw = mcu_compile_expr(v, slots, fns_off, isa) in let stw = Cons(mcu_inst(6, 0, tg_slot_idx(slots, nm)), Nil) in tg_app(vw, tg_app(stw, mcu_compile_expr(b, slots, fns_off, isa)))
    TBin(op, l, r) => let lw = mcu_compile_expr(l, slots, fns_off, isa) in let rw = mcu_compile_expr(r, slots, fns_off, isa) in tg_app(lw, tg_app(rw, Cons(mcu_inst(7, mcu_alu_sub(op), 0), Nil)))
    TIf(c, t, f)   => let cw = mcu_compile_expr(c, slots, fns_off, isa) in let tw = mcu_compile_expr(t, slots, fns_off, isa) in let fw = mcu_compile_expr(f, slots, fns_off, isa) in let jz_w = mcu_inst(8, 0, tg_len(tw) + 1) in let jmp_w = mcu_inst(9, 0, tg_len(fw)) in tg_app(cw, Cons(jz_w, tg_app(tw, Cons(jmp_w, fw))))
    TCall(nm, xs)  => let aw = mcu_compile_args(xs, slots, fns_off, isa) in let target_pc = tg_lookup_val(fns_off, nm) in tg_app(aw, Cons(mcu_inst(10, tg_len(xs), target_pc), Nil))
    _              => Cons(mcu_inst(1, 0, 0), Nil)

fn mcu_compile_fn(f, fns_off, isa) = let slots = tg_collect_locals(f.body, f.ps) in let bw = mcu_compile_expr(f.body, slots, fns_off, isa) in tg_app(bw, Cons(mcu_inst(11, 0, 0), Nil))

fn mcu_compile_fns_pass(fns, fns_off, cur_off, isa) = match fns
    Nil        => {words: Nil, offs: Nil, end_off: cur_off}
    Cons(f, r) => let fns_off1 = Cons({k: f.nm, v: cur_off}, fns_off) in let fw = mcu_compile_fn(f, fns_off1, isa) in let next_off = cur_off + tg_len(fw) in let rest = mcu_compile_fns_pass(r, fns_off1, next_off, isa) in {words: tg_app(fw, rest.words), offs: Cons({k: f.nm, v: cur_off}, rest.offs), end_off: rest.end_off}

fn mcu_compile_prints(ps, fns_off, isa) = match ps
    Nil        => Nil
    Cons(p, r) => let ew = mcu_compile_expr(p, Nil, fns_off, isa) in tg_app(ew, Cons(mcu_out_word(isa), mcu_compile_prints(r, fns_off, isa)))

fn enc_mcu_program(ifns, prints, isa) = let p1 = mcu_compile_fns_pass(ifns, Nil, 1, isa) in let p2 = mcu_compile_fns_pass(ifns, p1.offs, 1, isa) in let start_off = p2.end_off in let j0 = mcu_inst(9, 0, start_off - 1) in let pr = mcu_compile_prints(prints, p2.offs, isa) in let all_w = Cons(j0, tg_app(p2.words, tg_app(pr, Cons(mcu_halt_word(isa), Nil)))) in a64_words_to_bytes(all_w)

## 84-byte ELF32 container (`EI_CLASS=1`, `e_machine=83` for AVR or `94` for Xtensa, `e_entry=0x8054`)
fn container_elf32(code_bytes, e_machine) = let base_va = 32768 in let entry = base_va + 84 in let filesz = 84 + tg_len(code_bytes) in let ident = Cons(127, Cons(69, Cons(76, Cons(70, Cons(1, Cons(1, Cons(1, tg_zeros(9)))))))) in let ehdr = tg_app(ident, tg_app(tg_b2(2), tg_app(tg_b2(e_machine), tg_app(tg_b4(1), tg_app(tg_b4(entry), tg_app(tg_b4(52), tg_app(tg_b4(0), tg_app(tg_b4(0), tg_app(tg_b2(52), tg_app(tg_b2(32), tg_app(tg_b2(1), tg_zeros(6)))))))))))) in let phdr = tg_app(tg_b4(1), tg_app(tg_b4(0), tg_app(tg_b4(base_va), tg_app(tg_b4(base_va), tg_app(tg_b4(filesz), tg_app(tg_b4(filesz), tg_app(tg_b4(7), tg_b4(4096)))))))) in tg_app(ehdr, tg_app(phdr, code_bytes))

## ARM Cortex-M Thumb-2 Firmware Image: Vector Table (`MSP=0x20020000`, `Reset_Handler=0x08000009`) + code
fn container_cortexm_bin(code_bytes) = tg_app(tg_b4(537001984), tg_app(tg_b4(134217737), code_bytes))

fn tg_bytes_to_words(bs) = match bs
    Nil        => Nil
    Cons(b0, r) => let b1 = tg_nth(r, 0) in let b2 = tg_nth(r, 1) in let b3 = tg_nth(r, 2) in Cons(b0 + b1 * 256 + b2 * 65536 + b3 * 16777216, tg_bytes_to_words(ihex_drop(bs, 4)))

fn ihex_decode_lines(ls, acc_bytes) = match ls
    Nil        => {ok: 1, bytes: acc_bytes, diag: ""}
    Cons(l, r) => if count(l) == 0 then ihex_decode_lines(r, acc_bytes) else if at(l, 0) != ":" then {ok: 0, bytes: Nil, diag: "[T0902] error: invalid Intel HEX record prefix"} else let bs = tg_hex_to_bytes(slice(l, 1, count(l))) in let n = tg_len(bs) in if n < 5 then {ok: 0, bytes: Nil, diag: "[T0902] error: truncated Intel HEX record"} else let ll = tg_nth(bs, 0) in if n != ll + 5 then {ok: 0, bytes: Nil, diag: "[T0902] error: Intel HEX record length mismatch"} else if (ihex_sum_bytes(bs) % 256) != 0 then {ok: 0, bytes: Nil, diag: "[T0902] error: Intel HEX checksum mismatch"} else let rtype = tg_nth(bs, 3) in if rtype == 1 then {ok: 1, bytes: acc_bytes, diag: ""} else if rtype == 0 then ihex_decode_lines(r, tg_app(acc_bytes, ihex_take(ihex_drop(bs, 4), ll))) else ihex_decode_lines(r, acc_bytes)

fn ihex_decode_and_verify(ihex_txt) = ihex_decode_lines(tg_kvm_lines(ihex_txt), Nil)

fn tg_hd_int(xs) = match xs
    Nil        => 0
    Cons(h, t) => h

fn tg_hd_frame(xs) = match xs
    Nil        => {ret_pc: 0, old_fp: 0}
    Cons(h, t) => h

fn mcu_mem_get(mem, idx) = match mem
    Nil        => 0
    Cons(h, t) => if h.idx == idx then h.v else mcu_mem_get(t, idx)

fn mcu_pop_args(stk, mem, base_fp, slot_i) = if slot_i < 0 then {stk: stk, mem: mem} else let v = tg_hd_int(stk) in mcu_pop_args(tg_drop(stk), Cons({idx: base_fp + slot_i, v: v}, mem), base_fp, slot_i - 1)

fn mcu_vm_step(words, nwords, isa, st) = if st.pc < 0 or st.pc >= nwords then {pc: st.pc, fp: st.fp, stack: st.stack, cstack: st.cstack, mem: st.mem, out: st.out, status: 1, done: 1} else let w = tg_nth(words, st.pc) in let op = w % 256 in let sub = (w / 256) % 256 in let hi16 = (w / 65536) % 65536 in let arg = hi16 - 32768 in if op == 1 then {pc: st.pc + 1, fp: st.fp, stack: Cons(arg, st.stack), cstack: st.cstack, mem: st.mem, out: st.out, status: 0, done: 0} else if op == 2 then (if hi16 == mcu_trap_hi16(isa) then {pc: st.pc, fp: st.fp, stack: st.stack, cstack: st.cstack, mem: st.mem, out: st.out, status: 3, done: 1} else {pc: st.pc, fp: st.fp, stack: st.stack, cstack: st.cstack, mem: st.mem, out: st.out, status: 1, done: 1}) else if op == 3 then (if hi16 != mcu_out_hi16(isa) then {pc: st.pc, fp: st.fp, stack: st.stack, cstack: st.cstack, mem: st.mem, out: st.out, status: 1, done: 1} else let v = tg_hd_int(st.stack) in {pc: st.pc + 1, fp: st.fp, stack: tg_drop(st.stack), cstack: st.cstack, mem: st.mem, out: tg_append_out(st.out, v), status: 0, done: 0}) else if op == 4 then (if hi16 == mcu_halt_hi16(isa) then {pc: st.pc, fp: st.fp, stack: st.stack, cstack: st.cstack, mem: st.mem, out: st.out, status: 0, done: 1} else {pc: st.pc, fp: st.fp, stack: st.stack, cstack: st.cstack, mem: st.mem, out: st.out, status: 1, done: 1}) else if op == 5 then {pc: st.pc + 1, fp: st.fp, stack: Cons(mcu_mem_get(st.mem, st.fp + arg), st.stack), cstack: st.cstack, mem: st.mem, out: st.out, status: 0, done: 0} else if op == 6 then {pc: st.pc + 1, fp: st.fp, stack: tg_drop(st.stack), cstack: st.cstack, mem: Cons({idx: st.fp + arg, v: tg_hd_int(st.stack)}, st.mem), out: st.out, status: 0, done: 0} else if op == 7 then (let rhs = tg_hd_int(st.stack) in let s1 = tg_drop(st.stack) in let lhs = tg_hd_int(s1) in let s2 = tg_drop(s1) in {pc: st.pc + 1, fp: st.fp, stack: Cons(mcu_alu_eval(sub, lhs, rhs), s2), cstack: st.cstack, mem: st.mem, out: st.out, status: 0, done: 0}) else if op == 8 then (let cond = tg_hd_int(st.stack) in let next_pc = if cond == 0 then st.pc + 1 + arg else st.pc + 1 in {pc: next_pc, fp: st.fp, stack: tg_drop(st.stack), cstack: st.cstack, mem: st.mem, out: st.out, status: 0, done: 0}) else if op == 9 then {pc: st.pc + 1 + arg, fp: st.fp, stack: st.stack, cstack: st.cstack, mem: st.mem, out: st.out, status: 0, done: 0} else if op == 10 then (let new_fp = st.fp + 16 in let pa = mcu_pop_args(st.stack, st.mem, new_fp, sub - 1) in {pc: arg, fp: new_fp, stack: pa.stk, cstack: Cons({ret_pc: st.pc + 1, old_fp: st.fp}, st.cstack), mem: pa.mem, out: st.out, status: 0, done: 0}) else if op == 11 then (let fr = tg_hd_frame(st.cstack) in {pc: fr.ret_pc, fp: fr.old_fp, stack: st.stack, cstack: tg_drop(st.cstack), mem: st.mem, out: st.out, status: 0, done: 0}) else {pc: st.pc, fp: st.fp, stack: st.stack, cstack: st.cstack, mem: st.mem, out: st.out, status: 1, done: 1}

fn mcu_vm_loop(words, nwords, isa, st, fuel) = if st.done == 1 or fuel <= 0 then st else mcu_vm_loop(words, nwords, isa, mcu_vm_step(words, nwords, isa, st), fuel - 1)

fn mcu_extract_code(isa, raw_bytes, is_ihex) = if is_ihex == 1 then {ok: 1, code: raw_bytes, diag: ""} else if isa == "cortexm" then (if tg_len(raw_bytes) < 12 then {ok: 0, code: Nil, diag: "[T0902] error: truncated Cortex-M firmware image"} else let words = tg_bytes_to_words(raw_bytes) in if tg_nth(words, 0) != 537001984 or tg_nth(words, 1) != 134217737 then {ok: 0, code: Nil, diag: "[T0902] error: invalid Cortex-M vector table"} else {ok: 1, code: ihex_drop(raw_bytes, 8), diag: ""}) else (let exp_mach = if isa == "avr" then 83 else 94 in if tg_len(raw_bytes) < 88 then {ok: 0, code: Nil, diag: "[T0902] error: truncated ELF32 MCU binary"} else if tg_nth(raw_bytes, 0) != 127 or tg_nth(raw_bytes, 1) != 69 or tg_nth(raw_bytes, 2) != 76 or tg_nth(raw_bytes, 3) != 70 or tg_nth(raw_bytes, 4) != 1 or tg_nth(raw_bytes, 18) != exp_mach then {ok: 0, code: Nil, diag: "[T0902] error: invalid ELF32 header or e_machine mismatch for " + isa} else {ok: 1, code: ihex_drop(raw_bytes, 84), diag: ""})

fn mcu_vm_run(isa, raw_bytes, is_ihex) = let ex = mcu_extract_code(isa, raw_bytes, is_ihex) in if ex.ok == 0 then {ok: 0, status: 1, output: ex.diag} else let words = tg_bytes_to_words(ex.code) in let init_st = {pc: 0, fp: 0, stack: Nil, cstack: Nil, mem: Nil, out: "", status: 0, done: 0} in let fin = mcu_vm_loop(words, tg_len(words), isa, init_st, 4096) in {ok: if fin.status == 0 and fin.done == 1 then 1 else 0, status: fin.status, output: fin.out}

## --- 7i. FPGA / HDL Backends (`verilog-rtl` IEEE 1364-2005 & `vhdl-rtl` IEEE 1076-2008) + Cycle-Accurate RTL Simulator ---

fn hdl_decl_w(lang, wnm, expr_s) = if lang == "v" then "  wire signed [63:0] " + wnm + " = " + expr_s + ";\n" else "  signal " + wnm + " : integer := " + expr_s + ";\n"

fn hdl_decl_t(lang, tnm, expr_s) = if lang == "v" then "  wire " + tnm + " = " + expr_s + ";\n" else "  signal " + tnm + " : integer := " + expr_s + ";\n"

fn hdl_or_op(lang) = if lang == "v" then "|" else "or"

fn hdl_mux_expr(lang, cond_w, tv, fv) = if lang == "v" then cond_w + " ? " + tv + " : " + fv else tv + " when " + cond_w + " /= 0 else " + fv

fn hdl_lower_e(e, id, env, lang) = match e
    TNum(n)        => let w = "w_" + str(id) in let t = "t_" + str(id) in {code: hdl_decl_w(lang, w, str(n)) + hdl_decl_t(lang, t, "0"), w: w, t: t, next: id + 1}
    TVar(nm)       => let w = "w_" + str(id) in let t = "t_" + str(id) in let ssa = tg_lookup_ssa(env, nm) in {code: hdl_decl_w(lang, w, "v_" + ssa) + hdl_decl_t(lang, t, "0"), w: w, t: t, next: id + 1}
    TTrap          => let w = "w_" + str(id) in let t = "t_" + str(id) in {code: hdl_decl_w(lang, w, "0") + hdl_decl_t(lang, t, "1"), w: w, t: t, next: id + 1}
    TLet(nm, v, b) => let rv = hdl_lower_e(v, id, env, lang) in let ssa = nm + "_" + str(rv.next) in let vdecl = hdl_decl_w(lang, "v_" + ssa, rv.w) in let rb = hdl_lower_e(b, rv.next + 1, Cons({k: nm, ssa: ssa}, env), lang) in let t = "t_" + str(rb.next) in let tdecl = hdl_decl_t(lang, t, rv.t + " " + hdl_or_op(lang) + " " + rb.t) in {code: rv.code + vdecl + rb.code + tdecl, w: rb.w, t: t, next: rb.next + 1}
    TBin(op, l, r) => let rl = hdl_lower_e(l, id, env, lang) in let rr = hdl_lower_e(r, rl.next, env, lang) in let id2 = rr.next in let w = "w_" + str(id2) in let t = "t_" + str(id2) in let wdecl = hdl_decl_w(lang, w, rl.w + " " + op + " " + rr.w) in let tdecl = hdl_decl_t(lang, t, rl.t + " " + hdl_or_op(lang) + " " + rr.t) in {code: rl.code + rr.code + wdecl + tdecl, w: w, t: t, next: id2 + 1}
    TIf(c, tr, fl) => let rc = hdl_lower_e(c, id, env, lang) in let rt = hdl_lower_e(tr, rc.next, env, lang) in let rf = hdl_lower_e(fl, rt.next, env, lang) in let id2 = rf.next in let w = "w_" + str(id2) in let tm = "tm_" + str(id2) in let t = "t_" + str(id2) in let wdecl = hdl_decl_w(lang, w, hdl_mux_expr(lang, rc.w, rt.w, rf.w)) in let tmdecl = hdl_decl_t(lang, tm, hdl_mux_expr(lang, rc.w, rt.t, rf.t)) in let tdecl = hdl_decl_t(lang, t, rc.t + " " + hdl_or_op(lang) + " " + tm) in {code: rc.code + rt.code + rf.code + wdecl + tmdecl + tdecl, w: w, t: t, next: id2 + 1}
    _              => let w = "w_" + str(id) in let t = "t_" + str(id) in {code: hdl_decl_w(lang, w, "0") + hdl_decl_t(lang, t, "0"), w: w, t: t, next: id + 1}

fn hdl_lower_prints(ps, ifns, idx, id, prev_t, lang) = match ps
    Nil        => {decls: "", assigns: "", final_t: prev_t, count: idx}
    Cons(p, r) => let inl = tg_inline_expr(p, ifns, 6) in let b = hdl_lower_e(inl, id, Nil, lang) in let comb_t = "t_all_" + str(idx) in let ct_decl = hdl_decl_t(lang, comb_t, prev_t + " " + hdl_or_op(lang) + " " + b.t) in let asgn = "      out_" + str(idx) + " <= " + b.w + ";\n" in let rest = hdl_lower_prints(r, ifns, idx + 1, b.next + 1, comb_t, lang) in {decls: b.code + ct_decl + rest.decls, assigns: asgn + rest.assigns, final_t: rest.final_t, count: rest.count}

fn hdl_v_ports(n, i) = if i >= n then "" else ",\n  output reg signed [63:0] out_" + str(i) + hdl_v_ports(n, i + 1)

fn hdl_vhd_ports(n, i) = if i >= n then "" else ";\n    out_" + str(i) + " : out integer" + hdl_vhd_ports(n, i + 1)

fn enc_verilog_rtl(ifns, prints) = let mnm = ptx_entry_name(ifns) in let ps = (if tg_isnil(prints) == 0 then prints else Cons(TNum(0), Nil)) in let b = hdl_lower_prints(ps, ifns, 0, 0, "t_init", "v") in "// Synthesizable IEEE 1364-2005 Verilog RTL generated by Lume\nmodule " + mnm + "(\n  input wire clk,\n  input wire rst,\n  output reg done,\n  output reg trap" + hdl_v_ports(b.count, 0) + "\n);\n  wire t_init = 0;\n" + b.decls + "  always @(posedge clk) begin\n    if (rst) begin\n      done <= 0;\n      trap <= 0;\n    end else begin\n      trap <= " + b.final_t + ";\n" + b.assigns + "      done <= 1;\n    end\n  end\nendmodule\n"

fn enc_vhdl_rtl(ifns, prints) = let mnm = ptx_entry_name(ifns) in let ps = (if tg_isnil(prints) == 0 then prints else Cons(TNum(0), Nil)) in let b = hdl_lower_prints(ps, ifns, 0, 0, "t_init", "vhd") in "-- Synthesizable IEEE 1076-2008 VHDL RTL generated by Lume\nlibrary ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity " + mnm + " is\n  port (\n    clk : in std_logic;\n    rst : in std_logic;\n    done : out integer;\n    trap : out integer" + hdl_vhd_ports(b.count, 0) + "\n  );\nend entity;\n\narchitecture rtl of " + mnm + " is\n  signal t_init : integer := 0;\n" + b.decls + "begin\n  process(clk)\n  begin\n    if rising_edge(clk) then\n      if rst = '1' then\n        done <= 0;\n        trap <= 0;\n      else\n        trap <= " + b.final_t + ";\n" + b.assigns + "        done <= 1;\n      end if;\n    end if;\n  end process;\nend architecture;\n"

fn hdl_find_tok(toks, kw, i) = match toks
    Nil        => 0 - 1
    Cons(h, t) => if h == kw then i else hdl_find_tok(t, kw, i + 1)

fn hdl_eval_rhs(toks, idx, n, sigs) = let rem = n - idx in if rem <= 0 then 0 else if rem == 1 then tg_kvm_val(tg_tok_at(toks, idx), sigs) else if rem == 3 then (let op = tg_tok_at(toks, idx + 1) in let a = tg_kvm_val(tg_tok_at(toks, idx), sigs) in let b = tg_kvm_val(tg_tok_at(toks, idx + 2), sigs) in if op == "|" or op == "or" then tg_eval_bin("or", a, b) else tg_eval_bin(op, a, b)) else if rem >= 5 and tg_tok_at(toks, idx + 1) == "?" then (if tg_kvm_val(tg_tok_at(toks, idx), sigs) != 0 then tg_kvm_val(tg_tok_at(toks, idx + 2), sigs) else tg_kvm_val(tg_tok_at(toks, idx + 4), sigs)) else if rem >= 7 and tg_tok_at(toks, idx + 1) == "when" then (if tg_kvm_val(tg_tok_at(toks, idx + 2), sigs) != 0 then tg_kvm_val(tg_tok_at(toks, idx), sigs) else tg_kvm_val(tg_tok_at(toks, idx + 6), sigs)) else tg_kvm_val(tg_tok_at(toks, idx), sigs)

fn hdl_sim_line(toks, sigs) = let n = tg_len(toks) in if n < 3 then sigs else let t0 = tg_tok_at(toks, 0) in if t0 == "wire" then (let eq_i = hdl_find_tok(toks, "=", 0) in if eq_i > 0 then (let dst = tg_tok_at(toks, eq_i - 1) in Cons({k: dst, v: hdl_eval_rhs(toks, eq_i + 1, n, sigs)}, sigs)) else sigs) else if t0 == "signal" then (let eq_i = hdl_find_tok(toks, ":=", 0) in if eq_i > 0 then (let dst = tg_tok_at(toks, 1) in Cons({k: dst, v: hdl_eval_rhs(toks, eq_i + 1, n, sigs)}, sigs)) else sigs) else if tg_tok_at(toks, 1) == "<=" and (t0 == "trap" or t0 == "done" or slice(t0, 0, 4) == "out_") then Cons({k: t0, v: hdl_eval_rhs(toks, 2, n, sigs)}, sigs) else sigs

fn hdl_sim_lines(ls, sigs) = match ls
    Nil        => sigs
    Cons(l, r) => hdl_sim_lines(r, hdl_sim_line(tg_kvm_toks(l), sigs))

fn hdl_has_sig(sigs, nm) = match sigs
    Nil        => 0
    Cons(h, t) => if h.k == nm then 1 else hdl_has_sig(t, nm)

fn hdl_collect_outs(sigs, idx, acc) = let nm = "out_" + str(idx) in if hdl_has_sig(sigs, nm) == 0 then acc else hdl_collect_outs(sigs, idx + 1, tg_append_out(acc, tg_lookup_val(sigs, nm)))

fn hdl_vm_run(hdl_src) = let is_v = (if tg_str_has(hdl_src, "module ") == 1 and tg_str_has(hdl_src, "always @(posedge clk)") == 1 and tg_str_has(hdl_src, "endmodule") == 1 then 1 else 0) in let is_vhd = (if tg_str_has(hdl_src, "entity ") == 1 and tg_str_has(hdl_src, "rising_edge(clk)") == 1 and tg_str_has(hdl_src, "end architecture;") == 1 then 1 else 0) in if is_v == 0 and is_vhd == 0 then {ok: 0, status: 1, output: "[T0902] error: invalid Verilog/VHDL RTL module"} else let sigs = hdl_sim_lines(tg_kvm_lines(hdl_src), Nil) in if tg_lookup_val(sigs, "trap") != 0 then {ok: 0, status: 3, output: ""} else {ok: 1, status: 0, output: hdl_collect_outs(sigs, 0, "")}

## --- 7j. Mobile (`aarch64-ios-macho`, `aarch64-android-elf`) & Browser/Web (`wasm32-web-dom`) Containers ---

fn container_macho64_ios_hdr(csz, cpu_type) = container_macho64_hdr_p(csz, cpu_type, 2, 1114112)

fn container_macho64_ios_hex(code_bytes, cpu_type) = let csz = tg_len(code_bytes) in let hdr_all = container_macho64_ios_hdr(csz, cpu_type) in let pad_hdr_n = 1024 - tg_len(hdr_all) in let pad_text_n = 16384 - 1024 - csz in tg_bytes_to_hex(hdr_all) + tg_repeat_str("00", pad_hdr_n) + tg_bytes_to_hex(code_bytes) + tg_repeat_str("00", pad_text_n) + tg_bytes_to_hex(container_macho64_linkedit_bytes())

## Android Bionic ELF64 (`aarch64-android-elf`): 2 PHDRs (`PT_LOAD=1`, `PT_NOTE=4`) + 24-byte `.note.android.ident` (API 34)
fn container_elf64_android(code_bytes) = let base_va = 4194304 in let entry = base_va + 200 in let filesz = 200 + tg_len(code_bytes) in let ident = Cons(127, Cons(69, Cons(76, Cons(70, Cons(2, Cons(1, Cons(1, tg_zeros(9)))))))) in let ehdr = tg_app(ident, tg_app(tg_b2(2), tg_app(tg_b2(183), tg_app(tg_b4(1), tg_app(tg_b8(entry), tg_app(tg_b8(64), tg_app(tg_b8(0), tg_app(tg_b4(0), tg_app(tg_b2(64), tg_app(tg_b2(56), tg_app(tg_b2(2), tg_zeros(6)))))))))))) in let phdr_load = tg_app(tg_b4(1), tg_app(tg_b4(7), tg_app(tg_b8(0), tg_app(tg_b8(base_va), tg_app(tg_b8(base_va), tg_app(tg_b8(filesz), tg_app(tg_b8(filesz), tg_b8(65536)))))))) in let phdr_note = tg_app(tg_b4(4), tg_app(tg_b4(4), tg_app(tg_b8(176), tg_app(tg_b8(base_va + 176), tg_app(tg_b8(base_va + 176), tg_app(tg_b8(24), tg_app(tg_b8(24), tg_b8(4)))))))) in let android_note = tg_app(tg_b4(8), tg_app(tg_b4(4), tg_app(tg_b4(1), tg_app(tg_str_pad("Android", 8), tg_b4(34))))) in tg_app(ehdr, tg_app(phdr_load, tg_app(phdr_note, tg_app(android_note, code_bytes))))

## Browser / Web WASM + DOM (`wasm32-web-dom`): imports `env.dom_append_int`, `env.dom_set_attr`, `env.web_trap`; exports `lume_web_main` & `_start`
fn wasm_web_prints(ps, ifns) = match ps
    Nil        => Nil
    Cons(p, r) => tg_app(wasm_compile_expr(p, Nil, ifns), tg_app(Cons(16, Cons(0, Nil)), wasm_web_prints(r, ifns)))

fn container_wasm32_web_dom(ifns, prints) = let nfns = tg_len(ifns) in let magic = Cons(0, Cons(97, Cons(115, Cons(109, Cons(1, Cons(0, Cons(0, Cons(0, Nil)))))))) in let base_types = Cons(96, Cons(2, Cons(127, Cons(127, Cons(0, Cons(96, Cons(1, Cons(127, Cons(0, Cons(96, Cons(0, Cons(0, Nil)))))))))))) in let tsec = wasm_sec(1, tg_app(wasm_uleb(3 + nfns), tg_app(base_types, wasm_fn_types(ifns)))) in let imp0 = tg_app(wasm_str("env"), tg_app(wasm_str("dom_append_int"), Cons(0, Cons(1, Nil)))) in let imp1 = tg_app(wasm_str("env"), tg_app(wasm_str("web_trap"), Cons(0, Cons(1, Nil)))) in let imp2 = tg_app(wasm_str("env"), tg_app(wasm_str("dom_set_attr"), Cons(0, Cons(0, Nil)))) in let isec = wasm_sec(2, Cons(3, tg_app(imp0, tg_app(imp1, imp2)))) in let fsec = wasm_sec(3, tg_app(wasm_uleb(1 + nfns), Cons(2, wasm_fn_type_idxs(ifns, 3)))) in let msec = wasm_sec(5, Cons(1, Cons(0, Cons(1, Nil)))) in let exp1 = tg_app(wasm_str("memory"), Cons(2, Cons(0, Nil))) in let exp2 = tg_app(wasm_str("lume_web_main"), Cons(0, Cons(3, Nil))) in let exp3 = tg_app(wasm_str("_start"), Cons(0, Cons(3, Nil))) in let esec = wasm_sec(7, Cons(3, tg_app(exp1, tg_app(exp2, exp3)))) in let start_b = Cons(0, tg_app(wasm_web_prints(prints, ifns), Cons(11, Nil))) in let csec = wasm_sec(10, tg_app(wasm_uleb(1 + nfns), tg_app(wasm_with_len(start_b), wasm_fn_bodies(ifns, ifns)))) in tg_app(magic, tg_app(tsec, tg_app(isec, tg_app(fsec, tg_app(msec, tg_app(esec, csec))))))

## --- 8. Top-Level Target Compilation Entrypoint ---

fn target_compile_fmt(tp, ifns, prints, elided) = if tp.fmt == "lumb" then (let lb = container_lumb(ifns, prints) in {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: lb, hex: tg_bytes_to_hex(lb), ihex: ""}) else if tp.fmt == "wasm" then (let wb = container_wasm32(ifns, prints) in {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: wb, hex: tg_bytes_to_hex(wb), ihex: ""}) else if tp.fmt == "wasm-dom" then (let wb = container_wasm32_web_dom(ifns, prints) in {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: wb, hex: tg_bytes_to_hex(wb), ihex: ""}) else if tp.fmt == "ptx" then {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: Nil, hex: "", ihex: enc_ptx_program(ifns, prints)} else if tp.fmt == "spvasm" then {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: Nil, hex: "", ihex: enc_spirv_program(ifns, prints)} else if tp.fmt == "verilog" then {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: Nil, hex: "", ihex: enc_verilog_rtl(ifns, prints)} else if tp.fmt == "vhdl" then {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: Nil, hex: "", ihex: enc_vhdl_rtl(ifns, prints)} else if tp.fmt == "cortexm-bin" then (let mc = enc_mcu_program(ifns, prints, "cortexm") in let bin = container_cortexm_bin(mc) in {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: bin, hex: tg_bytes_to_hex(bin), ihex: ""}) else if tp.fmt == "elf32" then (let mc = enc_mcu_program(ifns, prints, tp.isa) in let bin = container_elf32(mc, tp.e_machine) in {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: bin, hex: tg_bytes_to_hex(bin), ihex: ""}) else if tp.fmt == "ihex" and (tp.isa == "avr" or tp.isa == "xtensa") then (let mc = enc_mcu_program(ifns, prints, tp.isa) in {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: mc, hex: tg_bytes_to_hex(mc), ihex: container_ihex(mc)}) else let code = (if tp.isa == "aarch64" then enc_aarch64_program(ifns, prints, tp.abi) else if tp.isa == "riscv64" then enc_riscv64_program(ifns, prints, tp.abi) else enc_x86_64_program(ifns, prints, tp.abi)) in if tp.fmt == "ihex" then {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: code, hex: tg_bytes_to_hex(code), ihex: container_ihex(code)} else if tp.fmt == "macho64" then {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: container_macho64_hdr(tg_len(code), tp.e_machine), hex: container_macho64_hex(code, tp.e_machine), ihex: ""} else if tp.fmt == "macho64-ios" then {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: container_macho64_ios_hdr(tg_len(code), tp.e_machine), hex: container_macho64_ios_hex(code, tp.e_machine), ihex: ""} else if tp.fmt == "elf64-android" then (let bin = container_elf64_android(code) in {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: bin, hex: tg_bytes_to_hex(bin), ihex: ""}) else if tp.fmt == "pe64" then {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: container_pe64_hdr(tg_len(code)), hex: container_pe64_hex(code), ihex: ""} else let bin = container_elf64(code, tp.e_machine) in {ok: 1, triple: tp.triple, diag: "", guards_elided: elided, bytes: bin, hex: tg_bytes_to_hex(bin), ihex: ""}

fn target_compile(triple, src) = let tp = target_parse_triple(triple) in if tp.valid == 0 then {ok: 0, triple: triple, diag: tp.diag, guards_elided: 0, bytes: Nil, hex: "", ihex: ""} else let toks = tg_lex(src, 0, count(src)) in let parsed = tg_parse_prog(toks) in let unsup = tg_check_prog_supported(parsed.fns, parsed.prints) in if unsup != "" then {ok: 0, triple: tp.triple, diag: "[T0900] error: construct '" + unsup + "' is outside the native target fragment for '" + tp.triple + "'", guards_elided: 0, bytes: Nil, hex: "", ihex: ""} else let ifns = tg_instrument_all(parsed.fns, parsed.fns) in let ref_nm = tg_has_refuted(ifns) in if ref_nm != "" then {ok: 0, triple: tp.triple, diag: "[V0001] error: contract on '" + ref_nm + "' refuted at compile time for target '" + tp.triple + "'", guards_elided: 0, bytes: Nil, hex: "", ihex: ""} else target_compile_fmt(tp, ifns, parsed.prints, tg_count_elided(ifns))

## --- 9. Unit & Mechanism Tests (`lume test compiler/stage1/ltarget.src`) ---

fn test_t0_orthogonal_target_triple_registry() = let t1 = target_parse_triple("aarch64-linux-elf") in let t2 = target_parse_triple("aarch64-macos-macho") in let t2x = target_parse_triple("x86_64-macos-macho") in let t3 = target_parse_triple("x86_64-windows-pe") in let t4 = target_parse_triple("riscv64-linux-elf") in let t5 = target_parse_triple("aarch64-none-ihex") in let t6 = target_parse_triple("lumb") in let t7 = target_parse_triple("wasm32-wasi") in let t8 = target_parse_triple("nvptx64-nvidia-cuda") in let t9 = target_parse_triple("spirv64-vulkan-compute") in let t10 = target_parse_triple("arm-none-cortexm") in let t11 = target_parse_triple("avr-none-elf") in let t12 = target_parse_triple("xtensa-esp32-elf") in let t13 = target_parse_triple("verilog-rtl") in let t14 = target_parse_triple("vhdl-rtl") in let t15 = target_parse_triple("aarch64-ios-macho") in let t16 = target_parse_triple("aarch64-android-elf") in let t17 = target_parse_triple("wasm32-web-dom") in let bad = target_parse_triple("mips64-unknown-coff") in if t1.valid == 1 and t2.valid == 1 and t2x.valid == 1 and t3.valid == 1 and t4.valid == 1 and t5.valid == 1 and t6.valid == 1 and t7.valid == 1 and t8.valid == 1 and t9.valid == 1 and t10.valid == 1 and t11.valid == 1 and t12.valid == 1 and t13.valid == 1 and t14.valid == 1 and t15.valid == 1 and t16.valid == 1 and t17.valid == 1 and bad.valid == 0 then 1 else 0

fn test_t1_t2_aarch64_elf_and_macho_proof_preserving() = let src = "fn clamp_pos(x: int) -> int requires x >= 0 ensures result >= 0 = x + 5\nfn add_pair(a: int, b: int) -> int = clamp_pos(a) + b\nprint add_pair(17, 20)\n" in let r_elf = target_compile("aarch64-linux-elf", src) in let r_macho = target_compile("aarch64-macos-macho", src) in let d_code = x64_ctfail_bytes("sysv64-darwin") in if r_elf.ok == 1 and r_elf.guards_elided == 1 and tg_nth(r_elf.bytes, 0) == 127 and tg_nth(r_elf.bytes, 18) == 183 and r_macho.ok == 1 and r_macho.guards_elided == 1 and tg_nth(r_macho.bytes, 0) == 207 and tg_nth(r_macho.bytes, 1) == 250 and tg_nth(r_macho.bytes, 4) == 12 and count(r_macho.hex) == 32864 and tg_nth(d_code, 6) == 1 and tg_nth(d_code, 9) == 2 then 1 else 0

fn test_t3_t4_pe64_and_riscv64_and_refuted_contract_rejection() = let src_ok = "fn scale(x: int) -> int requires x >= 1 ensures result >= 2 = x + x\nprint scale(21)\n" in let src_bad = "fn broken(x: int) -> int requires x >= 0 ensures result >= 0 = 5 - x\nprint broken(10)\n" in let r_pe = target_compile("x86_64-windows-pe", src_ok) in let r_rv = target_compile("riscv64-linux-elf", src_ok) in let r_wasm = target_compile("wasm32-wasi", src_ok) in let r_bad = target_compile("riscv64-linux-elf", src_bad) in if r_pe.ok == 1 and tg_nth(r_pe.bytes, 0) == 77 and tg_nth(r_pe.bytes, 1) == 90 and tg_nth(r_pe.bytes, 64) == 80 and tg_nth(r_pe.bytes, 65) == 69 and count(r_pe.hex) == 4096 and r_rv.ok == 1 and tg_nth(r_rv.bytes, 18) == 243 and r_wasm.ok == 1 and tg_nth(r_wasm.bytes, 0) == 0 and tg_nth(r_wasm.bytes, 1) == 97 and r_bad.ok == 0 then 1 else 0

fn test_t5_ihex_checksum_and_lumb_bytecode_vm() = let src = "fn fib_step(a: int, b: int) -> int requires a >= 0 requires b >= 0 ensures result >= 0 = a + b\nprint fib_step(20, 22)\n" in let r_hex = target_compile("x86_64-none-ihex", src) in let r_lumb = target_compile("lumb", src) in let vm = lumb_verify_and_run(r_lumb.bytes) in if r_hex.ok == 1 and slice(r_hex.ihex, 0, 15) == ":020000040001F9" and r_lumb.ok == 1 and vm.ok == 1 and vm.status == 0 and vm.guards_elided == 1 and vm.output == "42" then 1 else 0

fn test_t6_gpu_ptx_and_spirv_lowering_and_vm() = let src_ok = "@schedule(tile: 64) kernel fn fused_mac(x: int, w: int, b: int) -> int / gpu requires x >= 0 ensures result >= 0 = let z = x * w + b in if z > 0 then z else 0\nprint fused_mac(6, 7, -2)\nprint fused_mac(3, -5, 1)\n" in let src_trap = "kernel fn sq_guard(x: int) -> int / gpu requires x * x >= 25 = x * x + 2\nprint sq_guard(3)\n" in let r_ptx = target_compile("nvptx64-nvidia-cuda", src_ok) in let r_spv = target_compile("spirv64-vulkan-compute", src_ok) in let vm_ptx = ptx_vm_run(r_ptx.ihex) in let vm_spv = spirv_vm_run(r_spv.ihex) in let rt_ptx = target_compile("nvptx64-nvidia-cuda", src_trap) in let rt_spv = target_compile("spirv64-vulkan-compute", src_trap) in let vmt_ptx = ptx_vm_run(rt_ptx.ihex) in let vmt_spv = spirv_vm_run(rt_spv.ihex) in let bad_ptx = ptx_vm_run("corrupted ptx") in if r_ptx.ok == 1 and r_spv.ok == 1 and vm_ptx.ok == 1 and vm_ptx.output == "40\n0" and vm_spv.ok == 1 and vm_spv.output == "40\n0" and vmt_ptx.status == 3 and vmt_spv.status == 3 and bad_ptx.ok == 0 then 1 else 0

fn test_t7_mcu_cortexm_avr_xtensa_and_traps() = let src_ok = "fn clamp_pos(x: int) -> int requires x >= 0 ensures result >= 0 = x + 5\nfn add_pair(a: int, b: int) -> int = clamp_pos(a) + b\nprint add_pair(17, 20)\n" in let src_trap = "fn sq_guard(x: int) -> int requires x * x >= 25 = x * x + 2\nprint sq_guard(3)\n" in let r_cm = target_compile("arm-none-cortexm", src_ok) in let r_avr = target_compile("avr-none-elf", src_ok) in let r_avr_hex = target_compile("avr-none-ihex", src_ok) in let r_xt = target_compile("xtensa-esp32-elf", src_ok) in let vm_cm = mcu_vm_run("cortexm", r_cm.bytes, 0) in let vm_avr = mcu_vm_run("avr", r_avr.bytes, 0) in let dec_hex = ihex_decode_and_verify(r_avr_hex.ihex) in let vm_avr_hex = mcu_vm_run("avr", dec_hex.bytes, 1) in let vm_xt = mcu_vm_run("xtensa", r_xt.bytes, 0) in let rt_cm = target_compile("arm-none-cortexm", src_trap) in let vmt_cm = mcu_vm_run("cortexm", rt_cm.bytes, 0) in let bad_hex = ihex_decode_and_verify(":020000040001FF\n") in if r_cm.ok == 1 and r_cm.guards_elided == 1 and vm_cm.ok == 1 and vm_cm.output == "42" and vm_avr.ok == 1 and vm_avr.output == "42" and dec_hex.ok == 1 and vm_avr_hex.ok == 1 and vm_avr_hex.output == "42" and vm_xt.ok == 1 and vm_xt.output == "42" and vmt_cm.status == 3 and bad_hex.ok == 0 then 1 else 0

fn test_t8_fpga_verilog_and_vhdl_rtl_sim() = let src_ok = "fn mac_step(a: int, b: int, c: int) -> int requires a >= 0 ensures result >= 0 = a + b + c\nprint mac_step(10, 15, 17)\n" in let src_trap = "fn sq_guard(x: int) -> int requires x * x >= 25 = x * x + 2\nprint sq_guard(3)\n" in let r_v = target_compile("verilog-rtl", src_ok) in let r_vhd = target_compile("vhdl-rtl", src_ok) in let sim_v = hdl_vm_run(r_v.ihex) in let sim_vhd = hdl_vm_run(r_vhd.ihex) in let rt_v = target_compile("verilog-rtl", src_trap) in let rt_vhd = target_compile("vhdl-rtl", src_trap) in let simt_v = hdl_vm_run(rt_v.ihex) in let simt_vhd = hdl_vm_run(rt_vhd.ihex) in if r_v.ok == 1 and r_v.guards_elided == 1 and sim_v.ok == 1 and sim_v.output == "42" and sim_vhd.ok == 1 and sim_vhd.output == "42" and simt_v.status == 3 and simt_vhd.status == 3 then 1 else 0

fn test_t9_mobile_ios_android_and_web_dom_wasm() = let src = "fn score(x: int) -> int requires x >= 0 ensures result >= 0 = x + 12\nprint score(30)\n" in let r_ios = container_macho64_ios_hdr(64, 16777228) in let r_and = target_compile("aarch64-android-elf", src) in let r_web = target_compile("wasm32-web-dom", src) in if tg_nth(r_ios, 0) == 207 and tg_nth(r_ios, 528) == 2 and r_and.ok == 1 and r_and.guards_elided == 1 and tg_nth(r_and.bytes, 0) == 127 and tg_nth(r_and.bytes, 56) == 2 and tg_nth(r_and.bytes, 188) == 65 and tg_nth(r_and.bytes, 196) == 34 and r_web.ok == 1 and r_web.guards_elided == 1 and tg_nth(r_web.bytes, 0) == 0 and tg_nth(r_web.bytes, 1) == 97 then 1 else 0

## --- 10. CLI Dispatch (`run_core_tool ltarget <input>`) ---

fn tg_first_nl(s, i, n) = if i >= n then n else if at(s, i) == "\n" then i else tg_first_nl(s, i + 1, n)
fn tg_strip_cr(s) = let n = count(s) in if n > 0 and at(s, n - 1) == "\r" then slice(s, 0, n - 1) else s

fn tg_fmt_vm_res(vm) = if vm.status == 3 then "TRAP:3" else if vm.ok == 0 then "ERR:" + vm.output else "OK:0\n" + vm.output

fn tg_self_test() = str(test_t0_orthogonal_target_triple_registry()) + "," + str(test_t6_gpu_ptx_and_spirv_lowering_and_vm()) + "," + str(test_t7_mcu_cortexm_avr_xtensa_and_traps()) + "," + str(test_t8_fpga_verilog_and_vhdl_rtl_sim()) + "," + str(test_t9_mobile_ios_android_and_web_dom_wasm())

fn target_cli_dispatch(text) = let n = count(text) in let nl = tg_first_nl(text, 0, n) in let hdr = tg_strip_cr(slice(text, 0, nl)) in let body = (if nl + 1 < n then slice(text, nl + 1, n) else "") in if hdr == "@targets-json" then target_list_json() else if hdr == "@self-test" then tg_self_test() else if slice(hdr, 0, 9) == "@compile " then (let tr = slice(hdr, 9, count(hdr)) in let r = target_compile(tr, body) in if r.ok == 0 then "ERR:" + r.diag else if r.ihex != "" then "IHEX:" + str(r.guards_elided) + "\n" + r.ihex else "HEX:" + str(r.guards_elided) + ":" + r.hex) else if hdr == "@run-lumb" then (let r = target_compile("lumb", body) in if r.ok == 0 then "ERR:" + r.diag else let vm = lumb_verify_and_run(r.bytes) in if vm.status == 3 then "TRAP:3" else "OK:" + str(vm.guards_elided) + "\n" + vm.output) else if hdr == "@run-lumb-hex" then (let vm = lumb_verify_and_run(tg_hex_to_bytes(body)) in if vm.status == 3 then "TRAP:3" else if vm.ok == 0 then "ERR:" + vm.output else "OK:" + str(vm.guards_elided) + "\n" + vm.output) else if hdr == "@run-ptx" then tg_fmt_vm_res(ptx_vm_run(body)) else if hdr == "@run-spirv" then tg_fmt_vm_res(spirv_vm_run(body)) else if hdr == "@run-hdl" then tg_fmt_vm_res(hdl_vm_run(body)) else if slice(hdr, 0, 13) == "@run-mcu-hex " then (let isa = slice(hdr, 13, count(hdr)) in tg_fmt_vm_res(mcu_vm_run(isa, tg_hex_to_bytes(body), 0))) else if slice(hdr, 0, 14) == "@run-mcu-ihex " then (let isa = slice(hdr, 14, count(hdr)) in let dec = ihex_decode_and_verify(body) in if dec.ok == 0 then "ERR:" + dec.diag else tg_fmt_vm_res(mcu_vm_run(isa, dec.bytes, 1))) else target_list_json()

print target_cli_dispatch(readall())
